---
import { ClientRouter } from 'astro:transitions';
import AppAlert from '../components/AppAlert.astro';
import FlashMessage from '../components/FlashMessage.astro';
import FcmManager from '../components/FcmManager.astro';
import OrgNotificationDeepLink from '../components/OrgNotificationDeepLink.astro';
import SessionGuard from '../components/SessionGuard.astro';
import SubscriptionBanner from '../components/SubscriptionBanner.astro';
import { ROLES } from '../config/roles';
import {
    FLASH_MESSAGE_COOKIE,
    FLASH_TYPE_COOKIE,
} from '../lib/flash-server';
import '../styles/fonts.css';

const decodeCookieValue = (value: string) => {
    try {
        return decodeURIComponent(value);
    } catch {
        return value;
    }
};

const flashMessageFromCookie = Astro.cookies.get(FLASH_MESSAGE_COOKIE)?.value ?? '';
const flashTypeFromCookie = Astro.cookies.get(FLASH_TYPE_COOKIE)?.value ?? '';
const flashMessage = decodeCookieValue(flashMessageFromCookie);
const flashTypeRaw = decodeCookieValue(flashTypeFromCookie) || 'success';
const validFlashTypes = ['success', 'error', 'info', 'warning'] as const;
type FlashType = (typeof validFlashTypes)[number];
const flashType: FlashType = validFlashTypes.includes(flashTypeRaw as FlashType)
    ? (flashTypeRaw as FlashType)
    : 'info';
const hasSession = Boolean(Astro.locals.token ?? '');
const isAdmin = Number(Astro.locals.roleId ?? 0) === ROLES.ADMIN;

interface Props {
    pageTitle?: string;
    metaDescription?: string;
    canonicalPath?: string;
    siteOrigin?: string;
    ogImage?: string;
    ogImageAlt?: string;
    ogType?: string;
    robots?: string;
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
    pageTitle = 'Hasel',
    metaDescription,
    canonicalPath,
    siteOrigin: siteOriginProp,
    ogImage = '/icons/icon-512x512.png',
    ogImageAlt,
    ogType = 'website',
    robots = 'index, follow',
    jsonLd,
} = Astro.props as Props;

const siteOrigin = siteOriginProp || Astro.site || Astro.url;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteOrigin).href;
const ogImageUrl = /^https?:\/\//i.test(String(ogImage || '').trim())
    ? String(ogImage).trim()
    : new URL(ogImage, siteOrigin).href;
if (flashMessageFromCookie) {
    Astro.cookies.delete(FLASH_MESSAGE_COOKIE, { path: '/' });
}

if (flashTypeFromCookie) {
    Astro.cookies.delete(FLASH_TYPE_COOKIE, { path: '/' });
}

const themeCookie = String(Astro.cookies.get('bookmate-theme')?.value || '').trim();
const initialTheme = themeCookie === 'light' || themeCookie === 'dark' ? themeCookie : 'dark';
const themeColor = initialTheme === 'dark' ? '#0e0e10' : '#f6f7f9';
---

<!doctype html>
<html lang="es" data-theme={initialTheme}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            href="/fonts/nunito-sans-v19-latin-regular.woff2"
            as="font"
            type="font/woff2"
            crossorigin
            fetchpriority="high"
        />
        <link
            rel="preload"
            href="/fonts/nunito-sans-v19-latin-700.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/nunito-sans-v19-latin-800.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,500,0,0&display=block"
            rel="stylesheet"
        />

        <meta name="theme-color" content={themeColor} />
        <link rel="manifest" href="/manifest.webmanifest" />

        <script>
            import { initHaselPwaRegister } from '../scripts/pwa-register';

            initHaselPwaRegister();
        </script>

        <script is:inline>
            // Agrupamos la lógica en una función
            const setBookmateTheme = () => {
                const storedTheme = localStorage.getItem('bookmate-theme');
                const theme = storedTheme === 'dark' || storedTheme === 'light' ? storedTheme : 'dark';
                document.documentElement.dataset.theme = theme;
                try {
                    document.cookie = 'bookmate-theme=' + theme + ';path=/;max-age=31536000;SameSite=Lax';
                } catch (e) {
                    /* ignore */
                }
            };

            /** Solo desktop: recuerda sidebar colapsado/expandido entre páginas y refrescos. */
            const SIDEBAR_STATE_KEY = 'hasel-sidebar-state';
            const applySidebarState = () => {
                const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
                let stored = null;
                try {
                    stored = localStorage.getItem(SIDEBAR_STATE_KEY);
                } catch (e) {
                    stored = null;
                }
                if (!isDesktop || (stored !== 'collapsed' && stored !== 'expanded')) {
                    document.documentElement.removeAttribute('data-sidebar-pref');
                    document.documentElement.removeAttribute('data-sidebar-booting');
                    return;
                }
                // Preferencia en <html> (existe desde el primer paint) + shell si ya está en el DOM
                document.documentElement.setAttribute('data-sidebar-pref', stored);
                document.documentElement.setAttribute('data-sidebar-booting', '');
                document.querySelectorAll('[data-app-shell]').forEach((shell) => {
                    shell.setAttribute('data-sidebar-state', stored);
                });
                // Quitar "booting" tras el primer frame para reactivar transiciones
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        document.documentElement.removeAttribute('data-sidebar-booting');
                    });
                });
            };

            /** Pestaña activa del editor Perfil Público (persiste al recargar; se limpia al salir). */
            const PPE_TAB_KEY = 'hasel-ppe-active-tab';
            const PPE_TAB_IDS = ['general', 'apariencia', 'galeria', 'horario'];
            const clearPpeTabPref = () => {
                document.documentElement.removeAttribute('data-ppe-tab-pref');
                try {
                    localStorage.removeItem(PPE_TAB_KEY);
                } catch (e) {
                    /* ignore */
                }
            };
            const applyPpeTabPref = () => {
                let stored = null;
                try {
                    stored = localStorage.getItem(PPE_TAB_KEY);
                } catch (e) {
                    stored = null;
                }
                if (!stored || PPE_TAB_IDS.indexOf(stored) === -1) {
                    document.documentElement.removeAttribute('data-ppe-tab-pref');
                    return;
                }
                document.documentElement.setAttribute('data-ppe-tab-pref', stored);
                // Si el island ya está en el DOM, alinear hidden/is-active (FOUC + server:defer).
                document.querySelectorAll('[data-ppe-panel]').forEach((panel) => {
                    panel.hidden = panel.getAttribute('data-ppe-panel') !== stored;
                });
                document.querySelectorAll('[data-ppe-tab]').forEach((btn) => {
                    const active = btn.getAttribute('data-ppe-tab') === stored;
                    btn.classList.toggle('is-active', active);
                    btn.setAttribute('aria-selected', active ? 'true' : 'false');
                    btn.tabIndex = active ? 0 : -1;
                });
            };
            const syncPpeTabPrefForRoute = () => {
                const path = String(location.pathname || '');
                if (path.indexOf('/panel/perfil-publico') === -1) {
                    clearPpeTabPref();
                    return;
                }
                applyPpeTabPref();
            };

            /** Pestaña del hub público vía hash (#galeria, #equipo…) — evita flash Overview. */
            const HUB_TAB_IDS = ['overview', 'galeria', 'equipo', 'sucursales'];
            const applyHubTabPref = () => {
                const hash = String(location.hash || '')
                    .replace(/^#/, '')
                    .trim();
                if (HUB_TAB_IDS.indexOf(hash) === -1) {
                    document.documentElement.removeAttribute('data-hub-tab-pref');
                    return;
                }
                document.documentElement.setAttribute('data-hub-tab-pref', hash);
            };

            // 1. Se ejecuta inmediatamente en la carga inicial (evita el FOUC)
            setBookmateTheme();
            applySidebarState();
            syncPpeTabPrefForRoute();
            applyHubTabPref();

            // 2. Copiar tema al documento entrante ANTES del paint (after-swap llega tarde).
            document.addEventListener('astro:before-swap', (event) => {
                const theme = document.documentElement.dataset.theme;
                if (theme) event.newDocument.documentElement.dataset.theme = theme;
                document.documentElement.classList.add('is-theme-swapping');
                event.newDocument.documentElement.classList.add('is-theme-swapping');
            });

            // 3. Se ejecuta cada vez que ClientRouter intercambia el contenido de la página
            document.addEventListener('astro:after-swap', () => {
                setBookmateTheme();
                applySidebarState();
                syncPpeTabPrefForRoute();
                applyHubTabPref();
                document.documentElement.classList.remove('is-theme-swapping');
            });
            // Al salir de perfil-publico (navegación SPA), olvidar la pestaña para la próxima visita.
            document.addEventListener('astro:before-preparation', (event) => {
                const from = String(event.from?.pathname || location.pathname || '');
                const to = String(event.to?.pathname || '');
                const leavingPpe = from.indexOf('/panel/perfil-publico') !== -1;
                const stayingOnPpe = to.indexOf('/panel/perfil-publico') !== -1;
                if (leavingPpe && !stayingOnPpe) {
                    clearPpeTabPref();
                }
            });
        </script>
        
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        {metaDescription && (
            <>
                <meta name="description" content={metaDescription} />
                <meta name="robots" content={robots} />
                <link rel="canonical" href={canonicalUrl} />
                <meta property="og:locale" content="es_ES" />
                <meta property="og:site_name" content="Hasel" />
                <meta property="og:type" content={ogType} />
                <meta property="og:title" content={pageTitle} />
                <meta property="og:description" content={metaDescription} />
                <meta property="og:url" content={canonicalUrl} />
                <meta property="og:image" content={ogImageUrl} />
                {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
                <meta name="twitter:card" content="summary_large_image" />
                <meta name="twitter:title" content={pageTitle} />
                <meta name="twitter:description" content={metaDescription} />
                <meta name="twitter:image" content={ogImageUrl} />
            </>
        )}
        {jsonLd && (
            <script
                type="application/ld+json"
                set:html={JSON.stringify(jsonLd)}
            />
        )}
        <slot name="head" />
    </head>
    <body
        {...(hasSession
            ? { 'data-org-member-id': String(Astro.locals.userId ?? 0) }
            : {})}
    >
        <ClientRouter />
        <slot />
        {hasSession && (
            <>
                <SessionGuard />
                <SubscriptionBanner isAdmin={isAdmin} />
                <FcmManager />
                <OrgNotificationDeepLink />
                <AppAlert />
            </>
        )}
        {
            flashMessage ? (
                <div class="pointer-events-none fixed bottom-8 left-1/2 z-[10000] flex w-full -translate-x-1/2 justify-center px-4 sm:bottom-10">
                    <FlashMessage
                        message={flashMessage}
                        type={flashType}
                        autoHideMs={4000}
                    />
                </div>
            ) : (
                <FlashMessage message="" />
            )
        }
        {import.meta.env.DEV && (
            <script>
                import { initWebVitalsReporter } from '../lib/web-vitals-reporter';
                initWebVitalsReporter();
            </script>
        )}
    </body>
</html>

<style is:inline>
    html,
    body {
        margin: 0;
        width: 100%;
        min-height: 100%;
        font-family: "Nunito Sans", sans-serif;
    }
</style>
