---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import PublicHaselTopbar from '../../components/PublicHaselTopbar.astro';
import { formatBusinessHoursForDisplay } from '../../lib/business-hours';
import { PublicBookingApiError, getPublicProfileSpecialtyLabel } from '../../lib/public-booking';
import { buildGoogleMapsUrl } from '../../lib/public-booking-locations';
import {
	appendLocIdToBookingPath,
	getPublicOrgHubWithOrds,
	type PublicOrgHub,
} from '../../lib/public-org-hub';
import {
	buildOrgHubPath,
	resolveOgImageUrl,
	resolvePublicSiteOrigin,
} from '../../lib/public-profile-url';
import { isReservedOrgSlug } from '../../lib/reserved-org-slugs';
import {
	buildStadiaStaticMapUrl,
	HUB_LOCATION_CARD_COVER_OPTIONS,
	renderBrandMapMarkerOverlay,
	resolveMapThemeFromStorage,
} from '../../lib/maplibre-static';
import '../../styles/global.css';
import '../../styles/public-org-hub.css';

const organizationSlug = String(Astro.params.orgSlug || '').trim();

const toSafePageStatus = (status: number, hasHub: boolean) => {
	if (hasHub) return 200;
	const parsed = Number(status);
	if (!Number.isInteger(parsed)) return 200;
	if (parsed >= 400 && parsed < 500) return parsed;
	return 200;
};

const initialsFromName = (name: string) => {
	const parts = String(name || '')
		.trim()
		.split(/\s+/)
		.filter(Boolean);
	if (!parts.length) return '?';
	if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
	return `${parts[0][0] || ''}${parts[1][0] || ''}`.toUpperCase();
};

const whatsappHref = (phone: string) => {
	const digits = String(phone || '').replace(/\D/g, '');
	if (!digits) return '';
	return `https://wa.me/${digits}`;
};

const stadiaMapsKey = String(import.meta.env.PUBLIC_STADIA_MAPS_KEY ?? '');
const mapTheme = resolveMapThemeFromStorage(Astro.cookies.get('bookmate-theme')?.value);

let hub: PublicOrgHub | null = null;
let loadError = '';
let statusCode = 500;

if (!organizationSlug || isReservedOrgSlug(organizationSlug)) {
	loadError = 'Negocio no encontrado.';
	statusCode = 404;
} else {
	try {
		hub = await getPublicOrgHubWithOrds(organizationSlug);
		statusCode = 200;
	} catch (error) {
		const bookingError =
			error instanceof PublicBookingApiError
				? error
				: new PublicBookingApiError('No fue posible cargar este negocio.', 500);
		loadError = bookingError.message;
		statusCode = bookingError.status || 500;
	}
}

Astro.response.status = toSafePageStatus(statusCode, Boolean(hub));

const siteOrigin = resolvePublicSiteOrigin(Astro.url.origin);
const canonicalPath = buildOrgHubPath(organizationSlug) || Astro.url.pathname;
const organizationName = hub?.organization_name?.trim() || organizationSlug;
const description = hub?.description?.trim() || '';
const pageTitle = hub ? `${organizationName} | Hasel` : 'Negocio | Hasel';
const metaDescription =
	description ||
	(hub
		? `Reservá turnos online en ${organizationName} con Hasel.`
		: 'Perfil público de negocio en Hasel.');
const ogImage = hub ? resolveOgImageUrl(hub.logo_url, siteOrigin) : resolveOgImageUrl('', siteOrigin);

const professionals = hub?.professionals || [];
const locations = hub?.locations || [];
const serviceCategories = hub?.service_categories || [];
const galleryImages = hub?.gallery_images || [];
const chunkArray = <T,>(items: T[], size: number): T[][] => {
	const chunks: T[][] = [];
	for (let i = 0; i < items.length; i += size) {
		chunks.push(items.slice(i, i + size));
	}
	return chunks;
};
const galleryBlocks = chunkArray(galleryImages, 4);
const bannerUrl = String(hub?.banner_url || '').trim();
const facebookUrl = String(hub?.facebook_url || '').trim();
const instagramUrl = String(hub?.instagram_url || '').trim();
const businessHoursRows = hub?.business_hours
	? formatBusinessHoursForDisplay(hub.business_hours)
	: [];
const businessHoursLiveStatus =
	businessHoursRows.find((row) => row.liveStatus)?.liveStatus ?? null;
const singlePro = professionals.length === 1 ? professionals[0] : null;
const reserveHref = singlePro?.booking_path || '#equipo';
const hubUrl = siteOrigin ? `${siteOrigin}${canonicalPath}` : canonicalPath;
const waHref = hub ? whatsappHref(hub.public_whatsapp) : '';
const profileHandle = organizationSlug ? `@${organizationSlug}` : '';
const locationCount = locations.length;
const singleLocationName =
	String(locations[0]?.name || '').trim() || String(locations[0]?.address || '').trim();
const locationLabel =
	locationCount === 0
		? ''
		: locationCount === 1
			? singleLocationName
			: `${locationCount} sucursales`;
const teamLabel = professionals.length
	? `${professionals.length} profesional${professionals.length === 1 ? '' : 'es'}`
	: '';
const servicesMetaLabel = serviceCategories.length
	? `${serviceCategories.length} servicio${serviceCategories.length === 1 ? '' : 's'}`
	: '';
const shortTagline = description
	? description
			.split(/\n/)
			.map((line) => line.trim())
			.find(Boolean) || ''
	: '';
const serializedProfessionals = professionals.length
	? JSON.stringify(
			professionals.map((pro) => ({
				id: pro.id_professional,
				location_ids: pro.location_ids,
				booking_path: pro.booking_path,
			}))
		).replace(/</g, '\\u003c')
	: '[]';
---

<Layout
	pageTitle={pageTitle}
	metaDescription={metaDescription}
	canonicalPath={canonicalPath}
	ogImage={ogImage}
	ogImageAlt={hub ? `Logo de ${organizationName}` : 'Hasel'}
>
	<main
		class="hub-root"
		data-hub-root
		data-stadia-key={stadiaMapsKey}
		data-hub-professionals={serializedProfessionals}
	>
		{stadiaMapsKey ? (
			<>
				<link rel="dns-prefetch" href="https://tiles.stadiamaps.com" />
				<link rel="preconnect" href="https://tiles.stadiamaps.com" crossorigin />
			</>
		) : null}
		{
			hub ? (
				<>
					<PublicHaselTopbar showReserve={false} showLogin={false} />

					{hub.maintenance ? (
						<p class="hub-maintenance" role="status">
							La agenda online está en mantenimiento temporal. Podés contactar al local
							directamente.
						</p>
					) : null}

					<div class="hub-shell">
					<section class="hub-hero" aria-labelledby="hub-org-name">
						<div
							class={`hub-hero__banner ${bannerUrl ? 'hub-hero__banner--photo' : ''}`}
							aria-hidden="true"
							style={bannerUrl ? `background-image: url(${bannerUrl})` : undefined}
						>
							{!bannerUrl ? (
								<>
									<span class="hub-hero__orb hub-hero__orb--a" />
									<span class="hub-hero__orb hub-hero__orb--b" />
								</>
							) : null}
						</div>
						<div class="hub-hero__profile">
							<div class="hub-hero__avatar-row">
								{hub.logo_url ? (
									<img
										src={hub.logo_url}
										alt=""
										class="hub-hero__logo"
										width="96"
										height="96"
										loading="eager"
										decoding="async"
									/>
								) : (
									<div
										class="hub-hero__logo hub-hero__logo--placeholder"
										aria-hidden="true"
									>
										{initialsFromName(organizationName)}
									</div>
								)}
								<div class="hub-hero__actions">
									{facebookUrl ? (
										<a
											href={facebookUrl}
											class="hub-icon-btn"
											target="_blank"
											rel="noopener noreferrer"
											aria-label="Facebook"
											title="Facebook"
										>
											<svg
												class="hub-icon-btn__svg"
												viewBox="0 0 24 24"
												width="20"
												height="20"
												aria-hidden="true"
												fill="currentColor"
											>
												<path
													d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"
												></path>
											</svg>
										</a>
									) : null}
									{instagramUrl ? (
										<a
											href={instagramUrl}
											class="hub-icon-btn"
											target="_blank"
											rel="noopener noreferrer"
											aria-label="Instagram"
											title="Instagram"
										>
											<svg
												class="hub-icon-btn__svg"
												viewBox="0 0 24 24"
												width="20"
												height="20"
												aria-hidden="true"
												fill="currentColor"
											>
												<path
													d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"
												></path>
											</svg>
										</a>
									) : null}
									<button
										type="button"
										class="hub-icon-btn"
										data-hub-share
										data-hub-url={hubUrl}
										data-hub-share-title={organizationName}
										data-hub-share-text={shortTagline || metaDescription || organizationName}
										aria-label="Compartir perfil del negocio"
										title="Compartir"
									>
										<span class="material-symbols-rounded" aria-hidden="true">ios_share</span>
									</button>
								</div>
							</div>
							<div class="hub-hero__meta">
								<h1 id="hub-org-name" class="hub-hero__name">
									{organizationName}
								</h1>
								{profileHandle ? <p class="hub-hero__handle">{profileHandle}</p> : null}
								{shortTagline ? <p class="hub-hero__tagline">{shortTagline}</p> : null}
								{(locationLabel || teamLabel || servicesMetaLabel) ? (
									<ul class="hub-hero__facts">
										{locationLabel ? (
											<li>
												<span class="material-symbols-rounded" aria-hidden="true">location_on</span>
												{locationLabel}
											</li>
										) : null}
										{teamLabel ? (
											<li>
												<span class="material-symbols-rounded" aria-hidden="true">group</span>
												{teamLabel}
											</li>
										) : null}
										{servicesMetaLabel ? (
											<li>
												<span class="material-symbols-rounded" aria-hidden="true">category</span>
												{servicesMetaLabel}
											</li>
										) : null}
									</ul>
								) : null}
							</div>
							<div class="hub-hero__cta-row">
								{waHref ? (
									<a
										href={waHref}
										class="hub-btn hub-btn--outline hub-wa-link"
										target="_blank"
										rel="noopener noreferrer"
										aria-label="Contactar por WhatsApp"
									>
										<svg
											class="hub-btn__brand-icon"
											viewBox="0 0 24 24"
											width="18"
											height="18"
											aria-hidden="true"
											fill="currentColor"
										>
											<path
												d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
											></path>
										</svg>
										WhatsApp
									</a>
								) : null}
								<a
									href={reserveHref}
									class="hub-btn hub-btn--filled"
									data-hub-reserve-cta
								>
									<span class="material-symbols-rounded" aria-hidden="true">event</span>
									Reservar
								</a>
							</div>
						</div>
					</section>

					<div class="hub-section">
						<nav class="hub-tabs" aria-label="Secciones del negocio" data-hub-tabs>
							<button type="button" class="hub-tab is-active" data-hub-tab="overview">
								Overview
							</button>
							<button type="button" class="hub-tab" data-hub-tab="galeria">Galería</button>
							<button type="button" class="hub-tab" data-hub-tab="equipo">Equipo</button>
							<button type="button" class="hub-tab" data-hub-tab="sucursales">Sucursales</button>
						</nav>
					</div>

					<div class="hub-section hub-panels">
						<section
							id="overview"
							class="hub-panel is-active"
							data-hub-panel="overview"
							aria-labelledby={
								businessHoursRows.length ? 'hub-hours-title' : 'hub-services-title'
							}
						>
							<div class="hub-overview-stack">
								{businessHoursRows.length ? (
									<div class="hub-pin-block hub-hours" aria-label="Horario comercial">
										<p id="hub-hours-title" class="hub-pin-block__label hub-hours__heading">
											<span class="hub-hours__heading-title">
												<span class="material-symbols-rounded" aria-hidden="true">schedule</span>
												Horario
											</span>
											{businessHoursLiveStatus ? (
												<span
													class:list={[
														'hub-hours__live',
														businessHoursLiveStatus === 'open' ? 'is-open' : 'is-closed',
													]}
												>
													<span class="hub-hours__live-dot" aria-hidden="true" />
													{businessHoursLiveStatus === 'open'
														? 'Abierto ahora'
														: 'Cerrado ahora'}
												</span>
											) : null}
										</p>
										<ul class="hub-hours__list">
											{businessHoursRows.map((row) => (
												<li
													class:list={[
														{ 'is-closed': row.closed },
														{ 'is-today': row.isToday },
													]}
												>
													<span class="hub-hours__day">{row.label}</span>
													<span class="hub-hours__value">
														{row.closed
															? 'Cerrado'
															: row.slots.map((slot, slotIndex) => (
																	<span class="hub-hours__slot-wrap">
																		{slotIndex > 0 ? (
																			<span class="hub-hours__sep" aria-hidden="true">
																				|
																			</span>
																		) : null}
																		<span class="hub-hours__slot">{slot}</span>
																	</span>
																))}
													</span>
												</li>
											))}
										</ul>
									</div>
								) : null}
								{serviceCategories.length ? (
									<div class="hub-pin-block" aria-label="Servicios principales">
										<p id="hub-services-title" class="hub-pin-block__label">
											<span class="material-symbols-rounded" aria-hidden="true">keep</span>
											Servicios
										</p>
										<ul class="hub-categories__list">
											{serviceCategories.map((category) => (
												<li>
													<span class="hub-category-tag">{category}</span>
												</li>
											))}
										</ul>
									</div>
								) : (
									<p class="hub-empty">Todavía no hay servicios destacados.</p>
								)}
							</div>
						</section>

						<section
							id="galeria"
							class="hub-panel"
							data-hub-panel="galeria"
							aria-labelledby="hub-gallery-title"
							hidden
						>
							<h2 id="hub-gallery-title" class="hub-section-title">Galería</h2>
							{galleryBlocks.length ? (
								<div class="hub-gallery-blocks" aria-label="Fotos del negocio">
									{galleryBlocks.map((block, blockIndex) => (
										<ul class="hub-gallery-block">
											{block.map((image, imageIndex) => {
												const globalIndex = blockIndex * 4 + imageIndex;
												return (
													<li>
														<button
															type="button"
															class="hub-gallery-open"
															data-hub-gallery-open
															data-hub-gallery-index={String(globalIndex)}
															aria-label={`Ver foto ${globalIndex + 1}`}
														>
															<img
																src={image.url}
																alt=""
																loading={globalIndex < 4 ? 'eager' : 'lazy'}
																decoding="async"
															/>
														</button>
													</li>
												);
											})}
										</ul>
									))}
								</div>
							) : (
								<p class="hub-empty">Todavía no hay fotos.</p>
							)}
						</section>

						<section
							id="equipo"
							class="hub-panel"
							data-hub-panel="equipo"
							aria-labelledby="hub-team-title"
							hidden
						>
							<div class="hub-panel-header">
								<h2 id="hub-team-title" class="hub-section-title">Equipo</h2>
								<div
									class="hub-location-filter"
									data-hub-location-filter
									hidden
									role="status"
								>
									<span class="hub-location-filter__label">Sucursal:</span>
									<span class="hub-location-filter__text" data-hub-location-filter-label></span>
									<button
										type="button"
										class="hub-location-filter__clear"
										data-hub-clear-location-filter
										aria-label="Quitar filtro de sucursal"
										title="Quitar filtro"
									>
										<span class="material-symbols-rounded" aria-hidden="true">close</span>
									</button>
								</div>
							</div>
							{professionals.length ? (
								<>
									<div
										class="hub-team-grid hub-skel-grid"
										data-hub-team-skeleton
										hidden
										aria-hidden="true"
									>
										{Array.from(
											{ length: Math.min(4, Math.max(2, professionals.length)) },
											(_, i) => (
												<div class="hub-pro-card hub-pro-card--skeleton" aria-hidden="true">
													<div class="hub-pro-card__main">
														<span class="hub-pro-card__avatar hub-skel-circle">
															<span class="hub-skel hub-skel-circle hub-pro-card__avatar-face"></span>
															<span class="hub-pro-card__status-dot hub-pro-card__status-dot--avatar" aria-hidden="true"></span>
														</span>
														<div class="hub-pro-card__text">
															<span
																class={`hub-skel hub-skel-line hub-skel-line--title${i % 2 === 1 ? ' hub-skel-line--short' : ''}`}
															></span>
															<span class="hub-skel hub-skel-line hub-skel-line--sub"></span>
														</div>
													</div>
													<span class="hub-skel hub-pro-card__btn-skel"></span>
												</div>
											)
										)}
									</div>
									<div class="hub-team-grid" data-hub-team-grid>
										{professionals.map((pro) => {
											const specialty = getPublicProfileSpecialtyLabel(pro.specialty);
											const initials = initialsFromName(pro.full_name);
											const cardLabel = specialty
												? `Reservar con ${pro.full_name}, ${specialty}. Agenda abierta`
												: `Reservar con ${pro.full_name}. Agenda abierta`;
											return (
												<a
													href={pro.booking_path}
													class="hub-pro-card"
													data-hub-pro-card
													data-pro-id={String(pro.id_professional)}
													data-booking-path={pro.booking_path}
													data-location-ids={pro.location_ids.join(',')}
													aria-label={cardLabel}
												>
													<div class="hub-pro-card__main">
														<div
															class:list={[
																'hub-pro-card__avatar',
																pro.image_url ? 'is-loading' : 'hub-pro-card__avatar--ph',
															]}
														>
															{pro.image_url ? (
																<>
																	<span
																		class="hub-skel hub-pro-card__avatar-skel"
																		aria-hidden="true"
																	></span>
																	<img
																		src={pro.image_url}
																		alt=""
																		class="hub-pro-card__photo is-loading"
																		width="96"
																		height="96"
																		loading="lazy"
																		decoding="async"
																		data-hub-pro-photo
																	/>
																</>
															) : (
																<span class="hub-pro-card__initials" aria-hidden="true">
																	{initials}
																</span>
															)}
															<span
																class="hub-pro-card__status-dot hub-pro-card__status-dot--avatar"
																aria-hidden="true"
															></span>
														</div>
														<div class="hub-pro-card__text">
															<h3 class="hub-pro-card__name">{pro.full_name}</h3>
															{specialty ? (
																<p class="hub-pro-card__specialty">{specialty}</p>
															) : null}
														</div>
													</div>
													<span class="hub-pro-card__btn">
														<span class="material-symbols-rounded" aria-hidden="true">event</span>
														Reservar
													</span>
												</a>
											);
										})}
									</div>
								</>
							) : (
								<p class="hub-empty">
									Todavía no hay profesionales con agenda pública en este negocio.
								</p>
							)}
							<p class="hub-empty" data-hub-team-empty-filter hidden>
								No hay profesionales con agenda en esta sucursal.
							</p>
						</section>

						<section
							id="sucursales"
							class="hub-panel"
							data-hub-panel="sucursales"
							aria-labelledby="hub-locations-title"
							hidden
						>
							<h2 id="hub-locations-title" class="hub-section-title">Sucursales</h2>
							{locations.length ? (
								<>
									<div
										class="hub-locations-grid hub-skel-grid"
										data-hub-locations-skeleton
										hidden
										aria-hidden="true"
									>
										{Array.from(
											{ length: Math.min(3, Math.max(2, locations.length)) },
											(_, i) => (
												<article
													class="hub-location-card hub-location-card--skeleton"
													aria-hidden="true"
												>
													<div class="hub-location-card__map-frame">
														<div class="hub-skel hub-location-card__map"></div>
													</div>
													<div class="hub-location-card__body">
														<div class="hub-location-card__info">
															<span
																class={`hub-skel hub-skel-line hub-skel-line--title${i % 2 === 1 ? ' hub-skel-line--short' : ''}`}
															></span>
															<span class="hub-skel hub-skel-line hub-skel-line--sub"></span>
															<span class="hub-skel hub-skel-line hub-skel-line--meta"></span>
														</div>
														<div class="hub-location-card__actions">
															<span class="hub-skel hub-skel-pill hub-location-card__map-btn-skel"></span>
															<span class="hub-skel hub-skel-circle"></span>
														</div>
													</div>
												</article>
											)
										)}
									</div>
									<div class="hub-locations-grid" data-hub-locations-grid>
										{locations.map((loc) => {
											const mapsUrl = buildGoogleMapsUrl(loc);
											const latitude = Number(loc.latitude);
											const longitude = Number(loc.longitude);
											const hasCoords =
												Number.isFinite(latitude) && Number.isFinite(longitude);
											const mapPreviewUrl = hasCoords
												? buildStadiaStaticMapUrl(
														stadiaMapsKey,
														{ lat: latitude, lng: longitude },
														{
															theme: mapTheme,
															...HUB_LOCATION_CARD_COVER_OPTIONS,
														}
													)
												: null;
											const prosHere = professionals.filter((pro) =>
												pro.location_ids.includes(loc.id_location)
											);
											const canFilterHere = prosHere.length > 0;
											const reserveHereHref =
												prosHere.length === 1
													? appendLocIdToBookingPath(
															prosHere[0].booking_path,
															loc.id_location
														)
													: '#equipo';
											const prosMeta =
												prosHere.length === 0
													? 'Sin profesionales con agenda'
													: prosHere.length === 1
														? '1 profesional'
														: `${prosHere.length} profesionales`;
											const actionLabel =
												prosHere.length === 1
													? 'Reservar en esta sucursal'
													: 'Ver profesionales';
											const actionIcon = prosHere.length === 1 ? 'event' : 'group';
											return (
												<article
													class="hub-location-card"
													data-hub-location-card
												>
													<div class="hub-location-card__map-frame">
														{mapPreviewUrl ? (
															<div
																class="hub-location-card__map is-loading"
																data-hub-map
																data-lat={String(latitude)}
																data-lng={String(longitude)}
																data-title={loc.name}
																aria-hidden={mapsUrl ? 'true' : undefined}
																aria-label={mapsUrl ? undefined : `Mapa de ${loc.name}`}
															>
																<span
																	class="hub-skel hub-location-card__map-skel"
																	aria-hidden="true"
																></span>
																<img
																	class="hub-location-card__map-img"
																	data-hub-map-img
																	data-lat={String(latitude)}
																	data-lng={String(longitude)}
																	src={mapPreviewUrl}
																	sizes="(min-width: 640px) 45vw, 100vw"
																	alt=""
																	width={HUB_LOCATION_CARD_COVER_OPTIONS.width}
																	height={HUB_LOCATION_CARD_COVER_OPTIONS.height}
																	loading="eager"
																	decoding="async"
																	onload="this.classList.add('is-loaded'); this.closest('[data-hub-map]')?.classList.remove('is-loading')"
																	onerror="this.hidden=true; const m=this.closest('[data-hub-map]'); m?.classList.remove('is-loading'); m?.classList.add('hub-location-card__map--empty')"
																/>
																<Fragment set:html={renderBrandMapMarkerOverlay()} />
															</div>
														) : hasCoords ? (
															<div class="hub-location-card__map hub-location-card__map--empty">
																<span
																	class="material-symbols-rounded"
																	aria-hidden="true"
																>
																	map
																</span>
																<span>Mapa no disponible</span>
															</div>
														) : (
															<div class="hub-location-card__map hub-location-card__map--empty">
																<span
																	class="material-symbols-rounded"
																	aria-hidden="true"
																>
																	location_off
																</span>
																<span>Sin coordenadas cargadas</span>
															</div>
														)}
													</div>
													<div class="hub-location-card__body">
														<div class="hub-location-card__info">
															<h3 class="hub-location-card__name">{loc.name}</h3>
															{loc.address ? (
																<p class="hub-location-card__address">{loc.address}</p>
															) : null}
															<p class="hub-location-card__meta">
																<span class="material-symbols-rounded" aria-hidden="true"
																	>groups</span
																>
																{prosMeta}
															</p>
														</div>
														<div class="hub-location-card__actions">
															{mapsUrl ? (
																<button
																	type="button"
																	class="hub-location-card__map-btn"
																	data-hub-map-open
																	data-lat={hasCoords ? String(loc.latitude) : ''}
																	data-lng={hasCoords ? String(loc.longitude) : ''}
																	data-title={loc.name}
																	data-address={loc.address || ''}
																	data-maps-url={mapsUrl}
																	aria-label={`Ver mapa de ${loc.name}`}
																>
																	<span class="material-symbols-rounded" aria-hidden="true">
																		map
																	</span>
																	<span class="hub-location-card__map-btn-text">Ver mapa</span>
																</button>
															) : null}
															{prosHere.length === 1 ? (
																<a
																	href={reserveHereHref}
																	class="hub-location-card__action no-underline"
																	aria-label={actionLabel}
																	title={actionLabel}
																>
																	<span class="material-symbols-rounded" aria-hidden="true"
																		>{actionIcon}</span
																	>
																</a>
															) : (
																<button
																	type="button"
																	class="hub-location-card__action"
																	data-hub-view-pros-at-location
																	data-loc-id={canFilterHere ? String(loc.id_location) : '0'}
																	data-loc-name={canFilterHere ? loc.name : ''}
																	aria-label={actionLabel}
																	title={actionLabel}
																>
																	<span class="material-symbols-rounded" aria-hidden="true"
																		>{actionIcon}</span
																	>
																</button>
															)}
														</div>
													</div>
												</article>
											);
										})}
									</div>
								</>
							) : (
								<p class="hub-empty">Sin sucursales publicadas.</p>
							)}
						</section>
					</div>
					</div>

					{galleryImages.length ? (
						<dialog class="hub-lightbox" data-hub-lightbox aria-label="Foto de la galería">
							<button
								type="button"
								class="hub-lightbox__close"
								data-hub-lightbox-close
								aria-label="Cerrar"
							>
								<span class="material-symbols-rounded" aria-hidden="true">close</span>
							</button>
							<button
								type="button"
								class="hub-lightbox__nav hub-lightbox__nav--prev"
								data-hub-lightbox-prev
								aria-label="Foto anterior"
							>
								<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
							</button>
							<figure class="hub-lightbox__figure">
								<img src="" alt="" data-hub-lightbox-image />
								<figcaption class="hub-lightbox__caption" data-hub-lightbox-caption></figcaption>
							</figure>
							<button
								type="button"
								class="hub-lightbox__nav hub-lightbox__nav--next"
								data-hub-lightbox-next
								aria-label="Foto siguiente"
							>
								<span class="material-symbols-rounded" aria-hidden="true">chevron_right</span>
							</button>
						</dialog>
					) : null}

					{locations.length ? (
						<dialog class="hub-map-modal" data-hub-map-modal aria-label="Mapa de la sucursal">
							<div class="hub-map-modal__sheet">
								<div class="hub-map-modal__handle" aria-hidden="true"><span></span></div>
								<div class="hub-map-modal__header">
									<div class="hub-map-modal__heading">
										<h2 class="hub-map-modal__title" data-hub-map-modal-title>Ubicación</h2>
										<p class="hub-map-modal__address" data-hub-map-modal-address></p>
									</div>
									<button
										type="button"
										class="hub-map-modal__close"
										data-hub-map-modal-close
										aria-label="Cerrar mapa"
									>
										<span class="material-symbols-rounded" aria-hidden="true">close</span>
									</button>
								</div>
								<div class="hub-map-modal__canvas-wrap" data-hub-map-modal-wrap>
									<div class="hub-map-modal__canvas" data-hub-map-modal-canvas></div>
									<div
										class="hub-map-modal__loading"
										data-hub-map-modal-loading
										hidden
										aria-live="polite"
										aria-label="Cargando mapa"
									>
										<span class="material-symbols-rounded" aria-hidden="true">progress_activity</span>
									</div>
								</div>
								<p class="hub-map-modal__status" data-hub-map-modal-status hidden></p>
								<a
									class="hub-map-modal__external no-underline"
									data-hub-map-modal-external
									href="#"
									target="_blank"
									rel="noopener noreferrer"
								>
									<span class="material-symbols-rounded" aria-hidden="true">open_in_new</span>
									Abrir en Google Maps
								</a>
							</div>
						</dialog>
					) : null}

					<div
						class="hub-toast"
						data-hub-toast
						role="status"
						aria-live="polite"
						hidden
					></div>
				</>
			) : (
				<>
					<PublicHaselTopbar reserveHref="/" reserveLabel="Ir al inicio" showLogin={false} />
					<div class="hub-error">
						<h1>No encontramos este negocio</h1>
						<p>{loadError || 'El enlace puede ser incorrecto o el negocio ya no está disponible.'}</p>
						<a href="/">Volver a Hasel</a>
					</div>
				</>
			)
		}
	</main>
</Layout>

<script>
	import {
		buildStadiaStaticMapUrl,
		HUB_LOCATION_CARD_COVER_OPTIONS,
		resolveMapTheme,
	} from '../../lib/maplibre-static';

	type MapLibreMap = InstanceType<
		Awaited<ReturnType<typeof import('../../lib/maplibre-interactive')['loadMapLibre']>>['Map']
	>;

	type HubMapHandle = {
		map: MapLibreMap;
		center: { lat: number; lng: number };
		disconnectResize?: () => void;
	};

	const VALID_TABS = new Set(['overview', 'galeria', 'equipo', 'sucursales']);

	let hubMapLibreModule:
		| Awaited<ReturnType<typeof import('../../lib/maplibre-interactive')['loadMapLibre']>>
		| null = null;

	const loadHubMapLibre = async () => {
		if (!hubMapLibreModule) {
			const mod = await import('../../lib/maplibre-interactive');
			hubMapLibreModule = await mod.loadMapLibre();
		}
		return hubMapLibreModule;
	};

	const getHubStyleUrl = async (key: string) => {
		const mod = await import('../../lib/maplibre-interactive');
		return mod.getStadiaStyleUrl(mod.resolveMapTheme(), key);
	};

	const placeHubMarker = async (
		maplibregl: Awaited<ReturnType<typeof loadHubMapLibre>>,
		map: MapLibreMap,
		coords: { lat: number; lng: number },
		title?: string
	) => {
		const mod = await import('../../lib/maplibre-interactive');
		return mod
			.createBrandMarker(maplibregl, coords, { color: '#FB7185', title })
			.addTo(map);
	};

	const hubMapInstanceList: HubMapHandle[] = [];

	const markHubMapImageReady = (img: HTMLImageElement) => {
		img.classList.add('is-loaded');
		img.closest('[data-hub-map]')?.classList.remove('is-loading');
	};

	const markHubMapImageFailed = (img: HTMLImageElement) => {
		img.hidden = true;
		const canvas = img.closest<HTMLElement>('[data-hub-map]');
		canvas?.classList.remove('is-loading');
		canvas?.classList.add('hub-location-card__map--empty');
	};

	const bindHubMapImage = (img: HTMLImageElement) => {
		if (img.dataset.bound === '1') {
			if (img.complete && img.naturalWidth > 0) markHubMapImageReady(img);
			return;
		}
		img.dataset.bound = '1';
		if (img.complete && img.naturalWidth > 0) {
			markHubMapImageReady(img);
			return;
		}
		img.addEventListener('load', () => markHubMapImageReady(img), { once: true });
		img.addEventListener('error', () => markHubMapImageFailed(img), { once: true });
	};

	/** Miniaturas estáticas: no dependen de WebGL ni del tamaño del panel oculto. */
	const hydrateHubMapImages = (root: HTMLElement) => {
		const apiKey = String(root.dataset.stadiaKey || '').trim();
		const theme = resolveMapTheme();
		root.querySelectorAll<HTMLImageElement>('[data-hub-map-img]').forEach((img) => {
			const lat = Number(img.dataset.lat);
			const lng = Number(img.dataset.lng);
			if (apiKey && Number.isFinite(lat) && Number.isFinite(lng)) {
				const url = buildStadiaStaticMapUrl(apiKey, { lat, lng }, {
					theme,
					...HUB_LOCATION_CARD_COVER_OPTIONS,
				});
				if (url && img.getAttribute('src') !== url) {
					img.closest('[data-hub-map]')?.classList.add('is-loading');
					img.classList.remove('is-loaded');
					img.src = url;
				}
			}
			img.loading = 'eager';
			bindHubMapImage(img);
		});
	};

	const syncHubMapsTheme = async () => {
		const root = document.querySelector<HTMLElement>('[data-hub-root]');
		if (root) hydrateHubMapImages(root);
		if (!hubMapInstanceList.length) return;
		const apiKey = String(root?.dataset.stadiaKey || '').trim();
		if (!apiKey) return;
		const styleUrl = await getHubStyleUrl(apiKey);
		hubMapInstanceList.forEach((entry) => {
			try {
				entry.map.setStyle(styleUrl);
			} catch {
				// ignore
			}
			window.setTimeout(() => {
				void import('../../lib/maplibre-interactive').then((mod) => {
					mod.layoutMapLibreMap(entry.map, entry.center);
				});
			}, 80);
		});
	};

	const destroyHubMaps = () => {
		hubMapInstanceList.forEach((entry) => {
			entry.disconnectResize?.();
			try {
				entry.map.remove();
			} catch {
				// ignore
			}
		});
		hubMapInstanceList.length = 0;
	};

	let hubThemeObserver: MutationObserver | null = null;
	let hubHashHandler: (() => void) | null = null;

	const teardownHubPageListeners = () => {
		hubThemeObserver?.disconnect();
		hubThemeObserver = null;
		if (hubHashHandler) {
			window.removeEventListener('hashchange', hubHashHandler);
			hubHashHandler = null;
		}
	};

	const appendLocId = (bookingPath: string, locId: number) => {
		const path = String(bookingPath || '').trim();
		if (!path || !locId) return path;
		const separator = path.includes('?') ? '&' : '?';
		return `${path}${separator}loc_id=${locId}`;
	};

	const initHubPage = () => {
		const root = document.querySelector<HTMLElement>('[data-hub-root]');
		if (!root || root.dataset.hubPageReady === '1') return;
		root.dataset.hubPageReady = '1';

		const toastEl = root.querySelector<HTMLElement>('[data-hub-toast]');
		let toastTimer: number | null = null;
		const showHubToast = (message: string) => {
			if (!toastEl) return;
			toastEl.hidden = false;
			toastEl.textContent = message;
			toastEl.classList.add('is-visible');
			if (toastTimer) window.clearTimeout(toastTimer);
			toastTimer = window.setTimeout(() => {
				toastEl.classList.remove('is-visible');
				window.setTimeout(() => {
					if (!toastEl.classList.contains('is-visible')) {
						toastEl.hidden = true;
						toastEl.textContent = '';
					}
				}, 220);
			}, 2200);
		};

		const copyHubUrl = async (url: string) => {
			await navigator.clipboard.writeText(url);
		};

		const shareBtn = root.querySelector<HTMLButtonElement>('[data-hub-share]');
		if (shareBtn && shareBtn.dataset.bound !== '1') {
			shareBtn.dataset.bound = '1';
			shareBtn.addEventListener('click', async () => {
				const url = String(shareBtn.dataset.hubUrl || window.location.href).trim();
				const title = String(shareBtn.dataset.hubShareTitle || document.title).trim();
				const text = String(shareBtn.dataset.hubShareText || title).trim();
				const payload: ShareData = { title, text, url };

				const canNativeShare =
					typeof navigator.share === 'function' &&
					(typeof navigator.canShare !== 'function' || navigator.canShare(payload));

				if (canNativeShare) {
					try {
						await navigator.share(payload);
						return;
					} catch (error) {
						const name = error instanceof DOMException ? error.name : '';
						if (name === 'AbortError') return;
					}
				}

				try {
					await copyHubUrl(url);
					showHubToast('Enlace copiado para compartir');
				} catch {
					showHubToast('No se pudo compartir el enlace');
				}
			});
		}

		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hub-tab]'));
		const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-hub-panel]'));
		const filterBar = root.querySelector<HTMLElement>('[data-hub-location-filter]');
		const filterLabel = root.querySelector<HTMLElement>('[data-hub-location-filter-label]');
		const emptyFilter = root.querySelector<HTMLElement>('[data-hub-team-empty-filter]');
		const proCards = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-hub-pro-card]'));
		const teamGrid = root.querySelector<HTMLElement>('[data-hub-team-grid]');
		const teamSkeleton = root.querySelector<HTMLElement>('[data-hub-team-skeleton]');
		const locationsGrid = root.querySelector<HTMLElement>('[data-hub-locations-grid]');
		const locationsSkeleton = root.querySelector<HTMLElement>('[data-hub-locations-skeleton]');
		const equipoPanel = root.querySelector<HTMLElement>('[data-hub-panel="equipo"]');
		const sucursalesPanel = root.querySelector<HTMLElement>('[data-hub-panel="sucursales"]');
		let activeLocId = 0;
		let teamRevealPromise: Promise<void> | null = null;

		/** En PC, Reservar abre la agenda en una pestaña nueva. */
		const syncProCardTargets = () => {
			const openInNewTab = window.matchMedia('(min-width: 1024px)').matches;
			proCards.forEach((card) => {
				if (openInNewTab) {
					card.target = '_blank';
					card.rel = 'noopener noreferrer';
				} else {
					card.removeAttribute('target');
					card.removeAttribute('rel');
				}
			});
		};
		syncProCardTargets();
		window.matchMedia('(min-width: 1024px)').addEventListener('change', syncProCardTargets);

		const markProPhotoReady = (img: HTMLImageElement) => {
			img.classList.remove('is-loading');
			img.classList.add('is-ready');
			img.closest('.hub-pro-card__avatar')?.classList.remove('is-loading');
		};

		root.querySelectorAll<HTMLImageElement>('[data-hub-pro-photo]').forEach((img) => {
			if (img.dataset.bound === '1') return;
			img.dataset.bound = '1';
			if (img.complete && img.naturalWidth > 0) {
				markProPhotoReady(img);
				return;
			}
			img.addEventListener('load', () => markProPhotoReady(img), { once: true });
			img.addEventListener(
				'error',
				() => {
					markProPhotoReady(img);
				},
				{ once: true }
			);
		});

		const waitForProPhotos = (grid: HTMLElement, timeoutMs = 1200) =>
			new Promise<void>((resolve) => {
				const imgs = Array.from(grid.querySelectorAll<HTMLImageElement>('[data-hub-pro-photo]'));
				const pending = imgs.filter((img) => !(img.complete && img.naturalWidth > 0));
				if (!pending.length) {
					resolve();
					return;
				}
				let settled = 0;
				let done = false;
				const finish = () => {
					if (done) return;
					done = true;
					resolve();
				};
				const timer = window.setTimeout(finish, timeoutMs);
				pending.forEach((img) => {
					const onDone = () => {
						settled += 1;
						if (settled >= pending.length) {
							window.clearTimeout(timer);
							finish();
						}
					};
					img.addEventListener('load', onDone, { once: true });
					img.addEventListener('error', onDone, { once: true });
				});
			});

		const revealTeamGrid = async () => {
			if (!teamGrid || !equipoPanel) {
				return;
			}
			if (equipoPanel.dataset.teamReady === '1') {
				return;
			}
			if (teamRevealPromise) {
				await teamRevealPromise;
				return;
			}
			teamRevealPromise = (async () => {
				if (!teamSkeleton) {
					equipoPanel.dataset.teamReady = '1';
					return;
				}
				const pendingPhotos = Array.from(
					teamGrid.querySelectorAll<HTMLImageElement>('[data-hub-pro-photo]')
				).filter((img) => !(img.complete && img.naturalWidth > 0));

				if (!pendingPhotos.length) {
					equipoPanel.dataset.teamReady = '1';
					teamSkeleton.hidden = true;
					teamGrid.hidden = false;
					equipoPanel.removeAttribute('aria-busy');
					return;
				}

				// Forzar carga (el grid oculto no dispara lazy-load).
				pendingPhotos.forEach((img) => {
					img.loading = 'eager';
					if (!img.src && img.dataset.src) img.src = img.dataset.src;
				});

				teamGrid.hidden = true;
				teamSkeleton.hidden = false;
				equipoPanel.setAttribute('aria-busy', 'true');
				await waitForProPhotos(teamGrid);
				teamSkeleton.hidden = true;
				teamGrid.hidden = false;
				equipoPanel.dataset.teamReady = '1';
				equipoPanel.removeAttribute('aria-busy');
			})();
			await teamRevealPromise;
		};

		const revealLocationsGrid = async () => {
			if (locationsGrid && locationsSkeleton) {
				locationsSkeleton.hidden = true;
				locationsGrid.hidden = false;
			}
			if (sucursalesPanel) {
				sucursalesPanel.dataset.locationsReady = '1';
				sucursalesPanel.removeAttribute('aria-busy');
			}
			hydrateHubMapImages(root);
		};

		const applyLocationFilter = (locId: number, locName = '') => {
			activeLocId = locId > 0 ? locId : 0;
			let visibleCount = 0;

			proCards.forEach((card) => {
				const ids = String(card.dataset.locationIds || '')
					.split(',')
					.map((value) => Number(value))
					.filter((value) => Number.isInteger(value) && value > 0);
				const basePath = String(card.dataset.bookingPath || card.getAttribute('href') || '');
				const matches = !activeLocId || ids.length === 0 || ids.includes(activeLocId);
				card.hidden = !matches;
				if (matches) {
					visibleCount += 1;
					card.href = activeLocId ? appendLocId(basePath, activeLocId) : basePath;
				}
			});

			if (filterBar && filterLabel) {
				if (activeLocId && locName) {
					filterBar.hidden = false;
					filterLabel.textContent = locName;
				} else {
					filterBar.hidden = true;
					filterLabel.textContent = '';
				}
			}

			if (emptyFilter) {
				emptyFilter.hidden = !(activeLocId && visibleCount === 0 && proCards.length > 0);
			}
		};

		const scrollToPanel = (tabId: string) => {
			const target =
				root.querySelector<HTMLElement>(`[data-hub-panel="${tabId}"]`) ||
				root.querySelector<HTMLElement>(`#${tabId}`);
			if (!target) return;
			window.requestAnimationFrame(() => {
				target.scrollIntoView({ behavior: 'smooth', block: 'start' });
			});
		};

		const setActiveTab = (
			tabId: string,
			{ updateHash = true, scrollIntoView = false }: { updateHash?: boolean; scrollIntoView?: boolean } = {}
		) => {
			const safeTab = VALID_TABS.has(tabId) ? tabId : 'overview';
			tabs.forEach((tab) => {
				const active = tab.dataset.hubTab === safeTab;
				tab.classList.toggle('is-active', active);
				tab.setAttribute('aria-selected', String(active));
			});
			panels.forEach((panel) => {
				const active = panel.dataset.hubPanel === safeTab;
				panel.classList.toggle('is-active', active);
				panel.hidden = !active;
			});
			document.documentElement.setAttribute('data-hub-tab-pref', safeTab);
			if (updateHash) {
				const nextHash = `#${safeTab}`;
				if (window.location.hash !== nextHash) {
					history.replaceState(null, '', `${window.location.pathname}${nextHash}`);
				}
			}
			if (safeTab === 'equipo') {
				void revealTeamGrid();
			}
			if (safeTab === 'sucursales') {
				void revealLocationsGrid();
			}
			if (scrollIntoView) {
				scrollToPanel(safeTab);
			}
		};

		const hashTab = String(window.location.hash || '')
			.replace(/^#/, '')
			.trim();
		setActiveTab(VALID_TABS.has(hashTab) ? hashTab : 'overview', { updateHash: false });

		hubHashHandler = () => {
			if (!root.isConnected) return;
			const next = String(window.location.hash || '')
				.replace(/^#/, '')
				.trim();
			if (VALID_TABS.has(next)) {
				setActiveTab(next, { updateHash: false });
			}
		};
		window.addEventListener('hashchange', hubHashHandler);

		hubThemeObserver = new MutationObserver(() => {
			syncHubMapsTheme();
		});
		hubThemeObserver.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});


		tabs.forEach((tab) => {
			if (tab.dataset.bound === '1') return;
			tab.dataset.bound = '1';
			tab.addEventListener('click', () => {
				if (tab.dataset.hubTab !== 'equipo') {
					applyLocationFilter(0);
				}
				setActiveTab(String(tab.dataset.hubTab || 'overview'));
			});
		});

		root.querySelectorAll<HTMLElement>('[data-hub-view-pros-at-location]').forEach((btn) => {
			if (btn.dataset.bound === '1') return;
			btn.dataset.bound = '1';
			btn.addEventListener('click', () => {
				const locId = Number(btn.getAttribute('data-loc-id') || 0);
				const locName = String(btn.getAttribute('data-loc-name') || '').trim();
				applyLocationFilter(locId, locName);
				setActiveTab('equipo', { scrollIntoView: true });
			});
		});

		const clearFilterBtn = root.querySelector<HTMLButtonElement>('[data-hub-clear-location-filter]');
		if (clearFilterBtn && clearFilterBtn.dataset.bound !== '1') {
			clearFilterBtn.dataset.bound = '1';
			clearFilterBtn.addEventListener('click', () => applyLocationFilter(0));
		}

		const reserveCta = document.querySelector<HTMLAnchorElement>('[data-hub-reserve-cta]');
		if (reserveCta && reserveCta.dataset.bound !== '1') {
			reserveCta.dataset.bound = '1';
			reserveCta.addEventListener('click', (event) => {
				const href = String(reserveCta.getAttribute('href') || '');
				if (href === '#equipo') {
					event.preventDefault();
					applyLocationFilter(0);
					setActiveTab('equipo');
				}
			});
		}

		const lightbox = root.querySelector<HTMLDialogElement>('[data-hub-lightbox]');
		const lightboxImage = root.querySelector<HTMLImageElement>('[data-hub-lightbox-image]');
		const lightboxCaption = root.querySelector<HTMLElement>('[data-hub-lightbox-caption]');
		const lightboxPrev = root.querySelector<HTMLButtonElement>('[data-hub-lightbox-prev]');
		const lightboxNext = root.querySelector<HTMLButtonElement>('[data-hub-lightbox-next]');
		const galleryUrls = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hub-gallery-open]'))
			.map((btn) => {
				const img = btn.querySelector('img');
				return String(img?.src || '').trim();
			})
			.filter(Boolean);
		let lightboxIndex = 0;

		const syncLightbox = () => {
			const url = galleryUrls[lightboxIndex];
			if (!url || !lightboxImage) return;
			lightboxImage.src = url;
			lightboxImage.alt = `Foto ${lightboxIndex + 1} de ${galleryUrls.length}`;
			if (lightboxCaption) {
				lightboxCaption.textContent = `${lightboxIndex + 1} / ${galleryUrls.length}`;
			}
			const multi = galleryUrls.length > 1;
			if (lightboxPrev) {
				lightboxPrev.hidden = !multi;
				lightboxPrev.disabled = lightboxIndex <= 0;
			}
			if (lightboxNext) {
				lightboxNext.hidden = !multi;
				lightboxNext.disabled = lightboxIndex >= galleryUrls.length - 1;
			}
		};

		const openLightbox = (index: number) => {
			if (!lightbox || !galleryUrls.length) return;
			lightboxIndex = Math.max(0, Math.min(index, galleryUrls.length - 1));
			syncLightbox();
			if (!lightbox.open) lightbox.showModal();
		};

		const closeLightbox = () => {
			lightbox?.close();
			if (lightboxImage) {
				lightboxImage.removeAttribute('src');
				lightboxImage.alt = '';
			}
		};

		const stepLightbox = (delta: -1 | 1) => {
			const next = lightboxIndex + delta;
			if (next < 0 || next >= galleryUrls.length) return;
			lightboxIndex = next;
			syncLightbox();
		};

		if (lightbox && lightbox.dataset.bound !== '1') {
			lightbox.dataset.bound = '1';
			root.querySelectorAll<HTMLButtonElement>('[data-hub-gallery-open]').forEach((btn) => {
				btn.addEventListener('click', () => {
					openLightbox(Number(btn.dataset.hubGalleryIndex || 0));
				});
			});
			root.querySelectorAll('[data-hub-lightbox-close]').forEach((btn) => {
				btn.addEventListener('click', () => closeLightbox());
			});
			lightboxPrev?.addEventListener('click', () => stepLightbox(-1));
			lightboxNext?.addEventListener('click', () => stepLightbox(1));
			lightbox.addEventListener('click', (event) => {
				if (event.target === lightbox) closeLightbox();
			});
			lightbox.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowLeft') {
					event.preventDefault();
					stepLightbox(-1);
				} else if (event.key === 'ArrowRight') {
					event.preventDefault();
					stepLightbox(1);
				}
			});
		}

		const mapModal = root.querySelector<HTMLDialogElement>('[data-hub-map-modal]');
		const mapModalTitle = root.querySelector<HTMLElement>('[data-hub-map-modal-title]');
		const mapModalAddress = root.querySelector<HTMLElement>('[data-hub-map-modal-address]');
		const mapModalCanvas = root.querySelector<HTMLElement>('[data-hub-map-modal-canvas]');
		const mapModalLoading = root.querySelector<HTMLElement>('[data-hub-map-modal-loading]');
		const mapModalStatus = root.querySelector<HTMLElement>('[data-hub-map-modal-status]');
		const mapModalExternal = root.querySelector<HTMLAnchorElement>('[data-hub-map-modal-external]');
		const mapModalCloseBtns = Array.from(
			root.querySelectorAll<HTMLButtonElement>('[data-hub-map-modal-close]')
		);
		let modalMapHandle: HubMapHandle | null = null;

		const isHubMobileViewport = () => window.matchMedia('(max-width: 639px)').matches;

		const setMapModalLoading = (loading: boolean) => {
			if (!mapModalLoading) return;
			mapModalLoading.hidden = !loading;
		};

		const setMapModalStatus = (message: string) => {
			if (!mapModalStatus) return;
			const text = String(message || '').trim();
			mapModalStatus.textContent = text;
			mapModalStatus.hidden = !text;
		};

		const renderModalMap = async (lat: number, lng: number, title: string) => {
			if (!mapModalCanvas) return;
			const apiKey = String(root.dataset.stadiaKey || '').trim();
			if (!apiKey) {
				setMapModalStatus('Mapa no disponible.');
				setMapModalLoading(false);
				return;
			}

			setMapModalLoading(true);
			setMapModalStatus('');
			try {
				const mapLibreMod = await import('../../lib/maplibre-interactive');
				const maplibregl = await loadHubMapLibre();
				const styleUrl = await getHubStyleUrl(apiKey);
				const center = { lat, lng };
				await mapLibreMod.whenMapContainerReady(mapModalCanvas);
				if (modalMapHandle) {
					try {
						modalMapHandle.map.setStyle(styleUrl);
					} catch {
						// ignore
					}
					modalMapHandle.center = center;
					mapLibreMod.layoutMapLibreMap(modalMapHandle.map, center);
					window.setTimeout(() => {
						mapLibreMod.layoutMapLibreMap(modalMapHandle!.map, center);
					}, 80);
				} else {
					mapModalCanvas.innerHTML = '';
					const map = new maplibregl.Map({
						container: mapModalCanvas,
						style: styleUrl,
						center: [lng, lat],
						zoom: 16,
						attributionControl: { compact: true },
					});
					map.addControl(
						new maplibregl.NavigationControl({ showCompass: false }),
						'top-right'
					);
					const marker = await placeHubMarker(maplibregl, map, center, title);
					marker.setPopup(
						new maplibregl.Popup({ closeButton: false, offset: 24 }).setText(title)
					);
					const disconnectResize = mapLibreMod.observeMapContainerResize(
						mapModalCanvas,
						map
					);
					modalMapHandle = { map, center, disconnectResize };
					hubMapInstanceList.push(modalMapHandle);
					window.setTimeout(() => {
						mapLibreMod.layoutMapLibreMap(map, center);
					}, 120);
				}
			} catch {
				setMapModalStatus('No se pudo cargar el mapa.');
			} finally {
				setMapModalLoading(false);
			}
		};

		const openHubMapModal = (payload: {
			title: string;
			address: string;
			mapsUrl: string;
			lat: number;
			lng: number;
			hasCoords: boolean;
		}) => {
			if (!mapModal) return;
			if (mapModalTitle) mapModalTitle.textContent = payload.title || 'Ubicación';
			if (mapModalAddress) mapModalAddress.textContent = payload.address || '';
			if (mapModalExternal) {
				mapModalExternal.href = payload.mapsUrl || '#';
				mapModalExternal.hidden = !payload.mapsUrl;
			}
			if (!mapModal.open) mapModal.showModal();
			if (payload.hasCoords) {
				void renderModalMap(payload.lat, payload.lng, payload.title);
			} else {
				setMapModalLoading(false);
				setMapModalStatus(
					payload.mapsUrl
						? 'Usá el botón de abajo para abrir la ubicación en Google Maps.'
						: 'Sin coordenadas cargadas.'
				);
			}
		};

		const closeHubMapModal = () => {
			mapModal?.close();
			setMapModalLoading(false);
			setMapModalStatus('');
		};

		if (mapModal && mapModal.dataset.bound !== '1') {
			mapModal.dataset.bound = '1';
			root.querySelectorAll<HTMLButtonElement>('[data-hub-map-open]').forEach((btn) => {
				btn.addEventListener('click', () => {
					const mapsUrl = String(btn.dataset.mapsUrl || '').trim();
					const lat = Number(btn.dataset.lat);
					const lng = Number(btn.dataset.lng);
					const hasCoords = Number.isFinite(lat) && Number.isFinite(lng);
					const title = String(btn.dataset.title || 'Ubicación').trim() || 'Ubicación';
					const address = String(btn.dataset.address || '').trim();

					if (!isHubMobileViewport()) {
						if (mapsUrl) {
							window.open(mapsUrl, '_blank', 'noopener,noreferrer');
						}
						return;
					}

					openHubMapModal({
						title,
						address,
						mapsUrl,
						lat,
						lng,
						hasCoords,
					});
				});
			});
			mapModalCloseBtns.forEach((btn) => {
				btn.addEventListener('click', () => closeHubMapModal());
			});
			mapModal.addEventListener('click', (event) => {
				if (event.target === mapModal) closeHubMapModal();
			});
		}
	};

	initHubPage();
	document.addEventListener('astro:page-load', initHubPage);
	document.addEventListener('astro:before-swap', () => {
		teardownHubPageListeners();
		destroyHubMaps();
	});
</script>
