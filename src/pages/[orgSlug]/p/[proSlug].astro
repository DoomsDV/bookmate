---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import PublicSipapDepositPanel from '../../../components/PublicSipapDepositPanel.astro';
import {
	buildPublicProfileMetaDescription,
	getPublicProfileSpecialtyLabel,
	getPublicProfileWithOrds,
	PublicBookingApiError,
	type PublicBookingProfile,
} from '../../../lib/public-booking';
import {
	buildPublicProfilePath,
	resolveOgImageUrl,
	resolvePublicSiteOrigin,
} from '../../../lib/public-profile-url';
import '../../../styles/global.css';
import '../../../styles/public-booking.css';

const organizationSlug = String(Astro.params.orgSlug || '').trim();
const professionalSlug = String(Astro.params.proSlug || '').trim();

const parseLocationId = (value: string | null) => {
	const parsed = Number(value);
	return Number.isInteger(parsed) && parsed > 0 ? parsed : 0;
};

const toSafePageStatus = (status: number, hasProfile: boolean) => {
	if (hasProfile) return 200;
	const parsed = Number(status);
	if (!Number.isInteger(parsed)) return 200;

	// Keep explicit client errors, but avoid surfacing upstream server failures as document failures.
	if (parsed >= 400 && parsed < 500) return parsed;
	return 200;
};

const initialLocationId = parseLocationId(
	Astro.url.searchParams.get('loc_id') ?? Astro.url.searchParams.get('loc')
);
const stadiaMapsKey = String(import.meta.env.PUBLIC_STADIA_MAPS_KEY ?? '');

let profile: PublicBookingProfile | null = null;
let loadError = '';
let statusCode = 500;

if (!organizationSlug || !professionalSlug) {
	loadError = 'Enlace de agenda inválido.';
	statusCode = 404;
} else {
	try {
		profile = await getPublicProfileWithOrds(organizationSlug, professionalSlug);
		statusCode = 200;
	} catch (error) {
		const bookingError =
			error instanceof PublicBookingApiError
				? error
				: new PublicBookingApiError('No fue posible cargar esta agenda pública.', 500);
		loadError = bookingError.message;
		statusCode = bookingError.status || 500;
	}
}

Astro.response.status = toSafePageStatus(statusCode, Boolean(profile));
const serializedProfile = profile
	? JSON.stringify(profile).replace(/</g, '\\u003c').replace(/-->/g, '--\\>')
	: '';
const serializedLocations = profile
	? JSON.stringify(profile.locations || []).replace(/</g, '\\u003c').replace(/-->/g, '--\\>')
	: '';

const siteOrigin = resolvePublicSiteOrigin(Astro.url.origin);
const canonicalPath = buildPublicProfilePath(organizationSlug, professionalSlug) || Astro.url.pathname;

const organizationName = profile?.organization_name?.trim() || organizationSlug;
const professionalName = profile?.full_name?.trim() || professionalSlug;
const specialtyLabel = profile ? getPublicProfileSpecialtyLabel(profile.specialty) : null;

const pageTitle = profile
	? `Agendá con ${professionalName} | ${organizationName}`
	: 'Reserva online | Hasel';
const metaDescription = profile
	? buildPublicProfileMetaDescription({
			professionalName,
			organizationName,
			specialty: profile.specialty,
		})
	: 'Reservá turnos online con profesionales de la salud en Hasel.';
const ogImageAlt = profile
	? `Foto de perfil de ${professionalName} — ${organizationName}`
	: 'Hasel — reservas online';
const ogImage = profile ? resolveOgImageUrl(profile.image_url, siteOrigin) : resolveOgImageUrl('', siteOrigin);
---

<Layout
	pageTitle={pageTitle}
	metaDescription={metaDescription}
	canonicalPath={canonicalPath}
	siteOrigin={siteOrigin}
	ogImage={ogImage}
	ogImageAlt={ogImageAlt}
	ogType="website"
	robots={profile ? 'index, follow' : 'noindex, nofollow'}
>
	<main class="public-booking-shell">
		{
			loadError || !profile ? (
				<div class="public-booking-shell__canvas">
				<section class="rounded-3xl border border-rose-200 bg-rose-50 px-8 py-10 text-rose-900 shadow-sm">
					<h1 class="text-3xl font-semibold tracking-tight">No fue posible abrir esta agenda</h1>
					<p class="mt-3 text-base font-medium text-rose-800">{loadError || 'Perfil no disponible.'}</p>
					<a
						href="/"
						class="mt-6 inline-flex rounded-full bg-rose-100 px-6 py-2.5 text-sm font-medium text-rose-900 no-underline transition hover:bg-rose-200"
					>
						Volver al inicio
					</a>
				</section>
				</div>
			) : (
				<section
					class="public-booking-sheet"
					data-public-booking-root
					data-booting
					data-organization-slug={organizationSlug}
					data-professional-slug={professionalSlug}
					data-location-id={String(initialLocationId)}
					data-stadia-key={stadiaMapsKey}
				>
					<script type="application/json" id="public-booking-profile-json" set:html={serializedProfile}></script>
					<script type="application/json" id="public-booking-locations-json" set:html={serializedLocations}></script>

					<header class="public-booking-profile public-booking-profile--card" data-booking-profile-header>
						<button
							type="button"
							class="public-booking-header-back"
							data-booking-header-back
							hidden
							aria-label="Volver"
						>
							<span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
						</button>
						<div class="public-booking-profile__inner">
							<article class="public-booking-profile__card">
								<div class="public-booking-profile__body">
									<div class="public-booking-profile__media">
										{profile.image_url ? (
											<img
												src={profile.image_url}
												alt={`Foto de ${profile.full_name}`}
												loading="lazy"
												class="public-booking-avatar"
											/>
										) : (
											<div
												class="public-booking-avatar public-booking-avatar--empty"
												aria-label={`Sin foto de ${profile.full_name}`}
												role="img"
											>
												<span class="material-symbols-rounded">account_circle</span>
											</div>
										)}
									</div>
									<div class="public-booking-profile__text">
										<h1 class="public-booking-profile__title">{profile.full_name}</h1>
										{specialtyLabel ? (
											<p class="public-booking-profile__meta">{specialtyLabel}</p>
										) : null}
									</div>
								</div>
							</article>
						</div>
					</header>

					<div class="public-booking-shell__canvas">
					<div class="public-booking-stepper">
						<div class="public-booking-stepper__mobile">
							<p class="text-sm font-medium tracking-wide text-(--on-surface)" data-step-compact-label aria-live="polite">
								Paso 1 de 3: Detalles
							</p>
							<div class="h-2 flex-1 overflow-hidden rounded-full bg-(--surface-container-highest)" aria-hidden="true">
								<div class="h-full rounded-full bg-(--primary) transition-[width] duration-500 ease-out" data-step-progress-bar style="width:33%"></div>
							</div>
						</div>
						<ol data-step-indicator>
							<li data-step-item="1" class="step-item-current">1. Detalles</li>
							<li data-step-item="2" class="step-item-default">2. Fecha y Hora</li>
							<li data-step-item="3" class="step-item-default">3. Confirmación</li>
						</ol>
					</div>

					<div class="hidden rounded-2xl mb-3 px-5 py-4 text-sm font-medium shadow-sm transition-all" data-booking-toast></div>
					<span class="sr-only" data-summary-date-inline hidden aria-hidden="true"></span>

					<section data-step-panel="1" class="public-booking-panel">
						<h2 class="text-2xl font-normal tracking-tight text-(--on-surface)">¿Qué servicio desea?</h2>
						<p class="mt-2 text-base text-(--on-surface-variant)" data-step-services-hint>
							<span class="public-services-hint__desktop">Dale click al servicio que querés reservar</span>
							<span class="public-services-hint__mobile">Deslizá para elegir un servicio</span>
						</p>
				<div class="mt-6 grid gap-4 sm:grid-cols-2 public-services-grid is-service-grid" data-services-grid aria-busy="true">
						{Array.from({ length: 4 }).map(() => (
							<div class="public-service-card public-service-card--skeleton" aria-hidden="true">
								<span class="public-service-skeleton-cover"></span>
								<span class="public-service-card__body">
									<span class="public-service-skeleton-line public-service-skeleton-line--title"></span>
									<span class="public-service-skeleton-meta">
										<span class="public-service-skeleton-line public-service-skeleton-line--sm"></span>
										<span class="public-service-skeleton-line public-service-skeleton-line--price"></span>
									</span>
								</span>
							</div>
						))}
					</div>
					</section>

					<section data-step-panel="2" class="public-booking-panel hidden">
						<div>
							<div class="public-booking-selection-summary" data-selection-summary hidden>
								<span class="public-booking-selection-summary__text">
									<span class="public-booking-selection-summary__key">Servicio:</span>
									<span data-selection-summary-value></span>
								</span>
								<button type="button" class="public-booking-selection-summary__change" data-selection-summary-change>
									Cambiar
								</button>
							</div>
							<h2 class="text-2xl font-normal tracking-tight text-(--on-surface)">¿Dónde querés atenderte?</h2>
							<p class="mt-2 text-base text-(--on-surface-variant)">
								<span class="public-locations-hint__desktop">Elegí la sucursal para ver fechas y horarios disponibles</span>
								<span class="public-locations-hint__mobile">Deslizá para elegir una sucursal</span>
							</p>
						</div>
						<div class="mt-6 grid gap-3 public-locations-grid" data-locations-grid aria-busy="true"></div>
						<div class="public-booking-actions">
							<div class="public-booking-back-row">
								<button type="button" data-back-to-services class="public-booking-back-link">
									<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
									Volver
								</button>
							</div>
						</div>
					</section>

					<section data-step-panel="3" class="public-booking-panel hidden">
						<div>
							<h2 class="text-2xl font-normal tracking-tight text-(--on-surface)">Elegí fecha y hora</h2>
							<p class="mt-2 text-base text-(--on-surface-variant)">
								Seleccioná el día y después un horario disponible
							</p>
						</div>
						<div class="public-booking-calendar mt-5">
							<div class="public-booking-calendar__toolbar">
								<button type="button" data-calendar-prev class="calendar-nav-btn" aria-label="Mes anterior">
									<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
								</button>
								<p class="public-booking-calendar__month" data-calendar-month></p>
								<button type="button" data-calendar-next class="calendar-nav-btn" aria-label="Mes siguiente">
									<span class="material-symbols-rounded" aria-hidden="true">chevron_right</span>
								</button>
							</div>
							<div class="public-booking-calendar__weekdays">
								<span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span>
								<span>Vie</span><span>Sáb</span><span>Dom</span>
							</div>
							<div class="public-booking-calendar__grid" data-calendar-grid></div>
						</div>
						<div class="public-booking-datetime-slots mt-4" data-slots-under-calendar>
							<p class="public-slots-under-calendar__hint text-sm font-medium text-(--on-surface-variant)" data-slots-hint hidden>
								Horarios disponibles
							</p>
							<div data-slots-loading class="public-slots-skeleton mt-3 hidden" aria-busy="true" aria-live="polite">
								<span class="sr-only">Consultando horarios disponibles…</span>
								<div class="public-slots-skeleton__grid public-slots-skeleton__grid--pills" aria-hidden="true">
									<span class="public-slots-skeleton__chip"></span>
									<span class="public-slots-skeleton__chip"></span>
									<span class="public-slots-skeleton__chip"></span>
									<span class="public-slots-skeleton__chip"></span>
									<span class="public-slots-skeleton__chip"></span>
									<span class="public-slots-skeleton__chip"></span>
								</div>
							</div>
							<div class="mt-2 grid gap-4" data-slots-container></div>
							<div data-no-slots class="public-slots-empty mt-4 hidden">
								<span class="material-symbols-rounded public-slots-empty__icon" aria-hidden="true"
									>event_busy</span
								>
								<p class="public-slots-empty__text">
									No se encontraron horarios para este día. Elegí otra fecha.
								</p>
							</div>
						</div>
						<div class="public-booking-actions">
							<div class="public-booking-back-row">
								<button type="button" data-back-to-locations class="public-booking-back-link">
									<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
									Volver
								</button>
							</div>
							<button
								type="button"
								class="public-booking-continue"
								data-datetime-continue
								disabled
							>
								<span class="public-booking-continue__label">Continuar</span>
								<span class="material-symbols-rounded public-booking-continue__icon" aria-hidden="true">chevron_right</span>
							</button>
						</div>
					</section>

					<section data-step-panel="4" class="public-booking-panel hidden" hidden aria-hidden="true"></section>

					<section data-step-panel="5" class="public-booking-panel hidden">
						<h2 class="text-2xl font-normal tracking-tight text-(--on-surface)">Confirma tus datos</h2>
						<div class="mt-5 grid gap-5 lg:grid-cols-[1fr_22rem] lg:gap-8">
							<form class="contents lg:grid lg:gap-5" data-customer-form>
								<label class="grid gap-1.5 text-sm font-medium text-(--on-surface)">
									<span>Teléfono (WhatsApp) <span class="text-(--error)" aria-hidden="true">*</span></span>
									<div class="flex h-14 w-full overflow-hidden rounded-xl border border-(--outline) bg-(--surface-container-lowest) transition focus-within:border-(--primary) focus-within:ring-1 focus-within:ring-(--primary)">
										<span class="inline-flex items-center border-r border-(--outline) bg-(--surface-container-high) px-3 text-sm font-semibold text-(--on-surface-variant) lg:px-2.5">+595</span>
										<input type="tel" name="customer_phone" maxlength="11" required inputmode="numeric" autocomplete="tel-national" class="min-w-0 flex-1 border-0 bg-transparent px-4 text-base text-(--on-surface) placeholder-(--on-surface-variant) outline-none" placeholder="Ej: 981 123 456" />
									</div>
									<span class="hidden text-xs font-medium text-(--error)" data-field-error="customer_phone"></span>
								</label>
								<label class="hidden grid gap-1.5 text-sm font-medium text-(--on-surface)" data-customer-name-wrapper>
									<span>Nombre completo <span class="text-(--error)" aria-hidden="true">*</span></span>
									<input type="text" name="customer_name" maxlength="100" autocomplete="name" class="h-14 rounded-xl border border-(--outline) bg-(--surface-container-lowest) px-4 py-0 text-base text-(--on-surface) placeholder-(--on-surface-variant) outline-none transition focus:border-(--primary) focus:ring-1 focus:ring-(--primary)" placeholder="Ej: Juan Perez" />
								</label>
								<span class="hidden text-xs font-medium text-(--error)" data-field-error="customer_name"></span>
								<p data-submit-error class="hidden rounded-2xl bg-(--error-container) px-4 py-3 text-sm font-medium text-(--on-error-container)"></p>
								<label data-deposit-policy-wrap class="hidden flex items-start gap-3 px-0 py-1">
									<input type="checkbox" name="policy_accepted" value="1" data-deposit-policy-accept class="mt-1 size-5 accent-(--primary)" />
									<span class="grid gap-1 text-sm text-left">
										<span class="font-semibold text-(--on-surface)">Acepto la política de cancelación <span class="text-(--error)" aria-hidden="true">*</span></span>
										<span class="font-medium text-(--on-surface-variant)" data-deposit-policy-summary>—</span>
									</span>
								</label>
								<span class="hidden text-xs font-medium text-(--error) text-left" data-field-error="policy_accepted"></span>
								<p class="public-booking-notice" data-booking-stay-open-notice>
									<span class="material-symbols-rounded" aria-hidden="true">info</span>
									<span>No cierres esta página hasta confirmar. Si salís o cerrás el navegador, la cita no se reservará.</span>
								</p>
								<div class="order-3 grid gap-3 lg:order-none lg:mt-3" data-booking-primary-actions>
									<button type="submit" data-submit-booking data-submit-confirm data-booking-primary-action class="booking-primary-action inline-flex min-h-14 h-12 w-full items-center justify-center gap-2 rounded-full px-8 text-base font-medium transition disabled:cursor-not-allowed disabled:opacity-60">
										<span class="material-symbols-rounded booking-primary-action__icon" aria-hidden="true">event_available</span>
										<span class="booking-primary-action__label">Confirmar reserva</span>
									</button>
									<button type="button" data-pay-deposit-submit data-booking-primary-action class="booking-primary-action is-hidden inline-flex min-h-14 h-12 w-full items-center justify-center gap-2 rounded-full px-8 text-base font-medium transition disabled:cursor-not-allowed disabled:opacity-60"><span>Confirmar y transferir seña</span><span aria-hidden="true">🔒</span></button>
								</div>
							</form>
							<aside class="public-booking-summary order-2 self-start lg:order-none">
								<h3 class="text-xs font-bold uppercase tracking-widest text-(--primary)">Resumen</h3>
								<ul class="mt-5 grid gap-3">
									<li class="public-booking-summary__row"><span class="public-booking-summary__label">Servicio</span><span class="public-booking-summary__value" data-summary-service></span></li>
									<li class="public-booking-summary__row"><span class="public-booking-summary__label">Fecha</span><span class="public-booking-summary__value" data-summary-date></span></li>
									<li class="public-booking-summary__row"><span class="public-booking-summary__label">Hora</span><span class="public-booking-summary__value" data-summary-time></span></li>
									<li class="public-booking-summary__row"><span class="public-booking-summary__label">Ubicación</span><button type="button" class="public-location-link public-booking-summary__value cursor-pointer text-right font-normal disabled:cursor-not-allowed disabled:text-(--on-surface-variant)" data-summary-location>Ubicación no disponible</button></li>
									<li class="public-booking-summary__row public-booking-summary__row--deposit hidden" data-summary-deposit-wrap><span class="public-booking-summary__label">Seña requerida</span><span class="public-booking-summary__deposit" data-summary-deposit></span></li>
								</ul>
							</aside>
						</div>
						<div class="public-booking-actions">
							<div class="public-booking-back-row">
								<button type="button" data-back-to-slots class="public-booking-back-link">
									<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
									Volver
								</button>
							</div>
						</div>
					</section>

					<section data-step-panel="6" class="public-booking-panel public-booking-success hidden">
						<div class="public-booking-success__column">
							<div class="public-booking-success__hero">
								<span class="public-booking-success__icon" aria-hidden="true">
									<span class="material-symbols-rounded">check_circle</span>
								</span>
								<h2 class="public-booking-success__title">¡Reserva confirmada!</h2>
								<p class="public-booking-success__desc">
									¡Todo listo! Te enviamos los detalles a tu WhatsApp.
								</p>
							</div>

							<article class="booking-ticket">
								<header class="booking-ticket__header">
									<img
										alt=""
										loading="lazy"
										class="booking-ticket__avatar"
										data-ticket-avatar-img
										hidden
									/>
									<div
										class="booking-ticket__avatar booking-ticket__avatar--empty"
										data-ticket-avatar-empty
										aria-hidden="true"
									>
										<span class="material-symbols-rounded">account_circle</span>
									</div>
									<div class="booking-ticket__who">
										<p class="booking-ticket__name" data-ticket-professional></p>
										<p class="booking-ticket__org" data-ticket-organization></p>
									</div>
									<span class="booking-ticket__status" data-status="confirmed">Confirmado</span>
								</header>
								<div class="booking-ticket__service">
									<p class="booking-ticket__service-name" data-ticket-service></p>
									<p class="booking-ticket__service-meta" data-ticket-duration hidden></p>
								</div>
								<div class="booking-ticket__tear" aria-hidden="true"></div>
								<div class="booking-ticket__details">
									<div class="booking-ticket__field">
										<span class="booking-ticket__label">Fecha</span>
										<strong class="booking-ticket__value" data-ticket-date></strong>
									</div>
									<div class="booking-ticket__field">
										<span class="booking-ticket__label">Hora</span>
										<strong class="booking-ticket__value" data-ticket-time></strong>
									</div>
									<div class="booking-ticket__field">
										<span class="booking-ticket__label">Sucursal</span>
										<strong class="booking-ticket__value" data-ticket-location-name></strong>
									</div>
									<div class="booking-ticket__field">
										<span class="booking-ticket__label">Dirección</span>
										<strong class="booking-ticket__value" data-ticket-location-address></strong>
									</div>
								</div>
							</article>

							<div class="public-booking-success__actions">
								<button type="button" data-restart-booking class="public-booking-success__cta">
									Reservar otra cita
								</button>
								<a href="/" class="public-booking-success__home">Volver al inicio</a>
							</div>
						</div>
					</section>

					<PublicSipapDepositPanel stepPanel={7} />
					</div>

					<dialog class="public-map-modal" data-public-map-modal>
						<div class="public-map-modal__sheet">
							<div class="public-map-modal__handle" aria-hidden="true"><span></span></div>
							<div class="public-map-modal__header">
								<div class="min-w-0">
									<h2 class="text-xl font-semibold tracking-tight">Ubicación</h2>
									<p class="mt-1 text-sm text-(--on-surface-variant)" data-public-map-address></p>
								</div>
								<button
									type="button"
									class="grid h-10 w-10 shrink-0 place-items-center rounded-full text-(--on-surface-variant) transition hover:bg-(--surface-container-highest) hover:text-(--on-surface)"
									data-public-map-close
									aria-label="Cerrar mapa"
								>
									<span class="material-symbols-rounded">close</span>
								</button>
							</div>
							<div class="public-map-canvas-wrap relative overflow-hidden rounded-2xl bg-(--surface-container-highest)">
								<div class="h-full w-full" data-public-map-canvas></div>
								<div
									class="public-map-loading absolute inset-0 z-10 hidden place-items-center bg-(--surface-container-highest)/85 backdrop-blur-[2px]"
									data-public-map-loading
									aria-hidden="true"
									aria-live="polite"
									aria-label="Cargando mapa"
								>
									<span class="material-symbols-rounded animate-spin text-[1.75rem] text-(--primary)" aria-hidden="true">progress_activity</span>
								</div>
							</div>
