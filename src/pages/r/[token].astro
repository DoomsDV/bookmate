---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import AppAlert from '../../components/AppAlert.astro';
import {
	getPublicReservationWithOrds,
	PublicBookingApiError,
	type PublicBookingLocation,
	type PublicReservationDetail,
} from '../../lib/public-booking';
import { buildPublicProfilePath } from '../../lib/public-profile-url';
import {
	formatFriendlyTime,
	formatReservationStatusLabel,
	formatTicketDate,
	isReservationPast,
	parseApiDateTime,
} from '../../lib/booking-datetime';
import '../../styles/global.css';
import '../../styles/public-booking.css';

const token = String(Astro.params.token || '').trim();

let reservation: PublicReservationDetail | null = null;
let loadError = '';

try {
	reservation = await getPublicReservationWithOrds(token);
} catch (error) {
	const bookingError =
		error instanceof PublicBookingApiError
			? error
			: new PublicBookingApiError('No fue posible cargar esta reserva.', 500);
	loadError = bookingError.message;
	Astro.response.status = bookingError.status >= 400 && bookingError.status < 500 ? bookingError.status : 200;
}

const serializedReservation = reservation
	? JSON.stringify((() => {
			const {
				service_includes: _includes,
				visit_history: _history,
				last_recommendations: _recs,
				...manageReservation
			} = reservation;
			return manageReservation;
		})()).replace(/</g, '\\u003c').replace(/-->/g, '--\\>')
	: '';

const isCancelled =
	Boolean(reservation) && String(reservation?.status || '').trim().toUpperCase() === 'CANCELADO';
const refundStatus = String(reservation?.refund_status || '').trim().toUpperCase();
const awaitsRefundAlias = isCancelled && refundStatus === 'AWAITING_ALIAS';
const refundPending = isCancelled && refundStatus === 'PENDING';
const refundSent = isCancelled && refundStatus === 'SENT';
const canClaimRefund =
	refundPending &&
	Number(reservation?.can_claim_refund || 0) === 1 &&
	Number(reservation?.refund_claim_open || 0) === 0;
const claimAlreadyOpen =
	refundPending && Number(reservation?.refund_claim_open || 0) === 1;
const refundAmountLabel =
	reservation?.refund_amount != null
		? new Intl.NumberFormat('es-PY', {
				style: 'currency',
				currency: 'PYG',
				maximumFractionDigits: 0,
			}).format(Number(reservation.refund_amount) || 0)
		: '';
const reservationStart = reservation ? parseApiDateTime(reservation.start_time) : null;
const formattedCurrentDate = reservationStart ? formatTicketDate(reservationStart) : '';
const formattedCurrentTime = reservationStart ? `${formatFriendlyTime(reservationStart)} hs` : '';
const isPastReservation =
	Boolean(reservation) && !isCancelled && isReservationPast(reservation);
const statusMeta = formatReservationStatusLabel(reservation?.status || '', {
	isPast: isPastReservation,
});
const professionalSlug = String(reservation?.professional_slug || '').trim();
const organizationSlug = String(reservation?.organization_slug || '').trim();
const rebookHref =
	organizationSlug && professionalSlug
		? buildPublicProfilePath(organizationSlug, professionalSlug)
		: professionalSlug
			? `/p/${professionalSlug}`
			: '/';
const stadiaMapsKey = String(import.meta.env.PUBLIC_STADIA_MAPS_KEY ?? '');

// locations[]/professional_image_url/service_image_url ya vienen en el detalle
// de la reserva (Fase 6 N+1): evita el 2do fetch que antes hacía getPublicProfileWithOrds
// solo para obtener estos campos.
let reservationLocations: PublicBookingLocation[] =
	reservation?.locations && reservation.locations.length > 0 ? reservation.locations : [];
const professionalImageUrl = String(reservation?.professional_image_url || '').trim();
const durationMinutes = Number(reservation?.duration_minutes || 0) || 0;

if (reservation && reservationLocations.length === 0) {
	reservationLocations = [
		{
			id_location: reservation.loc_id_location,
			name: reservation.location_name,
			address: reservation.location_address,
		},
	];
}

const professionalDisplayName = String(reservation?.professional_name || '').trim();
const organizationDisplayName =
	String(reservation?.organization_name || '').trim() || organizationSlug || 'Hasel';
const locationAddress = String(reservation?.location_address || '').trim();
const durationLabel = durationMinutes > 0 ? `${durationMinutes} min` : '';
const serviceIncludes = reservation?.service_includes?.filter(Boolean) ?? [];
const visitHistory = reservation?.visit_history ?? [];
const visitHistoryCount = Number(reservation?.visit_history_count ?? visitHistory.length) || 0;
const professionalFirstName =
	professionalDisplayName.split(/\s+/).find(Boolean) || professionalDisplayName || 'este profesional';
const serializedLocations = reservation
	? JSON.stringify(reservationLocations).replace(/</g, '\\u003c').replace(/-->/g, '--\\>')
	: '';
const pageTitle = reservation ? 'Gestionar reserva | Hasel' : 'Reserva no encontrada | Hasel';
---

<Layout pageTitle={pageTitle} robots="noindex, nofollow">
	<main class="public-booking-shell reservation-shell relative z-10 mx-auto min-h-dvh w-full max-w-3xl px-3 sm:px-5 md:px-6">
		<div aria-hidden="true" class="pointer-events-none fixed inset-0 z-[-1] bg-(--surface-background)"></div>
		<section
			class="reservation-manage"
			data-reservation-root
			data-token={token}
			data-stadia-key={stadiaMapsKey}
		>
			{loadError || !reservation ? (
				<div class="reservation-state">
					<span class="material-symbols-rounded" aria-hidden="true">event_busy</span>
					<h1>No encontramos esta reserva</h1>
					<p>{loadError || 'El enlace puede haber expirado o no existe.'}</p>
					<a href="/" class="reservation-link">Volver al inicio</a>
				</div>
			) : (
				<>
					<script type="application/json" id="reservation-json" set:html={serializedReservation}></script>
					<script type="application/json" id="reservation-locations-json" set:html={serializedLocations}></script>

					<article class="public-booking-sheet reservation-manage__sheet">
						<div class="reservation-manage__column">
						<h1 class="reservation-manage__title">Gestionar reserva</h1>

						<div class="reservation-manage__body">
							<article class="booking-ticket">
								<header class="booking-ticket__header">
									{professionalImageUrl ? (
										<img
											src={professionalImageUrl}
											alt={`Foto de ${professionalDisplayName}`}
											loading="lazy"
											class="booking-ticket__avatar"
										/>
									) : (
										<div
											class="booking-ticket__avatar booking-ticket__avatar--empty"
											aria-label={`Sin foto de ${professionalDisplayName}`}
											role="img"
										>
											<span class="material-symbols-rounded">account_circle</span>
										</div>
									)}
									<div class="booking-ticket__who">
										<p class="booking-ticket__name">{professionalDisplayName}</p>
										<p class="booking-ticket__org">{organizationDisplayName}</p>
									</div>
									<span
										class="booking-ticket__status"
										data-status-text
										data-status={statusMeta.variant}
									>
										{statusMeta.label}
									</span>
								</header>

								<div class="booking-ticket__service">
									<p class="booking-ticket__service-name">{reservation.service_name}</p>
									{durationLabel && (
										<p class="booking-ticket__service-meta">{durationLabel}</p>
									)}
								</div>

								{serviceIncludes.length > 0 && (
									<ul class="booking-ticket__includes">
										{serviceIncludes.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								)}

								<div class="booking-ticket__tear" aria-hidden="true"></div>

								<div class="booking-ticket__details">
									<div class="booking-ticket__field">
										<span class="booking-ticket__label">Fecha</span>
										<strong class="booking-ticket__value" data-current-date>
											{formattedCurrentDate}
										</strong>
									</div>
									<div class="booking-ticket__field">
										<span class="booking-ticket__label">Hora</span>
										<strong class="booking-ticket__value" data-current-time>
											{formattedCurrentTime}
										</strong>
									</div>
									<div class="booking-ticket__field">
										<span class="booking-ticket__label">Sucursal</span>
										<strong class="booking-ticket__value" data-location-name>
											{reservation.location_name}
										</strong>
									</div>
									{isCancelled || isPastReservation ? (
										<div class="booking-ticket__field">
											<span class="booking-ticket__label">Dirección</span>
											<strong class="booking-ticket__value" data-location-address>
												{locationAddress || '—'}
											</strong>
										</div>
									) : locationAddress ? (
										<button
											type="button"
											class="booking-ticket__field booking-ticket__field--map"
											data-manage-open-map
											aria-label={`Ver mapa de ${reservation.location_name}`}
										>
											<span class="booking-ticket__label">Dirección</span>
											<strong class="booking-ticket__value" data-location-address>
												{locationAddress}
											</strong>
										</button>
									) : (
										<div class="booking-ticket__field">
											<span class="booking-ticket__label">Dirección</span>
											<strong class="booking-ticket__value" data-location-address>
												—
											</strong>
										</div>
									)}
								</div>
							</article>

							{visitHistoryCount > 0 && (
								<p class="reservation-manage__history-summary">
									<span>
										Citas previas con {professionalFirstName}: {visitHistoryCount}
									</span>
									<button type="button" data-open-visit-history-modal>
										Ver historial completo
									</button>
								</p>
							)}

							{isCancelled ? (
								<div class="reservation-manage__notice" data-reservation-cancelled>
									{awaitsRefundAlias ? (
										<>
											<p class="reservation-cancelled-text">
												Tu turno fue cancelado. Para recibir el reembolso
												{refundAmountLabel ? ` de ${refundAmountLabel}` : ''}, cargá tu alias SIPAP.
											</p>
											<form class="mt-4 grid gap-3" data-refund-alias-form>
												<label class="grid gap-1 text-sm font-semibold text-(--on-surface)">
													Alias SIPAP
													<input
														type="text"
														name="refund_alias"
														required
														maxlength="100"
														placeholder="CI, Celular, Email o RUC"
														class="rounded-2xl border border-(--outline-variant) bg-(--surface-bright) px-4 py-3 text-base font-normal"
														data-refund-alias-input
													/>
												</label>
												<button type="submit" class="reservation-primary-action" data-refund-alias-submit disabled>
													Enviar alias para reembolso
												</button>
												<p class="m-0 text-sm text-(--on-surface-variant)" data-refund-alias-status></p>
											</form>
										</>
									) : refundPending ? (
										<>
											<p class="reservation-cancelled-text">
												Reserva cancelada. Tu reembolso
												{refundAmountLabel ? ` de ${refundAmountLabel}` : ''} está pendiente: el comercio te transferirá en hasta 48 horas hábiles.
											</p>
											{claimAlreadyOpen ? (
												<p class="mt-3 text-sm font-semibold text-amber-700">
													Ya registraste un reclamo. Hasel está al tanto.
												</p>
											) : canClaimRefund ? (
												<div class="mt-4 grid gap-2" data-refund-claim-wrap>
													<p class="m-0 text-sm text-(--on-surface-variant)">
														Pasaron las 48 horas hábiles y aún no marcó el reembolso como enviado.
													</p>
													<button type="button" class="reservation-danger" data-refund-claim-submit>
														Reclamar reembolso
													</button>
													<p class="m-0 text-sm text-(--on-surface-variant)" data-refund-claim-status></p>
												</div>
											) : null}
											<a href={rebookHref} class="reservation-link">Volver a reservar</a>
										</>
									) : refundSent ? (
										<>
											<p class="reservation-cancelled-text">
												Reserva cancelada. El reembolso
												{refundAmountLabel ? ` de ${refundAmountLabel}` : ''} ya fue marcado como enviado.
											</p>
											<a href={rebookHref} class="reservation-link">Volver a reservar</a>
										</>
									) : (
										<>
											<p class="reservation-cancelled-text">
												Esta reserva se encuentra cancelada. Si deseas, puedes agendar un nuevo turno con el profesional.
											</p>
											<a href={rebookHref} class="reservation-link">Volver a reservar</a>
										</>
									)}
								</div>
							) : isPastReservation ? (
								<div class="reservation-manage__notice" data-reservation-past>
									<p class="reservation-cancelled-text">
										Esta reserva ya finalizó. Ya no es posible reprogramarla ni cancelarla desde este enlace.
									</p>
									<a href={rebookHref} class="reservation-link">Volver a reservar</a>
								</div>
							) : (
								<div class="reservation-manage__actions">
									<button
										type="button"
										class="reservation-primary-action"
										data-open-reschedule-modal
									>
										<span class="material-symbols-rounded" aria-hidden="true">event_repeat</span>
										Reprogramar reserva
									</button>
									<button type="button" class="reservation-manage__cancel" data-cancel-reservation>
										Cancelar reserva
									</button>
								</div>
							)}
						</div>
						</div>
					</article>

					<dialog
						class="public-map-modal rounded-[28px] border-0 bg-(--surface-bright) p-0 text-(--on-surface) shadow-[0_24px_64px_rgba(0,0,0,0.55)] backdrop:bg-black/70"
						data-public-map-modal
					>
						<div class="grid gap-5 p-6">
							<div class="flex items-start justify-between gap-4">
								<div>
									<h2 class="text-xl font-semibold tracking-tight">Ubicación</h2>
									<p class="mt-1 text-sm text-(--on-surface-variant)" data-public-map-address></p>
								</div>
								<button
									type="button"
									class="grid h-10 w-10 place-items-center rounded-full text-(--on-surface-variant) transition hover:bg-(--surface-container-highest) hover:text-(--on-surface)"
									data-public-map-close
									aria-label="Cerrar mapa"
								>
									<span class="material-symbols-rounded">close</span>
								</button>
							</div>
							<div class="public-map-canvas-wrap relative h-96 overflow-hidden rounded-2xl bg-(--surface-container-highest)">
								<div class="h-full w-full" data-public-map-canvas></div>
								<div
									class="public-map-loading absolute inset-0 z-10 hidden place-items-center bg-(--surface-container-highest)/85 backdrop-blur-[2px]"
									data-public-map-loading
									aria-hidden="true"
									aria-live="polite"
									aria-label="Cargando mapa"
								>
									<span class="material-symbols-rounded animate-spin text-[1.75rem] text-(--primary)" aria-hidden="true">progress_activity</span>
								</div>
							</div>
							<p
								class="hidden rounded-2xl bg-(--error-container) px-4 py-3 text-sm font-medium text-(--on-error-container)"
								data-public-map-status
							></p>
						</div>
					</dialog>

					{visitHistoryCount > 0 && (
						<dialog class="reservation-history-modal" data-visit-history-modal>
							<div class="reservation-history-modal__sheet">
								<div class="reservation-history-modal__handle" aria-hidden="true">
									<span></span>
								</div>
								<div class="reservation-history-modal__header">
									<div>
										<h2 class="reservation-history-modal__title">
											Citas con {professionalFirstName}
										</h2>
										<p class="reservation-history-modal__subtitle">
											{visitHistoryCount} {visitHistoryCount === 1 ? 'visita previa' : 'visitas previas'}
										</p>
									</div>
									<button
										type="button"
										class="reservation-history-modal__close"
										data-visit-history-close
										aria-label="Cerrar historial"
									>
										<span class="material-symbols-rounded">close</span>
									</button>
								</div>
								<div class="reservation-history-modal__scroll">
									<ul class="reservation-history-modal__list">
										{visitHistory.map((visit) => {
											const visitStart = parseApiDateTime(visit.start_time);
											const visitStatus = formatReservationStatusLabel(visit.status, {
												isPast: String(visit.status).toUpperCase() === 'CONFIRMADO',
											});
											return (
												<li class="reservation-history-modal__item">
													<span class="reservation-history-modal__service">
														{visit.service_name}
													</span>
													<span class="reservation-history-modal__meta">
														{visitStart ? formatTicketDate(visitStart) : visit.start_time}
														{' · '}
														{visitStatus.label}
													</span>
												</li>
											);
										})}
									</ul>
								</div>
							</div>
						</dialog>
					)}

					{!isCancelled && !isPastReservation && (
					<>
					<dialog
						class="reservation-reschedule-modal m-0 mt-auto mb-0 w-screen max-w-none open:flex open:flex-col max-h-[88dvh] overflow-hidden rounded-t-[1.75rem] rounded-b-none border border-(--outline-variant) border-b-0 bg-(--surface-container) p-0 text-(--on-surface) shadow-2xl backdrop:bg-black/70 md:m-auto md:mb-auto md:w-[min(42rem,calc(100vw-2rem))] md:max-w-[min(42rem,calc(100vw-2rem))] md:max-h-[min(90vh,52rem)] md:rounded-[28px] md:border-b"
						data-cancel-refund-modal
					>
						<form class="reservation-reschedule-form p-5 sm:p-6" data-cancel-refund-form>
							<div class="reservation-reschedule-header !mb-4">
								<div>
									<h2 class="reservation-reschedule-title">Cancelar y pedir reembolso</h2>
									<p class="mt-1 text-sm text-(--on-surface-variant)" data-cancel-refund-summary></p>
								</div>
								<button type="button" class="reservation-modal-close" data-cancel-refund-close aria-label="Cerrar">
									<span class="material-symbols-rounded" aria-hidden="true">close</span>
								</button>
							</div>
							<label class="grid gap-1 text-sm font-semibold text-(--on-surface)">
								Tu alias SIPAP
								<input
									type="text"
									required
									maxlength="100"
									placeholder="CI, Celular, Email o RUC"
									class="rounded-2xl border border-(--outline-variant) bg-(--surface-bright) px-4 py-3 text-base font-normal"
									data-cancel-refund-alias
								/>
							</label>
							<p class="mt-2 text-sm text-(--on-surface-variant)">
								El comercio te transferirá el reembolso en hasta 48 horas hábiles después de enviar el alias.
							</p>
							<div class="mt-5 flex w-full md:justify-end">
								<button type="submit" class="reservation-danger w-full md:w-auto" data-cancel-refund-submit disabled>
									Confirmar cancelación
								</button>
							</div>
						</form>
					</dialog>

					<dialog
						class="reservation-reschedule-modal m-0 mt-auto mb-0 w-screen max-w-none open:flex open:flex-col max-h-[90dvh] overflow-hidden rounded-t-[1.75rem] rounded-b-none border border-(--outline-variant) border-b-0 bg-(--surface-container) p-0 text-(--on-surface) shadow-2xl backdrop:bg-black/70 md:m-auto md:mb-auto md:w-[min(42rem,calc(100vw-2rem))] md:max-w-[min(42rem,calc(100vw-2rem))] md:max-h-[min(90vh,52rem)] md:rounded-[28px] md:border-b"
						data-reschedule-modal
					>
						<form class="reservation-reschedule-form" data-reservation-form data-reschedule-step="1">
							<div class="reservation-reschedule-header">
								<div>
									<h2 class="reservation-reschedule-title" data-reschedule-modal-title>Elige una nueva fecha y horario</h2>
								</div>
								<button
									type="button"
									class="reservation-modal-close"
									data-reschedule-close
									aria-label="Cerrar"
								>
									<span class="material-symbols-rounded" aria-hidden="true">close</span>
								</button>
							</div>

							<div class="reservation-reschedule-stepper public-booking-stepper">
								<div class="public-booking-stepper__mobile">
									<p
										class="text-sm font-medium tracking-wide text-(--on-surface)"
										data-reschedule-step-compact-label
										aria-live="polite"
									>
										Paso 1 de 4: Fecha
									</p>
									<div
										class="h-2 flex-1 overflow-hidden rounded-full bg-(--surface-container-highest)"
										aria-hidden="true"
									>
										<div
											class="h-full rounded-full bg-(--primary) transition-[width] duration-500 ease-out"
											data-reschedule-step-progress-bar
											style="width:25%"
										></div>
									</div>
								</div>
								<ol data-reschedule-step-indicator>
									<li data-reschedule-step-item="1" class="step-item-current">1. Fecha</li>
									<li data-reschedule-step-item="2" class="step-item-default">2. Sucursal</li>
									<li data-reschedule-step-item="3" class="step-item-default">3. Horario</li>
									<li data-reschedule-step-item="4" class="step-item-default">4. Confirmar</li>
								</ol>
							</div>

							<div class="reservation-reschedule-body">
								<section data-reschedule-step-panel="1" class="grid gap-3 reservation-reschedule-panel">
									<div class="reservation-reschedule-panel__intro">
										<h3 class="reservation-reschedule-panel__title">Selecciona una fecha</h3>
									</div>

									<div class="public-booking-calendar">
										<div class="public-booking-calendar__toolbar">
											<button type="button" data-calendar-prev class="calendar-nav-btn" aria-label="Mes anterior">
												<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
											</button>
											<p class="public-booking-calendar__month" data-calendar-month></p>
											<button type="button" data-calendar-next class="calendar-nav-btn" aria-label="Mes siguiente">
												<span class="material-symbols-rounded" aria-hidden="true">chevron_right</span>
											</button>
										</div>
										<div class="public-booking-calendar__weekdays">
											<span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span>
											<span>Vie</span><span>Sáb</span><span>Dom</span>
										</div>
										<div class="public-booking-calendar__grid" data-calendar-grid></div>
									</div>
								</section>

								<section data-reschedule-step-panel="2" class="hidden grid gap-3 reservation-reschedule-panel">
									<p class="reservation-reschedule-panel__hint">
										<span class="public-locations-hint__desktop">Elegí la sucursal para ver horarios disponibles</span>
										<span class="public-locations-hint__mobile">Deslizá para elegir una sucursal</span>
									</p>

									<div
										data-reservation-locations-loading
										class="hidden rounded-2xl bg-(--surface-container-high) px-5 py-4 text-base font-medium text-(--on-surface-variant)"
