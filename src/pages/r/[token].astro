---
import Layout from '../../layouts/Layout.astro';
import AppAlert from '../../components/AppAlert.astro';
import {
	getPublicProfileWithOrds,
	getPublicReservationWithOrds,
	normalizePublicBookingLocations,
	PublicBookingApiError,
	type PublicBookingLocation,
	type PublicReservationDetail,
} from '../../lib/public-booking';
import { buildPublicProfilePath } from '../../lib/public-profile-url';
import {
	formatHumanDateTime,
	isReservationPast,
	parseApiDateTime,
} from '../../lib/booking-datetime';
import '../../styles/global.css';
import '../../styles/public-booking.css';

const token = String(Astro.params.token || '').trim();

let reservation: PublicReservationDetail | null = null;
let loadError = '';

try {
	reservation = await getPublicReservationWithOrds(token);
} catch (error) {
	const bookingError =
		error instanceof PublicBookingApiError
			? error
			: new PublicBookingApiError('No fue posible cargar esta reserva.', 500);
	loadError = bookingError.message;
	Astro.response.status = bookingError.status >= 400 && bookingError.status < 500 ? bookingError.status : 200;
}

const serializedReservation = reservation
	? JSON.stringify(reservation).replace(/</g, '\\u003c').replace(/-->/g, '--\\>')
	: '';

const isCancelled =
	Boolean(reservation) && String(reservation?.status || '').trim().toUpperCase() === 'CANCELADO';
const refundStatus = String(reservation?.refund_status || '').trim().toUpperCase();
const awaitsRefundAlias = isCancelled && refundStatus === 'AWAITING_ALIAS';
const refundPending = isCancelled && refundStatus === 'PENDING';
const refundSent = isCancelled && refundStatus === 'SENT';
const canClaimRefund =
	refundPending &&
	Number((reservation as any)?.can_claim_refund || 0) === 1 &&
	Number((reservation as any)?.refund_claim_open || 0) === 0;
const claimAlreadyOpen =
	refundPending && Number((reservation as any)?.refund_claim_open || 0) === 1;
const refundAmountLabel =
	reservation?.refund_amount != null
		? new Intl.NumberFormat('es-PY', {
				style: 'currency',
				currency: 'PYG',
				maximumFractionDigits: 0,
			}).format(Number(reservation.refund_amount) || 0)
		: '';
const reservationStart = reservation ? parseApiDateTime(reservation.start_time) : null;
const formattedCurrentDate = reservationStart ? formatHumanDateTime(reservationStart) : '';
const isPastReservation =
	Boolean(reservation) && !isCancelled && isReservationPast(reservation);
const professionalSlug = String(reservation?.professional_slug || '').trim();
const organizationSlug = String(reservation?.organization_slug || '').trim();
const rebookHref =
	organizationSlug && professionalSlug
		? buildPublicProfilePath(organizationSlug, professionalSlug)
		: professionalSlug
			? `/p/${professionalSlug}`
			: '/';
const googleMapsApiKey =
	import.meta.env.PUBLIC_G_MAPS_API_KEY ??
	import.meta.env.PUBLIC_G_MAPS_API_KEYS ??
	'';

let reservationLocations: PublicBookingLocation[] = [];
let professionalImageUrl = '';
let organizationName = '';
let serviceImageUrl = '';
let durationMinutes = 0;

if (reservation && organizationSlug && professionalSlug) {
	try {
		const profile = await getPublicProfileWithOrds(organizationSlug, professionalSlug);
		reservationLocations = normalizePublicBookingLocations(profile.locations);
		professionalImageUrl = String(profile.image_url || '').trim();
		organizationName = String(profile.organization_name || '').trim();
		durationMinutes = Number(reservation.duration_minutes || 0) || 0;
		const matchedService = Array.isArray(profile.services)
			? profile.services.find((svc) => Number(svc.id_service) === Number(reservation.ser_id_service))
			: null;
		serviceImageUrl = String(matchedService?.image_url || '').trim();
	} catch {
		reservationLocations = [];
	}
}

if (reservation && reservationLocations.length === 0) {
	reservationLocations = [
		{
			id_location: reservation.loc_id_location,
			name: reservation.location_name,
			address: reservation.location_address,
		},
	];
}

if (reservation && !durationMinutes) {
	durationMinutes = Number(reservation.duration_minutes || 0) || 0;
}

const professionalDisplayName = String(reservation?.professional_name || '').trim();
const organizationDisplayName = organizationName || organizationSlug || 'Hasel';
const locationAddress = String(reservation?.location_address || '').trim();
const durationLabel = durationMinutes > 0 ? `${durationMinutes} min` : '';

const serializedLocations = reservation
	? JSON.stringify(reservationLocations).replace(/</g, '\\u003c').replace(/-->/g, '--\\>')
	: '';
---

<Layout>
	<main class="public-booking-shell reservation-shell relative z-10 mx-auto min-h-screen w-full max-w-3xl px-3 py-6 sm:px-5 md:px-6 lg:py-8">
		<div aria-hidden="true" class="pointer-events-none fixed inset-0 z-[-1] bg-(--surface-background)"></div>
		<section
			class="reservation-manage"
			data-reservation-root
			data-token={token}
			data-google-maps-api-key={googleMapsApiKey}
		>
			{loadError || !reservation ? (
				<div class="reservation-state">
					<span class="material-symbols-rounded" aria-hidden="true">event_busy</span>
					<h1>No encontramos esta reserva</h1>
					<p>{loadError || 'El enlace puede haber expirado o no existe.'}</p>
					<a href="/" class="reservation-link">Volver al inicio</a>
				</div>
			) : (
				<>
					<script type="application/json" id="reservation-json" set:html={serializedReservation}></script>
					<script type="application/json" id="reservation-locations-json" set:html={serializedLocations}></script>

					<article class="public-booking-sheet reservation-manage__sheet">
						<header class="public-booking-profile reservation-manage__profile">
							<div class="public-booking-profile__inner">
								{professionalImageUrl ? (
									<img
										src={professionalImageUrl}
										alt={`Foto de ${professionalDisplayName}`}
										loading="lazy"
										class="public-booking-avatar"
									/>
								) : (
									<div
										class="public-booking-avatar public-booking-avatar--empty"
										aria-label={`Sin foto de ${professionalDisplayName}`}
										role="img"
									>
										<span class="material-symbols-rounded">account_circle</span>
									</div>
								)}
								<div class="public-booking-profile__text">
									<p class="public-booking-profile__eyebrow">{organizationDisplayName}</p>
									<h1 class="public-booking-profile__title">{professionalDisplayName}</h1>
									<p class="public-booking-profile__subtitle">Gestionar reserva</p>
								</div>
							</div>
						</header>

						<div class="reservation-manage__body">
							<div class="reservation-manage__hero">
								<div class="reservation-manage__schedule">
									<span class="reservation-manage__schedule-icon material-symbols-rounded" aria-hidden="true">
										calendar_month
									</span>
									<div class="reservation-manage__schedule-text">
										<span class="reservation-manage__micro">Horario actual</span>
										<strong class="reservation-manage__schedule-value" data-current-date>
											{formattedCurrentDate}
										</strong>
									</div>
									<span class="reservation-manage__status" data-status-text>{reservation.status}</span>
								</div>

								<div class="reservation-manage__service">
									{serviceImageUrl ? (
										<img
											src={serviceImageUrl}
											alt=""
											loading="lazy"
											class="reservation-manage__service-thumb"
										/>
									) : (
										<span class="reservation-manage__service-thumb reservation-manage__service-thumb--empty" aria-hidden="true">
											<span class="material-symbols-rounded">spa</span>
										</span>
									)}
									<div class="reservation-manage__service-text">
										<span class="reservation-manage__micro">Servicio</span>
										<strong class="reservation-manage__service-name">{reservation.service_name}</strong>
										{durationLabel && (
											<span class="reservation-manage__service-meta">{durationLabel}</span>
										)}
									</div>
								</div>
							</div>

							{isCancelled || isPastReservation ? (
								<div class="reservation-manage__location">
									<span class="reservation-manage__location-icon material-symbols-rounded" aria-hidden="true">
										location_on
									</span>
									<span class="reservation-manage__location-text">
										<span class="reservation-manage__micro">Sucursal</span>
										<strong class="reservation-manage__location-name" data-location-name>
											{reservation.location_name}
										</strong>
										{locationAddress && (
											<span class="reservation-manage__location-address">{locationAddress}</span>
										)}
									</span>
								</div>
							) : (
								<button
									type="button"
									class="reservation-manage__location"
									data-manage-open-map
									aria-label={`Ver mapa de ${reservation.location_name}`}
								>
									<span class="reservation-manage__location-icon material-symbols-rounded" aria-hidden="true">
										location_on
									</span>
									<span class="reservation-manage__location-text">
										<span class="reservation-manage__micro">Sucursal</span>
										<strong class="reservation-manage__location-name" data-location-name>
											{reservation.location_name}
										</strong>
										{locationAddress && (
											<span class="reservation-manage__location-address">{locationAddress}</span>
										)}
									</span>
									<span class="reservation-manage__location-chevron material-symbols-rounded" aria-hidden="true">
										chevron_right
									</span>
								</button>
							)}

							<ul class="reservation-manage__meta">
								<li class="reservation-manage__meta-row">
									<span class="material-symbols-rounded" aria-hidden="true">person</span>
									<span class="reservation-manage__meta-copy">
										<span class="reservation-manage__micro">Cliente</span>
										<strong>{reservation.customer_name}</strong>
									</span>
								</li>
							</ul>

							{isCancelled ? (
								<div class="reservation-manage__notice" data-reservation-cancelled>
									{awaitsRefundAlias ? (
										<>
											<p class="reservation-cancelled-text">
												Tu turno fue cancelado. Para recibir el reembolso
												{refundAmountLabel ? ` de ${refundAmountLabel}` : ''}, cargá tu alias SIPAP.
											</p>
											<form class="mt-4 grid gap-3" data-refund-alias-form>
												<label class="grid gap-1 text-sm font-semibold text-(--on-surface)">
													Alias SIPAP
													<input
														type="text"
														name="refund_alias"
														required
														minlength="3"
														maxlength="100"
														placeholder="Ej. 0981XXXXXX"
														class="rounded-2xl border border-(--outline-variant) bg-(--surface-bright) px-4 py-3 text-base font-normal"
														data-refund-alias-input
													/>
												</label>
												<button type="submit" class="reservation-primary-action" data-refund-alias-submit>
													Enviar alias para reembolso
												</button>
												<p class="m-0 text-sm text-(--on-surface-variant)" data-refund-alias-status></p>
											</form>
										</>
									) : refundPending ? (
										<>
											<p class="reservation-cancelled-text">
												Reserva cancelada. Tu reembolso
												{refundAmountLabel ? ` de ${refundAmountLabel}` : ''} está pendiente: el comercio te transferirá en hasta 48 horas hábiles.
											</p>
											{claimAlreadyOpen ? (
												<p class="mt-3 text-sm font-semibold text-amber-700">
													Ya registraste un reclamo. Hasel está al tanto.
												</p>
											) : canClaimRefund ? (
												<div class="mt-4 grid gap-2" data-refund-claim-wrap>
													<p class="m-0 text-sm text-(--on-surface-variant)">
														Pasaron las 48 horas hábiles y aún no marcó el reembolso como enviado.
													</p>
													<button type="button" class="reservation-danger" data-refund-claim-submit>
														Reclamar reembolso
													</button>
													<p class="m-0 text-sm text-(--on-surface-variant)" data-refund-claim-status></p>
												</div>
											) : null}
											<a href={rebookHref} class="reservation-link">Volver a reservar</a>
										</>
									) : refundSent ? (
										<>
											<p class="reservation-cancelled-text">
												Reserva cancelada. El reembolso
												{refundAmountLabel ? ` de ${refundAmountLabel}` : ''} ya fue marcado como enviado.
											</p>
											<a href={rebookHref} class="reservation-link">Volver a reservar</a>
										</>
									) : (
										<>
											<p class="reservation-cancelled-text">
												Esta reserva se encuentra cancelada. Si deseas, puedes agendar un nuevo turno con el profesional.
											</p>
											<a href={rebookHref} class="reservation-link">Volver a reservar</a>
										</>
									)}
								</div>
							) : isPastReservation ? (
								<div class="reservation-manage__notice" data-reservation-past>
									<p class="reservation-cancelled-text">
										Esta reserva ya finalizó. Ya no es posible reprogramarla ni cancelarla desde este enlace.
									</p>
									<a href={rebookHref} class="reservation-link">Volver a reservar</a>
								</div>
							) : (
								<div class="reservation-manage__actions">
									<button
										type="button"
										class="reservation-primary-action"
										data-open-reschedule-modal
									>
										<span class="material-symbols-rounded" aria-hidden="true">event_repeat</span>
										Reprogramar reserva
									</button>
									<button type="button" class="reservation-danger" data-cancel-reservation>
										<span class="material-symbols-rounded" aria-hidden="true">event_busy</span>
										Cancelar reserva
									</button>
								</div>
							)}
						</div>
					</article>

					<dialog
						class="public-map-modal rounded-[28px] border-0 bg-(--surface-container-high) p-0 text-(--on-surface) shadow-[0_24px_64px_rgba(0,0,0,0.55)] backdrop:bg-black/70"
						data-public-map-modal
					>
						<div class="grid gap-5 p-6">
							<div class="flex items-start justify-between gap-4">
								<div>
									<h2 class="text-xl font-semibold tracking-tight">Ubicación</h2>
									<p class="mt-1 text-sm text-(--on-surface-variant)" data-public-map-address></p>
								</div>
								<button
									type="button"
									class="grid h-10 w-10 place-items-center rounded-full text-(--on-surface-variant) transition hover:bg-(--surface-container-highest) hover:text-(--on-surface)"
									data-public-map-close
									aria-label="Cerrar mapa"
								>
									<span class="material-symbols-rounded">close</span>
								</button>
							</div>
							<div class="public-map-canvas-wrap relative h-96 overflow-hidden rounded-2xl bg-(--surface-container-highest)">
								<div class="h-full w-full" data-public-map-canvas></div>
								<div
									class="public-map-loading absolute inset-0 z-10 hidden place-items-center bg-(--surface-container-highest)/85 backdrop-blur-[2px]"
									data-public-map-loading
									aria-hidden="true"
									aria-live="polite"
									aria-label="Cargando mapa"
								>
									<span class="material-symbols-rounded animate-spin text-[1.75rem] text-(--primary)" aria-hidden="true">progress_activity</span>
								</div>
							</div>
							<p
								class="hidden rounded-2xl bg-(--error-container) px-4 py-3 text-sm font-medium text-(--on-error-container)"
								data-public-map-status
							></p>
						</div>
					</dialog>

					{!isCancelled && !isPastReservation && (
					<>
					<dialog
						class="reservation-reschedule-modal m-0 mt-auto mb-0 w-screen max-w-none open:flex open:flex-col max-h-[88dvh] overflow-hidden rounded-t-[1.75rem] rounded-b-none border border-(--outline-variant) border-b-0 bg-(--surface-container) p-0 text-(--on-surface) shadow-2xl backdrop:bg-black/70 sm:m-auto sm:mb-auto sm:w-[min(42rem,calc(100vw-2rem))] sm:max-w-[min(42rem,calc(100vw-2rem))] sm:max-h-[min(90vh,52rem)] sm:rounded-[28px] sm:border-b"
						data-cancel-refund-modal
					>
						<form class="reservation-reschedule-form p-5 sm:p-6" data-cancel-refund-form>
							<div class="reservation-reschedule-header !mb-4">
								<div>
									<h2 class="reservation-reschedule-title">Cancelar y pedir reembolso</h2>
									<p class="mt-1 text-sm text-(--on-surface-variant)" data-cancel-refund-summary></p>
								</div>
								<button type="button" class="reservation-modal-close" data-cancel-refund-close aria-label="Cerrar">
									<span class="material-symbols-rounded" aria-hidden="true">close</span>
								</button>
							</div>
							<label class="grid gap-1 text-sm font-semibold text-(--on-surface)">
								Tu alias SIPAP
								<input
									type="text"
									required
									minlength="3"
									maxlength="100"
									placeholder="Ej. 0981XXXXXX"
									class="rounded-2xl border border-(--outline-variant) bg-(--surface-bright) px-4 py-3 text-base font-normal"
									data-cancel-refund-alias
								/>
							</label>
							<p class="mt-2 text-sm text-(--on-surface-variant)">
								El comercio te transferirá el reembolso en hasta 48 horas hábiles después de enviar el alias.
							</p>
							<div class="mt-5 grid gap-2">
								<button type="submit" class="reservation-danger">Confirmar cancelación</button>
								<button type="button" class="reservation-link justify-center" data-cancel-refund-close>Volver</button>
							</div>
						</form>
					</dialog>

					<dialog
						class="reservation-reschedule-modal m-0 mt-auto mb-0 w-screen max-w-none open:flex open:flex-col max-h-[88dvh] overflow-hidden rounded-t-[1.75rem] rounded-b-none border border-(--outline-variant) border-b-0 bg-(--surface-container) p-0 text-(--on-surface) shadow-2xl backdrop:bg-black/70 sm:m-auto sm:mb-auto sm:w-[min(42rem,calc(100vw-2rem))] sm:max-w-[min(42rem,calc(100vw-2rem))] sm:max-h-[min(90vh,52rem)] sm:rounded-[28px] sm:border-b"
						data-reschedule-modal
					>
						<form class="reservation-reschedule-form" data-reservation-form data-reschedule-step="1">
							<div class="reservation-reschedule-header">
								<div>
									<h2 class="reservation-reschedule-title" data-reschedule-modal-title>Elige una nueva fecha y horario</h2>
								</div>
								<button
									type="button"
									class="reservation-modal-close"
									data-reschedule-close
									aria-label="Cerrar"
								>
									<span class="material-symbols-rounded" aria-hidden="true">close</span>
								</button>
							</div>

							<div class="reservation-reschedule-stepper">
								<ol class="grid grid-cols-3" data-reschedule-step-indicator>
									<li data-reschedule-step-item="1" class="step-item-current">1. Fecha</li>
									<li data-reschedule-step-item="2" class="step-item-default">2. Horario</li>
									<li data-reschedule-step-item="3" class="step-item-default">3. Confirmar</li>
								</ol>
							</div>

							<div class="reservation-reschedule-body">
								<section data-reschedule-step-panel="1" class="grid gap-3">
									<div>
										<h3 class="text-lg font-normal tracking-tight text-(--on-surface) sm:text-xl">Selecciona una fecha</h3>
										<p class="mt-0.5 text-sm text-(--on-surface-variant)">
											Elige el día en el calendario para ver los horarios disponibles.
										</p>
									</div>

									<div class="public-booking-calendar">
										<div class="public-booking-calendar__toolbar">
											<button type="button" data-calendar-prev class="calendar-nav-btn" aria-label="Mes anterior">
												<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
											</button>
											<p class="public-booking-calendar__month" data-calendar-month></p>
											<button type="button" data-calendar-next class="calendar-nav-btn" aria-label="Mes siguiente">
												<span class="material-symbols-rounded" aria-hidden="true">chevron_right</span>
											</button>
										</div>
										<div class="public-booking-calendar__weekdays">
											<span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span>
											<span>Vie</span><span>Sáb</span><span>Dom</span>
										</div>
										<div class="public-booking-calendar__grid" data-calendar-grid></div>
									</div>
								</section>

								<section data-reschedule-step-panel="2" class="hidden grid gap-3">
									<p class="reservation-slots-date-subtitle">
										<span data-reservation-selected-date></span>
									</p>
									<p class="m-0 text-base text-(--on-surface-variant)">
										<span class="public-slots-hint__desktop">Elegí un horario disponible</span>
										<span class="public-slots-hint__mobile">Deslizá para seleccionar un horario</span>
									</p>

									<div
										data-reservation-slots-loading
										class="hidden rounded-2xl bg-(--surface-container-high) px-5 py-4 text-base font-medium text-(--on-surface-variant)"
									>
										Consultando horarios disponibles...
									</div>

									<div class="reservation-slots-panel hidden" data-reservation-slots-panel>
										<p
											data-reservation-slots-heading
											class="reservation-slots-section-label hidden"
										>
											Sucursales y horarios
										</p>

										<div class="public-slots-container grid gap-0" data-reservation-slots-container></div>
										<p
											data-no-reservation-slots
											class="hidden rounded-2xl border border-(--error-container) bg-(--error-container) px-4 py-3 text-sm font-medium text-(--on-error-container)"
										>
											No se encontraron horarios para este día. Selecciona otra fecha para continuar.
										</p>
									</div>
								</section>

								<section data-reschedule-step-panel="3" class="hidden">
									<div class="reservation-change-summary">
										<p class="reservation-change-summary-label">Cambio de horario</p>
										<div class="reservation-change-summary-text" data-reschedule-change-summary></div>
									</div>
								</section>
							</div>

							<input type="hidden" name="date" data-reservation-date />
							<input type="hidden" id="reservation_slot" name="slot" data-reservation-slot />
							<input type="hidden" name="loc_id_location" data-reservation-location />

							<div class="reservation-reschedule-footer">
								<button
									type="button"
									class="reservation-secondary-action"
									data-reschedule-back
								>
									Volver atrás
								</button>
								<div class="reservation-reschedule-footer-actions">
									<button
										type="button"
										class="reservation-primary-action reservation-primary-action--compact"
										data-reschedule-next
									>
										Siguiente
									</button>
									<button
										type="submit"
										class="reservation-primary-action reservation-primary-action--compact is-hidden"
										data-reschedule-submit
									>
										Guardar cambios
									</button>
