---
import Layout from '../../layouts/Layout.astro';
import AppAlert from '../../components/AppAlert.astro';
import {
	getPublicProfileWithOrds,
	getPublicReservationWithOrds,
	normalizePublicBookingLocations,
	PublicBookingApiError,
	type PublicBookingLocation,
	type PublicReservationDetail,
} from '../../lib/public-booking';
import { buildPublicProfilePath } from '../../lib/public-profile-url';
import {
	formatHumanDateTime,
	isReservationPast,
	parseApiDateTime,
} from '../../lib/booking-datetime';
import '../../styles/global.css';

const token = String(Astro.params.token || '').trim();

let reservation: PublicReservationDetail | null = null;
let loadError = '';

try {
	reservation = await getPublicReservationWithOrds(token);
} catch (error) {
	const bookingError =
		error instanceof PublicBookingApiError
			? error
			: new PublicBookingApiError('No fue posible cargar esta reserva.', 500);
	loadError = bookingError.message;
	Astro.response.status = bookingError.status >= 400 && bookingError.status < 500 ? bookingError.status : 200;
}

const serializedReservation = reservation
	? JSON.stringify(reservation).replace(/</g, '\\u003c').replace(/-->/g, '--\\>')
	: '';

const isCancelled =
	Boolean(reservation) && String(reservation?.status || '').trim().toUpperCase() === 'CANCELADO';
const reservationStart = reservation ? parseApiDateTime(reservation.start_time) : null;
const formattedCurrentDate = reservationStart ? formatHumanDateTime(reservationStart) : '';
const isPastReservation =
	Boolean(reservation) && !isCancelled && isReservationPast(reservation);
const professionalSlug = String(reservation?.professional_slug || '').trim();
const organizationSlug = String(reservation?.organization_slug || '').trim();
const rebookHref =
	organizationSlug && professionalSlug
		? buildPublicProfilePath(organizationSlug, professionalSlug)
		: professionalSlug
			? `/p/${professionalSlug}`
			: '/';
const googleMapsApiKey =
	import.meta.env.PUBLIC_G_MAPS_API_KEY ??
	import.meta.env.PUBLIC_G_MAPS_API_KEYS ??
	'';

let reservationLocations: PublicBookingLocation[] = [];

if (reservation && organizationSlug && professionalSlug) {
	try {
		const profile = await getPublicProfileWithOrds(organizationSlug, professionalSlug);
		reservationLocations = normalizePublicBookingLocations(profile.locations);
	} catch {
		reservationLocations = [];
	}
}

if (reservation && reservationLocations.length === 0) {
	reservationLocations = [
		{
			id_location: reservation.loc_id_location,
			name: reservation.location_name,
			address: reservation.location_address,
		},
	];
}

const serializedLocations = reservation
	? JSON.stringify(reservationLocations).replace(/</g, '\\u003c').replace(/-->/g, '--\\>')
	: '';
---

<Layout>
	<main class="public-booking-shell reservation-shell relative z-10 mx-auto min-h-screen w-full max-w-4xl px-2 py-6 sm:px-4 md:px-6 lg:py-8">
		<div aria-hidden="true" class="pointer-events-none fixed inset-0 z-[-1] bg-(--surface-background)"></div>
		<section
			class="reservation-card grid gap-4"
			data-reservation-root
			data-token={token}
			data-google-maps-api-key={googleMapsApiKey}
		>
			{loadError || !reservation ? (
				<div class="reservation-state rounded-[28px] bg-(--surface-container) p-6 shadow-sm">
					<span class="material-symbols-rounded">event_busy</span>
					<h1>No encontramos esta reserva</h1>
					<p>{loadError || 'El enlace puede haber expirado o no existe.'}</p>
					<a href="/" class="reservation-link">Volver al inicio</a>
				</div>
			) : (
				<>
					<script type="application/json" id="reservation-json" set:html={serializedReservation}></script>
					<script type="application/json" id="reservation-locations-json" set:html={serializedLocations}></script>

					<header class="reservation-header rounded-[28px] bg-(--surface-container) p-5 shadow-sm sm:p-6">
						<div class="reservation-header-content">
							<div class="grid gap-1">
								<p class="reservation-eyebrow">Gestionar reserva</p>
								<h1>Tu reserva en Hasel</h1>
								<p>Revisa los datos, cambia la fecha o cancela tu turno si ya no puedes asistir.</p>
							</div>
						</div>
					</header>

					<div class="reservation-summary rounded-[28px] bg-(--surface-container) p-4 shadow-sm sm:p-5">
						<div>
							<span>Cliente</span>
							<strong>{reservation.customer_name}</strong>
						</div>
						<div>
							<span>Servicio</span>
							<strong>{reservation.service_name}</strong>
						</div>
						<div>
							<span>Profesional</span>
							<strong>{reservation.professional_name}</strong>
						</div>
						<div>
							<span>Sucursal</span>
							<strong data-location-name>{reservation.location_name}</strong>
						</div>
						<div>
							<span>Estado</span>
							<strong data-status-text>{reservation.status}</strong>
						</div>
						<div>
							<span>Horario actual</span>
							<strong data-current-date>{formattedCurrentDate}</strong>
						</div>
					</div>

					{isCancelled ? (
						<div class="reservation-cancelled rounded-[28px] bg-(--surface-container) p-5 shadow-sm sm:p-6" data-reservation-cancelled>
							<p class="reservation-cancelled-text">
								Esta reserva se encuentra cancelada. Si deseas, puedes agendar un nuevo turno con el profesional.
							</p>
							<a href={rebookHref} class="reservation-link">Volver a reservar</a>
						</div>
					) : isPastReservation ? (
						<div class="reservation-cancelled rounded-[28px] bg-(--surface-container) p-5 shadow-sm sm:p-6" data-reservation-past>
							<p class="reservation-cancelled-text">
								Esta reserva ya finalizó. Ya no es posible reprogramarla ni cancelarla desde este enlace.
							</p>
							<a href={rebookHref} class="reservation-link">Volver a reservar</a>
						</div>
					) : (
					<>
					<div class="reservation-actions-card rounded-[28px] bg-(--surface-container) p-5 shadow-sm sm:p-6">
						<button
							type="button"
							class="reservation-primary-action"
							data-open-reschedule-modal
						>
							<span class="material-symbols-rounded" aria-hidden="true">event_repeat</span>
							Reprogramar reserva
						</button>
						<button type="button" class="reservation-danger" data-cancel-reservation>
							<span class="material-symbols-rounded" aria-hidden="true">event_busy</span>
							Cancelar reserva
						</button>
					</div>

					<dialog
						class="reservation-reschedule-modal m-0 mt-auto mb-0 w-screen max-w-none open:flex open:flex-col max-h-[88dvh] overflow-hidden rounded-t-[1.75rem] rounded-b-none border border-(--outline-variant) border-b-0 bg-(--surface-container) p-0 text-(--on-surface) shadow-2xl backdrop:bg-black/70 sm:m-auto sm:mb-auto sm:w-[min(42rem,calc(100vw-2rem))] sm:max-w-[min(42rem,calc(100vw-2rem))] sm:max-h-[min(90vh,52rem)] sm:rounded-[28px] sm:border-b"
						data-reschedule-modal
					>
						<form class="reservation-reschedule-form" data-reservation-form data-reschedule-step="1">
							<div class="reservation-reschedule-header">
								<div>
									<h2 class="reservation-reschedule-title" data-reschedule-modal-title>Elige una nueva fecha y horario</h2>
								</div>
								<button
									type="button"
									class="reservation-modal-close"
									data-reschedule-close
									aria-label="Cerrar"
								>
									<span class="material-symbols-rounded" aria-hidden="true">close</span>
								</button>
							</div>

							<div class="reservation-reschedule-stepper">
								<ol class="grid grid-cols-3" data-reschedule-step-indicator>
									<li data-reschedule-step-item="1" class="step-item-current">1. Fecha</li>
									<li data-reschedule-step-item="2" class="step-item-default">2. Horario</li>
									<li data-reschedule-step-item="3" class="step-item-default">3. Confirmar</li>
								</ol>
							</div>

							<div class="reservation-reschedule-body">
								<section data-reschedule-step-panel="1" class="grid gap-3">
									<div>
										<h3 class="text-lg font-normal tracking-tight text-(--on-surface) sm:text-xl">Selecciona una fecha</h3>
										<p class="mt-0.5 text-sm text-(--on-surface-variant)">
											Elige el día en el calendario para ver los horarios disponibles.
										</p>
									</div>

									<div class="rounded-3xl border border-(--outline-variant) bg-(--surface-container-low) p-3 sm:p-4">
										<div class="mb-3 flex items-center justify-between gap-3">
											<button
												type="button"
												data-calendar-prev
												class="flex h-10 items-center rounded-full px-5 text-sm font-medium text-(--primary) transition hover:bg-(--primary-container) hover:text-(--on-primary-container)"
											>
												Anterior
											</button>
											<p class="text-base font-medium capitalize tracking-wide text-(--on-surface)" data-calendar-month></p>
											<button
												type="button"
												data-calendar-next
												class="flex h-10 items-center rounded-full px-5 text-sm font-medium text-(--primary) transition hover:bg-(--primary-container) hover:text-(--on-primary-container)"
											>
												Siguiente
											</button>
										</div>
										<div class="mb-3 grid grid-cols-7 gap-1 text-center text-xs font-medium uppercase tracking-wider text-(--on-surface-variant) sm:text-sm">
											<span>Lun</span>
											<span>Mar</span>
											<span>Mie</span>
											<span>Jue</span>
											<span>Vie</span>
											<span>Sab</span>
											<span>Dom</span>
										</div>
										<div class="grid grid-cols-7 gap-1 sm:gap-2" data-calendar-grid></div>
									</div>
								</section>

								<section data-reschedule-step-panel="2" class="hidden grid gap-3">
									<p class="reservation-slots-date-subtitle">
										<span data-reservation-selected-date></span>
									</p>

									<div
										data-reservation-slots-loading
										class="hidden rounded-2xl bg-(--surface-container-high) px-5 py-4 text-base font-medium text-(--on-surface-variant)"
									>
										Consultando horarios disponibles...
									</div>

									<div class="reservation-slots-panel hidden" data-reservation-slots-panel>
										<p
											data-reservation-slots-heading
											class="reservation-slots-section-label hidden"
										>
											Sucursales y horarios
										</p>

										<div class="grid gap-0" data-reservation-slots-container></div>
										<p
											data-no-reservation-slots
											class="hidden rounded-2xl border border-(--error-container) bg-(--error-container) px-4 py-3 text-sm font-medium text-(--on-error-container)"
										>
											No se encontraron horarios para este día. Selecciona otra fecha para continuar.
										</p>
									</div>
								</section>

								<section data-reschedule-step-panel="3" class="hidden">
									<div class="reservation-change-summary">
										<p class="reservation-change-summary-label">Cambio de horario</p>
										<div class="reservation-change-summary-text" data-reschedule-change-summary></div>
									</div>
								</section>
							</div>

							<input type="hidden" name="date" data-reservation-date />
							<input type="hidden" id="reservation_slot" name="slot" data-reservation-slot />
							<input type="hidden" name="loc_id_location" data-reservation-location />

							<div class="reservation-reschedule-footer">
								<button
									type="button"
									class="reservation-secondary-action"
									data-reschedule-back
								>
									Volver atrás
								</button>
								<div class="reservation-reschedule-footer-actions">
									<button
										type="button"
										class="reservation-primary-action reservation-primary-action--compact"
										data-reschedule-next
									>
										Siguiente
									</button>
									<button
										type="submit"
										class="reservation-primary-action reservation-primary-action--compact is-hidden"
										data-reschedule-submit
									>
										Guardar cambios
									</button>
								</div>
							</div>
						</form>
					</dialog>

					<dialog
						class="public-map-modal rounded-[28px] border border-(--outline-variant) bg-(--surface-container) p-0 text-(--on-surface) shadow-2xl backdrop:bg-black/70"
						data-public-map-modal
					>
						<div class="grid gap-4 p-5 sm:p-6">
							<div class="flex items-start justify-between gap-4">
								<div>
									<h2 class="text-xl font-semibold tracking-tight">Ubicación</h2>
									<p class="mt-1 text-sm text-(--on-surface-variant)" data-public-map-address></p>
								</div>
								<button
									type="button"
									class="grid h-10 w-10 place-items-center rounded-full text-(--on-surface-variant) transition hover:bg-(--surface-container-highest) hover:text-(--on-surface)"
									data-public-map-close
									aria-label="Cerrar mapa"
								>
									<span class="material-symbols-rounded">close</span>
								</button>
							</div>
							<div class="public-map-modal-divider"></div>
							<div class="public-map-canvas-wrap relative h-80 overflow-hidden rounded-3xl border border-(--outline-variant) bg-(--surface-container-high)">
								<div class="h-full w-full" data-public-map-canvas></div>
								<div
									class="public-map-loading absolute inset-0 z-10 hidden place-items-center bg-(--surface-container-high)/85 backdrop-blur-[2px]"
									data-public-map-loading
									aria-hidden="true"
									aria-live="polite"
									aria-label="Cargando mapa"
								>
									<span class="material-symbols-rounded animate-spin text-[1.75rem] text-(--primary)" aria-hidden="true">progress_activity</span>
								</div>
							</div>
							<p
								class="hidden rounded-2xl bg-(--error-container) px-4 py-3 text-sm font-medium text-(--on-error-container)"
								data-public-map-status
							></p>
						</div>
					</dialog>
					</>
					)}

				</>
			)}
		</section>
	</main>
	<AppAlert />
</Layout>

<script>
	import { initializePublicReservationPage } from '../../scripts/public-reservation-page';

	initializePublicReservationPage();
	document.addEventListener('astro:page-load', initializePublicReservationPage);
</script>


<style is:global>
.reservation-shell {
	font-family: var(--font-body);
	--surface-background: #141414;
	--surface-container-lowest: #1b1b1b;
	--surface-container-low: #1b1b1b;
	--surface-container: #1b1b1b;
	--surface-container-high: #1b1b1b;
	--surface-container-highest: #1b1b1b;
	--outline: #44474e;
	--outline-variant: #44474e;
	--on-surface: #e2e2e9;
	--on-surface-variant: #c4c6d0;
	--primary: #a8c7fa;
	--on-primary: #062e6f;
	--primary-container: #0842a0;
	--on-primary-container: #d3e3fd;
	--primary-hover: #b9d4fa;
	--tertiary: #c7eccb;
	--on-tertiary: #0c381c;
	--tertiary-container: #225031;
	--on-tertiary-container: #e3ffe6;
	--error: #ffb4ab;
	--error-container: #93000a;
	--on-error-container: #ffdad6;
}

.reservation-card {
	width: 100%;
}

.reservation-header-content {
	display: flex;
	align-items: center;
	gap: 0.9rem;
}

.reservation-header h1,
.reservation-state h1 {
	margin: 0;
	font-size: clamp(1.75rem, 3.4vw, 2.2rem);
	line-height: 1.05;
	letter-spacing: -0.03em;
	color: var(--on-surface);
}

.reservation-header p,
.reservation-state p {
	margin: 0.3rem 0 0;
	color: var(--on-surface-variant);
	line-height: 1.45;
}

.reservation-eyebrow {
	color: var(--primary) !important;
	font-size: 0.72rem;
	font-weight: 800;
	letter-spacing: 0.12em;
	text-transform: uppercase;
}

.reservation-summary {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 0.55rem;
}

.reservation-summary div {
	border-radius: 0.8rem;
	background: var(--surface-container-high);
	padding: 0.65rem 0.75rem;
}

.reservation-summary span {
	display: block;
	color: var(--on-surface-variant);
	font-size: 0.72rem;
	font-weight: 700;
	margin-bottom: 0.28rem;
}

.reservation-summary strong {
	display: block;
	color: var(--on-surface);
	font-size: 0.96rem;
	line-height: 1.25;
}

.reservation-form {
	display: grid;
	gap: 1rem;
}

.reservation-actions-card {
	display: grid;
	gap: 0.75rem;
}

.reservation-primary-action,
.reservation-secondary-action {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 0.5rem;
	border: 0;
	border-radius: 999px;
	font: inherit;
	font-weight: 500;
	padding: 0.85rem 1.35rem;
	cursor: pointer;
	text-decoration: none;
	transition: background 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
}

.reservation-primary-action {
	background: var(--primary);
	color: var(--on-primary);
}

.reservation-primary-action:hover:not(:disabled) {
	background: var(--primary-hover);
}

.reservation-primary-action:disabled {
	cursor: not-allowed;
	opacity: 0.55;
}

.reservation-primary-action--compact {
	min-height: 3rem;
	padding-inline: 1.5rem;
}

.reservation-secondary-action {
	background: transparent;
	color: var(--on-surface);
	border: 1px solid var(--outline);
}

.reservation-secondary-action:hover {
	background: var(--surface-container-highest);
}

.reservation-actions {
	display: flex;
	gap: 0.8rem;
	justify-content: space-between;
	margin-top: 0.75rem;
}

.reservation-reschedule-modal {
	position: fixed;
	top: auto;
	right: 0;
	bottom: 0;
	left: 0;
	width: 100%;
	max-width: none;
	height: auto;
	max-height: 88dvh;
	margin: 0;
	padding: 0;
	overflow: hidden;
	animation: reservation-modal-in var(--modal-open-duration, 150ms)
		var(--modal-easing, cubic-bezier(0.16, 1, 0.3, 1));
}

.reservation-reschedule-modal::backdrop {
	background: rgba(0, 0, 0, 0.7);
	animation: reservation-backdrop-in var(--modal-open-duration, 150ms)
		var(--modal-easing, cubic-bezier(0.16, 1, 0.3, 1));
}

.reservation-reschedule-form {
	display: grid;
	min-height: 0;
	height: auto;
	max-height: inherit;
	grid-template-rows: auto auto auto auto;
}

.reservation-reschedule-form[data-reschedule-step='2'],
.reservation-reschedule-form[data-reschedule-step='3'] {
	max-height: 88dvh;
	grid-template-rows: auto auto minmax(0, 1fr) auto;
}

@media (max-width: 639px) {
	.reservation-reschedule-form[data-reschedule-step='2'],
	.reservation-reschedule-form[data-reschedule-step='3'] {
		height: auto;
		max-height: 88dvh;
	}

	.reservation-reschedule-form[data-reschedule-step='2'] .reservation-reschedule-body,
	.reservation-reschedule-form[data-reschedule-step='3'] .reservation-reschedule-body {
		overflow-y: auto;
		max-height: calc(88dvh - 11.5rem);
	}

	.reservation-reschedule-footer {
		padding: 0.65rem 1.15rem max(0.65rem, env(safe-area-inset-bottom, 0px));
	}
}

.reservation-reschedule-header {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 0.75rem;
	padding: 0.85rem 1.15rem 0.45rem;
}

.reservation-reschedule-title {
	margin: 0;
	font-size: clamp(1.15rem, 2.5vw, 1.45rem);
	line-height: 1.2;
	letter-spacing: -0.02em;
	color: var(--on-surface);
}

.reservation-modal-close {
	display: grid;
	place-items: center;
	width: 2.5rem;
	height: 2.5rem;
	border: 0;
	border-radius: 999px;
	background: transparent;
	color: var(--on-surface-variant);
	cursor: pointer;
	transition: background 0.15s ease, color 0.15s ease;
	flex-shrink: 0;
}

.reservation-modal-close:hover {
	background: var(--surface-container-highest);
	color: var(--on-surface);
}

.reservation-reschedule-stepper {
	padding: 0.55rem 1.15rem 0.75rem;
	border-bottom: 1px solid color-mix(in srgb, var(--outline-variant) 55%, transparent);
}

[data-reschedule-step-indicator] {
	gap: 0.65rem;
}

.reservation-reschedule-body {
	overflow-y: visible;
	padding: 0.65rem 1.15rem 0.5rem;
}

.reservation-reschedule-form[data-reschedule-step='2'] .reservation-reschedule-body,
.reservation-reschedule-form[data-reschedule-step='3'] .reservation-reschedule-body {
	overflow-y: auto;
}

.reservation-reschedule-footer {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 0.75rem;
	flex-shrink: 0;
	padding: 0.75rem 1.15rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
	border-top: 1px solid color-mix(in srgb, var(--outline-variant) 70%, transparent);
	background: var(--surface-container);
}

.reservation-reschedule-footer-actions {
	margin-left: auto;
	display: flex;
	align-items: center;
	justify-content: flex-end;
	gap: 0.75rem;
	flex-shrink: 0;
}

.reservation-reschedule-footer-actions .is-hidden,
.reservation-primary-action.is-hidden {
	display: none !important;
}

.reservation-change-summary {
	border-radius: 1.25rem;
	background: var(--surface-container-high);
	padding: 1rem 1.1rem;
}

.reservation-change-summary-label {
	margin: 0 0 0.9rem;
	font-size: 0.72rem;
	font-weight: 700;
	letter-spacing: 0.08em;
	text-transform: uppercase;
	color: var(--primary);
}

.reservation-change-summary-text {
	display: flex;
	flex-direction: column;
	gap: 0;
	margin: 0;
}

.reservation-change-diff__block {
	display: flex;
	flex-direction: column;
	gap: 0.3rem;
}

.reservation-change-diff__block--previous {
	margin-bottom: 0.85rem;
}

.reservation-change-diff__block--next {
	gap: 0.4rem;
	padding-top: 0.15rem;
}

.reservation-change-diff__microcopy {
	font-size: 0.72rem;
	font-weight: 700;
