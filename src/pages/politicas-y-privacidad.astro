---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const updatedAt = '15 de mayo de 2026';
const pageTitle = 'Políticas y privacidad — Hasel';
const pageDescription =
	'Qué datos trata Hasel, para qué los usa y cómo se administran en la plataforma.';

const toc = [
	{ id: 'responsable', label: 'Responsable del sitio' },
	{ id: 'datos', label: 'Datos que tratamos' },
	{ id: 'finalidad', label: 'Finalidad del tratamiento' },
	{ id: 'manejo', label: 'Cómo se maneja la información' },
	{ id: 'seguridad', label: 'Seguridad y conservación' },
	{ id: 'servicios-externos', label: 'Servicios externos' },
	{ id: 'derechos', label: 'Derechos y consultas' },
] as const;
---

<Layout pageTitle={pageTitle} metaDescription={pageDescription}>
	<main class="policy-root">
		<div class="policy-shell">
			<header class="policy-navbar">
				<a href="/" class="policy-brand no-underline">
					<img
						src="/icons/icon-512x512.png"
						alt="Logo Hasel"
						class="policy-brand-logo"
						loading="eager"
						decoding="async"
					/>
					<span>Hasel</span>
				</a>
				<a href="/" class="policy-home-link no-underline">Volver al inicio</a>
			</header>

			<header class="policy-hero">
				<p class="policy-kicker">Documentación legal</p>
				<h1>Políticas y privacidad de Hasel</h1>
				<p class="policy-lead">
					En Hasel cuidamos la información de los negocios que usan la plataforma para organizar
					servicios, clientes, equipos, horarios y citas. Esta página explica de forma simple qué
					datos tratamos, para qué los usamos y cómo se administran dentro del proyecto.
				</p>
				<p class="policy-updated">Última actualización: {updatedAt}</p>
			</header>

			<div class="policy-layout">
				<aside class="policy-toc" aria-label="Índice del artículo">
					<details class="policy-toc-mobile">
						<summary>En este artículo</summary>
						<nav class="policy-toc-nav">
							{
								toc.map((item) => (
									<a href={`#${item.id}`} class="policy-toc-link" data-toc-link={item.id}>
										{item.label}
									</a>
								))
							}
						</nav>
					</details>
					<nav class="policy-toc-desktop" aria-label="Secciones">
						<p class="policy-toc-title">En este artículo</p>
						{
							toc.map((item) => (
								<a href={`#${item.id}`} class="policy-toc-link" data-toc-link={item.id}>
									{item.label}
								</a>
							))
						}
					</nav>
				</aside>

				<article class="policy-article">
					<section id="responsable" class="policy-section" data-policy-section>
						<h2>Responsable del sitio y la aplicación</h2>
						<p>
							Este sitio web y la aplicación Hasel son operados y administrados por Daniel Ramon
							Villasanti Vergara, responsable principal del proyecto y CEO de Hasel.
						</p>
					</section>

					<section id="datos" class="policy-section" data-policy-section>
						<h2>Datos que podemos tratar</h2>
						<p>
							Hasel puede procesar datos necesarios para operar la agenda y el panel
							administrativo, incluyendo información de cuentas, negocios, sucursales, servicios,
							especialidades, profesionales, horarios, clientes, citas y estados operativos.
						</p>
						<p>
							También podemos registrar información técnica básica, como fecha y hora de acceso,
							identificadores de sesión, preferencias de la aplicación, notificaciones y datos
							mínimos para seguridad, soporte y mejora del servicio.
						</p>
					</section>

					<section id="finalidad" class="policy-section" data-policy-section>
						<h2>Finalidad del tratamiento</h2>
						<p>
							Usamos la información para permitir el funcionamiento de Hasel: gestionar reservas,
							mostrar disponibilidad, organizar equipos, consultar el estado del negocio, enviar
							notificaciones relevantes y mantener la seguridad de la cuenta.
						</p>
						<p>
							Cuando se usan funciones de asistencia inteligente, la información enviada al
							asistente se utiliza para responder consultas sobre agenda, clientes, turnos o
							disponibilidad dentro del contexto autorizado por el usuario.
						</p>
					</section>

					<section id="manejo" class="policy-section" data-policy-section>
						<h2>Cómo se maneja la información en el proyecto</h2>
						<p>
							Los datos se organizan por módulos funcionales de la plataforma, como panel,
							calendario, clientes, servicios, sucursales, equipo, horarios y herramientas de IA.
							El acceso se limita a usuarios autenticados y a los permisos necesarios para operar
							cada espacio de trabajo.
						</p>
						<aside class="policy-callout" role="note">
							<p>
								<strong>No vendemos información personal.</strong> Los datos se usan para
								prestar el servicio, cumplir solicitudes del usuario, mantener continuidad
								operativa y mejorar la experiencia de la aplicación.
							</p>
						</aside>
					</section>

					<section id="seguridad" class="policy-section" data-policy-section>
						<h2>Seguridad y conservación</h2>
						<p>
							Aplicamos controles razonables de acceso, autenticación y separación lógica de
							datos para reducir riesgos de acceso no autorizado. La información se conserva
							mientras sea necesaria para operar el servicio, cumplir obligaciones aplicables o
							atender solicitudes del usuario.
						</p>
					</section>

					<section id="servicios-externos" class="policy-section" data-policy-section>
						<h2>Servicios externos</h2>
						<p>
							Hasel puede apoyarse en proveedores tecnológicos para infraestructura,
							autenticación, notificaciones, hosting, análisis operativo o funciones de
							inteligencia artificial. Estos servicios se utilizan únicamente para habilitar
							funcionalidades del producto.
						</p>
					</section>

					<section id="derechos" class="policy-section policy-section--last" data-policy-section>
						<h2>Derechos y consultas</h2>
						<p>
							Los usuarios pueden solicitar revisión, actualización o eliminación de información
							asociada a su cuenta o negocio, según corresponda al uso de la plataforma y a las
							obligaciones operativas vigentes.
						</p>
						<p>
							Para consultas sobre privacidad o tratamiento de datos, el usuario puede
							comunicarse por los canales oficiales habilitados por Hasel.
						</p>
						<p>
							Las reglas de señas, cancelación y devoluciones se detallan en
							<a href="/politicas-de-cancelacion-y-reembolso" class="policy-inline-link">
								Políticas de cancelación y reembolso
							</a>.
						</p>
					</section>
				</article>
			</div>
		</div>
	</main>
</Layout>

<script>
	const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-policy-section]'));
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
	const mobileDetails = document.querySelector<HTMLDetailsElement>('.policy-toc-mobile');

	const setActive = (id: string) => {
		for (const link of links) {
			link.classList.toggle('is-active', link.dataset.tocLink === id);
		}
	};

	for (const link of links) {
		link.addEventListener('click', () => {
			if (mobileDetails) mobileDetails.open = false;
		});
	}

	if (sections.length && 'IntersectionObserver' in window) {
		const visible = new Map<string, number>();
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const id = entry.target.id;
					if (!id) continue;
					if (entry.isIntersecting) visible.set(id, entry.intersectionRatio);
					else visible.delete(id);
				}
				let bestId = '';
				let bestRatio = 0;
				for (const [id, ratio] of visible) {
					if (ratio >= bestRatio) {
						bestRatio = ratio;
						bestId = id;
					}
				}
				if (bestId) setActive(bestId);
			},
			{ rootMargin: '-20% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
		);
		for (const section of sections) observer.observe(section);
		setActive(sections[0]?.id || '');
	}
</script>

<style>
	:root {
		--policy-bg: #0a0a0b;
		--policy-text: #f4f4f5;
		--policy-muted: #a1a1aa;
		--policy-heading: #fafafa;
		--policy-border: rgba(255, 255, 255, 0.1);
		--policy-border-soft: rgba(255, 255, 255, 0.06);
		--policy-primary: #3a6fd7;
		--policy-primary-soft: #bfd6ff;
		--policy-callout-bg: rgba(255, 255, 255, 0.04);
		--policy-toc-active: #e4e4e7;
	}

	.policy-root {
		min-height: 100vh;
		background: var(--policy-bg);
		color: var(--policy-text);
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
	}

	.policy-shell {
		width: min(1120px, 100%);
		margin: 0 auto;
		padding: 1rem 1.15rem 4rem;
	}

	.policy-navbar {
		position: sticky;
		top: 0.75rem;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin: 0.5rem 0 1.5rem;
		padding: 0.55rem 0.75rem;
		border: 1px solid var(--policy-border);
		border-radius: 999px;
		background: rgba(10, 10, 11, 0.82);
		backdrop-filter: blur(12px);
	}

	.policy-brand,
	.policy-home-link {
		display: inline-flex;
		align-items: center;
		color: var(--policy-text);
		text-decoration: none;
	}

	.policy-brand {
		gap: 0.5rem;
		font-size: 1.05rem;
		font-weight: 700;
	}

	.policy-brand-logo {
		width: 1.85rem;
		height: 1.85rem;
		border-radius: 999px;
		object-fit: contain;
	}

	.policy-home-link {
		border-radius: 999px;
		background: var(--policy-primary);
		padding: 0.5rem 0.95rem;
		font-size: 0.875rem;
		font-weight: 650;
	}

	.policy-hero {
		padding: 2rem 0 2.25rem;
		border-bottom: 1px solid var(--policy-border-soft);
	}

	.policy-kicker {
		margin: 0 0 0.75rem;
		color: var(--policy-primary-soft);
		font-size: 0.8rem;
		font-weight: 650;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.policy-hero h1 {
		margin: 0 0 1rem;
		max-width: 14ch;
		color: var(--policy-heading);
		font-size: clamp(2.35rem, 6.5vw, 3.75rem);
		font-weight: 750;
		letter-spacing: -0.04em;
		line-height: 1.22;
	}

	.policy-lead {
		margin: 0 0 1rem;
		max-width: 62ch;
		color: var(--policy-muted);
		font-size: clamp(1.02rem, 1.8vw, 1.15rem);
		line-height: 1.7;
	}

	.policy-updated {
		margin: 0;
		color: #8b8b96;
		font-size: 0.88rem;
		font-weight: 500;
	}

	.policy-layout {
		display: grid;
		gap: 1.5rem;
		padding-top: 1.5rem;
	}

	.policy-toc-desktop {
		display: none;
	}

	.policy-toc-mobile {
		border: 1px solid var(--policy-border);
		border-radius: 0.75rem;
		background: transparent;
		padding: 0;
	}

	.policy-toc-mobile summary {
		cursor: pointer;
		list-style: none;
		padding: 0.85rem 1rem;
		color: var(--policy-heading);
		font-size: 0.92rem;
		font-weight: 650;
	}

	.policy-toc-mobile summary::-webkit-details-marker {
		display: none;
	}

	.policy-toc-mobile summary::after {
		content: 'expand_more';
		float: right;
		font-family: 'Material Symbols Rounded';
		font-size: 1.2rem;
		color: var(--policy-muted);
	}

	.policy-toc-mobile[open] summary::after {
		content: 'expand_less';
	}

	.policy-toc-mobile .policy-toc-nav {
		display: grid;
		gap: 0.15rem;
		padding: 0 0.5rem 0.75rem;
		border-top: 1px solid var(--policy-border-soft);
	}

	.policy-toc-title {
		margin: 0 0 0.75rem;
		color: #8b8b96;
		font-size: 0.75rem;
		font-weight: 650;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.policy-toc-link {
		display: block;
		padding: 0.45rem 0.65rem;
		border-left: 2px solid transparent;
		color: var(--policy-muted);
		font-size: 0.9rem;
		font-weight: 500;
		line-height: 1.35;
		text-decoration: none;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.policy-toc-link:hover {
		color: var(--policy-heading);
	}

	.policy-toc-link.is-active {
		border-left-color: var(--policy-primary);
		color: var(--policy-toc-active);
		font-weight: 600;
	}

	.policy-article {
		min-width: 0;
		max-width: 46rem;
	}

	.policy-section {
		padding: 2.25rem 0;
		border-bottom: 1px solid var(--policy-border-soft);
		scroll-margin-top: 5.5rem;
	}

	.policy-section--last {
		border-bottom: 0;
		padding-bottom: 1rem;
	}

	.policy-section h2 {
		margin: 0 0 1.1rem;
		color: var(--policy-heading);
		font-size: clamp(1.35rem, 2.5vw, 1.65rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.25;
	}

	.policy-section p {
		margin: 0;
		color: var(--policy-muted);
		font-size: 1rem;
		line-height: 1.75;
	}

	.policy-section p + p {
		margin-top: 1rem;
	}

	.policy-section strong {
		color: #d4d4d8;
		font-weight: 650;
	}

	.policy-callout {
		margin: 1.25rem 0;
		padding: 0.95rem 1rem 0.95rem 1.05rem;
		border-left: 3px solid var(--policy-primary);
		background: var(--policy-callout-bg);
		border-radius: 0 0.5rem 0.5rem 0;
	}

	.policy-callout p {
		margin: 0;
		color: #c4c4cc;
		font-size: 0.96rem;
		line-height: 1.65;
	}

	.policy-callout strong {
		color: var(--policy-heading);
	}

	.policy-inline-link {
		color: var(--policy-primary-soft);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.policy-inline-link:hover {
		color: #ffffff;
	}

	@media (min-width: 960px) {
		.policy-shell {
			padding: 1.25rem 1.5rem 5rem;
		}

		.policy-hero {
			padding: 3rem 0 2.75rem;
		}

		.policy-hero h1 {
			line-height: 1.12;
		}

		.policy-layout {
			grid-template-columns: 15.5rem minmax(0, 1fr);
			gap: 3rem;
			align-items: start;
			padding-top: 2.5rem;
		}

		.policy-toc {
			position: sticky;
			top: 5.25rem;
		}

		.policy-toc-mobile {
			display: none;
		}

		.policy-toc-desktop {
			display: grid;
			gap: 0.1rem;
		}

		.policy-section {
			padding: 2.75rem 0;
			scroll-margin-top: 6rem;
		}
	}
</style>
