---
import Layout from '../../layouts/Layout.astro';

/**
 * Fase E: página legacy post-checkout Pagopar de señas.
 * El flujo activo es SIPAP (reserva pública → comprobante → Cobros).
 */
Astro.response.status = 410;
---

<Layout>
	<main class="public-booking-shell relative z-10 mx-auto min-h-screen w-full max-w-3xl px-2 py-8 sm:px-4 md:px-8 lg:py-12">
		<div aria-hidden="true" class="pointer-events-none fixed inset-0 z-[-1] bg-(--surface-background)"></div>

		<section class="rounded-3xl border border-amber-200 bg-amber-50 px-8 py-10 text-amber-950 shadow-sm">
			<h1 class="text-3xl font-semibold tracking-tight">Este enlace ya no se usa</h1>
			<p class="mt-3 text-base font-medium">
				El pago de señas por Pagopar fue reemplazado por transferencia SIPAP. Si reservaste con seña,
				seguí las instrucciones de transferencia de la reserva o contactá al negocio.
			</p>
			<div class="mt-7">
				<a
					href="/"
					class="inline-flex h-11 items-center justify-center rounded-full bg-white/70 px-6 text-sm font-semibold text-(--on-surface) no-underline transition hover:bg-white"
				>
					Volver al inicio
				</a>
			</div>
		</section>
	</main>
</Layout>
