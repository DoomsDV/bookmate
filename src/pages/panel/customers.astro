			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
		}
	}

	dialog[data-customer-profile-modal] {
		--modal-open-duration: 150ms;
		position: fixed;
		inset: 0;
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		box-shadow: none;
		overflow: hidden;
		animation: customer-profile-modal-in var(--modal-open-duration, 150ms)
			var(--modal-easing, cubic-bezier(0.16, 1, 0.3, 1));
	}

	dialog[data-customer-profile-modal][open] {
		display: flex;
	}

	/* Mobile: bottom sheet al 90% del viewport */
	dialog[data-customer-profile-modal][open] .customer-profile-modal__panel {
		min-height: 90dvh;
	}

	@media (min-width: 640px) {
		dialog[data-customer-profile-modal][open] .customer-profile-modal__panel {
			min-height: min(90vh, 40rem);
		}
	}

	.customer-profile-modal-body {
		flex: 1 1 auto;
		min-height: 0;
	}

	.customer-profile-tab-panel[data-customer-profile-tab-panel='history']:not([hidden]) {
		min-height: 100%;
		align-content: start;
	}

	.customer-profile-tab-panel[data-customer-profile-tab-panel='history']:has(
		[data-customer-profile-history-empty]:not(.hidden)
	) {
		align-content: center;
	}

	dialog[data-customer-profile-modal]::backdrop {
		animation: customer-profile-backdrop-in var(--modal-open-duration, 150ms) ease;
	}

	dialog[data-customer-profile-modal].is-closing {
		animation: customer-profile-modal-out 140ms ease forwards;
	}

	dialog[data-customer-profile-modal].is-closing::backdrop {
		animation: customer-profile-backdrop-out 140ms ease forwards;
	}

	@keyframes customer-profile-modal-in {
		from {
			opacity: 0;
			transform: translateY(100%);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes customer-profile-modal-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(100%);
		}
	}

	@media (min-width: 640px) and (max-width: 1023px) {
		@keyframes customer-profile-modal-in {
			from {
				opacity: 0;
				transform: translateY(12px) scale(0.98);
			}
			to {
				opacity: 1;
				transform: translateY(0) scale(1);
			}
		}

		@keyframes customer-profile-modal-out {
			from {
				opacity: 1;
				transform: translateY(0) scale(1);
			}
			to {
				opacity: 0;
				transform: translateY(8px) scale(0.98);
			}
		}
	}

	/* Desktop PC: side drawer a la derecha (mismo slide que Servicios) */
	@media (min-width: 1024px) {
		dialog[data-customer-profile-modal][open] {
			flex-direction: row;
			align-items: stretch;
			justify-content: flex-end;
		}

		dialog[data-customer-profile-modal][open] .customer-profile-modal__panel {
			min-height: 100dvh;
			margin-left: auto;
		}

		dialog[data-customer-profile-modal] {
			animation-name: customer-profile-drawer-in;
		}

		dialog[data-customer-profile-modal].is-closing {
			animation-name: customer-profile-drawer-out;
		}

		dialog[data-customer-profile-modal]::backdrop {
			background-color: var(--modal-backdrop-scrim);
			backdrop-filter: blur(var(--modal-backdrop-blur));
			-webkit-backdrop-filter: blur(var(--modal-backdrop-blur));
		}
	}

	dialog[data-customer-profile-modal].is-odontogram-workspace[open] .customer-profile-modal__panel,
	.customer-profile-modal__panel.is-odontogram-workspace {
		height: 90dvh;
		max-height: 90dvh;
		min-height: 90dvh;
	}

	@media (min-width: 1024px) {
		dialog[data-customer-profile-modal].is-odontogram-workspace[open] {
			align-items: stretch;
			justify-content: stretch;
			flex-direction: row;
		}

		dialog[data-customer-profile-modal].is-odontogram-workspace[open] .customer-profile-modal__panel,
		.customer-profile-modal__panel.is-odontogram-workspace {
			width: 100vw;
			max-width: 100vw;
			height: 100dvh;
			max-height: 100dvh;
			min-height: 100dvh;
			margin: 0;
			border-radius: 0;
			border: 0;
		}
	}

	dialog[data-customer-profile-modal].is-odontogram-workspace .customer-profile-modal-body {
		overflow-x: hidden;
		overflow-y: auto;
		padding: 0;
		background: var(--surface-bright);
	}

	dialog[data-customer-profile-modal].is-odontogram-workspace .customer-profile-modal-footer {
		display: none;
	}

	dialog[data-customer-profile-modal].is-odontogram-workspace [data-customer-profile-body]:not(.hidden) {
		display: flex;
		flex-direction: column;
		flex: 1 1 auto;
		min-height: 0;
		height: auto;
		gap: 0;
	}

	dialog[data-customer-profile-modal].is-odontogram-workspace
		.customer-profile-tab-panel[data-customer-profile-tab-panel='odontogram']:not([hidden]) {
		flex: 0 0 auto;
		min-height: 0;
		height: auto;
		display: flex;
		flex-direction: column;
		align-content: start;
	}

	@media (min-width: 1024px) {
		dialog[data-customer-profile-modal].is-odontogram-workspace .customer-profile-modal-body {
			overflow: hidden;
		}

		dialog[data-customer-profile-modal].is-odontogram-workspace [data-customer-profile-body]:not(.hidden) {
			height: 100%;
		}

		dialog[data-customer-profile-modal].is-odontogram-workspace
			.customer-profile-tab-panel[data-customer-profile-tab-panel='odontogram']:not([hidden]) {
			flex: 1 1 auto;
			min-height: 0;
			height: auto;
			align-content: stretch;
		}
	}

	dialog[data-customer-profile-modal].is-odontogram-workspace
