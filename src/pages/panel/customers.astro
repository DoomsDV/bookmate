---
import AppAlert from '../../components/AppAlert.astro';
import FlashMessage from '../../components/FlashMessage.astro';
import SideNav from '../../components/SideNav.astro';
import TopBar from '../../components/TopBar.astro';
import { ROLES } from '../../config/roles';
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

const token = Astro.locals.token ?? '';
const roleId = Number(Astro.locals.roleId ?? 0);
const isProfessional = roleId === ROLES.PROFESIONAL;
const canFilterByProfessional =
	roleId === ROLES.ADMIN || roleId === ROLES.RECEPCIONISTA;
const initialLoadError = token ? '' : 'No hay sesion valida para consultar clientes.';
---

<Layout>
	<customer-manager data-role-id={String(roleId)}>
		<div class="min-h-screen bg-(--page-background) transition-colors duration-300">
			<div
				class="app-shell grid min-h-screen overflow-hidden bg-transparent"
				data-app-shell
				data-sidebar-state="expanded"
			>
				<SideNav currentPath={Astro.url.pathname} />

				<div class="grid min-h-full grid-rows-[auto_1fr]">
					<TopBar />

					<main class="px-4 py-4 sm:px-6 sm:py-6">
						<section class="grid gap-4 sm:gap-5">
							{
								initialLoadError ? (
									<FlashMessage message={initialLoadError} type="error" expand={true} dismissible={false} />
								) : (
									<div class="grid gap-4 sm:gap-5">
										<header class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end sm:gap-4">
											<div class="grid gap-2">
												<h1 class="m-0 text-[1.5rem] font-bold leading-none tracking-tight text-(--on-surface) sm:text-[1.75rem]">
													Clientes
												</h1>
												<p class="text-[0.95rem] text-(--on-surface-variant) leading-relaxed">
													{
														isProfessional
															? 'Consulta los clientes registrados en tu agenda.'
															: canFilterByProfessional
																? 'Consulta los clientes registrados y filtralos por profesional.'
																: 'Consulta los clientes registrados.'
													}
												</p>
											</div>

											<div class="flex flex-wrap items-center gap-2">
												<a
													href="/api/customers/export"
													class="inline-flex items-center gap-1.5 rounded-full border border-(--shell-border) bg-(--surface-bright) px-4 py-2 text-[0.88rem] font-extrabold text-(--on-surface) no-underline transition hover:border-(--primary) hover:text-(--primary)"
													download
												>
													<span class="material-symbols-rounded text-[1.1rem]" aria-hidden="true">download</span>
													Exportar CSV
												</a>
												<div class="rounded-full border border-(--shell-border) bg-(--surface-bright) px-4 py-2 text-[0.88rem] font-extrabold text-(--on-surface)">
													<span data-customers-summary>0 clientes</span>
												</div>
											</div>
										</header>

										{
											!canFilterByProfessional ? (
												<select data-professional-filter hidden class="hidden" aria-hidden="true" tabindex="-1"></select>
											) : (
												<div class="grid gap-3 sm:max-w-xl">
													<label class="grid gap-1.5 text-[0.95rem] font-bold text-(--on-surface)">
														Profesional
														<select
															data-professional-filter
															class="cursor-pointer appearance-none w-full rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-4 py-3 text-[0.95rem] font-semibold outline-none transition hover:border-(--on-surface-variant) focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10 shadow-sm bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M7%2010l5%205%205-5%22%20stroke%3D%22%236b7280%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] bg-position-[calc(100%-12px)_center] bg-no-repeat pr-10"
														>
															<option value="">Todos los profesionales</option>
														</select>
													</label>
												</div>
											)
										}

										<div
											class="hidden rounded-2xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-[0.9rem] font-bold text-rose-500 shadow-sm"
											data-customers-error
										></div>

										<div
											class="hidden"
											data-customers-loading
											aria-busy="true"
											aria-label="Cargando clientes"
										>
											<div class="material-cards-grid gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
												{Array.from({ length: 6 }).map(() => (
													<article class="customer-card panel-skeleton-card" aria-hidden="true">
														<div class="flex items-start justify-between gap-4">
															<div class="panel-skeleton-line size-11 rounded-[0.85rem]"></div>
														</div>
														<div class="customer-card-body">
															<div class="panel-skeleton-line h-5 w-40 max-w-full rounded-md"></div>
															<div class="flex items-center justify-between gap-3 mt-1">
																<div class="panel-skeleton-line h-3.5 w-16 rounded"></div>
																<div class="panel-skeleton-line h-3.5 w-24 rounded"></div>
															</div>
														</div>
													</article>
												))}
											</div>
										</div>

										<div
											class="hidden customers-empty-state"
											data-customers-empty
										>
											<div class="customers-empty-icon">
												<span class="material-symbols-rounded text-[2rem]">inbox</span>
											</div>
											<h2 class="text-[1.1rem] font-bold text-(--on-surface)">No hay clientes registrados</h2>
											<p class="mt-1.5 max-w-sm text-[0.95rem] leading-relaxed text-(--on-surface-variant)">
												No hay clientes para mostrar con el filtro seleccionado.
											</p>
										</div>

										<div class="customers-grid material-cards-grid gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3" data-customers-grid></div>

										<div class="app-pagination">
											<p class="app-pagination__summary" data-customers-page-label>
												Pagina <strong>1</strong> de <strong>1</strong>
												<span aria-hidden="true">-</span>
												Total: <strong>0</strong> clientes
											</p>

											<nav class="app-pagination__controls" aria-label="Paginacion clientes">
												<button type="button" class="app-pagination__icon-button" data-customers-prev aria-label="Pagina anterior">
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6z"></path>
													</svg>
												</button>

												<span class="app-pagination__current" aria-current="page" data-customers-current-page>1</span>

												<button type="button" class="app-pagination__icon-button" data-customers-next aria-label="Pagina siguiente">
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"></path>
													</svg>
												</button>
											</nav>
										</div>
									</div>
								)
							}
						</section>
					</main>
				</div>
			</div>
		</div>

		<dialog
			class="relative m-0 mt-auto mb-0 w-screen max-w-none sm:m-auto sm:w-[min(48rem,calc(100vw-2rem))] sm:max-w-[min(48rem,calc(100vw-2rem))] open:flex open:flex-col max-h-[85vh] sm:max-h-[90vh] overflow-hidden rounded-t-[1.8rem] rounded-b-none sm:rounded-[1.8rem] border border-(--shell-border) bg-(--surface-bright) p-0 text-(--on-surface) shadow-[0_24px_80px_rgba(0,0,0,0.2)]"
			data-customer-profile-modal
		>
			<div
				class="shrink-0 z-10 border-b border-(--shell-border) bg-(--surface-bright) px-4 py-3 sm:px-7 sm:py-6"
			>
				<div class="flex items-start justify-between gap-4">
					<div class="flex min-w-0 items-center gap-4">
						<div
							class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-(--primary-soft) text-(--primary)"
						>
							<span class="material-symbols-rounded text-[1.4rem]">person</span>
						</div>
						<div class="min-w-0">
							<h2
								class="truncate text-[1.2rem] font-extrabold tracking-tight text-(--on-surface)"
								data-customer-profile-name
							>
								Cliente
							</h2>
							<p
								class="customer-profile-scope hidden"
								data-customer-profile-scope
							>
								<span
									class="material-symbols-rounded customer-profile-scope-icon"
									data-customer-profile-scope-icon
									aria-hidden="true"
								>public</span>
								<span
									class="customer-profile-scope-label"
									data-customer-profile-scope-label
								></span>
							</p>
						</div>
					</div>
					<button
						type="button"
						class="flex size-9 shrink-0 items-center justify-center rounded-full text-(--on-surface-variant) transition-colors hover:bg-(--surface-variant) hover:text-(--on-surface) focus:outline-none focus:ring-2 focus:ring-(--primary)"
						data-close-customer-profile-modal
						aria-label="Cerrar modal"
					>
						<span class="material-symbols-rounded text-[1.3rem]">close</span>
					</button>
				</div>
			</div>

			<div
				class="customer-profile-tabs shrink-0 border-b border-(--shell-border) bg-(--surface-bright) px-4 pt-1 pb-3 sm:px-7"
				data-customer-profile-tabs
			>
				<div class="customer-profile-tablist" role="tablist" aria-label="Secciones del perfil">
					<button
						type="button"
						class="customer-profile-tab is-active"
						role="tab"
						id="customer-profile-tab-summary"
						aria-selected="true"
						aria-controls="customer-profile-panel-summary"
						data-customer-profile-tab="summary"
						tabindex="0"
					>
						Resumen
					</button>
					<button
						type="button"
						class="customer-profile-tab"
						role="tab"
						id="customer-profile-tab-history"
						aria-selected="false"
						aria-controls="customer-profile-panel-history"
						data-customer-profile-tab="history"
						tabindex="-1"
					>
						Historial de citas
					</button>
				</div>
			</div>

			<div
				class="relative flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-contain bg-(--surface)/30 px-4 py-4 sm:px-7 sm:py-5"
			>
				<div
					class="hidden rounded-2xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-[0.9rem] font-bold text-rose-500 shadow-sm"
					data-customer-profile-error
				></div>

				<div class="hidden grid gap-4" data-customer-profile-body>
					<div
						class="customer-profile-tab-panel grid gap-4"
						role="tabpanel"
						id="customer-profile-panel-summary"
						aria-labelledby="customer-profile-tab-summary"
						data-customer-profile-tab-panel="summary"
					>
					<section class="customer-profile-meta">
						<div class="customer-profile-field-row">
							<span class="customer-profile-field-term">Teléfono</span>
							<span
								class="customer-profile-field-value customer-profile-field-value--emphasize"
								data-customer-profile-phone
							>—</span>
						</div>
						<div class="customer-profile-field-row">
							<span class="customer-profile-field-term">Registrado</span>
							<span
								class="customer-profile-field-value"
								data-customer-profile-registered
							>—</span>
						</div>
					</section>

					<section class="customer-profile-metrics">
						<article class="customer-profile-stat-card">
							<p class="text-[0.82rem] font-bold uppercase tracking-wide text-(--on-surface-variant)">
								Asistencia
							</p>
							<div class="mt-1 flex items-center gap-3">
								<span
									class="customer-profile-attendance-dot"
									data-customer-profile-attendance-dot
									aria-hidden="true"
								></span>
								<p
									class="text-[1.5rem] font-extrabold leading-tight text-(--on-surface)"
									data-customer-profile-attendance-rate
								>
									—
								</p>
							</div>
							<p
								class="customer-profile-stat-hint"
								data-customer-profile-attendance-detail
							></p>
						</article>

						<article class="customer-profile-stat-card">
							<p class="text-[0.82rem] font-bold uppercase tracking-wide text-(--on-surface-variant)">
								Ingresos totales
							</p>
							<p
								class="mt-1 text-[1.5rem] font-extrabold leading-tight text-(--on-surface)"
								data-customer-profile-ltv
							>
								Gs. 0
							</p>
							<p class="customer-profile-stat-hint">
								Suma el precio de citas <strong>confirmadas</strong> o
								<strong>completadas</strong> que ya ocurrieron. No incluye pendientes ni
								canceladas.
							</p>
						</article>
					</section>

					<section
						class="customer-profile-section hidden"
						data-customer-profile-profitability-wrap
					>
						<h3 class="customer-profile-section-title flex items-center gap-1.5">
							<span class="material-symbols-rounded text-[1.1rem] text-(--primary)" aria-hidden="true">trending_up</span>
							Rentabilidad
							<span class="ml-1 inline-flex items-center gap-1 rounded-full bg-(--primary-soft) px-2 py-0.5 text-[0.68rem] font-bold text-(--primary)">Premium</span>
						</h3>
						<section class="customer-profile-metrics">
							<article class="customer-profile-stat-card">
								<p class="text-[0.82rem] font-bold uppercase tracking-wide text-(--on-surface-variant)">
									Ingreso promedio
								</p>
								<p
									class="mt-1 text-[1.5rem] font-extrabold leading-tight text-(--on-surface)"
									data-customer-profile-avg-ticket
								>
									Gs. 0
								</p>
								<p class="customer-profile-stat-hint">Promedio por cita atendida.</p>
							</article>

							<article class="customer-profile-stat-card">
								<p class="text-[0.82rem] font-bold uppercase tracking-wide text-(--on-surface-variant)">
									Pérdida por ausencias
								</p>
								<p
									class="mt-1 text-[1.5rem] font-extrabold leading-tight text-(--on-surface)"
									data-customer-profile-lost-value
								>
									Gs. 0
								</p>
								<p class="customer-profile-stat-hint">Ingresos no realizados por cancelaciones.</p>
							</article>
						</section>
					</section>

					<section class="customer-profile-section">
						<h3 class="customer-profile-section-title">Reservas</h3>
						<div
							class="customer-profile-reservation-cards"
							data-customer-profile-reservations
						>
							<article class="customer-profile-reservation-card">
								<p class="customer-profile-reservation-card__label">Última cita</p>
								<div
									class="customer-profile-reservation-card__body"
									data-customer-profile-last
								>
									<span class="customer-profile-reservation-card__empty">Sin reservas atendidas</span>
								</div>
							</article>
							<article
								class="customer-profile-reservation-card customer-profile-reservation-card--next"
							>
								<p
									class="customer-profile-reservation-card__label customer-profile-reservation-card__label--next"
								>
									Próxima cita
								</p>
								<div
									class="customer-profile-reservation-card__body"
									data-customer-profile-next
								>
									<span class="customer-profile-reservation-card__empty">Sin reserva confirmada</span>
								</div>
							</article>
						</div>
						<div
							class="customer-profile-pending-block hidden"
							data-customer-profile-pending-wrap
						>
							<p class="customer-profile-reservation-card__label">Pendientes</p>
							<div class="grid gap-2 mt-1.5" data-customer-profile-pending-list></div>
						</div>
					</section>

					<section class="customer-profile-section">
						<h3 class="customer-profile-section-title">Servicios habituales</h3>
						<div class="flex flex-wrap gap-2" data-customer-profile-services></div>
					</section>
					</div>

					<div
						class="customer-profile-tab-panel hidden grid gap-3"
						role="tabpanel"
						id="customer-profile-panel-history"
						aria-labelledby="customer-profile-tab-history"
						data-customer-profile-tab-panel="history"
						hidden
					>
						<div class="grid gap-2" data-customer-profile-history-list></div>
						<p
							class="m-0 hidden text-[0.88rem] font-medium text-(--on-surface-variant)"
							data-customer-profile-history-empty
						>
							Todavía no hay citas atendidas.
						</p>
					</div>
				</div>
			</div>

			<div
				class="customer-profile-modal-footer shrink-0 border-t border-(--shell-border) bg-(--surface-bright) px-4 py-4 sm:px-7"
			>
				<button
					type="button"
					class="modal-action-secondary w-full sm:ml-auto sm:w-auto"
					data-close-customer-profile-modal
				>
					Cerrar
				</button>
			</div>

			<div
				class="pointer-events-none absolute inset-0 z-20 hidden flex items-center justify-center px-6 py-20 sm:px-8 sm:py-24 bg-(--surface-bright)/82 backdrop-blur-[2px]"
				data-customer-profile-loading
				aria-hidden="true"
			>
				<div
					class="inline-flex items-center gap-3 rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-5 py-3.5 text-[0.95rem] font-extrabold text-(--on-surface) shadow-[0_12px_32px_rgba(0,0,0,0.12)]"
					role="status"
					aria-live="polite"
				>
					<span class="material-symbols-rounded animate-spin text-[1.2rem] text-(--primary)"
						>progress_activity</span
					>
					Cargando perfil...
				</div>
			</div>
		</dialog>
	</customer-manager>

	<AppAlert />
</Layout>

<script>
	import '../../scripts/customers-page';
</script>

<style is:global>
	customer-manager {
		display: block;
	}

	.customers-grid {
		align-items: stretch;
	}

	.customers-empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 1.35rem;
		border: 1px solid rgba(148, 163, 184, 0.24);
		background: color-mix(in srgb, var(--surface-container-low) 72%, var(--surface-bright) 28%);
		padding: 2.5rem 1.25rem;
		text-align: center;
	}

	.customers-empty-state.hidden {
		display: none;
	}

	.customers-empty-icon {
		margin-bottom: 1rem;
		display: flex;
		height: 4rem;
		width: 4rem;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container) 88%, var(--surface-bright) 12%);
		color: var(--on-surface-variant);
	}

	.customer-card {
		cursor: pointer;
	}

	.customer-card-value {
		font-weight: 700;
	}

	.customer-profile-modal-footer {
		display: none;
	}

	@media (min-width: 768px) {
		.customer-profile-modal-footer {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
		}
	}

	dialog[data-customer-profile-modal] {
		--modal-open-duration: 150ms;
		animation: customer-profile-modal-in var(--modal-open-duration, 150ms)
			var(--modal-easing, cubic-bezier(0.16, 1, 0.3, 1));
	}

	dialog[data-customer-profile-modal]::backdrop {
		animation: customer-profile-backdrop-in var(--modal-open-duration, 150ms) ease;
	}

	dialog[data-customer-profile-modal].is-closing {
		animation: customer-profile-modal-out 140ms ease forwards;
	}

	dialog[data-customer-profile-modal].is-closing::backdrop {
		animation: customer-profile-backdrop-out 140ms ease forwards;
	}

	@keyframes customer-profile-modal-in {
		from {
			opacity: 0;
			transform: translateY(12px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@keyframes customer-profile-modal-out {
		from {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
		to {
			opacity: 0;
			transform: translateY(8px) scale(0.98);
		}
	}

	@keyframes customer-profile-backdrop-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes customer-profile-backdrop-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

	.customer-profile-scope {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.55rem;
		max-width: 100%;
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--shell-border);
		background: color-mix(in srgb, var(--surface-container-low) 55%, var(--surface-bright) 45%);
		font-size: 0.76rem;
		font-weight: 700;
		line-height: 1.25;
		color: var(--on-surface-variant);
	}

	.customer-profile-scope-icon {
		font-size: 1rem;
		line-height: 1;
		color: var(--on-surface-variant);
	}

	.customer-profile-scope[data-scope='global'] .customer-profile-scope-icon {
		color: var(--primary);
	}

	.customer-profile-scope[data-scope='professional'] {
		background: color-mix(in srgb, var(--primary-soft) 52%, var(--surface-bright) 48%);
		border-color: color-mix(in srgb, var(--primary) 22%, var(--shell-border) 78%);
		color: color-mix(in srgb, var(--on-surface) 72%, var(--primary) 28%);
	}

	.customer-profile-scope[data-scope='professional'] .customer-profile-scope-icon {
		color: var(--primary);
	}

	.customer-profile-scope-label {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.customer-profile-meta {
		display: grid;
		gap: 0.45rem;
		border-radius: 1rem;
		border: 1px solid var(--shell-border);
		background: var(--surface-bright);
