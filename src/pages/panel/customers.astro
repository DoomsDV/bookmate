	dialog[data-customer-profile-modal] {
		--modal-open-duration: 150ms;
		position: fixed;
		inset: 0;
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		box-shadow: none;
		overflow: hidden;
		animation: customer-profile-modal-in var(--modal-open-duration, 150ms)
			var(--modal-easing, cubic-bezier(0.16, 1, 0.3, 1));
	}

	dialog[data-customer-profile-modal][open] {
		display: flex;
	}

	/* Misma altura al cambiar entre Resumen e Historial de citas */
	dialog[data-customer-profile-modal][open] .customer-profile-modal__panel {
		min-height: min(85vh, 36rem);
	}

	@media (min-width: 640px) {
		dialog[data-customer-profile-modal][open] .customer-profile-modal__panel {
			min-height: min(90vh, 40rem);
		}
	}

	.customer-profile-modal-body {
		flex: 1 1 auto;
		min-height: 0;
	}

	.customer-profile-tab-panel[data-customer-profile-tab-panel='history']:not([hidden]) {
		min-height: 100%;
		align-content: start;
	}

	.customer-profile-tab-panel[data-customer-profile-tab-panel='history']:has(
		[data-customer-profile-history-empty]:not(.hidden)
	) {
		align-content: center;
	}

	dialog[data-customer-profile-modal]::backdrop {
		animation: customer-profile-backdrop-in var(--modal-open-duration, 150ms) ease;
	}

	dialog[data-customer-profile-modal].is-closing {
		animation: customer-profile-modal-out 140ms ease forwards;
	}

	dialog[data-customer-profile-modal].is-closing::backdrop {
		animation: customer-profile-backdrop-out 140ms ease forwards;
	}

	@keyframes customer-profile-modal-in {
		from {
			opacity: 0;
			transform: translateY(100%);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes customer-profile-modal-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(100%);
		}
	}

	@media (min-width: 640px) and (max-width: 1023px) {
		@keyframes customer-profile-modal-in {
			from {
				opacity: 0;
				transform: translateY(12px) scale(0.98);
			}
			to {
				opacity: 1;
				transform: translateY(0) scale(1);
			}
		}

		@keyframes customer-profile-modal-out {
			from {
				opacity: 1;
				transform: translateY(0) scale(1);
			}
			to {
				opacity: 0;
				transform: translateY(8px) scale(0.98);
			}
		}
	}

	/* Desktop PC: side drawer a la derecha (mismo slide que Servicios) */
	@media (min-width: 1024px) {
		dialog[data-customer-profile-modal][open] {
			flex-direction: row;
			align-items: stretch;
			justify-content: flex-end;
		}

		dialog[data-customer-profile-modal][open] .customer-profile-modal__panel {
			min-height: 100dvh;
			margin-left: auto;
		}

		dialog[data-customer-profile-modal] {
			animation-name: customer-profile-drawer-in;
		}

		dialog[data-customer-profile-modal].is-closing {
			animation-name: customer-profile-drawer-out;
		}

		dialog[data-customer-profile-modal]::backdrop {
			background-color: var(--modal-backdrop-scrim);
			backdrop-filter: blur(var(--modal-backdrop-blur));
			-webkit-backdrop-filter: blur(var(--modal-backdrop-blur));
		}
	}

	@keyframes customer-profile-drawer-in {
		from {
			opacity: 0;
			transform: translateX(100%);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@keyframes customer-profile-drawer-out {
		from {
			opacity: 1;
			transform: translateX(0);
		}
		to {
			opacity: 0;
			transform: translateX(100%);
		}
	}

	@keyframes customer-profile-backdrop-in {
		from {
			opacity: 0;
			backdrop-filter: blur(0);
			-webkit-backdrop-filter: blur(0);
		}
		to {
			opacity: 1;
			backdrop-filter: blur(var(--modal-backdrop-blur));
			-webkit-backdrop-filter: blur(var(--modal-backdrop-blur));
		}
	}

	@keyframes customer-profile-backdrop-out {
		from {
			opacity: 1;
			backdrop-filter: blur(var(--modal-backdrop-blur));
			-webkit-backdrop-filter: blur(var(--modal-backdrop-blur));
		}
		to {
			opacity: 0;
			backdrop-filter: blur(0);
			-webkit-backdrop-filter: blur(0);
		}
	}

