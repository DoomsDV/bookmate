---
import AppAlert from '../../components/AppAlert.astro';
import AppPagination from '../../components/AppPagination.astro';
import FileViewer from '../../components/FileViewer.astro';
import FlashMessage from '../../components/FlashMessage.astro';
import SideNav from '../../components/SideNav.astro';
import TopBar from '../../components/TopBar.astro';
import { ROLES } from '../../config/roles';
import Layout from '../../layouts/Layout.astro';
import { panelPageTitle } from '../../lib/panel-page-title';
import '../../styles/global.css';

const token = Astro.locals.token ?? '';
const roleId = Number(Astro.locals.roleId ?? 0);
const organizationName = String(
	Astro.locals.organizationName || Astro.cookies.get('org_name')?.value || ''
).trim();
const organizationLogoUrl = String(
	Astro.locals.organizationLogoUrl || Astro.cookies.get('org_logo_url')?.value || ''
).trim();
const isProfessional = roleId === ROLES.PROFESIONAL;
const canFilterByProfessional =
	roleId === ROLES.ADMIN || roleId === ROLES.RECEPCIONISTA;
const initialLoadError = token ? '' : 'No hay sesion valida para consultar clientes.';
---

<Layout pageTitle={panelPageTitle('Clientes')}>
	<customer-manager
		data-role-id={String(roleId)}
		data-org-name={organizationName}
		data-org-logo-url={organizationLogoUrl}
	>
		<div class="min-h-screen bg-(--page-background)">
			<div
				class="app-shell grid min-h-screen overflow-hidden bg-transparent"
				data-app-shell
				data-sidebar-state="expanded"
			>
				<SideNav currentPath={Astro.url.pathname} />

				<div class="grid min-h-full grid-rows-[auto_1fr]">
					<TopBar />

					<main class="px-4 py-4 sm:px-6 sm:py-6">
						<section class="grid gap-4 sm:gap-5">
							{
								initialLoadError ? (
									<FlashMessage message={initialLoadError} type="error" expand={true} dismissible={false} />
								) : (
									<div class="grid gap-3 sm:gap-4">
										<header class="grid gap-1">
											<h1 class="m-0 text-[1.5rem] font-bold leading-none tracking-tight text-(--on-surface) sm:text-[1.75rem]">
												Clientes{' '}
												<span
													class="font-semibold text-(--on-surface-variant)"
													data-customers-summary
												>(0)</span>
											</h1>
											<p class="m-0 hidden text-[0.88rem] leading-snug text-(--on-surface-variant) sm:block">
												{
													isProfessional
														? 'Clientes registrados en tu agenda.'
														: canFilterByProfessional
															? 'Buscá por nombre o teléfono y filtrá por profesional.'
															: 'Clientes registrados en el consultorio.'
												}
											</p>
										</header>

										<select
											data-professional-filter
											hidden
											class="hidden"
											aria-hidden="true"
											tabindex="-1"
										></select>

										<div class="flex max-w-xl items-center gap-2">
											<div class="relative min-w-0 flex-1" data-panel-search>
												<span
													class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-(--on-surface-variant)"
													aria-hidden="true"
												>
													<span class="material-symbols-rounded text-[1.2rem]">search</span>
												</span>
												<input
													type="text"
													inputmode="search"
													enterkeyhint="search"
													data-customers-search
													placeholder="Buscar por nombre o teléfono"
													aria-label="Buscar por nombre o teléfono"
													autocomplete="off"
													class="w-full rounded-2xl border border-(--shell-border) bg-(--surface-bright) py-2.5 pl-11 pr-11 text-[0.95rem] font-semibold text-(--on-surface) outline-none transition placeholder:font-medium placeholder:text-(--on-surface-variant)/70 hover:border-(--on-surface-variant) focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10 shadow-sm"
												/>
												<button
													type="button"
													class="panel-search-clear"
													data-panel-search-clear
													hidden
													aria-label="Limpiar búsqueda"
												>
													<span class="material-symbols-rounded" aria-hidden="true">close</span>
												</button>
											</div>

											{
												canFilterByProfessional ? (
													<div class="customers-pro-filter relative shrink-0">
														<button
															type="button"
															class="customers-pro-filter-btn relative flex size-11 shrink-0 items-center justify-center rounded-2xl border border-(--shell-border) bg-(--surface-bright) text-(--on-surface-variant) shadow-sm transition hover:border-(--on-surface-variant) hover:text-(--on-surface) focus:border-(--primary) focus:outline-none focus:ring-4 focus:ring-(--primary)/10"
															data-open-pro-filter
															aria-label="Filtrar por profesional"
															aria-haspopup="dialog"
															aria-controls="customers-pro-filter-sheet"
															aria-expanded="false"
															aria-pressed="false"
														>
															<span class="material-symbols-rounded text-[1.25rem]" aria-hidden="true">tune</span>
															<span
																class="customers-pro-filter-badge hidden"
																data-pro-filter-badge
																aria-hidden="true"
															></span>
														</button>
													</div>
												) : null
											}

											<a
												href="/api/customers/export"
												class="flex size-11 shrink-0 items-center justify-center rounded-2xl border border-(--shell-border) bg-(--surface-bright) text-(--on-surface-variant) no-underline shadow-sm transition hover:border-(--on-surface-variant) hover:text-(--on-surface) focus:border-(--primary) focus:outline-none focus:ring-4 focus:ring-(--primary)/10"
												download
												aria-label="Exportar CSV"
												title="Exportar CSV"
											>
												<span class="material-symbols-rounded text-[1.25rem]" aria-hidden="true">download</span>
											</a>
										</div>

										<div
											class="hidden rounded-2xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-[0.9rem] font-bold text-rose-500 shadow-sm"
											data-customers-error
										></div>

										<div
											class="hidden"
											data-customers-loading
											aria-busy="true"
											aria-label="Cargando clientes"
										>
											<div class="material-cards-grid gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
												{Array.from({ length: 6 }).map(() => (
													<article class="customer-card panel-skeleton-card" aria-hidden="true">
														<div class="customer-card__inner">
															<div class="customer-card__identity">
																<div class="panel-skeleton-line size-12 rounded-full"></div>
																<div class="customer-card-body">
																	<div class="panel-skeleton-line h-5 w-40 max-w-full rounded-md"></div>
																	<div class="panel-skeleton-line h-3.5 w-28 max-w-full rounded"></div>
																</div>
															</div>
															<div class="customer-card__contact">
																<div class="panel-skeleton-line h-3.5 w-16 rounded"></div>
																<div class="panel-skeleton-line h-3.5 w-24 rounded"></div>
															</div>
														</div>
													</article>
												))}
											</div>
										</div>

										<div
											class="hidden customers-empty-state"
											data-customers-empty
											role="status"
										>
											<div class="customers-empty-icon">
												<span class="material-symbols-rounded text-[2rem]" data-customers-empty-icon>group_off</span>
											</div>
											<h2 class="text-[1.1rem] font-bold text-(--on-surface)" data-customers-empty-title>
												No hay clientes para mostrar
											</h2>
											<p
												class="mt-1.5 max-w-sm text-[0.95rem] leading-relaxed text-(--on-surface-variant)"
												data-customers-empty-copy
											>
												Cuando registres citas, tus clientes aparecerán aquí.
											</p>
										</div>

										<div class="customers-grid material-cards-grid gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3" data-customers-grid></div>

										<AppPagination
											currentPage={1}
											totalPages={1}
											totalRecords={0}
											recordLabel="clientes"
											ariaLabel="Paginacion clientes"
											rootDataAttr="data-customers-pagination"
											summaryDataAttr="data-customers-page-label"
											pagesDataAttr="data-customers-pagination-pages"
											prevDataAttr="data-customers-prev"
											nextDataAttr="data-customers-next"
											pageDataAttr="data-customers-page"
										/>
									</div>
								)
							}
						</section>
					</main>
				</div>
			</div>
		</div>

		<dialog
			id="customers-pro-filter-sheet"
			class="customers-pro-filter-sheet"
			data-pro-filter-sheet
			aria-labelledby="customers-pro-filter-title"
		>
			<div class="customers-pro-filter-sheet__handle" aria-hidden="true">
				<span></span>
			</div>
			<div class="customers-pro-filter-sheet__header">
				<h2 id="customers-pro-filter-title" class="m-0 text-[1.05rem] font-extrabold tracking-tight">
					Filtros
				</h2>
				<button
					type="button"
					class="customers-pro-filter-sheet__close flex size-9 shrink-0 items-center justify-center rounded-full text-(--on-surface-variant) transition-colors hover:bg-(--surface-variant) hover:text-(--on-surface)"
					data-close-pro-filter
					aria-label="Cerrar filtro"
				>
					<span class="material-symbols-rounded text-[1.3rem]">close</span>
				</button>
			</div>
			<div class="customers-pro-filter-sheet__body">
				<p class="customers-pro-filter-field-label" id="customers-pro-filter-field-label">
					Profesional
				</p>
				<div
					class="customers-pro-filter-sheet__list"
					data-pro-filter-list
					role="listbox"
					aria-labelledby="customers-pro-filter-field-label"
					aria-label="Profesionales"
				></div>
			</div>
		</dialog>

		<dialog
			class="customer-profile-modal m-0 max-h-none w-screen max-w-none border-0 bg-transparent p-0 text-(--on-surface) shadow-none open:flex open:flex-col open:items-stretch open:justify-end sm:open:items-center sm:open:justify-center lg:open:flex-row lg:open:items-stretch lg:open:justify-end"
			data-customer-profile-modal
		>
			<div
				class="customer-profile-modal__panel relative flex h-[90dvh] max-h-[90dvh] w-full max-w-none flex-col overflow-hidden rounded-t-[1.8rem] rounded-b-none border border-(--shell-border) bg-(--surface-bright) shadow-[0_24px_80px_rgba(0,0,0,0.2)] sm:h-auto sm:max-h-[90vh] sm:w-[min(48rem,calc(100vw-2rem))] sm:max-w-[min(48rem,calc(100vw-2rem))] sm:rounded-[1.8rem] lg:h-[100dvh] lg:max-h-[100dvh] lg:w-[max(50vw,40rem)] lg:max-w-[max(50vw,40rem)] lg:rounded-none lg:border-y-0 lg:border-r-0 lg:shadow-none"
				data-customer-profile-panel
			>
			<div class="panel-modal-header panel-modal-header--shadow">
				<div class="panel-modal-header__row">
					<div class="panel-modal-header__leading">
						<div
							class="customer-card-avatar customer-card-avatar--tone-1 panel-modal-header__avatar"
							data-customer-profile-avatar
							aria-hidden="true"
						>
							?
						</div>
						<div class="panel-modal-header__text">
							<h2 class="panel-modal-header__title truncate" data-customer-profile-name>
								Cliente
							</h2>
							<p
								class="customer-profile-scope hidden"
								data-customer-profile-scope
							>
								<span
									class="material-symbols-rounded customer-profile-scope-icon"
									data-customer-profile-scope-icon
									aria-hidden="true"
								>public</span>
								<span
									class="customer-profile-scope-label"
									data-customer-profile-scope-label
								></span>
							</p>
						</div>
					</div>
					<div class="panel-modal-header__actions">
						<button
							type="button"
							class="settings-toolbar-help inline-flex shrink-0 items-center justify-center gap-2 rounded-full border border-(--shell-border) bg-(--surface-bright) px-[0.72rem] py-[0.72rem] text-[0.9rem] font-bold text-(--on-surface) transition focus:outline-none focus:ring-2 focus:ring-(--primary)/25 sm:px-[1.05rem]"
							data-customer-odontogram-tour-help
							aria-label="Guía del odontograma"
							hidden
						>
							<span class="material-symbols-rounded text-[1.12rem]">help</span>
							<span class="hidden sm:inline">Guía</span>
						</button>
						<button
							type="button"
							class="panel-modal-header__close"
							data-close-customer-profile-modal
							aria-label="Cerrar modal"
						>
							<span class="material-symbols-rounded">close</span>
						</button>
					</div>
				</div>
			</div>

			<div
				class="customer-profile-tabs shrink-0 border-b border-(--shell-border) bg-(--surface-bright) px-4 py-3 sm:px-7"
				data-customer-profile-tabs
			>
				<div class="customer-profile-tablist" role="tablist" aria-label="Secciones del perfil">
					<button
						type="button"
						class="customer-profile-tab is-active"
						role="tab"
						id="customer-profile-tab-summary"
						aria-selected="true"
						aria-controls="customer-profile-panel-summary"
						data-customer-profile-tab="summary"
						tabindex="0"
					>
						Resumen
					</button>
					<button
						type="button"
						class="customer-profile-tab"
						role="tab"
						id="customer-profile-tab-history"
						aria-selected="false"
						aria-controls="customer-profile-panel-history"
						data-customer-profile-tab="history"
						tabindex="-1"
					>
						<span class="customer-profile-tab__label-full">Historial de reservas</span>
						<span class="customer-profile-tab__label-short">Historial</span>
					</button>
					<button
						type="button"
						class="customer-profile-tab customer-profile-tab--odontogram"
						role="tab"
						id="customer-profile-tab-odontogram"
						aria-selected="false"
						aria-controls="customer-profile-panel-odontogram"
						data-customer-profile-tab="odontogram"
						tabindex="-1"
					>
						<span class="customer-profile-tab__label-full">Odontograma</span>
						<span class="customer-profile-tab__label-short">Odonto</span>
						<span class="customer-profile-tab__badge" aria-hidden="true">Nuevo</span>
					</button>
				</div>
			</div>

			<div
				class="customer-profile-modal-body relative flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-contain bg-(--surface)/30 px-4 py-4 sm:px-7 sm:py-5"
			>
				<div
					class="hidden rounded-2xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-[0.9rem] font-bold text-rose-500 shadow-sm"
					data-customer-profile-error
				></div>

				<div class="hidden grid gap-4" data-customer-profile-body>
					<div
						class="customer-profile-tab-panel grid gap-4"
						role="tabpanel"
						id="customer-profile-panel-summary"
						aria-labelledby="customer-profile-tab-summary"
						data-customer-profile-tab-panel="summary"
					>
					<section class="customer-profile-meta">
						<div class="customer-profile-field-row">
							<span class="customer-profile-field-term">Teléfono</span>
							<span
								class="customer-profile-field-value customer-profile-field-value--emphasize"
								data-customer-profile-phone
							>—</span>
						</div>
						<div class="customer-profile-field-row">
							<span class="customer-profile-field-term">Registrado</span>
							<span
								class="customer-profile-field-value"
								data-customer-profile-registered
							>—</span>
						</div>
					</section>

					<section class="customer-profile-metrics">
						<article class="customer-profile-stat-card">
							<p class="text-[0.82rem] font-bold uppercase tracking-wide text-(--on-surface-variant)">
								Asistencia
							</p>
							<div class="mt-1 flex items-center gap-3">
								<span
									class="customer-profile-attendance-dot"
									data-customer-profile-attendance-dot
									aria-hidden="true"
								></span>
								<p
									class="text-[1.5rem] font-extrabold leading-tight text-(--on-surface)"
									data-customer-profile-attendance-rate
								>
									—
								</p>
							</div>
							<p
								class="customer-profile-stat-hint"
								data-customer-profile-attendance-detail
							></p>
						</article>

						<article class="customer-profile-stat-card">
							<p class="text-[0.82rem] font-bold uppercase tracking-wide text-(--on-surface-variant)">
								Ingresos totales
							</p>
							<p
								class="mt-1 text-[1.5rem] font-extrabold leading-tight text-(--on-surface)"
								data-customer-profile-ltv
							>
								Gs. 0
							</p>
							<p class="customer-profile-stat-hint">
								Suma el precio de citas <strong>confirmadas</strong> o
								<strong>completadas</strong> que ya ocurrieron. No incluye pendientes ni
								canceladas.
							</p>
						</article>
					</section>

					<section
						class="customer-profile-section hidden"
						data-customer-profile-profitability-wrap
					>
						<h3 class="customer-profile-section-title flex items-center gap-1.5">
							<span class="material-symbols-rounded text-[1.1rem] text-(--primary)" aria-hidden="true">trending_up</span>
							Rentabilidad
						</h3>
						<section class="customer-profile-metrics">
							<article class="customer-profile-stat-card">
								<p class="text-[0.82rem] font-bold uppercase tracking-wide text-(--on-surface-variant)">
									Ingreso promedio
								</p>
								<p
									class="mt-1 text-[1.5rem] font-extrabold leading-tight text-(--on-surface)"
									data-customer-profile-avg-ticket
								>
									Gs. 0
								</p>
								<p class="customer-profile-stat-hint">Promedio por cita atendida.</p>
							</article>

							<article class="customer-profile-stat-card">
								<p class="text-[0.82rem] font-bold uppercase tracking-wide text-(--on-surface-variant)">
									Pérdida por ausencias
								</p>
								<p
									class="mt-1 text-[1.5rem] font-extrabold leading-tight text-(--on-surface)"
									data-customer-profile-lost-value
								>
									Gs. 0
								</p>
								<p class="customer-profile-stat-hint">Ingresos no realizados por cancelaciones.</p>
							</article>
						</section>
					</section>

					<section class="customer-profile-section">
						<h3 class="customer-profile-section-title">Reservas</h3>
						<div
							class="customer-profile-reservation-cards"
							data-customer-profile-reservations
						>
							<article class="customer-profile-reservation-card">
								<p class="customer-profile-reservation-card__label">Última cita</p>
								<div
									class="customer-profile-reservation-card__body"
									data-customer-profile-last
								>
									<span class="customer-profile-reservation-card__empty">Sin reservas atendidas</span>
								</div>
							</article>
							<article
								class="customer-profile-reservation-card customer-profile-reservation-card--next"
							>
								<p
									class="customer-profile-reservation-card__label customer-profile-reservation-card__label--next"
								>
									Próxima cita
								</p>
								<div
									class="customer-profile-reservation-card__body"
									data-customer-profile-next
								>
									<span class="customer-profile-reservation-card__empty">Sin reserva confirmada</span>
								</div>
							</article>
						</div>
						<div
							class="customer-profile-pending-block hidden"
							data-customer-profile-pending-wrap
						>
							<p class="customer-profile-reservation-card__label">Pendientes</p>
							<div class="grid gap-2 mt-1.5" data-customer-profile-pending-list></div>
						</div>
					</section>

					<section class="customer-profile-section">
						<h3 class="customer-profile-section-title">Servicios habituales</h3>
						<div class="flex flex-wrap gap-2" data-customer-profile-services></div>
					</section>
					</div>

					<div
						class="customer-profile-tab-panel hidden grid gap-3"
						role="tabpanel"
						id="customer-profile-panel-history"
						aria-labelledby="customer-profile-tab-history"
						data-customer-profile-tab-panel="history"
						hidden
					>
						<div class="customer-profile-timeline" data-customer-profile-history-list></div>
						<div
							class="customer-profile-history-empty hidden"
							data-customer-profile-history-empty
							role="status"
						>
							<div class="customer-profile-history-empty__icon" aria-hidden="true">
								<span class="material-symbols-rounded">event_busy</span>
							</div>
							<p class="customer-profile-history-empty__title">Todavía no hay citas atendidas.</p>
							<p class="customer-profile-history-empty__copy">
								Cuando completes citas con este cliente, aparecerán aquí.
							</p>
						</div>
					</div>

					<div
						class="customer-profile-tab-panel hidden grid gap-4"
						role="tabpanel"
						id="customer-profile-panel-odontogram"
						aria-labelledby="customer-profile-tab-odontogram"
						data-customer-profile-tab-panel="odontogram"
						hidden
					>
						<div
							class="customer-odontogram-lock hidden rounded-2xl border border-(--shell-border) bg-(--surface-bright)"
							data-customer-odontogram-lock
						>
							<div class="customer-odontogram-lock__icon" aria-hidden="true">
								<span class="material-symbols-rounded">dentistry</span>
							</div>
							<p class="customer-odontogram-lock__title">Odontograma</p>
							<p class="customer-odontogram-lock__copy">
								Llevá tu clínica al siguiente nivel con el odontograma. Activá el complemento para
								registrar caries, restauraciones y extracciones por pieza.
							</p>
							<div data-customer-odontogram-lock-action></div>
						</div>

						<div class="customer-odontogram-content hidden" data-customer-odontogram-content>
							<div class="customer-odontogram-stage" data-customer-odontogram-chart>
								<div
									class="customer-odontogram-viewport"
									data-customer-odontogram-viewport
								>
									<canvas
										data-customer-odontogram-canvas
										aria-label="Odontograma 3D"
									></canvas>
									<div
										class="customer-odontogram-cam"
										data-customer-odontogram-cam
										role="toolbar"
										aria-label="Controles de cámara"
									>
										<button
											type="button"
											class="customer-odontogram-cam__btn"
											data-odontogram-cam="reset"
											title="Restablecer vista"
											aria-label="Restablecer vista"
