---
import PublicProfileEditor from '../../components/PublicProfileEditor.astro';
import SideNav from '../../components/SideNav.astro';
import TopBar from '../../components/TopBar.astro';
import { ROLES } from '../../config/roles';
import Layout from '../../layouts/Layout.astro';
import { getPublicOrgHubWithOrds } from '../../lib/public-org-hub';
import { getWorkspaceSettingsWithOrds } from '../../lib/workspace-settings';
import '../../styles/global.css';
import '../../styles/public-org-hub.css';
import '../../styles/public-profile-editor.css';

const roleId = Number(Astro.locals.roleId ?? 0);
if (roleId !== ROLES.ADMIN) {
	return Astro.redirect('/panel/dashboard');
}

const token = String(Astro.locals.token || '').trim();
let workspace = null;
let hub = null;
let loadError = '';

try {
	workspace = await getWorkspaceSettingsWithOrds(token);
	try {
		if (workspace.profile_slug) {
			hub = await getPublicOrgHubWithOrds(workspace.profile_slug);
		}
	} catch {
		hub = null;
	}
} catch (error) {
	loadError =
		error instanceof Error
			? error.message
			: 'No fue posible cargar el perfil público.';
}

const organizationName =
	workspace?.name?.trim() ||
	String(Astro.locals.organizationName || '').trim() ||
	'Tu negocio';
---

<Layout pageTitle="Perfil Público | Hasel">
	<div class="min-h-screen bg-(--page-background) transition-colors duration-300">
		<div
			class="app-shell grid min-h-screen overflow-hidden bg-transparent"
			data-app-shell
			data-sidebar-state="expanded"
		>
			<SideNav currentPath={Astro.url.pathname} />

			<div class="grid min-h-full grid-rows-[auto_1fr]">
				<TopBar />

				<main class="px-4 py-4 sm:px-6 sm:py-6">
					{
						workspace ? (
							<PublicProfileEditor
								workspace={workspace}
								hub={hub}
								organizationName={organizationName}
							/>
						) : (
							<section class="rounded-2xl border border-(--shell-border) bg-(--surface-bright) p-6">
								<h1 class="text-xl font-extrabold">Perfil Público</h1>
								<p class="mt-2 text-(--on-surface-variant) font-semibold">
									{loadError || 'No fue posible cargar la configuración.'}
								</p>
							</section>
						)
					}
				</main>
			</div>
		</div>
	</div>
</Layout>
