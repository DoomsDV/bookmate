---
import PublicProfileEditorIsland from '../../components/PublicProfileEditorIsland.astro';
import PublicProfileEditorSkeleton from '../../components/PublicProfileEditorSkeleton.astro';
import SideNav from '../../components/SideNav.astro';
import TopBar from '../../components/TopBar.astro';
import { ROLES } from '../../config/roles';
import Layout from '../../layouts/Layout.astro';
import { panelPageTitle } from '../../lib/panel-page-title';
import '../../styles/global.css';
import '../../styles/public-org-hub.css';
import '../../styles/public-profile-editor.css';

const roleId = Number(Astro.locals.roleId ?? 0);
if (roleId !== ROLES.ADMIN) {
	return Astro.redirect('/panel/dashboard');
}
---

<Layout pageTitle={panelPageTitle('Perfil Público')}>
	<div class="min-h-screen bg-(--page-background) transition-colors duration-300">
		<div
			class="app-shell grid min-h-screen overflow-hidden bg-transparent"
			data-app-shell
			data-sidebar-state="expanded"
		>
			<SideNav currentPath={Astro.url.pathname} />

			<div class="grid h-full min-h-0 grid-rows-[auto_1fr]">
				<TopBar />

				<main class="ppe-main h-full min-h-0 px-4 py-4 sm:px-6 sm:py-6">
					<PublicProfileEditorIsland server:defer>
						<PublicProfileEditorSkeleton slot="fallback" />
					</PublicProfileEditorIsland>
				</main>
			</div>
		</div>
	</div>
</Layout>
