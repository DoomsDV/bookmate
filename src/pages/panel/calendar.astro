---
import AppAlert from '../../components/AppAlert.astro';
import AppointmentModalPanel from '../../components/AppointmentModalPanel.astro';
import AppointmentVoiceOverlay from '../../components/AppointmentVoiceOverlay.astro';
import AgendaScanPreview from '../../components/AgendaScanPreview.astro';
import FlashMessage from '../../components/FlashMessage.astro';
import SideNav from '../../components/SideNav.astro';
import TopBar from '../../components/TopBar.astro';
import { FEATURE_FLAGS } from '../../config/feature-flags';
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

const ENABLE_GOOGLE_CALENDAR = false;

const GOOGLE_PROVIDER = 'google_calendar';
const token = Astro.locals.token ?? '';
const initialLoadError = token ? '' : 'No hay sesi�n v�lida para consultar el calendario.';
const googleSuccessFlag = String(Astro.url.searchParams.get('success') || '').trim();
const googleErrorFlag = String(Astro.url.searchParams.get('error') || '').trim();
const googleDebugParam = String(Astro.url.searchParams.get('debug') || '').trim();
const showGoogleDebug = import.meta.env.DEV && Boolean(googleDebugParam);

let isGoogleConnected = false;
let googleStatusMessage = '';

const getIntegrationUrl = () => {
	const baseUrl = String(import.meta.env.ORDS_INTEGRATIONS_URL || '').trim();
	if (!baseUrl) return '';
	return `${baseUrl.replace(/\/+$/, '')}/${GOOGLE_PROVIDER}`;
};

const parseMessageFromResponse = async (response: Response) => {
	try {
		const payload = await response.json();
		if (payload && typeof payload === 'object' && 'message' in payload) {
			const message = String(payload.message || '').trim();
			if (message) return message;
		}
	} catch {
		// Ignore parse errors and fallback below.
	}
	return `Request failed with status ${response.status}.`;
};

if (ENABLE_GOOGLE_CALENDAR && !initialLoadError) {
	const integrationUrl = getIntegrationUrl();
	if (!integrationUrl) {
		googleStatusMessage = 'Falta configurar ORDS_INTEGRATIONS_URL para integrar Google Calendar.';
	} else {
		try {
			const response = await fetch(integrationUrl, {
				method: 'GET',
				headers: {
					Authorization: `Bearer ${token}`,
					Accept: 'application/json',
				},
			});

			if (response.status === 200) {
				isGoogleConnected = true;
			} else if (response.status === 404) {
				isGoogleConnected = false;
			} else {
				googleStatusMessage = await parseMessageFromResponse(response);
			}
		} catch (error) {
			console.error('[panel-calendar] google integration status error', error);
			googleStatusMessage = 'No fue posible consultar el estado de Google Calendar.';
		}
	}
}

const hasGoogleSuccess =
	ENABLE_GOOGLE_CALENDAR &&
	(googleSuccessFlag === 'google_connected' || googleSuccessFlag === 'google_disconnected');
const googleSuccessMessage =
	googleSuccessFlag === 'google_connected'
		? 'Google Calendar se conect� correctamente.'
		: googleSuccessFlag === 'google_disconnected'
			? 'Google Calendar se desconect� correctamente.'
			: '';

const hasGoogleError = ENABLE_GOOGLE_CALENDAR && Boolean(googleErrorFlag);
const googleErrorMessageMap: Record<string, string> = {
	google_connect_failed: 'No fue posible iniciar la conexi�n con Google.',
	google_oauth_error: 'Google devolvi� un error durante la autorizaci�n OAuth.',
	google_missing_code: 'Google no envi� el c�digo de autorizaci�n.',
	google_token_exchange_failed: 'Google no devolvi� tokens v�lidos al canjear el c�digo.',
	google_ords_payload_invalid: 'No se pudo construir el body JSON para guardar la integraci�n.',
	google_ords_save_failed: 'Google respondi�, pero no se pudieron guardar los tokens en ORDS.',
	google_callback_failed: 'No fue posible completar la conexi�n con Google Calendar.',
	google_disconnect_failed: 'No fue posible desconectar Google Calendar.',
};
const googleErrorMessage = hasGoogleError
	? (googleErrorMessageMap[googleErrorFlag] || 'Ocurri� un error con la integraci�n de Google Calendar.')
	: '';
---

<Layout>
	<calendar-manager data-google-connected={ENABLE_GOOGLE_CALENDAR && isGoogleConnected ? 'true' : 'false'}>
		<div class="min-h-screen bg-(--page-background) transition-colors duration-300">
			<div
				class="app-shell grid min-h-screen overflow-hidden bg-transparent"
				data-app-shell
				data-sidebar-state="expanded"
			>
				<SideNav currentPath={Astro.url.pathname} />

				<div class="grid min-h-full grid-rows-[auto_1fr]">
					<TopBar>
						<div
							slot="actions-before"
							class="calendar-topbar-actions flex items-center gap-1.5 lg:hidden"
							data-calendar-topbar-actions
						></div>
					</TopBar>

				<main class="calendar-main px-4 pt-2 pb-4 sm:px-6 sm:py-6 lg:px-8" data-calendar-main>
					<section class="material-region dark:shadow-none" data-calendar-root>
						{
							initialLoadError ? (
								<FlashMessage message={initialLoadError} type="error" expand={true} dismissible={false} />
							) : (
								<div class="calendar-page-stack grid gap-3 sm:gap-3.5">
									<header class="calendar-page-header">
										<div class="calendar-page-header__intro grid gap-1 min-w-0">
											<h1 class="calendar-page-title sr-only">
												Calendario
											</h1>
											{
												ENABLE_GOOGLE_CALENDAR && (
													<div class="mt-1 inline-flex w-fit items-center gap-2 rounded-full px-3 py-1 text-[0.73rem] font-bold uppercase tracking-[0.08em] bg-(--surface-container-high) text-(--on-surface-variant)">
														<span class:list={[
															'inline-block size-2 rounded-full',
															isGoogleConnected ? 'bg-emerald-500' : 'bg-zinc-400'
														]}></span>
														{isGoogleConnected ? 'Google sincronizado' : 'Google no conectado'}
													</div>
												)
											}
										</div>

										<div class="calendar-header-toolbar">
											{
												ENABLE_GOOGLE_CALENDAR && (
													isGoogleConnected ? (
														<form
															method="post"
															action="/api/google/disconnect"
															class="calendar-header-toolbar__google w-full sm:w-auto"
														>
															<button
																type="submit"
																class="inline-flex w-full items-center justify-center rounded-full border border-rose-500/30 bg-rose-500/12 px-5 py-3 text-sm font-extrabold text-rose-600 transition hover:bg-rose-500/18 sm:w-auto"
															>
																Desconectar Google
															</button>
														</form>
													) : (
														<a
															href="/api/google/connect"
															class="calendar-header-toolbar__google inline-flex w-full items-center justify-center rounded-full border border-(--shell-border) bg-(--surface-bright) px-5 py-3 text-sm font-extrabold text-(--on-surface) no-underline transition hover:bg-(--surface-container-high) sm:w-auto"
														>
															Conectar Google
														</a>
													)
												)
											}

											<div class="calendar-header-toolbar__actions" data-calendar-chrome-home>
												<div class="calendar-filters-control calendar-header-toolbar__filters" data-calendar-filters-control>
													<button
														type="button"
														class="calendar-filters-trigger relative inline-flex items-center justify-center gap-2"
														data-calendar-filters-open
														aria-label="Filtros del calendario"
														aria-haspopup="dialog"
														aria-controls="calendar-filters-sheet"
														aria-expanded="false"
													>
														<span class="material-symbols-rounded text-[1.25rem]" aria-hidden="true">tune</span>
														<span class="calendar-filters-trigger__label">
															Filtros
															<span class="calendar-filters-trigger__count-wrap">
																(<span data-calendar-filters-count>0</span>)
															</span>
														</span>
														<span
															class="calendar-filters-badge hidden"
															data-calendar-filters-badge
															aria-hidden="true"
														></span>
													</button>
												</div>

												<button
													type="button"
													class="calendar-tour-help calendar-header-toolbar__guide inline-flex shrink-0 items-center justify-center gap-2"
													data-calendar-tour-help
													aria-label="Ayuda del calendario"
													aria-haspopup="dialog"
													aria-controls="calendar-help-sheet"
												>
													<span class="material-symbols-rounded text-[1.12rem]">help</span>
													<span class="calendar-tour-help__label hidden sm:inline">Guía</span>
												</button>

												<div class="calendar-fab-stack" data-calendar-fab-stack>
													<button
														type="button"
														class="calendar-refresh-btn calendar-header-toolbar__refresh inline-flex shrink-0 items-center justify-center gap-2"
														data-refresh-calendar
														aria-label="Refrescar calendario"
													>
														<span class="material-symbols-rounded text-[1.12rem]">refresh</span>
														<span class="calendar-refresh-btn__label sr-only">Refrescar</span>
													</button>

													<button
														type="button"
														class="calendar-create-btn calendar-header-toolbar__create inline-flex items-center justify-center gap-2"
														data-open-appointment-modal
														aria-label="Agendar"
													>
														<svg
															class="calendar-create-btn-icon w-[18px] h-[18px]"
															viewBox="0 0 24 24"
															fill="none"
															aria-hidden="true"
														>
															<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
														</svg>
														<span class="calendar-create-btn__label">Agendar</span>
													</button>
												</div>
											</div>
										</div>
									</header>

									{
										hasGoogleSuccess && (
											<div class="rounded-2xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-[0.9rem] font-semibold text-emerald-700 dark:text-emerald-300">
												{googleSuccessMessage}
											</div>
										)
									}

									{
										hasGoogleError && (
											<div class="rounded-2xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-[0.9rem] font-semibold text-rose-700 dark:text-rose-300">
												{googleErrorMessage}
												{
													showGoogleDebug && (
														<p class="mt-2 rounded-lg border border-rose-500/25 bg-black/20 px-2.5 py-2 font-mono text-[0.74rem] leading-snug text-rose-100/90">
															[{googleErrorFlag || 'google_error'}] {googleDebugParam}
														</p>
													)
												}
											</div>
										)
									}

									{
										ENABLE_GOOGLE_CALENDAR && googleStatusMessage && (
											<div class="rounded-2xl border border-amber-500/20 bg-amber-500/10 px-4 py-3 text-[0.9rem] font-semibold text-amber-700 dark:text-amber-300">
												{googleStatusMessage}
											</div>
										)
									}

									<div
										class="hidden rounded-2xl border border-amber-500/25 bg-amber-500/10 px-3 py-2.5 text-[0.84rem] font-semibold text-amber-800 sm:px-4 sm:py-3 sm:text-[0.86rem] dark:text-amber-200"
										data-schedule-misaligned-banner
										role="status"
									></div>

									<div
										class="calendar-help-sheet"
										id="calendar-help-sheet"
										data-calendar-help-sheet
										aria-hidden="true"
									>
										<button
											type="button"
											class="calendar-help-sheet__backdrop"
											data-calendar-help-close
											aria-label="Cerrar ayuda"
										></button>
										<div
											class="calendar-help-sheet__panel"
											role="dialog"
											aria-modal="true"
											aria-labelledby="calendar-help-title"
										>
											<div class="calendar-help-sheet__header">
												<h2 id="calendar-help-title" class="text-[1.05rem] font-extrabold text-(--on-surface)">
													Estados de las citas
												</h2>
												<button
													type="button"
													class="calendar-sheet-close"
													data-calendar-help-close
													aria-label="Cerrar"
												>
													<span class="material-symbols-rounded text-[1.3rem]">close</span>
												</button>
											</div>
											<div
												class="calendar-help-sheet__body grid gap-3 text-[0.9rem] font-semibold text-(--on-surface-variant)"
												data-calendar-status-legend
												aria-label="Leyenda de estados de citas"
											>
												<span class="inline-flex items-center gap-2">
													<span class="calendar-legend-dot calendar-legend-dot--pending"></span>
													Pendiente
												</span>
												<span class="inline-flex items-center gap-2">
													<span class="calendar-legend-dot calendar-legend-dot--confirmed"></span>
													Confirmado
												</span>
												<span class="inline-flex items-center gap-2">
													<span class="calendar-legend-dot calendar-legend-dot--completed"></span>
													Completado
												</span>
												<span class="inline-flex items-center gap-2">
													<span class="calendar-legend-dot calendar-legend-dot--cancelled"></span>
													Cancelado
												</span>
												<span class="inline-flex items-center gap-2">
													<span class="calendar-legend-dot calendar-legend-dot--misaligned"></span>
													Fuera de horario
												</span>
												{
													ENABLE_GOOGLE_CALENDAR && (
														<span class="inline-flex items-center gap-2">
															<span class="calendar-legend-dot calendar-legend-dot--google"></span>
															Google Calendar
														</span>
													)
												}
											</div>
											<div class="calendar-help-sheet__footer">
												<button
													type="button"
													class="calendar-help-sheet__tour"
													data-calendar-tour-start
												>
													Ver guía del calendario
												</button>
											</div>
										</div>
									</div>

									{/* Fuera del toolbar: evita que transform/z-index del FC rompan position:fixed */}
									<div
										class="calendar-filters-sheet"
										id="calendar-filters-sheet"
										data-calendar-filters-sheet
										aria-hidden="true"
									>
										<button
											type="button"
											class="calendar-filters-sheet__backdrop"
											data-calendar-filters-close
											aria-label="Cerrar filtros"
										></button>
										<div
											class="calendar-filters-sheet__panel"
											role="dialog"
											aria-modal="true"
											aria-labelledby="calendar-filters-title"
										>
											<div class="calendar-filters-sheet__header">
												<h2 id="calendar-filters-title" class="text-[1.05rem] font-extrabold text-(--on-surface)">
													Filtros
												</h2>
												<button
													type="button"
													class="calendar-sheet-close"
													data-calendar-filters-close
													aria-label="Cerrar"
												>
													<span class="material-symbols-rounded text-[1.3rem]">close</span>
												</button>
											</div>

											<div class="calendar-filters-sheet__body flex flex-col gap-3" data-calendar-filters>
												<label class="grid w-full gap-1.5 text-[0.95rem] font-bold text-(--on-surface)" data-professional-filter-wrap>
													Profesional
													<select
														data-professional-filter
														class="cursor-pointer appearance-none w-full rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-4 py-3 text-[0.95rem] font-semibold text-(--on-surface) outline-none transition hover:border-(--on-surface-variant) focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10 shadow-sm bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M7%2010l5%205%205-5%22%20stroke%3D%22%236b7280%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] bg-position-[calc(100%-12px)_center] bg-no-repeat pr-10"
													>
														<option value="">Todos los profesionales</option>
													</select>
												</label>

												<label class="grid w-full gap-1.5 text-[0.95rem] font-bold text-(--on-surface)">
													Sucursal
													<select
														data-location-filter
														class="cursor-pointer appearance-none w-full rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-4 py-3 text-[0.95rem] font-semibold text-(--on-surface) outline-none transition hover:border-(--on-surface-variant) focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10 shadow-sm bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M7%2010l5%205%205-5%22%20stroke%3D%22%236b7280%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] bg-position-[calc(100%-12px)_center] bg-no-repeat pr-10"
													>
														<option value="">Todas las sucursales</option>
													</select>
												</label>
											</div>

											<div class="calendar-filters-sheet__footer">
												<button
													type="button"
													class="calendar-filters-sheet__done"
													data-calendar-filters-close
												>
													Listo
												</button>
											</div>
										</div>
									</div>

									<div
										class="hidden rounded-2xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-[0.9rem] font-bold text-rose-500 shadow-sm"
										data-calendar-error
									></div>

									<div class="calendar-stage-wrap">
										<div class="calendar-stage relative" data-calendar-stage>
											<div data-calendar-el class="calendar-host min-h-136 md:min-h-152"></div>
											<div
												class="calendar-loading-overlay pointer-events-none absolute inset-0 z-10 hidden flex items-center justify-center rounded-[inherit] bg-(--surface-bright)/45 backdrop-blur-[3px]"
												data-calendar-loading
												aria-hidden="true"
											>
												<span class="inline-flex items-center gap-2 rounded-full border border-(--calendar-outline-strong) bg-(--surface-bright)/92 px-3.5 py-2 text-[0.84rem] font-semibold text-(--on-surface-variant) shadow-sm">
													<span class="material-symbols-rounded animate-spin text-[1rem] text-(--primary)">progress_activity</span>
													Cargando calendario...
												</span>
											</div>
										</div>
									</div>
								</div>
							)
						}
					</section>
					</main>
				</div>
			</div>
		</div>

		<AppointmentModalPanel showVoiceButton />
	</calendar-manager>

	{FEATURE_FLAGS.APPOINTMENT_AI_VOICE && <AppointmentVoiceOverlay />}
	{FEATURE_FLAGS.APPOINTMENT_AI_VOICE && <AgendaScanPreview />}
	<AppAlert />
</Layout>

<script>
	import '../../scripts/calendar-page';
</script>

<style is:global>
	calendar-manager,
	appointment-modal {
		display: block;
	}

	[data-appointment-form] [data-ai-draft-highlight] {
		outline: 2px solid color-mix(in srgb, var(--primary) 45%, transparent);
		outline-offset: 2px;
		transition: outline-color 240ms ease;
	}

	dialog[data-appointment-modal] {
		position: fixed;
		inset: 0;
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		box-shadow: none;
		overflow: hidden;
		animation: appointment-modal-in var(--modal-open-duration) var(--modal-easing);
	}

	dialog[data-appointment-modal][open] {
		display: flex;
	}

	dialog[data-appointment-modal][open].is-settled {
		will-change: auto;
	}

	dialog[data-appointment-modal]::backdrop {
		/* Blur estático: solo se anima opacity (blur animado es muy costoso). */
		backdrop-filter: blur(var(--modal-backdrop-blur));
		-webkit-backdrop-filter: blur(var(--modal-backdrop-blur));
		animation: appointment-backdrop-in var(--modal-open-duration) var(--modal-easing);
	}

	dialog[data-appointment-modal][open].is-settled::backdrop {
		will-change: auto;
	}

	dialog[data-appointment-modal].is-closing {
		animation: appointment-modal-out var(--modal-close-duration) var(--modal-easing) forwards;
	}

	dialog[data-appointment-modal].is-closing::backdrop {
		animation: appointment-backdrop-out var(--modal-close-duration) var(--modal-easing) forwards;
	}

	.calendar-legend-dot {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 999px;
		display: inline-block;
		flex-shrink: 0;
	}

	.calendar-legend-dot--pending {
		background: #f59e0b;
	}

	.calendar-legend-dot--confirmed {
		background: #10b981;
	}

	.calendar-legend-dot--completed {
		background: #3b82f6;
	}

	.calendar-legend-dot--cancelled {
		background: #ef4444;
	}

	.calendar-legend-dot--google {
		background: var(--calendar-google-dot, #6b7280);
		box-shadow: inset 0 0 0 1px var(--calendar-google-border, #7e8694);
	}

	.calendar-legend-dot--misaligned {
		background: transparent;
		border: 2px dashed #d97706;
		box-shadow: inset 0 0 0 1px rgb(217 119 6 / 35%);
	}

	[data-calendar-root] {
		--calendar-radius: 1.2rem;
		--calendar-surface: color-mix(in srgb, var(--surface-container-low) 86%, var(--surface-bright) 14%);
		--calendar-outline: color-mix(in srgb, var(--shell-border) 88%, transparent);
		--calendar-outline-strong: color-mix(in srgb, var(--shell-border) 70%, var(--on-surface-variant) 30%);
		--calendar-toolbar-surface: color-mix(in srgb, var(--surface-container) 90%, var(--surface-bright) 10%);
		--calendar-segmented-surface: color-mix(in srgb, var(--surface-container) 92%, var(--surface-bright) 8%);
		--calendar-google-bg: #e1e2ec;
		--calendar-google-fg: #44474e;
		--calendar-google-time: color-mix(in srgb, #44474e 82%, var(--on-surface-variant) 18%);
		--calendar-google-border: color-mix(in srgb, #7e8694 40%, var(--calendar-outline-strong) 60%);
		--calendar-google-accent: color-mix(in srgb, #5e6a7c 76%, #9ea8b8 24%);
		--calendar-google-dot: color-mix(in srgb, #4f5b6b 84%, #aeb7c6 16%);
		--calendar-google-stripe: color-mix(in srgb, #7f8896 45%, transparent);
		--calendar-google-description: color-mix(in srgb, #4f5b6b 80%, var(--on-surface-variant) 20%);
	}

	html[data-theme='dark'] [data-calendar-root] {
		--calendar-outline: rgb(255 255 255 / 0.05);
		--calendar-outline-strong: rgb(255 255 255 / 0.08);
