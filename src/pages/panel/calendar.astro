	.calendar-topbar-actions .calendar-tour-help:hover {
		background: var(--control-surface-strong);
	}

	.calendar-topbar-actions .calendar-tour-help__label {
		display: none;
	}

	.calendar-tour-help {
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border-radius: 999px;
		border: 1px solid var(--calendar-outline-strong);
		background: var(--calendar-toolbar-surface);
		color: var(--on-surface-variant);
		transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease;
	}

	.calendar-tour-help:hover {
		background: color-mix(in srgb, var(--calendar-toolbar-surface) 88%, var(--surface-bright) 12%);
		color: var(--on-surface);
	}

	.calendar-tour-help:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
		outline-offset: 3px;
	}

	.calendar-sheet-close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.35rem;
		height: 2.35rem;
		border-radius: 999px;
		border: 1px solid var(--calendar-outline-strong);
		background: var(--calendar-toolbar-surface);
		color: var(--on-surface-variant);
	}

	.calendar-filters-sheet,
	.calendar-help-sheet {
		display: none;
	}

	.calendar-filters-sheet.is-open,
	.calendar-help-sheet.is-open {
		display: flex;
		position: fixed;
		inset: 0;
		z-index: 200;
		align-items: flex-end;
		justify-content: center;
	}

	.calendar-filters-sheet__backdrop,
	.calendar-help-sheet__backdrop {
		position: absolute;
		inset: 0;
		border: 0;
		/* Mismo overlay que dialog::backdrop / settings */
		background: rgba(15, 17, 21, 0.6);
		cursor: pointer;
	}

	.calendar-filters-sheet__panel,
	.calendar-help-sheet__panel {
		position: relative;
		z-index: 1;
		display: flex;
		width: 100%;
		max-height: min(82dvh, 36rem);
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--shell-border);
		border-bottom: 0;
		border-radius: 1.6rem 1.6rem 0 0;
		background: var(--surface-bright);
		color: var(--on-surface);
		box-shadow: 0 -12px 40px rgb(0 0 0 / 0.18);
		animation: appointment-modal-in 180ms ease;
	}

	.calendar-filters-sheet__panel {
		/* Contraste explícito: el sheet vive en body fuera del tema del host FC */
		background: var(--surface-bright, #ffffff);
		color: var(--on-surface, #1f2937);
	}

	.calendar-filters-sheet__panel label,
	.calendar-filters-sheet__panel h2 {
		color: var(--on-surface, #1f2937);
	}

	.calendar-filters-sheet__panel select,
	.calendar-filters-sheet__panel .ts-control {
		color: var(--on-surface, #1f2937);
		background-color: var(--surface-bright, #ffffff);
	}

	.calendar-filters-sheet__header,
	.calendar-help-sheet__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.95rem 1rem 0.75rem;
		border-bottom: 1px solid var(--shell-border);
	}

	.calendar-filters-sheet__body,
	.calendar-help-sheet__body {
		min-height: 0;
		flex: 1 1 auto;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 1rem;
