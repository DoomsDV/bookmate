			'intro'
			'actions'
			'google';
		align-items: stretch;
	}

	.calendar-page-header__intro {
		grid-area: intro;
	}

	.calendar-page-header__intro:not(:has(.rounded-full)) {
		display: none;
	}

	.calendar-header-toolbar {
		display: contents;
	}

	.calendar-header-toolbar__actions {
		grid-area: actions;
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		gap: 0.45rem;
