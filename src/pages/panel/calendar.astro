	/* Host en TopBar: Actualizar / Ayuda en mobile */
	.calendar-topbar-actions:empty {
		display: none;
	}

	.calendar-topbar-actions .calendar-tour-help {
		width: 2.5rem;
		height: 2.5rem;
		min-width: 2.5rem;
		min-height: 2.5rem;
		padding: 0;
		border-radius: 1rem;
		border: 1px solid var(--shell-border);
		background: var(--control-surface);
		color: var(--on-surface-variant);
		box-shadow: none;
