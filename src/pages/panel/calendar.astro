	/* Full-bleed: sin card; el grid llena el alto bajo el TopBar */
	.app-shell > :last-child:has([data-calendar-main]) {
		display: flex;
		flex-direction: column;
	}

	.app-shell > :last-child:has([data-calendar-main]) > .grid {
		flex: 1 1 auto;
		min-height: 0;
		height: 100%;
		display: grid;
		grid-template-rows: auto 1fr;
	}

	.calendar-main[data-calendar-main] {
		display: flex;
		flex-direction: column;
		height: 100%;
		max-height: 100%;
		min-height: 0;
		overflow: hidden;
	}

	[data-calendar-root].material-region {
		flex: 1 1 auto;
		min-height: 0;
		display: flex;
		flex-direction: column;
		border: 0;
		border-radius: 0;
		box-shadow: none;
		background: transparent;
		padding: 0;
	}

	[data-calendar-root] .calendar-page-stack {
		flex: 1 1 auto;
		min-height: 0;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.calendar-stage-wrap {
		flex: 1 1 auto;
		min-height: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	.calendar-stage {
		flex: 1 1 auto;
		min-height: 0;
		display: flex;
		flex-direction: column;
	}

	[data-calendar-root] .calendar-host {
		flex: 1 1 auto;
		min-height: 0 !important;
		height: 100%;
		border-radius: 0;
	}

	[data-calendar-root] .fc {
		height: 100%;
	}

	[data-calendar-root] .fc .fc-view-harness {
		min-height: 0 !important;
	}

	.calendar-page-header {
		display: grid;
		gap: 0.5rem;
		grid-template-areas:
			'intro'
			'actions'
			'google';
		align-items: stretch;
	}

	.calendar-page-header__intro {
		grid-area: intro;
	}

	.calendar-page-header__intro:not(:has(.rounded-full)) {
		display: none;
	}

	.calendar-header-toolbar {
		display: contents;
	}

	.calendar-header-toolbar__actions {
		grid-area: actions;
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		gap: 0.45rem;
		min-width: 0;
	}

	.calendar-header-toolbar__filters {
		flex: 0 0 auto;
		min-width: 0;
	}

	.calendar-header-toolbar__create,
	.calendar-header-toolbar__refresh {
		flex: 0 0 auto;
		min-width: auto;
	}

	.calendar-header-toolbar__guide {
		flex: 0 0 auto;
		align-self: center;
	}

	.calendar-header-toolbar__google {
		grid-area: google;
	}

	.calendar-filters-control {
		position: relative;
		flex: 0 0 auto;
		/* Evita CLS: solo se muestra cuando JS lo dockea al toolbar FC */
		display: none;
	}

	.fc .fc-toolbar .calendar-filters-control {
		display: flex;
		align-items: center;
	}

	/* Evita CLS: no mostrar chrome en home (desktop lo dockea al FC; mobile solo deja el FAB) */
	[data-calendar-chrome-home] > .calendar-tour-help {
		display: none !important;
	}

	@media (min-width: 768px) {
		[data-calendar-chrome-home] {
			display: none !important;
		}
	}

	.calendar-filters-trigger {
		min-height: 2.75rem;
		padding: 0.55rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--calendar-outline-strong);
		background: var(--calendar-toolbar-surface);
		font-size: 0.84rem;
		font-weight: 760;
