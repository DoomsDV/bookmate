	/* Stack FAB: Refresh arriba + Agendar abajo (mobile <768) */
	@media (max-width: 767px) {
		.calendar-fab-stack {
			position: fixed;
			right: max(1rem, env(safe-area-inset-right, 0px));
			/* Por encima del bottom nav mobile (~4.25rem + padding + safe-area) */
			bottom: calc(5.55rem + env(safe-area-inset-bottom, 0px));
			z-index: 46;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.65rem;
			pointer-events: auto;
		}

		.calendar-fab-stack .calendar-refresh-btn {
			width: 2.85rem;
			height: 2.85rem;
			min-width: 2.85rem;
			min-height: 2.85rem;
			padding: 0;
			border-radius: 999px;
			border: 1px solid var(--shell-border);
			background: var(--control-surface);
			color: var(--on-surface-variant);
			box-shadow:
				0 6px 16px rgb(0 0 0 / 0.12),
				0 1px 4px rgb(0 0 0 / 0.08);
		}

		.calendar-fab-stack .calendar-create-btn {
			position: static;
			width: 3.55rem;
			height: 3.55rem;
			padding: 0;
			border-radius: 999px;
			box-shadow:
				0 4px 12px rgb(0 0 0 / 0.16),
				0 1px 3px rgb(0 0 0 / 0.1);
		}

		html[data-theme='dark'] .calendar-fab-stack .calendar-create-btn {
			box-shadow:
				0 4px 12px rgb(0 0 0 / 0.35),
				0 1px 3px rgb(0 0 0 / 0.22);
		}

		.calendar-create-btn__label {
			display: none;
		}

		.calendar-create-btn-icon {
			width: 1.35rem;
			height: 1.35rem;
		}

		.calendar-create-btn,
		.calendar-refresh-btn {
			min-height: 0;
			font-size: 0.84rem;
			line-height: 1.15;
			white-space: nowrap;
		}
