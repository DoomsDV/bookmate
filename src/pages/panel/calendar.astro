			display: flex;
			flex: 1 1 auto;
			flex-wrap: wrap;
			align-items: center;
			justify-content: flex-end;
			gap: 0.5rem;
		}

		.calendar-header-toolbar__actions {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.5rem;
		}

		.calendar-header-toolbar__create,
		.calendar-header-toolbar__refresh {
			flex: 0 0 auto;
			min-width: auto;
			order: unset;
		}

		.calendar-header-toolbar__guide {
			align-self: auto;
		}

		.calendar-tour-help {
			width: auto;
			height: 2.875rem;
			min-height: 2.875rem;
			padding: 0 1.05rem;
			font-size: 0.9rem;
			font-weight: 760;
			color: var(--on-surface);
		}

		/* Desktop: botón ícono + popover anclado (como Clientes / Documentos) */
		.calendar-filters-trigger {
			width: 2.875rem;
			height: 2.875rem;
			min-width: 2.875rem;
			min-height: 2.875rem;
			padding: 0;
			border-radius: 1rem;
		}

		.calendar-filters-trigger__label {
			display: none;
		}

		.calendar-filters-sheet.is-open.is-desktop-popover {
			align-items: flex-start;
			justify-content: flex-start;
			padding: 0;
			z-index: 220;
			pointer-events: none;
		}

		.calendar-filters-sheet.is-desktop-popover .calendar-filters-sheet__backdrop {
			pointer-events: auto;
			background: transparent;
			cursor: default;
		}

		.calendar-filters-sheet.is-desktop-popover .calendar-filters-sheet__panel {
