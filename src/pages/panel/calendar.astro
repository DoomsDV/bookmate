		border-color: color-mix(in srgb, var(--primary) 55%, var(--calendar-outline-strong));
		background: color-mix(in srgb, var(--primary) 10%, var(--calendar-toolbar-surface));
		color: var(--primary);
	}

	.calendar-filters-trigger:hover {
		background: color-mix(in srgb, var(--calendar-toolbar-surface) 88%, var(--surface-bright) 12%);
	}

	.calendar-filters-trigger__count-wrap {
		display: none;
	}

	.calendar-filters-trigger[data-has-active='true'] .calendar-filters-trigger__count-wrap {
		display: inline;
	}

	.calendar-filters-badge {
		position: absolute;
		top: 0.4rem;
		right: 0.4rem;
		min-width: 1rem;
		height: 1rem;
		padding: 0 0.28rem;
		border-radius: 999px;
		background: var(--primary);
		color: #fff;
		font-size: 0.58rem;
		font-weight: 800;
		line-height: 1rem;
		text-align: center;
		box-shadow: 0 0 0 2px var(--calendar-toolbar-surface, var(--surface-bright));
