---
import AppAlert from '../../components/AppAlert.astro';
import FlashMessage from '../../components/FlashMessage.astro';
import SideNav from '../../components/SideNav.astro';
import TopBar from '../../components/TopBar.astro';
import { ROLES } from '../../config/roles';
import Layout from '../../layouts/Layout.astro';
import { panelPageTitle } from '../../lib/panel-page-title';
import '../../styles/global.css';

const token = Astro.locals.token ?? '';
const roleId = Number(Astro.locals.roleId ?? 0);
const isProfessional = roleId === ROLES.PROFESIONAL;
const canManageSchedules = !isProfessional;
const initialLoadError = token ? '' : 'No hay sesión válida para configurar horarios.';
---

<Layout pageTitle={panelPageTitle('Horarios')}>
	<schedule-manager
		data-can-edit={canManageSchedules ? 'true' : 'false'}
		data-role-id={String(roleId)}
		data-professional-view={isProfessional ? 'true' : 'false'}
	>
		<div class="min-h-screen bg-(--page-background)">
			<div
				class="app-shell grid min-h-screen overflow-hidden bg-transparent"
				data-app-shell
				data-sidebar-state="expanded"
			>
				<SideNav currentPath={Astro.url.pathname} />

				<div class="grid min-h-full grid-rows-[auto_1fr]">
					<TopBar />

					<main
						class:list={[
							'schedule-page-main relative px-4 pb-4 sm:px-6 sm:pb-6',
							isProfessional ? 'pt-2 sm:pt-3' : 'pt-0',
						]}
					>
						<section class="grid gap-4 sm:gap-5">
							{
								initialLoadError ? (
									<FlashMessage message={initialLoadError} type="error" expand={true} dismissible={false} />
								) : (
									<div
										class:list={[
											'grid',
											isProfessional
												? 'gap-3 schedule-page-header--professional'
												: 'schedule-page-header--owner',
										]}
										data-schedule-page-header
									>
										{
											!isProfessional ? (
												<div class="schedule-page-chrome">
													<div
														data-schedule-header-hero
														aria-hidden="true"
														class="schedule-page-chrome__sentinel"
													></div>
													<div
														class="schedule-page-header__sticky-bar"
														data-schedule-header-sticky
													>
													<div
														class="schedule-page-header__toolbar"
														data-schedule-header-toolbar
													>
														<div
															class="schedule-page-header__professional flex min-w-0 flex-1 items-center gap-2"
															data-schedule-professional-field
														>
															<div class="schedule-pro-select min-w-0 flex-1">
																<p class="schedule-pro-select__label" id="schedule-professional-label">
																	Profesional
																</p>
																<div class="schedule-pro-select__control">
																	<select
																		id="schedule-professional-select"
																		class="sr-only"
																		data-professional-select
																		tabindex="-1"
																		aria-hidden="true"
																	></select>
																	<button
																		type="button"
																		class="schedule-pro-select__trigger"
																		data-schedule-pro-select-trigger
																		aria-labelledby="schedule-professional-label"
																		aria-haspopup="listbox"
																		aria-expanded="false"
																		aria-controls="schedule-pro-select-menu"
																	>
																		<span class="schedule-pro-select__value" data-schedule-professional-label>
																			Selecciona un profesional
																		</span>
																		<span class="schedule-pro-select__chevron material-symbols-rounded" aria-hidden="true">expand_more</span>
																	</button>
																	<div
																		id="schedule-pro-select-menu"
																		class="schedule-pro-select__menu"
																		data-schedule-pro-select-menu
																		hidden
																		role="listbox"
																		aria-labelledby="schedule-professional-label"
																	></div>
																</div>
															</div>
															<div class="schedule-save-info shrink-0" data-schedule-save-info>
																<button
																	type="button"
																	class="schedule-pro-filter-btn schedule-save-info-btn relative flex size-11 shrink-0 items-center justify-center rounded-2xl border border-(--shell-border) bg-(--surface-bright) text-(--on-surface-variant) shadow-sm transition hover:border-(--on-surface-variant) hover:text-(--on-surface) focus:border-(--primary) focus:outline-none focus:ring-4 focus:ring-(--primary)/10"
																	data-schedule-save-info-btn
																	aria-label="Información antes de guardar horarios"
																	aria-haspopup="dialog"
																	aria-expanded="false"
																	aria-controls="schedule-save-info-sheet"
																>
																	<span class="material-symbols-rounded text-[1.25rem]" aria-hidden="true">info</span>
																</button>
																<div
																	id="schedule-save-info-popover"
																	class="schedule-save-info-popover"
																	data-schedule-save-info-popover
																	role="tooltip"
																	aria-hidden="true"
																>
																	<p class="schedule-save-info-popover__title">Antes de guardar</p>
																	<ul class="schedule-save-info-popover__list">
																		<li>
																			Al guardar la plantilla, las citas ya agendadas no se mueven solas.
																		</li>
																		<li>
																			Si hay citas futuras desalineadas, el sistema te avisará antes de guardar.
																		</li>
																		<li>
																			Revisa el calendario y reprograma manualmente; avisa al cliente si cambias fecha u hora.
																		</li>
																	</ul>
																</div>
															</div>
														</div>
														{
															canManageSchedules && (
																<button
																	type="button"
																	class="schedule-save-btn schedule-page-header__save inline-flex shrink-0 items-center justify-center gap-2 self-center rounded-2xl px-5 py-3 text-[0.95rem] font-extrabold transition focus:outline-none focus:ring-2 focus:ring-(--primary) focus:ring-offset-2 focus:ring-offset-(--surface-bright) disabled:opacity-60 disabled:pointer-events-none"
																	data-save-schedule
																>
																	<span class="material-symbols-rounded text-[1.2rem]" aria-hidden="true">save</span>
																	<span data-save-schedule-label>Guardar horarios</span>
																</button>
															)
														}
													</div>

													<div class="schedule-error-anchor" data-schedule-error-anchor>
														<div
															data-schedule-error
															class="schedule-error-banner hidden"
															role="alert"
															aria-live="assertive"
															hidden
														></div>
													</div>
													</div>
												</div>
											) : (
												<select
													data-professional-select
													hidden
													class="hidden"
													aria-hidden="true"
													tabindex="-1"
												></select>
											)
										}

										<div class="schedule-page-header__tabs-row relative">
											{
												isProfessional ? (
													<div class="schedule-error-anchor" data-schedule-error-anchor>
														<div
															data-schedule-error
															class="schedule-error-banner hidden"
															role="alert"
															aria-live="assertive"
															hidden
														></div>
													</div>
												) : null
											}
											<div class="flex flex-wrap items-center gap-2 sm:gap-3">
											<div data-schedule-tabs role="tablist" class="min-w-0 flex-1">
												<button
													type="button"
													class="schedule-tab schedule-tab--active"
													data-schedule-tab="template"
													role="tab"
													aria-selected="true"
												>
													<span class="material-symbols-rounded schedule-tab__icon" aria-hidden="true">calendar_view_week</span>
													<span class="schedule-tab__label">Plantilla semanal</span>
												</button>
												<button
													type="button"
													class="schedule-tab"
													data-schedule-tab="exceptions"
													role="tab"
													aria-selected="false"
												>
													<span class="material-symbols-rounded schedule-tab__icon" aria-hidden="true">event_busy</span>
													<span class="schedule-tab__label">Excepciones del calendario</span>
												</button>
											</div>
											<button
												type="button"
												class="schedule-exceptions-help inline-flex shrink-0 items-center gap-1.5 rounded-full border border-(--shell-border) bg-(--surface-bright) px-3 py-2 text-[0.82rem] font-bold text-(--on-surface-variant) transition hover:border-(--primary)/35 hover:text-(--primary) focus:outline-none focus:ring-2 focus:ring-(--primary)/25"
												data-schedule-exceptions-help
												aria-label="Guía de profesional, plantilla semanal y excepciones del calendario"
											>
												<span class="material-symbols-rounded text-[1.1rem]">help</span>
												<span class="hidden sm:inline">Guía</span>
											</button>
										</div>
										</div>

										<div class="mt-0.5">
												<div data-schedule-view-template>
													<p class="schedule-week-kicker">
														<span>Plantilla</span>
														Horario habitual que se repite cada semana.
													</p>
													<div
														class="schedule-loading-skeleton hidden grid gap-5 sm:gap-6"
														data-schedule-loading-template
														aria-busy="true"
														aria-label="Cargando plantilla semanal"
													>
														{
															[0, 1, 2].map(() => (
																<article
																	class="schedule-day-card panel-skeleton-card pointer-events-none"
																	aria-hidden="true"
																>
																	<div class="schedule-day-card__inner">
																		<div class="schedule-day-card__mast">
																			<div class="panel-skeleton-line h-8 w-8 rounded-xl"></div>
																			<div class="min-w-0 flex-1 grid gap-2">
																				<div class="panel-skeleton-line h-5 w-24 rounded-md"></div>
																				<div class="panel-skeleton-line h-3 w-16 rounded"></div>
																			</div>
																			<div class="panel-skeleton-line h-7 w-24 rounded-full"></div>
																		</div>
																		<div class="schedule-day-card__rail">
																			<div class="schedule-shift">
																				<div class="min-w-0 grid gap-2">
																					<div class="panel-skeleton-line h-11 w-full rounded-2xl"></div>
																					<div class="grid grid-cols-2 gap-2">
																						<div class="panel-skeleton-line h-11 w-full rounded-2xl"></div>
																						<div class="panel-skeleton-line h-11 w-full rounded-2xl"></div>
																					</div>
																				</div>
																			</div>
																			<div class="panel-skeleton-line mt-1 h-10 w-40 rounded-full"></div>
																		</div>
																	</div>
																</article>
															))
														}
													</div>
													<div data-schedule-template-content>
														<div class="grid gap-5 sm:gap-6" data-weekly-planner></div>
													</div>
												</div>

												<div class="hidden" data-schedule-view-exceptions>
													<p class="schedule-week-kicker">
														<span>Excepciones</span>
														Cambios puntuales por fecha. La excepción reemplaza la plantilla solo ese día.
													</p>

													<div
														class="schedule-loading-skeleton schedule-exc-plate hidden"
														data-schedule-loading-exceptions
														aria-busy="true"
														aria-label="Cargando excepciones del calendario"
													>
														<div class="schedule-exc-plate__inner">
															<div class="schedule-exc-plate__mast">
																<div class="panel-skeleton-line h-6 w-40 rounded-md"></div>
																<div class="panel-skeleton-line h-9 w-20 rounded-full"></div>
															</div>
															<div class="schedule-exc-legend">
																<div class="panel-skeleton-line h-7 w-24 rounded-full"></div>
																<div class="panel-skeleton-line h-7 w-24 rounded-full"></div>
																<div class="panel-skeleton-line h-7 w-28 rounded-full"></div>
															</div>
															<div class="schedule-exception-calendar__weekdays" aria-hidden="true">
																<span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span>
																<span>Vie</span><span>Sáb</span><span>Dom</span>
															</div>
															<div class="schedule-exception-calendar__grid" aria-hidden="true">
																{Array.from({ length: 35 }).map(() => (
																	<div class="panel-skeleton-line min-h-[2.35rem] w-full rounded-[0.85rem]"></div>
																))}
															</div>
														</div>
													</div>

													<div data-schedule-exceptions-content>
														<div
															class="schedule-exc-plate"
															data-exception-calendar-panel
														>
															<div class="schedule-exc-plate__inner">
																<header class="schedule-exc-plate__mast">
																	<p
																		class="schedule-exception-calendar__month"
																		data-exception-cal-month
																	></p>
																	<div class="schedule-exc-nav">
																		<button
																			type="button"
																			class="schedule-cal-nav"
																			data-exception-cal-prev
																			aria-label="Mes anterior"
																		>
																			<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
																		</button>
																		<button
																			type="button"
																			class="schedule-cal-nav"
																			data-exception-cal-next
																			aria-label="Mes siguiente"
																		>
																			<span class="material-symbols-rounded" aria-hidden="true">chevron_right</span>
																		</button>
																	</div>
																</header>

																<div class="schedule-exc-legend" data-exception-legend>
																	<span class="schedule-exc-chip">
																		<span class="schedule-cal-dot schedule-cal-dot--normal"></span>
																		Usa plantilla
																	</span>
																	<span class="schedule-exc-chip">
																		<span class="schedule-cal-dot schedule-cal-dot--blocked"></span>
																		Bloqueado
																	</span>
																	<span class="schedule-exc-chip">
																		<span class="schedule-cal-dot schedule-cal-dot--override"></span>
																		Horario especial
																	</span>
																</div>

																<div class="schedule-exception-calendar">
																	<div class="schedule-exception-calendar__weekdays">
																		<span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span>
																		<span>Vie</span><span>Sáb</span><span>Dom</span>
																	</div>
																	<div class="schedule-exception-calendar__grid" data-exception-cal-grid></div>
																</div>
															</div>
														</div>
													</div>
												</div>
											</div>

										<div
											class="schedule-exception-modal-backdrop fixed inset-0 z-[100] hidden items-end justify-center p-0 sm:items-center sm:p-4 lg:items-stretch lg:justify-end lg:p-0"
											data-exception-modal
											role="dialog"
											aria-modal="true"
											aria-labelledby="exception-modal-title"
										>
											<div
												class="schedule-exception-modal flex w-full max-w-none flex-col overflow-hidden rounded-t-[1.8rem] rounded-b-none border border-(--shell-border) border-b-0 bg-(--surface-bright) text-(--on-surface) shadow-[0_-12px_40px_rgba(0,0,0,0.18)] max-h-[80dvh] sm:max-h-[90vh] sm:max-w-[min(48rem,calc(100vw-2rem))] sm:rounded-[1.8rem] sm:border-b sm:shadow-xl md:max-w-[min(52rem,calc(100vw-2rem))] lg:h-[100dvh] lg:max-h-[100dvh] lg:w-[max(50vw,40rem)] lg:max-w-[max(50vw,40rem)] lg:rounded-none lg:border-y-0 lg:border-r-0 lg:shadow-none"
											>
												<div class="panel-modal-header panel-modal-header--shadow">
													<div class="panel-modal-header__row">
														<div class="panel-modal-header__leading">
															<div class="panel-modal-header__icon">
																<span class="material-symbols-rounded">event_busy</span>
															</div>
															<div class="panel-modal-header__text">
																<h2
																	id="exception-modal-title"
																	class="panel-modal-header__title"
																	data-exception-modal-title
																>
																	Excepción de horario
																</h2>
																<p
																	class="panel-modal-header__subtitle"
																	data-exception-modal-subtitle
																></p>
															</div>
														</div>
														<div class="panel-modal-header__actions">
															<button
																type="button"
																class="schedule-exceptions-help hidden inline-flex shrink-0 items-center gap-1.5 rounded-full border border-(--shell-border) bg-(--surface-bright) px-3 py-2 text-[0.82rem] font-bold text-(--on-surface-variant) transition hover:border-(--primary)/35 hover:text-(--primary) focus:outline-none focus:ring-2 focus:ring-(--primary)/25"
																data-exception-modal-tour-help
																aria-label="Guía del modal de excepción de horario"
															>
																<span class="material-symbols-rounded text-[1.1rem]">help</span>
																<span class="hidden sm:inline">Guía</span>
															</button>
															<button
																type="button"
																class="schedule-modal-close panel-modal-header__close hidden sm:inline-flex"
																data-exception-modal-close
																aria-label="Cerrar"
															>
																<span class="material-symbols-rounded">close</span>
															</button>
														</div>
													</div>
												</div>

												<div
													class="schedule-exception-modal-scroll relative min-h-0 flex-1 overflow-y-auto overscroll-contain bg-(--surface)/30 px-4 py-4 shadow-[inset_0_4px_10px_rgba(0,0,0,0.015)] sm:px-7 sm:py-5"
												>
													<div
														class="schedule-exception-modal-feedback"
														data-exception-modal-feedback
													>
														<div
															class="schedule-exception-modal-feedback__alert hidden ml-auto max-w-full items-center gap-2 rounded-2xl border border-rose-500/25 px-4 py-3 text-[0.9rem] font-bold text-rose-600 shadow-sm sm:max-w-md dark:border-rose-400/30 dark:text-rose-300"
															data-exception-modal-error
															role="alert"
															aria-live="polite"
														>
															<p
																class="m-0 min-w-0 flex-1 leading-snug font-bold"
																data-exception-modal-error-message
															></p>
															<button
																type="button"
																class="schedule-exception-modal-feedback__close shrink-0 rounded-full p-0.5 text-rose-500 transition hover:bg-rose-500/10 hover:text-rose-700 dark:text-rose-300 dark:hover:bg-rose-400/10 dark:hover:text-rose-100"
																data-dismiss-exception-modal-error
																aria-label="Cerrar mensaje de error"
															>
																<span class="material-symbols-rounded block text-[1.15rem] leading-none"
																	>close</span
																>
															</button>
														</div>
													</div>

													<div class="grid gap-4" data-exception-modal-body></div>
												</div>

												<div
													class="schedule-exception-modal-footer modal-footer shrink-0 border-t border-(--shell-border) bg-(--surface-bright) px-4 py-4 sm:px-7 sm:py-5"
													data-exception-modal-actions
												></div>
											</div>
										</div>
									</div>
								)
							}
						</section>
					</main>
				</div>
			</div>
		</div>

		{
			!isProfessional ? (
				<dialog
					id="schedule-save-info-sheet"
					class="schedule-save-info-sheet"
					data-schedule-save-info-sheet
					aria-labelledby="schedule-save-info-title"
				>
					<div class="schedule-save-info-sheet__handle" aria-hidden="true">
						<span></span>
					</div>
					<div class="schedule-save-info-sheet__header">
						<h2 id="schedule-save-info-title" class="m-0 text-[1.05rem] font-extrabold tracking-tight">
							Antes de guardar
						</h2>
						<button
							type="button"
							class="flex size-9 shrink-0 items-center justify-center rounded-full text-(--on-surface-variant) transition-colors hover:bg-(--surface-variant) hover:text-(--on-surface)"
							data-close-schedule-save-info
							aria-label="Cerrar información"
						>
							<span class="material-symbols-rounded text-[1.3rem]">close</span>
						</button>
					</div>
					<div class="schedule-save-info-sheet__body">
						<ul class="schedule-save-info-sheet__list">
							<li>
								Al guardar la plantilla, las citas ya agendadas no se mueven solas.
							</li>
							<li>
								Si hay citas futuras desalineadas, el sistema te avisará antes de guardar.
							</li>
							<li>
								Revisa el calendario y reprograma manualmente; avisa al cliente si cambias fecha u hora.
							</li>
						</ul>
					</div>
				</dialog>
			) : null
		}
	</schedule-manager>

	<AppAlert />
</Layout>

<script>
	import '../../scripts/schedule-manager';
	import '../../scripts/schedule-save-info-tooltip';
</script>

<style is:global>
	schedule-manager {
		display: block;
	}

	[data-weekly-planner] {
		min-width: 0;
		max-width: 100%;
	}

	.schedule-error-anchor {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 0;
		overflow: visible;
		pointer-events: none;
		transform: translateY(100%);
		z-index: 25;
	}

	/* El sticky bar es full-bleed (cancela px-4 / sm:px-6 del main).
	   Inset solo el ancla para alinear el banner con el contenido, sin tocar el header. */
	.schedule-page-header__sticky-bar .schedule-error-anchor {
		left: 1rem;
		right: 1rem;
	}

	@media (min-width: 640px) {
		.schedule-page-header__sticky-bar .schedule-error-anchor {
			left: 1.5rem;
			right: 1.5rem;
		}
	}

	.schedule-error-anchor:not(:has(.schedule-error-banner:not(.hidden))) {
		display: none;
	}

	.schedule-error-banner {
		position: absolute;
		top: 0.5rem;
		left: 0.25rem;
		right: 0.25rem;
		pointer-events: auto;
		width: auto;
		max-width: none;
		height: auto;
		min-height: unset;
		margin: 0;
		box-shadow: none !important;
	}

	.schedule-error-banner.inline-feedback {
		align-items: center;
		padding: 0.7rem 0.85rem 0.7rem 1rem;
		height: auto;
		min-height: unset;
		line-height: 1.4;
	}

	.schedule-error-banner.inline-feedback .inline-feedback__text {
		line-height: 1.4;
		white-space: normal;
		overflow-wrap: anywhere;
	}

	.schedule-error-banner.inline-feedback.schedule-error-banner--wrap {
		align-items: flex-start;
