		font-variation-settings: 'FILL' 0, 'wght' 500, 'GRAD' 0, 'opsz' 24;
	}
	.plan-add-card-label {
		font-size: 0.92rem;
		font-weight: 750;
		line-height: 1.25;
	}
	.plan-add-card-hint {
		font-size: 0.72rem;
		font-weight: 550;
		line-height: 1.3;
		color: var(--on-surface-variant);
