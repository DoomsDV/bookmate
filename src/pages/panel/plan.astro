	/* Agregar tarjeta — empty state (ghost card) */
	.plan-add-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		flex: 0 0 auto;
		width: 80%;
		max-width: 80%;
		min-width: 0;
		margin-inline: auto;
		aspect-ratio: 1.68 / 1;
		padding: 1rem;
		border: 0;
		border-radius: 1.15rem;
		background: color-mix(in srgb, var(--surface-container-high) 88%, transparent);
		color: var(--on-surface);
		cursor: pointer;
		text-align: center;
		appearance: none;
		-webkit-appearance: none;
		box-sizing: border-box;
		overflow: visible;
		transition:
			background 0.2s ease,
			transform 0.2s ease;
	}
	.plan-add-card::before {
		content: '';
		position: absolute;
		inset: 2px;
		border: 2px dashed color-mix(in srgb, var(--on-surface-variant) 90%, transparent);
		border-radius: calc(1.15rem - 2px);
		pointer-events: none;
	}
	.plan-add-card:hover::before,
	.plan-add-card:active::before {
		border-color: color-mix(in srgb, var(--primary) 70%, transparent);
	}
	.plan-add-card:hover,
	.plan-add-card:active {
		background: color-mix(in srgb, var(--surface-container-highest) 92%, transparent);
	}
	.plan-add-card:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 3px;
	}
