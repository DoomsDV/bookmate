											</div>
											<p class="plan-history-filter-group__label">Periodo</p>
											<div class="plan-history-period-filter-sheet__list" role="listbox" aria-label="Periodo">
												<button type="button" class="plan-history-period-option is-selected" data-plan-history-period-option="none" role="option">
													<span>Todo el historial</span>
													<span class="material-symbols-rounded" aria-hidden="true">check</span>
												</button>
												<button type="button" class="plan-history-period-option" data-plan-history-period-option="this_month" role="option">
													<span>Este mes</span>
													<span class="material-symbols-rounded" aria-hidden="true">check</span>
												</button>
												<button type="button" class="plan-history-period-option" data-plan-history-period-option="last_month" role="option">
													<span>Mes pasado</span>
													<span class="material-symbols-rounded" aria-hidden="true">check</span>
												</button>
												<button type="button" class="plan-history-period-option" data-plan-history-period-option="custom" role="option">
													<span>Personalizado</span>
													<span class="material-symbols-rounded" aria-hidden="true">check</span>
												</button>
											</div>
											<div class="plan-history-period-custom hidden" data-plan-history-custom-dates>
												<label class="grid gap-1.5 text-[0.85rem] font-bold text-(--on-surface)">
													Desde
													<span class="plan-history-date-field">
														<input
															type="text"
															class="plan-history-date-field__text"
															data-plan-history-date-from-text
															inputmode="numeric"
															autocomplete="off"
															placeholder="dd/mm/aaaa"
															maxlength="10"
															aria-label="Fecha desde"
														/>
														<input type="hidden" data-plan-history-date-from value="" />
														<button
															type="button"
															class="plan-history-date-field__pick"
															data-plan-history-date-from-pick
															aria-label="Elegir fecha desde"
														>
															<span class="material-symbols-rounded" aria-hidden="true">calendar_month</span>
														</button>
													</span>
												</label>
												<label class="grid gap-1.5 text-[0.85rem] font-bold text-(--on-surface)">
													Hasta
													<span class="plan-history-date-field">
														<input
															type="text"
															class="plan-history-date-field__text"
															data-plan-history-date-to-text
															inputmode="numeric"
															autocomplete="off"
															placeholder="dd/mm/aaaa"
															maxlength="10"
															aria-label="Fecha hasta"
														/>
														<input type="hidden" data-plan-history-date-to value="" />
														<button
															type="button"
															class="plan-history-date-field__pick"
															data-plan-history-date-to-pick
															aria-label="Elegir fecha hasta"
														>
															<span class="material-symbols-rounded" aria-hidden="true">calendar_month</span>
														</button>
													</span>
												</label>
												<p class="hidden m-0 text-[0.82rem] font-semibold text-rose-500" data-plan-history-date-error></p>
												<button
													type="button"
													class="plan-history-period-apply"
													data-plan-history-apply-period
												>
													Aplicar
												</button>
											</div>

											<dialog
												class="plan-history-date-picker"
												data-plan-history-date-picker
												aria-labelledby="plan-history-date-picker-label"
											>
												<div class="dtp-card">
													<div class="dtp-head">
														<div class="dtp-head-row">
															<p class="dtp-target-label" id="plan-history-date-picker-label" data-plan-history-dp-label>
																Seleccionando fecha
															</p>
															<button
																type="button"
																class="dtp-icon-btn"
																data-plan-history-dp-close
																aria-label="Cerrar selector de fecha"
															>
																<span class="material-symbols-rounded text-[1.1rem]">close</span>
															</button>
														</div>

														<div class="dtp-nav-row">
															<div class="inline-flex items-center gap-1.5">
																<select
																	data-plan-history-dp-month
																	class="dtp-select"
																	aria-label="Seleccionar mes"
																></select>
																<select
																	data-plan-history-dp-year
																	class="dtp-select dtp-select--year"
																	aria-label="Seleccionar año"
																></select>
															</div>
															<div class="inline-flex items-center gap-1">
																<button
																	type="button"
																	class="dtp-icon-btn"
																	data-plan-history-dp-prev
																	aria-label="Mes anterior"
																>
																	<span class="material-symbols-rounded text-[1.05rem]">chevron_left</span>
																</button>
																<button
																	type="button"
																	class="dtp-icon-btn"
																	data-plan-history-dp-next
																	aria-label="Mes siguiente"
																>
																	<span class="material-symbols-rounded text-[1.05rem]">chevron_right</span>
																</button>
															</div>
														</div>

														<div class="dtp-weekdays">
															<span>Lun</span>
															<span>Mar</span>
															<span>Mié</span>
															<span>Jue</span>
															<span>Vie</span>
															<span>Sáb</span>
															<span>Dom</span>
														</div>
														<div class="dtp-days-grid" data-plan-history-dp-days></div>
													</div>

													<div class="dtp-foot">
														<div class="dtp-foot-row plan-history-dp-foot-row">
															<button type="button" class="dtp-action-btn" data-plan-history-dp-today>Hoy</button>
															<button type="button" class="dtp-action-btn dtp-action-btn--primary" data-plan-history-dp-apply>
																Hecho
															</button>
														</div>
													</div>
												</div>
											</dialog>
										</div>
									</dialog>
								</div>
							</>
						) : null}
					</div>
				</main>
			</div>
		</div>
	</div>

	{/* Modal de retención — downgrade Premium → Base */}
	{canDowngradeToBase && current && basePlan ? (
		<div class="plan-modal-backdrop hidden" data-downgrade-modal>
			<div
				class="plan-modal plan-downgrade-modal"
				role="dialog"
				aria-modal="true"
				aria-labelledby="plan-downgrade-title"
			>
				<div class="plan-modal-head">
					<h3 id="plan-downgrade-title" class="m-0 text-lg font-bold text-(--on-surface)">
						¿Seguro que querés cambiar al Plan Base?
					</h3>
					<button type="button" class="panel-modal-header__close" data-downgrade-close aria-label="Cerrar">
						<span class="material-symbols-rounded">close</span>
					</button>
				</div>
				<div class="plan-downgrade-compare">
					<div class="plan-downgrade-col plan-downgrade-col--keep">
						<p class="plan-downgrade-col-title m-0">Plan Base</p>
						<ul class="plan-downgrade-list">
							{DOWNGRADE_KEEP_FEATURES.map((code) => (
								<li>
									<span class="material-symbols-rounded plan-downgrade-icon-keep" aria-hidden="true">check_circle</span>
									<span>{featureLabel(code)}</span>
								</li>
							))}
						</ul>
					</div>
					<div class="plan-downgrade-col plan-downgrade-col--lose">
						<p class="plan-downgrade-col-title m-0">Lo que perdés</p>
						<ul class="plan-downgrade-list">
							{DOWNGRADE_LOSE_FEATURES.map((code) => (
								<li>
									<span class="material-symbols-rounded plan-downgrade-icon-lose" aria-hidden="true">cancel</span>
									<span class="plan-downgrade-lose-text">{featureLabel(code)}</span>
								</li>
							))}
							<li>
								<span class="material-symbols-rounded plan-downgrade-icon-lose" aria-hidden="true">cancel</span>
								<span class="plan-downgrade-lose-text">
									{formatGb(current.storage_limit_bytes)} → {formatGb(basePlan.storage_limit_bytes)} de almacenamiento
								</span>
							</li>
						</ul>
					</div>
				</div>
				<p class="m-0 text-[0.84rem] font-medium text-(--on-surface-variant)">
					El cambio se programa para el{' '}
					{current.current_period_end
						? formatDateEs(current.current_period_end)
						: 'fin de tu ciclo actual'}
					. Hasta entonces seguís con {current.plan_name}.
				</p>
				<div class="grid gap-2">
					<button type="button" class="plan-btn plan-btn-primary" data-downgrade-keep>
						Mantener mi plan {current.plan_name}
					</button>
					<button
						type="button"
						class="plan-btn plan-btn-ghost"
						data-downgrade-confirm
						data-plan-code={basePlan.code}
						data-plan-name={basePlan.name}
					>
						Sí, pasar al Plan Base
					</button>
				</div>
			</div>
		</div>
	) : null}

	{/* Modal de confirmación de cobro — bottom sheet en mobile/tablet */}
	<div class="plan-modal-backdrop plan-pay-modal-backdrop hidden" data-pay-modal>
		<div class="plan-modal plan-pay-sheet" role="dialog" aria-modal="true" aria-labelledby="plan-pay-title">
			<div class="plan-sheet-handle" aria-hidden="true"><span></span></div>
			<div class="grid gap-3">
				<h3 id="plan-pay-title" class="m-0 text-lg font-bold text-(--on-surface)" data-pay-title>Confirmar suscripción</h3>

				{/* Formato recibo: cobro hoy vs renovación */}
				<div class="plan-pay-receipt" data-pay-receipt>
					<div class="plan-pay-receipt-today">
						<span class="plan-pay-receipt-label" data-pay-today-label>A pagar hoy</span>
						<span class="plan-pay-receipt-amount" data-pay-today-amount>—</span>
						<span class="plan-pay-receipt-note hidden" data-pay-today-note></span>
					</div>
					<div class="plan-pay-receipt-future hidden" data-pay-future>
						<span class="plan-pay-receipt-future-text" data-pay-future-note></span>
					</div>
				</div>

				{/* Fallback legacy (oculto si hay recibo) */}
				<p class="m-0 hidden text-[0.88rem] font-medium text-(--on-surface-variant)" data-pay-summary></p>
				<p class="m-0 hidden text-[0.82rem] font-medium text-(--on-surface-variant)" data-pay-detail></p>
			</div>

			{/* Con tarjeta: confirmar cobro */}
			<div class="grid gap-3" data-pay-has-card>
				<div class="plan-pay-card" data-pay-card-info>
					<span class="material-symbols-rounded">credit_card</span>
					<span class="grid text-left gap-0.5">
						<strong data-pay-card-label>{defaultCardLabel}</strong>
						<small data-pay-card-hint>{defaultCardHint}</small>
						<small class="opacity-80">Cobro con la tarjeta predeterminada · se renueva cada mes.</small>
					</span>
				</div>
				<button type="button" class="plan-btn plan-btn-primary" data-confirm-pay>Pagar y activar</button>
			</div>

			{/* Sin tarjeta: pedir catastro */}
			<div class="grid gap-3 hidden" data-pay-need-card>
				<p class="m-0 rounded-xl bg-amber-50 px-4 py-3 text-[0.85rem] font-semibold text-amber-700 dark:bg-amber-500/10 dark:text-amber-300">
					Para continuar necesitás registrar una tarjeta. El cobro es automático cada mes.
				</p>
				<button type="button" class="plan-btn plan-btn-primary" data-add-card-cta>
					<span class="material-symbols-rounded align-middle text-[1.1rem]">add_card</span> Registrar tarjeta
				</button>
			</div>

			<button type="button" class="plan-btn plan-btn-ghost" data-pay-cancel>Cancelar</button>
			<div class="plan-loading-chip hidden" data-pay-loading aria-live="polite">
				<span class="material-symbols-rounded animate-spin text-[1.1rem] text-(--primary)">progress_activity</span>
				<span>Procesando el cobro…</span>
			</div>
		</div>
	</div>

	{/* Modal del iframe uPay — bottom sheet en mobile/tablet */}
	<div class="plan-modal-backdrop plan-card-modal-backdrop hidden" data-card-modal>
		<div class="plan-modal plan-modal-wide plan-card-sheet" role="dialog" aria-modal="true" aria-labelledby="plan-card-title">
			<div class="plan-sheet-handle" aria-hidden="true"><span></span></div>
			<div class="plan-card-sheet-head">
				<div class="plan-card-sheet-copy">
					<h3 id="plan-card-title" class="m-0 text-lg font-bold text-(--on-surface)">Registrar tarjeta</h3>
					<p class="m-0 text-[0.85rem] font-medium text-(--on-surface-variant)">Crédito o débito · Visa / Mastercard</p>
				</div>
				<button type="button" class="plan-card-close" data-card-close aria-label="Cerrar">
					<span class="material-symbols-rounded">close</span>
				</button>
			</div>
			<div class="plan-iframe-wrap">
				<div class="plan-iframe-loading" data-card-loading aria-live="polite" aria-busy="true">
					<span class="plan-loading-chip">
						<span class="material-symbols-rounded animate-spin text-[1.1rem] text-(--primary)">progress_activity</span>
						<span>Cargando formulario seguro…</span>
					</span>
				</div>
				<iframe class="plan-card-iframe hidden" data-card-iframe title="Registro de tarjeta" allow="payment"></iframe>
			</div>
		</div>
	</div>

	{/* Drawer datos de facturación — PC (mismo tamaño que ATC) */}
