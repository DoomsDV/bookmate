	.plan-btn-outline:hover { background: color-mix(in srgb, var(--primary) 8%, transparent); }
	.plan-btn-current { background: color-mix(in srgb, var(--on-surface-variant) 16%, transparent); color: var(--on-surface-variant); }
	.plan-btn-soft { width: auto; background: color-mix(in srgb, var(--primary) 12%, transparent); color: var(--primary); }
	.plan-btn--auto { width: auto; }
	.plan-btn-danger {
