															>
																<span class="material-symbols-rounded">delete</span>
															</button>
														</div>
													</article>
												))
											)}
										</div>

										<div>
											<button type="button" class="plan-btn plan-btn-soft" data-add-card>
												<span class="material-symbols-rounded align-middle text-[1.1rem]">add_card</span>
												{cards.length === 0 ? 'Agregar tarjeta' : 'Agregar otra tarjeta'}
											</button>
										</div>
									</section>
								)}

								{/* ---- Add-ons de storage ---- */}
								{(catalog.storage_addons.length > 0 || current.active_storage_addons.length > 0) && (
									<section class="grid gap-4" data-storage-section>
										<div class="grid gap-1">
											<h2 class="m-0 text-lg font-bold text-(--on-surface)">Almacenamiento adicional</h2>
											<p class="m-0 text-[0.88rem] font-medium text-(--on-surface-variant)">
												Sumá espacio para notas y archivos del historial de tus citas.
												{!current.supports_storage_addons && ' Disponible con el plan Premium.'}
												{current.account_balance > 0
													? ' Si cancelás un paquete, el tiempo no usado se acredita a favor.'
													: ''}
											</p>
										</div>

										{current.active_storage_addons.length > 0 ? (
											<div class="grid gap-3">
												<span class="text-xs font-bold uppercase tracking-wide text-(--on-surface-variant)">Activos</span>
												{current.active_storage_addons.map((line) => (
													<article class="plan-addon-card">
														<div class="grid gap-1">
															<span class="text-[1.05rem] font-bold text-(--on-surface)">
																{line.name}
																{line.quantity > 1 ? ` ×${line.quantity}` : ''}
															</span>
															<span class="text-[0.85rem] font-semibold text-(--on-surface-variant)">
																{formatGs(line.line_total)} / mes · {formatGb(line.extra_bytes * line.quantity)}
															</span>
															{line.cancel_credit_amount > 0 ? (
																<span class="text-[0.78rem] font-medium text-(--on-surface-variant)">
																	Al cancelar: crédito estimado {formatGs(line.cancel_credit_amount)}
																</span>
															) : null}
														</div>
														{isAdmin && line.cancelable ? (
															<button
																type="button"
																class="plan-btn plan-btn-soft"
																data-addon-cancel
																data-addon-code={line.code}
																data-addon-name={line.name}
																data-addon-credit={String(line.cancel_credit_amount)}
															>
																Cancelar
															</button>
														) : null}
													</article>
												))}
											</div>
										) : null}

										{catalog.storage_addons.length > 0 ? (
										<div class="grid gap-4 sm:grid-cols-2">
											{catalog.storage_addons.map((addon) => {
												const showProrate =
													current.supports_storage_addons &&
													addon.days_remaining > 0 &&
													addon.prorate_amount > 0 &&
													addon.prorate_amount < addon.price_amount;
												return (
												<article class="plan-addon-card">
													<div class="grid gap-1">
														<span class="text-[1.05rem] font-bold text-(--on-surface)">{addon.name}</span>
														<span class="text-[0.85rem] font-semibold text-(--on-surface-variant)">{formatGb(addon.extra_bytes)} extra</span>
														{showProrate ? (
															<span class="text-[0.78rem] font-medium text-(--on-surface-variant)">
																Hoy: {formatGs(addon.prorate_amount)} (proporcional · {addon.days_remaining} día{addon.days_remaining === 1 ? '' : 's'})
															</span>
														) : null}
													</div>
													<div class="flex items-center justify-between gap-3">
														<span class="text-xl font-extrabold text-(--on-surface)">{formatGs(addon.price_amount)}<span class="text-[0.8rem] font-semibold text-(--on-surface-variant)"> /mes</span></span>
														{isAdmin && current.supports_storage_addons ? (
															<button
																type="button"
																class="plan-btn plan-btn-soft"
																data-addon-select
																data-addon-code={addon.code}
																data-addon-name={addon.name}
																data-addon-price={String(addon.price_amount)}
																data-addon-prorate={String(addon.prorate_amount)}
																data-addon-days={String(addon.days_remaining)}
															>Contratar</button>
														) : (
															<button type="button" class="plan-btn plan-btn-soft" disabled>{current.supports_storage_addons ? 'Solo admin' : 'Solo Premium'}</button>
														)}
													</div>
												</article>
												);
											})}
										</div>
										) : null}
									</section>
								)}
								</div>

								{/* ---- Pestaña Facturación ---- */}
								<div data-plan-panel="billing" class="hidden grid gap-6 sm:gap-8">
									<section class="plan-billing-summary">
										<div class="grid gap-1">
											<h2 class="m-0 text-lg font-bold text-(--on-surface)">Resumen de facturación</h2>
											<p class="m-0 text-[0.88rem] font-medium text-(--on-surface-variant)">
												Próximo cobro y desglose de tu suscripción.
											</p>
										</div>
										<div class="plan-billing-grid">
											<div class="plan-billing-cell">
												<span class="plan-billing-label">Próxima facturación</span>
												<strong class="plan-billing-value">
													{formatDateEs(billing?.next_billing_at || current.next_billing_at)}
												</strong>
											</div>
											<div class="plan-billing-cell">
												<span class="plan-billing-label">Plan</span>
												<strong class="plan-billing-value">
													{formatGs(billing?.plan_monthly_amount ?? current.plan_monthly_amount)}
												</strong>
												<small>{billing?.plan_name || current.plan_name}</small>
											</div>
											<div class="plan-billing-cell">
												<span class="plan-billing-label">Almacenamiento</span>
												<strong class="plan-billing-value">
													{formatGs(billing?.addons_monthly_amount ?? current.addons_monthly_amount)}
												</strong>
												<small>/ mes</small>
											</div>
											<div class="plan-billing-cell">
												<span class="plan-billing-label">Saldo a favor</span>
												<strong class="plan-billing-value text-(--primary)">
													{formatGs(billing?.account_balance ?? current.account_balance)}
												</strong>
											</div>
											<div class="plan-billing-cell plan-billing-cell-accent">
												<span class="plan-billing-label">Estimado próximo cargo</span>
												<strong class="plan-billing-value plan-billing-value-lg">
													{formatGs(billing?.next_charge_estimate ?? current.next_charge_estimate)}
												</strong>
												<small>Después de aplicar el saldo a favor</small>
											</div>
										</div>
									</section>

									<section class="grid gap-4">
										<div class="grid gap-1">
											<h2 class="m-0 text-lg font-bold text-(--on-surface)">Historial de pagos</h2>
											<p class="m-0 text-[0.88rem] font-medium text-(--on-surface-variant)">
												Cobros exitosos, pendientes y fallidos de tu suscripción.
											</p>
										</div>

										{(billing?.invoices?.length ?? 0) === 0 ? (
											<div class="plan-billing-empty">
												<span class="material-symbols-rounded text-[1.5rem] text-(--on-surface-variant)">receipt_long</span>
												<p class="m-0 text-[0.9rem] font-semibold text-(--on-surface-variant)">
													Todavía no hay pagos registrados.
												</p>
											</div>
										) : (
											<>
												<div class="plan-invoice-table-wrap hidden md:block">
													<table class="plan-invoice-table">
														<thead>
															<tr>
																<th>Fecha</th>
																<th>Detalle</th>
																<th>Monto</th>
																<th>Estado</th>
															</tr>
														</thead>
														<tbody>
															{billing!.invoices.map((inv) => {
																const st = invoiceStatusMeta(inv.status);
																return (
																	<tr>
																		<td>
																			{formatDateTimeEs(inv.paid_at || inv.created_at)}
																		</td>
																		<td>
																			<span class="plan-invoice-desc">{inv.description || inv.invoice_type}</span>
																			{inv.credit_applied > 0 ? (
																				<small class="plan-invoice-credit">
																					Crédito aplicado: {formatGs(inv.credit_applied)}
																				</small>
																			) : null}
																		</td>
																		<td class="plan-invoice-amount">{formatGs(inv.amount)}</td>
																		<td>
																			<span class={`plan-inv-badge plan-inv-${st.tone}`}>{st.label}</span>
																		</td>
																	</tr>
																);
															})}
														</tbody>
													</table>
												</div>
												<div class="grid gap-3 md:hidden">
													{billing!.invoices.map((inv) => {
														const st = invoiceStatusMeta(inv.status);
														return (
															<article class="plan-invoice-card">
																<div class="flex items-start justify-between gap-3">
																	<div class="grid gap-1">
																		<span class="text-[0.95rem] font-bold text-(--on-surface)">
																			{inv.description || inv.invoice_type}
																		</span>
																		<span class="text-[0.8rem] font-medium text-(--on-surface-variant)">
																			{formatDateTimeEs(inv.paid_at || inv.created_at)}
																		</span>
																		{inv.credit_applied > 0 ? (
																			<span class="text-[0.78rem] font-medium text-(--primary)">
																				Crédito: {formatGs(inv.credit_applied)}
																			</span>
																		) : null}
																	</div>
																	<span class={`plan-inv-badge plan-inv-${st.tone}`}>{st.label}</span>
																</div>
																<span class="text-lg font-extrabold text-(--on-surface)">{formatGs(inv.amount)}</span>
															</article>
														);
													})}
												</div>
											</>
										)}
									</section>
								</div>
							</>
						) : null}
					</div>
				</main>
			</div>
		</div>
	</div>

	{/* Modal de confirmación de cobro — bottom sheet en mobile/tablet */}
	<div class="plan-modal-backdrop plan-pay-modal-backdrop hidden" data-pay-modal>
		<div class="plan-modal plan-pay-sheet" role="dialog" aria-modal="true" aria-labelledby="plan-pay-title">
			<div class="plan-sheet-handle" aria-hidden="true"><span></span></div>
			<div class="grid gap-3">
				<h3 id="plan-pay-title" class="m-0 text-lg font-bold text-(--on-surface)" data-pay-title>Confirmar suscripción</h3>

				{/* Formato recibo: cobro hoy vs renovación */}
				<div class="plan-pay-receipt" data-pay-receipt>
					<div class="plan-pay-receipt-today">
						<span class="plan-pay-receipt-label" data-pay-today-label>A pagar hoy</span>
						<span class="plan-pay-receipt-amount" data-pay-today-amount>—</span>
						<span class="plan-pay-receipt-note hidden" data-pay-today-note></span>
					</div>
					<div class="plan-pay-receipt-future hidden" data-pay-future>
						<span class="plan-pay-receipt-future-text" data-pay-future-note></span>
					</div>
				</div>

				{/* Fallback legacy (oculto si hay recibo) */}
				<p class="m-0 hidden text-[0.88rem] font-medium text-(--on-surface-variant)" data-pay-summary></p>
				<p class="m-0 hidden text-[0.82rem] font-medium text-(--on-surface-variant)" data-pay-detail></p>
			</div>

			{/* Con tarjeta: confirmar cobro */}
			<div class="grid gap-3" data-pay-has-card>
				<div class="plan-pay-card" data-pay-card-info>
					<span class="material-symbols-rounded">credit_card</span>
					<span class="grid text-left gap-0.5">
						<strong data-pay-card-label>{defaultCardLabel}</strong>
						<small data-pay-card-hint>{defaultCardHint}</small>
						<small class="opacity-80">Cobro con la tarjeta predeterminada · se renueva cada mes.</small>
					</span>
				</div>
				<button type="button" class="plan-btn plan-btn-primary" data-confirm-pay>Pagar y activar</button>
			</div>

			{/* Sin tarjeta: pedir catastro */}
			<div class="grid gap-3 hidden" data-pay-need-card>
				<p class="m-0 rounded-xl bg-amber-50 px-4 py-3 text-[0.85rem] font-semibold text-amber-700 dark:bg-amber-500/10 dark:text-amber-300">
					Para continuar necesitás registrar una tarjeta. El cobro es automático cada mes.
				</p>
				<button type="button" class="plan-btn plan-btn-primary" data-add-card-cta>
					<span class="material-symbols-rounded align-middle text-[1.1rem]">add_card</span> Registrar tarjeta
				</button>
			</div>

			<button type="button" class="plan-btn plan-btn-ghost" data-pay-cancel>Cancelar</button>
			<div class="plan-loading-chip hidden" data-pay-loading aria-live="polite">
				<span class="material-symbols-rounded animate-spin text-[1.1rem] text-(--primary)">progress_activity</span>
				<span>Procesando el cobro…</span>
			</div>
		</div>
	</div>

	{/* Modal del iframe uPay — bottom sheet en mobile/tablet */}
	<div class="plan-modal-backdrop plan-card-modal-backdrop hidden" data-card-modal>
		<div class="plan-modal plan-modal-wide plan-card-sheet" role="dialog" aria-modal="true" aria-labelledby="plan-card-title">
			<div class="plan-sheet-handle" aria-hidden="true"><span></span></div>
			<div class="plan-card-sheet-head">
				<div class="plan-card-sheet-copy">
					<h3 id="plan-card-title" class="m-0 text-lg font-bold text-(--on-surface)">Registrar tarjeta</h3>
					<p class="m-0 text-[0.85rem] font-medium text-(--on-surface-variant)">Crédito o débito · Visa / Mastercard</p>
				</div>
				<button type="button" class="plan-card-close" data-card-close aria-label="Cerrar">
					<span class="material-symbols-rounded">close</span>
				</button>
			</div>
			<div class="plan-iframe-wrap">
				<div class="plan-iframe-loading" data-card-loading aria-live="polite" aria-busy="true">
					<span class="plan-loading-chip">
						<span class="material-symbols-rounded animate-spin text-[1.1rem] text-(--primary)">progress_activity</span>
						<span>Cargando formulario seguro…</span>
					</span>
				</div>
				<iframe class="plan-card-iframe hidden" data-card-iframe title="Registro de tarjeta" allow="payment"></iframe>
			</div>
		</div>
	</div>

	<AppAlert />
</Layout>

