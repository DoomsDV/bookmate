---
import { isSubscriptionBillingUiEnabled } from '../../config/feature-flags';
import { ROLES } from '../../config/roles';
import SideNav from '../../components/SideNav.astro';
import TopBar from '../../components/TopBar.astro';
import AppAlert from '../../components/AppAlert.astro';
import BillingProfileForm from '../../components/BillingProfileForm.astro';
import Layout from '../../layouts/Layout.astro';
import { panelPageTitle } from '../../lib/panel-page-title';
import {
	getPlansWithOrds,
	listCardsWithOrds,
	listInvoicesWithOrds,
	SubscriptionApiError,
	type BillingHistory,
	type PlansCatalog,
	type PaymentCard,
} from '../../lib/subscription';
import {
	getBillingProfileWithOrds,
	type BillingProfileData,
} from '../../lib/billing-profile';
import '../../styles/global.css';

if (!isSubscriptionBillingUiEnabled()) {
	return Astro.redirect('/panel/dashboard', 302);
}

const token = Astro.locals.token ?? '';
const roleId = Number(Astro.locals.roleId ?? 0);
const isAdmin = roleId === ROLES.ADMIN;

let catalog: PlansCatalog | null = null;
let cards: PaymentCard[] = [];
let billing: BillingHistory | null = null;
let billingProfile: BillingProfileData | null = null;
let loadError = '';

if (!token) {
	loadError = 'No hay sesion valida para consultar tu plan.';
} else {
	// Las 4 llamadas son independientes entre sí: se resuelven en paralelo en vez
	// de una tras otra (cada catch preserva el mismo fallback que tenía secuencialmente).
	const catalogPromise = getPlansWithOrds(token).catch((error) => {
		loadError =
			error instanceof SubscriptionApiError
				? error.message
				: 'No fue posible cargar la información de tu plan.';
		return null;
	});
	// Tarjetas/perfil de facturación: solo admin (para el cobro recurrente).
	const cardsPromise: Promise<PaymentCard[]> = isAdmin
		? listCardsWithOrds(token).catch(() => [])
		: Promise.resolve([]);
	const billingProfilePromise: Promise<BillingProfileData | null> = isAdmin
		? getBillingProfileWithOrds(token).catch(() => null)
		: Promise.resolve(null);
	const billingPromise = listInvoicesWithOrds(token).catch(() => null);

	[catalog, cards, billingProfile, billing] = await Promise.all([
		catalogPromise,
		cardsPromise,
		billingProfilePromise,
		billingPromise,
	]);
}

const hasCard = cards.length > 0;

const currency = new Intl.NumberFormat('es-PY');
const formatGs = (amount: number) => `${currency.format(Math.max(0, Math.round(amount)))} Gs`;
const formatDateEs = (iso: string | null | undefined) => {
	if (!iso) return '—';
	const d = new Date(iso);
	if (Number.isNaN(d.getTime())) return '—';
	return d.toLocaleDateString('es-PY', { day: 'numeric', month: 'long', year: 'numeric' });
};
const formatDateTimeEs = (iso: string | null | undefined) => {
	if (!iso) return '—';
	const d = new Date(iso);
	if (Number.isNaN(d.getTime())) return '—';
	return d.toLocaleString('es-PY', {
		day: 'numeric',
		month: 'short',
		year: 'numeric',
		hour: '2-digit',
		minute: '2-digit',
	});
};
const invoiceStatusMeta = (status: string) => {
	const s = status.toUpperCase();
	if (s === 'PAID') return { label: 'Pagado', tone: 'ok' as const };
	if (s === 'FAILED') return { label: 'Fallido', tone: 'bad' as const };
	if (s === 'PENDING') return { label: 'Pendiente', tone: 'warn' as const };
	if (s === 'VOID') return { label: 'Anulado', tone: 'muted' as const };
	return { label: status || '—', tone: 'muted' as const };
};
const formatGb = (bytes: number) => {
	if (!bytes || bytes <= 0) return '0 GB';
	const gb = bytes / 1024 / 1024 / 1024;
	return `${Number.isInteger(gb) ? gb : gb.toFixed(1)} GB`;
};

/** Uso: KB / MB / GB según el peso real (el límite del plan sigue en GB). */
const formatStorageUsed = (bytes: number) => {
	if (!bytes || bytes <= 0) return '0 KB';
	const kb = bytes / 1024;
	const mb = bytes / (1024 * 1024);
	const gb = bytes / (1024 * 1024 * 1024);
	if (gb >= 1) {
		const rounded = Math.round(gb * 10) / 10;
		return `${Number.isInteger(rounded) ? rounded : rounded.toFixed(1)} GB`;
	}
	if (mb >= 1) {
		const rounded = mb < 10 ? Math.round(mb * 10) / 10 : Math.round(mb);
		return `${rounded} MB`;
	}
	return `${Math.max(1, Math.round(kb))} KB`;
};

const FEATURE_LABELS: Record<string, string> = {
	WEB_BOOKING: 'Reservas web 24/7',
	NOTIFICATIONS: 'Notificaciones al instante',
	CUSTOMERS: 'Gestión de clientes',
	SERVICES: 'Servicios y catálogo',
	TEAM_MULTI_BRANCH: 'Equipo y sucursales sin límites',
	AI_MORNING_DIGEST: 'Resumen Inteligente (IA)',
	VOICE_RECEPTION: 'Recepción Inteligente por voz',
	DEPOSIT_COLLECTION: 'Cobro seguro por señas',
	APPOINTMENT_HISTORY: 'Historial completo del cliente',
	PROFITABILITY_ANALYTICS: 'Análisis de rentabilidad',
};
const featureLabel = (code: string) => FEATURE_LABELS[code] ?? code;

type PlanBenefit = { title: string; description: string };
type PlanMarketing = {
	tagline: string;
	includesBase?: boolean;
	benefits: PlanBenefit[];
};

const PLAN_MARKETING: Record<string, PlanMarketing> = {
	BASE: {
		tagline: 'Para digitalizar y ordenar tu negocio sin límites.',
		benefits: [
			{
				title: 'Equipo y sucursales sin límites',
				description: 'Agregá todos los profesionales y locales que necesites desde el primer día.',
			},
			{
				title: 'Reservas web 24/7',
				description: 'Tu página para que los clientes agenden turnos solos, en cualquier momento.',
			},
			{
				title: 'Notificaciones al instante',
				description: 'Avisos automáticos al equipo sobre reservas, cambios o cancelaciones.',
			},
			{
				title: 'Gestión de clientes y servicios',
				description: 'Controlá tu base de clientes y organizá todo el catálogo en un solo lugar.',
			},
			{
				title: 'Resumen Inteligente (IA)',
				description: 'Hasel analiza tu agenda y te da un panorama claro cada mañana.',
			},
			{
				title: 'Análisis de rentabilidad',
				description: 'Reportes de ingresos y asistencia de cada cliente para conocer tu negocio.',
			},
			{
				title: 'Almacenamiento en la nube (1 GB)',
				description: 'Espacio para el logo, fotos del equipo y adjuntos básicos del día a día.',
			},
		],
	},
	PREMIUM: {
		tagline: 'Nuestra solución más completa para ahorrar tiempo, asegurar ingresos y fidelizar clientes.',
		includesBase: true,
		benefits: [
			{
				title: 'Recepción Inteligente por voz',
				description: 'Olvidate de tipear. Creá turnos al instante dictándole a nuestra IA.',
			},
			{
				title: 'Cobro seguro por señas',
				description: 'Cobrá un anticipo al momento de reservar y reducí el ausentismo a cero.',
			},
			{
				title: 'Historial completo del cliente',
				description: 'Registrá visitas con notas internas, fotos del "antes y después" y documentos PDF.',
			},
			{
				title: '5 GB de almacenamiento total',
				description: 'Espacio garantizado para no perder nunca tus fotos y archivos.',
			},
		],
	},
};

const planMarketing = (code: string): PlanMarketing | null => PLAN_MARKETING[code] ?? null;

const current = catalog?.current ?? null;
const effState = current?.effective_status ?? 'NONE';

// Días restantes de prueba (para el CTA de día 15).
let trialDaysLeft: number | null = null;
if (current?.trial_ends_at) {
	const diffMs = new Date(current.trial_ends_at).getTime() - Date.now();
	trialDaysLeft = Math.max(0, Math.ceil(diffMs / (1000 * 60 * 60 * 24)));
}

const STATUS_META: Record<string, { label: string; tone: string; hint: string }> = {
	TRIAL: {
		label: 'Prueba gratis',
		tone: 'trial',
		hint:
			trialDaysLeft !== null
				? `Te ${trialDaysLeft === 1 ? 'queda' : 'quedan'} ${trialDaysLeft} ${trialDaysLeft === 1 ? 'día' : 'días'} de prueba Premium. Al terminar, elegí un plan para continuar.`
				: 'Estás en período de prueba Premium.',
	},
	TRIAL_EXPIRED: {
		label: 'Prueba vencida',
		tone: 'danger',
		hint: 'Tu prueba terminó. Elegí un plan para seguir usando todas las funciones.',
	},
	ACTIVE: { label: 'Activo', tone: 'ok', hint: 'Tu suscripción está al día.' },
	PAST_DUE: {
		label: 'Pago pendiente',
		tone: 'warning',
		hint: 'Tu pago está pendiente. Regularizá para no perder el acceso de escritura.',
	},
	READ_ONLY: {
		label: 'Solo lectura',
		tone: 'danger',
		hint: 'Tu cuenta está en solo lectura. Podés consultar tu información; para volver a agendar, elegí un plan Base o Premium.',
	},
	CANCELED: { label: 'Cancelado', tone: 'danger', hint: 'Tu suscripción está cancelada.' },
	FOUNDER: {
		label: 'Fundador',
		tone: 'founder',
		hint: '50% de descuento de por vida (Miembro Fundador)',
	},
	NONE: { label: 'Sin plan', tone: 'warning', hint: 'No encontramos una suscripción activa.' },
};
const statusMeta = STATUS_META[effState] ?? STATUS_META.NONE;

const storageUsedBytes = current?.storage_used_bytes ?? 0;
const storageLimitBytes = current?.storage_limit_bytes ?? 0;
const storagePctExact =
	storageLimitBytes > 0 ? Math.min(100, (storageUsedBytes / storageLimitBytes) * 100) : 0;
const storagePct = Math.min(100, Math.round(storagePctExact));
const storagePctLabel =
	storageUsedBytes > 0 && storagePctExact > 0 && storagePctExact < 1
		? '< 1'
		: String(storagePct);
/** Ancho visual mínimo (~2%) cuando hay uso real, aunque el % sea ínfimo. */
const storageBarWidth =
	storageUsedBytes > 0 ? Math.min(100, Math.max(storagePctExact, 2)) : 0;

const showDay15 = effState === 'TRIAL' || effState === 'TRIAL_EXPIRED';
const cancelScheduled = !!current?.cancel_scheduled;
const isContinuity =
	!!current &&
	(current.plan_code === 'FREE' || (effState === 'READ_ONLY' && !!current.canceled_at));
const canTerminate =
	isAdmin &&
	!!current &&
	!current.billing_exempt &&
	!cancelScheduled &&
	!isContinuity &&
	['ACTIVE', 'PAST_DUE', 'TRIAL', 'FOUNDER'].includes(effState);

// Método de pago (cobro recurrente con tarjeta): solo admin y planes facturables.
const showPaymentMethod = isAdmin && !!current && !current.billing_exempt;

const PLAN_TABS = new Set(['plan', 'billing', 'history']);
const tabParam = Astro.url.searchParams.get('tab') || 'plan';
const activeTab = PLAN_TABS.has(tabParam) ? tabParam : 'plan';
const historyInvoices = billing?.invoices ?? [];

const isAtMaxPlan =
	!!current &&
	current.plan_code === 'PREMIUM' &&
	!['TRIAL', 'TRIAL_EXPIRED', 'READ_ONLY'].includes(effState);

const showUpgradeOnly =
	!!current &&
	current.plan_code === 'BASE' &&
	!['TRIAL_EXPIRED', 'READ_ONLY'].includes(effState) &&
	!isContinuity;

const showFullPlanCatalog = !isAtMaxPlan && !showUpgradeOnly;
const plansToShow =
	catalog?.plans.filter((plan) => {
		if (showUpgradeOnly) return plan.code === 'PREMIUM';
		if (showFullPlanCatalog) return true;
		return false;
	}) ?? [];

const premiumMarketing = planMarketing('PREMIUM');
const currentPlanCatalog =
	catalog?.plans.find((p) => p.is_current || p.code === current?.plan_code) ?? null;
const hasCurrentFounderDeal =
	!!currentPlanCatalog &&
	currentPlanCatalog.founder_discount_percent > 0 &&
	currentPlanCatalog.checkout_price_amount > 0 &&
	currentPlanCatalog.checkout_price_amount < currentPlanCatalog.price_amount;
const currentOriginalMonthlyTotal =
	hasCurrentFounderDeal && current
		? currentPlanCatalog.price_amount + current.addons_monthly_amount
		: 0;
const basePlan = catalog?.plans.find((p) => p.code === 'BASE') ?? null;
const canDowngradeToBase =
	isAdmin &&
	isAtMaxPlan &&
	!cancelScheduled &&
	!current?.billing_exempt &&
	!current?.pending_plan_code &&
	!!basePlan;

const DOWNGRADE_KEEP_FEATURES = [
	'CUSTOMERS',
	'WEB_BOOKING',
	'SERVICES',
	'AI_MORNING_DIGEST',
	'PROFITABILITY_ANALYTICS',
] as const;
const DOWNGRADE_LOSE_FEATURES = [
	'VOICE_RECEPTION',
	'DEPOSIT_COLLECTION',
	'APPOINTMENT_HISTORY',
] as const;
const formatMaskedCard = (masked: string | null) => {
	const raw = String(masked || '').replace(/\s+/g, '');
	if (!raw) return '•••• •••• •••• ••••';
	return raw.replace(/(.{4})/g, '$1 ').trim();
};
const cardTone = (brand: string | null) => {
	const b = String(brand || '').toLowerCase();
	if (b.includes('master')) return 'mc';
	if (b.includes('visa')) return 'visa';
	return 'generic';
};
const cardBrandLabel = (brand: string | null) => {
	const b = String(brand || '').toLowerCase();
	if (b.includes('master')) return 'Mastercard';
	if (b.includes('visa')) return 'Visa';
	return brand || 'Tarjeta';
};
const nextChargeEstimate = billing?.next_charge_estimate ?? current?.next_charge_estimate ?? 0;
const billingProfileComplete = billingProfile?.is_complete === 1;
const defaultCard = cards.find((c) => c.is_default) || cards[0] || null;
const defaultCardLabel = defaultCard
	? `${defaultCard.brand || 'Tarjeta'} · ${formatMaskedCard(defaultCard.masked_number)}`
	: 'Tarjeta registrada';
const defaultCardHint = defaultCard
	? [defaultCard.card_type, defaultCard.issuer].filter(Boolean).join(' · ') ||
		'Se debitará automáticamente cada mes.'
	: 'Se debitará automáticamente cada mes.';
---

<Layout pageTitle={panelPageTitle('Plan y facturación')}>
	<div
		class="plan-canvas min-h-screen w-full max-w-full overflow-x-hidden bg-(--page-background)"
		data-has-card={hasCard ? '1' : '0'}
		data-default-card-label={defaultCardLabel}
		data-default-card-hint={defaultCardHint}
	>
		<div class="app-shell grid min-h-screen overflow-hidden bg-transparent" data-app-shell data-sidebar-state="expanded">
			<SideNav currentPath={Astro.url.pathname} />

			<div class="grid min-h-full grid-rows-[auto_1fr] bg-(--page-background)">
				<TopBar />

				<main class="w-full max-w-full overflow-x-hidden px-4 py-4 sm:px-6 sm:py-8 lg:px-8">
					<div class="grid w-full gap-6 sm:gap-8">
						<header class="grid gap-1">
							<h1 class="m-0 text-3xl font-extrabold tracking-tight text-(--on-surface) sm:text-4xl">Plan y suscripción</h1>
						</header>

						{loadError ? (
							<div class="rounded-2xl border border-rose-200 bg-rose-50 p-5 text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-300">
								<p class="m-0 font-semibold">{loadError}</p>
							</div>
						) : current && catalog ? (
							<>
								<nav class="plan-tabs" data-plan-tabs aria-label="Secciones de plan">
									<button
										type="button"
										class:list={['plan-tab', activeTab === 'plan' && 'is-active']}
										data-plan-tab="plan"
										aria-selected={activeTab === 'plan' ? 'true' : 'false'}
									>
										Plan
									</button>
									<button
										type="button"
										class:list={['plan-tab', activeTab === 'billing' && 'is-active']}
										data-plan-tab="billing"
										aria-selected={activeTab === 'billing' ? 'true' : 'false'}
									>
										Facturación
									</button>
									<button
										type="button"
										class:list={['plan-tab', activeTab === 'history' && 'is-active']}
										data-plan-tab="history"
										aria-selected={activeTab === 'history' ? 'true' : 'false'}
									>
										Historial de pagos
									</button>
								</nav>

								<div data-plan-panel="plan" class:list={['grid', 'gap-6', 'sm:gap-8', activeTab !== 'plan' && 'hidden']}>
								{/* ---- Estado actual ---- */}
								<section class={`plan-status-card plan-tone-${statusMeta.tone}`}>
									<span class="plan-status-corner" aria-hidden="true">{statusMeta.label}</span>
									<div class="plan-status-main">
										<div class="plan-status-copy">
											<span class="plan-status-kicker">Plan actual</span>
											<div class="plan-status-headline">
												<h2 class="plan-status-title">{current.plan_name || current.plan_code}</h2>
												{current.monthly_total > 0 && !current.billing_exempt ? (
													<>
														<span class="plan-status-sep" aria-hidden="true">·</span>
														<div class="plan-status-price">
															{hasCurrentFounderDeal ? (
																<span class="plan-status-price-old">{formatGs(currentOriginalMonthlyTotal)}</span>
															) : null}
															<span class="plan-status-amount">{formatGs(current.monthly_total)}</span>
															<span class="plan-status-period">/ mes</span>
														</div>
													</>
												) : null}
											</div>
											{effState === 'FOUNDER' || current.is_founder ? (
												<span class="plan-status-deal">50% de descuento de por vida</span>
											) : statusMeta.hint ? (
												<p class="plan-status-hint">{statusMeta.hint}</p>
											) : null}
										</div>
										{current.next_billing_at && !current.billing_exempt ? (
											<div class="plan-status-side">
												<p class="plan-status-billing">
													<span class="plan-status-billing-label">Próxima facturación</span>
													<strong>{formatDateEs(current.next_billing_at)}</strong>
												</p>
											</div>
										) : null}
									</div>

									{current.pending_plan_code ? (
										<div class="plan-day15 mt-4">
											<div class="flex flex-wrap items-start justify-between gap-3">
												<div class="grid gap-1">
													<p class="m-0 font-bold text-(--on-surface)">
														{cancelScheduled
															? 'Cancelación programada'
															: `Cambio a ${current.pending_plan_name || current.pending_plan_code} programado`}
													</p>
													<p class="m-0 text-[0.88rem] font-medium text-(--on-surface-variant)">
														{cancelScheduled ? (
															<>
																Seguís con {current.plan_name} hasta el{' '}
																{current.pending_plan_change_at
																	? new Date(current.pending_plan_change_at).toLocaleDateString('es-PY', {
																			day: 'numeric',
																			month: 'long',
																			year: 'numeric',
																		})
																	: 'fin del periodo'}
																. Ese día pasás a Continuidad (0 Gs): sin cobros, addons cancelados y cuenta en solo lectura.
															</>
														) : (
															<>
																Seguís con {current.plan_name} hasta el{' '}
																{current.pending_plan_change_at
																	? new Date(current.pending_plan_change_at).toLocaleDateString('es-PY', {
																			day: 'numeric',
																			month: 'long',
																			year: 'numeric',
																		})
																	: 'fin del periodo'}
																. Ese día se aplica {current.pending_plan_name || current.pending_plan_code} y se cobra su tarifa mensual.
															</>
														)}
													</p>
												</div>
												{isAdmin ? (
													cancelScheduled ? (
														<button type="button" class="plan-btn plan-btn-soft" data-undo-cancel>
															Seguir con {current.plan_name}
														</button>
													) : (
														<button
															type="button"
															class="plan-btn plan-btn-soft"
															data-keep-plan
															data-plan-code={current.plan_code}
															data-plan-name={current.plan_name}
														>
															Mantener {current.plan_name}
														</button>
													)
												) : null}
											</div>
										</div>
									) : null}

									{isContinuity ? (
										<div class="plan-day15 mt-4">
											<div class="flex flex-wrap items-start justify-between gap-3">
												<div class="grid gap-1">
													<p class="m-0 font-bold text-(--on-surface)">Modo Continuidad (solo lectura)</p>
													<p class="m-0 text-[0.88rem] font-medium text-(--on-surface-variant)">
														Podés consultar historial y exportar clientes. Para volver a agendar, elegí Base o Premium abajo.
													</p>
												</div>
												<a
													href="/api/customers/export"
													class="plan-btn plan-btn-soft"
													download
												>
													Exportar clientes
												</a>
											</div>
										</div>
									) : null}

									{showDay15 && (
										<div class="plan-day15">
											<div class="flex items-start gap-3">
												<span class="material-symbols-rounded text-[1.4rem] text-(--primary)">workspace_premium</span>
												<div class="grid gap-1">
													<p class="m-0 font-bold text-(--on-surface)">
														{effState === 'TRIAL' ? '¿Listo para continuar?' : 'Elegí tu plan para reactivar'}
													</p>
													<p class="m-0 text-[0.88rem] font-medium text-(--on-surface-variant)">
														Cuando termine tu prueba podés seguir con <strong>Premium</strong> o pasar al plan <strong>Base</strong>.
													</p>
												</div>
											</div>
										</div>
									)}
								</section>

								{isAtMaxPlan ? (
									<section class="plan-usage-section">
										<div class="grid gap-1">
											<h2 class="m-0 text-lg font-bold text-(--on-surface)">Tu uso este mes</h2>
											<p class="m-0 text-[0.88rem] font-medium text-(--on-surface-variant)">
												Consultá cuánto espacio estás usando y si necesitás sumar almacenamiento adicional.
											</p>
										</div>
										<div class="plan-usage-grid">
											<article class="plan-usage-card">
												<div class="plan-usage-card-head">
													<span class="plan-usage-icon material-symbols-rounded" aria-hidden="true">cloud</span>
													<div class="grid gap-0.5">
														<span class="plan-usage-label">Almacenamiento</span>
														<span class="plan-usage-value">
															{formatStorageUsed(current.storage_used_bytes)}
															{' / '}
															{current.storage_limit_bytes > 0 ? formatGb(current.storage_limit_bytes) : 'No incluido'}
														</span>
													</div>
												</div>
												<div class="plan-storage-track plan-usage-track">
													<div
														class:list={['plan-storage-fill', storageUsedBytes > 0 && 'plan-storage-fill--active']}
														style={`width:${storageBarWidth}%`}
													></div>
												</div>
												<p class="plan-usage-footnote m-0">
													{storagePct >= 90
														? 'Estás cerca del límite. Podés sumar espacio extra en almacenamiento adicional.'
														: `${storagePctLabel}% del espacio incluido en uso.`}
												</p>
											</article>
										</div>
									</section>
								) : null}

								{/* ---- Planes / upgrade ---- */}
								{plansToShow.length > 0 ? (
								<section class="grid gap-4">
									<div class="grid gap-1">
										<h2 class="m-0 text-lg font-bold text-(--on-surface)">
											{showUpgradeOnly ? 'Potenciá tu negocio' : 'Elegí tu plan'}
										</h2>
										{showUpgradeOnly ? (
											<p class="m-0 text-[0.88rem] font-medium text-(--on-surface-variant)">
												Pasá a Premium y desbloqueá herramientas que no están en el plan Base.
											</p>
										) : null}
									</div>
									<div class:list={[
										'plan-cards-carousel md:grid md:gap-4',
										showUpgradeOnly ? 'plan-cards-carousel--single md:grid-cols-1 md:max-w-xl' : 'md:grid-cols-2',
									]}>
										{plansToShow.map((plan) => {
											const marketing = planMarketing(plan.code);
											const hasFounderDeal =
												plan.founder_discount_percent > 0 &&
												plan.checkout_price_amount > 0 &&
												plan.checkout_price_amount < plan.price_amount;
											const displayPrice = hasFounderDeal
												? plan.checkout_price_amount
												: plan.price_amount;
											const showConsolidated =
												plan.code === 'PREMIUM' &&
												plan.monthly_total > displayPrice &&
												current.addons_monthly_amount > 0;
											const isFounderViewer =
												!!current.is_founder ||
												effState === 'FOUNDER' ||
												catalog.plans.some(
													(p) =>
														p.code === 'PREMIUM' &&
														p.founder_discount_percent > 0 &&
														p.checkout_price_amount > 0 &&
														p.checkout_price_amount < p.price_amount
												);
											const showRegularPriceTag =
												plan.code === 'BASE' && isFounderViewer && !hasFounderDeal;
											const planAction = current.billing_exempt
												? 'immediate'
												: plan.price_amount < (catalog.plans.find((p) => p.is_current)?.price_amount ?? 0) ||
													  (plan.code === 'BASE' && current.plan_code === 'PREMIUM')
													? 'schedule'
													: 'activate';
											const isDowngradeCta = planAction === 'schedule';
											return (
											<article class:list={[
												'plan-card',
												plan.is_current && 'plan-card-current',
												(plan.code === 'PREMIUM' || showUpgradeOnly) && 'plan-card-featured',
												showUpgradeOnly && 'plan-card-upgrade',
											]}>
												{plan.is_current ? (
													<span class="plan-ribbon plan-ribbon--included">Incluido</span>
												) : plan.code === 'PREMIUM' ? (
													<span class="plan-ribbon">{showUpgradeOnly ? 'Tu próximo paso' : 'Recomendado'}</span>
												) : null}
												<div class="plan-card-head grid gap-1">
													<span class="plan-card-name text-sm font-bold uppercase tracking-wide text-(--on-surface-variant)">{plan.name}</span>
													<div class="plan-card-price-row flex flex-wrap items-end gap-x-2 gap-y-1">
														{hasFounderDeal ? (
															<span class="plan-card-price-old pb-1 text-[0.95rem] font-semibold text-(--on-surface-variant) line-through">
																{formatGs(plan.price_amount)}
															</span>
														) : null}
														<span class="plan-card-price text-3xl font-extrabold text-(--on-surface)">{formatGs(displayPrice)}</span>
														<span class="plan-card-period pb-1 text-[0.85rem] font-semibold text-(--on-surface-variant)">/ {plan.billing_period === 'YEARLY' ? 'año' : 'mes'}</span>
													</div>
													{hasFounderDeal ? (
														<span class="plan-card-deal text-[0.82rem] font-bold text-(--primary)">
															Precio fundador · {plan.founder_discount_percent}% off de por vida
														</span>
													) : null}
													{showRegularPriceTag ? (
														<span class="plan-price-tag">Precio Regular</span>
													) : null}
													{showConsolidated ? (
														<span class="plan-card-extra text-[0.82rem] font-semibold text-(--on-surface-variant)">
															Con almacenamiento: {formatGs(plan.monthly_total)} / mes
														</span>
													) : null}
													{marketing ? (
														<p class="plan-tagline m-0">{marketing.tagline}</p>
													) : plan.storage_limit_bytes > 0 ? (
														<span class="text-[0.82rem] font-semibold text-(--primary)">Incluye {formatGb(plan.storage_limit_bytes)} de almacenamiento</span>
													) : null}
												</div>
												<div class="plan-card-divider" aria-hidden="true"></div>
												{marketing ? (
													<div class="plan-card-body grid gap-3">
														{marketing.includesBase ? (
															<p class="plan-includes-base m-0">Incluye todo lo del Plan Base, más:</p>
														) : (
															<p class="plan-features-label m-0">Características</p>
														)}
														<ul class="plan-feature-list">
															{marketing.benefits.map((benefit) => (
																<li>
																	<span class="material-symbols-rounded plan-feature-check" aria-hidden="true">check_circle</span>
																	<span class="plan-feature-copy">
																		<strong>{benefit.title}</strong>
																		<button
																			type="button"
																			class="plan-feature-info"
																			aria-label={benefit.description}
																			data-tooltip={benefit.description}
																		>
																			<span class="material-symbols-rounded" aria-hidden="true">info</span>
																		</button>
																	</span>
																</li>
															))}
														</ul>
													</div>
												) : (
													<div class="plan-card-body grid gap-3">
														<p class="plan-features-label m-0">Características</p>
														<ul class="plan-feature-list">
															{plan.features.map((f) => (
																<li><span class="material-symbols-rounded plan-feature-check" aria-hidden="true">check_circle</span>{featureLabel(f)}</li>
															))}
														</ul>
													</div>
												)}
												{showUpgradeOnly && premiumMarketing ? (
													<div class="plan-upgrade-missing">
														<p class="plan-upgrade-missing-title m-0">Lo que te estás perdiendo en Base</p>
														<ul class="plan-upgrade-missing-list">
															{premiumMarketing.benefits.map((benefit) => (
																<li>
																	<span class="material-symbols-rounded" aria-hidden="true">lock_open</span>
																	<span>
																		<strong>{benefit.title}</strong>
																		<small>{benefit.description}</small>
																	</span>
																</li>
															))}
														</ul>
													</div>
												) : null}
												<div class="plan-card-cta mt-auto">
													{plan.is_current ? (
														<button type="button" class="plan-btn plan-btn-current" disabled>Plan actual</button>
													) : isAdmin ? (
														<button
															type="button"
															class={`plan-btn ${isDowngradeCta ? 'plan-btn-outline' : 'plan-btn-primary'}`}
															data-plan-select
															data-plan-code={plan.code}
															data-plan-name={plan.name}
															data-plan-price={String(displayPrice)}
															data-plan-monthly-total={String(showConsolidated ? plan.monthly_total : displayPrice)}
															data-billing-exempt={current.billing_exempt ? '1' : '0'}
															data-plan-action={planAction}
															data-period-end={current.current_period_end || ''}
														>
															{current.billing_exempt
																? 'Cambiar a este plan'
																: showUpgradeOnly
																	? 'Mejorar a Premium'
																	: current.plan_code === 'FREE' || effState === 'READ_ONLY'
																		? `Renovar con ${plan.name}`
																		: plan.code === 'BASE' && current.plan_code === 'PREMIUM'
																			? `Pasar a ${plan.name}`
																			: `Elegir ${plan.name}`}
														</button>
													) : (
														<button type="button" class="plan-btn plan-btn-current" disabled>Solo el administrador puede cambiarlo</button>
													)}
												</div>
											</article>
											);
										})}
									</div>
									{!current.billing_configured && isAdmin && (
										<p class="m-0 rounded-xl bg-amber-50 px-4 py-3 text-[0.85rem] font-semibold text-amber-700 dark:bg-amber-500/10 dark:text-amber-300">
											La pasarela de pago de suscripción aún no está configurada en este entorno. El checkout se habilitará al cargar las credenciales de Pagopar de la plataforma.
										</p>
									)}
								</section>
								) : null}

								{/* ---- Add-ons de storage ---- */}
								{(catalog.storage_addons.length > 0 || current.active_storage_addons.length > 0) && (
									<section class="grid gap-4" data-storage-section>
										<div class="grid gap-1">
											<h2 class="m-0 text-lg font-bold text-(--on-surface)">Almacenamiento adicional</h2>
											<p class="m-0 text-[0.88rem] font-medium text-(--on-surface-variant)">
												Más espacio para tus archivos. El saldo no usado al cancelar se acredita a tu favor.
												{!current.supports_storage_addons ? ' Disponible con el plan Premium.' : ''}
											</p>
										</div>

										{current.active_storage_addons.length > 0 ? (
											<div class="grid gap-3">
												<span class="text-xs font-bold uppercase tracking-wide text-(--on-surface-variant)">Activos</span>
												{current.active_storage_addons.map((line) => (
													<article class="plan-addon-card">
														<div class="grid gap-1">
															<span class="text-[1.05rem] font-bold text-(--on-surface)">
																{line.name}
																{line.quantity > 1 ? ` ×${line.quantity}` : ''}
															</span>
															<span class="text-[0.85rem] font-semibold text-(--on-surface-variant)">
																{formatGs(line.line_total)} / mes · {formatGb(line.extra_bytes * line.quantity)}
															</span>
															{line.cancel_credit_amount > 0 ? (
																<span class="text-[0.78rem] font-medium text-(--on-surface-variant)">
																	Al cancelar: crédito estimado {formatGs(line.cancel_credit_amount)}
																</span>
															) : null}
														</div>
														{isAdmin && line.cancelable ? (
															<button
																type="button"
																class="plan-btn plan-btn-soft"
																data-addon-cancel
																data-addon-code={line.code}
																data-addon-name={line.name}
																data-addon-credit={String(line.cancel_credit_amount)}
															>
																Cancelar
															</button>
														) : null}
													</article>
												))}
											</div>
										) : null}

										{catalog.storage_addons.length > 0 ? (
										<div class="grid gap-4 sm:grid-cols-2">
											{catalog.storage_addons.map((addon) => {
												const showProrate =
													current.supports_storage_addons &&
													addon.days_remaining > 0 &&
													addon.prorate_amount > 0 &&
													addon.prorate_amount < addon.price_amount;
												return (
												<article class="plan-addon-card">
													<div class="grid gap-1">
														<span class="text-[1.05rem] font-bold text-(--on-surface)">{addon.name}</span>
														<span class="text-[0.85rem] font-semibold text-(--on-surface-variant)">{formatGb(addon.extra_bytes)} extra</span>
														{showProrate ? (
															<span class="text-[0.78rem] font-medium text-(--on-surface-variant)">
																Hoy: {formatGs(addon.prorate_amount)} (proporcional · {addon.days_remaining} día{addon.days_remaining === 1 ? '' : 's'})
															</span>
														) : null}
													</div>
													<div class="flex items-center justify-between gap-3">
														<span class="text-xl font-extrabold text-(--on-surface)">{formatGs(addon.price_amount)}<span class="text-[0.8rem] font-semibold text-(--on-surface-variant)"> /mes</span></span>
														{isAdmin && current.supports_storage_addons && !cancelScheduled ? (
															<button
																type="button"
																class="plan-btn plan-btn-primary plan-btn--auto"
																data-addon-select
																data-addon-code={addon.code}
																data-addon-name={addon.name}
																data-addon-price={String(addon.price_amount)}
																data-addon-prorate={String(addon.prorate_amount)}
																data-addon-days={String(addon.days_remaining)}
															>Contratar</button>
														) : (
															<button type="button" class="plan-btn plan-btn-soft" disabled>
																{cancelScheduled
																	? 'Cancelación programada'
																	: current.supports_storage_addons
																		? 'Solo admin'
																		: 'Solo Premium'}
															</button>
														)}
													</div>
												</article>
												);
											})}
										</div>
										) : null}
									</section>
								)}

								{canDowngradeToBase ? (
									<section class="grid gap-3 rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-4 py-4 sm:px-5">
										<div class="grid gap-1">
											<h2 class="m-0 text-lg font-bold text-(--on-surface)">Cambiar de plan</h2>
											<p class="m-0 text-[0.88rem] font-medium text-(--on-surface-variant)">
												Podés cambiarte al Plan Base en cualquier momento. Se aplicará en tu próximo ciclo de facturación.
											</p>
										</div>
										<div>
											<button type="button" class="plan-btn plan-btn-outline plan-btn--auto" data-downgrade-open>
												Pasar al Plan Base
											</button>
										</div>
									</section>
								) : null}

								{canTerminate ? (
									<section class="grid gap-3 rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-4 py-4 sm:px-5">
										<div class="grid gap-1">
											<h2 class="m-0 text-lg font-bold text-(--on-surface)">Cancelar suscripción</h2>
											<p class="m-0 text-[0.88rem] font-medium text-(--on-surface-variant)">
												Tu cuenta pasará al plan gratuito (solo lectura) al finalizar el ciclo. Se cancelarán tus paquetes extra.
											</p>
										</div>
										<div>
											<button type="button" class="plan-btn plan-btn-danger" data-terminate-sub>
												Cancelar suscripción
											</button>
										</div>
									</section>
								) : null}
								</div>

								{/* ---- Pestaña Facturación ---- */}
								<div data-plan-panel="billing" class:list={['grid', 'gap-6', 'sm:gap-8', activeTab !== 'billing' && 'hidden']}>
									{/* 1. Tarjeta / método de pago (primero) */}
									{showPaymentMethod && (
										<section class="grid gap-4" data-payment-section data-billing-complete={billingProfileComplete ? '1' : '0'}>
											<div class="flex flex-wrap items-center justify-between gap-2">
												<h2 class="m-0 text-lg font-bold text-(--on-surface)">Método de pago</h2>
												<button
													type="button"
													class:list={['plan-billing-view-link', !billingProfileComplete && 'hidden']}
													data-billing-view
													aria-label="Ver y editar datos de facturación"
												>
													<span class="material-symbols-rounded" aria-hidden="true">visibility</span>
													Datos de facturación
												</button>
											</div>

											{/* Grilla multitarjeta + agregar tarjeta (móvil + PC) */}
											<div class="plan-plastic-grid" data-cards-list>
												{cards.map((card) => (
													<article class={`plan-plastic-card plan-plastic-${cardTone(card.brand)} ${card.is_default ? 'plan-plastic-default' : ''}`}>
														<div class="plan-plastic-shine" aria-hidden="true"></div>
														<div class="plan-plastic-top">
															<div class="plan-plastic-chip" aria-hidden="true"></div>
															<span class="plan-plastic-brand">{cardBrandLabel(card.brand)}</span>
														</div>
														<p class="plan-plastic-number">{formatMaskedCard(card.masked_number)}</p>
														<div class="plan-plastic-bottom">
															{card.is_default ? (
																<span class="plan-plastic-default-badge">Predeterminada</span>
															) : (
																<span class="plan-plastic-provider">{card.provider}</span>
															)}
															<button
																type="button"
																class="plan-plastic-del"
																data-card-delete
																data-card-id={String(card.id)}
																aria-label="Eliminar tarjeta"
															>
																<span class="material-symbols-rounded">delete</span>
															</button>
														</div>
													</article>
												))}

												<button
													type="button"
													class:list={['plan-add-card', !billingProfileComplete && 'plan-add-card--billing']}
													data-ghost-card
													aria-label={billingProfileComplete ? 'Agregar tarjeta' : 'Completá tus datos de facturación'}
												>
													<span
														class="material-symbols-rounded plan-add-card-icon"
														data-ghost-icon
														aria-hidden="true"
													>{billingProfileComplete ? 'add' : 'lock'}</span>
													<span class="plan-add-card-label" data-ghost-label>
														{billingProfileComplete ? 'Agregar tarjeta' : 'Completá tus datos de facturación'}
													</span>
													<span
														class:list={['plan-add-card-hint', billingProfileComplete && 'hidden']}
														data-ghost-hint
													>
														Requerido para agregar tarjetas.
													</span>
													<span
														class:list={['plan-add-card-cta', billingProfileComplete && 'hidden']}
														data-ghost-cta
														aria-hidden="true"
													>
														Completar facturación
													</span>
												</button>
											</div>

											<p class="plan-payment-secure plan-payment-secure--solo">
												<span class="material-symbols-rounded" aria-hidden="true">lock</span>
												Pagos 100% seguros vía Pagopar.
											</p>
										</section>
									)}

									{/* 2. Resumen — compacto en mobile */}
									<div class="plan-billing-compact flex md:hidden">
										<p class="plan-billing-compact-text">
											Próximo cargo: <strong>{formatGs(nextChargeEstimate)}</strong>
										</p>
										<button
											type="button"
											class="plan-billing-compact-detail"
											data-billing-detail-open
											aria-label="Ver detalle de facturación"
										>
											<span class="material-symbols-rounded" aria-hidden="true">info</span>
											Ver detalle
										</button>
									</div>

									{/* 2. Resumen — completo en desktop (sin cambios) */}
									<section class="plan-billing-summary hidden md:grid">
										<div class="grid gap-1">
											<h2 class="m-0 text-lg font-bold text-(--on-surface)">Resumen de facturación</h2>
											<p class="m-0 text-[0.88rem] font-medium text-(--on-surface-variant)">
												Próximo cobro y desglose de tu suscripción.
											</p>
										</div>
										<div class="plan-billing-ticket">
											<div class="plan-billing-row">
												<span class="plan-billing-concept">Próxima facturación</span>
												<span class="plan-billing-amount">
													{formatDateEs(billing?.next_billing_at || current.next_billing_at)}
												</span>
											</div>
											<div class="plan-billing-row">
												<span class="plan-billing-concept">
													Plan
													<small>({billing?.plan_name || current.plan_name})</small>
												</span>
												<span class="plan-billing-amount">
													{formatGs(billing?.plan_monthly_amount ?? current.plan_monthly_amount)}
												</span>
											</div>
											<div class="plan-billing-row">
												<span class="plan-billing-concept">Almacenamiento</span>
												<span class="plan-billing-amount">
													{formatGs(billing?.addons_monthly_amount ?? current.addons_monthly_amount)}
												</span>
											</div>
											<div class="plan-billing-row plan-billing-row--credit">
												<span class="plan-billing-concept">Saldo a favor</span>
												<span class="plan-billing-amount">
													{(billing?.account_balance ?? current.account_balance) > 0
														? `− ${formatGs(billing?.account_balance ?? current.account_balance)}`
														: formatGs(billing?.account_balance ?? current.account_balance)}
												</span>
											</div>
											<div class="plan-billing-total">
												<div class="plan-billing-total-copy">
													<span class="plan-billing-total-label">Estimado próximo cargo</span>
													<small>Después de aplicar el saldo a favor</small>
												</div>
												<strong class="plan-billing-total-amount">
													{formatGs(nextChargeEstimate)}
												</strong>
											</div>
										</div>
									</section>

									{/* 3. Datos de facturación — solo si ya hay datos (móvil + PC) */}
									{showPaymentMethod && (
										<section
											class:list={['grid', 'gap-4', !billingProfileComplete && 'hidden']}
											data-billing-profile-section
										>
											<div
												class:list={['plan-billing-profile-collapsed', !billingProfileComplete && 'hidden']}
												data-billing-profile-collapsed
											>
												<div class="plan-billing-profile-collapsed-copy">
													<span class="material-symbols-rounded plan-billing-profile-icon" aria-hidden="true">receipt_long</span>
													<div class="grid gap-0.5 min-w-0">
														<span class="plan-billing-profile-collapsed-title">Datos de facturación registrados</span>
														<span class="plan-billing-profile-collapsed-hint" data-billing-profile-summary>
															{billingProfile?.billing_name || ''} · {billingProfile?.billing_doc_type || 'CI'} {billingProfile?.billing_doc_number || ''}
														</span>
													</div>
												</div>
												<button type="button" class="plan-btn plan-btn-soft plan-billing-profile-edit" data-billing-profile-edit>
													Editar
												</button>
											</div>
										</section>
									)}
								</div>

								{/* ---- Pestaña Historial ---- */}
								<div data-plan-panel="history" class:list={['grid', 'gap-6', 'sm:gap-8', activeTab !== 'history' && 'hidden']}>
									<section class="grid gap-4">
										<div class="grid gap-1">
											<h2 class="m-0 text-lg font-bold text-(--on-surface)">Historial de pagos</h2>
											<p class="m-0 text-[0.88rem] font-medium text-(--on-surface-variant)">
												Cobros exitosos, pendientes y fallidos de tu suscripción.
											</p>
