		<dialog
			data-billing-profile-drawer
			class="plan-billing-profile-drawer m-0 mt-auto mb-0 h-[min(34rem,92svh)] w-screen max-w-none open:flex open:flex-col overflow-hidden rounded-t-[1.8rem] rounded-b-none border border-(--shell-border) bg-(--surface-bright) p-0 text-(--on-surface) shadow-[0_24px_80px_rgba(0,0,0,0.2)] sm:m-auto sm:h-[min(36rem,90vh)] sm:w-[min(32rem,calc(100vw-2rem))] sm:max-w-[min(32rem,calc(100vw-2rem))] sm:rounded-[1.8rem] lg:m-0 lg:ml-auto lg:mr-0 lg:mt-0 lg:mb-0 lg:h-[100dvh] lg:max-h-[100dvh] lg:w-[min(32rem,100%)] lg:max-w-[min(32rem,100%)] lg:rounded-none lg:border-y-0 lg:border-r-0 lg:shadow-none"
			aria-labelledby="plan-billing-profile-drawer-title"
		>
			<header class="flex shrink-0 items-start justify-between gap-3 border-b border-(--shell-border) px-4 py-3 sm:px-5 sm:py-4">
				<div class="flex min-w-0 items-center gap-3">
					<div class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-(--primary-soft) text-(--primary)">
						<span class="material-symbols-rounded text-[1.35rem]" aria-hidden="true">receipt_long</span>
					</div>
					<div class="min-w-0">
						<h2 id="plan-billing-profile-drawer-title" class="text-[1.05rem] font-extrabold tracking-tight text-(--on-surface)">
							Datos de facturación
						</h2>
						<p class="truncate text-[0.82rem] font-medium text-(--on-surface-variant)">
							Requeridos para registrar tu tarjeta
						</p>
					</div>
				</div>
				<button
					type="button"
					class="flex size-10 shrink-0 items-center justify-center rounded-full border border-(--shell-border) text-(--on-surface-variant) transition hover:bg-(--control-surface)"
					data-billing-profile-drawer-close
					aria-label="Cerrar datos de facturación"
				>
					<span class="material-symbols-rounded text-[1.2rem]" aria-hidden="true">close</span>
				</button>
			</header>
			<BillingProfileForm
				variant="drawer"
				billingProfile={billingProfile}
				billingProfileComplete={billingProfileComplete}
			/>
		</dialog>
