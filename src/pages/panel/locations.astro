---
import AppAlert from "../../components/AppAlert.astro";
import LocationsListIsland from "../../components/LocationsListIsland.astro";
import PanelCardsSkeleton from "../../components/PanelCardsSkeleton.astro";
import SideNav from "../../components/SideNav.astro";
import TopBar from "../../components/TopBar.astro";
import { ROLES } from "../../config/roles";
import Layout from "../../layouts/Layout.astro";
import { panelPageTitle } from "../../lib/panel-page-title";
import "../../styles/global.css";

const canManageLocations = Number(Astro.locals.roleId ?? 0) === ROLES.ADMIN;
const rawPage = Number(Astro.url.searchParams.get("page") || "1");
const currentPage = Number.isInteger(rawPage) && rawPage > 0 ? rawPage : 1;

const stadiaMapsKey = String(import.meta.env.PUBLIC_STADIA_MAPS_KEY ?? "");
---

<Layout pageTitle={panelPageTitle('Sucursales')}>
	<location-manager data-stadia-key={stadiaMapsKey} data-can-manage={canManageLocations ? "true" : "false"}>
		<div class="min-h-screen bg-(--page-background)">
			<div
				class="app-shell grid min-h-screen overflow-hidden bg-transparent"
				data-app-shell
				data-sidebar-state="expanded"
			>
				<SideNav currentPath={Astro.url.pathname} />

				<div class="grid min-h-full grid-rows-[auto_1fr]">
					<TopBar />

					<main
						class="px-4 py-4 sm:px-6 sm:py-6"
					>
						<section class="grid gap-4 sm:gap-5">
							<LocationsListIsland
								server:defer
								canManageLocations={canManageLocations}
								currentPage={currentPage}
							>
								<PanelCardsSkeleton
									slot="fallback"
									label="Cargando sucursales"
									cardClass="locations-card"
									bodyClass="locations-card-body"
									place
								/>
							</LocationsListIsland>
						</section>
					</main>
				</div>
			</div>
		</div>

		<dialog
			class="m-0 mt-auto mb-0 w-screen max-w-none max-h-[80vh] open:flex open:flex-col overflow-hidden rounded-t-[1.8rem] rounded-b-none border border-(--shell-border) bg-(--surface-bright) p-0 text-(--on-surface) shadow-[0_24px_80px_rgba(0,0,0,0.2)] sm:m-auto sm:w-[min(48rem,calc(100vw-2rem))] sm:max-w-[min(48rem,calc(100vw-2rem))] sm:max-h-[90vh] sm:rounded-[1.8rem] lg:m-0 lg:ml-auto lg:mr-0 lg:mt-0 lg:mb-0 lg:h-[100dvh] lg:max-h-[100dvh] lg:w-[max(50vw,40rem)] lg:max-w-[max(50vw,40rem)] lg:rounded-none lg:border-y-0 lg:border-r-0 lg:shadow-none"
			data-location-modal
		>
			<div class="panel-modal-header">
				<div class="panel-modal-header__row">
					<div class="panel-modal-header__leading">
						<div class="panel-modal-header__icon">
							<span class="material-symbols-rounded">storefront</span>
						</div>
						<div class="panel-modal-header__text">
							<h2 class="panel-modal-header__title" data-location-modal-title>
								Crear sucursal
							</h2>
						</div>
					</div>
					<button
						type="button"
						class="panel-modal-header__close"
						data-close-location-modal
						aria-label="Cerrar modal"
					>
						<span class="material-symbols-rounded">close</span>
					</button>
				</div>
			</div>

			<form
				class="relative flex min-h-0 flex-1 flex-col overflow-hidden bg-(--surface)/30 shadow-[inset_0_4px_10px_rgba(0,0,0,0.015)]"
				data-location-form
			>
				<div
					class="pointer-events-none fixed inset-0 z-20 hidden items-center justify-center bg-(--surface-bright)/80 backdrop-blur-[2px] transition-all"
					data-location-loading
				>
					<div
						class="inline-flex items-center gap-3 rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-5 py-3.5 text-[0.95rem] font-extrabold text-(--on-surface) shadow-[0_12px_32px_rgba(0,0,0,0.12)]"
					>
						<span
							class="material-symbols-rounded animate-spin text-[1.2rem] text-(--primary)"
							>progress_activity</span
						>
						Procesando...
					</div>
				</div>

				<fieldset data-form-fieldset class="contents">
				<div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-7 py-7 lg:px-6">
				<div class="grid gap-5">
				<div
					class="hidden rounded-2xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-[0.9rem] font-bold text-rose-500 shadow-sm"
					data-form-error
				>
				</div>

				<div class="grid gap-5 sm:grid-cols-2">
					<label
						class="grid gap-1.5 text-[0.95rem] font-bold text-(--on-surface)"
					>
						<span class="inline-flex items-center gap-1">
							Nombre
							<span class="text-rose-500">*</span>
						</span>
						<input
							type="text"
							name="name"
							maxlength="100"
							required
							class="rounded-xl border border-(--shell-border) bg-(--surface-bright) px-4 py-3 text-[0.95rem] outline-none transition hover:border-(--on-surface-variant)/40 focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10"
							placeholder="Ej: Casa Central"
						/>
						<span
							class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400"
							data-field-error="name"></span>
					</label>

					<label
						class="grid gap-1.5 text-[0.95rem] font-bold text-(--on-surface)"
					>
						<span class="inline-flex items-center gap-1">
							Dirección
							<span class="text-rose-500">*</span>
						</span>
						<input
							type="text"
							name="address"
							maxlength="255"
							required
							class="rounded-xl border border-(--shell-border) bg-(--surface-bright) px-4 py-3 text-[0.95rem] outline-none transition hover:border-(--on-surface-variant)/40 focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10"
							placeholder="Ej: Av. Principal 123"
						/>
						<span
							class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400"
							data-field-error="address"></span>
					</label>
				</div>

				<div class="grid gap-5 sm:grid-cols-2">
					<label
						class="grid gap-1.5 text-[0.95rem] font-bold text-(--on-surface)"
					>
						<span class="inline-flex items-center gap-1">
							Departamento
							<span class="text-rose-500">*</span>
						</span>
						<div class="relative">
							<select
								name="dep_id_department"
								required
								data-department-select
								class="w-full appearance-none rounded-xl border border-(--shell-border) bg-(--surface-bright) px-4 py-3 text-[0.95rem] outline-none transition hover:border-(--on-surface-variant)/40 focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10 font-bold text-(--on-surface) cursor-pointer"
							>
								<option value=""
									>Selecciona un departamento</option
								>
							</select>
						</div>
						<span
							class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400"
							data-field-error="dep_id_department"></span>
					</label>

					<label
						class="grid gap-1.5 text-[0.95rem] font-bold text-(--on-surface)"
					>
						<span class="inline-flex items-center gap-1">
							Ciudad
							<span class="text-rose-500">*</span>
						</span>
						<div class="relative">
							<select
								name="cit_id_city"
								required
								disabled
								data-city-select
								class="w-full appearance-none rounded-xl border border-(--shell-border) bg-(--surface-bright) px-4 py-3 text-[0.95rem] outline-none transition hover:border-(--on-surface-variant)/40 focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10 font-bold text-(--on-surface) cursor-pointer disabled:cursor-not-allowed disabled:opacity-70"
							>
								<option value=""
									>Selecciona un departamento primero</option
								>
							</select>
						</div>
						<span
							class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400"
							data-field-error="cit_id_city"></span>
					</label>
				</div>

				<div class="grid gap-2">
					<div class="flex items-center justify-between gap-2">
						<p
							class="text-[0.95rem] font-bold text-(--on-surface)"
						>
							Ubicación en mapa <span
								class="text-(--on-surface-variant) font-medium"
								>(Opcional)</span>
						</p>
						<button
							type="button"
							class="rounded-[0.8rem] border border-(--shell-border) px-3 py-1.5 text-[0.8rem] font-extrabold text-(--on-surface-variant) transition hover:bg-(--surface-variant) disabled:cursor-not-allowed disabled:opacity-60"
							data-clear-location-point
						>
							Limpiar punto
						</button>
					</div>

					<div
						class="location-map-shell relative overflow-hidden rounded-2xl border border-(--shell-border) bg-(--control-surface) shadow-sm"
					>
						<div class="h-65 w-full" data-location-map></div>
						<div
							class="location-map-geoloading pointer-events-none absolute inset-0 z-10 hidden items-center justify-center bg-(--surface-bright)/82 backdrop-blur-[2px]"
							data-location-map-geoloading
							aria-hidden="true"
							aria-live="polite"
						>
							<div
								class="pointer-events-auto inline-flex items-center gap-3 rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-5 py-3.5 text-[0.9rem] font-extrabold text-(--on-surface) shadow-[0_12px_32px_rgba(0,0,0,0.12)]"
							>
								<span
									class="material-symbols-rounded animate-spin text-[1.2rem] text-(--primary)"
									>progress_activity</span
								>
								<span data-location-map-geoloading-label
									>Obteniendo ubicación...</span
								>
							</div>
						</div>
					</div>

					<p
						class="text-[0.85rem] font-medium text-(--on-surface-variant) mt-1"
						data-location-map-status
					>
						Haz clic en el mapa para registrar coordenadas exactas. En móvil, usa dos dedos para mover o hacer zoom.
					</p>

					<input
						type="hidden"
						name="latitude"
						data-location-latitude
					/>
					<input
						type="hidden"
						name="longitude"
						data-location-longitude
					/>
					<span
						class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400"
						data-field-error="latitude"></span>
					<span
						class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400"
						data-field-error="longitude"></span>
				</div>

				<section
					class="location-closures-section"
					data-closures-section
					hidden
				>
					<div class="location-closures-header">
						<div>
							<h3 class="location-closures-title">Días festivos y cierres</h3>
							<p class="location-closures-desc">
								Días en los que esta sucursal permanece cerrada. Se aplica a todos los profesionales.
							</p>
						</div>
						<button
							type="button"
							class="location-closures-add-btn"
							data-add-closure-btn
						>
							<span class="material-symbols-rounded text-[1.05rem]">add</span>
							<span>Añadir cierre</span>
						</button>
					</div>
					<div class="location-closures-list" data-closures-list>
						<p class="location-closures-empty" data-closures-empty>
							No hay cierres cargados para esta sucursal.
						</p>
					</div>
				</section>

				<label
					class="grid gap-1.5 text-[0.95rem] font-bold text-(--on-surface) pt-1"
					data-location-status-wrap
					hidden
				>
					Estado
					<div class="relative">
						<select
							name="is_active"
							class="w-full appearance-none rounded-xl border border-(--shell-border) bg-(--surface-bright) px-4 py-3 text-[0.95rem] outline-none transition hover:border-(--on-surface-variant)/40 focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10 font-bold text-(--on-surface) cursor-pointer"
						>
							<option value="1"
								>Activa (Visible para clientes)</option
							>
							<option value="0"
								>Inactiva (Oculto temporalmente)</option
							>
						</select>
						<span
							class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-(--on-surface-variant)"
						>
							<span class="material-symbols-rounded"
								>expand_more</span
							>
						</span>
					</div>
					<span
						class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400"
						data-field-error="is_active"></span>
				</label>
				</div>
				</div>
				</fieldset>

				<div
					class="z-20 mt-auto shrink-0 border-t border-(--shell-border) bg-(--surface-bright) px-7 py-5 lg:px-6"
				>
					<div class="modal-footer">
						<button
							type="button"
							class="hidden modal-action-danger"
							data-delete-location
							aria-label="Eliminar sucursal"
						>
							<span
								class="material-symbols-rounded mr-1.5 align-[-0.22em] text-[1.15rem]"
								aria-hidden="true"
								>delete</span
							>
							<span class="modal-action-danger__label" data-delete-location-label>Eliminar</span>
						</button>

						<div class="modal-footer-actions">
							<button
								type="button"
								class="modal-action-secondary"
								data-close-location-modal
							>
								Cancelar
							</button>
							<button
								type="submit"
								class="modal-action-primary"
								data-submit-location
							>
								<span
									class="material-symbols-rounded text-[1.2rem]"
									data-submit-location-icon
									aria-hidden="true">check</span
								>
								<span data-submit-location-label
									>Crear sucursal</span
								>
							</button>
						</div>
					</div>
				</div>
			</form>
		</dialog>

		<dialog class="closures-org-dialog" data-org-closures-dialog>
			<div class="panel-modal-header closures-org-dialog__header">
				<div class="panel-modal-header__row">
					<div class="panel-modal-header__leading">
						<div class="panel-modal-header__icon">
							<span class="material-symbols-rounded">event_busy</span>
						</div>
						<div class="panel-modal-header__text" data-org-closures-tour-intro>
							<h2 class="panel-modal-header__title closures-org-dialog__title">Cierres generales</h2>
							<p class="panel-modal-header__subtitle closures-org-dialog__desc">
								Feriados o cierres que aplican a todas las sucursales activas.
							</p>
						</div>
					</div>
					<div class="panel-modal-header__actions">
						<button
							type="button"
							class="schedule-exceptions-help inline-flex shrink-0 items-center gap-1.5 rounded-full border border-(--shell-border) bg-(--surface-bright) px-3 py-2 text-[0.82rem] font-bold text-(--on-surface-variant) transition hover:border-(--primary)/35 hover:text-(--primary) focus:outline-none focus:ring-2 focus:ring-(--primary)/25"
							data-org-closures-tour-help
							aria-label="Guía de cierres generales"
						>
							<span class="material-symbols-rounded text-[1.1rem]">help</span>
							<span class="hidden sm:inline">Guía</span>
						</button>
						<button
							type="button"
							class="panel-modal-header__close closures-org-dialog__close"
							data-close-org-closures
							aria-label="Cerrar"
						>
							<span class="material-symbols-rounded">close</span>
						</button>
					</div>
				</div>
			</div>
			<div class="closures-org-dialog__body">
				<button
					type="button"
					class="location-closures-add-btn location-closures-add-btn--wide"
					data-add-org-closure-btn
				>
					<span class="material-symbols-rounded text-[1.05rem]">add</span>
					<span>Nuevo cierre general</span>
				</button>
				<div class="closures-org-dialog__list" data-org-closures-list>
					<p class="location-closures-empty" data-org-closures-empty>
						No hay cierres generales cargados.
					</p>
				</div>
			</div>
		</dialog>

		<dialog class="closure-form-dialog" data-closure-form-dialog>
			<form class="closure-form" data-closure-form>
				<div class="panel-modal-header">
					<div class="panel-modal-header__row">
						<div class="panel-modal-header__text">
							<h2 class="panel-modal-header__title" data-closure-form-title>Añadir cierre</h2>
						</div>
						<button
							type="button"
							class="panel-modal-header__close"
							data-close-closure-form
							aria-label="Cerrar"
						>
							<span class="material-symbols-rounded">close</span>
						</button>
					</div>
				</div>

				<div class="closure-form__body">
					<div
						class="closure-form__error"
						data-closure-form-error
						hidden
					></div>

					<label class="closure-form__label">
						<span class="closure-form__label-text">
							Nombre / Motivo
							<span class="text-rose-500">*</span>
						</span>
						<div class="closure-motive-lov" data-closure-motive-lov>
							<input type="hidden" name="id_holiday" data-closure-holiday-id />
							<input
								type="text"
								name="name"
								required
								autocomplete="off"
								placeholder="Buscar feriado o escribir un motivo"
								class="closure-form__input closure-motive-lov__input"
								data-closure-name
							/>
							<button
								type="button"
								class="closure-motive-lov__clear hidden"
								data-closure-motive-clear
								aria-label="Limpiar motivo"
							>
								<span class="material-symbols-rounded text-[1.1rem]" aria-hidden="true">close</span>
							</button>
							<div class="closure-motive-lov__results hidden" data-closure-motive-results></div>
						</div>
					</label>

					<div class="closure-form__row">
						<label class="closure-form__label">
							<span class="closure-form__label-text">
								Fecha inicio
								<span class="text-rose-500">*</span>
							</span>
							<input
								type="date"
								name="start_date"
								required
								class="closure-form__input"
								data-closure-start-date
							/>
						</label>
						<label class="closure-form__label">
							<span class="closure-form__label-text">
								Fecha fin
								<span class="text-rose-500">*</span>
							</span>
							<input
								type="date"
								name="end_date"
								required
								class="closure-form__input"
								data-closure-end-date
							/>
						</label>
					</div>

					<label class="closure-form__checkbox">
						<input
							type="checkbox"
							name="is_full_day"
							checked
							data-closure-full-day
						/>
						<span>Día completo</span>
					</label>

					<div class="closure-form__row" data-closure-partial-row hidden>
						<label class="closure-form__label">
							Hora inicio
							<input
								type="time"
								name="start_time"
								class="closure-form__input"
								data-closure-start-time
							/>
						</label>
						<label class="closure-form__label">
							Hora fin
							<input
								type="time"
								name="end_time"
								class="closure-form__input"
								data-closure-end-time
							/>
						</label>
					</div>

					<div class="closure-form__scope" data-closure-scope-wrap>
						<label class="closure-form__checkbox">
							<input
								type="checkbox"
								name="apply_all_locations"
								data-closure-apply-all
							/>
							<span>Aplicar a todas las sucursales</span>
						</label>
						<label class="closure-form__label" data-closure-locations-wrap>
							<span class="closure-form__label-text">Sucursales</span>
							<select
								name="location_ids"
								multiple
								class="w-full"
								data-closure-locations
							></select>
						</label>
					</div>
				</div>

				<div class="closure-form__footer">
					<button
						type="button"
						class="modal-action-secondary"
						data-close-closure-form
					>
						Cancelar
					</button>
					<button
						type="submit"
						class="modal-action-primary"
						data-submit-closure
					>
						<span class="material-symbols-rounded text-[1.2rem]" aria-hidden="true">save</span>
						<span>Guardar cierre</span>
					</button>
				</div>
			</form>
		</dialog>
	</location-manager>

	<AppAlert />
</Layout>

<script>
	import { reloadPageWithFlash } from "../../lib/flash";
	import { openPanelModal } from "../../lib/panel-scroll-lock";
	import { getBrowserGeolocation } from "../../lib/geolocation-browser";
	import { initLocationClosuresUI } from "../../scripts/location-closures-ui";
	import {
		createBrandMarker,
		getStadiaStyleUrl,
		loadMapLibre,
		resolveMapTheme,
		type MapLibreModule,
		type MapTheme,
	} from "../../lib/maplibre-interactive";
	import {
		destroySearchableSelect,
		rebuildSearchableSelect,
		setSearchableSelectDisabled,
	} from "../../scripts/searchable-select";

	type LocationMode = "create" | "edit";
	type Coordinates = { lat: number; lng: number };
	type MapLibreMap = InstanceType<MapLibreModule["Map"]>;
	type MapLibreMarker = InstanceType<MapLibreModule["Marker"]>;
	type DepartmentOption = { id_department: number; description?: string };
	type CityOption = { id_city: number; description?: string };

	type LocationSubmitPayload = {
		name: string;
		address: string;
		cit_id_city: number;
		dep_id_department: number;
		is_active: 0 | 1;
		latitude?: number;
		longitude?: number;
	};

	type SelectOptionsConfig<T> = {
		placeholder: string;
		selectedValue?: string | number | null;
		getValue: (item: T) => string | number;
		getLabel: (item: T) => string;
	};

	class LocationManager extends HTMLElement {
		private get canManage() {
			return this.dataset.canManage === "true";
		}

		private abortController: AbortController | null = null;
		private closeTimer: number | null = null;
		private themeObserver: MutationObserver | null = null;
		private mode: LocationMode = "create";
		private editingLocationId = 0;
		private locationReadRequestSeq = 0;
		private citiesRequestSeq = 0;
		private geolocationRequestSeq = 0;

		private departmentsLoaded = false;
		private departmentsCache: DepartmentOption[] = [];
		private departmentsLoadPromise: Promise<void> | null = null;
		private citiesByDepartment = new Map<number, CityOption[]>();

		private stadiaKey = "";
		private defaultMapCenter: Coordinates = {
			lat: -25.28646,
			lng: -57.647,
		};
		private readonly mapIdleMessage =
			"Haz clic en el mapa para registrar coordenadas exactas. En móvil, usa dos dedos para mover o hacer zoom.";
		private selectedCoordinates: Coordinates | null = null;
		private mapLibre: MapLibreModule | null = null;
		private mapInstance: MapLibreMap | null = null;
		private mapMarker: MapLibreMarker | null = null;
		private mapCurrentTheme: MapTheme = "dark";

		private els!: {
			modal: HTMLDialogElement | null;
			form: HTMLFormElement | null;
			fieldset: HTMLFieldSetElement | null;
			submitBtn: HTMLButtonElement | null;
			submitLabel: HTMLElement | null;
			submitIcon: HTMLElement | null;
			deleteBtn: HTMLButtonElement | null;
			errorBox: HTMLElement | null;
			loading: HTMLElement | null;
			modalTitle: HTMLElement | null;
			modalDesc: HTMLElement | null;
			mapContainer: HTMLElement | null;
			mapGeolocationLoading: HTMLElement | null;
			mapStatus: HTMLElement | null;
			clearMapBtn: HTMLButtonElement | null;
			statusWrap: HTMLElement | null;
		};

		private formEls!: {
			name: HTMLInputElement | null;
			address: HTMLInputElement | null;
			department: HTMLSelectElement | null;
			city: HTMLSelectElement | null;
			latitude: HTMLInputElement | null;
			longitude: HTMLInputElement | null;
			status: HTMLSelectElement | null;
			fieldErrors: NodeListOf<HTMLElement>;
		};

		connectedCallback() {
			if (this.abortController) return;
			this.abortController = new AbortController();
			const { signal } = this.abortController;

			this.els = {
				modal: this.querySelector<HTMLDialogElement>(
					"[data-location-modal]",
				),
				form: this.querySelector<HTMLFormElement>(
					"[data-location-form]",
				),
				fieldset: this.querySelector<HTMLFieldSetElement>(
					"[data-form-fieldset]",
				),
				submitBtn: this.querySelector<HTMLButtonElement>(
					"[data-submit-location]",
				),
				submitLabel: this.querySelector<HTMLElement>(
					"[data-submit-location-label]",
				),
				submitIcon: this.querySelector<HTMLElement>(
					"[data-submit-location-icon]",
				),
				deleteBtn: this.querySelector<HTMLButtonElement>(
					"[data-delete-location]",
				),
				errorBox: this.querySelector<HTMLElement>("[data-form-error]"),
				loading: this.querySelector<HTMLElement>(
					"[data-location-loading]",
				),
				modalTitle: this.querySelector<HTMLElement>(
					"[data-location-modal-title]",
				),
				modalDesc: this.querySelector<HTMLElement>(
					"[data-location-modal-description]",
				),
				mapContainer: this.querySelector<HTMLElement>(
					"[data-location-map]",
				),
				mapGeolocationLoading: this.querySelector<HTMLElement>(
					"[data-location-map-geoloading]",
				),
				mapStatus: this.querySelector<HTMLElement>(
					"[data-location-map-status]",
				),
				clearMapBtn: this.querySelector<HTMLButtonElement>(
					"[data-clear-location-point]",
				),
				statusWrap: this.querySelector<HTMLElement>(
					"[data-location-status-wrap]",
				),
			};

			this.formEls = {
				name:
					this.els.form?.querySelector<HTMLInputElement>(
						'[name="name"]',
					) ?? null,
				address:
					this.els.form?.querySelector<HTMLInputElement>(
						'[name="address"]',
					) ?? null,
				department:
					this.els.form?.querySelector<HTMLSelectElement>(
						"[data-department-select]",
					) ?? null,
				city:
					this.els.form?.querySelector<HTMLSelectElement>(
						"[data-city-select]",
					) ?? null,
				latitude:
					this.els.form?.querySelector<HTMLInputElement>(
						"[data-location-latitude]",
					) ?? null,
				longitude:
					this.els.form?.querySelector<HTMLInputElement>(
						"[data-location-longitude]",
					) ?? null,
				status:
					this.els.form?.querySelector<HTMLSelectElement>(
						'[name="is_active"]',
					) ?? null,
				fieldErrors:
					this.querySelectorAll<HTMLElement>("[data-field-error]"),
			};

			this.stadiaKey = String(this.dataset.stadiaKey || "").trim();

			this.addEventListener("click", this.handleRootClick, { signal });
			this.addEventListener("keydown", this.handleRootKeydown, {
				signal,
			});
			this.els.form?.addEventListener("submit", this.handleSubmit, {
				signal,
			});

			if (this.formEls.department) {
				this.formEls.department.addEventListener(
					"change",
					this.handleDepartmentChange,
					{ signal },
				);
			}
			if (this.els.clearMapBtn) {
				this.els.clearMapBtn.addEventListener(
					"click",
					this.handleClearMapPoint,
					{ signal },
				);
			}

			this.themeObserver = new MutationObserver(() => {
				this.syncMapTheme();
			});
			this.themeObserver.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["data-theme"],
			});

			document.addEventListener(
				"visibilitychange",
				this.handleVisibilityChange,
				{ signal },
			);
			window.addEventListener("pagehide", this.handlePageHide, { signal });
		}

		disconnectedCallback() {
			this.abortController?.abort();
			this.abortController = null;
			this.themeObserver?.disconnect();
			this.themeObserver = null;
			destroySearchableSelect(this.formEls?.department);
			destroySearchableSelect(this.formEls?.city);
			if (this.closeTimer) window.clearTimeout(this.closeTimer);
			this.destroyMapInstance();
		}

		private handleVisibilityChange = () => {
			if (document.hidden) {
				this.freezeMapForBackground();
				return;
			}
			this.unfreezeMapFromBackground();
		};

		private handlePageHide = () => {
			this.freezeMapForBackground();
		};

		/** Detiene interacciones cuando la pestaña queda en segundo plano. */
		private freezeMapForBackground = () => {
			if (!this.mapInstance) return;
			try {
				this.mapInstance.dragPan.disable();
				this.mapInstance.scrollZoom.disable();
				this.mapInstance.doubleClickZoom.disable();
				this.mapInstance.touchZoomRotate.disable();
			} catch {
				this.destroyMapInstance();
			}
		};

		private unfreezeMapFromBackground = () => {
			if (!this.mapInstance) return;
			if (!this.els.modal?.open) {
				this.destroyMapInstance();
				return;
			}
			try {
				this.mapInstance.dragPan.enable();
				this.mapInstance.scrollZoom.enable();
				this.mapInstance.doubleClickZoom.enable();
				this.mapInstance.touchZoomRotate.enable();
			} catch {
				// ignore
			}
		};

		private destroyMapInstance = () => {
			try {
				this.mapMarker?.remove();
			} catch {
				// ignore
			}
			this.mapMarker = null;

			try {
				this.mapInstance?.remove();
			} catch {
				// ignore
			}
			this.mapInstance = null;

			if (this.els?.mapContainer) {
				this.els.mapContainer.replaceChildren();
			}
		};

		private syncMapTheme = () => {
			if (!this.mapInstance) return;
			const nextTheme = resolveMapTheme();
			if (nextTheme === this.mapCurrentTheme) return;
			this.mapCurrentTheme = nextTheme;
			try {
				this.mapInstance.setStyle(
					getStadiaStyleUrl(nextTheme, this.stadiaKey),
				);
				// El pin es DOM overlay; re-sincronizar tras recrear el canvas.
				this.mapInstance.once("idle", () => {
					this.syncMapMarker();
				});
			} catch {
				// ignore
			}
		};

		private handleRootClick = (event: MouseEvent) => {
			const target = event.target as HTMLElement;

			if (target === this.els.modal) {
				this.closeModal();
				return;
			}

			const openBtn = target.closest("[data-open-location-modal]");
			if (openBtn && this.canManage) {
				void this.openCreateModal();
				return;
			}

			const closeBtn = target.closest("[data-close-location-modal]");
			if (closeBtn) {
				this.closeModal();
				return;
			}

			const deleteBtn = target.closest("[data-delete-location]");
			if (deleteBtn) {
				void this.handleDelete();
				return;
			}

			const card = target.closest("[data-location-card]");
			if (card && this.canManage) {
				const locationId = Number(
					card.getAttribute("data-location-id") || "0",
				);
				if (locationId > 0) void this.openEditModal(locationId);
			}
		};

		private handleRootKeydown = (event: KeyboardEvent) => {
			if (event.key !== "Enter" && event.key !== " ") return;
			const target = event.target as HTMLElement;
			const card = target.closest("[data-location-card]");
			if (card && this.canManage) {
				event.preventDefault();
				const locationId = Number(
					card.getAttribute("data-location-id") || "0",
				);
				if (locationId > 0) void this.openEditModal(locationId);
			}
		};

		private handleClearMapPoint = () => {
			this.setSelectedCoordinates(null, null);
		};

		private handleDepartmentChange = async () => {
			if (!this.formEls.department) return;
			const selectedDepartmentId = Number(
				this.formEls.department.value || "0",
			);

			const departmentErrorNode = this.querySelector(
				'[data-field-error="dep_id_department"]',
			);
			const cityErrorNode = this.querySelector(
				'[data-field-error="cit_id_city"]',
			);

			if (departmentErrorNode) {
				departmentErrorNode.textContent = "";
				departmentErrorNode.classList.add("hidden");
			}
			if (cityErrorNode) {
				cityErrorNode.textContent = "";
				cityErrorNode.classList.add("hidden");
			}

			await this.loadCitiesByDepartment(selectedDepartmentId, {
				selectedCityId: 0,
				showErrors: true,
			});
		};

		private setMapGeolocationLoading = (isLoading: boolean) => {
			const overlay = this.els.mapGeolocationLoading;
			if (!overlay) return;
			overlay.classList.toggle("hidden", !isLoading);
			overlay.classList.toggle("flex", isLoading);
			overlay.setAttribute("aria-hidden", isLoading ? "false" : "true");
			if (this.els.mapContainer) {
				this.els.mapContainer.style.pointerEvents = isLoading
					? "none"
					: "auto";
			}
		};

		private getGeolocationPermissionState = async (): Promise<
			"granted" | "denied" | "prompt" | "unknown"
		> => {
			if (
				typeof navigator === "undefined" ||
				!("geolocation" in navigator)
			) {
				return "unknown";
			}
			if (!navigator.permissions?.query) return "unknown";

			try {
				const status = await navigator.permissions.query({
					name: "geolocation",
				});
				if (status.state === "granted") return "granted";
				if (status.state === "denied") return "denied";
				return "prompt";
			} catch {
				return "unknown";
			}
		};

		private setMapStatus = (message: string, isError = false) => {
			if (!this.els.mapStatus) return;
			this.els.mapStatus.textContent = message;
			this.els.mapStatus.classList.toggle("hidden", message.trim() === "");
			if (isError) {
				this.els.mapStatus.classList.add(
					"text-rose-600",
					"dark:text-rose-300",
				);
			} else {
				this.els.mapStatus.classList.remove(
					"text-rose-600",
					"dark:text-rose-300",
				);
			}
		};

		private setSelectedCoordinates = (
			latitude: number | null,
			longitude: number | null,
			options: { center?: boolean; zoom?: number } = {},
		) => {
			const hasCoordinates =
				Number.isFinite(latitude) && Number.isFinite(longitude);

			if (!hasCoordinates) {
				this.selectedCoordinates = null;
				if (this.formEls.latitude) this.formEls.latitude.value = "";
				if (this.formEls.longitude) this.formEls.longitude.value = "";
				this.setMapStatus(this.mapIdleMessage);
				if (this.mapMarker) this.mapMarker.remove();
				this.mapMarker = null;
				return;
			}

			const coords: Coordinates = {
				lat: Number(latitude),
				lng: Number(longitude),
			};
			this.selectedCoordinates = coords;
			if (this.formEls.latitude)
				this.formEls.latitude.value = coords.lat.toFixed(6);
			if (this.formEls.longitude)
				this.formEls.longitude.value = coords.lng.toFixed(6);
			this.setMapStatus("");

			if (!this.mapInstance || !this.mapLibre) return;
			this.syncMapMarker(coords);

			if (options.center !== false) {
				this.mapInstance.easeTo({
					center: [coords.lng, coords.lat],
					zoom: options.zoom ?? 15,
					duration: 220,
				});
			}
		};

		/** Crea o reposiciona el pin (sin recrear en cada frame/resize). */
		private syncMapMarker = (coords?: Coordinates | null) => {
			const point = coords ?? this.selectedCoordinates;
			if (!this.mapInstance || !this.mapLibre || !point) return;

			if (!this.mapMarker) {
				this.mapMarker = createBrandMarker(this.mapLibre, point, {
					color: "#FB7185",
					title: "Ubicación de la sucursal",
				}).addTo(this.mapInstance);
				return;
			}

			this.mapMarker.setLngLat([point.lng, point.lat]);
			if (!this.mapMarker.getElement().isConnected) {
				this.mapMarker.addTo(this.mapInstance);
			}
		};

		private layoutMapContainer = () => {
			if (!this.mapInstance) return;
			try {
				this.mapInstance.resize();
			} catch {
				// ignore
			}
		};

		private focusMapOnCoordinates = (zoom = 15) => {
			if (!this.mapInstance || !this.selectedCoordinates) return;
			this.mapInstance.easeTo({
				center: [
					this.selectedCoordinates.lng,
					this.selectedCoordinates.lat,
				],
				zoom,
				duration: 0,
			});
			this.syncMapMarker(this.selectedCoordinates);
		};

		private layoutMapViewport = () => {
			this.layoutMapContainer();
			if (!this.mapInstance) return;
			if (this.selectedCoordinates) {
				this.focusMapOnCoordinates(15);
				return;
			}
			this.mapInstance.setCenter([
				this.defaultMapCenter.lng,
				this.defaultMapCenter.lat,
			]);
			this.mapInstance.setZoom(12);
		};

		private ensureMapReady = async () => {
			if (!this.els.mapContainer) return;

			if (!this.stadiaKey) {
				throw new Error(
					"No se encontró la API key de Stadia Maps para el mapa de sucursales.",
				);
			}

			if (!this.mapLibre) {
				this.mapLibre = await loadMapLibre();
			}
			const maplibregl = this.mapLibre;

			if (!this.mapInstance) {
				const isCoarsePointer = window.matchMedia(
					"(pointer: coarse)",
				).matches;
				this.mapCurrentTheme = resolveMapTheme();
				this.mapInstance = new maplibregl.Map({
					container: this.els.mapContainer,
					style: getStadiaStyleUrl(
						this.mapCurrentTheme,
						this.stadiaKey,
					),
					center: [
						this.defaultMapCenter.lng,
						this.defaultMapCenter.lat,
					],
					zoom: 12,
					attributionControl: { compact: true },
					cooperativeGestures: isCoarsePointer,
				});

				this.mapInstance.addControl(
					new maplibregl.NavigationControl({ showCompass: false }),
					"top-right",
				);

				this.mapInstance.on("click", (event) => {
					const { lat, lng } = event.lngLat;
					if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
					this.setSelectedCoordinates(lat, lng, { center: false });
				});

				this.mapInstance.once("load", () => {
					this.layoutMapContainer();
					if (this.selectedCoordinates) {
						this.focusMapOnCoordinates(15);
					}
				});
			}

			// El dialog anima al abrir: solo redimensionar; no recentrar si viene geolocalización.
			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					this.layoutMapContainer();
					window.setTimeout(() => {
						this.layoutMapContainer();
						if (this.selectedCoordinates) {
							this.focusMapOnCoordinates(15);
						}
					}, 120);
				});
			});

			if (this.selectedCoordinates) {
				this.setSelectedCoordinates(
					this.selectedCoordinates.lat,
					this.selectedCoordinates.lng,
					{ center: true, zoom: 15 },
				);
				return;
			}

			this.setMapStatus(this.mapIdleMessage);
		};

		private getSelectSearchPlaceholder = (
			selectNode: HTMLSelectElement | null | undefined,
		) => {
			if (selectNode === this.formEls.department) {
				return "Buscar departamento...";
			}
			if (selectNode === this.formEls.city) {
				return "Buscar ciudad...";
			}
			return "Buscar...";
		};

		private setSelectOptions = <T,>(
			selectNode: HTMLSelectElement | null | undefined,
			items: T[],
			config: SelectOptionsConfig<T>,
		) => {
			if (!selectNode) return;

			const options = [
				{ value: "", label: config.placeholder },
				...items.map((item) => ({
					value: String(config.getValue(item)),
					label: config.getLabel(item),
				})),
			];

			const hasSelectedValue =
				config.selectedValue !== undefined &&
				config.selectedValue !== null &&
				String(config.selectedValue).trim() !== "";

			rebuildSearchableSelect(
				selectNode,
				options,
				{ placeholder: this.getSelectSearchPlaceholder(selectNode) },
				hasSelectedValue ? String(config.selectedValue) : "",
			);
		};

		private async requestApi<T = any>(url: string, options: RequestInit, fallbackError: string): Promise<any> {
			const response = await fetch(url, {
				credentials: "same-origin",
				cache: "no-store",
				...options,
			});
			let data = null;
			try { data = await response.json(); } catch { throw new Error("Error al interpretar respuesta del servidor."); }
			if (!response.ok || !data || data.status !== "success") {
				const error = new Error(data?.message || fallbackError);
				(error as any).apiData = data; 
				throw error;
			}
			return data;
		}

		private fetchCatalogResource = async <T = unknown,>(
			url: string,
		): Promise<T[]> => {
			const data = await this.requestApi(url, {
				method: "GET",
				headers: { Accept: "application/json" },
			}, "No fue posible cargar catálogos.");
			return data.data as T[];
		};

		private applyDepartmentsToSelect = (
			departments: DepartmentOption[],
			selectedValue: string | number | "" = "",
		) => {
			this.setSelectOptions(this.formEls.department, departments, {
				placeholder: "Selecciona un departamento",
				selectedValue,
				getValue: (item) => item.id_department,
				getLabel: (item) =>
					item.description || `Departamento #${item.id_department}`,
			});
		};

		private ensureDepartmentsLoaded = async () => {
			if (this.departmentsLoadPromise) return this.departmentsLoadPromise;

			if (this.departmentsLoaded && this.departmentsCache.length > 0) {
				this.applyDepartmentsToSelect(this.departmentsCache);
				return;
			}

			this.setSelectOptions(this.formEls.department, [], {
				placeholder: "Cargando departamentos...",
				getValue: (i: DepartmentOption) => i.id_department,
				getLabel: (i: DepartmentOption) => i.description ?? "",
			});
			setSearchableSelectDisabled(this.formEls.department, true);

			this.departmentsLoadPromise = (async () => {
				const departments =
					await this.fetchCatalogResource<DepartmentOption>(
						"/api/catalog/departments",
					);
				this.departmentsCache = departments;
				this.departmentsLoaded = true;
				this.applyDepartmentsToSelect(departments);
			})()
				.catch((error) => {
					this.setSelectOptions(this.formEls.department, [], {
						placeholder: "No fue posible cargar departamentos",
						getValue: (i: any) => i.id_department,
						getLabel: (i: any) => i.description,
					});
					throw error;
				})
				.finally(() => {
					this.departmentsLoadPromise = null;
					setSearchableSelectDisabled(this.formEls.department, false);
				});

			return this.departmentsLoadPromise;
		};

		private loadCitiesByDepartment = async (
			departmentId: number,
			options: { selectedCityId?: number; showErrors?: boolean } = {
				selectedCityId: 0,
				showErrors: true,
			},
		) => {
			const citySelect = this.formEls.city;
			if (!citySelect) return;

			const selectedCityId = Number(options?.selectedCityId || 0);

			if (!Number.isInteger(departmentId) || departmentId <= 0) {
				setSearchableSelectDisabled(citySelect, true);
				this.setSelectOptions(citySelect, [], {
					placeholder: "Selecciona un departamento primero",
					getValue: (i: any) => i.id_city,
					getLabel: (i: any) => i.description,
				});
				return;
			}

			const cachedCities = this.citiesByDepartment.get(departmentId);
			if (Array.isArray(cachedCities)) {
				setSearchableSelectDisabled(citySelect, cachedCities.length === 0);
				this.setSelectOptions(citySelect, cachedCities, {
					placeholder:
						cachedCities.length > 0
							? "Selecciona una ciudad"
							: "Sin ciudades disponibles",
					selectedValue: selectedCityId > 0 ? selectedCityId : "",
					getValue: (item: CityOption) => item.id_city,
					getLabel: (item: CityOption) =>
						item.description || `Ciudad #${item.id_city}`,
				});
				citySelect.removeAttribute("data-loading");
				return;
			}

			const requestId = ++this.citiesRequestSeq;
			setSearchableSelectDisabled(citySelect, true);
			citySelect.setAttribute("data-loading", "true");
			this.setSelectOptions(citySelect, [], {
				placeholder: "Cargando ciudades...",
				getValue: (i: any) => i.id_city,
				getLabel: (i: any) => i.description,
			});

			try {
				const cities = await this.fetchCatalogResource<CityOption>(
					`/api/catalog/departments/${departmentId}/cities`,
				);
				if (requestId !== this.citiesRequestSeq) return;

				this.citiesByDepartment.set(departmentId, cities);
				setSearchableSelectDisabled(citySelect, cities.length === 0);
				this.setSelectOptions(citySelect, cities, {
					placeholder:
						cities.length > 0
							? "Selecciona una ciudad"
							: "Sin ciudades disponibles",
					selectedValue: selectedCityId > 0 ? selectedCityId : "",
					getValue: (item: CityOption) => item.id_city,
					getLabel: (item: CityOption) =>
						item.description || `Ciudad #${item.id_city}`,
				});
			} catch (error) {
				if (requestId !== this.citiesRequestSeq) return;
				setSearchableSelectDisabled(citySelect, true);
				this.setSelectOptions(citySelect, [], {
					placeholder: "No fue posible cargar ciudades",
					getValue: (i: any) => i.id_city,
					getLabel: (i: any) => i.description,
				});
				if (options?.showErrors !== false) {
					this.showFormError(
						error instanceof Error
							? error.message
							: "No fue posible cargar las ciudades del departamento.",
					);
				}
			} finally {
				citySelect.removeAttribute("data-loading");
			}
		};

		private clearErrors = () => {
			if (this.els.errorBox) {
				this.els.errorBox.textContent = "";
				this.els.errorBox.classList.add("hidden");
			}
			for (const node of this.formEls.fieldErrors) {
				node.textContent = "";
				node.classList.add("hidden");
			}
		};

		private showFormError = (message: string) => {
			if (!this.els.errorBox) return;
			this.els.errorBox.textContent = message;
			this.els.errorBox.classList.remove("hidden");
		};

		private setFormLoadingState = (isLoading: boolean) => {
			if (this.els.loading) {
				if (isLoading) {
					this.els.loading.classList.remove("hidden");
					this.els.loading.classList.add("flex");
				} else {
					this.els.loading.classList.remove("flex");
					this.els.loading.classList.add("hidden");
				}
			}

			if (this.els.fieldset) {
				this.els.fieldset.disabled = isLoading;
			}
			if (this.els.clearMapBtn) this.els.clearMapBtn.disabled = isLoading;
			if (this.els.mapContainer)
				this.els.mapContainer.style.pointerEvents = isLoading
					? "none"
					: "auto";
		};

		private setLoadingMode = (label = "Procesando...") => {
			if (this.els.submitBtn) this.els.submitBtn.disabled = true;
			if (this.els.deleteBtn && this.mode === "edit")
				this.els.deleteBtn.disabled = true;
			if (this.els.submitLabel) this.els.submitLabel.textContent = label;
			if (this.els.submitIcon)
				this.els.submitIcon.textContent = "hourglass_top";
		};

		private restoreButtons = () => {
			if (this.els.submitBtn) this.els.submitBtn.disabled = false;
			if (this.mode === "create") {
				if (this.els.submitLabel)
					this.els.submitLabel.textContent = "Crear sucursal";
				if (this.els.submitIcon)
					this.els.submitIcon.textContent = "check";
				return;
			}
			if (this.els.submitLabel)
				this.els.submitLabel.textContent = "Guardar cambios";
			if (this.els.submitIcon) this.els.submitIcon.textContent = "save";
			if (this.els.deleteBtn) this.els.deleteBtn.disabled = false;
		};

		private resetModalScroll = () => {
			if (this.els.form) this.els.form.scrollTop = 0;
		};

		private openModalShell = () => {
			this.els.modal?.classList.remove("is-closing");
			if (this.closeTimer) {
				window.clearTimeout(this.closeTimer);
				this.closeTimer = null;
			}
			if (this.els.modal && !this.els.modal.open) openPanelModal(this.els.modal);
			this.resetModalScroll();
		};

		private closeModal = () => {
			if (!this.els.modal?.open) return;
			this.dispatchEvent(
				new CustomEvent("location-modal:closed", { bubbles: true }),
			);
			this.locationReadRequestSeq += 1;
			this.citiesRequestSeq += 1;
			this.geolocationRequestSeq += 1;
			this.setMapGeolocationLoading(false);
			this.els.modal.classList.add("is-closing");

			this.closeTimer = window.setTimeout(() => {
				this.els.modal?.close();
				this.els.modal?.classList.remove("is-closing");
				this.els.form?.reset();
				destroySearchableSelect(this.formEls?.department);
				destroySearchableSelect(this.formEls?.city);
				this.destroyMapInstance();
				this.setCreateMode();
				this.setFormLoadingState(false);
				this.clearErrors();
				this.closeTimer = null;
			}, 140);
		};

		private resetFormValues = () => {
			if (this.formEls.name) this.formEls.name.value = "";
			if (this.formEls.address) this.formEls.address.value = "";
			destroySearchableSelect(this.formEls.department);
			destroySearchableSelect(this.formEls.city);
			if (this.formEls.department) {
				this.formEls.department.disabled = false;
			}
			if (this.formEls.city) {
				this.formEls.city.disabled = true;
				this.setSelectOptions(this.formEls.city, [], {
					placeholder: "Selecciona un departamento primero",
					getValue: (i: CityOption) => i.id_city,
					getLabel: (i: CityOption) => i.description ?? "",
				});
			}
			this.setSelectedCoordinates(null, null);
			if (this.formEls.status) this.formEls.status.value = "1";
		};

		private setCreateMode = () => {
			this.mode = "create";
			this.editingLocationId = 0;
			if (this.els.modalTitle)
				this.els.modalTitle.textContent = "Crear sucursal";
			if (this.els.modalDesc)
				this.els.modalDesc.textContent =
					"Completa los campos para registrar una nueva sucursal.";
			if (this.els.submitLabel)
				this.els.submitLabel.textContent = "Crear sucursal";
			if (this.els.submitIcon) this.els.submitIcon.textContent = "check";
			this.els.deleteBtn?.classList.add("hidden");
			this.els.deleteBtn?.setAttribute("disabled", "true");
			this.els.statusWrap?.setAttribute("hidden", "");
			if (this.formEls.status) {
				this.formEls.status.value = "1";
				this.formEls.status.disabled = true;
			}
			if (this.els.loading) this.els.loading.classList.add("hidden");
		};

		private setEditMode = (locationId: number) => {
			this.mode = "edit";
			this.editingLocationId = locationId;
			if (this.els.modalTitle)
				this.els.modalTitle.textContent = "Editar sucursal";
			if (this.els.modalDesc)
				this.els.modalDesc.textContent =
					"Actualiza la información de la sucursal seleccionada.";
			if (this.els.submitLabel)
				this.els.submitLabel.textContent = "Guardar cambios";
			if (this.els.submitIcon) this.els.submitIcon.textContent = "save";
			this.els.deleteBtn?.classList.remove("hidden");
			this.els.deleteBtn?.removeAttribute("disabled");
			this.els.statusWrap?.removeAttribute("hidden");
			if (this.formEls.status) this.formEls.status.disabled = false;
			this.dispatchEvent(
				new CustomEvent("location-modal:edit-opened", {
					bubbles: true,
					detail: { locationId },
				}),
			);
		};

		private waitForMapLoaded = (): Promise<void> =>
			new Promise((resolve) => {
				if (!this.mapInstance) {
					resolve();
					return;
				}
				if (this.mapInstance.loaded()) {
					resolve();
					return;
				}
				this.mapInstance.once("load", () => resolve());
			});

		private tryApplyCurrentGeolocation = async () => {
			if (this.mode !== "create") return;

			const requestId = ++this.geolocationRequestSeq;

			try {
				const permission = await this.getGeolocationPermissionState();
				if (permission === "denied") {
					this.setMapStatus(this.mapIdleMessage);
					return;
				}

				this.setMapGeolocationLoading(true);
				this.setMapStatus("Obteniendo tu ubicación...");

				const point = await getBrowserGeolocation();
				if (
					requestId !== this.geolocationRequestSeq ||
					this.mode !== "create"
				) {
					return;
				}

				if (!point) {
					this.setMapStatus(this.mapIdleMessage);
					return;
				}

				if (this.selectedCoordinates) return;

				await this.waitForMapLoaded();
				if (
					requestId !== this.geolocationRequestSeq ||
					this.mode !== "create"
				) {
					return;
				}

				const accuracy = point.accuracy ?? Number.POSITIVE_INFINITY;
				if (accuracy > 5_000) {
					this.setMapStatus(
						"No pudimos ubicarte con precisión en este dispositivo. Haz clic en el mapa para marcar la sucursal.",
					);
					return;
				}

				const zoom =
					accuracy <= 50 ? 17 : accuracy <= 150 ? 16 : 15;
				this.setSelectedCoordinates(point.latitude, point.longitude, {
					center: true,
					zoom,
				});
				this.layoutMapContainer();
				this.focusMapOnCoordinates(zoom);

				const precisionHint =
					accuracy <= 150
						? "Ubicación detectada."
						: `Ubicación aproximada (±${Math.round(accuracy)} m).`;
				this.setMapStatus(
					`${precisionHint} Puedes ajustar el punto haciendo clic en el mapa.`,
				);
			} finally {
				this.setMapGeolocationLoading(false);
			}
		};

		private openCreateModal = async () => {
			this.setCreateMode();
			this.resetFormValues();
			this.setFormLoadingState(false);
			this.clearErrors();
			this.openModalShell();
			try {
				await this.ensureDepartmentsLoaded();
				await this.ensureMapReady();
				await this.tryApplyCurrentGeolocation();
				if (!this.selectedCoordinates) {
					this.layoutMapViewport();
				}
			} catch (error) {
				const errorMessage =
					error instanceof Error
						? error.message
						: "No fue posible cargar recursos del formulario.";
				if (errorMessage.toLowerCase().includes("stadia maps")) {
					this.setMapStatus(errorMessage, true);
					return;
				}
				this.showFormError(errorMessage);
			}
		};

		private openEditModal = async (locationId: number) => {
			if (!locationId) return;
			const requestId = ++this.locationReadRequestSeq;
			this.setEditMode(locationId);
			this.resetFormValues();
			this.clearErrors();
			this.openModalShell();
			this.setFormLoadingState(true);
			this.setLoadingMode("Cargando...");

			try {
				const data = await this.requestApi(
					`/api/locations/${locationId}`,
					{
						method: "GET",
						headers: { Accept: "application/json" },
					},
					"No fue posible obtener la sucursal seleccionada."
				);

				if (requestId !== this.locationReadRequestSeq) return;
				const loc = data.data;

				if (this.formEls.name)
					this.formEls.name.value = String(loc?.name || "");
				if (this.formEls.address)
					this.formEls.address.value = String(loc?.address || "");
				if (this.formEls.status)
					this.formEls.status.value = String(
						loc?.is_active === 0 ? 0 : 1,
					);

				const lat =
					typeof loc?.latitude === "number" ? loc.latitude : null;
				const lng =
					typeof loc?.longitude === "number" ? loc.longitude : null;
				this.setSelectedCoordinates(lat, lng, { center: false });

				const departmentId =
					typeof loc?.department?.id_department === "number" &&
					loc.department.id_department > 0
						? loc.department.id_department
						: 0;
				const cityId =
					typeof loc?.city?.id_city === "number" &&
					loc.city.id_city > 0
						? loc.city.id_city
						: 0;

				await this.ensureDepartmentsLoaded();
				await this.ensureMapReady();
				if (requestId !== this.locationReadRequestSeq) return;

				this.applyDepartmentsToSelect(
					this.departmentsCache,
					departmentId > 0 ? departmentId : "",
				);
				await this.loadCitiesByDepartment(departmentId, {
					selectedCityId: cityId,
					showErrors: true,
				});
			} catch (error) {
				if (requestId !== this.locationReadRequestSeq) return;
				const errorMessage =
					error instanceof Error
						? error.message
						: "No fue posible obtener la sucursal.";
				if (errorMessage.toLowerCase().includes("stadia maps")) {
					this.setMapStatus(errorMessage, true);
				} else {
					this.setCreateMode();
					this.showFormError(errorMessage);
				}
			} finally {
				if (requestId !== this.locationReadRequestSeq) return;
				this.setFormLoadingState(false);
				this.restoreButtons();
			}
		};

		private handleDelete = async () => {
			if (!this.editingLocationId || this.mode !== "edit") return;

			// @ts-ignore - BookmateAlert is a custom global
			const confirmed = await window.BookmateAlert?.confirm({
				type: "error",
				title: "Eliminar sucursal",
				message:
					"Esta acción eliminará la sucursal de forma permanente. ¿Deseas continuar?",
				confirmText: "Eliminar",
				cancelText: "Cancelar",
			});
			if (!confirmed) return;

			this.clearErrors();
			this.setLoadingMode("Eliminando...");

			try {
				const data = await this.requestApi(
					`/api/locations/${this.editingLocationId}`,
					{
						method: "DELETE",
						headers: { Accept: "application/json" },
					},
					"No fue posible eliminar la sucursal."
				);

				this.closeModal();
				void reloadPageWithFlash({
					message:
						data?.message?.trim() || "Sucursal eliminada correctamente.",
					type: "success",
				});
			} catch (error) {
				this.showFormError(
					error instanceof Error
						? error.message
						: "No fue posible eliminar la sucursal.",
				);
				this.restoreButtons();
			}
		};

		private handleSubmit = async (event: SubmitEvent) => {
			event.preventDefault();
			if (!this.canManage) return;
			this.clearErrors();
			if (!this.els.form) return;

			const rawData = Object.fromEntries(new FormData(this.els.form).entries());
			const name = String(rawData.name || "").trim();
			const address = String(rawData.address || "").trim();
			const cityRaw = String(rawData.cit_id_city || "").trim();
			const departmentRaw = String(rawData.dep_id_department || "").trim();
			const latitudeRaw = String(rawData.latitude || "").trim();
			const longitudeRaw = String(rawData.longitude || "").trim();
			const isActiveRaw = String(rawData.is_active || "1").trim();

			const cityId = Number(cityRaw);
			const departmentId = Number(departmentRaw);

			if (
				!name ||
				!address ||
				!cityRaw ||
				!departmentRaw ||
				!Number.isInteger(cityId) ||
				cityId <= 0 ||
				!Number.isInteger(departmentId) ||
				departmentId <= 0
			) {
				this.showFormError(
					"Completa los campos requeridos antes de continuar.",
				);
				return;
			}

			const payload: LocationSubmitPayload = {
				name,
				address,
				cit_id_city: cityId,
				dep_id_department: departmentId,
				is_active: isActiveRaw === "0" ? 0 : 1,
			};

			if (latitudeRaw !== "") {
				const lat = Number(latitudeRaw);
				if (Number.isFinite(lat)) payload.latitude = lat;
			}
			if (longitudeRaw !== "") {
				const lng = Number(longitudeRaw);
				if (Number.isFinite(lng)) payload.longitude = lng;
			}

			const endpoint =
				this.mode === "edit" && this.editingLocationId
					? `/api/locations/${this.editingLocationId}`
					: "/api/locations";
			const httpMethod =
				this.mode === "edit" && this.editingLocationId ? "PUT" : "POST";

			this.setLoadingMode(
				this.mode === "edit" ? "Guardando..." : "Creando...",
			);

			try {
				const data = await this.requestApi(
					endpoint,
					{
						method: httpMethod,
						headers: {
							"Content-Type": "application/json",
							Accept: "application/json",
						},
						body: JSON.stringify(payload),
					},
					"No fue posible guardar la sucursal."
				);

				this.closeModal();
				void reloadPageWithFlash({
					message:
						data?.message?.trim() ||
						(this.mode === "edit" ? "Sucursal actualizada." : "Sucursal creada."),
					type: "success",
				});
			} catch (error: any) {
				this.showFormError(
					error instanceof Error
						? error.message
						: "No fue posible guardar la sucursal.",
				);
				if (error.apiData && Array.isArray(error.apiData.errors)) {
					for (const err of error.apiData.errors) {
						if (!err || typeof err !== "object") continue;
						const field = "field" in err ? String(err.field || "") : "";
						const messageText = "message" in err ? String(err.message || "") : "";
						if (!field || !messageText) continue;
						const fieldNode = this.querySelector(`[data-field-error="${field}"]`);
						if (fieldNode) {
							fieldNode.textContent = messageText;
							fieldNode.classList.remove("hidden");
						}
					}
				}
			} finally {
				this.restoreButtons();
			}
		};
	}

	if (!customElements.get("location-manager")) {
		customElements.define("location-manager", LocationManager);
	}

	const startClosuresUI = () => {
		try {
			initLocationClosuresUI();
		} catch {}
	};

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", startClosuresUI, { once: true });
	} else {
		startClosuresUI();
	}
	document.addEventListener("astro:page-load", startClosuresUI);
</script>

