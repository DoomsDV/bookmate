													</div>
												)
											}

											{
												showAppointmentPagination ? (
													<AppPagination
														class="dashboard-appointments-pagination"
														currentPage={safeCurrentPage}
														totalPages={totalAppointmentPages}
														totalRecords={appointmentPagination.total_records}
														recordLabel="citas"
														ariaLabel="Paginación próximas citas"
														prevHref={canPrevPage ? toPageHref(safeCurrentPage - 1) : undefined}
														nextHref={canNextPage ? toPageHref(safeCurrentPage + 1) : undefined}
														pageHrefs={appointmentPageHrefs}
													/>
												) : null
											}
										</div>

										{showAlertsPanel && (
											<aside
												class="dashboard-alerts-shell dashboard-floor__panel rounded-4xl p-5 transition-colors duration-300"
												data-dashboard-alerts
											>
												<div class="mb-4 flex shrink-0 items-center justify-between gap-2">
													<h2 class="text-lg font-bold text-[#202124] dark:text-[#E3E3E3]">Pendientes</h2>
												</div>

												<ul
													class:list={[
														'dashboard-alerts-list m-0 grid list-none gap-2.5 p-0',
														pendingConfirmAlerts.length === 0 && 'hidden',
													]}
													data-dashboard-alerts-list
												>
