---
import { ROLES } from '../../config/roles';
import { FEATURE_FLAGS } from '../../config/feature-flags';
import SideNav from '../../components/SideNav.astro';
import AppAlert from '../../components/AppAlert.astro';
import AiChatPanel from '../../components/AiChatPanel.astro';
import AppointmentVoiceOverlay from '../../components/AppointmentVoiceOverlay.astro';
import AppointmentModalPanel from '../../components/AppointmentModalPanel.astro';
import TopBar from '../../components/TopBar.astro';
import { DashboardApiError, getMainDashboardWithOrds, type DashboardMainData } from '../../lib/dashboard';
import { getMyProfileWithOrds } from '../../lib/my-profile';
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

const token = Astro.locals.token ?? '';
const roleId = Number(Astro.locals.roleId ?? 0);
const showTeamOverview = roleId !== ROLES.PROFESIONAL;
const showAlertsPanel = roleId === ROLES.ADMIN || roleId === ROLES.RECEPCIONISTA;
const PAGE_SIZE = 5;
const rawPage = Number(Astro.url.searchParams.get('page') || '1');
const currentPage = Number.isInteger(rawPage) && rawPage > 0 ? rawPage : 1;
const APP_TZ = 'America/Asuncion';

let dashboard: DashboardMainData = {
	kpis: {
		today_appointments: 0,
		today_completed_appointments: 0,
		pending_appointments: 0,
		my_customers: 2,
		total_customers: 6,
	},
	upcoming_appointments: [],
	pagination: {
		current_page: currentPage,
		per_page: PAGE_SIZE,
		total_records: 0,
		total_pages: 1,
	},
};
let loadError = '';
let userFirstName = '';
const defaultAiSummaryShort = '¡Buen día! Preparate para una excelente jornada de trabajo.';
const defaultAiSummaryFull = defaultAiSummaryShort;

if (!token) {
	loadError = 'No hay sesion valida para consultar el dashboard.';
} else {
	try {
		dashboard = await getMainDashboardWithOrds(token, {
			page: currentPage,
			limit: PAGE_SIZE,
		});
	} catch (error) {
		loadError =
			error instanceof DashboardApiError
				? error.message
				: 'No fue posible cargar los datos del dashboard.';
	}

	try {
		const profile = await getMyProfileWithOrds(token);
		userFirstName = String(profile.first_name || '')
			.trim()
			.split(/\s+/)
			.filter(Boolean)[0] || '';
	} catch {
		userFirstName = '';
	}
}

const dashboardDate = new Intl.DateTimeFormat('es-PY', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: APP_TZ,
}).format(new Date());

const organizationName = String(Astro.locals.organizationName || 'Workspace').trim() || 'Workspace';

const hourAsuncion = Number(
	new Intl.DateTimeFormat('en-US', {
		hour: 'numeric',
		hour12: false,
		timeZone: APP_TZ,
	}).format(new Date())
);

const greetingWord =
	hourAsuncion < 12 ? 'Buenos días' : hourAsuncion < 19 ? 'Buenas tardes' : 'Buenas noches';
const greetingTitle = userFirstName ? `${greetingWord}, ${userFirstName}` : greetingWord;
const greetingHasName = Boolean(userFirstName);

const todayTotal = dashboard.kpis.today_appointments;
const todayCompleted = Math.min(todayTotal, dashboard.kpis.today_completed_appointments || 0);
const dayProgressPct =
	todayTotal > 0 ? Math.min(100, Math.round((todayCompleted / todayTotal) * 100)) : 0;

const greetingSubtitle = `${organizationName} · ${dashboardDate}`;

const progressHint =
	todayTotal === 0
		? 'Sin turnos programados para hoy.'
		: todayCompleted === todayTotal
			? 'Todos los turnos de hoy ya fueron completados.'
			: `${todayTotal - todayCompleted} por atender todavía.`;

type SecondaryMetric = {
	label: string;
	value: number | null;
	description: string;
	zeroStateDescription?: string;
	zeroStateActionLabel?: string;
	zeroStateActionHref?: string;
	icon: string;
	accent: string;
};

const secondaryMetrics: SecondaryMetric[] = [
	{
		label: 'Próximas citas',
		value: dashboard.kpis.pending_appointments,
		description: 'Turnos por atender desde ahora.',
		zeroStateDescription: 'Agenda al día.',
		zeroStateActionLabel: 'Crear cita',
		zeroStateActionHref: '/panel/calendar',
		icon: 'schedule',
		accent: 'green',
	},
	...(roleId !== ROLES.RECEPCIONISTA
		? [
				{
					label: 'Mis clientes',
					value: dashboard.kpis.my_customers,
					description: 'Con historial de citas contigo.',
					icon: 'groups',
					accent: 'green',
				} satisfies SecondaryMetric,
			]
		: dashboard.kpis.total_customers !== null
			? [
					{
						label: 'Total clientes',
						value: dashboard.kpis.total_customers,
						description: 'Base registrada en el negocio.',
						icon: 'hub',
						accent: 'orange',
					} satisfies SecondaryMetric,
				]
			: []),
];

const weekDayLabelsByJs = ['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sa'] as const;
const asuncionDateParts = new Intl.DateTimeFormat('en-CA', {
	timeZone: APP_TZ,
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
}).formatToParts(new Date());
const asuncionY = Number(asuncionDateParts.find((p) => p.type === 'year')?.value || 0);
const asuncionM = Number(asuncionDateParts.find((p) => p.type === 'month')?.value || 1);
const asuncionD = Number(asuncionDateParts.find((p) => p.type === 'day')?.value || 1);
const asuncionToday = new Date(Date.UTC(asuncionY, asuncionM - 1, asuncionD));
const asuncionTodayIso = `${asuncionY}-${String(asuncionM).padStart(2, '0')}-${String(asuncionD).padStart(2, '0')}`;
// Próximos 7 días desde hoy (alineado al listado), no la semana calendario Lu–Do.
const weekGlance = Array.from({ length: 7 }, (_, index) => {
	const day = new Date(asuncionToday);
	day.setUTCDate(asuncionToday.getUTCDate() + index);
	const iso = `${day.getUTCFullYear()}-${String(day.getUTCMonth() + 1).padStart(2, '0')}-${String(day.getUTCDate()).padStart(2, '0')}`;
	const appointmentCount = dashboard.upcoming_appointments.filter(
		(item) => item.appointment_date === iso
	).length;
	return {
		label: weekDayLabelsByJs[day.getUTCDay()],
		dayNumber: day.getUTCDate(),
		iso,
		isToday: iso === asuncionTodayIso,
		hasAppointments: appointmentCount > 0,
		appointmentCount,
	};
});

const pendingConfirmAlerts = dashboard.upcoming_appointments
	.filter((item) => item.status === 'PENDIENTE')
	.slice(0, 4);

const getStatusLabel = (status: string) => {
	switch (status) {
		case 'CONFIRMADO':
			return 'Confirmado';
		case 'PENDIENTE':
			return 'Pendiente';
		case 'COMPLETADO':
			return 'Completado';
		case 'CANCELADO':
			return 'Cancelado';
		default:
			return status || 'Estado';
	}
};

const getCustomerInitials = (name: string) => {
	const parts = String(name || '')
		.trim()
		.split(/\s+/)
		.filter(Boolean);
	if (parts.length === 0) return '?';
	if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
	return `${parts[0][0] || ''}${parts[parts.length - 1][0] || ''}`.toUpperCase();
};

const formatUpcomingAppointmentDate = (value: string) => {
	const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(value || '').trim());
	if (!match) return '';

	const year = Number(match[1]);
	const month = Number(match[2]);
	const day = Number(match[3]);
	const date = new Date(year, month - 1, day);
	if (Number.isNaN(date.getTime())) return '';

	const weekDays = ['Dom', 'Lun', 'Mar', 'Mie', 'Jue', 'Vie', 'Sab'];
	return `${weekDays[date.getDay()]} ${String(day).padStart(2, '0')}/${String(month).padStart(2, '0')}`;
};

const appointmentPagination = dashboard.pagination;
const totalAppointmentPages = Math.max(1, appointmentPagination.total_pages);
const safeCurrentPage = Math.min(
	Math.max(1, appointmentPagination.current_page),
	totalAppointmentPages
);
const canPrevPage = safeCurrentPage > 1;
const canNextPage = safeCurrentPage < totalAppointmentPages;
const appointmentsCountText =
	appointmentPagination.total_records === 1
		? '1 cita'
		: `${appointmentPagination.total_records} citas`;

const toPageHref = (page: number) => {
	const nextUrl = new URL(Astro.url);
	nextUrl.searchParams.set('page', String(page));
	nextUrl.hash = 'dashboard-upcoming-appointments';
	return `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`;
};

---

<Layout>
	<div class="dashboard-canvas min-h-screen w-full max-w-full overflow-x-hidden transition-colors duration-300">
		<div
			class="app-shell grid min-h-screen overflow-hidden bg-transparent"
			data-app-shell
			data-sidebar-state="expanded"
		>
			<SideNav currentPath={Astro.url.pathname} />

			<div class="dashboard-content-canvas grid min-h-full min-w-0 max-w-full grid-rows-[auto_1fr] overflow-x-hidden transition-colors duration-300">
				<TopBar>
					{showTeamOverview && (
						<div
							slot="actions-before"
							class="dashboard-team-chip dashboard-team-chip--compact"
							data-team-card
						>
							<div class="flex -space-x-2" data-team-avatar-stack aria-label="Vista previa del equipo">
								<span class="team-avatar team-avatar--placeholder"></span>
								<span class="team-avatar team-avatar--placeholder"></span>
								<span class="team-avatar team-avatar--placeholder"></span>
							</div>
							<p class="dashboard-team-summary sr-only" data-team-summary>Equipo activo</p>
							<p class="team-overview-state text-[0.75rem] font-medium hidden" data-team-state></p>
						</div>
					)}
				</TopBar>

				<main class="w-full max-w-full min-w-0 overflow-x-hidden px-4 py-5 sm:px-6 sm:py-7 lg:px-8">
					<div class="mx-auto w-full max-w-[92rem] min-w-0">
						<section class="dashboard-main-stack grid w-full min-w-0 gap-5 sm:gap-8" data-dashboard-main>
							<section class="dashboard-summary-card mb-0 transition-all duration-300">
								<div class="flex flex-col justify-between gap-3 lg:flex-row lg:items-center lg:gap-4">
									<div class="flex min-w-0 flex-col gap-2 lg:flex-row lg:items-center lg:gap-4">
										<div class="dashboard-greeting grid min-w-0 gap-1" data-dashboard-intro>
											<h1
												class="dashboard-greeting__title font-extrabold text-[#202124] dark:text-[#E3E3E3] tracking-tight"
												data-dashboard-greeting
												data-dashboard-reveal
												data-dashboard-reveal-delay="0"
												aria-label={greetingTitle}
											>
												{greetingHasName ? (
													<>
														<span class="dashboard-greeting__word">{greetingWord},</span>
														<span class="dashboard-greeting__name">{userFirstName}</span>
													</>
												) : (
													greetingWord
												)}
											</h1>
											<p
												class="dashboard-greeting__sub font-medium text-[#5f6368] dark:text-[#C4C7C5]"
												data-dashboard-greeting-sub
												data-dashboard-reveal
												data-dashboard-reveal-delay="90"
											>
												{greetingSubtitle}
											</p>
										</div>

										{showTeamOverview && (
										<div
											class="dashboard-team-chip dashboard-team-chip--pill dashboard-deferred h-fit lg:ml-8"
											data-team-card
											data-dashboard-reveal
											data-dashboard-reveal-delay="180"
										>
											<div class="flex items-center gap-3">
												<div class="flex -space-x-2" data-team-avatar-stack aria-label="Vista previa del equipo">
													<span class="team-avatar team-avatar--placeholder"></span>
													<span class="team-avatar team-avatar--placeholder"></span>
													<span class="team-avatar team-avatar--placeholder"></span>
												</div>
												<p class="dashboard-team-summary" data-team-summary>
													Equipo activo
												</p>
											</div>
											<p class="team-overview-state text-[0.75rem] font-medium hidden mt-1" data-team-state></p>
										</div>
										)}
									</div>

									<div
										class="dashboard-header-actions dashboard-deferred"
										data-dashboard-reveal
										data-dashboard-reveal-delay="180"
									>
										{FEATURE_FLAGS.APPOINTMENT_AI_VOICE && (
											<button
												type="button"
												class="dashboard-ai-chat-cta"
												data-open-appointment-voice
												data-appointment-voice-mode="inline"
											>
												<span class="material-symbols-rounded text-lg" aria-hidden="true">auto_awesome</span>
												<span>Cita rápida</span>
											</button>
										)}
										<a
											href="/panel/calendar"
											class="dashboard-primary-cta dashboard-header-cta inline-flex w-full items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-bold no-underline transition sm:w-auto"
										>
											<span class="material-symbols-rounded text-lg" aria-hidden="true">calendar_month</span>
											<span>Ir al calendario</span>
										</a>
									</div>
								</div>
							</section>

							{roleId === ROLES.ADMIN && (
								<section
									class="dashboard-profitability-shell is-loading transition-colors duration-300"
									data-profitability-panel
									aria-busy="true"
								>
									<div class="mb-4 flex min-w-0 items-center justify-between gap-2 sm:gap-3 dashboard-profitability-head">
										<div class="flex min-w-0 items-center gap-1.5 sm:gap-2">
											<span class="material-symbols-rounded shrink-0 text-[1.3rem] text-(--primary)" aria-hidden="true">trending_up</span>
											<h2 class="dashboard-profitability-title min-w-0 text-xl font-bold text-[#202124] dark:text-[#E3E3E3]">Rentabilidad del mes</h2>
										</div>
									</div>

									<div class="dashboard-carousel">
									<div class="dashboard-profit-metrics-track">
										<article class="dashboard-profit-card" data-profit-accent="emerald">
											<div class="dashboard-profit-card__head">
												<p class="dashboard-profit-label">Ingresos del mes</p>
												<span class="dashboard-profit-icon material-symbols-rounded" aria-hidden="true">payments</span>
											</div>
											<p class="dashboard-profit-value" data-profit-month-revenue>&nbsp;</p>
											<p class="dashboard-profit-hint" data-profit-mom>&nbsp;</p>
										</article>
										<article class="dashboard-profit-card" data-profit-accent="violet">
											<div class="dashboard-profit-card__head">
												<p class="dashboard-profit-label">Promedio por turno</p>
												<span class="dashboard-profit-icon material-symbols-rounded" aria-hidden="true">confirmation_number</span>
											</div>
											<p class="dashboard-profit-value" data-profit-avg-ticket>&nbsp;</p>
											<p class="dashboard-profit-hint" data-profit-count>&nbsp;</p>
										</article>
										<article class="dashboard-profit-card" data-profit-accent="brand">
											<div class="dashboard-profit-card__head">
												<p class="dashboard-profit-label">Ingresos de hoy</p>
												<span class="dashboard-profit-icon material-symbols-rounded" aria-hidden="true">today</span>
											</div>
											<p class="dashboard-profit-value" data-profit-today>&nbsp;</p>
											<p class="dashboard-profit-hint">Citas ya atendidas hoy.</p>
										</article>
										<article class="dashboard-profit-card" data-profit-accent="amber">
											<div class="dashboard-profit-card__head">
												<p class="dashboard-profit-label">Esperado (futuro)</p>
												<span class="dashboard-profit-icon material-symbols-rounded" aria-hidden="true">trending_up</span>
											</div>
											<p class="dashboard-profit-value" data-profit-pending>&nbsp;</p>
											<p class="dashboard-profit-hint">Citas confirmadas y pendientes.</p>
										</article>
									</div>
									</div>
								</section>
							)}

							<div
								class="dashboard-ai-strip is-generating"
								data-ai-summary-card
								data-role-id={String(roleId)}
								data-default-summary-short={defaultAiSummaryShort}
								data-default-summary-full={defaultAiSummaryFull}
								aria-live="polite"
								aria-busy="true"
							>
								<div class="dashboard-ai-strip__glow" aria-hidden="true"></div>
								<div class="dashboard-ai-strip__head">
									<span class="dashboard-ai-strip__badge" aria-hidden="true">
										<span class="dashboard-ai-strip__icon material-symbols-rounded">auto_awesome</span>
									</span>
									<div class="dashboard-ai-strip__meta">
										<p class="dashboard-ai-strip__eyebrow">Resumen inteligente del día</p>
									</div>
								</div>
								<div class="dashboard-ai-strip__skeleton" aria-hidden="true">
									<span class="dashboard-ai-strip__skel-line dashboard-ai-strip__skel-line--lg"></span>
									<span class="dashboard-ai-strip__skel-line dashboard-ai-strip__skel-line--md"></span>
									<span class="dashboard-ai-strip__skel-line dashboard-ai-strip__skel-line--sm"></span>
								</div>
								<p class="dashboard-ai-strip__text" data-ai-summary-line>
									Generando resumen inteligente…
								</p>
								<button
									type="button"
									class="dashboard-ai-strip__action"
									data-open-ai-summary-modal
									hidden
								>
									<span class="dashboard-ai-strip__action-label">Ver análisis completo</span>
									<span class="material-symbols-rounded" aria-hidden="true">chevron_right</span>
								</button>
							</div>

							{
								loadError ? (
									<div class="rounded-3xl bg-rose-50 px-5 py-4 text-sm font-semibold text-rose-700 dark:bg-[#3B191E] dark:text-[#FFB4AB] shadow-sm">
										{loadError}
									</div>
								) : (
									<>
										<div class="dashboard-floor dashboard-floor--today">
											<article class="dashboard-day-progress" aria-label="Progreso del día">
												<div class="dashboard-day-progress__inner">
													<div class="dashboard-day-progress__top">
														<div>
															<p class="dashboard-day-progress__eyebrow">Progreso del día</p>
															<p class="dashboard-day-progress__metric">
																<span data-day-completed>{todayCompleted}</span>
																<span class="dashboard-day-progress__of"> de {todayTotal}</span>
																<span class="dashboard-day-progress__unit">turnos completados</span>
															</p>
															<p class="dashboard-day-progress__hint">{progressHint}</p>
														</div>
														<span class="dashboard-day-progress__icon material-symbols-rounded" aria-hidden="true">
															event_available
														</span>
													</div>
													<div
														class="dashboard-day-progress__bar"
														role="progressbar"
														aria-valuemin="0"
														aria-valuemax={Math.max(todayTotal, 1)}
														aria-valuenow={todayCompleted}
														aria-label={`${todayCompleted} de ${todayTotal} turnos completados`}
													>
														<span class="dashboard-day-progress__fill" style={`width: ${dayProgressPct}%`}></span>
													</div>
													<p class="dashboard-day-progress__insight" data-day-progress-insight hidden></p>
												</div>
											</article>

											<div class="dashboard-side-metrics">
												{
													secondaryMetrics.map((metric) => {
														const numericValue = Number(metric.value ?? 0);
														const isZeroState = Number.isFinite(numericValue) && numericValue === 0;
														const supportingText =
															isZeroState && metric.zeroStateDescription
																? metric.zeroStateDescription
																: metric.description;

														return (
															<article
																class="dashboard-metric-card dashboard-metric-card--compact flex h-full min-w-0 flex-col rounded-4xl p-5 transition-all duration-300"
																data-metric-accent={metric.accent}
															>
																<p class="dashboard-metric-label mb-2 text-[0.7rem] font-extrabold uppercase tracking-widest leading-tight">
																	{metric.label}
																</p>
																<div class="dashboard-metric-content">
																	<div class="dashboard-metric-value-row mb-1">
																		<p class="dashboard-metric-value dashboard-metric-value--compact">
																			{metric.value}
																		</p>
																		<span class="dashboard-metric-icon material-symbols-rounded" aria-hidden="true">
																			{metric.icon}
																		</span>
																	</div>
																	<p class="dashboard-metric-description text-[0.8rem] font-semibold leading-snug">
																		{supportingText}
																	</p>
																	{
																		isZeroState && metric.zeroStateActionHref && metric.zeroStateActionLabel ? (
																			<div class="dashboard-metric-zero-link-wrap mt-auto">
																				<a href={metric.zeroStateActionHref} class="dashboard-metric-zero-link">
																					{metric.zeroStateActionLabel}
																					<span class="material-symbols-rounded text-[0.95rem]">chevron_right</span>
																				</a>
																			</div>
																		) : null
																	}
																</div>
															</article>
														);
													})
												}
											</div>
										</div>

									<div class:list={['dashboard-floor', 'dashboard-floor--action', showAlertsPanel && 'dashboard-floor--split']}>
										<div
											id="dashboard-upcoming-appointments"
											class="dashboard-report-shell dashboard-floor__panel rounded-4xl p-6 transition-colors duration-300"
										>
											<div class="mb-4 flex items-center justify-between gap-3">
												<div class="min-w-0">
													<h2 class="text-xl font-bold text-[#202124] dark:text-[#E3E3E3]">Próximas citas</h2>
													<p class="dashboard-appointments-subtitle">Siguientes 7 días</p>
												</div>
												<span class="dashboard-appointments-count whitespace-nowrap rounded-full bg-[#E8EAED] dark:bg-[#2B2D31] px-3 py-1.5 text-[0.75rem] font-black text-[#5f6368] dark:text-[#C4C7C5] tracking-wide shadow-sm transition-colors duration-300">
													{appointmentsCountText}
												</span>
											</div>

											<div class="dashboard-week-glance" aria-label="Próximos 7 días">
												{
													weekGlance.map((day) => (
														<div
															class:list={[
																'dashboard-week-glance__day',
																day.isToday && 'is-today',
																day.hasAppointments && 'has-appointments',
															]}
															title={
																day.hasAppointments
																	? `${day.appointmentCount} cita(s)`
																	: day.isToday
																		? 'Hoy'
																		: undefined
															}
														>
															<span class="dashboard-week-glance__label">{day.label}</span>
