		position: relative;
	}

	.dashboard-ai-preview-wrap::after {
		content: none;
	}

	.dashboard-ai-preview-wrap.has-more::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 2.75rem;
