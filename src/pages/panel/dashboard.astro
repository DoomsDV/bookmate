		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes ai-summary-sheet-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(100%);
		}
	}

	@keyframes ai-summary-drawer-in {
		from {
			opacity: 0;
			transform: translateX(100%);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@keyframes ai-summary-drawer-out {
		from {
			opacity: 1;
			transform: translateX(0);
		}
		to {
			opacity: 0;
			transform: translateX(100%);
		}
	}

	@keyframes ai-summary-backdrop-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes ai-summary-backdrop-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

