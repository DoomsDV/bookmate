	dialog[data-ai-summary-modal] {
		position: fixed;
		inset: 0;
		margin: 0;
		padding: 0;
		width: 100%;
		max-width: 100%;
		height: 100dvh;
		max-height: 100dvh;
		border: none;
		background: transparent;
	}

	dialog[data-ai-summary-modal][open] {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		justify-content: flex-end;
		animation: ai-summary-sheet-in var(--modal-open-duration) var(--modal-easing);
	}

	dialog[data-ai-summary-modal]::backdrop {
		animation: ai-summary-backdrop-in var(--modal-open-duration) var(--modal-easing);
	}

	dialog[data-ai-summary-modal].is-closing {
		animation: ai-summary-sheet-out var(--modal-close-duration) var(--modal-easing) forwards;
	}

	dialog[data-ai-summary-modal].is-closing::backdrop {
		animation: ai-summary-backdrop-out var(--modal-close-duration) var(--modal-easing) forwards;
	}

	.dashboard-ai-drawer__panel {
		width: 100%;
		max-width: 100%;
		height: min(92dvh, calc(100dvh - 1rem));
		max-height: min(92dvh, calc(100dvh - 1rem));
		border-left: 0;
		border-top: 1px solid var(--shell-border);
		border-radius: 1.5rem 1.5rem 0 0;
		box-shadow: var(--modal-shadow-sheet);
		background: var(--surface-bright);
		background-image: none;
		padding-bottom: env(safe-area-inset-bottom, 0px);
	}

	.dashboard-ai-drawer__handle {
		display: flex;
		justify-content: center;
		padding: 0.55rem 0 0.1rem;
	}

	.dashboard-ai-drawer__handle-pill {
		width: 2.35rem;
		height: 0.28rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--on-surface-variant) 42%, transparent);
	}

	@keyframes ai-summary-sheet-in {
		from {
			opacity: 0;
			transform: translateY(100%);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes ai-summary-sheet-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(100%);
		}
	}

	@keyframes ai-summary-drawer-in {
		from {
			opacity: 0;
			transform: translateX(100%);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@keyframes ai-summary-drawer-out {
		from {
			opacity: 1;
			transform: translateX(0);
		}
		to {
			opacity: 0;
			transform: translateX(100%);
		}
	}

	@keyframes ai-summary-backdrop-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes ai-summary-backdrop-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

	/* Tablet+: drawer lateral desde la derecha (como Servicios / Cita). */
	@media (min-width: 640px) {
		dialog[data-ai-summary-modal][open] {
			flex-direction: row;
			align-items: stretch;
			justify-content: flex-end;
