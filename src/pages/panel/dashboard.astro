---
import { ROLES } from '../../config/roles';
import { FEATURE_FLAGS } from '../../config/feature-flags';
import SideNav from '../../components/SideNav.astro';
import AppAlert from '../../components/AppAlert.astro';
import AppPagination from '../../components/AppPagination.astro';
import AiChatPanel from '../../components/AiChatPanel.astro';
import AppointmentVoiceOverlay from '../../components/AppointmentVoiceOverlay.astro';
import AgendaScanPreview from '../../components/AgendaScanPreview.astro';
import AppointmentModalPanel from '../../components/AppointmentModalPanel.astro';
import TopBar from '../../components/TopBar.astro';
import {
	DashboardApiError,
	DASHBOARD_APP_TZ,
	fillAppointmentsByDay,
	getMainDashboardWithOrds,
	type DashboardMainData,
} from '../../lib/dashboard';
import { getMyProfileWithOrds } from '../../lib/my-profile';
import Layout from '../../layouts/Layout.astro';
import { panelPageTitle } from '../../lib/panel-page-title';
import '../../styles/global.css';
import '../../styles/dashboard-ai-strip.css';

const token = Astro.locals.token ?? '';
const roleId = Number(Astro.locals.roleId ?? 0);
const showTeamOverview = false;
const PAGE_SIZE = 20;
const rawPage = Number(Astro.url.searchParams.get('page') || '1');
const currentPage = Number.isInteger(rawPage) && rawPage > 0 ? rawPage : 1;
const APP_TZ = DASHBOARD_APP_TZ;

let dashboard: DashboardMainData = {
	kpis: {
		today_appointments: 0,
		today_completed_appointments: 0,
		pending_appointments: 0,
		unconfirmed_appointments: 0,
		my_customers: 2,
		total_customers: 6,
	},
	upcoming_appointments: [],
	appointments_by_day: fillAppointmentsByDay(null),
	pagination: {
		current_page: currentPage,
		per_page: PAGE_SIZE,
		total_records: 0,
		total_pages: 1,
	},
};
let loadError = '';
let userDisplayName = '';
const defaultAiSummaryShort = '¡Buen día! Preparate para una excelente jornada de trabajo.';
const defaultAiSummaryFull = defaultAiSummaryShort;

if (!token) {
	loadError = 'No hay sesion valida para consultar el dashboard.';
} else {
	const [dashboardResult, profileResult] = await Promise.allSettled([
		getMainDashboardWithOrds(token, {
			page: currentPage,
			limit: PAGE_SIZE,
		}),
		getMyProfileWithOrds(token),
	]);

	if (dashboardResult.status === 'fulfilled') {
		dashboard = dashboardResult.value;
	} else {
		const error = dashboardResult.reason;
		loadError =
			error instanceof DashboardApiError
				? error.message
				: 'No fue posible cargar los datos del dashboard.';
	}

	if (profileResult.status === 'fulfilled') {
		const firstName = String(profileResult.value.first_name || '').trim();
		const lastName = String(profileResult.value.last_name || '').trim();
		userDisplayName = firstName || lastName;
	} else {
		userDisplayName = '';
	}
}

const dashboardDate = new Intl.DateTimeFormat('es-PY', {
	day: 'numeric',
	month: 'short',
	timeZone: APP_TZ,
}).format(new Date());

const organizationName = String(Astro.locals.organizationName || 'Workspace').trim() || 'Workspace';

const hourAsuncion = Number(
	new Intl.DateTimeFormat('en-US', {
		hour: 'numeric',
		hour12: false,
		timeZone: APP_TZ,
	}).format(new Date())
);

const greetingWord =
	hourAsuncion < 12 ? 'Buenos días' : hourAsuncion < 19 ? 'Buenas tardes' : 'Buenas noches';
const greetingTitle = userDisplayName ? `${greetingWord}, ${userDisplayName}` : greetingWord;
const greetingLine = userDisplayName ? `${greetingWord},` : greetingWord;
const greetingHasName = Boolean(userDisplayName);
const greetingNameWords = userDisplayName.split(/\s+/).filter(Boolean);

const toGreetingChars = (value: string) => Array.from(value);
const greetingLineChars = toGreetingChars(greetingLine);
const greetingNamePieces = greetingNameWords.map((word, wordIndex) => {
	const startIndex =
		greetingLineChars.length +
		greetingNameWords.slice(0, wordIndex).reduce((total, item) => total + Array.from(item).length + 1, 0);
	return { word, startIndex };
});

const todayTotal = dashboard.kpis.today_appointments;
const unconfirmedTotal = Math.max(0, dashboard.kpis.unconfirmed_appointments || 0);

const greetingSubtitle = `${organizationName} · ${dashboardDate}`;

const weekDayLabelsByJs = ['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sa'] as const;
const weekDayNamesByJs = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'] as const;
const asuncionTodayIso = dashboard.appointments_by_day[0]?.date ?? '';
const weekChartMax = Math.max(1, ...dashboard.appointments_by_day.map((item) => item.count));
const weekChartTotal = dashboard.appointments_by_day.reduce((sum, item) => sum + item.count, 0);
const weekChartEmpty = weekChartTotal === 0;
const weekChartCountText = weekChartTotal === 1 ? '1 cita' : `${weekChartTotal} citas`;
const weekGlance = dashboard.appointments_by_day.map((item) => {
	const [year, month, dayNumber] = item.date.split('-').map(Number);
	const utcDay = new Date(Date.UTC(year, month - 1, dayNumber));
	const weekday = utcDay.getUTCDay();
	return {
		label: weekDayLabelsByJs[weekday],
		weekdayName: weekDayNamesByJs[weekday],
		dayNumber,
		iso: item.date,
		isToday: item.date === asuncionTodayIso,
		hasAppointments: item.count > 0,
		appointmentCount: item.count,
		barPct: weekChartEmpty ? 0 : Math.round((item.count / weekChartMax) * 100),
	};
});
const weekChartAria = weekGlance
	.map((day) => `${day.weekdayName}: ${day.appointmentCount}`)
	.join('. ');

const getStatusLabel = (status: string) => {
	switch (status) {
		case 'CONFIRMADO':
			return 'Confirmado';
		case 'PENDIENTE':
			return 'Pendiente';
		case 'COMPLETADO':
			return 'Completado';
		case 'CANCELADO':
			return 'Cancelado';
		default:
			return status || 'Estado';
	}
};

const formatUpcomingAppointmentDate = (value: string) => {
	const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(value || '').trim());
	if (!match) return '';

	const year = Number(match[1]);
	const month = Number(match[2]);
	const day = Number(match[3]);
	const date = new Date(year, month - 1, day);
	if (Number.isNaN(date.getTime())) return '';

	const weekDays = ['Dom', 'Lun', 'Mar', 'Mie', 'Jue', 'Vie', 'Sab'];
	return `${weekDays[date.getDay()]} ${String(day).padStart(2, '0')}/${String(month).padStart(2, '0')}`;
};

const appointmentPagination = dashboard.pagination;
const totalAppointmentPages = Math.max(1, appointmentPagination.total_pages);
const safeCurrentPage = Math.min(
	Math.max(1, appointmentPagination.current_page),
	totalAppointmentPages
);
const canPrevPage = safeCurrentPage > 1;
const canNextPage = safeCurrentPage < totalAppointmentPages;
const showAppointmentPagination =
	appointmentPagination.total_records > 0 && totalAppointmentPages > 1;
const appointmentsCountText =
	appointmentPagination.total_records === 1
		? '1 cita'
		: `${appointmentPagination.total_records} citas`;

const toPageHref = (page: number) => {
	const nextUrl = new URL(Astro.url);
	nextUrl.searchParams.set('page', String(page));
	nextUrl.hash = 'dashboard-upcoming-appointments';
	return `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`;
};

const appointmentPageHrefs: Partial<Record<number, string>> = {};
for (let page = 1; page <= totalAppointmentPages; page += 1) {
	appointmentPageHrefs[page] = toPageHref(page);
}

---

<Layout pageTitle={panelPageTitle('Dashboard')}>
	<div class="dashboard-canvas min-h-screen w-full max-w-full overflow-x-hidden">
		<div
			class="app-shell grid min-h-screen overflow-hidden bg-transparent"
			data-app-shell
			data-sidebar-state="expanded"
		>
			<SideNav currentPath={Astro.url.pathname} />

			<div class="dashboard-content-canvas grid min-h-full min-w-0 max-w-full grid-rows-[auto_1fr] overflow-x-hidden">
				<TopBar />

				<main class="w-full max-w-full min-w-0 overflow-x-hidden px-4 py-5 sm:px-6 sm:py-6">
					<div class="w-full min-w-0">
						<section
							class="dashboard-main-stack grid w-full min-w-0"
							data-dashboard-main
							data-fade-content
							data-fc-blur="true"
							data-fc-duration="1000"
							data-fc-easing="ease-out"
							data-fc-opacity="0"
							data-fc-immediate="true"
						>
							<section class="dashboard-summary-card mb-0 transition-all duration-300">
								<div class="flex flex-col justify-between gap-3 lg:flex-row lg:items-center lg:gap-4">
									<div class="flex min-w-0 flex-col gap-2 lg:flex-row lg:items-center lg:gap-4">
										<div class="dashboard-greeting flex min-w-0 flex-col gap-1" data-dashboard-intro>
											<h1
												class="dashboard-greeting__title font-semibold text-[#1e293b] dark:text-[#E5E7EB] tracking-tight"
												data-dashboard-greeting
												aria-label={greetingTitle}
											>
												<span class="dashboard-greeting__word dashboard-greeting__split" aria-hidden="true">
													{greetingLineChars.map((char, index) => (
														<span
															class="dashboard-greeting__char"
															style={`--char-i: ${index}`}
														>
															{char === ' ' ? '\u00A0' : char}
														</span>
													))}
												</span>
												{greetingHasName ? (
													<span class="dashboard-greeting__name dashboard-greeting__split" aria-hidden="true">
														{greetingNamePieces.map((piece, wordIndex) => (
															<span class="dashboard-greeting__name-piece">
																{wordIndex > 0 ? (
																	<span class="dashboard-greeting__gap">{' '}</span>
																) : null}
																<span class="dashboard-greeting__name-word">
																	{Array.from(piece.word).map((char, charIndex) => (
																		<span
																			class="dashboard-greeting__char"
																			style={`--char-i: ${piece.startIndex + charIndex}`}
																		>
																			{char}
																		</span>
																	))}
																</span>
															</span>
														))}
													</span>
												) : null}
											</h1>
											<p
												class="dashboard-greeting__sub"
												data-dashboard-greeting-sub
											>
												{greetingSubtitle}
											</p>
										</div>

										{showTeamOverview && (
										<div
											class="dashboard-team-chip dashboard-team-chip--pill h-fit lg:ml-8"
											data-team-card
										>
											<div class="flex items-center gap-3">
												<div class="flex -space-x-2" data-team-avatar-stack aria-label="Vista previa del equipo">
													<span class="team-avatar team-avatar--placeholder"></span>
													<span class="team-avatar team-avatar--placeholder"></span>
													<span class="team-avatar team-avatar--placeholder"></span>
												</div>
												<p class="dashboard-team-summary" data-team-summary>
													Equipo activo
												</p>
											</div>
											<p class="team-overview-state text-[0.75rem] font-medium hidden mt-1" data-team-state></p>
										</div>
										)}
									</div>

									<div class="dashboard-header-actions">
										{FEATURE_FLAGS.APPOINTMENT_AI_VOICE && (
											<button
												type="button"
												class="dashboard-ai-chat-cta"
												data-open-appointment-voice
												data-appointment-voice-mode="inline"
											>
												<span class="material-symbols-rounded text-lg dashboard-ai-strip__icon dashboard-ai-strip__shiny" aria-hidden="true">auto_awesome</span>
												<span class="dashboard-ai-strip__shiny">Agenda rápida</span>
											</button>
										)}
										<a
											href="/panel/calendar"
											class="dashboard-primary-cta dashboard-header-cta inline-flex items-center justify-center gap-2 rounded-full text-sm font-semibold no-underline"
										>
											<span class="material-symbols-rounded text-lg" aria-hidden="true">calendar_month</span>
											<span>Ir al calendario</span>
										</a>
									</div>
								</div>
							</section>

							{(roleId === ROLES.ADMIN || roleId === ROLES.PROFESIONAL) && (
								<section
									class="dashboard-profitability-shell is-loading transition-colors duration-300"
									data-profitability-panel
									aria-busy="true"
									aria-label={roleId === ROLES.PROFESIONAL ? 'Resumen de tu consultorio' : 'Resumen del consultorio'}
								>
									<h2 class="sr-only">
										{roleId === ROLES.PROFESIONAL ? 'Resumen de tu consultorio' : 'Resumen del consultorio'}
									</h2>

									<div class="dashboard-carousel">
									<div class="dashboard-profit-metrics-track">
										<a
											class="dashboard-profit-card dashboard-profit-card--simple"
											data-profit-accent="brand"
											href="/panel/calendar"
										>
											<span class="dashboard-profit-card__head">
												<span class="dashboard-profit-icon" aria-hidden="true">
													<span class="material-symbols-rounded">today</span>
												</span>
												<p class="dashboard-profit-label">Hoy</p>
												<span class="dashboard-profit-card__go material-symbols-rounded" aria-hidden="true">arrow_outward</span>
											</span>
											<p class="dashboard-profit-value dashboard-profit-value--static">{todayTotal}</p>
											<p class="dashboard-profit-caption">{todayTotal === 1 ? 'turno' : 'turnos'}</p>
										</a>
										<article
											class:list={[
												'dashboard-profit-card dashboard-profit-card--simple',
												unconfirmedTotal > 0 && 'is-alert',
											]}
											data-profit-accent="amber"
										>
											<span class="dashboard-profit-card__head">
												<span class="dashboard-profit-icon" aria-hidden="true">
													<span class="material-symbols-rounded">hourglass_top</span>
												</span>
												<p class="dashboard-profit-label">Por confirmar</p>
											</span>
											<p class="dashboard-profit-value dashboard-profit-value--static">{unconfirmedTotal}</p>
											<p class="dashboard-profit-caption">
												{unconfirmedTotal === 0
													? 'Nada pendiente'
													: unconfirmedTotal === 1
														? 'Cita por confirmar'
														: 'Citas por confirmar'}
											</p>
										</article>
										<article class="dashboard-profit-card dashboard-profit-card--simple" data-profit-accent="emerald">
											<span class="dashboard-profit-card__head">
												<span class="dashboard-profit-icon" aria-hidden="true">
													<span class="material-symbols-rounded">payments</span>
												</span>
												<p class="dashboard-profit-label">Este mes</p>
											</span>
											<p class="dashboard-profit-value" data-profit-month-revenue>&nbsp;</p>
											<p class="dashboard-profit-caption">Estimado por servicios</p>
										</article>
										<a
											class="dashboard-profit-card dashboard-profit-card--simple"
											data-profit-accent="violet"
											href="/panel/customers"
										>
											<span class="dashboard-profit-card__head">
												<span class="dashboard-profit-icon" aria-hidden="true">
													<span class="material-symbols-rounded">person_add</span>
												</span>
												<p class="dashboard-profit-label">Nuevos</p>
												<span class="dashboard-profit-card__go material-symbols-rounded" aria-hidden="true">arrow_outward</span>
											</span>
											<p class="dashboard-profit-value" data-profit-new-clients>&nbsp;</p>
											<p class="dashboard-profit-caption">Clientes este mes</p>
										</a>
									</div>
									</div>
								</section>
							)}

							{showTeamOverview && (
								<div
									class="dashboard-team-chip dashboard-team-chip--compact"
									data-team-card
								>
									<div class="dashboard-team-chip__row">
										<div class="dashboard-team-chip__avatars flex -space-x-2" data-team-avatar-stack aria-label="Vista previa del equipo">
											<span class="team-avatar team-avatar--placeholder"></span>
											<span class="team-avatar team-avatar--placeholder"></span>
											<span class="team-avatar team-avatar--placeholder"></span>
										</div>
										<div class="dashboard-team-chip__copy">
											<p class="dashboard-team-chip__label">Tu equipo</p>
											<p class="dashboard-team-summary" data-team-summary>Equipo activo</p>
										</div>
									</div>
									<p class="team-overview-state text-[0.75rem] font-medium hidden" data-team-state></p>
								</div>
							)}

							<div
								class="dashboard-ai-strip"
								data-ai-summary-card
								data-role-id={String(roleId)}
								data-default-summary-short={defaultAiSummaryShort}
								data-default-summary-full={defaultAiSummaryFull}
								aria-live="polite"
								aria-busy="false"
							>
								<div class="dashboard-ai-strip__body">
									<span class="dashboard-ai-strip__spine" aria-hidden="true"></span>
									<div class="dashboard-ai-strip__copy">
										<div class="dashboard-ai-strip__head">
											<span class="dashboard-ai-strip__badge" aria-hidden="true">
												<span class="dashboard-ai-strip__icon material-symbols-rounded">
													auto_awesome
												</span>
											</span>
											<div class="dashboard-ai-strip__heading">
												<p class="dashboard-ai-strip__eyebrow">
													Resumen del día
												</p>
												<p class="dashboard-ai-strip__status" data-ai-summary-status>
													Leyendo la agenda de hoy
												</p>
											</div>
										</div>
										<button
											type="button"
											class="dashboard-ai-strip__action"
											data-open-ai-summary-modal
											hidden
										>
											<span class="dashboard-ai-strip__action-label">Ver más</span>
											<span class="dashboard-ai-strip__action-icon" aria-hidden="true">
												<span class="material-symbols-rounded">arrow_forward</span>
											</span>
										</button>
										<div class="dashboard-ai-strip__skeleton" aria-hidden="true">
											<span class="dashboard-ai-strip__skel-line dashboard-ai-strip__skel-line--lg"></span>
											<span class="dashboard-ai-strip__skel-line dashboard-ai-strip__skel-line--md"></span>
										</div>
										<p class="dashboard-ai-strip__text" data-ai-summary-line>
											{defaultAiSummaryShort}
										</p>
									</div>
								</div>
							</div>

							{
								loadError ? (
									<div class="rounded-xl bg-rose-50 px-5 py-4 text-sm font-semibold text-rose-700 dark:bg-[#3B191E] dark:text-[#FFB4AB] shadow-sm">
										{loadError}
									</div>
								) : null
							}

							{
								!loadError && (
									<>
									<div class="dashboard-floor dashboard-floor--action dashboard-floor--split">
										<div
											id="dashboard-upcoming-appointments"
											class="dashboard-report-shell dashboard-floor__panel p-5 sm:p-7 transition-colors duration-300"
										>
											<div class="dashboard-upcoming-head mb-4 flex items-center justify-between gap-3">
												<div class="min-w-0">
													<h2 class="text-xl font-semibold text-[#1e293b] dark:text-[#E5E7EB]">Próximas citas</h2>
													<p class="dashboard-appointments-subtitle" data-week-subtitle>Siguientes 7 días</p>
												</div>
												<div class="dashboard-appointments-actions">
													<a href="/panel/calendar" class="dashboard-upcoming-create-cta">
														<span class="material-symbols-rounded" aria-hidden="true">add</span>
														Crear cita
													</a>
													<span class="dashboard-appointments-count" data-week-count>{appointmentsCountText}</span>
												</div>
											</div>

											<div class="dashboard-week-glance" aria-label="Próximos 7 días" data-week-glance>
												{
													weekGlance.map((day) => (
														<button
															type="button"
															class:list={[
																'dashboard-week-glance__day',
																day.isToday && 'is-today',
																day.hasAppointments && 'has-appointments',
															]}
															data-week-day={day.iso}
															data-day-count={String(day.appointmentCount)}
															data-day-label={`${day.weekdayName} ${String(day.dayNumber).padStart(2, '0')}`}
															aria-pressed="false"
															aria-label={
																day.appointmentCount === 1
																	? `${day.weekdayName} ${day.dayNumber}, 1 cita`
																	: `${day.weekdayName} ${day.dayNumber}, ${day.appointmentCount} citas`
															}
														>
															<span class="dashboard-week-glance__label">{day.label}</span>
															<span class="dashboard-week-glance__number">{day.dayNumber}</span>
															<span class="dashboard-week-glance__dot" aria-hidden="true"></span>
														</button>
													))
												}
											</div>

											{
												dashboard.upcoming_appointments.length === 0 ? (
													<div class="rounded-xl bg-[#F8F9FA] dark:bg-(--surface-container) px-6 py-8 text-center transition-colors duration-300" data-week-idle>
														<div class="w-14 h-14 bg-white dark:bg-[#2B2D31] rounded-full flex items-center justify-center mx-auto mb-3 shadow-[0_4px_15px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_15px_rgba(0,0,0,0.2)] transition-colors duration-300">
															<span class="material-symbols-rounded text-[#BDC1C6] dark:text-[#C4C7C5] text-2xl">event_busy</span>
														</div>
														<p class="text-base font-medium text-[#64748b] dark:text-[#C4C7C5]">Agenda libre.</p>
														<a href="/panel/calendar" class="dashboard-appointments-see-all">
															Ver agenda
														</a>
													</div>
												) : (
													<div class="dashboard-report-list" data-week-list>
														{
															dashboard.upcoming_appointments.map((appointment) => {
																const appointmentDateLabel = formatUpcomingAppointmentDate(
																	appointment.appointment_date || ''
																);

																return (
																	<article
																		class:list={[
																			'dashboard-report-card',
																			appointment.status === 'CONFIRMADO' && 'is-confirmed',
																			appointment.status === 'PENDIENTE' && 'is-pending',
																			appointment.status === 'CANCELADO' && 'is-canceled',
																		]}
																		data-appointment-date={appointment.appointment_date || ''}
																	>
																		<div class="dashboard-report-time">
																			<span class="dashboard-report-time__hour">{appointment.time_start}</span>
																			<span class="dashboard-report-time__day">{appointmentDateLabel || appointment.time_end}</span>
																		</div>
																		<div class="dashboard-report-main">
																			<h3 class="dashboard-report-title">{appointment.customer_name}</h3>
																			<p class="dashboard-report-service">{appointment.service_name}</p>
																			<p class="dashboard-report-meta">{appointment.time_start} - {appointment.time_end}</p>
																		</div>
																		<span
																			class:list={[
																				'dashboard-report-status',
																				appointment.status === 'CONFIRMADO' ? 'dashboard-report-status--confirmed' :
																				appointment.status === 'PENDIENTE' ? 'dashboard-report-status--pending' :
																				appointment.status === 'CANCELADO' ? 'dashboard-report-status--canceled' :
																				'dashboard-report-status--default'
																			]}
																		>
																			{getStatusLabel(appointment.status)}
																		</span>
																	</article>
																);
															})
														}
													</div>
												)
											}

											<div class="dashboard-day-empty" data-day-empty hidden>
												<div class="w-14 h-14 bg-white dark:bg-[#2B2D31] rounded-full flex items-center justify-center mx-auto mb-3 shadow-[0_4px_15px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_15px_rgba(0,0,0,0.2)]">
													<span class="material-symbols-rounded text-[#BDC1C6] dark:text-[#C4C7C5] text-2xl">event_busy</span>
												</div>
												<p class="text-base font-medium text-[#64748b] dark:text-[#C4C7C5]" data-day-empty-copy>
													No hay citas este día.
												</p>
												<a href="/panel/calendar" class="dashboard-appointments-see-all">
													Ver agenda
												</a>
											</div>

											{
												dashboard.upcoming_appointments.length > 0 ? (
													<a href="/panel/calendar" class="dashboard-appointments-see-all dashboard-appointments-see-all--list" data-week-see-all>
														Ver agenda
													</a>
												) : null
											}

											{
												showAppointmentPagination ? (
													<AppPagination
														class="dashboard-appointments-pagination"
														currentPage={safeCurrentPage}
														totalPages={totalAppointmentPages}
														totalRecords={appointmentPagination.total_records}
														recordLabel="citas"
														ariaLabel="Paginación próximas citas"
														prevHref={canPrevPage ? toPageHref(safeCurrentPage - 1) : undefined}
														nextHref={canNextPage ? toPageHref(safeCurrentPage + 1) : undefined}
														pageHrefs={appointmentPageHrefs}
													/>
												) : null
											}
										</div>

										<aside
											class:list={[
												'dashboard-week-chart',
												'dashboard-floor__panel',
												weekChartEmpty && 'is-empty',
											]}
											aria-label={`Citas por día. ${weekChartAria}`}
										>
											<div class="dashboard-week-chart__inner">
												<div class="dashboard-week-chart__head">
													<div class="min-w-0">
														<h2 class="text-xl font-semibold text-[#1e293b] dark:text-[#E5E7EB]">Citas por día</h2>
														<p class="dashboard-appointments-subtitle">Siguientes 7 días</p>
													</div>
													<span class="dashboard-appointments-count">{weekChartCountText}</span>
												</div>

												<div class="dashboard-week-chart__plot" role="img" aria-hidden="true">
													{
														weekGlance.map((day) => (
															<div
																class:list={[
																	'dashboard-week-chart__col',
																	day.isToday && 'is-today',
																	!day.hasAppointments && 'is-empty',
																]}
																title={
																	day.isToday
																		? `Hoy · ${day.appointmentCount} ${day.appointmentCount === 1 ? 'cita' : 'citas'}`
																		: `${day.weekdayName} ${String(day.dayNumber).padStart(2, '0')} · ${day.appointmentCount} ${day.appointmentCount === 1 ? 'cita' : 'citas'}`
																}
															>
																<span class="dashboard-week-chart__value">
																	{day.appointmentCount}
																</span>
																<span class="dashboard-week-chart__track">
																	<span
																		class="dashboard-week-chart__bar"
																		style={`--h:${Math.max(day.barPct, day.hasAppointments ? 12 : 6)}`}
																	></span>
																</span>
																<span class="dashboard-week-chart__label">{day.label}</span>
																<span class="dashboard-week-chart__number">{day.dayNumber}</span>
															</div>
														))
													}
												</div>

												{
													weekChartEmpty ? (
														<p class="dashboard-week-chart__idle">Aún no hay citas en los próximos 7 días.</p>
													) : null
												}
											</div>
										</aside>
									</div>
								</>
							)
						}
						</section>
					</div>

					{FEATURE_FLAGS.APPOINTMENT_AI_VOICE && (
						<button
							type="button"
							class="dashboard-cita-fab"
							data-open-appointment-voice
							data-appointment-voice-mode="inline"
							aria-label="Agenda rápida"
						>
							<span class="material-symbols-rounded dashboard-cita-fab__icon" aria-hidden="true">auto_awesome</span>
						</button>
					)}
				</main>
			</div>
		</div>
	</div>
	<AiChatPanel />
	<appointment-voice-host>
		<AppointmentModalPanel />
	</appointment-voice-host>
	{FEATURE_FLAGS.APPOINTMENT_AI_VOICE && <AppointmentVoiceOverlay />}
	{FEATURE_FLAGS.APPOINTMENT_AI_VOICE && <AgendaScanPreview />}
	<AppAlert />

	<dialog
		class="dashboard-ai-modal dashboard-ai-drawer m-0 max-h-none w-full max-w-none border-0 bg-transparent p-0 text-(--on-surface) shadow-none open:flex"
		data-ai-summary-modal
	>
		<div class="dashboard-ai-drawer__panel relative flex flex-col overflow-hidden border-(--shell-border) bg-(--surface-bright)">
			<div class="dashboard-ai-drawer__handle" aria-hidden="true">
				<span class="dashboard-ai-drawer__handle-pill"></span>
			</div>
			<div class="dashboard-ai-modal__header">
				<div class="dashboard-ai-modal__title-wrap">
					<div class="dashboard-ai-modal__mark">
						<span class="material-symbols-rounded">auto_awesome</span>
					</div>
					<h2 class="dashboard-ai-modal__title">Resumen del día</h2>
				</div>
				<button
					type="button"
					class="dashboard-ai-modal__close"
					data-close-ai-summary-modal
					aria-label="Cerrar resumen"
				>
					<span class="material-symbols-rounded">close</span>
				</button>
			</div>
			<div class="dashboard-ai-modal__body overflow-y-auto overscroll-contain min-h-0 flex-1 px-4 pb-6 pt-1 sm:px-6 sm:pb-7">
				<div
					class="dashboard-ai-sections dashboard-ai-sections--modal"
					data-ai-summary-modal-sections
					aria-live="polite"
				></div>
			</div>
		</div>
	</dialog>
</Layout>

<script>
	import '../../scripts/appointment-voice-overlay';
	import '../../scripts/calendar/appointment-modal';
	import '../../scripts/appointment-voice-host';
	import { initFadeContent } from '../../lib/fade-content';
	import { initDashboardGreeting } from '../../lib/dashboard-greeting';
	import { lockPanelScroll } from '../../lib/panel-scroll-lock';

	const normalizeAiSummaryBase = (value: unknown): string =>
		String(value ?? '')
			.replace(/\\r\\n|\\n|\\r/g, '\n')
			.replace(/\r\n|\r/g, '\n')
			.replace(/\t/g, ' ')
			.replace(/\u0000/g, '')
			.replace(/[ ]{2,}/g, ' ')
			.replace(/[ \t]*\n[ \t]*/g, ' ')
			.replace(/\n{2,}/g, ' ')
			.replace(/^\s*["'`]/, '')
			.replace(/["'`]\s*$/, '')
			.trim();

	const sanitizeAiSummary = (value: unknown): string =>
		normalizeAiSummaryBase(value).replace(/\*\*/g, '').replace(/\*/g, '');

	const SUMMARY_HIGHLIGHT_NUMERIC = new RegExp(
		String.raw`\d+(?:[.,]\d+)?(?:\s+(?:%|por ciento|clientes?(?:\s+activos?)?|citas?(?:\s+(?:pendientes?|confirmadas?|activas?))?|pacientes?|días?|horas?|servicios?|activos?|pendientes?|confirmadas?)){0,2}`,
		'giu'
	);

	const appendAiSummaryHighlight = (
		parent: HTMLElement,
		text: string,
		sectionType: AiSummarySectionType
	) => {
		const strong = document.createElement('strong');
		strong.className = `dashboard-ai-highlight dashboard-ai-highlight--${sectionType}`;
		strong.textContent = text;
		parent.appendChild(strong);
	};

	const appendEnrichedSummaryText = (
		parent: HTMLElement,
		rawText: string,
		sectionType: AiSummarySectionType
	) => {
		const text = normalizeAiSummaryBase(rawText);
		if (!text) return;

		const parts = text.split(/(\*\*[^*]+\*\*)/g);
		for (const part of parts) {
			if (!part) continue;

			const boldMatch = /^\*\*(.+)\*\*$/.exec(part);
			if (boldMatch) {
				appendAiSummaryHighlight(parent, boldMatch[1], sectionType);
				continue;
			}

			SUMMARY_HIGHLIGHT_NUMERIC.lastIndex = 0;
			let lastIndex = 0;
			let match: RegExpExecArray | null;

			while ((match = SUMMARY_HIGHLIGHT_NUMERIC.exec(part)) !== null) {
				if (match.index > lastIndex) {
					parent.appendChild(document.createTextNode(part.slice(lastIndex, match.index)));
				}
				appendAiSummaryHighlight(parent, match[0].trim(), sectionType);
				lastIndex = match.index + match[0].length;
			}

			if (lastIndex < part.length) {
				parent.appendChild(document.createTextNode(part.slice(lastIndex)));
			}
		}
	};

	const splitSummaryIntoTokens = (text: string): string[] =>
		String(text || '')
			.split(/(\s+)/)
			.filter((token) => token.length > 0);

	type AiSummarySectionType = 'panorama' | 'contexto' | 'sugerencia';

	interface AiSummarySection {
		type: AiSummarySectionType;
		text?: string;
		items?: string[];
	}

	interface AiSummaryPayload {
		summaryShort: string;
		summaryFull: string;
		sections: AiSummarySection[];
	}

	const AI_SUMMARY_SECTION_UI: Record<
		AiSummarySectionType,
		{ title: string; icon: string }
	> = {
		panorama: { title: 'Panorama', icon: 'insights' },
		contexto: { title: 'Contexto', icon: 'fact_check' },
		sugerencia: { title: 'Sugerencia', icon: 'auto_awesome' },
	};

	const normalizeAiSummarySection = (value: unknown): AiSummarySection | null => {
		if (!value || typeof value !== 'object') return null;

		const source = value as Record<string, unknown>;
		const typeRaw = String(source.type ?? '').trim().toLowerCase();
		if (typeRaw !== 'panorama' && typeRaw !== 'contexto' && typeRaw !== 'sugerencia') {
			return null;
		}

		if (typeRaw === 'contexto') {
			const items = (Array.isArray(source.items) ? source.items : [])
				.map((item) => normalizeAiSummaryBase(item))
				.filter(Boolean)
				.slice(0, 3);
			return { type: typeRaw, items };
		}

		const text = normalizeAiSummaryBase(source.text);
		if (!text) return null;
		return { type: typeRaw, text };
	};

	const buildSectionsFromLegacy = (legacyFull: string): AiSummarySection[] => {
		const lines = String(legacyFull || '')
			.replace(/\r\n|\r/g, '\n')
			.split('\n')
			.map((line) => sanitizeAiSummary(line))
			.filter(Boolean);

		if (lines.length === 0) {
			return [
				{ type: 'panorama', text: 'Tu jornada está lista para arrancar con buen pie.' },
				{ type: 'contexto', items: [] },
				{
					type: 'sugerencia',
					text: 'Conviene revisar tu agenda y confirmar los turnos pendientes.',
				},
			];
		}

		if (lines.length === 1 && lines[0].length > 180) {
			const sentences =
				lines[0].match(/[^.!?]+[.!?]+(?:\s|$)|[^.!?]+$/g)?.map((part) => sanitizeAiSummary(part)).filter(Boolean) ??
				[lines[0]];
			if (sentences.length >= 3) {
				return [
					{ type: 'panorama', text: sentences[0] },
					{ type: 'contexto', items: sentences.slice(1, -1).slice(0, 3) },
					{ type: 'sugerencia', text: sentences[sentences.length - 1] },
				];
			}
			if (sentences.length === 2) {
				return [
					{ type: 'panorama', text: sentences[0] },
					{ type: 'contexto', items: [] },
					{ type: 'sugerencia', text: sentences[1] },
				];
			}
		}

		return [
			{ type: 'panorama', text: lines[0] },
			{ type: 'contexto', items: lines.length > 2 ? lines.slice(1, -1) : [] },
			{
				type: 'sugerencia',
				text:
					lines.length >= 2
						? lines[lines.length - 1]
						: 'Conviene revisar tu agenda y confirmar los turnos pendientes.',
			},
		];
	};

	const truncatePreviewText = (text: string, maxChars = 320): string => {
		const clean = sanitizeAiSummary(text);
		if (clean.length <= maxChars) return clean;

		const slice = clean.slice(0, maxChars);
		const lastSpace = slice.lastIndexOf(' ');
		const safeCut = lastSpace > 200 ? slice.slice(0, lastSpace) : slice;
		return `${safeCut.trim()}…`;
	};

	const normalizeForCompare = (text: string): string =>
		sanitizeAiSummary(text).toLowerCase().replace(/\s+/g, ' ');

	const textsAreRedundant = (candidate: string, existing: string): boolean => {
		const c = normalizeForCompare(candidate);
		const e = normalizeForCompare(existing);
		if (!c || !e) return true;
		if (e === c || e.includes(c) || c.includes(e)) return true;

		const cWords = c.split(' ').filter((word) => word.length > 3);
		const eWords = new Set(e.split(' ').filter((word) => word.length > 3));
		if (cWords.length === 0) return true;

		const shared = cWords.filter((word) => eWords.has(word)).length;
		if (shared / cWords.length >= 0.55) return true;

		const greeting = c.match(/^(buenos días|buenas tardes|buenas noches)[,!.\s]+/i);
		if (greeting && e.includes(greeting[0].toLowerCase().trim())) {
			const cBody = c.slice(greeting[0].length).trim();
			const eBody = e.replace(/^(buenos días|buenas tardes|buenas noches)[,!.\s]+/i, '').trim();
			if (!cBody || eBody.includes(cBody.slice(0, Math.min(cBody.length, 40)))) return true;

			const cBodyWords = cBody.split(' ').filter((word) => word.length > 3);
			const eBodyWords = new Set(eBody.split(' ').filter((word) => word.length > 3));
			const bodyShared = cBodyWords.filter((word) => eBodyWords.has(word)).length;
			if (cBodyWords.length > 0 && bodyShared / cBodyWords.length >= 0.5) return true;
		}

		return false;
	};

	const buildMobilePreviewContent = (
		summaryShort: string,
		summaryFull: string,
		sections: AiSummarySection[]
	): { intro: string; highlights: string[] } => {
		const short = sanitizeAiSummary(summaryShort);
		const highlights: string[] = [];
		const combined = () => [short, ...highlights].filter(Boolean).join(' ');

		const tryAddExtra = (text: string) => {
			const clean = sanitizeAiSummary(text);
			if (!clean || textsAreRedundant(clean, combined())) return;
			highlights.push(clean);
		};

		for (const item of sections.find((section) => section.type === 'contexto')?.items ?? []) {
			tryAddExtra(item);
			if (highlights.length >= 2) break;
		}

		if (highlights.length < 2) {
			const sugerencia = sections.find((section) => section.type === 'sugerencia')?.text;
			if (sugerencia) tryAddExtra(sugerencia);
		}

		return {
			intro: truncatePreviewText(short || summaryFull, 220),
			highlights,
		};
	};

	const renderMobilePreview = (
		container: HTMLElement,
		content: { intro: string; highlights: string[] }
	) => {
		container.replaceChildren();

		if (content.intro) {
			const intro = document.createElement('p');
			intro.className = 'dashboard-ai-preview-intro';
			intro.textContent = content.intro;
			container.appendChild(intro);
		}

		if (content.highlights.length === 0) return;

		const list = document.createElement('ul');
		list.className = 'dashboard-ai-preview-highlights';
		for (const item of content.highlights) {
			const listItem = document.createElement('li');
			listItem.textContent = item;
			list.appendChild(listItem);
		}
		container.appendChild(list);
	};

	const summaryHasExpandedDetail = (
		summaryShort: string,
		summaryFull: string,
		sections: AiSummarySection[]
	): boolean => {
		if (sections.some((section) => sectionHasVisibleContent(section))) {
			return sections.length > 1 || (sections[0]?.text?.length ?? 0) > summaryShort.length + 24;
		}

		return summaryFull.replace(/\s+/g, ' ').trim() !== summaryShort.replace(/\s+/g, ' ').trim();
	};

	const normalizeAiSummarySections = (
		value: unknown,
		legacyFull: string
	): AiSummarySection[] => {
		const sections = (Array.isArray(value) ? value : [])
			.map(normalizeAiSummarySection)
			.filter((item): item is AiSummarySection => item !== null);

		if (sections.length > 0) return sections;
		return buildSectionsFromLegacy(legacyFull);
	};

	const sectionHasVisibleContent = (section: AiSummarySection): boolean => {
		if (section.type === 'contexto') {
			return (section.items ?? []).some((item) => Boolean(sanitizeAiSummary(item)));
		}
		return Boolean(sanitizeAiSummary(section.text));
	};

	const renderAiSummarySections = (
		container: HTMLElement,
		sections: AiSummarySection[],
		variant: 'card' | 'modal'
	) => {
		container.replaceChildren();
		container.classList.remove('dashboard-ai-sections--animate');

		let staggerIndex = 0;

		for (const section of sections) {
			if (!sectionHasVisibleContent(section)) continue;

			const meta = AI_SUMMARY_SECTION_UI[section.type];
			const article = document.createElement('article');
			article.className = `dashboard-ai-section dashboard-ai-section--${section.type}`;

			if (variant === 'modal') {
				article.classList.add('dashboard-ai-section--stagger');
				article.style.setProperty('--ai-section-index', String(staggerIndex));
				staggerIndex += 1;
			}

			const header = document.createElement('div');
			header.className = 'dashboard-ai-section__header';

			const iconWrap = document.createElement('span');
			iconWrap.className = 'dashboard-ai-section__icon';
			iconWrap.setAttribute('aria-hidden', 'true');
			const icon = document.createElement('span');
			icon.className = 'material-symbols-rounded';
			icon.textContent = meta.icon;
			iconWrap.appendChild(icon);

			const title = document.createElement('h3');
			title.className = 'dashboard-ai-section__title';
			title.textContent = meta.title;

			header.appendChild(iconWrap);
			header.appendChild(title);
			article.appendChild(header);

			if (section.type === 'contexto') {
				const list = document.createElement('ul');
				list.className = 'dashboard-ai-section__list';
				for (const item of section.items ?? []) {
					const cleanItem = normalizeAiSummaryBase(item);
					if (!cleanItem) continue;
					const listItem = document.createElement('li');
					appendEnrichedSummaryText(listItem, cleanItem, section.type);
					list.appendChild(listItem);
				}
				if (list.childElementCount === 0) continue;
				article.appendChild(list);
			} else {
				const body = document.createElement('p');
				body.className = 'dashboard-ai-section__text';
				appendEnrichedSummaryText(body, section.text ?? '', section.type);
				article.appendChild(body);
			}

			container.appendChild(article);
		}
	};

	const wait = (ms: number): Promise<void> => new Promise((resolve) => window.setTimeout(resolve, ms));

	const getTokenDelayMs = () => 28 + Math.floor(Math.random() * 53);

	const streamSummaryTokens = async (node: HTMLElement, text: string): Promise<void> => {
		node.replaceChildren();

		const tokens = splitSummaryIntoTokens(text);
		for (const token of tokens) {
			if (/^\s+$/.test(token)) {
				node.appendChild(document.createTextNode(token));
				continue;
			}

			const tokenNode = document.createElement('span');
			tokenNode.className = 'ai-summary-token';
			tokenNode.textContent = token;
			node.appendChild(tokenNode);

			await wait(getTokenDelayMs());
		}
	};

	interface TeamMemberPreview {
		avatarUrl: string;
		label: string;
	}

	interface TeamOverviewPayload {
		totalRecords: number;
		members: TeamMemberPreview[];
	}

	interface TeamOverviewCache {
		expiresAt: number;
		payload: TeamOverviewPayload;
	}

	interface AiSummaryCache {
		dateKey: string;
		roleId: number;
		summaryShort: string;
		summaryFull: string;
		sections: AiSummarySection[];
		savedAt: number;
		expiresAt: number;
	}

	const TEAM_OVERVIEW_CACHE_KEY = 'hasel:dashboard-team-overview:v1';
	const TEAM_OVERVIEW_TTL_MS = 120000;
	const TEAM_OVERVIEW_LIMIT = 4;
	const TEAM_AVATAR_FALLBACK_PALETTE = ['#2563eb', '#0f766e', '#be185d', '#7c3aed'];
	const AI_SUMMARY_CACHE_KEY = 'hasel:dashboard-ai-summary:v5';
	const AI_SUMMARY_TTL_MS = 10 * 60 * 1000;
	const DEFAULT_AI_SUMMARY_SHORT = '¡Buen día! Preparate para una excelente jornada de trabajo.';
	const DEFAULT_AI_SUMMARY_FULL = DEFAULT_AI_SUMMARY_SHORT;
	const DEFAULT_AI_SUMMARY_SECTIONS: AiSummarySection[] = buildSectionsFromLegacy(DEFAULT_AI_SUMMARY_FULL);
	const AI_MODAL_CLOSE_MS = 140;

	let aiSummaryModalSections: AiSummarySection[] = [];
	let aiSummaryModalCloseTimer: number | null = null;
	let unlockAiSummaryScroll: (() => void) | null = null;

	const getDashboardScrollContainer = (): HTMLElement | null =>
		document.querySelector<HTMLElement>('.app-shell > :last-child > main') ??
		document.querySelector<HTMLElement>('.dashboard-content-canvas > main');

	const lockDashboardScrollForAiModal = () => {
		if (unlockAiSummaryScroll) return;
		unlockAiSummaryScroll = lockPanelScroll();
	};

	const unlockDashboardScrollForAiModal = () => {
		unlockAiSummaryScroll?.();
		unlockAiSummaryScroll = null;
	};

	const applyAiSummaryContent = async (payload: AiSummaryPayload) => {
		const card = document.querySelector<HTMLElement>('[data-ai-summary-card]');
		if (!card) return;

		const lineNode = card.querySelector<HTMLElement>('[data-ai-summary-line]');
		const moreButton = card.querySelector<HTMLButtonElement>('[data-open-ai-summary-modal]');
		const fallbackShort =
			sanitizeAiSummary(card.getAttribute('data-default-summary-short')) || DEFAULT_AI_SUMMARY_SHORT;
		const fallbackFull =
			sanitizeAiSummary(card.getAttribute('data-default-summary-full')) || fallbackShort;

		if (!lineNode) return;

		const summaryShort = sanitizeAiSummary(payload.summaryShort) || fallbackShort;
		const summaryFull = sanitizeAiSummary(payload.summaryFull) || summaryShort || fallbackFull;
		const sections =
			payload.sections.length > 0
				? payload.sections
				: buildSectionsFromLegacy(summaryFull || summaryShort);

		aiSummaryModalSections = sections;

		const hasExpandedContent = summaryHasExpandedDetail(summaryShort, summaryFull, sections);
		if (moreButton) {
			moreButton.hidden = !hasExpandedContent;
		}

		const rawPreview = summaryShort || summaryFull;
		const sentenceParts = rawPreview
			.split(/(?<=[.!?])\s+/)
			.map((part) => part.trim())
			.filter(Boolean);
		const lineText =
			sentenceParts.length > 1
				? sentenceParts.slice(0, 2).join(' ')
				: truncatePreviewText(rawPreview, 160);

		lineNode.textContent = lineText;
	};

	const toRecord = (value: unknown): Record<string, unknown> =>
		typeof value === 'object' && value !== null ? (value as Record<string, unknown>) : {};

	const padDatePart = (value: number): string => String(value).padStart(2, '0');

	const getLocalDateKey = (date = new Date()): string =>
		`${date.getFullYear()}-${padDatePart(date.getMonth() + 1)}-${padDatePart(date.getDate())}`;

	const readAiSummaryCache = (dateKey: string, roleId: number): AiSummaryPayload | null => {
		try {
			const rawCache = window.localStorage.getItem(AI_SUMMARY_CACHE_KEY);
			if (!rawCache) return null;

			const parsed = JSON.parse(rawCache) as Partial<AiSummaryCache>;
			if (parsed?.dateKey !== dateKey || Number(parsed?.roleId ?? -1) !== roleId) {
				window.localStorage.removeItem(AI_SUMMARY_CACHE_KEY);
				return null;
			}

			const savedAt = Number(parsed?.savedAt ?? 0);
			const expiresAt = Number(parsed?.expiresAt ?? savedAt + AI_SUMMARY_TTL_MS);
			if (!Number.isFinite(expiresAt) || expiresAt <= Date.now()) {
				window.localStorage.removeItem(AI_SUMMARY_CACHE_KEY);
				return null;
			}

			const summaryShort = sanitizeAiSummary(parsed?.summaryShort);
			const summaryFull = sanitizeAiSummary(parsed?.summaryFull) || summaryShort;
			const sections = normalizeAiSummarySections(parsed?.sections, summaryFull || summaryShort);
			if (!summaryShort && !summaryFull && sections.length === 0) return null;

			return {
				summaryShort: summaryShort || summaryFull,
				summaryFull: summaryFull || summaryShort,
				sections,
			};
		} catch {
			return null;
		}
	};

	const saveAiSummaryCache = (dateKey: string, roleId: number, payload: AiSummaryPayload) => {
		const summaryShort = sanitizeAiSummary(payload.summaryShort);
		const summaryFull = sanitizeAiSummary(payload.summaryFull) || summaryShort;
		const sections = payload.sections.length
			? payload.sections
			: buildSectionsFromLegacy(summaryFull || summaryShort);
		if (!summaryShort && !summaryFull && sections.length === 0) return;

		try {
			const savedAt = Date.now();
			const cacheEntry: AiSummaryCache = {
				dateKey,
				roleId,
				summaryShort: summaryShort || summaryFull,
				summaryFull: summaryFull || summaryShort,
				sections,
				savedAt,
				expiresAt: savedAt + AI_SUMMARY_TTL_MS,
			};
			window.localStorage.setItem(AI_SUMMARY_CACHE_KEY, JSON.stringify(cacheEntry));
		} catch {
			// Ignore storage errors (private mode, quota, or blocked storage).
		}
	};

	const toNonNegativeInt = (value: unknown, fallback = 0): number => {
		const parsed = Number(value);
		if (!Number.isFinite(parsed) || parsed < 0) return fallback;
		return Math.floor(parsed);
	};

	const getTeamMemberLabel = (member: Record<string, unknown>, index: number): string => {
		const user = toRecord(member.user);
		const firstName = String(user.first_name ?? '').trim();
		const lastName = String(user.last_name ?? '').trim();
		const fullName = `${firstName} ${lastName}`.trim();
		const email = String(user.email ?? '').trim();
		return fullName || email || `Miembro ${index + 1}`;
	};

	const normalizeTeamPayload = (value: unknown): TeamOverviewPayload => {
		const source = toRecord(value);
		const rawMembers = Array.isArray(source.members) ? source.members : [];

		const members = rawMembers.slice(0, TEAM_OVERVIEW_LIMIT).map((entry, index) => {
			const sourceMember = toRecord(entry);
			return {
				avatarUrl: String(sourceMember.avatarUrl ?? '').trim(),
				label: String(sourceMember.label ?? '').trim() || `Miembro ${index + 1}`,
			};
		});

		const totalRecords = Math.max(
			members.length,
			toNonNegativeInt(source.totalRecords, members.length)
		);

		return { totalRecords, members };
	};

	const parseTeamOverviewResponse = (value: unknown): TeamOverviewPayload => {
		const source = toRecord(value);
		const data = Array.isArray(source.data) ? source.data : [];
		const meta = toRecord(source.meta);

		const members: TeamMemberPreview[] = data.slice(0, TEAM_OVERVIEW_LIMIT).map((entry, index) => {
			const member = toRecord(entry);
			return {
				avatarUrl: String(
					member.avatar_url ?? member.profile_image_url ?? member.avatarUrl ?? ''
				).trim(),
				label: getTeamMemberLabel(member, index),
			};
		});

		const totalRecords = Math.max(
			members.length,
			toNonNegativeInt(meta.total_records, data.length)
		);

		return { totalRecords, members };
	};

	const readTeamOverviewCache = (): TeamOverviewPayload | null => {
		try {
			const rawCache = window.sessionStorage.getItem(TEAM_OVERVIEW_CACHE_KEY);
			if (!rawCache) return null;

			const parsed = JSON.parse(rawCache) as TeamOverviewCache;
			const expiresAt = Number(parsed?.expiresAt ?? 0);

			if (!Number.isFinite(expiresAt) || expiresAt <= Date.now()) {
				window.sessionStorage.removeItem(TEAM_OVERVIEW_CACHE_KEY);
				return null;
			}

			return normalizeTeamPayload(parsed?.payload);
		} catch {
			return null;
		}
	};

	const saveTeamOverviewCache = (payload: TeamOverviewPayload) => {
		try {
			const cacheEntry: TeamOverviewCache = {
				expiresAt: Date.now() + TEAM_OVERVIEW_TTL_MS,
				payload,
			};
			window.sessionStorage.setItem(TEAM_OVERVIEW_CACHE_KEY, JSON.stringify(cacheEntry));
		} catch {
			// Ignore storage errors (private mode, quota, or blocked storage).
		}
	};

	const getTeamSummaryText = (totalRecords: number): string => {
		const extraMembers = Math.max(0, totalRecords - 1);
		if (totalRecords <= 0) return 'Equipo activo';
		if (extraMembers <= 0) return 'Equipo activo';
		return `Equipo activo · +${extraMembers} ${extraMembers === 1 ? 'miembro' : 'miembros'}`;
	};

	const getMemberInitials = (label: string): string => {
		const tokens = String(label || '')
			.split(/\s+/)
			.filter(Boolean);
		if (tokens.length === 0) return 'TM';
		if (tokens.length === 1) return tokens[0].slice(0, 2).toUpperCase();
		return `${tokens[0][0] || ''}${tokens[1][0] || ''}`.toUpperCase();
	};

	const renderAvatarStack = (stackNode: HTMLElement, payload: TeamOverviewPayload) => {
		stackNode.replaceChildren();

		const visibleMembers = payload.members.slice(0, TEAM_OVERVIEW_LIMIT);
		for (const [index, member] of visibleMembers.entries()) {
			const avatar = document.createElement('span');
			avatar.className = 'team-avatar';
			avatar.title = member.label;
			avatar.setAttribute('aria-label', member.label);

			if (member.avatarUrl) {
				const image = document.createElement('img');
				image.src = member.avatarUrl;
				image.alt = member.label;
				image.loading = 'lazy';
				image.decoding = 'async';
				avatar.appendChild(image);
			} else {
				avatar.classList.add('team-avatar--fallback');
				avatar.style.background =
					TEAM_AVATAR_FALLBACK_PALETTE[index % TEAM_AVATAR_FALLBACK_PALETTE.length];
				avatar.textContent = getMemberInitials(member.label);
			}

			stackNode.appendChild(avatar);
		}

		const extraCount = Math.max(0, payload.totalRecords - visibleMembers.length);
		if (extraCount > 0) {
			const more = document.createElement('span');
			more.className = 'team-avatar team-avatar--more';
			more.textContent = `+${extraCount}`;
			more.setAttribute('aria-label', `${extraCount} miembros mas`);
			stackNode.appendChild(more);
		}

		if (stackNode.childElementCount === 0) {
			const placeholder = document.createElement('span');
			placeholder.className = 'team-avatar team-avatar--placeholder';
			stackNode.appendChild(placeholder);
		}
	};

	const renderTeamOverview = (
		card: HTMLElement,
		payload: TeamOverviewPayload,
		source: 'cache' | 'network'
	) => {
		const summaryNode = card.querySelector<HTMLElement>('[data-team-summary]');
		const stateNode = card.querySelector<HTMLElement>('[data-team-state]');
		const avatarStackNode = card.querySelector<HTMLElement>('[data-team-avatar-stack]');

		if (!summaryNode || !stateNode || !avatarStackNode) return;

		summaryNode.textContent = getTeamSummaryText(payload.totalRecords);
		renderAvatarStack(avatarStackNode, payload);
		stateNode.classList.remove('team-overview-state--error');

		if (payload.totalRecords === 0) {
			stateNode.textContent = 'Aún no hay profesionales registrados.';
			stateNode.classList.remove('hidden');
			stateNode.classList.add('team-overview-state--empty');
			return;
		}

		stateNode.classList.add('hidden');
		stateNode.classList.remove('team-overview-state--empty');
		stateNode.textContent = '';
	};

	const fetchTeamOverview = async (): Promise<TeamOverviewPayload> => {
		const response = await fetch(`/api/professionals?page=1&limit=${TEAM_OVERVIEW_LIMIT}`, {
			headers: { Accept: 'application/json' },
		});
		const payload = await response.json();

		if (!response.ok || payload?.status !== 'success') {
			throw new Error(payload?.message || 'No fue posible cargar el equipo.');
		}

		return parseTeamOverviewResponse(payload);
	};

	const loadTeamOverview = async () => {
		const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-team-card]'));
		if (cards.length === 0) return;

		const cachedPayload = readTeamOverviewCache();
		if (cachedPayload) {
			for (const card of cards) {
				renderTeamOverview(card, cachedPayload, 'cache');
			}
			return;
		}

		try {
			const teamPayload = await fetchTeamOverview();
			saveTeamOverviewCache(teamPayload);
			for (const card of cards) {
				renderTeamOverview(card, teamPayload, 'network');
			}
		} catch (error) {
			const message =
				error instanceof Error ? error.message : 'No fue posible cargar el equipo de trabajo.';
			for (const card of cards) {
				const stateNode = card.querySelector<HTMLElement>('[data-team-state]');
				if (!stateNode) continue;
				stateNode.classList.remove('team-overview-state--empty');
				stateNode.classList.remove('hidden');
				stateNode.textContent = message;
				stateNode.classList.add('team-overview-state--error');
			}
		}
	};

	const openAiSummaryModal = () => {
		const modal = document.querySelector<HTMLDialogElement>('[data-ai-summary-modal]');
		const modalSections = document.querySelector<HTMLElement>('[data-ai-summary-modal-sections]');
		if (!modal || !modalSections) return;

		renderAiSummarySections(modalSections, aiSummaryModalSections, 'modal');
		modalSections.classList.remove('dashboard-ai-sections--animate');
		void modalSections.offsetWidth;
		modalSections.classList.add('dashboard-ai-sections--animate');
		modal.classList.remove('is-closing');

		if (aiSummaryModalCloseTimer) {
			window.clearTimeout(aiSummaryModalCloseTimer);
			aiSummaryModalCloseTimer = null;
		}

		if (!modal.open) {
			lockDashboardScrollForAiModal();
			modal.showModal();
		}
	};

	const closeAiSummaryModal = () => {
		const modal = document.querySelector<HTMLDialogElement>('[data-ai-summary-modal]');
		if (!modal?.open || modal.classList.contains('is-closing')) return;

		modal.classList.add('is-closing');
		if (aiSummaryModalCloseTimer) window.clearTimeout(aiSummaryModalCloseTimer);

		aiSummaryModalCloseTimer = window.setTimeout(() => {
			aiSummaryModalCloseTimer = null;
			modal.close();
			modal.classList.remove('is-closing');
		}, AI_MODAL_CLOSE_MS);
	};

	const bindAiSummaryModalEvents = () => {
		const modal = document.querySelector<HTMLDialogElement>('[data-ai-summary-modal]');
		if (!modal || modal.dataset.bound === '1') return;
		modal.dataset.bound = '1';

		modal.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			if (target.closest('[data-close-ai-summary-modal]')) {
				closeAiSummaryModal();
				return;
			}
			if (target === modal) closeAiSummaryModal();
		});

		modal.addEventListener('cancel', (event) => {
			event.preventDefault();
			closeAiSummaryModal();
		});

		modal.addEventListener('close', () => {
			modal.classList.remove('is-closing');
			unlockDashboardScrollForAiModal();
		});

		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			if (target.closest('[data-open-ai-summary-modal]')) {
				openAiSummaryModal();
			}
		});
	};

	const loadAiSummary = async () => {
		const card = document.querySelector<HTMLElement>('[data-ai-summary-card]');
		if (!card) return;

		if (card.getAttribute('data-ai-summary-loaded') === '1') return;
		card.setAttribute('data-ai-summary-loaded', '1');

		const lineNode = card.querySelector<HTMLElement>('[data-ai-summary-line]');
		const roleId = Number(card.getAttribute('data-role-id') ?? '0');
		const fallbackShort =
			sanitizeAiSummary(card.getAttribute('data-default-summary-short')) || DEFAULT_AI_SUMMARY_SHORT;
		const fallbackFull =
			sanitizeAiSummary(card.getAttribute('data-default-summary-full')) || fallbackShort;
		const fallbackSections = buildSectionsFromLegacy(fallbackFull);

		if (!lineNode) return;

		bindAiSummaryModalEvents();

		const revealSummary = async (payload: AiSummaryPayload) => {
			card.classList.remove('is-generating');
			card.setAttribute('aria-busy', 'false');
			await applyAiSummaryContent(payload);
		};

		const todayKey = getLocalDateKey();
		const cachedSummary = readAiSummaryCache(todayKey, roleId);

		if (cachedSummary) {
			await revealSummary(cachedSummary);
			return;
		}

		card.setAttribute('aria-busy', 'true');
		card.classList.add('is-generating');
		lineNode.textContent = 'Leyendo la agenda de hoy.';

		try {
			const response = await fetch('/api/dashboard/ai-summary', {
				headers: { Accept: 'application/json' },
			});
			const payload = await response.json();

			if (!response.ok || payload?.status !== 'success') {
				throw new Error(payload?.message || 'No fue posible recuperar el resumen IA.');
			}

			const summaryShort = sanitizeAiSummary(payload?.data?.ai_summary_short);
			const summaryFull = sanitizeAiSummary(payload?.data?.ai_summary);
			const sections = normalizeAiSummarySections(
				payload?.data?.ai_summary_sections,
				summaryFull || summaryShort
			);
			if (!summaryShort && !summaryFull && sections.length === 0) {
				throw new Error('El resumen IA no está disponible en este momento.');
			}

			const normalizedSummary: AiSummaryPayload = {
				summaryShort: summaryShort || summaryFull,
				summaryFull: summaryFull || summaryShort,
				sections,
			};

			saveAiSummaryCache(todayKey, roleId, normalizedSummary);
			await revealSummary(normalizedSummary);
		} catch {
			await revealSummary({
				summaryShort: fallbackShort,
				summaryFull: fallbackFull,
				sections: fallbackSections,
			});
		}
	};

	const formatGs = (value: unknown): string => {
		const amount = Number(value);
		const safe = Number.isFinite(amount) && amount > 0 ? Math.round(amount) : 0;
		return `Gs. ${safe.toLocaleString('es-PY')}`;
	};

	const dismissProfitabilityPanel = (panel: HTMLElement) => {
		panel.dataset.loaded = '';
		panel.setAttribute('aria-busy', 'false');
		panel.classList.remove('is-loading', 'is-ready');
		panel.classList.add('is-dismissed');
		window.setTimeout(() => {
			if (!panel.classList.contains('is-dismissed')) return;
			panel.hidden = true;
			panel.classList.add('hidden');
		}, 280);
	};

	const loadProfitability = async () => {
		const panel = document.querySelector<HTMLElement>('[data-profitability-panel]');
		if (!panel) return;
		if (panel.dataset.loaded === '1') return;
		panel.dataset.loaded = '1';
		panel.hidden = false;
		panel.classList.remove('hidden', 'is-dismissed', 'is-ready');
		panel.classList.add('is-loading');
		panel.setAttribute('aria-busy', 'true');

		try {
			const response = await fetch('/api/dashboard/profitability', {
				headers: { Accept: 'application/json' },
			});
			const payload = await response.json();

			// 403 (no admin/feature) u otros errores: ocultamos sin salto brusco.
			if (!response.ok || payload?.status !== 'success' || !payload?.data) {
				dismissProfitabilityPanel(panel);
				return;
			}

			const data = payload.data as Record<string, unknown>;

			const setText = (selector: string, text: string) => {
				const node = panel.querySelector<HTMLElement>(selector);
				if (node) node.textContent = text;
			};

			setText('[data-profit-month-revenue]', formatGs(data.month_revenue));
			setText('[data-profit-new-clients]', String(Number(data.new_clients_month ?? 0)));

			panel.hidden = false;
			panel.classList.remove('hidden', 'is-dismissed', 'is-loading');
			panel.setAttribute('aria-busy', 'false');
			panel.classList.add('is-ready');
		} catch {
			dismissProfitabilityPanel(panel);
		}
	};

	const playDashboardIntro = () => {
		const main = document.querySelector<HTMLElement>('[data-dashboard-main]');
		if (!main) return;
		initFadeContent(main, { immediate: true });
		initDashboardGreeting(main);
	};

	const applyUpcomingDayFilter = (shell: HTMLElement, iso: string) => {
		const glance = shell.querySelector<HTMLElement>('[data-week-glance]');
		const list = shell.querySelector<HTMLElement>('[data-week-list]');
		const idle = shell.querySelector<HTMLElement>('[data-week-idle]');
		const empty = shell.querySelector<HTMLElement>('[data-day-empty]');
		const emptyCopy = shell.querySelector<HTMLElement>('[data-day-empty-copy]');
		const subtitle = shell.querySelector<HTMLElement>('[data-week-subtitle]');
		const countNode = shell.querySelector<HTMLElement>('[data-week-count]');
		const seeAll = shell.querySelector<HTMLElement>('[data-week-see-all]');
		const pagination = shell.querySelector<HTMLElement>('.dashboard-appointments-pagination');
		const buttons = [...(glance?.querySelectorAll<HTMLButtonElement>('[data-week-day]') ?? [])];
		const cards = [...(list?.querySelectorAll<HTMLElement>('[data-appointment-date]') ?? [])];
		const selected = buttons.find((button) => button.getAttribute('data-week-day') === iso) ?? null;

		glance?.classList.toggle('is-filtering', Boolean(iso));

		for (const button of buttons) {
			const isSelected = Boolean(iso) && button === selected;
			button.classList.toggle('is-selected', isSelected);
			button.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
		}

		if (!iso) {
			list?.classList.remove('is-day-filtered');
			for (const card of cards) card.classList.remove('is-day-match');
			if (empty) empty.hidden = true;
			if (idle) idle.hidden = false;
			if (list) list.hidden = false;
			if (seeAll) seeAll.hidden = false;
			if (pagination) pagination.hidden = false;
			if (subtitle) subtitle.textContent = 'Siguientes 7 días';
			if (countNode) {
				countNode.textContent = countNode.getAttribute('data-default-count') || '0 citas';
			}
			return;
		}

		const matches = cards.filter((card) => card.getAttribute('data-appointment-date') === iso);
		const dayCount = Number(selected?.getAttribute('data-day-count') || '0');
		const dayLabel = selected?.getAttribute('data-day-label') || '';

		list?.classList.add('is-day-filtered');
		for (const card of cards) {
			card.classList.toggle('is-day-match', card.getAttribute('data-appointment-date') === iso);
		}

		const hasMatches = matches.length > 0;
		if (list) list.hidden = !hasMatches;
		if (idle) idle.hidden = true;
		if (empty) empty.hidden = hasMatches;
		if (seeAll) seeAll.hidden = !hasMatches;
		if (pagination) pagination.hidden = true;

		if (subtitle) subtitle.textContent = dayLabel ? dayLabel.charAt(0).toUpperCase() + dayLabel.slice(1) : 'Ese día';
		if (countNode) {
			const shown = hasMatches ? matches.length : dayCount;
			countNode.textContent = shown === 1 ? '1 cita' : `${shown} citas`;
		}
		if (emptyCopy) {
			emptyCopy.textContent = dayCount > 0 && !hasMatches
				? `Hay ${dayCount === 1 ? '1 cita' : `${dayCount} citas`} este día.`
				: 'No hay citas este día.';
		}
	};

	const bindUpcomingDayFilter = () => {
		const shell = document.getElementById('dashboard-upcoming-appointments');
		if (!shell || shell.dataset.dayFilterBound === '1') return;
		shell.dataset.dayFilterBound = '1';

		const countNode = shell.querySelector<HTMLElement>('[data-week-count]');
		if (countNode && !countNode.getAttribute('data-default-count')) {
			countNode.setAttribute('data-default-count', countNode.textContent?.trim() || '');
		}

		shell.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const button = target.closest<HTMLButtonElement>('[data-week-day]');
			if (!button || !shell.contains(button)) return;

			const iso = button.getAttribute('data-week-day') || '';
			const alreadyOn = button.getAttribute('aria-pressed') === 'true';
			applyUpcomingDayFilter(shell, alreadyOn ? '' : iso);
		});
	};

	const initializeDashboardPage = () => {
		playDashboardIntro();
		loadTeamOverview();
		loadProfitability();
		loadAiSummary();
		bindUpcomingDayFilter();
		scrollToUpcomingAppointmentsIfNeeded();
	};

	if (!(window as unknown as { __haselDashVisibilityBound?: boolean }).__haselDashVisibilityBound) {
		(window as unknown as { __haselDashVisibilityBound?: boolean }).__haselDashVisibilityBound = true;
		const syncPageHidden = () => {
			document.documentElement.toggleAttribute('data-page-hidden', document.hidden);
		};
		syncPageHidden();
		document.addEventListener('visibilitychange', syncPageHidden);
	}

	const UPCOMING_APPOINTMENTS_ANCHOR_ID = 'dashboard-upcoming-appointments';
	const UPCOMING_APPOINTMENTS_SCROLL_OFFSET = 12;

	const shouldScrollToUpcomingAppointments = (): boolean => {
		const url = new URL(window.location.href);
		return (
			url.hash === `#${UPCOMING_APPOINTMENTS_ANCHOR_ID}` ||
			url.searchParams.has('page')
		);
	};

	const scrollToUpcomingAppointments = (behavior: ScrollBehavior = 'smooth') => {
		const target = document.getElementById(UPCOMING_APPOINTMENTS_ANCHOR_ID);
		const container = getDashboardScrollContainer();
		if (!target || !container) return;

		const containerTop = container.getBoundingClientRect().top;
		const targetTop = target.getBoundingClientRect().top;
		const nextScrollTop =
			container.scrollTop + (targetTop - containerTop) - UPCOMING_APPOINTMENTS_SCROLL_OFFSET;

		container.scrollTo({
			top: Math.max(0, nextScrollTop),
			behavior,
		});
	};

	const scrollToUpcomingAppointmentsIfNeeded = () => {
		if (!shouldScrollToUpcomingAppointments()) return;

		const behavior: ScrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches
			? 'auto'
			: 'smooth';

		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				scrollToUpcomingAppointments(behavior);
			});
		});
	};

	// Solo page-load: evita doble init (cancela la animación a mitad).
	document.addEventListener('astro:page-load', initializeDashboardPage);
</script>

