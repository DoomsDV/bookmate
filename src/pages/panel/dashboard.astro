													)}
												</nav>
											</div>

											<a href="/panel/calendar" class="dashboard-appointments-see-all">
												Ver todas en la agenda
												<span class="material-symbols-rounded text-[1.05rem]" aria-hidden="true">arrow_forward</span>
											</a>
										</div>

										{showAlertsPanel && (
											<aside class="dashboard-alerts-shell dashboard-floor__panel rounded-4xl p-5 transition-colors duration-300" data-dashboard-alerts>
												<div class="mb-4 flex shrink-0 items-center justify-between gap-2">
													<h2 class="text-lg font-bold text-[#202124] dark:text-[#E3E3E3]">Pendientes</h2>
												</div>

												<ul
													class:list={[
														'dashboard-alerts-list m-0 grid list-none gap-2.5 p-0',
														pendingConfirmAlerts.length === 0 && 'hidden',
													]}
													data-dashboard-alerts-list
												>
													{
														pendingConfirmAlerts.map((appointment) => (
															<li class="dashboard-alert-item">
																<span class="dashboard-alert-icon dashboard-alert-icon--amber material-symbols-rounded" aria-hidden="true">
																	schedule
																</span>
																<div class="dashboard-alert-body">
																	<p class="dashboard-alert-title">{appointment.customer_name}</p>
																	<p class="dashboard-alert-meta">Cita pendiente de confirmar</p>
																</div>
																<a href="/panel/calendar" class="dashboard-alert-action">Revisar</a>
															</li>
														))
													}
													<li class="dashboard-alert-item dashboard-alert-item--loading" data-dashboard-cobros-alert-slot hidden>
														<span class="dashboard-alert-icon dashboard-alert-icon--rose material-symbols-rounded" aria-hidden="true">
															warning
														</span>
														<div class="dashboard-alert-body">
															<p class="dashboard-alert-title" data-dashboard-cobros-alert-title>Comprobantes por validar</p>
															<p class="dashboard-alert-meta" data-dashboard-cobros-alert-meta>Cargando…</p>
														</div>
														<a href="/panel/cobros?status=pending" class="dashboard-alert-action">Validar</a>
													</li>
												</ul>

												<div
													class:list={[
														'dashboard-alerts-empty',
														pendingConfirmAlerts.length > 0 && 'hidden',
													]}
													data-dashboard-alerts-empty
												>
													<span class="material-symbols-rounded dashboard-alerts-empty__icon" aria-hidden="true">task_alt</span>
													<p class="dashboard-alerts-empty__text">Todo al día. No hay tareas urgentes.</p>
													<div class="dashboard-alerts-empty__actions">
														<a href="/panel/calendar" class="dashboard-alerts-empty__cta">
															<span class="material-symbols-rounded" aria-hidden="true">add</span>
															Crear cita
														</a>
														<a href="/panel/cobros" class="dashboard-alerts-empty__link">Revisar cobros</a>
