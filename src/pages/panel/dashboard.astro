	}

	.dashboard-ai-strip__glow {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		border-radius: inherit;
		pointer-events: none;
	}

	.dashboard-ai-strip__glow::before,
	.dashboard-ai-strip__glow::after {
		content: '';
		position: absolute;
		pointer-events: none;
		filter: blur(40px);
	}

	/* Aurora inferior suave, sin neón */
	.dashboard-ai-strip__glow::before {
		left: -20%;
		right: -10%;
		bottom: -58%;
		height: 88%;
		background:
			radial-gradient(ellipse 55% 48% at 30% 74%, rgba(147, 197, 253, 0.22), transparent 72%),
			radial-gradient(ellipse 48% 42% at 70% 80%, rgba(196, 181, 253, 0.14), transparent 70%),
			radial-gradient(ellipse 42% 38% at 52% 96%, rgba(165, 243, 252, 0.16), transparent 68%);
		opacity: 0.65;
	}

	.dashboard-ai-strip__glow::after {
		left: 40%;
		right: -8%;
		bottom: -42%;
		height: 62%;
		background: radial-gradient(ellipse 50% 45% at 60% 80%, rgba(191, 219, 254, 0.12), transparent 72%);
		opacity: 0.5;
	}

	.dashboard-ai-strip__head,
	.dashboard-ai-strip__skeleton,
	.dashboard-ai-strip__text,
	.dashboard-ai-strip__action {
		position: relative;
		z-index: 1;
	}

	.dashboard-ai-strip__head {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		min-width: 0;
	}

	.dashboard-ai-strip__badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.55rem;
		height: 1.55rem;
		flex-shrink: 0;
		border-radius: 0.45rem;
		background: transparent;
		border: 0;
		box-shadow: none;
	}

	.dashboard-ai-strip__icon {
		font-size: 1.2rem;
		color: var(--primary);
		line-height: 1;
		animation: dashboard-ai-strip-sparkle 3.6s ease-in-out infinite;
	}

	.dashboard-ai-strip__meta {
		position: relative;
		min-width: 0;
		flex: 1 1 auto;
		text-align: left;
	}

	.dashboard-ai-strip__eyebrow {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		text-transform: none;
		color: color-mix(in srgb, var(--primary) 78%, #1d4ed8 22%);
		line-height: 1.25;
	}

	.dashboard-ai-strip__text {
		margin: 0;
		min-width: 0;
		font-size: 0.95rem;
		font-weight: 550;
		line-height: 1.55;
		color: color-mix(in srgb, var(--on-surface) 90%, #0f172a 10%);
		text-align: left;
		white-space: pre-line;
	}

	.dashboard-ai-strip__skeleton {
		display: none;
		flex-direction: column;
		gap: 0.55rem;
		width: 100%;
		padding-top: 0.05rem;
	}

	.dashboard-ai-strip__skel-line {
		display: block;
		height: 0.72rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--primary) 12%, #dbe4f3 88%);
		overflow: hidden;
		position: relative;
	}

	.dashboard-ai-strip__skel-line--lg { width: 100%; }
	.dashboard-ai-strip__skel-line--md { width: 88%; }
	.dashboard-ai-strip__skel-line--sm { width: 64%; }

	.dashboard-ai-strip__skel-line::after {
		content: '';
		position: absolute;
		inset: 0;
		transform: translateX(-120%);
		background: linear-gradient(
			90deg,
			transparent 0%,
			color-mix(in srgb, #ffffff 72%, var(--primary) 28%) 45%,
			transparent 100%
		);
		opacity: 0.75;
	}

	.dashboard-ai-strip__action {
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		align-self: flex-start;
		gap: 0.15rem;
		width: auto;
		min-height: 0;
		margin: 0.1rem 0 0;
		padding: 0.15rem 0;
		border: 0;
		border-radius: 0.35rem;
		background: transparent;
		color: color-mix(in srgb, var(--primary) 72%, var(--on-surface-variant) 28%);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		text-transform: none;
		cursor: pointer;
		text-decoration: none;
		text-align: left;
		transition:
			color 160ms ease,
			opacity 160ms ease;
	}

	.dashboard-ai-strip__action[hidden] {
		display: none !important;
	}

	.dashboard-ai-strip__action-label {
		text-decoration: none;
	}

	.dashboard-ai-strip__action .material-symbols-rounded {
		font-size: 1.05rem;
		line-height: 1;
		opacity: 0.8;
		transition: transform 160ms ease;
	}

	.dashboard-ai-strip__action:hover {
		background: transparent;
		color: var(--primary);
	}

	.dashboard-ai-strip__action:hover .material-symbols-rounded {
		transform: translateX(2px);
	}

	.dashboard-ai-strip__action:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 3px;
	}

	.dashboard-ai-strip.is-generating {
		border-color: color-mix(in srgb, var(--shell-border, #d0d7e2) 82%, transparent);
		box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 6px 16px rgba(15, 23, 42, 0.05);
	}

	.dashboard-ai-strip.is-generating .dashboard-ai-strip__glow::before {
		animation: dashboard-ai-strip-glow 3.2s ease-in-out infinite;
	}

	.dashboard-ai-strip.is-generating .dashboard-ai-strip__head,
	.dashboard-ai-strip.is-generating .dashboard-ai-strip__skeleton,
	.dashboard-ai-strip.is-generating .dashboard-ai-strip__action {
		position: relative;
		z-index: 1;
	}

	.dashboard-ai-strip.is-generating .dashboard-ai-strip__icon {
		animation: dashboard-ai-strip-pulse 1.15s ease-in-out infinite;
	}

	.dashboard-ai-strip.is-generating .dashboard-ai-strip__badge {
		animation: dashboard-ai-strip-badge-glow 1.6s ease-in-out infinite;
	}

	.dashboard-ai-strip.is-generating .dashboard-ai-strip__text {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.dashboard-ai-strip.is-generating .dashboard-ai-strip__skeleton {
		display: flex;
	}

	.dashboard-ai-strip.is-generating .dashboard-ai-strip__skel-line::after {
		animation: dashboard-ai-strip-shimmer 1.55s ease-in-out infinite;
	}

	.dashboard-ai-strip.is-generating .dashboard-ai-strip__skel-line--md::after {
		animation-delay: 120ms;
	}

	.dashboard-ai-strip.is-generating .dashboard-ai-strip__skel-line--sm::after {
		animation-delay: 240ms;
	}

	.dashboard-ai-strip.is-generating .dashboard-ai-strip__action {
		opacity: 0.45;
		pointer-events: none;
	}

	@keyframes dashboard-ai-strip-sparkle {
		0%,
		100% {
			opacity: 0.72;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.06);
		}
	}

	@keyframes dashboard-ai-strip-pulse {
		0%,
		100% {
			opacity: 0.55;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.1);
		}
	}

	@keyframes dashboard-ai-strip-badge-glow {
		0%,
		100% {
			box-shadow: none;
			opacity: 0.85;
		}
		50% {
			box-shadow: none;
			opacity: 1;
		}
	}

	@keyframes dashboard-ai-strip-shimmer {
		0% {
			transform: translateX(-120%);
		}
		100% {
			transform: translateX(130%);
		}
	}

	@keyframes dashboard-ai-strip-glow {
		0%,
		100% {
			opacity: 0.55;
		}
		50% {
			opacity: 1;
		}
	}

