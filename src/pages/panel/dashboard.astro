																<div class="dashboard-alert-body">
																	<p class="dashboard-alert-title">{appointment.customer_name}</p>
																	<p class="dashboard-alert-meta">Cita pendiente de confirmar</p>
																</div>
																<a href="/panel/calendar" class="dashboard-alert-action">Revisar</a>
															</li>
														))
													}
													<li class="dashboard-alert-item dashboard-alert-item--loading" data-dashboard-cobros-alert-slot hidden>
														<span class="dashboard-alert-icon dashboard-alert-icon--rose material-symbols-rounded" aria-hidden="true">
															warning
														</span>
														<div class="dashboard-alert-body">
															<p class="dashboard-alert-title" data-dashboard-cobros-alert-title>Comprobantes por validar</p>
															<p class="dashboard-alert-meta" data-dashboard-cobros-alert-meta>Cargando…</p>
														</div>
														<a href="/panel/cobros?status=pending" class="dashboard-alert-action">Validar</a>
													</li>
												</ul>

												<div
													class:list={[
														'dashboard-alerts-empty',
														pendingConfirmAlerts.length > 0 && 'hidden',
													]}
													data-dashboard-alerts-empty
												>
													<span class="material-symbols-rounded dashboard-alerts-empty__icon" aria-hidden="true">task_alt</span>
													<p class="dashboard-alerts-empty__text">Todo al día. No hay tareas urgentes.</p>
												</div>
