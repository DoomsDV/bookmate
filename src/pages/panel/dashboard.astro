		@keyframes ai-summary-modal-in {
			from {
				opacity: 0;
				transform: translate(-50%, calc(-50% + 10px)) scale(0.98);
			}

			to {
				opacity: 1;
				transform: translate(-50%, -50%) scale(1);
			}
		}

		@keyframes ai-summary-modal-out {
			from {
				opacity: 1;
				transform: translate(-50%, -50%) scale(1);
			}

			to {
				opacity: 0;
				transform: translate(-50%, calc(-50% + 8px)) scale(0.98);
			}
		}
	}

