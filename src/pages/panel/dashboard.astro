	.dashboard-ai-card {
		position: relative;
		overflow: visible;
		padding-block: 0.35rem 0.15rem;
		padding-inline: 0;
		border: 0;
		border-radius: 0;
		--ai-card-bg: transparent;
		background: transparent;
		box-shadow: none;
	}

	.dashboard-ai-orbs {
		display: none;
		pointer-events: none;
	}

	.dashboard-ai-card.is-generating .dashboard-ai-orbs {
		display: block;
	}

	.dashboard-ai-orbs {
		position: absolute;
		inset: -0.5rem 0;
		z-index: 0;
		overflow: hidden;
		border-radius: 1.25rem;
		pointer-events: none;
	}

	.dashboard-ai-orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(26px);
		opacity: 0;
		animation: ai-orb-drift 5.5s ease-in-out infinite;
	}

	.dashboard-ai-orb--1 {
		top: -18%;
		left: -8%;
		width: 9rem;
		height: 9rem;
		background: radial-gradient(circle, rgba(56, 189, 248, 0.55) 0%, rgba(56, 189, 248, 0) 72%);
		animation-delay: 0s;
	}

	.dashboard-ai-orb--2 {
		top: 8%;
		right: -10%;
		width: 7.5rem;
		height: 7.5rem;
		background: radial-gradient(circle, rgba(59, 130, 246, 0.48) 0%, rgba(59, 130, 246, 0) 70%);
		animation-delay: 1.2s;
	}

	.dashboard-ai-orb--3 {
		bottom: -22%;
		left: 34%;
		width: 8.5rem;
		height: 8.5rem;
		background: radial-gradient(circle, rgba(125, 211, 252, 0.42) 0%, rgba(125, 211, 252, 0) 68%);
		animation-delay: 2.4s;
	}

	.dashboard-ai-header,
	.dashboard-ai-state,
	.dashboard-ai-body {
		position: relative;
		z-index: 1;
	}

	.dashboard-ai-shimmer-top {
		pointer-events: none;
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		opacity: 0;
		overflow: hidden;
		transition: opacity 280ms ease;
		z-index: 1;
	}

	.dashboard-ai-shimmer-top::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			transparent 0%,
			rgba(56, 189, 248, 0.2) 18%,
			rgba(59, 130, 246, 0.95) 50%,
			rgba(56, 189, 248, 0.2) 82%,
			transparent 100%
		);
		transform: translateX(-100%);
	}

	.dashboard-ai-card.is-generating .dashboard-ai-shimmer-top {
		opacity: 1;
	}

	.dashboard-ai-card.is-generating .dashboard-ai-shimmer-top::after {
		animation: ai-shimmer-sweep 2.4s ease-in-out infinite;
	}

	.dashboard-ai-card.is-generating {
		animation: none;
	}

	.dashboard-ai-card.is-generating::after {
		content: none;
	}

	.dashboard-ai-card.is-generating .dashboard-ai-sparkle {
		animation: ai-sparkle-pulse 1.6s ease-in-out infinite;
		filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.55));
	}

	.dashboard-ai-loading {
		display: grid;
		gap: 1rem;
	}

	.dashboard-ai-loading-label {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0;
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.45;
		color: color-mix(in srgb, var(--on-surface-variant) 90%, #334155 10%);
	}

	.dashboard-ai-loading-icon {
		font-size: 1.05rem;
		color: var(--primary);
		animation: ai-sparkle-pulse 1.6s ease-in-out infinite;
		filter: drop-shadow(0 0 8px color-mix(in srgb, var(--primary) 45%, transparent));
	}

	.dashboard-ai-skeleton {
		display: grid;
		gap: 0.55rem;
		max-width: 36rem;
	}

	.dashboard-ai-skeleton-line {
		position: relative;
		display: block;
		overflow: hidden;
		height: 0.72rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--on-surface-variant) 10%, #e2e8f0 90%);
	}

	.dashboard-ai-skeleton-line::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			transparent 0%,
			rgba(59, 130, 246, 0.12) 24%,
			rgba(96, 165, 250, 0.42) 50%,
			rgba(59, 130, 246, 0.12) 76%,
			transparent 100%
		);
		transform: translateX(-100%);
	}

	.dashboard-ai-card.is-generating .dashboard-ai-skeleton-line::after {
		animation: ai-shimmer-sweep 1.8s ease-in-out infinite;
	}

	.dashboard-ai-skeleton-line--lg { width: 96%; }
	.dashboard-ai-skeleton-line--md { width: 82%; }
	.dashboard-ai-skeleton-line--md::after { animation-delay: 120ms; }
	.dashboard-ai-skeleton-line--sm { width: 64%; }
	.dashboard-ai-skeleton-line--sm::after { animation-delay: 240ms; }

	@keyframes ai-shimmer-sweep {
		0% { transform: translateX(-100%); }
		100% { transform: translateX(100%); }
	}

	@keyframes ai-orb-drift {
		0%, 100% {
			opacity: 0.28;
			transform: translate(0, 0) scale(1);
		}

		33% {
			opacity: 0.52;
			transform: translate(8px, -6px) scale(1.06);
		}

		66% {
			opacity: 0.38;
			transform: translate(-6px, 8px) scale(0.96);
		}
	}

	@keyframes ai-card-pulse {
		0%, 100% {
			border-color: rgba(59, 130, 246, 0.2);
			box-shadow:
				inset 0 1px 0 rgba(186, 230, 253, 0.06),
				0 4px 20px rgba(37, 99, 235, 0.07);
		}

		50% {
			border-color: rgba(56, 189, 248, 0.38);
			box-shadow:
				inset 0 1px 0 rgba(186, 230, 253, 0.11),
				0 8px 28px rgba(37, 99, 235, 0.13);
		}
	}

	@keyframes ai-card-pulse-dark {
		0%, 100% {
			border-color: rgba(96, 165, 250, 0.22);
			box-shadow:
				inset 0 1px 0 rgba(147, 197, 253, 0.05),
				0 6px 24px rgba(37, 99, 235, 0.12);
		}

		50% {
			border-color: rgba(125, 211, 252, 0.4);
			box-shadow:
				inset 0 1px 0 rgba(147, 197, 253, 0.1),
				0 10px 32px rgba(37, 99, 235, 0.18);
		}
	}

	@media (max-width: 639px) {
		.dashboard-ai-orb {
			filter: blur(18px);
		}

		.dashboard-ai-orb--1 {
			width: 6.5rem;
			height: 6.5rem;
		}

		.dashboard-ai-orb--2 {
			width: 5.5rem;
			height: 5.5rem;
		}

		.dashboard-ai-orb--3 {
			width: 6rem;
			height: 6rem;
		}
	}

	@media (min-width: 640px) {
		.dashboard-ai-card.is-generating .dashboard-ai-orb {
			filter: blur(20px);
		}
	}

	@keyframes ai-sparkle-pulse {
		0%, 100% {
			opacity: 0.72;
			transform: scale(1);
		}

		50% {
			opacity: 1;
			transform: scale(1.08);
		}
	}

	.dashboard-ai-header {
