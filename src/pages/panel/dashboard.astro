	.dashboard-ai-preview-highlights li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.52rem;
		width: 0.32rem;
		height: 0.32rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--primary) 72%, #ffffff 28%);
	}

