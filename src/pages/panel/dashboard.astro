		flex-direction: column;
		align-items: stretch;
		gap: 0.95rem;
		width: 100%;
		max-width: none;
		padding: 1.15rem 1.2rem;
		border-radius: 1.25rem;
		border: 1px solid color-mix(in srgb, var(--shell-border, #d0d7e2) 88%, transparent);
		background: color-mix(in srgb, var(--surface-bright, #ffffff) 92%, var(--page-background, #f4f6f8) 8%);
