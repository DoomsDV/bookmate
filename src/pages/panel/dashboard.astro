											<div class="mb-4 flex items-center justify-between gap-3">
												<div class="min-w-0">
													<h2 class="text-xl font-bold text-[#202124] dark:text-[#E3E3E3]">Próximas citas</h2>
													<p class="dashboard-appointments-subtitle">Siguientes 7 días</p>
												</div>
												<div class="dashboard-appointments-actions flex shrink-0 items-center gap-2">
													<a href="/panel/calendar" class="dashboard-upcoming-create-cta">
