---
import AppAlert from "../../components/AppAlert.astro";
import ServicesListIsland from "../../components/ServicesListIsland.astro";
import ServicesListSkeleton from "../../components/ServicesListSkeleton.astro";
import SideNav from "../../components/SideNav.astro";
import TopBar from "../../components/TopBar.astro";
import { FEATURE_FLAGS } from "../../config/feature-flags";
import { ROLES } from "../../config/roles";
import Layout from "../../layouts/Layout.astro";
import { panelPageTitle } from "../../lib/panel-page-title";
import "../../styles/global.css";

const canManageServices = Number(Astro.locals.roleId ?? 0) === ROLES.ADMIN;
const rawPage = Number(Astro.url.searchParams.get("page") || "1");
const currentPage = Number.isInteger(rawPage) && rawPage > 0 ? rawPage : 1;
---

<Layout pageTitle={panelPageTitle('Servicios')}>
	<service-manager data-can-manage={canManageServices ? "true" : "false"}>
		<div class="min-h-screen bg-(--page-background)">
			<div
				class="app-shell grid min-h-screen overflow-hidden bg-transparent"
				data-app-shell
				data-sidebar-state="expanded"
			>
				<SideNav currentPath={Astro.url.pathname} />

				<div class="grid min-h-full grid-rows-[auto_1fr]">
					<TopBar />

					<main class="px-4 py-4 sm:px-6 sm:py-6">
						<section class="grid gap-4 sm:gap-5">
							<ServicesListIsland
								server:defer
								canManageServices={canManageServices}
								currentPage={currentPage}
							>
								<ServicesListSkeleton slot="fallback" />
							</ServicesListIsland>
						</section>
					</main>
				</div>
			</div>
		</div>

		<dialog
			class="m-0 mt-auto mb-0 w-screen max-w-none max-h-[80vh] open:flex open:flex-col overflow-hidden rounded-t-[1.8rem] rounded-b-none border border-white/10 bg-(--surface-bright) p-0 text-(--on-surface) shadow-2xl shadow-black/60 sm:m-auto sm:w-[min(48rem,calc(100vw-2rem))] sm:max-w-[min(48rem,calc(100vw-2rem))] sm:max-h-[90vh] sm:rounded-[1.8rem] lg:m-0 lg:ml-auto lg:mr-0 lg:mt-0 lg:mb-0 lg:h-[100dvh] lg:max-h-[100dvh] lg:w-[max(50vw,40rem)] lg:max-w-[max(50vw,40rem)] lg:rounded-none lg:border-y-0 lg:border-r-0"
			data-service-modal
		>

			<div class="panel-modal-header">
				<div class="panel-modal-header__row">
					<div class="panel-modal-header__leading">
						<div class="panel-modal-header__icon">
							<span class="material-symbols-rounded">design_services</span>
						</div>
						<div class="panel-modal-header__text">
							<h2 class="panel-modal-header__title" data-service-modal-title>
								Crear servicio
							</h2>
						</div>
					</div>
					<button
						type="button"
						class="panel-modal-header__close"
						data-close-service-modal
						aria-label="Cerrar modal"
					>
						<span class="material-symbols-rounded">close</span>
					</button>
				</div>
			</div>

			<form
				class="relative flex min-h-0 flex-1 flex-col overflow-hidden bg-(--surface)/30 shadow-[inset_0_4px_10px_rgba(0,0,0,0.015)]"
				data-service-create-form
			>
				<div
					class="pointer-events-none fixed inset-0 z-10 hidden items-center justify-center bg-(--surface-bright)/80 backdrop-blur-[2px] transition-all"
					data-service-loading
				>
					<div
						class="inline-flex items-center gap-3 rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-5 py-3.5 text-[0.95rem] font-extrabold text-(--on-surface) shadow-[0_12px_32px_rgba(0,0,0,0.12)]"
					>
						<span
							class="material-symbols-rounded animate-spin text-[1.2rem] text-(--primary)"
							>progress_activity</span
						>
						Procesando...
					</div>
				</div>

				{/* fieldset con display:contents evita el bug de flex que aplasta el contenido en drawers */}
				<fieldset data-form-fieldset class="contents">
				<div class="service-modal-body min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 py-5 sm:px-7 sm:py-7 lg:px-6">
				<div class="grid gap-5">
				<div
					class="hidden rounded-2xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-[0.9rem] font-bold text-rose-500 shadow-sm"
					data-form-error
				>
				</div>

				<div class="grid gap-2" data-service-cover-block>
					<span class="text-[0.95rem] font-bold text-(--on-surface)">Imagen de portada</span>
					<p class="m-0 text-[0.82rem] font-medium text-(--on-surface-variant)">
						Opcional. Se muestra en la reserva pública (proporción 4:3).
					</p>
					<label
						class="service-cover-dropzone"
						data-service-cover-dropzone
					>
						<input
							type="file"
							accept="image/jpeg,image/png,image/webp"
							class="sr-only"
							data-service-cover-input
						/>
						<img
							alt=""
							class="service-cover-dropzone__preview hidden"
							data-service-cover-preview
						/>
						<div class="service-cover-dropzone__empty" data-service-cover-empty>
							<span
								class="material-symbols-rounded service-cover-dropzone__icon"
								aria-hidden="true"
								>image</span
							>
							<span class="service-cover-dropzone__title">
								<span class="service-cover-copy-desktop">Arrastrá tu imagen aquí</span>
								<span class="service-cover-copy-mobile">Tocá para subir una imagen</span>
							</span>
							<span class="service-cover-dropzone__meta"
								>JPG, PNG o WebP · máx. 5 MB</span
							>
							<span class="service-cover-dropzone__btn" data-service-cover-select>
								Seleccionar imagen
							</span>
						</div>
						<span class="service-cover-dropzone__overlay" aria-hidden="true">
							<span class="material-symbols-rounded">photo_camera</span>
						</span>
						<button
							type="button"
							class="service-cover-dropzone__clear hidden"
							data-service-cover-clear
							aria-label="Eliminar portada"
						>
							<span class="material-symbols-rounded" aria-hidden="true">delete</span>
						</button>
					</label>
				</div>

				<label
					class="grid gap-1.5 text-[0.95rem] font-bold text-(--on-surface)"
				>
					<span class="inline-flex items-center gap-1">
						Nombre
						<span class="text-rose-500">*</span>
					</span>
					<input
						type="text"
						name="name"
						maxlength="100"
						required
						class="w-full min-w-0 rounded-xl border border-(--shell-border) bg-(--surface-bright) px-4 py-3 text-[0.95rem] outline-none transition hover:border-(--on-surface-variant)/40 focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10"
						placeholder="Ej: Corte premium"
					/>
					<span
						class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400"
						data-field-error="name"></span>
				</label>

				<label class="grid gap-1.5 text-[0.95rem] font-bold text-(--on-surface)">
					<span>
						Qué incluye
						<span class="font-medium text-(--on-surface-variant)"> (opcional)</span>
					</span>
					<textarea
						name="public_includes"
						maxlength="2000"
						rows="3"
						class="w-full min-w-0 resize-y rounded-xl border border-(--shell-border) bg-(--surface-bright) px-4 py-3 text-[0.95rem] font-normal outline-none transition hover:border-(--on-surface-variant)/40 focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10"
						placeholder="Una línea por ítem. Ej: Relajación profunda"
					></textarea>
					<span class="text-xs font-medium text-(--on-surface-variant)">
						Se muestra en la reserva pública solo si hay al menos un ítem.
					</span>
					<span
						class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400"
						data-field-error="public_includes"></span>
				</label>

				<div class="grid gap-3">
				<div class="grid grid-cols-2 gap-5">
					<label
						class="grid gap-1.5 text-[0.95rem] font-bold text-(--on-surface)"
					>
						<span class="inline-flex items-center gap-1">
							Duración
							<span class="text-rose-500">*</span>
						</span>
						<div class="service-input-affix">
							<input
								type="number"
								name="duration_minutes"
								min="1"
								max="999"
								step="1"
								inputmode="numeric"
								required
								class="service-input-affix__input"
								placeholder="30"
							/>
							<span class="service-input-affix__suffix">min</span>
						</div>
						<span
							class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400"
							data-field-error="duration_minutes"></span>
					</label>

					<label
						class="grid gap-1.5 text-[0.95rem] font-bold text-(--on-surface)"
					>
						<span class="inline-flex items-center gap-1">
							Precio <span
								class="text-(--on-surface-variant) font-medium"
								>(Opcional)</span
							>
						</span>
						<div class="service-input-affix">
							<span class="service-input-affix__prefix">Gs.</span>
							<input
								type="text"
								name="price"
								inputmode="numeric"
								maxlength="8"
								class="service-input-affix__input"
								placeholder="50.000"
								data-price-mask
							/>
						</div>
						<span
							class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400"
							data-field-error="price"></span>
					</label>
				</div>

				<div class="service-options-card">
					<div>
						<div class="service-switch-row">
							<span class="inline-flex min-w-0 items-center gap-1.5 text-[0.95rem] font-bold text-(--on-surface)">
								Ocultar precio en reserva
								<button
									type="button"
									class="service-field-info"
									aria-label="El cliente verá el texto por defecto de Ajustes → Negocio. El precio real sigue usándose en el panel y en métricas."
									data-tooltip="El cliente verá el texto por defecto de Ajustes → Negocio. El precio real sigue usándose en el panel y en métricas."
								>
									<span class="material-symbols-rounded" aria-hidden="true">info</span>
								</button>
							</span>
							<label class="service-switch shrink-0">
								<input
									type="checkbox"
									name="hide_public_price"
									value="1"
									data-hide-public-price-toggle
									class="service-switch__input sr-only"
									aria-label="Ocultar precio en reserva"
								/>
								<span class="service-switch__track" aria-hidden="true"></span>
							</label>
						</div>

						<div class="service-reveal" data-hide-public-price-fields>
							<div class="service-reveal__inner">
								<div class="service-options-card__sub">
									<label class="grid gap-1 text-[0.82rem] font-bold text-(--on-surface)">
										<span>Texto alternativo</span>
										<input
											type="text"
											name="hidden_public_price_label"
											maxlength="80"
											data-hidden-public-price-label
											placeholder="Ej. A consultar / A evaluar"
											class="w-full rounded-lg border border-(--shell-border) bg-(--surface-bright) px-3 py-2 text-[0.88rem] font-medium outline-none transition hover:border-(--on-surface-variant)/40 focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10"
										/>
									</label>
									<p class="m-0 mt-1.5 text-[0.75rem] font-medium leading-snug text-(--on-surface-variant)">
										Si lo dejás vacío, usará el texto global del negocio.
									</p>
									<span class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400" data-field-error="hidden_public_price_label"></span>
								</div>
							</div>
						</div>
					</div>

					{
						FEATURE_FLAGS.SERVICE_DEPOSIT_OPTIONS ? (
							<>
								<div class="service-options-card__divider"></div>
								<div>
									<div class="service-switch-row">
										<span class="inline-flex min-w-0 items-center gap-1.5 text-[0.95rem] font-bold text-(--on-surface)">
											Requiere seña
											<button
												type="button"
												class="service-field-info"
												aria-label="Si lo activas, el cliente deberá pagar una seña en la web para confirmar."
												data-tooltip="Si lo activas, el cliente deberá pagar una seña en la web para confirmar."
											>
												<span class="material-symbols-rounded" aria-hidden="true">info</span>
											</button>
										</span>
										<label class="service-switch shrink-0">
											<input
												type="checkbox"
												name="requires_deposit"
												value="1"
												data-requires-deposit-toggle
												class="service-switch__input sr-only"
												aria-label="Requiere seña"
											/>
											<span class="service-switch__track" aria-hidden="true"></span>
										</label>
									</div>

									<div class="service-reveal" data-deposit-fields>
										<div class="service-reveal__inner">
											<div class="service-options-card__sub">
												<div class="grid grid-cols-2 gap-3">
													<label class="grid gap-1.5 text-[0.95rem] font-bold text-(--on-surface)">
														<span>Tipo <span class="text-rose-500">*</span></span>
														<div class="relative">
															<select
																name="deposit_type"
																data-deposit-type
																class="w-full appearance-none rounded-xl border border-(--shell-border) bg-(--surface-bright) px-4 py-2.5 text-[0.95rem] outline-none transition hover:border-(--on-surface-variant)/40 focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10 font-bold text-(--on-surface) cursor-pointer"
															>
																<option value="PERCENT">Porcentaje (%)</option>
																<option value="FIXED">Monto fijo (Gs)</option>
															</select>
															<span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-(--on-surface-variant)">
																<span class="material-symbols-rounded">expand_more</span>
															</span>
														</div>
														<span class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400" data-field-error="deposit_type"></span>
													</label>

													<label class="grid gap-1.5 text-[0.95rem] font-bold text-(--on-surface)">
														<span>Valor <span class="text-rose-500">*</span></span>
														<div class="service-input-affix" data-deposit-value-affix>
															<span class="service-input-affix__prefix hidden" data-deposit-prefix>Gs.</span>
															<input
																type="text"
																name="deposit_value"
																data-deposit-value
																inputmode="numeric"
																class="service-input-affix__input"
																placeholder="30"
															/>
															<span class="service-input-affix__suffix" data-deposit-suffix>%</span>
														</div>
														<span class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400" data-field-error="deposit_value"></span>
													</label>
												</div>
											</div>
										</div>
									</div>
								</div>
							</>
						) : null
					}
				</div>
				</div>

				<label
					class="grid gap-1.5 border-t border-(--shell-border) pt-5 text-[0.95rem] font-bold text-(--on-surface)"
					data-service-status-wrap
					hidden
				>
					Estado
					<div class="relative">
						<select
							name="is_active"
							class="w-full appearance-none rounded-xl border border-(--shell-border) bg-(--surface-bright) px-4 py-3 text-[0.95rem] outline-none transition hover:border-(--on-surface-variant)/40 focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10 font-bold text-(--on-surface) cursor-pointer"
						>
							<option value="1"
								>Activo (Visible para clientes)</option
							>
							<option value="0"
								>Inactivo (Oculto temporalmente)</option
							>
						</select>
						<span
							class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-(--on-surface-variant)"
						>
							<span class="material-symbols-rounded"
								>expand_more</span
							>
						</span>
					</div>
					<span
						class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400"
						data-field-error="is_active"></span>
				</label>

				</div>
				</div>
				<div
					class="z-20 mt-auto shrink-0 border-t border-(--shell-border) bg-(--surface-bright) px-4 py-4 sm:px-7 sm:py-5 lg:px-6"
				>
					<div class="modal-footer">
						<button
							type="button"
							class="hidden modal-action-danger"
							data-delete-service
							aria-label="Eliminar servicio"
						>
							<span
								class="material-symbols-rounded mr-1.5 align-[-0.22em] text-[1.15rem]"
								aria-hidden="true"
								>delete</span
							>
							<span class="modal-action-danger__label" data-delete-service-label>Eliminar</span>
						</button>

						<div class="modal-footer-actions">
							<button
								type="button"
								class="modal-action-secondary"
								data-close-service-modal
							>
								Cancelar
							</button>
							<button
								type="submit"
								class="modal-action-primary"
								data-submit-service
							>
								<span
									class="material-symbols-rounded text-[1.2rem]"
									data-submit-service-icon
									aria-hidden="true">check</span
								>
								<span data-submit-service-label>Crear servicio</span
								>
							</button>
						</div>
					</div>
				</div>
				</fieldset>
			</form>
		</dialog>

		<dialog class="service-crop-modal" data-service-crop-modal>
			<div class="service-crop-modal__sheet" data-service-crop-sheet>
				<div class="service-crop-modal__handle" aria-hidden="true"><span></span></div>
				<div class="service-crop-modal__head">
					<div>
						<strong data-service-crop-title>Recortar portada</strong>
						<p class="service-crop-modal__hint" data-service-crop-hint>
							El marco es lo que se verá en la reserva pública (proporción 4:3). Arrastrá para mover y usá el control para acercar o alejar.
						</p>
					</div>
					<button
						type="button"
						class="flex size-9 shrink-0 items-center justify-center rounded-full text-(--on-surface-variant) transition-colors hover:bg-(--surface-variant) hover:text-(--on-surface)"
						data-service-crop-close
						aria-label="Cerrar"
					>
						<span class="material-symbols-rounded text-[1.3rem]">close</span>
					</button>
				</div>
				<div class="service-crop-modal__mount" data-service-crop-mount></div>
				<div class="service-crop-modal__actions">
					<button type="button" class="modal-action-secondary" data-service-crop-close>
						Cancelar
					</button>
					<button type="button" class="modal-action-primary" data-service-crop-confirm>
						Usar imagen
					</button>
				</div>
			</div>
		</dialog>
	</service-manager>

	<AppAlert />
</Layout>

<script>
	import { FEATURE_FLAGS } from "../../config/feature-flags";
	import { reloadPageWithFlash } from "../../lib/flash";
	import { openPanelModal } from "../../lib/panel-scroll-lock";
	import {
		isAcceptedCoverImage,
		ProfileImageCropper,
	} from "../../lib/profile-image-crop";

	type ServiceMode = "create" | "edit";
	type ServiceSubmitPayload = {
		name: string;
		duration_minutes: number;
		is_active: 0 | 1;
		price?: number;
		hide_public_price?: 0 | 1;
		hidden_public_price_label?: string | null;
		requires_deposit?: 0 | 1;
		deposit_type?: "PERCENT" | "FIXED";
		deposit_value?: number;
		image_base64?: string;
		image_name?: string;
		image_mime?: string;
		clear_image?: 0 | 1;
		public_includes?: string | null;
	};

	type ServiceDetail = {
		name?: string | null;
		duration_minutes?: number | null;
		price?: number | null;
		hide_public_price?: 0 | 1 | boolean | null;
		hidden_public_price_label?: string | null;
		image_url?: string | null;
		is_active?: 0 | 1 | boolean | null;
		requires_deposit?: 0 | 1 | boolean | null;
		deposit_type?: "PERCENT" | "FIXED" | string | null;
		deposit_value?: number | null;
		public_includes?: string | null;
	};

	class ServiceManager extends HTMLElement {
		private get canManage() {
			return this.dataset.canManage === "true";
		}

		private abortController: AbortController | null = null;
		private closeTimer: number | null = null;
		private mode: ServiceMode = "create";
		private editingServiceId = 0;
		private requestSeq = 0;
		private orgHiddenPriceDefault = "A evaluar";
		private coverPendingBase64: string | null = null;
		private coverPendingName = "portada.jpg";
		private coverPendingMime = "image/jpeg";
		private coverExistingUrl: string | null = null;
		private coverCleared = false;
		private coverCropper: ProfileImageCropper | null = null;
		private coverCropPendingName = "portada.jpg";

		// Grouped DOM References
		private els!: {
			modal: HTMLDialogElement | null;
			form: HTMLFormElement | null;
			submitBtn: HTMLButtonElement | null;
			submitLabel: HTMLElement | null;
			submitIcon: HTMLElement | null;
			deleteBtn: HTMLButtonElement | null;
			errorBox: HTMLElement | null;
			loading: HTMLElement | null;
			modalTitle: HTMLElement | null;
			statusWrap: HTMLElement | null;
			priceInput: HTMLInputElement | null;
			hidePublicPriceToggle: HTMLInputElement | null;
			hidePublicPriceFields: HTMLElement | null;
			hiddenPublicPriceLabel: HTMLInputElement | null;
			requiresDepositToggle: HTMLInputElement | null;
			depositFields: HTMLElement | null;
			depositType: HTMLSelectElement | null;
			depositValue: HTMLInputElement | null;
			coverPreview: HTMLImageElement | null;
			coverEmpty: HTMLElement | null;
			coverInput: HTMLInputElement | null;
			coverClear: HTMLButtonElement | null;
			coverDropzone: HTMLElement | null;
			cropModal: HTMLDialogElement | null;
			cropMount: HTMLElement | null;
			cropConfirm: HTMLButtonElement | null;
		};

		private formEls!: {
			fieldset: HTMLFieldSetElement | null;
			name: HTMLInputElement | null;
			publicIncludes: HTMLTextAreaElement | null;
			duration: HTMLInputElement | null;
			status: HTMLSelectElement | null;
			fieldErrors: HTMLElement[];
		};

		connectedCallback() {
			this.els = {
				modal: this.querySelector<HTMLDialogElement>(
					"[data-service-modal]",
				),
				form: this.querySelector<HTMLFormElement>(
					"[data-service-create-form]",
				),
				submitBtn: this.querySelector<HTMLButtonElement>(
					"[data-submit-service]",
				),
				submitLabel: this.querySelector<HTMLElement>(
					"[data-submit-service-label]",
				),
				submitIcon: this.querySelector<HTMLElement>(
					"[data-submit-service-icon]",
				),
				deleteBtn: this.querySelector<HTMLButtonElement>(
					"[data-delete-service]",
				),
				errorBox: this.querySelector<HTMLElement>("[data-form-error]"),
				loading: this.querySelector<HTMLElement>("[data-service-loading]"),
				modalTitle: this.querySelector<HTMLElement>(
					"[data-service-modal-title]",
				),
				statusWrap: this.querySelector<HTMLElement>(
					"[data-service-status-wrap]",
				),
				priceInput:
					this.querySelector<HTMLInputElement>("[data-price-mask]"),
				hidePublicPriceToggle: this.querySelector<HTMLInputElement>(
					"[data-hide-public-price-toggle]",
				),
				hidePublicPriceFields: this.querySelector<HTMLElement>(
					"[data-hide-public-price-fields]",
				),
				hiddenPublicPriceLabel: this.querySelector<HTMLInputElement>(
					"[data-hidden-public-price-label]",
				),
				requiresDepositToggle: this.querySelector<HTMLInputElement>(
					"[data-requires-deposit-toggle]",
				),
				depositFields: this.querySelector<HTMLElement>("[data-deposit-fields]"),
				depositType: this.querySelector<HTMLSelectElement>("[data-deposit-type]"),
				depositValue: this.querySelector<HTMLInputElement>("[data-deposit-value]"),
				coverPreview: this.querySelector<HTMLImageElement>("[data-service-cover-preview]"),
				coverEmpty: this.querySelector<HTMLElement>("[data-service-cover-empty]"),
				coverInput: this.querySelector<HTMLInputElement>("[data-service-cover-input]"),
				coverClear: this.querySelector<HTMLButtonElement>("[data-service-cover-clear]"),
				coverDropzone: this.querySelector<HTMLElement>("[data-service-cover-dropzone]"),
				cropModal: this.querySelector<HTMLDialogElement>("[data-service-crop-modal]"),
				cropMount: this.querySelector<HTMLElement>("[data-service-crop-mount]"),
				cropConfirm: this.querySelector<HTMLButtonElement>("[data-service-crop-confirm]"),
			};

			this.formEls = {
				fieldset: this.els.form?.querySelector<HTMLFieldSetElement>(
					"[data-form-fieldset]"
				) || null,
				name: this.els.form?.querySelector<HTMLInputElement>(
					'[name="name"]',
				) || null,
				publicIncludes: this.els.form?.querySelector<HTMLTextAreaElement>(
					'[name="public_includes"]',
				) || null,
				duration: this.els.form?.querySelector<HTMLInputElement>(
					'[name="duration_minutes"]',
				) || null,
				status: this.els.form?.querySelector<HTMLSelectElement>(
					'[name="is_active"]',
				) || null,
				fieldErrors: Array.from(
					this.querySelectorAll<HTMLElement>("[data-field-error]"),
				),
			};

			if (this.abortController) return;
			this.abortController = new AbortController();
			const { signal } = this.abortController;

			this.addEventListener("click", this.handleRootClick, { signal });
			this.addEventListener("keydown", this.handleRootKeydown, {
				signal,
			});
			this.els.form?.addEventListener("submit", this.handleSubmit, {
				signal,
			});
			this.els.priceInput?.addEventListener(
				"input",
				this.handlePriceInput,
				{ signal },
			);
			this.els.requiresDepositToggle?.addEventListener(
				"change",
				this.handleRequiresDepositToggle,
				{ signal },
			);
			this.els.depositType?.addEventListener(
				"change",
				this.handleDepositTypeChange,
				{ signal },
			);
			this.els.depositValue?.addEventListener(
				"input",
				this.handleDepositValueInput,
				{ signal },
			);
			this.els.coverInput?.addEventListener(
				"change",
				this.handleCoverInput,
				{ signal },
			);
			this.els.coverClear?.addEventListener(
				"click",
				this.handleCoverClear,
				{ signal },
			);
			this.bindCoverDropzone(signal);
			this.els.hidePublicPriceToggle?.addEventListener(
				"change",
				this.handleHidePublicPriceToggle,
				{ signal },
			);
			this.els.cropConfirm?.addEventListener(
				"click",
				() => void this.applyCoverCrop(),
				{ signal },
			);
			this.els.cropModal?.addEventListener(
				"cancel",
				(event) => {
					event.preventDefault();
					this.closeCoverCrop();
				},
				{ signal },
			);
			this.els.cropModal?.addEventListener(
				"click",
				(event) => {
					if (event.target === this.els.cropModal) this.closeCoverCrop();
				},
				{ signal },
			);
			void this.loadOrgHiddenPriceDefault();
			this.formEls.duration?.addEventListener(
				"input",
				this.handleDurationInput,
				{ signal },
			);
		}

		disconnectedCallback() {
			this.abortController?.abort();
			this.abortController = null;
			if (this.closeTimer) window.clearTimeout(this.closeTimer);
			this.closeCoverCrop();
		}

		private clearErrors() {
			if (this.els.errorBox) {
				this.els.errorBox.textContent = "";
				this.els.errorBox.classList.add("hidden");
			}
			this.formEls.fieldErrors.forEach((node) => {
				node.textContent = "";
				node.classList.add("hidden");
			});
		}

		private showFormError(message: string) {
			if (!this.els.errorBox) return;
			this.els.errorBox.textContent = message;
			this.els.errorBox.classList.remove("hidden");
		}

		private updateUIMode(mode: ServiceMode) {
			this.mode = mode;
			const isEdit = mode === "edit";

			if (this.els.modalTitle)
				this.els.modalTitle.textContent = isEdit
					? "Editar servicio"
					: "Crear servicio";

			if (this.els.submitLabel)
				this.els.submitLabel.textContent = isEdit
					? "Guardar cambios"
					: "Crear servicio";
			if (this.els.submitIcon)
				this.els.submitIcon.textContent = isEdit ? "save" : "check";

			if (this.els.deleteBtn) {
				isEdit
					? this.els.deleteBtn.classList.remove("hidden")
					: this.els.deleteBtn.classList.add("hidden");
				this.els.deleteBtn.disabled = !isEdit;
			}

			if (this.els.statusWrap) {
				if (isEdit) {
					this.els.statusWrap.removeAttribute("hidden");
				} else {
					this.els.statusWrap.setAttribute("hidden", "");
				}
			}

			if (this.formEls.status) {
				if (isEdit) {
					this.formEls.status.disabled = false;
				} else {
					this.formEls.status.value = "1";
					this.formEls.status.disabled = true;
				}
			}

			if (!isEdit) {
				this.editingServiceId = 0;
				this.els.loading?.classList.add("hidden");
			}
		}

		private toggleFormLoading(isLoading: boolean) {
			if (this.els.loading) {
				isLoading
					? this.els.loading.classList.replace("hidden", "flex")
					: this.els.loading.classList.replace("flex", "hidden");
			}
			if (this.formEls.fieldset) {
				this.formEls.fieldset.disabled = isLoading;
			}
		}

		private setButtonsProcessing(label = "Procesando...") {
			if (this.els.submitBtn) this.els.submitBtn.disabled = true;
			if (this.els.deleteBtn && this.mode === "edit")
				this.els.deleteBtn.disabled = true;
			if (this.els.submitLabel) this.els.submitLabel.textContent = label;
			if (this.els.submitIcon)
				this.els.submitIcon.textContent = "hourglass_top";
		}

		private restoreButtons() {
			if (this.els.submitBtn) this.els.submitBtn.disabled = false;
			const isEdit = this.mode === "edit";
			if (this.els.submitLabel)
				this.els.submitLabel.textContent = isEdit
					? "Guardar cambios"
					: "Crear servicio";
			if (this.els.submitIcon)
				this.els.submitIcon.textContent = isEdit ? "save" : "check";
			if (this.els.deleteBtn && isEdit)
				this.els.deleteBtn.disabled = false;
		}

		private openModalShell() {
			this.els.modal?.classList.remove("is-closing");
			if (this.closeTimer) {
				window.clearTimeout(this.closeTimer);
				this.closeTimer = null;
			}
			if (this.els.modal && !this.els.modal.open) openPanelModal(this.els.modal);
		}

		private closeModal() {
			if (!this.els.modal?.open) return;
			this.closeCoverCrop();
			this.requestSeq++;
			this.els.modal.classList.add("is-closing");

			this.closeTimer = window.setTimeout(() => {
				this.els.modal?.close();
				this.els.modal?.classList.remove("is-closing");
				this.els.form?.reset();
				this.updateUIMode("create");
				this.toggleFormLoading(false);
				this.clearErrors();
				this.closeTimer = null;
			}, 140);
		}
		private openCreateModal() {
			this.updateUIMode("create");
			this.resetFormValues();
			this.toggleFormLoading(false);
			this.clearErrors();
			this.openModalShell();
		}

		private formatPrice(val: string | number | null | undefined) {
			const digits = String(val || "").replace(/\D/g, "").slice(0, 8);
			return digits ? Number(digits).toLocaleString("es-PY") : "";
		}

		private sanitizeDuration(raw: string | number | null | undefined) {
			return String(raw || "").replace(/\D/g, "").slice(0, 3);
		}

		private fillForm(service: ServiceDetail) {
			if (this.formEls.name)
				this.formEls.name.value = String(service?.name || "");
			if (this.formEls.publicIncludes)
				this.formEls.publicIncludes.value = String(service?.public_includes || "");
			if (this.formEls.duration)
				this.formEls.duration.value =
					typeof service?.duration_minutes === "number"
						? this.sanitizeDuration(service.duration_minutes)
						: "";
			if (this.els.priceInput)
				this.els.priceInput.value = this.formatPrice(
					service?.price ?? "",
				);
			const hidePublicPrice =
				String(service?.hide_public_price ?? "0") === "1" ||
				service?.hide_public_price === true;
			if (this.els.hidePublicPriceToggle) {
				this.els.hidePublicPriceToggle.checked = hidePublicPrice;
			}
			if (this.els.hiddenPublicPriceLabel) {
				const custom = String(service?.hidden_public_price_label || "").trim();
				// Si coincide con el default de org, dejar vacío para mostrar el placeholder.
				this.els.hiddenPublicPriceLabel.value =
					custom && custom !== this.orgHiddenPriceDefault ? custom : "";
			}
			this.toggleHidePublicPriceFields(hidePublicPrice);
			const requiresDeposit =
				String(service?.requires_deposit ?? "0") === "1" ||
				service?.requires_deposit === true;
			if (this.els.requiresDepositToggle) {
				this.els.requiresDepositToggle.checked = requiresDeposit;
			}
			this.toggleDepositFields(requiresDeposit);
			if (this.els.depositType) {
				const type = String(service?.deposit_type || "PERCENT").toUpperCase();
				this.els.depositType.value = type === "FIXED" ? "FIXED" : "PERCENT";
			}
			this.syncDepositValueField(service?.deposit_value ?? "");
			if (this.formEls.status)
				this.formEls.status.value = String(
					service?.is_active === 0 ? 0 : 1,
				);
			this.setCoverState({
				existingUrl: String(service?.image_url || "").trim() || null,
				pendingBase64: null,
			});
		}

		private resetFormValues() {
			[
				this.formEls.name,
				this.formEls.publicIncludes,
				this.formEls.duration,
				this.els.priceInput,
			].forEach((el) => el && (el.value = ""));
			if (this.formEls.status) this.formEls.status.value = "1";
			if (this.els.hidePublicPriceToggle) this.els.hidePublicPriceToggle.checked = false;
			if (this.els.hiddenPublicPriceLabel) this.els.hiddenPublicPriceLabel.value = "";
			this.toggleHidePublicPriceFields(false);
			if (this.els.requiresDepositToggle) this.els.requiresDepositToggle.checked = false;
			this.toggleDepositFields(false);
			if (this.els.depositType) this.els.depositType.value = "PERCENT";
			if (this.els.depositValue) this.els.depositValue.value = "";
			this.syncDepositValueField("");
			this.setCoverState({ existingUrl: null, pendingBase64: null });
		}

		private setCoverState(options: {
			existingUrl: string | null;
			pendingBase64: string | null;
			pendingName?: string;
			pendingMime?: string;
			cleared?: boolean;
		}) {
			this.coverExistingUrl = options.existingUrl;
			this.coverPendingBase64 = options.pendingBase64;
			this.coverPendingName = options.pendingName || "portada.jpg";
			this.coverPendingMime = options.pendingMime || "image/jpeg";
			this.coverCleared = Boolean(options.cleared);
			if (this.els.coverInput) this.els.coverInput.value = "";

			const previewSrc = options.pendingBase64
				? `data:${this.coverPendingMime};base64,${options.pendingBase64}`
				: options.existingUrl && !options.cleared
					? options.existingUrl
					: "";

			if (this.els.coverPreview) {
				if (previewSrc) {
					this.els.coverPreview.src = previewSrc;
					this.els.coverPreview.classList.remove("hidden");
				} else {
					this.els.coverPreview.removeAttribute("src");
					this.els.coverPreview.classList.add("hidden");
				}
			}
			this.els.coverEmpty?.classList.toggle("hidden", Boolean(previewSrc));
			this.els.coverClear?.classList.toggle("hidden", !previewSrc);
			this.els.coverDropzone?.classList.toggle("has-preview", Boolean(previewSrc));
		}

		private handleCoverClear = (event?: MouseEvent) => {
			event?.preventDefault();
			event?.stopPropagation();
			this.setCoverState({
				existingUrl: this.coverExistingUrl,
				pendingBase64: null,
				cleared: true,
			});
		};

		private handleCoverInput = () => {
			const file = this.els.coverInput?.files?.[0];
			if (!file) return;
			void this.processCoverFile(file);
		};

		/** Drag & drop solo en desktop (pointer fino). En mobile queda click/tap. */
		private bindCoverDropzone(signal: AbortSignal) {
			const zone = this.els.coverDropzone;
			if (!zone) return;

			const canDragDrop =
				typeof window !== "undefined" &&
				window.matchMedia("(hover: hover) and (pointer: fine)").matches;

			if (!canDragDrop) return;

			zone.addEventListener(
				"dragover",
				(event) => {
					event.preventDefault();
					zone.classList.add("is-dragging");
				},
				{ signal },
			);
			zone.addEventListener(
				"dragleave",
				() => zone.classList.remove("is-dragging"),
				{ signal },
			);
			zone.addEventListener(
				"drop",
				(event) => {
					event.preventDefault();
					zone.classList.remove("is-dragging");
					const file = event.dataTransfer?.files?.[0];
					if (file) void this.processCoverFile(file);
				},
				{ signal },
			);
		}

		private async processCoverFile(file: File) {
			if (!isAcceptedCoverImage(file)) {
				this.showFormError("Usá una imagen JPG, PNG o WebP.");
				return;
			}
			if (file.size > 5 * 1024 * 1024) {
				this.showFormError("La imagen supera el máximo de 5 MB.");
				return;
			}
			if (this.els.coverInput) this.els.coverInput.value = "";
			await this.openCoverCrop(file);
		}

		private async openCoverCrop(file: File) {
			const modal = this.els.cropModal;
			const mount = this.els.cropMount;
			if (!modal || !mount) return;

			this.coverCropPendingName = file.name || "portada.jpg";
			this.coverCropper?.destroy();
			this.coverCropper = null;

			if (!modal.open) openPanelModal(modal);
			// Esperar a que el sheet mobile tenga ancho real antes de medir Croppie
			await new Promise<void>((resolve) =>
				requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
			);
			this.coverCropper = new ProfileImageCropper(mount, 512, "cover");
			try {
				await this.coverCropper.bindFile(file);
			} catch (err) {
				this.closeCoverCrop();
				this.showFormError(
					err instanceof Error
						? err.message
						: "No se pudo abrir el recorte.",
				);
			}
		}

		private closeCoverCrop() {
			this.coverCropper?.destroy();
			this.coverCropper = null;
			if (this.els.cropModal?.open) this.els.cropModal.close();
		}

		private async applyCoverCrop() {
			if (!this.coverCropper) return;
			try {
				const file = await this.coverCropper.exportJpeg(
					this.coverCropPendingName,
				);
				const base64 = await this.fileToBase64(file);
				this.setCoverState({
					existingUrl: this.coverExistingUrl,
					pendingBase64: base64,
					pendingName: file.name,
					pendingMime: file.type || "image/jpeg",
					cleared: false,
				});
				this.closeCoverCrop();
			} catch (err) {
				this.showFormError(
					err instanceof Error
						? err.message
						: "No se pudo recortar la imagen.",
				);
			}
		}

		private fileToBase64(file: File): Promise<string> {
			return new Promise((resolve, reject) => {
				const reader = new FileReader();
				reader.onload = () => {
					const result = String(reader.result || "");
					const base64 = result.includes(",")
						? result.split(",")[1] || ""
						: result;
					if (!base64) {
						reject(new Error("No se pudo leer la imagen."));
						return;
					}
					resolve(base64);
				};
				reader.onerror = () =>
					reject(new Error("No se pudo leer la imagen."));
				reader.readAsDataURL(file);
			});
		}

		private toggleHidePublicPriceFields(isEnabled: boolean) {
			this.els.hidePublicPriceFields?.classList.toggle("is-open", isEnabled);
			if (!isEnabled && this.els.hiddenPublicPriceLabel) {
				this.els.hiddenPublicPriceLabel.value = "";
			}
		}

		private toggleDepositFields(isEnabled: boolean) {
			this.els.depositFields?.classList.toggle("is-open", isEnabled);
			if (!isEnabled) {
				if (this.els.depositValue) this.els.depositValue.value = "";
			}
			if (isEnabled) this.syncDepositValueAffix();
		}

		private handleHidePublicPriceToggle = () => {
			const enabled = Boolean(this.els.hidePublicPriceToggle?.checked);
			this.toggleHidePublicPriceFields(enabled);
		};

		private async loadOrgHiddenPriceDefault() {
			if (!this.canManage) return;
			try {
				const data = await this.requestApi("/api/workspace", {
					headers: { Accept: "application/json" },
				});
				const label = String(
					(data?.data as { hidden_public_price_label?: string } | null)
						?.hidden_public_price_label || "",
				).trim();
				this.orgHiddenPriceDefault = label || "A evaluar";
			} catch {
				this.orgHiddenPriceDefault = "A evaluar";
			}
		}

		private isDepositFixedType() {
			return String(this.els.depositType?.value || "").toUpperCase() === "FIXED";
		}

		private formatDepositValue(val: string | number | null | undefined) {
			if (this.isDepositFixedType()) {
				return this.formatPrice(val);
			}
			const digits = String(val ?? "").replace(/\D/g, "").slice(0, 3);
			if (!digits) return "";
			const n = Number(digits);
			if (!Number.isFinite(n) || n <= 0) return "";
			return String(Math.min(n, 100));
		}

		private syncDepositValueAffix() {
			const isFixed = this.isDepositFixedType();
			this.querySelector("[data-deposit-prefix]")?.classList.toggle("hidden", !isFixed);
			this.querySelector("[data-deposit-suffix]")?.classList.toggle("hidden", isFixed);
		}

		private syncDepositValueField(val: string | number | null | undefined) {
			if (!this.els.depositValue) return;
			this.els.depositValue.value = this.formatDepositValue(val);
			this.els.depositValue.placeholder = this.isDepositFixedType()
				? "50.000"
				: "30";
			this.els.depositValue.maxLength = this.isDepositFixedType() ? 12 : 3;
			this.syncDepositValueAffix();
		}

		private handleDepositTypeChange = () => {
			this.syncDepositValueField(this.els.depositValue?.value ?? "");
		};

		private handleDepositValueInput = () => {
			this.syncDepositValueField(this.els.depositValue?.value ?? "");
		};

		private handleRequiresDepositToggle = () => {
			const enabled = Boolean(this.els.requiresDepositToggle?.checked);
			this.toggleDepositFields(enabled);
			if (enabled) this.syncDepositValueField(this.els.depositValue?.value ?? "");
		};

		private async requestApi<T = any>(url: string, options?: RequestInit): Promise<any> {
			const response = await fetch(url, options);
			let data = null;
			try { data = await response.json(); } catch { throw new Error("No fue posible interpretar la respuesta del servidor."); }
			if (!response.ok || !data || data.status !== "success") {
				const error = new Error(data?.message || "Error en la petición.");
				(error as any).apiData = data;
				throw error;
			}
			return data;
		}

		private async openEditModal(serviceId: number) {
			if (!serviceId) return;
			const currentReq = ++this.requestSeq;

			this.editingServiceId = serviceId;
			this.updateUIMode("edit");
			this.resetFormValues();
			this.clearErrors();
			this.openModalShell();

			this.toggleFormLoading(true);
			this.setButtonsProcessing("Cargando...");

			try {
				const data = await this.requestApi(`/api/services/${serviceId}`, {
					headers: { Accept: "application/json" },
				});
				if (currentReq === this.requestSeq) this.fillForm(data.data);
			} catch (err) {
				if (currentReq !== this.requestSeq) return;
				this.updateUIMode("create");
				this.showFormError(
					err instanceof Error ? err.message : "Error desconocido.",
				);
			} finally {
				if (currentReq === this.requestSeq) {
					this.toggleFormLoading(false);
					this.restoreButtons();
				}
			}
		}

		private handlePriceInput = () => {
			if (this.els.priceInput)
				this.els.priceInput.value = this.formatPrice(
					this.els.priceInput.value,
				);
		};

		private handleDurationInput = () => {
			if (!this.formEls.duration) return;
			this.formEls.duration.value = this.sanitizeDuration(
				this.formEls.duration.value,
			);
		};

		private handleRootClick = (e: MouseEvent) => {
			const target = e.target as Element;
			if (!target) return;

			if (target.closest("[data-service-crop-close]")) {
				this.closeCoverCrop();
				return;
			}

			if (this.els.modal && target === this.els.modal)
				return this.closeModal();

			if (target.closest("[data-close-service-modal]"))
				return this.closeModal();

			const deleteTrigger = target.closest("[data-delete-service]");
			if (deleteTrigger && this.contains(deleteTrigger)) {
				void this.handleDelete();
				return;
			}

			const card = target.closest("[data-service-card]");
			if (card && this.contains(card) && this.canManage) {
				const id = Number(card.getAttribute("data-service-id") || "0");
				if (id > 0) void this.openEditModal(id);
				return;
			}

			if (
				this.canManage &&
				target.closest("[data-open-service-modal]") &&
				this.contains(target.closest("[data-open-service-modal]"))
			) {
				this.openCreateModal();
			}
		};

		private handleRootKeydown = (e: KeyboardEvent) => {
			if (e.key !== "Enter" && e.key !== " ") return;
			const target = e.target as Element;
			const card = target?.closest("[data-service-card]");
			if (!card || !this.contains(card) || !this.canManage) return;

			e.preventDefault();
			const id = Number(card.getAttribute("data-service-id") || "0");
			if (id > 0) void this.openEditModal(id);
		};

		private handleSubmit = async (e: SubmitEvent) => {
			e.preventDefault();
			if (!this.canManage) return;
			this.clearErrors();
			if (!this.els.form) return;

			const formData = new FormData(this.els.form);
			const name = String(formData.get("name") || "").trim();
			const durationRaw = this.sanitizeDuration(
				String(formData.get("duration_minutes") || ""),
			);
			const duration = Number(durationRaw);
			const isActive = String(formData.get("is_active")) === "0" ? 0 : 1;
			const priceRaw = String(formData.get("price") || "").replace(
				/\D/g,
				"",
			).slice(0, 8);
			const hidePublicPrice = formData.get("hide_public_price") ? 1 : 0;
			const hiddenPriceLabel = String(
				formData.get("hidden_public_price_label") || "",
			).trim();
			const requiresDeposit = formData.get("requires_deposit") ? 1 : 0;
			const depositType = String(formData.get("deposit_type") || "")
				.trim()
				.toUpperCase();
			const depositValueRaw = String(formData.get("deposit_value") || "")
				.trim()
				.replace(/\D/g, "");

			if (!name || !duration || !Number.isFinite(duration)) {
				return this.showFormError(
					"Completa los campos requeridos antes de continuar.",
				);
			}

			const publicIncludes = String(formData.get("public_includes") || "").trim();
			const payload: ServiceSubmitPayload = {
				name,
				duration_minutes: duration,
				is_active: isActive,
				hide_public_price: hidePublicPrice as 0 | 1,
				hidden_public_price_label:
					hidePublicPrice === 1 ? hiddenPriceLabel || null : null,
				public_includes: publicIncludes || null,
			};
			if (priceRaw) payload.price = Number(priceRaw);

			if (FEATURE_FLAGS.SERVICE_DEPOSIT_OPTIONS) {
				payload.requires_deposit = requiresDeposit as 0 | 1;

				if (requiresDeposit === 1) {
					payload.deposit_type = depositType === "FIXED" ? "FIXED" : "PERCENT";
					if (!depositValueRaw) {
						return this.showFormError(
							"Ingresa el valor de la seña antes de continuar.",
						);
					}
					payload.deposit_value = Number(depositValueRaw);
				}
			}

			if (this.coverPendingBase64) {
				payload.image_base64 = this.coverPendingBase64;
				payload.image_name = this.coverPendingName;
				payload.image_mime = this.coverPendingMime;
			} else if (this.coverCleared && this.mode === "edit") {
				payload.clear_image = 1;
			}

			const isEdit = this.mode === "edit" && this.editingServiceId > 0;
			this.setButtonsProcessing(isEdit ? "Guardando..." : "Creando...");

			try {
				const data = await this.requestApi(
					isEdit
						? `/api/services/${this.editingServiceId}`
						: "/api/services",
					{
						method: isEdit ? "PUT" : "POST",
						headers: {
							"Content-Type": "application/json",
							Accept: "application/json",
						},
						body: JSON.stringify(payload),
					},
				);

				this.closeModal();
				void reloadPageWithFlash({
					message:
						data?.message ||
						`Servicio ${isEdit ? "actualizado" : "creado"} correctamente.`,
					type: "success",
				});
			} catch (err: any) {
				this.showFormError(
					err instanceof Error
						? err.message
						: "Error inesperado del servidor.",
				);
				if (err.apiData && Array.isArray(err.apiData.errors)) {
					err.apiData.errors.forEach((errorItem: any) => {
						if (!errorItem?.field || !errorItem?.message) return;
						const node = this.querySelector<HTMLElement>(
							`[data-field-error="${errorItem.field}"]`,
						);
						if (node) {
							node.textContent = errorItem.message;
							node.classList.remove("hidden");
						}
					});
				}
			} finally {
				this.restoreButtons();
			}
		};

		private async handleDelete() {
			if (!this.editingServiceId || this.mode !== "edit") return;

			const confirmed = await (window as any).BookmateAlert?.confirm?.({
				type: "error",
				title: "Eliminar servicio",
				message:
					"Esta acción eliminará el servicio de forma permanente. ¿Deseas continuar?",
				confirmText: "Eliminar",
				cancelText: "Cancelar",
			});
			if (!confirmed) return;

			this.clearErrors();
			this.setButtonsProcessing("Eliminando...");

			try {
				const data = await this.requestApi(
					`/api/services/${this.editingServiceId}`,
					{
						method: "DELETE",
						headers: { Accept: "application/json" },
					},
				);

				this.closeModal();
				void reloadPageWithFlash({
					message: data?.message || "Servicio eliminado correctamente.",
					type: "success",
				});
			} catch (err) {
				this.restoreButtons();
				this.showFormError(
					err instanceof Error
						? err.message
						: "Error al eliminar el servicio.",
				);
			}
		}
	}

	if (!customElements.get("service-manager")) {
		customElements.define("service-manager", ServiceManager);
	}
</script>

