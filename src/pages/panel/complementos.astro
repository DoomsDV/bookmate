---
import SideNav from '../../components/SideNav.astro';
import TopBar from '../../components/TopBar.astro';
import Layout from '../../layouts/Layout.astro';
import { panelPageTitle } from '../../lib/panel-page-title';
import '../../styles/global.css';
---

<Layout pageTitle={panelPageTitle('Complementos')}>
	<complementos-store>
		<div class="min-h-screen bg-(--page-background)">
			<div
				class="app-shell grid min-h-screen overflow-hidden bg-transparent"
				data-app-shell
				data-sidebar-state="expanded"
			>
				<SideNav currentPath={Astro.url.pathname} />

				<div class="grid min-h-full grid-rows-[auto_1fr]">
					<TopBar />

					<main class="px-4 py-4 sm:px-6 sm:py-6">
						<section class="grid gap-4 sm:gap-5">
							<header class="complementos-header">
								<div class="grid gap-2 min-w-0">
									<h1 class="m-0 text-[1.5rem] font-bold leading-none tracking-tight text-(--on-surface) sm:text-[1.75rem]">
										Complementos
									</h1>
									<p
										class="m-0 max-w-2xl text-[0.92rem] leading-snug text-(--on-surface-variant)"
										data-complementos-lead
									>
										Módulos extras para tu clínica. Activálos cuando los necesites.
									</p>
								</div>
								<div class="complementos-tablist" role="tablist" aria-label="Secciones de complementos">
									<button
										type="button"
										class="complementos-tab is-active"
										role="tab"
										id="complementos-tab-explore"
										aria-selected="true"
										aria-controls="complementos-panel-explore"
										data-complementos-tab="explore"
									>
										Explorar
									</button>
									<button
										type="button"
										class="complementos-tab"
										role="tab"
										id="complementos-tab-mine"
										aria-selected="false"
										aria-controls="complementos-panel-mine"
										data-complementos-tab="mine"
									>
										Mis módulos
										<span class="complementos-tab__badge hidden" data-complementos-mine-badge>0</span>
									</button>
								</div>
							</header>

							<div
								class="complementos-banner"
								data-complementos-banner
								role="status"
							>
								<span class="material-symbols-rounded complementos-banner__icon" aria-hidden="true">
									science
								</span>
								<div class="complementos-banner__copy">
									<p class="complementos-banner__kicker">Versión Beta</p>
									<p class="complementos-banner__text">
										Activación gratuita. Te avisaremos antes de realizar cualquier cargo futuro.
									</p>
								</div>
							</div>

							<div
								class="hidden rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-4 py-3 text-[0.9rem] font-semibold text-(--on-surface-variant)"
								data-complementos-error
								role="alert"
							></div>

							<div
								class="grid place-items-center gap-3 rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-6 py-14"
								data-complementos-loading
							>
								<span class="material-symbols-rounded animate-pulse text-[2rem] text-(--on-surface-variant)" aria-hidden="true">
									progress_activity
								</span>
								<p class="m-0 text-[0.9rem] font-semibold text-(--on-surface-variant)">Cargando complementos…</p>
							</div>

							<div
								id="complementos-panel-explore"
								role="tabpanel"
								aria-labelledby="complementos-tab-explore"
								data-complementos-panel="explore"
							>
								<div
									class="hidden grid place-items-center gap-2 rounded-2xl border border-dashed border-(--shell-border) bg-(--surface-bright) px-6 py-14 text-center"
									data-complementos-empty="explore"
								>
									<span class="material-symbols-rounded text-[2rem] text-(--on-surface-variant)" aria-hidden="true">
										storefront
									</span>
									<p class="m-0 text-[0.95rem] font-bold text-(--on-surface)">No hay más módulos para tu rubro</p>
									<p class="m-0 max-w-sm text-[0.85rem] font-medium text-(--on-surface-variant)">
										Cuando haya complementos disponibles para tu categoría, van a aparecer acá.
									</p>
								</div>
								<div class="hidden grid gap-5 sm:grid-cols-2" data-complementos-grid="explore"></div>
							</div>

							<div
								id="complementos-panel-mine"
								class="hidden"
								role="tabpanel"
								aria-labelledby="complementos-tab-mine"
								data-complementos-panel="mine"
								hidden
							>
								<div
									class="hidden grid place-items-center gap-2 rounded-2xl border border-dashed border-(--shell-border) bg-(--surface-bright) px-6 py-14 text-center"
									data-complementos-empty="mine"
								>
									<span class="material-symbols-rounded text-[2rem] text-(--on-surface-variant)" aria-hidden="true">
										extension
									</span>
									<p class="m-0 text-[0.95rem] font-bold text-(--on-surface)">Todavía no activaste ningún complemento</p>
									<p class="m-0 max-w-sm text-[0.85rem] font-medium text-(--on-surface-variant)">
										Explorá la tienda y activá el que necesites para tu negocio.
									</p>
								</div>
								<div class="hidden grid gap-5 sm:grid-cols-2" data-complementos-grid="mine"></div>
							</div>
						</section>
					</main>
				</div>
			</div>
		</div>
	</complementos-store>
</Layout>

<style is:global>
	/* is:global: las tarjetas se inyectan con JS y no reciben el scope de Astro */
	.complementos-header {
		display: grid;
		gap: 0.9rem;
	}

	@media (min-width: 720px) {
		.complementos-header {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: start;
			gap: 1rem 1.25rem;
		}
	}

	.complementos-tablist {
		display: flex;
		flex-wrap: nowrap;
		width: 100%;
		max-width: 22rem;
		gap: 0.25rem;
		padding: 0.25rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container) 88%, var(--surface-bright) 12%);
	}

	@media (min-width: 720px) {
		.complementos-tablist {
			width: auto;
			min-width: 16.5rem;
			justify-self: end;
		}
	}

	.complementos-tab {
		flex: 1 1 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 2.35rem;
		padding: 0.4rem 0.75rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--on-surface-variant);
		font-size: 0.84rem;
		font-weight: 700;
		white-space: nowrap;
		cursor: pointer;
		transition: background-color 140ms ease, color 140ms ease;
	}

	.complementos-tab:hover {
		color: var(--on-surface);
	}

	.complementos-tab.is-active {
		background: var(--surface-bright);
		color: var(--on-surface);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
	}

	.complementos-tab:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 55%, transparent);
		outline-offset: 2px;
	}

	.complementos-tab__badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.15rem;
		padding: 0.08rem 0.38rem;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 800;
		line-height: 1.2;
		background: color-mix(in srgb, var(--primary) 14%, transparent);
		color: var(--primary);
	}

	.complementos-tab.is-active .complementos-tab__badge {
		background: color-mix(in srgb, var(--primary) 18%, transparent);
	}

	html[data-theme='dark'] .complementos-tablist {
		background: color-mix(in srgb, var(--surface-container) 70%, rgb(255 255 255 / 0.04));
	}

	html[data-theme='dark'] .complementos-tab.is-active {
		background: color-mix(in srgb, var(--surface-bright) 92%, rgb(255 255 255 / 0.06));
		box-shadow: none;
	}

	.complementos-banner {
		display: flex;
		align-items: flex-start;
		align-self: start;
		width: fit-content;
		max-width: 42rem;
		gap: 0.65rem;
		border-radius: 0.95rem;
		border: 1px solid color-mix(in srgb, var(--primary) 22%, var(--shell-border));
		background: color-mix(in srgb, var(--on-surface) 4%, transparent);
		padding: 0.65rem 0.95rem;
		color: var(--on-surface);
	}

	.complementos-banner.is-hidden {
		display: none;
	}

	.complementos-banner__icon {
		flex-shrink: 0;
		margin-top: 0.06rem;
		font-size: 1.15rem;
		line-height: 1;
		color: color-mix(in srgb, var(--primary) 70%, var(--on-surface-variant));
	}

	.complementos-banner__copy {
		display: grid;
		gap: 0.12rem;
		min-width: 0;
	}

	.complementos-banner__kicker {
		margin: 0;
		font-size: 0.82rem;
		font-weight: 700;
		line-height: 1.25;
		color: var(--on-surface);
	}

	.complementos-banner__text {
		margin: 0;
		font-size: 0.86rem;
		font-weight: 500;
		line-height: 1.35;
		color: var(--on-surface-variant);
	}

	html[data-theme='light'] .complementos-banner {
		background: color-mix(in srgb, var(--primary) 6%, var(--surface-bright));
		border-color: color-mix(in srgb, var(--primary) 18%, var(--shell-border));
	}

	html[data-theme='light'] .complementos-banner__icon {
		color: color-mix(in srgb, var(--primary) 75%, var(--on-surface-variant));
	}

	html[data-theme='light'] .complementos-banner__kicker {
		color: var(--on-surface);
	}

	html[data-theme='light'] .complementos-banner__text {
		color: var(--on-surface-variant);
	}

	.complementos-card {
		--complementos-ease: cubic-bezier(0.32, 0.72, 0, 1);
		display: block;
		min-width: 0;
	}

	.complementos-card__shell {
		padding: 0.28rem;
		border-radius: 1.65rem;
		background: color-mix(in srgb, var(--on-surface) 4%, var(--page-background));
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--on-surface) 8%, transparent);
		transition: transform 420ms var(--complementos-ease);
	}

	.complementos-card__core {
		display: grid;
		align-content: start;
		min-width: 0;
		overflow: hidden;
		border-radius: 1.4rem;
		background: var(--surface-bright);
		box-shadow:
			inset 0 1px 0 color-mix(in srgb, #fff 9%, transparent),
			inset 0 0 0 1px color-mix(in srgb, var(--on-surface) 6%, transparent);
	}

	.complementos-card--media .complementos-card__core {
		grid-template-columns: 1fr;
		gap: 0;
	}

	@media (min-width: 720px) {
		.complementos-card--media .complementos-card__core {
			grid-template-columns: minmax(8.4rem, 38%) minmax(0, 1fr);
			align-items: stretch;
		}
	}

	.complementos-card:hover .complementos-card__shell {
		transform: translateY(-2px);
	}

	.complementos-card:hover .complementos-card__core {
		box-shadow:
			inset 0 1px 0 color-mix(in srgb, #fff 12%, transparent),
			inset 0 0 0 1px color-mix(in srgb, var(--primary) 22%, transparent);
	}

	.complementos-card__media {
		display: grid;
		place-items: center;
		padding: 1rem 1rem 0.15rem;
	}

	@media (min-width: 720px) {
		.complementos-card__media {
			padding: 0.95rem 0.35rem 0.95rem 0.95rem;
		}
	}

	.complementos-card__preview {
		position: relative;
		width: min(11.5rem, 100%);
		aspect-ratio: 1;
		padding: 0.28rem;
		border-radius: 1.25rem;
		background: color-mix(in srgb, var(--on-surface) 5%, var(--surface-bright));
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--on-surface) 8%, transparent);
	}

	.complementos-card__preview::before {
		content: '';
		position: absolute;
		inset: 0.28rem;
		border-radius: 1.05rem;
		background:
			radial-gradient(80% 70% at 50% 18%, color-mix(in srgb, var(--primary) 18%, transparent), transparent 68%),
			color-mix(in srgb, var(--surface-container-high, #16161a) 82%, var(--surface-bright));
		pointer-events: none;
	}

	.complementos-card__preview-img {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		height: 100%;
		padding: 0.7rem;
		object-fit: contain;
		object-position: center;
		transform: scale(1.02);
		transition: transform 520ms var(--complementos-ease);
	}

	.complementos-card:hover .complementos-card__preview-img {
		transform: scale(1.06);
	}

	.complementos-card__body {
		display: grid;
		align-content: start;
		gap: 0.85rem;
		padding: 1.05rem 1.15rem 1.15rem;
	}

	@media (min-width: 720px) {
		.complementos-card--media .complementos-card__body {
			align-content: center;
			padding: 1.15rem 1.25rem 1.2rem 0.85rem;
		}
	}

	.complementos-card__eyebrow {
		margin: 0;
		width: max-content;
		padding: 0.22rem 0.55rem;
		border-radius: 999px;
		font-size: 0.62rem;
		font-weight: 750;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--on-surface) 58%, var(--on-surface-variant));
		background: color-mix(in srgb, var(--on-surface) 5%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--on-surface) 8%, transparent);
	}

	.complementos-card__copy {
		min-width: 0;
	}

	.complementos-card__title {
		margin: 0;
		font-size: 1.18rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.15;
		color: var(--on-surface);
	}

	.complementos-card__desc {
		margin: 0.4rem 0 0;
		font-size: 0.88rem;
		font-weight: 550;
		line-height: 1.45;
		color: var(--on-surface-variant);
	}

	.complementos-card__price-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem 0.65rem;
	}

	.complementos-card__price {
		font-size: 1.4rem;
		font-weight: 800;
		letter-spacing: -0.035em;
		color: var(--on-surface);
		line-height: 1;
	}

	.complementos-card__price.is-struck {
		font-size: 0.92rem;
		font-weight: 650;
		color: color-mix(in srgb, var(--on-surface-variant) 72%, transparent);
		text-decoration: line-through;
		text-decoration-thickness: 1.5px;
	}

	.complementos-card__free {
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1;
		color: #3ee0a8;
	}

	.complementos-card__period {
		font-size: 0.74rem;
		font-weight: 650;
		letter-spacing: 0.01em;
		color: color-mix(in srgb, var(--on-surface) 55%, var(--on-surface-variant));
	}

	.complementos-card__badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		width: max-content;
		border-radius: 999px;
		padding: 0.28rem 0.7rem;
		font-size: 0.7rem;
		font-weight: 750;
		letter-spacing: 0.04em;
		color: #3ee0a8;
		background: color-mix(in srgb, #10b981 10%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #34d399 28%, transparent);
	}

	.complementos-card__badge-dot {
		width: 0.38rem;
		height: 0.38rem;
		border-radius: 999px;
		background: #3ee0a8;
		box-shadow: 0 0 0 3px color-mix(in srgb, #3ee0a8 18%, transparent);
	}

	html[data-theme='light'] .complementos-card__shell {
		background: color-mix(in srgb, var(--on-surface) 3.5%, var(--page-background));
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--on-surface) 7%, transparent);
	}

	html[data-theme='light'] .complementos-card__core {
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.7),
			inset 0 0 0 1px color-mix(in srgb, var(--on-surface) 7%, transparent);
	}

	html[data-theme='light'] .complementos-card:hover .complementos-card__core {
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.85),
			inset 0 0 0 1px color-mix(in srgb, var(--primary) 26%, transparent);
	}

	html[data-theme='light'] .complementos-card__badge {
		color: #047857;
		background: color-mix(in srgb, #10b981 10%, #fff);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #059669 22%, transparent);
	}

	html[data-theme='light'] .complementos-card__badge-dot {
		background: #059669;
		box-shadow: 0 0 0 3px color-mix(in srgb, #059669 14%, transparent);
	}

	html[data-theme='light'] .complementos-card__free {
		color: #059669;
	}

	.complementos-btn {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.65rem;
		width: 100%;
		min-height: 2.75rem;
		margin-top: 0.15rem;
		border: 0;
		border-radius: 999px;
		padding: 0.35rem 0.4rem 0.35rem 1.05rem;
		font-size: 0.86rem;
		font-weight: 750;
		letter-spacing: -0.01em;
		cursor: pointer;
		transition:
			transform 280ms var(--complementos-ease),
			background-color 280ms var(--complementos-ease),
			color 280ms var(--complementos-ease),
			opacity 280ms var(--complementos-ease);
	}

	.complementos-btn:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	.complementos-btn:not(:disabled):active {
		transform: scale(0.985);
	}

	.complementos-btn__glyph {
		display: grid;
		place-items: center;
		width: 1.95rem;
		height: 1.95rem;
		border-radius: 999px;
		transition: transform 320ms var(--complementos-ease);
	}

	.complementos-btn__glyph .material-symbols-rounded {
		font-size: 1.05rem;
		line-height: 1;
	}

	.complementos-btn:not(:disabled):hover .complementos-btn__glyph {
		transform: translateX(2px);
	}

	.complementos-btn--primary {
		background: var(--primary);
		color: var(--on-primary, #f8fbff);
	}

	.complementos-btn--primary .complementos-btn__glyph {
		background: color-mix(in srgb, #fff 16%, transparent);
		color: inherit;
	}

	.complementos-btn--primary:hover:not(:disabled) {
		background: color-mix(in srgb, var(--primary) 88%, #fff);
	}

	.complementos-btn--soft {
		background: color-mix(in srgb, var(--on-surface) 6%, transparent);
		color: var(--on-surface);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--on-surface) 8%, transparent);
	}

	.complementos-btn--soft .complementos-btn__glyph {
		background: color-mix(in srgb, var(--on-surface) 7%, transparent);
	}

	.complementos-btn--soft:hover:not(:disabled) {
		background: color-mix(in srgb, var(--on-surface) 9%, transparent);
	}
</style>

<script>
	import { initComplementosPage } from '../../scripts/complementos-page';

	const boot = () => {
		initComplementosPage();
	};

	boot();
	document.addEventListener('astro:page-load', boot);
</script>
