---
import SideNav from '../../components/SideNav.astro';
import TopBar from '../../components/TopBar.astro';
import Layout from '../../layouts/Layout.astro';
import { panelPageTitle } from '../../lib/panel-page-title';
import '../../styles/global.css';
---

<Layout pageTitle={panelPageTitle('Complementos')}>
	<complementos-store>
		<div class="min-h-screen bg-(--page-background)">
			<div
				class="app-shell grid min-h-screen overflow-hidden bg-transparent"
				data-app-shell
				data-sidebar-state="expanded"
			>
				<SideNav currentPath={Astro.url.pathname} />

				<div class="grid min-h-full grid-rows-[auto_1fr]">
					<TopBar />

					<main class="px-4 py-4 sm:px-6 sm:py-6">
						<section class="grid gap-4 sm:gap-5">
							<header class="complementos-header">
								<div class="grid gap-2 min-w-0">
									<h1 class="m-0 text-[1.5rem] font-bold leading-none tracking-tight text-(--on-surface) sm:text-[1.75rem]">
										Complementos
									</h1>
									<p
										class="m-0 max-w-2xl text-[0.92rem] leading-snug text-(--on-surface-variant)"
										data-complementos-lead
									>
										Módulos extras para tu negocio. Activálos cuando los necesites.
									</p>
								</div>
								<div class="complementos-tablist" role="tablist" aria-label="Secciones de complementos">
									<button
										type="button"
										class="complementos-tab is-active"
										role="tab"
										id="complementos-tab-explore"
										aria-selected="true"
										aria-controls="complementos-panel-explore"
										data-complementos-tab="explore"
									>
										Explorar
									</button>
									<button
										type="button"
										class="complementos-tab"
										role="tab"
										id="complementos-tab-mine"
										aria-selected="false"
										aria-controls="complementos-panel-mine"
										data-complementos-tab="mine"
									>
										Mis módulos
										<span class="complementos-tab__badge hidden" data-complementos-mine-badge>0</span>
									</button>
								</div>
							</header>

							<div
								class="complementos-banner"
								data-complementos-banner
								role="status"
							>
								<span class="material-symbols-rounded complementos-banner__icon" aria-hidden="true">
									science
								</span>
								<div class="complementos-banner__copy">
									<p class="complementos-banner__kicker">Versión Beta</p>
									<p class="complementos-banner__text">
										Activación gratuita. Te avisaremos antes de realizar cualquier cargo futuro.
									</p>
								</div>
							</div>

							<div
								class="hidden rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-4 py-3 text-[0.9rem] font-semibold text-(--on-surface-variant)"
								data-complementos-error
								role="alert"
							></div>

							<div
								class="grid place-items-center gap-3 rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-6 py-14"
								data-complementos-loading
							>
								<span class="material-symbols-rounded animate-pulse text-[2rem] text-(--on-surface-variant)" aria-hidden="true">
									progress_activity
								</span>
								<p class="m-0 text-[0.9rem] font-semibold text-(--on-surface-variant)">Cargando complementos…</p>
							</div>

							<div
								id="complementos-panel-explore"
								role="tabpanel"
								aria-labelledby="complementos-tab-explore"
								data-complementos-panel="explore"
							>
								<div
									class="hidden grid place-items-center gap-2 rounded-2xl border border-dashed border-(--shell-border) bg-(--surface-bright) px-6 py-14 text-center"
									data-complementos-empty="explore"
								>
									<span class="material-symbols-rounded text-[2rem] text-(--on-surface-variant)" aria-hidden="true">
										storefront
									</span>
									<p class="m-0 text-[0.95rem] font-bold text-(--on-surface)">No hay más módulos para tu rubro</p>
									<p class="m-0 max-w-sm text-[0.85rem] font-medium text-(--on-surface-variant)">
										Cuando haya complementos disponibles para tu categoría, van a aparecer acá.
									</p>
								</div>
								<div class="hidden complementos-grid" data-complementos-grid="explore"></div>
							</div>

							<div
								id="complementos-panel-mine"
								class="hidden"
								role="tabpanel"
								aria-labelledby="complementos-tab-mine"
								data-complementos-panel="mine"
								hidden
							>
								<div
									class="hidden grid place-items-center gap-2 rounded-2xl border border-dashed border-(--shell-border) bg-(--surface-bright) px-6 py-14 text-center"
									data-complementos-empty="mine"
								>
									<span class="material-symbols-rounded text-[2rem] text-(--on-surface-variant)" aria-hidden="true">
										extension
									</span>
									<p class="m-0 text-[0.95rem] font-bold text-(--on-surface)">Todavía no activaste ningún complemento</p>
									<p class="m-0 max-w-sm text-[0.85rem] font-medium text-(--on-surface-variant)">
										Explorá la tienda y activá el que necesites para tu negocio.
									</p>
								</div>
								<div class="hidden complementos-grid" data-complementos-grid="mine"></div>
							</div>
						</section>
					</main>
				</div>
			</div>
		</div>
	</complementos-store>
</Layout>

<style is:global>
	/* is:global: las tarjetas se inyectan con JS y no reciben el scope de Astro */
	.complementos-header {
		display: grid;
		gap: 0.9rem;
	}

	@media (min-width: 720px) {
		.complementos-header {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: start;
			gap: 1rem 1.25rem;
		}
	}

	.complementos-tablist {
		display: flex;
		flex-wrap: nowrap;
		width: 100%;
		max-width: 22rem;
		gap: 0.25rem;
		padding: 0.25rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container) 88%, var(--surface-bright) 12%);
	}

	@media (min-width: 720px) {
		.complementos-tablist {
			width: auto;
			min-width: 16.5rem;
			justify-self: end;
		}
	}

	.complementos-tab {
		flex: 1 1 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 2.35rem;
		padding: 0.4rem 0.75rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--on-surface-variant);
		font-size: 0.84rem;
		font-weight: 700;
		white-space: nowrap;
		cursor: pointer;
		transition: background-color 140ms ease, color 140ms ease;
	}

	.complementos-tab:hover {
		color: var(--on-surface);
	}

	.complementos-tab.is-active {
		background: var(--surface-bright);
		color: var(--on-surface);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
	}

	.complementos-tab:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 55%, transparent);
		outline-offset: 2px;
	}

	.complementos-tab__badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.15rem;
		padding: 0.08rem 0.38rem;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 800;
		line-height: 1.2;
		background: color-mix(in srgb, var(--primary) 14%, transparent);
		color: var(--primary);
	}

	.complementos-tab.is-active .complementos-tab__badge {
		background: color-mix(in srgb, var(--primary) 18%, transparent);
	}

	html[data-theme='dark'] .complementos-tablist {
		background: color-mix(in srgb, var(--surface-container) 70%, rgb(255 255 255 / 0.04));
	}

	html[data-theme='dark'] .complementos-tab.is-active {
		background: color-mix(in srgb, var(--surface-bright) 92%, rgb(255 255 255 / 0.06));
		box-shadow: none;
	}

	.complementos-banner {
		display: flex;
		align-items: flex-start;
		align-self: start;
		width: fit-content;
		max-width: 42rem;
		gap: 0.65rem;
		border-radius: 0.95rem;
		border: 1px solid color-mix(in srgb, var(--primary) 22%, var(--shell-border));
		background: color-mix(in srgb, var(--on-surface) 4%, transparent);
		padding: 0.65rem 0.95rem;
		color: var(--on-surface);
	}

	.complementos-banner.is-hidden {
		display: none;
	}

	.complementos-banner__icon {
		flex-shrink: 0;
		margin-top: 0.06rem;
		font-size: 1.15rem;
		line-height: 1;
		color: color-mix(in srgb, var(--primary) 70%, var(--on-surface-variant));
	}

	.complementos-banner__copy {
		display: grid;
		gap: 0.12rem;
		min-width: 0;
	}

	.complementos-banner__kicker {
		margin: 0;
		font-size: 0.82rem;
		font-weight: 700;
		line-height: 1.25;
		color: var(--on-surface);
	}

	.complementos-banner__text {
		margin: 0;
		font-size: 0.86rem;
		font-weight: 500;
		line-height: 1.35;
		color: var(--on-surface-variant);
	}

	html[data-theme='light'] .complementos-banner {
		background: color-mix(in srgb, var(--primary) 6%, var(--surface-bright));
		border-color: color-mix(in srgb, var(--primary) 18%, var(--shell-border));
	}

	html[data-theme='light'] .complementos-banner__icon {
		color: color-mix(in srgb, var(--primary) 75%, var(--on-surface-variant));
	}

	html[data-theme='light'] .complementos-banner__kicker {
		color: var(--on-surface);
	}

	html[data-theme='light'] .complementos-banner__text {
		color: var(--on-surface-variant);
	}

	.complementos-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.35rem;
		align-items: stretch;
	}

	@media (min-width: 880px) {
		.complementos-grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 1.6rem;
		}

		.complementos-card.is-featured {
			grid-column: 1 / -1;
		}
	}

	.complementos-grid.hidden,
	[data-complementos-grid].hidden {
		display: none !important;
	}

	.complementos-card {
		--complementos-ease: cubic-bezier(0.32, 0.72, 0, 1);
		display: block;
		min-width: 0;
		animation: complementos-card-enter 900ms var(--complementos-ease) both;
	}

	.complementos-grid .complementos-card:nth-child(1) { animation-delay: 0ms; }
	.complementos-grid .complementos-card:nth-child(2) { animation-delay: 80ms; }
	.complementos-grid .complementos-card:nth-child(3) { animation-delay: 140ms; }
	.complementos-grid .complementos-card:nth-child(n + 4) { animation-delay: 200ms; }

	@keyframes complementos-card-enter {
		from {
			opacity: 0;
			transform: translateY(22px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.complementos-card__shell {
		padding: 0.4rem;
		border-radius: 2rem;
		background: color-mix(in srgb, var(--on-surface) 4.5%, var(--page-background));
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--on-surface) 8%, transparent);
		transition: transform 640ms var(--complementos-ease);
	}

	.complementos-card__core {
		display: grid;
		min-width: 0;
		overflow: hidden;
		border-radius: calc(2rem - 0.4rem);
		background: var(--surface-bright);
		box-shadow:
			inset 0 1px 0 color-mix(in srgb, #fff 14%, transparent),
			inset 0 0 0 1px color-mix(in srgb, var(--on-surface) 6%, transparent);
	}

	@media (min-width: 880px) {
		.complementos-card.is-featured .complementos-card__core {
			grid-template-columns: minmax(16rem, 46%) minmax(0, 1fr);
			align-items: stretch;
		}
	}

	.complementos-card:hover .complementos-card__shell {
		transform: translateY(-4px);
	}

	.complementos-card:active .complementos-card__shell {
		transform: scale(0.985);
	}

	.complementos-card:focus-within .complementos-card__shell {
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 34%, transparent);
	}

	.complementos-card__hero {
		position: relative;
		isolation: isolate;
		min-height: 13.5rem;
		overflow: hidden;
		background:
			radial-gradient(70% 80% at 18% 12%, color-mix(in srgb, var(--primary) 22%, transparent), transparent 62%),
			radial-gradient(55% 60% at 88% 88%, color-mix(in srgb, #10b981 16%, transparent), transparent 58%),
			#101014;
	}

	.complementos-card.is-featured .complementos-card__hero {
		min-height: 16.5rem;
	}

	@media (min-width: 880px) {
		.complementos-card.is-featured .complementos-card__hero {
			min-height: 100%;
		}
	}

	.complementos-card__hero-img {
		position: absolute;
		inset: 0;
		box-sizing: border-box;
		width: 100%;
		height: 100%;
		padding: 1.15rem;
		object-fit: contain;
		object-position: center;
		transition: transform 700ms var(--complementos-ease);
	}

	.complementos-card:hover .complementos-card__hero-img {
		transform: scale(1.03);
	}

	.complementos-card__hero--initials {
		display: grid;
		place-items: center;
	}

	.complementos-card__hero-mark {
		position: relative;
		z-index: 1;
		font-size: 2.1rem;
		font-weight: 780;
		letter-spacing: -0.04em;
		color: color-mix(in srgb, #fff 82%, var(--primary));
	}

	.complementos-card__body {
		display: grid;
		align-content: start;
		gap: 0.7rem;
		padding: 1.35rem 1.4rem 1.45rem;
	}

	@media (min-width: 880px) {
		.complementos-card.is-featured .complementos-card__body {
			align-content: center;
			gap: 0.85rem;
			padding: 1.85rem 1.9rem 1.95rem 1.55rem;
		}
	}

	.complementos-card__eyebrow {
		margin: 0;
		width: max-content;
		padding: 0.28rem 0.7rem;
		border-radius: 999px;
		font-size: 0.62rem;
		font-weight: 720;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--on-surface) 62%, var(--on-surface-variant));
		background: color-mix(in srgb, var(--on-surface) 5%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--on-surface) 8%, transparent);
	}

	.complementos-card__title {
		margin: 0;
		font-size: 1.55rem;
		font-weight: 780;
		letter-spacing: -0.04em;
		line-height: 1.05;
		color: var(--on-surface);
		text-wrap: balance;
	}

	@media (min-width: 880px) {
		.complementos-card.is-featured .complementos-card__title {
			font-size: 2.05rem;
		}
	}

	.complementos-card__desc {
		margin: 0;
		max-width: 28rem;
		font-size: 0.95rem;
		font-weight: 520;
		line-height: 1.5;
		color: var(--on-surface-variant);
		text-wrap: pretty;
	}

	.complementos-card__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.7rem 1rem;
		margin-top: 0.25rem;
	}

	.complementos-card__price {
		display: inline-flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.45rem 0.65rem;
		font-variant-numeric: tabular-nums;
	}

	.complementos-card__amount {
		font-size: 1.55rem;
		font-weight: 780;
		letter-spacing: -0.04em;
		line-height: 1;
		color: var(--on-surface);
	}

	.complementos-card__amount.is-struck {
		font-size: 1rem;
		font-weight: 620;
		color: color-mix(in srgb, var(--on-surface-variant) 68%, transparent);
		text-decoration: line-through;
		text-decoration-thickness: 1.5px;
	}

	.complementos-card__free {
		font-size: 1.55rem;
		font-weight: 780;
		letter-spacing: -0.04em;
		line-height: 1;
		color: #059669;
	}

	.complementos-card__period {
		font-size: 0.78rem;
		font-weight: 620;
		color: var(--on-surface-variant);
	}

	.complementos-card__status {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.28rem 0.7rem;
		border-radius: 999px;
		font-size: 0.72rem;
		font-weight: 720;
		color: #047857;
		background: color-mix(in srgb, #10b981 10%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #059669 20%, transparent);
	}

	.complementos-card__status-dot {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 999px;
		background: #059669;
		box-shadow: 0 0 0 4px color-mix(in srgb, #059669 14%, transparent);
	}

	.complementos-card__cta {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		width: 100%;
		max-width: 22rem;
		min-height: 3.05rem;
		margin-top: 0.35rem;
		padding: 0.35rem 0.35rem 0.35rem 1.15rem;
		border: 0;
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 740;
		letter-spacing: -0.015em;
		cursor: pointer;
		transition:
			transform 420ms var(--complementos-ease),
			background 420ms var(--complementos-ease),
			opacity 280ms var(--complementos-ease);
	}

	.complementos-card__cta:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	.complementos-card__cta:not(:disabled):active {
		transform: scale(0.98);
	}

	.complementos-card__cta-glyph {
		display: grid;
		place-items: center;
		width: 2.2rem;
		height: 2.2rem;
		border-radius: 999px;
		transition: transform 520ms var(--complementos-ease);
	}

	.complementos-card__cta-glyph .material-symbols-rounded {
		font-size: 1.05rem;
		line-height: 1;
		font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 20;
	}

	.complementos-card__cta:not(:disabled):hover .complementos-card__cta-glyph {
		transform: translateX(3px) translateY(-1px) scale(1.05);
	}

	.complementos-card__cta--primary {
		background: var(--primary);
		color: var(--on-primary, #f8fbff);
	}

	.complementos-card__cta--primary .complementos-card__cta-glyph {
		background: color-mix(in srgb, #fff 16%, transparent);
	}

	.complementos-card__cta--soft {
		background: color-mix(in srgb, var(--on-surface) 6%, transparent);
		color: var(--on-surface);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--on-surface) 8%, transparent);
	}

	.complementos-card__cta--soft .complementos-card__cta-glyph {
		background: color-mix(in srgb, var(--on-surface) 8%, transparent);
	}

	html[data-theme='dark'] .complementos-card__shell {
		background: color-mix(in srgb, #050505 72%, #1a1a20);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
	}

	html[data-theme='dark'] .complementos-card__core {
		background: #0f0f13;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.08),
			inset 0 0 0 1px rgba(255, 255, 255, 0.04);
	}

	html[data-theme='dark'] .complementos-card:hover .complementos-card__shell {
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.14);
	}

	html[data-theme='dark'] .complementos-card__free {
		color: #3ee0a8;
	}

	html[data-theme='dark'] .complementos-card__status {
		color: #3ee0a8;
		background: color-mix(in srgb, #10b981 12%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #34d399 24%, transparent);
	}

	html[data-theme='dark'] .complementos-card__status-dot {
		background: #3ee0a8;
		box-shadow: 0 0 0 4px color-mix(in srgb, #3ee0a8 16%, transparent);
	}

	html[data-theme='light'] .complementos-card__hero {
		background:
			radial-gradient(70% 80% at 18% 12%, color-mix(in srgb, var(--primary) 18%, transparent), transparent 62%),
			radial-gradient(55% 60% at 88% 88%, color-mix(in srgb, #10b981 12%, transparent), transparent 58%),
			#eceff4;
	}

	html[data-theme='light'] .complementos-card__hero-mark {
		color: color-mix(in srgb, var(--primary) 70%, #111);
	}

	@media (prefers-reduced-motion: reduce) {
		.complementos-card,
		.complementos-card__shell,
		.complementos-card__cta,
		.complementos-card__cta-glyph,
		.complementos-card__hero-img {
			animation: none;
			transition: none;
		}

		.complementos-card:hover .complementos-card__shell,
		.complementos-card:active .complementos-card__shell,
		.complementos-card:hover .complementos-card__cta-glyph,
		.complementos-card:hover .complementos-card__hero-img {
			transform: none;
		}
	}
</style>

<script>
	import { initComplementosPage } from '../../scripts/complementos-page';

	const boot = () => {
		initComplementosPage();
	};

	boot();
	document.addEventListener('astro:page-load', boot);
