---
import SideNav from '../../components/SideNav.astro';
import TopBar from '../../components/TopBar.astro';
import Layout from '../../layouts/Layout.astro';
import { panelPageTitle } from '../../lib/panel-page-title';
import '../../styles/global.css';
---

<Layout pageTitle={panelPageTitle('Complementos')}>
	<complementos-store>
		<div class="min-h-screen bg-(--page-background)">
			<div
				class="app-shell grid min-h-screen overflow-hidden bg-transparent"
				data-app-shell
				data-sidebar-state="expanded"
			>
				<SideNav currentPath={Astro.url.pathname} />

				<div class="grid min-h-full grid-rows-[auto_1fr]">
					<TopBar />

					<main class="px-4 py-4 sm:px-6 sm:py-6">
						<section class="grid gap-4 sm:gap-5">
							<header class="complementos-header">
								<div class="grid gap-2 min-w-0">
									<h1 class="m-0 text-[1.5rem] font-bold leading-none tracking-tight text-(--on-surface) sm:text-[1.75rem]">
										Complementos
									</h1>
									<p
										class="m-0 max-w-2xl text-[0.92rem] leading-snug text-(--on-surface-variant)"
										data-complementos-lead
									>
										Módulos extras para tu clínica. Activálos cuando los necesites.
									</p>
								</div>
								<div class="complementos-tablist" role="tablist" aria-label="Secciones de complementos">
									<button
										type="button"
										class="complementos-tab is-active"
										role="tab"
										id="complementos-tab-explore"
										aria-selected="true"
										aria-controls="complementos-panel-explore"
										data-complementos-tab="explore"
									>
										Explorar
									</button>
									<button
										type="button"
										class="complementos-tab"
										role="tab"
										id="complementos-tab-mine"
										aria-selected="false"
										aria-controls="complementos-panel-mine"
										data-complementos-tab="mine"
									>
										Mis módulos
										<span class="complementos-tab__badge hidden" data-complementos-mine-badge>0</span>
									</button>
								</div>
							</header>

							<div
								class="complementos-banner"
								data-complementos-banner
								role="status"
							>
								<span class="material-symbols-rounded complementos-banner__icon" aria-hidden="true">
									verified
								</span>
								<div class="complementos-banner__copy">
									<p class="complementos-banner__kicker">Acceso temprano</p>
									<p class="complementos-banner__text">
										Activación gratuita. Te avisaremos antes de realizar cualquier cargo futuro.
									</p>
								</div>
							</div>

							<div
								class="hidden rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-4 py-3 text-[0.9rem] font-semibold text-(--on-surface-variant)"
								data-complementos-error
								role="alert"
							></div>

							<div
								class="grid place-items-center gap-3 rounded-2xl border border-(--shell-border) bg-(--surface-bright) px-6 py-14"
								data-complementos-loading
							>
								<span class="material-symbols-rounded animate-pulse text-[2rem] text-(--on-surface-variant)" aria-hidden="true">
									progress_activity
								</span>
								<p class="m-0 text-[0.9rem] font-semibold text-(--on-surface-variant)">Cargando complementos…</p>
							</div>

							<div
								id="complementos-panel-explore"
								role="tabpanel"
								aria-labelledby="complementos-tab-explore"
								data-complementos-panel="explore"
							>
								<div
									class="hidden grid place-items-center gap-2 rounded-2xl border border-dashed border-(--shell-border) bg-(--surface-bright) px-6 py-14 text-center"
									data-complementos-empty="explore"
								>
									<span class="material-symbols-rounded text-[2rem] text-(--on-surface-variant)" aria-hidden="true">
										storefront
									</span>
									<p class="m-0 text-[0.95rem] font-bold text-(--on-surface)">No hay más módulos para tu rubro</p>
									<p class="m-0 max-w-sm text-[0.85rem] font-medium text-(--on-surface-variant)">
										Cuando haya complementos disponibles para tu categoría, van a aparecer acá.
									</p>
								</div>
								<div class="hidden grid gap-4 sm:grid-cols-2" data-complementos-grid="explore"></div>
							</div>

							<div
								id="complementos-panel-mine"
								class="hidden"
								role="tabpanel"
								aria-labelledby="complementos-tab-mine"
								data-complementos-panel="mine"
								hidden
							>
								<div
									class="hidden grid place-items-center gap-2 rounded-2xl border border-dashed border-(--shell-border) bg-(--surface-bright) px-6 py-14 text-center"
									data-complementos-empty="mine"
								>
									<span class="material-symbols-rounded text-[2rem] text-(--on-surface-variant)" aria-hidden="true">
										extension
									</span>
									<p class="m-0 text-[0.95rem] font-bold text-(--on-surface)">Todavía no activaste ningún complemento</p>
									<p class="m-0 max-w-sm text-[0.85rem] font-medium text-(--on-surface-variant)">
										Explorá la tienda y activá el que necesites para tu negocio.
									</p>
								</div>
								<div class="hidden grid gap-4 sm:grid-cols-2" data-complementos-grid="mine"></div>
							</div>
						</section>
					</main>
				</div>
			</div>
		</div>
	</complementos-store>
</Layout>

<style is:global>
	/* is:global: las tarjetas se inyectan con JS y no reciben el scope de Astro */
	.complementos-header {
		display: grid;
		gap: 0.9rem;
	}

	@media (min-width: 720px) {
		.complementos-header {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: start;
			gap: 1rem 1.25rem;
		}
	}

	.complementos-tablist {
		display: flex;
		flex-wrap: nowrap;
		width: 100%;
		max-width: 22rem;
		gap: 0.25rem;
		padding: 0.25rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container) 88%, var(--surface-bright) 12%);
	}

	@media (min-width: 720px) {
		.complementos-tablist {
			width: auto;
			min-width: 16.5rem;
			justify-self: end;
		}
	}

	.complementos-tab {
		flex: 1 1 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 2.35rem;
		padding: 0.4rem 0.75rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--on-surface-variant);
		font-size: 0.84rem;
		font-weight: 700;
		white-space: nowrap;
		cursor: pointer;
		transition: background-color 140ms ease, color 140ms ease;
	}

	.complementos-tab:hover {
		color: var(--on-surface);
	}

	.complementos-tab.is-active {
		background: var(--surface-bright);
		color: var(--on-surface);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
	}

	.complementos-tab:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 55%, transparent);
		outline-offset: 2px;
	}

	.complementos-tab__badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.15rem;
		padding: 0.08rem 0.38rem;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 800;
		line-height: 1.2;
		background: color-mix(in srgb, var(--primary) 14%, transparent);
		color: var(--primary);
	}

	.complementos-tab.is-active .complementos-tab__badge {
		background: color-mix(in srgb, var(--primary) 18%, transparent);
	}

	html[data-theme='dark'] .complementos-tablist {
		background: color-mix(in srgb, var(--surface-container) 70%, rgb(255 255 255 / 0.04));
	}

	html[data-theme='dark'] .complementos-tab.is-active {
		background: color-mix(in srgb, var(--surface-bright) 92%, rgb(255 255 255 / 0.06));
		box-shadow: none;
	}

	.complementos-banner {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
		border-radius: 1.15rem;
		border: 1px solid color-mix(in srgb, #34d399 55%, transparent);
		background: linear-gradient(
			135deg,
			color-mix(in srgb, #10b981 22%, var(--surface-bright)) 0%,
			color-mix(in srgb, #0ea5e9 10%, var(--surface-bright)) 100%
		);
		box-shadow:
			inset 0 1px 0 color-mix(in srgb, #6ee7b7 28%, transparent),
			0 8px 24px color-mix(in srgb, #10b981 12%, transparent);
		padding: 0.95rem 1.1rem;
		color: color-mix(in srgb, var(--on-surface) 88%, #6ee7b7 12%);
	}

	.complementos-banner.is-hidden {
		display: none;
	}

	.complementos-banner__icon {
		flex-shrink: 0;
		margin-top: 0.08rem;
		font-size: 1.45rem;
		line-height: 1;
		color: #34d399;
	}

	.complementos-banner__copy {
		display: grid;
		gap: 0.18rem;
		min-width: 0;
	}

	.complementos-banner__kicker {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #6ee7b7;
	}

	.complementos-banner__text {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 650;
		line-height: 1.35;
		color: color-mix(in srgb, var(--on-surface) 92%, #a7f3d0 8%);
	}

	html[data-theme='light'] .complementos-banner {
		background: linear-gradient(135deg, #ecfdf5 0%, #e0f2fe 100%);
		border-color: color-mix(in srgb, #10b981 38%, #a7f3d0);
		color: #065f46;
		box-shadow: none;
	}

	html[data-theme='light'] .complementos-banner__icon,
	html[data-theme='light'] .complementos-banner__kicker {
		color: #047857;
	}

	html[data-theme='light'] .complementos-banner__text {
		color: #064e3b;
	}

	.complementos-card {
		display: grid;
		overflow: hidden;
		align-content: start;
		border-radius: 1.25rem;
		border: 1px solid var(--shell-border);
		background: var(--surface-bright, #fff);
		transition:
			border-color 160ms ease,
			box-shadow 160ms ease,
			opacity 160ms ease;
	}

	.complementos-card--media {
		grid-template-columns: 1fr;
		align-items: center;
		gap: 1rem;
		padding: 1.05rem 1.1rem 1.15rem;
	}

	@media (min-width: 720px) {
		.complementos-card--media {
			grid-template-columns: minmax(7.25rem, 30%) minmax(0, 1fr);
			gap: 1.15rem 1.4rem;
			padding: 1.15rem 1.25rem 1.2rem;
		}
	}

	.complementos-card:hover {
		border-color: color-mix(in srgb, var(--primary) 28%, var(--shell-border));
		box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
	}

	.complementos-card__preview {
		position: relative;
		min-height: 9.5rem;
		padding: 1rem 1.1rem 0.85rem;
		background:
			radial-gradient(120% 80% at 50% 0%, color-mix(in srgb, var(--primary) 16%, transparent), transparent 62%),
			color-mix(in srgb, var(--surface-container-high, #1a1a1c) 88%, var(--surface-bright));
		border-bottom: 1px solid var(--shell-border);
		overflow: hidden;
	}

	.complementos-card--media .complementos-card__preview {
		min-height: 0;
		width: min(11rem, 100%);
		aspect-ratio: 1;
		margin: 0 auto;
		padding: 0;
		border: 1px solid var(--shell-border);
		border-radius: 1.15rem;
		background: color-mix(in srgb, var(--surface-container-high, #1a1a1c) 70%, var(--surface-bright));
	}

	.complementos-card__preview--odontogram {
		min-height: 0;
		padding: 0.55rem;
		background: transparent;
		border-color: transparent;
	}

	.complementos-card__preview-img {
		position: absolute;
		inset: 0.45rem;
		width: calc(100% - 0.9rem);
		height: calc(100% - 0.9rem);
		object-fit: contain;
		object-position: center;
	}

	@media (min-width: 720px) {
		.complementos-card--media .complementos-card__preview {
			width: 100%;
			max-width: 12.5rem;
			margin: 0;
		}

		.complementos-card--media .complementos-card__body {
			align-content: center;
			padding: 0.15rem 0.15rem 0.1rem 0;
		}
	}

	.complementos-card__body {
		display: grid;
		gap: 1.05rem;
		padding: 1.2rem 1.3rem 1.3rem;
	}

	.complementos-card--media .complementos-card__body {
		padding: 0 0.1rem 0.15rem;
	}

	.complementos-card__title {
		margin: 0;
		font-size: 1.12rem;
		font-weight: 800;
		line-height: 1.25;
		color: var(--on-surface);
	}

	.complementos-card__desc {
		margin: 0.35rem 0 0;
		font-size: 0.9rem;
		font-weight: 550;
		line-height: 1.45;
		color: color-mix(in srgb, var(--on-surface) 74%, var(--on-surface-variant) 26%);
	}

	.complementos-card__price-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.55rem 0.75rem;
	}

	.complementos-card__price {
		font-size: 1.45rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--on-surface);
		line-height: 1;
	}

	.complementos-card__price.is-struck {
		font-size: 1.05rem;
		font-weight: 700;
		color: color-mix(in srgb, var(--on-surface-variant) 80%, transparent);
		text-decoration: line-through;
		text-decoration-thickness: 1.5px;
	}

	.complementos-card__free {
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1;
		color: #34d399;
	}

	.complementos-card__period {
		font-size: 0.8rem;
		font-weight: 650;
		color: color-mix(in srgb, var(--on-surface) 62%, var(--on-surface-variant) 38%);
	}

	.complementos-card__badge {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		border-radius: 999px;
		padding: 0.28rem 0.65rem;
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.02em;
		background: color-mix(in srgb, #10b981 14%, transparent);
		color: #34d399;
	}

	html[data-theme='light'] .complementos-card__badge {
		color: #059669;
	}

	html[data-theme='light'] .complementos-card__free {
		color: #059669;
	}

	.complementos-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		min-height: 2.65rem;
		border-radius: 0.95rem;
		padding: 0.65rem 1.1rem;
		font-size: 0.9rem;
		font-weight: 750;
		border: none;
		cursor: pointer;
		transition:
			background 140ms ease,
			color 140ms ease,
			opacity 140ms ease;
	}

	.complementos-btn:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}

	.complementos-btn--primary {
		background: var(--primary);
		color: var(--on-primary, #fff);
	}

	.complementos-btn--primary:hover:not(:disabled) {
		filter: brightness(1.05);
	}

	.complementos-btn--soft {
		background: color-mix(in srgb, var(--primary) 12%, transparent);
		color: var(--primary);
	}

	.complementos-btn--soft:hover:not(:disabled) {
		background: color-mix(in srgb, var(--primary) 18%, transparent);
	}
</style>

<script>
	import { initComplementosPage } from '../../scripts/complementos-page';

	const boot = () => {
		initComplementosPage();
	};

	boot();
	document.addEventListener('astro:page-load', boot);
</script>
