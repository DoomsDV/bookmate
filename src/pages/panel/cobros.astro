---
import FlashMessage from '../../components/FlashMessage.astro';
import SideNav from '../../components/SideNav.astro';
import TopBar from '../../components/TopBar.astro';
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

const token = Astro.locals.token ?? '';
const initialLoadError = token ? '' : 'No hay sesion valida para consultar cobros.';
---

<Layout>
	<cobros-manager>
		<div class="min-h-screen bg-(--page-background) transition-colors duration-300">
			<div
				class="app-shell grid min-h-screen overflow-hidden bg-transparent"
				data-app-shell
				data-sidebar-state="expanded"
			>
				<SideNav currentPath={Astro.url.pathname} />

				<div class="grid min-h-full grid-rows-[auto_1fr]">
					<TopBar />

					<main class="px-4 py-4 sm:px-6 sm:py-6">
						<section class="grid gap-4 sm:gap-5" data-requires-feature="DEPOSIT_COLLECTION">
							{
								initialLoadError ? (
									<FlashMessage message={initialLoadError} type="error" expand={true} dismissible={false} />
								) : (
									<div class="grid gap-3 sm:gap-4">
										<header class="grid gap-1">
											<h1 class="m-0 text-[1.5rem] font-bold leading-none tracking-tight text-(--on-surface) sm:text-[1.75rem]">
												Cobros{' '}
												<span class="font-semibold text-(--on-surface-variant)" data-cobros-summary>(0)</span>
											</h1>
											<p class="m-0 hidden text-[0.88rem] leading-snug text-(--on-surface-variant) sm:block">
												Revisá señas SIPAP y validá comprobantes pendientes.
											</p>
										</header>

										<select
											data-cobros-date-preset
											hidden
											class="hidden"
											aria-hidden="true"
											tabindex="-1"
										>
											<option value="this_month">Este mes</option>
											<option value="last_month">Mes pasado</option>
											<option value="custom">Personalizado</option>
										</select>

										<div class="flex items-start gap-2">
											<div class="flex min-w-0 flex-1 flex-wrap gap-2" role="tablist" aria-label="Estado">
												<button type="button" data-cobros-tab="all" class="cobros-tab">Todos</button>
												<button type="button" data-cobros-tab="pending" class="cobros-tab is-active">Pendientes</button>
												<button type="button" data-cobros-tab="approved" class="cobros-tab">Aprobados</button>
												<button type="button" data-cobros-tab="refunded" class="cobros-tab">Reembolsados</button>
											</div>
											<button
												type="button"
												class="cobros-period-filter-btn relative flex size-11 shrink-0 items-center justify-center rounded-2xl border border-(--shell-border) bg-(--surface-bright) text-(--on-surface-variant) shadow-sm transition hover:border-(--on-surface-variant) hover:text-(--on-surface) focus:border-(--primary) focus:outline-none focus:ring-4 focus:ring-(--primary)/10"
												data-open-period-filter
												aria-label="Filtrar por periodo"
												aria-haspopup="dialog"
												aria-controls="cobros-period-filter-sheet"
												aria-pressed="false"
											>
												<span class="material-symbols-rounded text-[1.25rem]" aria-hidden="true">tune</span>
												<span class="cobros-period-filter-badge hidden" data-period-filter-badge aria-hidden="true"></span>
											</button>
										</div>

										<div class="hidden rounded-2xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-[0.9rem] font-bold text-rose-500" data-cobros-error></div>
										<div
											class="cobros-loading hidden"
											data-cobros-loading
											aria-busy="true"
											aria-label="Cargando cobros"
										>
											<div class="cobros-loading__grid" aria-hidden="true">
												{Array.from({ length: 3 }).map(() => (
													<article class="cobros-loading__card">
														<div class="cobros-loading__row">
															<div class="panel-skeleton-line h-4 w-28 rounded"></div>
															<div class="panel-skeleton-line h-6 w-16 rounded-full"></div>
														</div>
														<div class="panel-skeleton-line mt-3 h-5 w-40 max-w-full rounded-md"></div>
														<div class="panel-skeleton-line mt-2 h-3.5 w-48 max-w-[85%] rounded"></div>
														<div class="panel-skeleton-line mt-4 h-11 w-full rounded-full md:hidden"></div>
													</article>
												))}
											</div>
										</div>

										<div class="overflow-hidden rounded-2xl border border-(--shell-border) bg-(--surface-bright)" data-cobros-results>
											<!-- Desktop headers -->
											<div class="hidden overflow-x-auto md:block" data-cobros-table-wrap>
												<table class="w-full min-w-[44rem] border-collapse text-left text-[0.92rem]">
													<thead>
														<tr class="border-b border-(--shell-border) text-[0.78rem] uppercase tracking-wide text-(--on-surface-variant)">
															<th class="px-4 py-3 font-bold">Fecha / Hora</th>
															<th class="px-4 py-3 font-bold">Cliente</th>
															<th class="px-4 py-3 font-bold">Servicio</th>
															<th class="px-4 py-3 font-bold">Monto</th>
															<th class="px-4 py-3 font-bold">Estado</th>
															<th class="px-4 py-3 font-bold"></th>
														</tr>
													</thead>
													<tbody data-cobros-table-body></tbody>
												</table>
											</div>

											<div class="hidden cobros-empty" data-cobros-empty role="status">
												<div class="cobros-empty__icon" aria-hidden="true">
													<span class="material-symbols-rounded">payments</span>
												</div>
												<h2 class="cobros-empty__title">No hay cobros</h2>
												<p class="cobros-empty__copy">
													No hay movimientos para el filtro seleccionado.
												</p>
											</div>

											<!-- Mobile cards -->
											<div class="grid gap-3 p-3 md:hidden" data-cobros-cards></div>
										</div>
									</div>
								)
							}
						</section>

						<section
							class="hidden rounded-2xl border border-(--shell-border) bg-(--surface-bright) p-6"
							data-cobros-feature-locked
						>
							<h2 class="text-xl font-bold text-(--on-surface)">Cobros es Premium</h2>
							<p class="mt-2 text-(--on-surface-variant)">
								El cobro de señas SIPAP está disponible en el plan Premium.
							</p>
							<a href="/panel/plan" class="mt-4 inline-flex h-11 items-center rounded-full bg-(--primary) px-5 text-sm font-semibold text-(--on-primary) no-underline">
								Ver planes
							</a>
						</section>
					</main>
				</div>
			</div>

			<dialog
				id="cobros-period-filter-sheet"
				class="cobros-period-filter-sheet"
				data-cobros-period-sheet
				aria-labelledby="cobros-period-filter-title"
			>
				<div class="cobros-period-filter-sheet__handle" aria-hidden="true">
					<span></span>
				</div>
				<div class="cobros-period-filter-sheet__header">
					<h2 id="cobros-period-filter-title" class="m-0 text-[1.05rem] font-extrabold tracking-tight">
						Periodo
					</h2>
					<button
						type="button"
						class="flex size-9 shrink-0 items-center justify-center rounded-full text-(--on-surface-variant) transition-colors hover:bg-(--surface-variant) hover:text-(--on-surface)"
						data-close-period-filter
						aria-label="Cerrar filtro"
					>
						<span class="material-symbols-rounded text-[1.3rem]">close</span>
					</button>
				</div>
				<div class="cobros-period-filter-sheet__body">
					<div class="cobros-period-filter-sheet__list" role="listbox" aria-label="Periodo">
						<button type="button" class="cobros-period-option" data-period-option="this_month" role="option">
							<span>Este mes</span>
							<span class="material-symbols-rounded" aria-hidden="true">check</span>
						</button>
						<button type="button" class="cobros-period-option" data-period-option="last_month" role="option">
							<span>Mes pasado</span>
							<span class="material-symbols-rounded" aria-hidden="true">check</span>
						</button>
						<button type="button" class="cobros-period-option" data-period-option="custom" role="option">
							<span>Personalizado</span>
							<span class="material-symbols-rounded" aria-hidden="true">check</span>
						</button>
					</div>
					<div class="cobros-period-custom hidden" data-cobros-custom-dates>
						<label class="grid gap-1.5 text-[0.85rem] font-bold text-(--on-surface)">
							Desde
							<span class="cobros-date-field">
								<input
									type="text"
									class="cobros-date-field__text"
									data-cobros-date-from-text
									inputmode="numeric"
									autocomplete="off"
									placeholder="dd/mm/aaaa"
									maxlength="10"
									aria-label="Fecha desde"
								/>
								<input type="hidden" data-cobros-date-from value="" />
								<button
									type="button"
									class="cobros-date-field__pick"
									data-cobros-date-from-pick
									aria-label="Elegir fecha desde"
								>
									<span class="material-symbols-rounded" aria-hidden="true">calendar_month</span>
								</button>
							</span>
						</label>
						<label class="grid gap-1.5 text-[0.85rem] font-bold text-(--on-surface)">
							Hasta
							<span class="cobros-date-field">
								<input
									type="text"
									class="cobros-date-field__text"
									data-cobros-date-to-text
									inputmode="numeric"
									autocomplete="off"
									placeholder="dd/mm/aaaa"
									maxlength="10"
									aria-label="Fecha hasta"
								/>
								<input type="hidden" data-cobros-date-to value="" />
								<button
									type="button"
									class="cobros-date-field__pick"
									data-cobros-date-to-pick
									aria-label="Elegir fecha hasta"
								>
									<span class="material-symbols-rounded" aria-hidden="true">calendar_month</span>
								</button>
							</span>
						</label>
						<p class="hidden m-0 text-[0.82rem] font-semibold text-rose-500" data-cobros-date-error></p>
						<button
							type="button"
							class="cobros-period-apply"
							data-apply-period-filter
						>
							Aplicar
						</button>
					</div>
				</div>
			</dialog>

			<dialog
				class="fixed inset-0 z-[10000] m-0 h-screen w-screen max-h-none max-w-none border-0 bg-transparent p-4 outline-none backdrop:bg-black/45 open:grid open:place-items-center"
				data-cobros-date-picker
				aria-labelledby="cobros-date-picker-label"
			>
				<div class="dtp-card">
					<div class="dtp-head">
						<div class="dtp-head-row">
							<p class="dtp-target-label" id="cobros-date-picker-label" data-cobros-dp-label>
								Seleccionando fecha
							</p>
							<button
								type="button"
								class="dtp-icon-btn"
								data-cobros-dp-close
								aria-label="Cerrar selector de fecha"
							>
								<span class="material-symbols-rounded text-[1.1rem]">close</span>
							</button>
						</div>

						<div class="dtp-nav-row">
							<div class="inline-flex items-center gap-1.5">
								<select
									data-cobros-dp-month
									class="dtp-select"
									aria-label="Seleccionar mes"
								></select>
								<select
									data-cobros-dp-year
									class="dtp-select dtp-select--year"
									aria-label="Seleccionar año"
								></select>
							</div>
							<div class="inline-flex items-center gap-1">
								<button
									type="button"
									class="dtp-icon-btn"
									data-cobros-dp-prev
									aria-label="Mes anterior"
								>
									<span class="material-symbols-rounded text-[1.05rem]">chevron_left</span>
								</button>
								<button
									type="button"
									class="dtp-icon-btn"
									data-cobros-dp-next
									aria-label="Mes siguiente"
								>
									<span class="material-symbols-rounded text-[1.05rem]">chevron_right</span>
								</button>
							</div>
						</div>

						<div class="dtp-weekdays">
							<span>Lun</span>
							<span>Mar</span>
							<span>Mié</span>
							<span>Jue</span>
							<span>Vie</span>
							<span>Sáb</span>
							<span>Dom</span>
						</div>
						<div class="dtp-days-grid" data-cobros-dp-days></div>
					</div>

					<div class="dtp-foot">
						<div class="dtp-foot-row cobros-dp-foot-row">
							<button type="button" class="dtp-action-btn" data-cobros-dp-today>Hoy</button>
							<button type="button" class="dtp-action-btn dtp-action-btn--primary" data-cobros-dp-apply>
								Hecho
							</button>
						</div>
					</div>
				</div>
			</dialog>

			<dialog
				class="cobros-modal m-0 max-h-[100dvh] w-full max-w-none border-0 bg-transparent p-0 text-(--on-surface) backdrop:bg-black/55 open:flex open:items-end open:justify-center sm:open:items-center"
				data-cobros-modal
			>
				<div class="flex max-h-[92dvh] w-full max-w-3xl flex-col overflow-hidden rounded-t-[1.5rem] bg-(--surface-bright) shadow-2xl sm:rounded-[1.5rem]">
					<header class="flex items-start justify-between gap-3 border-b border-(--shell-border) px-5 py-4">
						<div>
							<h2 class="m-0 text-lg font-bold" data-cobros-modal-title>Validar comprobante</h2>
							<p class="mt-1 text-sm text-(--on-surface-variant)" data-cobros-modal-subtitle></p>
						</div>
						<button type="button" class="grid size-10 place-items-center rounded-full hover:bg-(--control-surface)" data-cobros-modal-close aria-label="Cerrar">
							<span class="material-symbols-rounded">close</span>
						</button>
					</header>
					<div class="grid min-h-0 flex-1 gap-4 overflow-y-auto p-5 sm:grid-cols-[1.1fr_0.9fr]">
						<div class="overflow-hidden rounded-2xl border border-(--shell-border) bg-(--control-surface)">
							<img alt="Comprobante" class="hidden max-h-[50vh] w-full object-contain" data-cobros-modal-image />
							<p class="hidden p-6 text-sm text-(--on-surface-variant)" data-cobros-modal-no-image>Sin imagen de comprobante.</p>
						</div>
						<div class="grid gap-3 content-start">
							<div class="grid gap-1 text-sm">
								<span class="text-(--on-surface-variant)">Cliente</span>
								<strong data-cobros-modal-customer>—</strong>
							</div>
							<div class="grid gap-1 text-sm">
								<span class="text-(--on-surface-variant)">Servicio</span>
								<strong data-cobros-modal-service>—</strong>
							</div>
							<div class="grid gap-1 text-sm">
								<span class="text-(--on-surface-variant)">Monto</span>
								<strong data-cobros-modal-amount>—</strong>
							</div>
							<div class="grid gap-1 text-sm">
								<span class="text-(--on-surface-variant)">Código HASEL</span>
								<strong class="font-mono" data-cobros-modal-reference>—</strong>
							</div>
							<div class="grid gap-1 text-sm">
								<span class="text-(--on-surface-variant)">OCR</span>
								<strong data-cobros-modal-ocr>—</strong>
							</div>
							<div class="hidden grid gap-3" data-cobros-refund-block>
								<div class="grid gap-1 text-sm">
									<span class="text-(--on-surface-variant)">Estado reembolso</span>
									<strong data-cobros-modal-refund-status>—</strong>
								</div>
								<div class="grid gap-1 text-sm">
									<span class="text-(--on-surface-variant)">Alias SIPAP del cliente</span>
									<strong class="font-mono break-all" data-cobros-modal-refund-alias>—</strong>
								</div>
								<button
									type="button"
									class="hidden inline-flex h-12 items-center justify-center rounded-full bg-(--primary) px-5 text-base font-semibold text-(--on-primary)"
									data-cobros-mark-refund-sent
								>
									Marcar reembolso enviado
								</button>
								<p class="hidden text-sm font-semibold text-amber-700" data-cobros-claim-note></p>
								<div class="hidden grid gap-2" data-cobros-waive-wrap>
									<label class="grid gap-1 text-sm font-semibold">
										Renunciar al reembolso (motivo)
										<input type="text" maxlength="400" placeholder="Ej. cliente aceptó crédito / error de monto" class="cobros-select" data-cobros-waive-reason />
									</label>
									<button type="button" class="inline-flex h-11 items-center justify-center rounded-full border border-(--shell-border) px-5 text-sm font-semibold" data-cobros-waive>
										Marcar como renunciado (WAIVED)
									</button>
								</div>
							</div>
							<label class="grid gap-1 text-sm font-semibold" data-cobros-reject-wrap>
								Motivo de rechazo (opcional)
								<input type="text" maxlength="400" placeholder="Ej. foto borrosa, monto distinto" class="cobros-select" data-cobros-reject-reason />
							</label>
							<div class="mt-2 grid gap-2" data-cobros-modal-actions>
								<button type="button" class="inline-flex h-12 items-center justify-center rounded-full bg-(--primary) px-5 text-base font-semibold text-(--on-primary)" data-cobros-approve>
									Aprobar seña
								</button>
								<button type="button" class="inline-flex h-12 items-center justify-center rounded-full border border-rose-500/40 bg-rose-500/10 px-5 text-base font-semibold text-rose-600" data-cobros-reject>
									Rechazar
								</button>
							</div>
							<p class="text-sm text-(--on-surface-variant)" data-cobros-modal-status></p>
						</div>
					</div>
				</div>
			</dialog>
		</div>
	</cobros-manager>
</Layout>

<style>
	.cobros-tab {
		border-radius: 999px;
		border: 1px solid var(--shell-border);
		background: var(--surface-bright);
		padding: 0.55rem 1rem;
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--on-surface);
		cursor: pointer;
	}
	.cobros-tab.is-active {
		background: var(--primary-container);
		color: var(--primary);
		border-color: transparent;
	}
	.cobros-select {
		border-radius: 1rem;
		border: 1px solid var(--shell-border);
		background: var(--surface-bright);
		padding: 0.65rem 0.9rem;
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--on-surface);
		outline: none;
	}
	[data-cobros-table-wrap].is-empty,
	[data-cobros-cards].hidden,
	[data-cobros-results].hidden,
	.cobros-loading.hidden {
		display: none !important;
	}

	.cobros-loading {
		display: block;
	}

	.cobros-loading__grid {
		display: grid;
		gap: 0.75rem;
	}

	.cobros-loading__card {
		border-radius: 1.15rem;
		border: 1px solid var(--shell-border);
		background: var(--surface-bright);
		padding: 1rem 1.05rem;
	}

	.cobros-loading__row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	@media (min-width: 768px) {
		.cobros-loading__grid {
			gap: 0.65rem;
		}

		.cobros-loading__card {
			border-radius: 1rem;
			padding: 0.95rem 1.15rem;
		}
	}

	.cobros-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		padding: 1.75rem 1.25rem;
		text-align: center;
		background: transparent;
	}
	.cobros-empty.hidden {
		display: none;
	}
	.cobros-empty__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3.5rem;
		height: 3.5rem;
		margin-bottom: 0.5rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container) 88%, var(--surface-bright) 12%);
		color: var(--on-surface-variant);
	}
	.cobros-empty__icon .material-symbols-rounded {
		font-size: 1.75rem;
	}
	.cobros-empty__title {
		margin: 0;
		font-size: 1.1rem;
		font-weight: 800;
		color: var(--on-surface);
	}
	.cobros-empty__copy {
		margin: 0;
		max-width: 18rem;
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--on-surface-variant);
	}

	.cobros-period-filter-btn.is-active {
		border-color: color-mix(in srgb, var(--primary) 55%, var(--shell-border));
		color: var(--primary);
		background: color-mix(in srgb, var(--primary) 10%, var(--surface-bright));
	}
	.cobros-period-filter-badge {
		position: absolute;
		top: 0.45rem;
		right: 0.45rem;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--primary);
		box-shadow: 0 0 0 2px var(--surface-bright);
	}
	.cobros-period-filter-sheet {
		position: fixed;
		inset: auto 0 0;
		z-index: 80;
		margin: 0;
		width: 100vw;
		max-width: none;
		max-height: min(72dvh, 28rem);
		border: 1px solid var(--shell-border);
		border-bottom: 0;
		border-radius: 1.6rem 1.6rem 0 0;
		background: var(--surface-bright);
		color: var(--on-surface);
		padding: 0;
		overflow: hidden;
		box-shadow: 0 -12px 40px rgb(0 0 0 / 0.18);
	}
	.cobros-period-filter-sheet[open] {
		display: flex;
		flex-direction: column;
	}
	.cobros-period-filter-sheet::backdrop {
		background: rgb(0 0 0 / 0.4);
	}
	.cobros-period-filter-sheet__handle {
		display: flex;
		justify-content: center;
		padding: 0.65rem 0 0.15rem;
