									<span class="cobros-detail-field__label">Estado reembolso</span>
									<strong class="cobros-refund-status" data-cobros-modal-refund-status>—</strong>
								</div>
								<div class="cobros-refund-panel__alias">
									<span class="cobros-detail-field__label">Alias SIPAP del cliente</span>
									<strong class="cobros-refund-alias" data-cobros-modal-refund-alias>—</strong>
								</div>
							</div>
						</section>
					</div>

					<footer class="cobros-modal-footer z-20 mt-auto shrink-0 border-t border-(--shell-border) bg-(--surface-bright) px-5 py-4">
						<div class="hidden" data-cobros-modal-actions>
							<div class="cobros-reject-reveal" data-cobros-reject-wrap>
								<div class="cobros-reject-alert" role="status">
									<span class="material-symbols-rounded cobros-reject-alert__icon" aria-hidden="true">warning</span>
									<p class="cobros-reject-alert__text">
										¿Confirmás el rechazo? El cliente deberá subir un nuevo comprobante.
									</p>
								</div>
								<label class="grid gap-1.5 pb-3.5 text-sm font-semibold">
									Motivo de rechazo (opcional)
									<input type="text" maxlength="400" placeholder="Ej. foto borrosa, monto distinto" class="cobros-select" data-cobros-reject-reason />
								</label>
							</div>
							<div class="cobros-modal-actions" data-cobros-actions-default>
								<button
									type="button"
									class="cobros-modal-btn cobros-modal-btn--ghost cobros-modal-btn--icon"
									data-cobros-reject
									data-requires-write
									aria-label="Rechazar seña"
								>
									<span class="material-symbols-rounded" aria-hidden="true">close</span>
									<span class="cobros-modal-btn__label" data-cobros-reject-label>Rechazar</span>
								</button>
								<button
									type="button"
									class="cobros-modal-btn cobros-modal-btn--primary"
									data-cobros-approve
									data-requires-write
								>
									<span class="material-symbols-rounded" aria-hidden="true" data-cobros-approve-icon
										>check</span
									>
									<span class="cobros-modal-btn__label">Aprobar</span>
								</button>
							</div>
							<div class="cobros-modal-actions hidden" data-cobros-actions-reject>
								<button
									type="button"
									class="cobros-modal-btn cobros-modal-btn--muted"
									data-cobros-reject-cancel
								>
									Cancelar
								</button>
								<button
									type="button"
									class="cobros-modal-btn cobros-modal-btn--danger"
									data-cobros-reject-confirm
									data-requires-write
								>
									Rechazar
								</button>
							</div>
						</div>
						<div class="hidden grid gap-3" data-cobros-refund-actions>
							<div class="hidden grid gap-1.5" data-cobros-waive-wrap>
								<label class="grid gap-1.5 text-sm font-semibold">
									Motivo para omitir el reembolso
									<input
										type="text"
										maxlength="400"
										placeholder="Ej. el cliente aceptó un crédito"
										class="cobros-select"
										data-cobros-waive-reason
									/>
								</label>
							</div>
							<div class="cobros-modal-actions cobros-modal-actions--refund">
								<button
									type="button"
									class="cobros-modal-btn cobros-modal-btn--primary cobros-modal-btn--island group"
									data-cobros-mark-refund-sent
									data-requires-write
								>
									<span class="cobros-modal-btn__label">Marcar como enviado</span>
									<span class="cobros-modal-btn__icon-ring" aria-hidden="true">
										<span class="material-symbols-rounded" data-cobros-refund-sent-icon>check</span>
									</span>
								</button>
								<button
									type="button"
									class="cobros-modal-btn cobros-modal-btn--text"
									data-cobros-waive
									data-requires-write
								>
									Omitir reembolso
								</button>
							</div>
						</div>
						<div class="hidden grid gap-3" data-cobros-dispute-actions>
							<div class="cobros-modal-actions cobros-modal-actions--refund">
								<button
									type="button"
									class="cobros-modal-btn cobros-modal-btn--primary cobros-modal-btn--island group"
									data-cobros-dispute-upload
									data-requires-write
								>
									<span class="cobros-modal-btn__label" data-cobros-dispute-upload-label>Enviar prueba</span>
									<span class="cobros-modal-btn__icon-ring" aria-hidden="true">
										<span class="material-symbols-rounded" data-cobros-dispute-upload-icon>upload</span>
									</span>
								</button>
							</div>
						</div>
						<p class="text-sm text-(--on-surface-variant)" data-cobros-modal-status role="status" aria-live="polite"></p>
					</footer>
				</div>
			</dialog>

			<FileViewer label="Archivo" />
		</div>
	</cobros-manager>
</Layout>

<style>
	.cobros-tab {
		border-radius: 999px;
		border: 1px solid var(--shell-border);
		background: var(--surface-bright);
		padding: 0.55rem 1rem;
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--on-surface);
		cursor: pointer;
		user-select: none;
		-webkit-user-select: none;
	}
