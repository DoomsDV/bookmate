											<span class="material-symbols-rounded cobros-dropzone__icon" aria-hidden="true">cloud_upload</span>
											<span class="cobros-dropzone__title">Subí el comprobante o arrastralo acá</span>
										</div>
										<div class="cobros-dropzone__preview hidden" data-cobros-dropzone-preview>
