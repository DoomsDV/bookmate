	.app-pagination[hidden] {
		display: none !important;
	}

	/* Móvil: sin caja externa → cards sueltas (como Clientes/Servicios) */
	@media (max-width: 767px) {
		.cobros-results {
			border: 0;
			background: transparent;
			border-radius: 0;
			overflow: visible;
			box-shadow: none;
