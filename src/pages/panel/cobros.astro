								</div>
								<label class="grid gap-1.5 pb-3.5 text-sm font-semibold">
									Motivo de rechazo (opcional)
									<input type="text" maxlength="400" placeholder="Ej. foto borrosa, monto distinto" class="cobros-select" data-cobros-reject-reason />
								</label>
							</div>
							<div class="cobros-modal-actions" data-cobros-actions-default>
								<button
									type="button"
									class="cobros-modal-btn cobros-modal-btn--ghost cobros-modal-btn--icon"
									data-cobros-reject
									aria-label="Rechazar seña"
								>
									<span class="material-symbols-rounded" aria-hidden="true">close</span>
									<span class="cobros-modal-btn__label" data-cobros-reject-label>Rechazar</span>
								</button>
								<button
									type="button"
									class="cobros-modal-btn cobros-modal-btn--primary"
									data-cobros-approve
								>
									<span class="material-symbols-rounded" aria-hidden="true">check</span>
									<span class="cobros-modal-btn__label">Aprobar</span>
								</button>
							</div>
							<div class="cobros-modal-actions hidden" data-cobros-actions-reject>
								<button
									type="button"
									class="cobros-modal-btn cobros-modal-btn--muted"
									data-cobros-reject-cancel
								>
									Cancelar
								</button>
								<button
									type="button"
									class="cobros-modal-btn cobros-modal-btn--danger"
									data-cobros-reject-confirm
								>
									Rechazar
								</button>
							</div>
						</div>
						<div class="hidden grid gap-3" data-cobros-refund-actions>
							<div class="hidden grid gap-1.5" data-cobros-waive-wrap>
								<label class="grid gap-1.5 text-sm font-semibold">
									Motivo para omitir el reembolso
									<input
										type="text"
										maxlength="400"
										placeholder="Ej. el cliente aceptó un crédito"
										class="cobros-select"
										data-cobros-waive-reason
									/>
								</label>
							</div>
							<div class="cobros-modal-actions cobros-modal-actions--refund">
								<button
									type="button"
									class="cobros-modal-btn cobros-modal-btn--primary"
									data-cobros-mark-refund-sent
								>
									Marcar como enviado
								</button>
								<button
									type="button"
									class="cobros-modal-btn cobros-modal-btn--text"
									data-cobros-waive
								>
									Omitir reembolso
								</button>
							</div>
						</div>
						<p class="text-sm text-(--on-surface-variant)" data-cobros-modal-status></p>
					</footer>
				</div>
			</dialog>

			<FileViewer label="Comprobante" />
		</div>
	</cobros-manager>
</Layout>

