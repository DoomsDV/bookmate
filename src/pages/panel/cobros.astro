---
import AppPagination from '../../components/AppPagination.astro';
import FileViewer from '../../components/FileViewer.astro';
import FlashMessage from '../../components/FlashMessage.astro';
import SideNav from '../../components/SideNav.astro';
import TopBar from '../../components/TopBar.astro';
import { ROLES } from '../../config/roles';
import Layout from '../../layouts/Layout.astro';
import { panelPageTitle } from '../../lib/panel-page-title';
import '../../styles/global.css';

const token = Astro.locals.token ?? '';
const isAdmin = Number(Astro.locals.roleId ?? 0) === ROLES.ADMIN;
const initialLoadError = token ? '' : 'No hay sesion valida para consultar cobros.';
---

<Layout pageTitle={panelPageTitle('Cobros')}>
	<cobros-manager>
		<div class="min-h-screen bg-(--page-background)">
			<div
				class="app-shell grid min-h-screen overflow-hidden bg-transparent"
				data-app-shell
				data-sidebar-state="expanded"
			>
				<SideNav currentPath={Astro.url.pathname} />

				<div class="grid min-h-full grid-rows-[auto_1fr]">
					<TopBar />

					<main class="px-4 py-4 sm:px-6 sm:py-6">
						<section class="grid gap-4 sm:gap-5" data-requires-feature="DEPOSIT_COLLECTION">
							{
								initialLoadError ? (
									<FlashMessage message={initialLoadError} type="error" expand={true} dismissible={false} />
								) : (
									<div class="grid gap-3 sm:gap-4">
										<header class="flex items-start justify-between gap-3">
											<div class="grid min-w-0 gap-1">
												<h1 class="m-0 text-[1.5rem] font-bold leading-none tracking-tight text-(--on-surface) sm:text-[1.75rem]">
													Cobros{' '}
													<span class="font-semibold text-(--on-surface-variant)" data-cobros-summary>(0)</span>
												</h1>
												<p class="m-0 hidden text-[0.88rem] leading-snug text-(--on-surface-variant) sm:block">
													Revisá señas SIPAP y validá comprobantes pendientes.
												</p>
											</div>
											<button
												type="button"
												class="cobros-period-filter-btn relative flex size-11 shrink-0 items-center justify-center rounded-2xl border border-(--shell-border) bg-(--surface-bright) text-(--on-surface-variant) shadow-sm transition hover:border-(--on-surface-variant) hover:text-(--on-surface) focus:border-(--primary) focus:outline-none focus:ring-4 focus:ring-(--primary)/10"
												data-open-period-filter
												aria-label="Filtrar por periodo"
												aria-haspopup="dialog"
												aria-controls="cobros-period-filter-sheet"
												aria-pressed="false"
												title="Filtrar por periodo"
											>
												<span class="material-symbols-rounded text-[1.25rem]" aria-hidden="true">tune</span>
												<span class="cobros-period-filter-badge hidden" data-period-filter-badge aria-hidden="true"></span>
											</button>
										</header>

										<select
											data-cobros-date-preset
											hidden
											class="hidden"
											aria-hidden="true"
											tabindex="-1"
										>
											<option value="all" selected>Todos los meses</option>
											<option value="this_month">Este mes</option>
											<option value="last_month">Mes pasado</option>
											<option value="custom">Personalizado</option>
										</select>

										<div class="hidden min-w-0 flex-wrap gap-2 md:flex" role="tablist" aria-label="Estado">
											<button type="button" data-cobros-tab="all" class="cobros-tab is-active">Todos</button>
											<button type="button" data-cobros-tab="pending" class="cobros-tab">Pendientes</button>
											<button type="button" data-cobros-tab="approved" class="cobros-tab">Aprobados</button>
											<button type="button" data-cobros-tab="refunded" class="cobros-tab">Reembolsados</button>
											<button type="button" data-cobros-tab="expired" class="cobros-tab">Vencidos</button>
										</div>

										<div class="hidden rounded-2xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-[0.9rem] font-bold text-rose-500" data-cobros-error></div>
										<div
											class="cobros-loading hidden"
											data-cobros-loading
											aria-busy="true"
											aria-label="Cargando cobros"
										>
											<div class="cobros-loading__grid" aria-hidden="true">
												{Array.from({ length: 3 }).map(() => (
													<article class="cobros-loading__card">
														<div class="cobros-loading__row">
															<div class="panel-skeleton-line h-4 w-32 rounded"></div>
															<div class="panel-skeleton-line h-6 w-20 rounded-full"></div>
														</div>
														<div class="panel-skeleton-line mt-3 h-3 w-24 max-w-[50%] rounded"></div>
														<div class="panel-skeleton-line mt-3 h-8 w-36 max-w-full rounded-md"></div>
														<div class="panel-skeleton-line mt-2 h-3.5 w-40 max-w-[70%] rounded"></div>
														<div class="panel-skeleton-line mt-4 h-11 w-full rounded-full md:hidden"></div>
													</article>
												))}
											</div>
										</div>

										<div class="cobros-results overflow-hidden rounded-2xl border border-(--shell-border) bg-(--surface-bright)" data-cobros-results>
											<!-- Desktop headers -->
											<div class="hidden overflow-x-auto md:block" data-cobros-table-wrap>
												<table class="w-full min-w-[44rem] border-collapse text-left text-[0.92rem]">
													<thead>
														<tr class="border-b border-(--shell-border) text-[0.78rem] uppercase tracking-wide text-(--on-surface-variant)">
															<th class="px-4 py-3 font-bold">
																<div class="cobros-th-date">
																	<span>Fecha / Hora</span>
																	<span class="cobros-sort" role="group" aria-label="Ordenar por fecha y hora">
																		<button
																			type="button"
																			class="cobros-sort__btn"
																			data-cobros-sort="asc"
																			aria-pressed="false"
																			aria-label="Más antiguos primero"
																			title="Más antiguos primero"
																		>
																			<span class="material-symbols-rounded" aria-hidden="true">keyboard_arrow_up</span>
																		</button>
																		<button
																			type="button"
																			class="cobros-sort__btn is-active"
																			data-cobros-sort="desc"
																			aria-pressed="true"
																			aria-label="Más recientes primero"
																			title="Más recientes primero"
																		>
																			<span class="material-symbols-rounded" aria-hidden="true">keyboard_arrow_down</span>
																		</button>
																	</span>
																</div>
															</th>
															<th class="px-4 py-3 font-bold">Cliente</th>
															<th class="px-4 py-3 font-bold">Servicio</th>
															<th class="px-4 py-3 font-bold">Monto</th>
															<th class="px-4 py-3 font-bold">Estado</th>
															<th class="px-4 py-3 font-bold"></th>
														</tr>
													</thead>
													<tbody data-cobros-table-body></tbody>
												</table>
											</div>

											<div class="hidden cobros-empty" data-cobros-empty role="status">
												<div class="cobros-empty__icon" aria-hidden="true">
													<span class="material-symbols-rounded">payments</span>
												</div>
												<h2 class="cobros-empty__title">No hay cobros</h2>
												<p class="cobros-empty__copy">
													No hay movimientos para el filtro seleccionado.
												</p>
											</div>

											<!-- Mobile cards -->
											<div class="cobros-cards grid gap-3 md:hidden" data-cobros-cards></div>
										</div>

										<AppPagination
											currentPage={1}
											totalPages={1}
											totalRecords={0}
											recordLabel="cobros"
											ariaLabel="Paginacion cobros"
											hidden={true}
											rootDataAttr="data-cobros-pagination"
											summaryDataAttr="data-cobros-page-label"
											pagesDataAttr="data-cobros-pagination-pages"
											prevDataAttr="data-cobros-prev"
											nextDataAttr="data-cobros-next"
											pageDataAttr="data-cobros-page"
										/>
									</div>
								)
							}
						</section>

						<section
							class="hidden rounded-2xl border border-(--shell-border) bg-(--surface-bright) p-6"
							data-cobros-feature-locked
						>
							<h2 class="text-xl font-bold text-(--on-surface)">Cobros es Premium</h2>
							<p class="mt-2 text-(--on-surface-variant)">
								El cobro de señas SIPAP está disponible en el plan Premium.
							</p>
							{
								isAdmin ? (
									<a href="/panel/plan" class="mt-4 inline-flex h-11 items-center rounded-full bg-(--primary) px-5 text-sm font-semibold text-(--on-primary) no-underline">
										Ver planes
									</a>
								) : (
									<p class="mt-4 text-sm font-medium text-(--on-surface-variant)">
										Pedile al administrador del negocio que revise el plan.
									</p>
								)
							}
						</section>
					</main>
				</div>
			</div>

			<dialog
				id="cobros-period-filter-sheet"
				class="cobros-period-filter-sheet"
				data-cobros-period-sheet
				aria-labelledby="cobros-period-filter-title"
			>
				<div class="cobros-period-filter-sheet__handle" aria-hidden="true">
					<span></span>
				</div>
				<div class="cobros-period-filter-sheet__header">
					<h2 id="cobros-period-filter-title" class="m-0 text-[1.05rem] font-extrabold tracking-tight">
						<span class="md:hidden">Filtros</span>
						<span class="hidden md:inline">Periodo</span>
					</h2>
					<button
						type="button"
						class="flex size-9 shrink-0 items-center justify-center rounded-full text-(--on-surface-variant) transition-colors hover:bg-(--surface-variant) hover:text-(--on-surface)"
						data-close-period-filter
						aria-label="Cerrar filtro"
					>
						<span class="material-symbols-rounded text-[1.3rem]">close</span>
					</button>
				</div>
				<div class="cobros-period-filter-sheet__body">
					<div class="cobros-filter-group md:hidden">
						<label class="cobros-filter-group__label" for="cobros-status-select">Estado</label>
						<div class="cobros-filter-select">
							<select id="cobros-status-select" data-cobros-status-select aria-label="Estado">
								<option value="all">Todos</option>
								<option value="pending">Pendientes</option>
								<option value="approved">Aprobados</option>
								<option value="refunded">Reembolsados</option>
								<option value="expired">Vencidos</option>
							</select>
							<span class="material-symbols-rounded cobros-filter-select__chevron" aria-hidden="true">expand_more</span>
						</div>
					</div>
					<p class="cobros-filter-group__label md:hidden">Periodo</p>
					<div class="cobros-period-filter-sheet__list" role="listbox" aria-label="Periodo">
						<button type="button" class="cobros-period-option" data-period-option="all" role="option">
							<span>Todos los meses</span>
							<span class="material-symbols-rounded" aria-hidden="true">check</span>
						</button>
						<button type="button" class="cobros-period-option" data-period-option="this_month" role="option">
							<span>Este mes</span>
							<span class="material-symbols-rounded" aria-hidden="true">check</span>
						</button>
						<button type="button" class="cobros-period-option" data-period-option="last_month" role="option">
							<span>Mes pasado</span>
							<span class="material-symbols-rounded" aria-hidden="true">check</span>
						</button>
						<button type="button" class="cobros-period-option" data-period-option="custom" role="option">
							<span>Personalizado</span>
							<span class="material-symbols-rounded" aria-hidden="true">check</span>
						</button>
					</div>
					<div class="cobros-period-custom hidden" data-cobros-custom-dates>
						<label class="grid gap-1.5 text-[0.85rem] font-bold text-(--on-surface)">
							Desde
							<span class="cobros-date-field">
								<input
									type="text"
									class="cobros-date-field__text"
									data-cobros-date-from-text
									inputmode="numeric"
									autocomplete="off"
									placeholder="dd/mm/aaaa"
									maxlength="10"
									aria-label="Fecha desde"
								/>
								<input type="hidden" data-cobros-date-from value="" />
								<button
									type="button"
									class="cobros-date-field__pick"
									data-cobros-date-from-pick
									aria-label="Elegir fecha desde"
								>
									<span class="material-symbols-rounded" aria-hidden="true">calendar_month</span>
								</button>
							</span>
						</label>
						<label class="grid gap-1.5 text-[0.85rem] font-bold text-(--on-surface)">
							Hasta
							<span class="cobros-date-field">
								<input
									type="text"
									class="cobros-date-field__text"
									data-cobros-date-to-text
									inputmode="numeric"
									autocomplete="off"
									placeholder="dd/mm/aaaa"
									maxlength="10"
									aria-label="Fecha hasta"
								/>
								<input type="hidden" data-cobros-date-to value="" />
								<button
									type="button"
									class="cobros-date-field__pick"
									data-cobros-date-to-pick
									aria-label="Elegir fecha hasta"
								>
									<span class="material-symbols-rounded" aria-hidden="true">calendar_month</span>
								</button>
							</span>
						</label>
						<p class="hidden m-0 text-[0.82rem] font-semibold text-rose-500" data-cobros-date-error></p>
						<button
							type="button"
							class="cobros-period-apply"
							data-apply-period-filter
						>
							Aplicar
						</button>
					</div>

					<dialog
						class="cobros-date-picker"
						data-cobros-date-picker
						aria-labelledby="cobros-date-picker-label"
					>
						<div class="dtp-card">
							<div class="dtp-head">
								<div class="dtp-head-row">
									<p class="dtp-target-label" id="cobros-date-picker-label" data-cobros-dp-label>
										Seleccionando fecha
									</p>
									<button
										type="button"
										class="dtp-icon-btn"
										data-cobros-dp-close
										aria-label="Cerrar selector de fecha"
									>
										<span class="material-symbols-rounded text-[1.1rem]">close</span>
									</button>
								</div>

								<div class="dtp-nav-row">
									<div class="inline-flex items-center gap-1.5">
										<select
											data-cobros-dp-month
											class="dtp-select"
											aria-label="Seleccionar mes"
										></select>
										<select
											data-cobros-dp-year
											class="dtp-select dtp-select--year"
											aria-label="Seleccionar año"
										></select>
									</div>
									<div class="inline-flex items-center gap-1">
										<button
											type="button"
											class="dtp-icon-btn"
											data-cobros-dp-prev
											aria-label="Mes anterior"
										>
											<span class="material-symbols-rounded text-[1.05rem]">chevron_left</span>
										</button>
										<button
											type="button"
											class="dtp-icon-btn"
											data-cobros-dp-next
											aria-label="Mes siguiente"
										>
											<span class="material-symbols-rounded text-[1.05rem]">chevron_right</span>
										</button>
									</div>
								</div>

								<div class="dtp-weekdays">
									<span>Lun</span>
									<span>Mar</span>
									<span>Mié</span>
									<span>Jue</span>
									<span>Vie</span>
									<span>Sáb</span>
									<span>Dom</span>
								</div>
								<div class="dtp-days-grid" data-cobros-dp-days></div>
							</div>

							<div class="dtp-foot">
								<div class="dtp-foot-row cobros-dp-foot-row">
									<button type="button" class="dtp-action-btn" data-cobros-dp-today>Hoy</button>
									<button type="button" class="dtp-action-btn dtp-action-btn--primary" data-cobros-dp-apply>
										Hecho
									</button>
								</div>
							</div>
						</div>
					</dialog>
				</div>
			</dialog>

			<dialog
				class="cobros-modal m-0 max-h-none w-screen max-w-none border-0 bg-transparent p-0 text-(--on-surface) shadow-none open:flex open:flex-col open:items-stretch open:justify-end sm:open:items-center sm:open:justify-center lg:open:flex-row lg:open:items-stretch lg:open:justify-end"
				data-cobros-modal
				aria-labelledby="cobros-modal-title"
			>
				<div
					class="cobros-modal__panel relative flex max-h-[92dvh] w-full max-w-none flex-col overflow-hidden rounded-t-[1.5rem] rounded-b-none border border-(--shell-border) bg-(--surface-bright) shadow-[0_24px_80px_rgba(0,0,0,0.2)] sm:max-h-[min(90vh,40rem)] sm:w-[min(28rem,calc(100vw-2rem))] sm:max-w-[28rem] sm:rounded-[1.5rem] lg:h-[100dvh] lg:max-h-[100dvh] lg:w-[min(26rem,100vw)] lg:max-w-[26rem] lg:rounded-none lg:border-y-0 lg:border-r-0 lg:shadow-none"
					data-cobros-modal-panel
				>
					<header class="panel-modal-header">
						<div class="panel-modal-header__row">
							<div class="panel-modal-header__text">
								<h2 id="cobros-modal-title" class="panel-modal-header__title" data-cobros-modal-title>Validar comprobante</h2>
								<p class="panel-modal-header__subtitle" data-cobros-modal-subtitle></p>
							</div>
							<button type="button" class="panel-modal-header__close" data-cobros-modal-close aria-label="Cerrar">
								<span class="material-symbols-rounded">close</span>
							</button>
						</div>
					</header>
					<div class="grid min-h-0 flex-1 content-start gap-5 overflow-y-auto overscroll-contain p-5">
						<div
							class="cobros-receipt-row hidden items-center gap-3 rounded-xl border border-(--shell-border) bg-(--control-surface) px-3.5 py-3"
							data-cobros-receipt-row
						>
							<span
								class="material-symbols-rounded shrink-0 text-[1.4rem] text-(--primary)"
								aria-hidden="true"
								data-cobros-receipt-icon
							>description</span>
							<div class="min-w-0 flex-1">
								<p class="m-0 truncate text-sm font-bold text-(--on-surface)" data-cobros-receipt-name>comprobante</p>
								<p class="m-0 text-xs text-(--on-surface-variant)">Comprobante adjunto</p>
							</div>
							<button
								type="button"
								class="cobros-receipt-open cursor-pointer"
								title="Ver comprobante"
								aria-label="Ver comprobante"
								data-cobros-receipt-open
							>
								<span class="material-symbols-rounded" aria-hidden="true">visibility</span>
							</button>
						</div>
						<p class="hidden rounded-xl border border-dashed border-(--shell-border) px-4 py-4 text-sm text-(--on-surface-variant)" data-cobros-modal-no-image>
							Sin comprobante adjunto.
						</p>

						<div class="cobros-ticket grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-x-5 sm:gap-y-4" data-cobros-ticket>
							<div class="grid gap-1 min-w-0">
								<span class="text-[0.72rem] font-semibold uppercase tracking-wide text-(--on-surface-variant)">Cliente</span>
								<strong class="truncate text-[1.05rem] font-extrabold leading-snug" data-cobros-modal-customer>—</strong>
							</div>
							<div class="grid gap-1 min-w-0 sm:text-right">
								<span class="text-[0.72rem] font-semibold uppercase tracking-wide text-(--on-surface-variant)">Monto</span>
								<strong class="text-[1.15rem] font-extrabold leading-snug tabular-nums" data-cobros-modal-amount>—</strong>
							</div>
							<div class="grid gap-1 min-w-0">
								<span class="text-[0.72rem] font-semibold uppercase tracking-wide text-(--on-surface-variant)">Servicio</span>
								<strong class="truncate text-[0.98rem] font-bold leading-snug" data-cobros-modal-service>—</strong>
							</div>
							<div class="grid gap-1 min-w-0 sm:text-right">
								<span class="text-[0.72rem] font-semibold uppercase tracking-wide text-(--on-surface-variant)">Código HASEL</span>
								<strong class="truncate font-mono text-[0.92rem] font-bold leading-snug" data-cobros-modal-reference>—</strong>
							</div>
							<div class="grid gap-1 min-w-0">
								<span class="text-[0.72rem] font-semibold uppercase tracking-wide text-(--on-surface-variant)">Profesional</span>
								<strong class="truncate text-[0.98rem] font-bold leading-snug" data-cobros-modal-professional>—</strong>
							</div>
							<div class="grid gap-1 min-w-0 sm:text-right">
								<span class="text-[0.72rem] font-semibold uppercase tracking-wide text-(--on-surface-variant)">Lugar</span>
								<strong class="truncate text-[0.98rem] font-bold leading-snug" data-cobros-modal-location>—</strong>
							</div>
						</div>

						<div class="hidden grid gap-4" data-cobros-refund-block>
							<div class="grid gap-1 min-w-0">
								<span class="text-[0.72rem] font-semibold uppercase tracking-wide text-(--on-surface-variant)">Estado reembolso</span>
								<strong class="text-[0.98rem] font-bold leading-snug" data-cobros-modal-refund-status>—</strong>
							</div>
							<div class="grid gap-1 min-w-0">
								<span class="text-[0.72rem] font-semibold uppercase tracking-wide text-(--on-surface-variant)">Alias SIPAP del cliente</span>
								<strong class="break-all font-mono text-[0.98rem] font-bold leading-snug" data-cobros-modal-refund-alias>—</strong>
							</div>
							<p class="hidden text-sm font-semibold text-amber-700" data-cobros-claim-note></p>
						</div>
					</div>

					<footer class="cobros-modal-footer z-20 mt-auto shrink-0 border-t border-(--shell-border) bg-(--surface-bright) px-5 py-4">
						<div class="hidden" data-cobros-modal-actions>
							<div class="cobros-reject-reveal" data-cobros-reject-wrap>
