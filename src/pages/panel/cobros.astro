												class="cobros-dropzone__thumb hidden"
												data-cobros-preview-image
											/>
											<div class="cobros-dropzone__pdf hidden" data-cobros-preview-pdf>
												<span class="material-symbols-rounded" aria-hidden="true">description</span>
