										<span class="material-symbols-rounded" aria-hidden="true">delete</span>
									</button>
								</div>
							</div>
						</section>

						<div class="cobros-detail-receipt hidden" data-cobros-receipt-row>
							<div class="cobros-detail-receipt__inner">
								<div class="cobros-detail-receipt__icon" aria-hidden="true">
									<span class="material-symbols-rounded" data-cobros-receipt-icon>description</span>
								</div>
								<div class="cobros-detail-receipt__copy min-w-0 flex-1">
									<p class="cobros-detail-receipt__name" data-cobros-receipt-name>comprobante</p>
									<p class="cobros-detail-receipt__meta" data-cobros-receipt-meta>Comprobante de seña (cliente)</p>
								</div>
								<button
									type="button"
									class="cobros-detail-receipt__cta group"
									title="Ver comprobante de seña"
									aria-label="Ver comprobante de seña"
									data-cobros-receipt-open
								>
									<span class="cobros-detail-receipt__cta-label">Ver</span>
									<span class="cobros-detail-receipt__cta-icon" aria-hidden="true">
										<span class="material-symbols-rounded">visibility</span>
									</span>
								</button>
							</div>
						</div>
						<p class="cobros-detail-empty hidden" data-cobros-modal-no-image>
							Sin comprobante de seña.
						</p>

						<section class="cobros-detail-sheet" data-cobros-ticket>
							<div class="cobros-detail-sheet__hero">
								<span class="cobros-detail-field__label" data-cobros-amount-label>Monto</span>
								<strong class="cobros-detail-sheet__amount tabular-nums" data-cobros-modal-amount>—</strong>
							</div>
							<div class="cobros-detail-sheet__grid">
								<div class="cobros-detail-field">
									<span class="cobros-detail-field__label">Cliente</span>
									<strong class="cobros-detail-field__value" data-cobros-modal-customer>—</strong>
								</div>
								<div class="cobros-detail-field">
									<span class="cobros-detail-field__label">Servicio</span>
									<strong class="cobros-detail-field__value" data-cobros-modal-service>—</strong>
								</div>
								<div class="cobros-detail-field cobros-detail-field--wide">
									<span class="cobros-detail-field__label">Código HASEL</span>
									<strong class="cobros-detail-field__value cobros-detail-field__value--mono" data-cobros-modal-reference>—</strong>
								</div>
								<div class="cobros-detail-field cobros-detail-field--wide">
									<span class="cobros-detail-field__label">Profesional</span>
									<strong class="cobros-detail-field__value" data-cobros-modal-professional>—</strong>
								</div>
								<div class="cobros-detail-field cobros-detail-field--wide">
									<span class="cobros-detail-field__label">Lugar</span>
									<strong class="cobros-detail-field__value" data-cobros-modal-location>—</strong>
								</div>
							</div>
						</section>

						<section class="cobros-refund-panel hidden" data-cobros-refund-block>
							<div class="cobros-refund-panel__inner">
