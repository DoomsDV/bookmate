	.cobros-sort {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0;
		margin: -0.15rem 0;
	}

	.cobros-sort__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.35rem;
		height: 0.95rem;
		padding: 0;
		border: 0;
		border-radius: 0.35rem;
		background: transparent;
		color: color-mix(in srgb, var(--on-surface-variant) 72%, transparent);
		cursor: pointer;
		transition:
			color 420ms cubic-bezier(0.32, 0.72, 0, 1),
			background-color 420ms cubic-bezier(0.32, 0.72, 0, 1),
			transform 420ms cubic-bezier(0.32, 0.72, 0, 1);
	}

	.cobros-sort__btn .material-symbols-rounded {
		font-size: 1.05rem;
		line-height: 1;
		font-variation-settings: 'wght' 500, 'opsz' 20;
