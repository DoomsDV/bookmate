		border-color: transparent;
	}
	.cobros-select {
		border-radius: 1rem;
		border: 1px solid var(--shell-border);
		background: var(--surface-bright);
		padding: 0.65rem 0.9rem;
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--on-surface);
