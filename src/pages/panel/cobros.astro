	[data-cobros-results].hidden,
	.cobros-loading.hidden,
	[data-cobros-refund-actions].hidden,
	[data-cobros-refund-block].hidden,
	.cobros-refund-panel.hidden,
	[data-cobros-waive-wrap].hidden,
	[data-cobros-mark-refund-sent].hidden,
	[data-cobros-waive].hidden,
	[data-cobros-dispute-lead].hidden,
