---
import Layout from '../../layouts/Layout.astro';
import PublicSipapDepositPanel from '../../components/PublicSipapDepositPanel.astro';
import {
	buildPublicUserProfileMetaDescription,
	getPublicUserProfileWithOrds,
	PublicUserProfileApiError,
	type PublicUserProfile,
} from '../../lib/public-user-profile';
import {
	buildGlobalPublicProfilePath,
	resolveOgImageUrl,
	resolvePublicSiteOrigin,
} from '../../lib/public-profile-url';
import '../../styles/global.css';
import '../../styles/public-booking.css';

const publicSlug = String(Astro.params.slug || '').trim();

const toSafePageStatus = (status: number, hasProfile: boolean) => {
	if (hasProfile) return 200;
	const parsed = Number(status);
	if (!Number.isInteger(parsed)) return 200;
	if (parsed >= 400 && parsed < 500) return parsed;
	return 200;
};

let profile: PublicUserProfile | null = null;
let loadError = '';
let statusCode = 500;

if (!publicSlug) {
	loadError = 'Enlace de perfil inválido.';
	statusCode = 404;
} else {
	try {
		profile = await getPublicUserProfileWithOrds(publicSlug);
		statusCode = 200;
	} catch (error) {
		const profileError =
			error instanceof PublicUserProfileApiError
				? error
				: new PublicUserProfileApiError('No fue posible cargar este perfil público.', 500);
		loadError = profileError.message;
		statusCode = profileError.status || 500;
	}
}

Astro.response.status = toSafePageStatus(statusCode, Boolean(profile));
const serializedProfile = profile
	? JSON.stringify(profile).replace(/</g, '\\u003c').replace(/-->/g, '--\\>')
	: '';

const siteOrigin = resolvePublicSiteOrigin(Astro.url.origin);
const canonicalPath = buildGlobalPublicProfilePath(publicSlug) || Astro.url.pathname;
const professionalName = profile?.full_name?.trim() || publicSlug;

const pageTitle = profile ? `Agendá con ${professionalName} | Hasel` : 'Reserva online | Hasel';
const metaDescription = profile
	? buildPublicUserProfileMetaDescription({
			fullName: professionalName,
			locationCount: profile.locations.length,
		})
	: 'Reservá turnos online con profesionales en Hasel.';
const ogImageAlt = profile ? `Foto de perfil de ${professionalName}` : 'Hasel — reservas online';
const ogImage = profile ? resolveOgImageUrl(profile.image_url, siteOrigin) : resolveOgImageUrl('', siteOrigin);
const googleMapsApiKey =
	import.meta.env.PUBLIC_G_MAPS_API_KEY ??
	import.meta.env.PUBLIC_G_MAPS_API_KEYS ??
	'';
---

<Layout
	pageTitle={pageTitle}
	metaDescription={metaDescription}
	canonicalPath={canonicalPath}
	siteOrigin={siteOrigin}
	ogImage={ogImage}
	ogImageAlt={ogImageAlt}
	ogType="profile"
	robots={profile ? 'index, follow' : 'noindex, nofollow'}
>
	<main class="public-booking-shell">
		{
			loadError || !profile ? (
				<div class="public-booking-shell__canvas">
				<section class="rounded-3xl border border-rose-200 bg-rose-50 px-8 py-10 text-rose-900 shadow-sm">
					<h1 class="text-3xl font-semibold tracking-tight">No fue posible abrir este perfil</h1>
					<p class="mt-3 text-base font-medium text-rose-800">{loadError || 'Perfil no disponible.'}</p>
					<a
						href="/"
						class="mt-6 inline-flex rounded-full bg-rose-100 px-6 py-2.5 text-sm font-medium text-rose-900 no-underline transition hover:bg-rose-200"
					>
						Volver al inicio
					</a>
				</section>
				</div>
			) : (
				<section
					class="public-booking-sheet"
					data-public-user-booking-root
					data-booting
					data-public-slug={publicSlug}
					data-google-maps-api-key={googleMapsApiKey}
				>
					<script type="application/json" id="public-user-profile-json" set:html={serializedProfile}></script>

					<header class="public-booking-profile" data-booking-profile-header>
						<div class="public-booking-profile__inner">
							{profile.image_url ? (
								<img
									src={profile.image_url}
									alt={`Foto de ${profile.full_name}`}
									loading="lazy"
									class="public-booking-avatar"
								/>
							) : (
								<div
									class="public-booking-avatar public-booking-avatar--empty"
									aria-label={`Sin foto de ${profile.full_name}`}
									role="img"
								>
									<span class="material-symbols-rounded">account_circle</span>
								</div>
							)}
							<div class="public-booking-profile__text">
								<p class="public-booking-profile__eyebrow">Agendar cita con</p>
								<h1 class="public-booking-profile__title">{profile.full_name}</h1>
								<p class="public-booking-profile__subtitle">
									Elegí dónde atenderte y reservá tu turno
								</p>
							</div>
						</div>
					</header>

					<div class="public-booking-shell__canvas">
					<div class="public-booking-stepper">
						<div class="public-booking-stepper__mobile">
							<p class="text-sm font-medium tracking-wide text-(--on-surface)" data-step-compact-label aria-live="polite">
								Paso 1 de 4: Servicio
							</p>
							<div class="h-2 flex-1 overflow-hidden rounded-full bg-(--surface-container-highest)" aria-hidden="true">
								<div
									class="h-full rounded-full bg-(--primary) transition-[width] duration-500 ease-out"
									data-step-progress-bar
									style="width:25%"
								></div>
							</div>
						</div>
						<ol data-step-indicator>
							<li data-step-item="1" class="step-item-current">1. Servicio</li>
							<li data-step-item="2" class="step-item-default">2. Fecha</li>
							<li data-step-item="3" class="step-item-default">3. Horario</li>
							<li data-step-item="4" class="step-item-default">4. Datos</li>
						</ol>
					</div>

					<div class="hidden rounded-2xl mb-3 px-5 py-4 text-sm font-medium shadow-sm transition-all" data-booking-toast></div>

					<section data-step-panel="1" class="public-booking-panel">
						<div class="public-booking-back-row hidden" data-back-to-orgs-wrap>
							<button type="button" data-back-to-orgs class="public-booking-back-link">
								<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
								Volver
							</button>
						</div>
						<div class="grid gap-2">
							<h2 class="text-2xl font-normal tracking-tight text-(--on-surface)" data-step1-title>
								Seleccioná un negocio
							</h2>
							<p class="text-base text-(--on-surface-variant)" data-step1-subtitle>
								Elegí el negocio para ver ubicaciones y servicios.
							</p>
						</div>
						<div class="mt-5 grid gap-4" data-user-locations-root></div>
					</section>

					<section data-step-panel="2" class="public-booking-panel hidden">
						<div class="public-booking-back-row">
							<button type="button" data-back-to-locations class="public-booking-back-link">
								<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
								Volver
							</button>
						</div>
						<div class="grid gap-2">
							<h2 class="text-2xl font-normal tracking-tight text-(--on-surface)">Seleccioná una fecha</h2>
						</div>
						<div class="public-booking-calendar mt-5">
							<div class="public-booking-calendar__toolbar">
								<button type="button" data-calendar-prev class="calendar-nav-btn" aria-label="Mes anterior">
									<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
								</button>
								<p class="public-booking-calendar__month" data-calendar-month></p>
								<button type="button" data-calendar-next class="calendar-nav-btn" aria-label="Mes siguiente">
									<span class="material-symbols-rounded" aria-hidden="true">chevron_right</span>
								</button>
							</div>
							<div class="public-booking-calendar__weekdays">
								<span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span>
								<span>Vie</span><span>Sáb</span><span>Dom</span>
							</div>
							<div class="public-booking-calendar__grid" data-calendar-grid></div>
						</div>
					</section>

					<section data-step-panel="3" class="public-booking-panel hidden">
						<div class="public-booking-back-row">
							<button type="button" data-back-to-calendar class="public-booking-back-link">
								<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
								Volver
							</button>
						</div>
						<div class="grid gap-2">
							<h2 class="text-2xl font-normal tracking-tight text-(--on-surface)">Seleccioná un horario</h2>
							<p class="text-base text-(--on-surface-variant)">
								<span class="font-medium text-(--on-surface)" data-summary-date-inline></span>
							</p>
						</div>
						<div data-slots-loading class="public-slots-skeleton mt-5 hidden" aria-busy="true" aria-live="polite">
							<span class="sr-only">Consultando horarios disponibles…</span>
							<div class="public-slots-skeleton__roulette" aria-hidden="true">
								<span class="public-slots-skeleton__bar public-slots-skeleton__bar--far"></span>
								<span class="public-slots-skeleton__bar public-slots-skeleton__bar--near"></span>
								<span class="public-slots-skeleton__bar public-slots-skeleton__bar--focus"></span>
								<span class="public-slots-skeleton__bar public-slots-skeleton__bar--near"></span>
								<span class="public-slots-skeleton__bar public-slots-skeleton__bar--far"></span>
							</div>
							<div class="public-slots-skeleton__grid" aria-hidden="true">
								<span class="public-slots-skeleton__chip"></span>
								<span class="public-slots-skeleton__chip"></span>
								<span class="public-slots-skeleton__chip"></span>
								<span class="public-slots-skeleton__chip"></span>
								<span class="public-slots-skeleton__chip"></span>
								<span class="public-slots-skeleton__chip"></span>
								<span class="public-slots-skeleton__chip"></span>
								<span class="public-slots-skeleton__chip"></span>
							</div>
						</div>
						<div class="mt-5 grid gap-6" data-slots-container></div>
						<div data-no-slots class="public-slots-empty mt-10 hidden">
							<span class="material-symbols-rounded public-slots-empty__icon" aria-hidden="true"
								>event_busy</span
							>
							<p class="public-slots-empty__text">
								No se encontraron horarios para este día. Seleccioná otra fecha para continuar.
							</p>
							<button type="button" data-back-to-calendar class="public-slots-empty__action">
								Volver al calendario
							</button>
						</div>
					</section>

					<section data-step-panel="4" class="public-booking-panel hidden">
						<div class="public-booking-back-row">
							<button type="button" data-back-to-slots class="public-booking-back-link">
								<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
								Volver
							</button>
						</div>
						<h2 class="text-2xl font-normal tracking-tight text-(--on-surface)">Confirmá tus datos</h2>
						<div class="mt-5 grid gap-5 lg:grid-cols-[1fr_22rem] lg:gap-8">
							<form class="contents lg:grid lg:gap-5" data-customer-form>
								<label class="grid gap-1.5 text-sm font-medium text-(--on-surface)">
									<span>Teléfono (WhatsApp) <span class="text-(--error)" aria-hidden="true">*</span></span>
									<div class="flex h-14 w-full overflow-hidden rounded-xl border border-(--outline) bg-(--surface-container-lowest) transition focus-within:border-(--primary) focus-within:ring-1 focus-within:ring-(--primary)">
										<span class="inline-flex items-center border-r border-(--outline) bg-(--surface-container-high) px-3 text-sm font-semibold text-(--on-surface-variant)">+595</span>
										<input type="tel" name="customer_phone" maxlength="11" required inputmode="numeric" autocomplete="tel-national" class="min-w-0 flex-1 border-0 bg-transparent px-4 text-base text-(--on-surface) outline-none" placeholder="Ej: 981 123 456" />
									</div>
									<span class="hidden text-xs font-medium text-(--error)" data-field-error="customer_phone"></span>
								</label>
								<label class="hidden grid gap-1.5 text-sm font-medium text-(--on-surface)" data-customer-name-wrapper>
									<span>Nombre completo <span class="text-(--error)" aria-hidden="true">*</span></span>
									<input type="text" name="customer_name" maxlength="100" autocomplete="name" class="h-14 rounded-xl border border-(--outline) bg-(--surface-container-lowest) px-4 text-base outline-none transition focus:border-(--primary) focus:ring-1 focus:ring-(--primary)" placeholder="Ej: Juan Perez" />
									<span class="hidden text-xs font-medium text-(--error)" data-field-error="customer_name"></span>
								</label>
								<p data-submit-error class="hidden rounded-2xl bg-(--error-container) px-4 py-3 text-sm font-medium text-(--on-error-container)"></p>
								<label
									data-deposit-policy-wrap
									class="hidden flex items-start gap-3 px-0 py-1"
								>
									<input
										type="checkbox"
										name="policy_accepted"
										value="1"
										data-deposit-policy-accept
										class="mt-1 size-5 accent-(--primary)"
									/>
									<span class="grid gap-1 text-sm text-left">
										<span class="font-semibold text-(--on-surface)">
											Acepto la política de cancelación
											<span class="text-(--error)" aria-hidden="true">*</span>
										</span>
										<span class="font-medium text-(--on-surface-variant)" data-deposit-policy-summary>
											—
										</span>
									</span>
								</label>
								<span class="hidden text-xs font-medium text-(--error) text-left" data-field-error="policy_accepted"></span>
								<p class="public-booking-notice" data-booking-stay-open-notice>
									<span class="material-symbols-rounded" aria-hidden="true">info</span>
									<span>No cierres esta página hasta confirmar. Si salís o cerrás el navegador, la cita no se reservará.</span>
								</p>
								<div class="order-3 grid gap-3 lg:order-none lg:mt-3">
									<button type="submit" data-submit-booking class="booking-primary-action inline-flex h-12 w-full items-center justify-center rounded-full px-8 text-base font-medium transition disabled:cursor-not-allowed disabled:opacity-60">
										Confirmar reserva
									</button>
									<button type="button" data-pay-deposit-submit class="booking-primary-action is-hidden inline-flex h-12 w-full items-center justify-center gap-2 rounded-full px-8 text-base font-medium transition disabled:cursor-not-allowed disabled:opacity-60">
										<span>Confirmar y transferir seña</span>
										<span aria-hidden="true">🔒</span>
									</button>
								</div>
							</form>
							<aside class="public-booking-summary order-2 self-start lg:order-none">
								<h3 class="text-xs font-bold uppercase tracking-widest text-(--primary)">Resumen</h3>
								<ul class="mt-5 grid gap-3">
									<li class="public-booking-summary__row"><span class="public-booking-summary__label">Servicio</span><span class="public-booking-summary__value" data-summary-service></span></li>
									<li class="public-booking-summary__row"><span class="public-booking-summary__label">Fecha</span><span class="public-booking-summary__value" data-summary-date></span></li>
									<li class="public-booking-summary__row"><span class="public-booking-summary__label">Hora</span><span class="public-booking-summary__value" data-summary-time></span></li>
									<li class="public-booking-summary__row"><span class="public-booking-summary__label">Ubicación</span><button type="button" class="public-location-link public-booking-summary__value cursor-pointer text-right font-normal disabled:cursor-not-allowed disabled:text-(--on-surface-variant)" data-summary-location>Ubicación no disponible</button></li>
									<li class="public-booking-summary__row public-booking-summary__row--deposit hidden" data-summary-deposit-wrap><span class="public-booking-summary__label">Seña requerida</span><span class="public-booking-summary__deposit" data-summary-deposit></span></li>
								</ul>
							</aside>
						</div>
					</section>

					<section data-step-panel="5" class="public-booking-panel hidden rounded-none bg-(--tertiary-container) text-(--on-tertiary-container)">
						<h2 class="text-3xl font-normal tracking-tight">Reserva confirmada</h2>
						<p class="mt-2 text-base font-medium opacity-90">
							¡Todo listo! Te enviamos los detalles a tu WhatsApp.
						</p>
						<div class="mt-6 rounded-3xl bg-(--surface-container-lowest) p-6 shadow-sm">
							<ul class="grid gap-4 text-base">
								<li class="grid"><span class="text-sm font-medium text-(--on-surface-variant)">Profesional</span><span class="font-normal text-(--on-surface)" data-ticket-professional></span></li>
								<li class="grid"><span class="text-sm font-medium text-(--on-surface-variant)">Servicio</span><span class="font-normal text-(--on-surface)" data-ticket-service></span></li>
								<li class="grid"><span class="text-sm font-medium text-(--on-surface-variant)">Fecha</span><span class="font-normal text-(--on-surface)" data-ticket-date></span></li>
								<li class="grid"><span class="text-sm font-medium text-(--on-surface-variant)">Hora</span><span class="font-normal text-(--on-surface)" data-ticket-time></span></li>
							</ul>
						</div>
						<button type="button" data-restart-booking class="mt-8 inline-flex h-12 items-center justify-center rounded-full bg-(--tertiary) px-8 text-base font-medium text-(--on-tertiary)">
							Reservar otra cita
						</button>
					</section>

					<PublicSipapDepositPanel />

					<dialog class="public-map-modal rounded-[28px] border-0 bg-(--surface-container-high) p-0 text-(--on-surface) shadow-[0_24px_64px_rgba(0,0,0,0.55)] backdrop:bg-black/70" data-public-map-modal>
						<div class="grid gap-5 p-6">
							<div class="flex items-start justify-between gap-4">
								<div>
									<h2 class="text-xl font-semibold tracking-tight">Ubicación</h2>
									<p class="mt-1 text-sm text-(--on-surface-variant)" data-public-map-address></p>
								</div>
								<button
									type="button"
									class="grid h-10 w-10 place-items-center rounded-full text-(--on-surface-variant) transition hover:bg-(--surface-container-highest) hover:text-(--on-surface)"
									data-public-map-close
									aria-label="Cerrar mapa"
								>
									<span class="material-symbols-rounded">close</span>
								</button>
							</div>
							<div class="public-map-canvas-wrap relative h-96 overflow-hidden rounded-2xl bg-(--surface-container-highest)">
								<div class="h-full w-full" data-public-map-canvas></div>
								<div
									class="public-map-loading absolute inset-0 z-10 hidden place-items-center bg-(--surface-container-highest)/85 backdrop-blur-[2px]"
									data-public-map-loading
									aria-hidden="true"
									aria-live="polite"
									aria-label="Cargando mapa"
								>
									<span class="material-symbols-rounded animate-spin text-[1.75rem] text-(--primary)" aria-hidden="true">progress_activity</span>
								</div>
							</div>
							<p class="hidden rounded-2xl bg-(--error-container) px-4 py-3 text-sm font-medium text-(--on-error-container)" data-public-map-status></p>
						</div>
					</dialog>
					</div>
				</section>
			)
		}
	</main>
</Layout>

<script>
	import { initializePublicUserBookingPage } from '../../scripts/public-user-booking/index';

	const boot = () => initializePublicUserBookingPage();
	boot();
	document.addEventListener('astro:page-load', boot);
</script>

<style is:global>
	html:has(.public-booking-shell),
	html:has(.public-booking-shell) body {
		background: #1b1b1b;
	}

	.public-booking-shell {
		--surface-background: #1b1b1b;
		--surface-container-lowest: #141414;
		--surface-container-low: #1b1b1b;
		--surface-container: #1b1b1b;
		--surface-container-high: #252528;
		--surface-container-highest: #2e2e32;
		--outline: #44474e;
		--outline-variant: #44474e;
		--on-surface: #e2e2e9;
		--on-surface-variant: #c4c6d0;
		--primary: #a8c7fa;
		--on-primary: #062e6f;
		--primary-container: #0842a0;
		--on-primary-container: #d3e3fd;
		--primary-hover: #b9d4fa;
		--tertiary: #c7eccb;
		--on-tertiary: #0c381c;
		--tertiary-container: #225031;
		--on-tertiary-container: #e3ffe6;
		--error: #ffb4ab;
		--error-container: #93000a;
		--on-error-container: #ffdad6;
	}

	.secondary-action-btn {
		display: inline-flex;
		height: 2.75rem;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		border: 1px solid var(--outline);
		background: transparent;
		padding: 0 1.5rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--on-surface);
		transition: background 0.15s ease;
	}
	.secondary-action-btn:hover { background: var(--surface-container-highest); }

	[data-booking-toast].is-error {
		border: 1px solid var(--error-container);
		background: var(--error-container);
		color: var(--on-error-container);
	}
	[data-booking-toast].is-success {
		border: 1px solid var(--tertiary-container);
		background: var(--tertiary-container);
		color: var(--on-tertiary-container);
	}

	.user-org-group + .user-org-group {
		margin-top: 0;
	}

	.public-booking-shell .grid.gap-4 > .user-org-group {
		margin-top: 0;
	}

	.public-map-modal {
		width: min(92vw, 44rem);
		max-height: min(92vh, 48rem);
		margin: auto;
		border: none;
		box-shadow: 0 24px 64px rgba(0, 0, 0, 0.55);
	}

	.public-map-canvas-wrap.is-loading [data-public-map-canvas] {
		visibility: hidden;
	}

	.public-map-loading {
		display: grid;
	}

	.public-map-loading.hidden {
		display: none;
	}

	.public-location-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		width: fit-content;
		border: 0;
		background: transparent;
		padding: 0;
		font: inherit;
		color: var(--primary);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.public-location-link:hover:not(:disabled) {
		color: var(--primary-hover);
	}

	.public-location-link:hover:not(:disabled) .public-location-link__label {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.public-location-link:hover:not(:disabled):not(:has(.public-location-link__label)) {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

