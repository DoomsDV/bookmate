---
import Layout from '../layouts/Layout.astro';
import PublicHaselTopbar from '../components/PublicHaselTopbar.astro';
import { searchOrgDirectory, type OrgDirectoryItem } from '../lib/public-org-directory';
import '../styles/global.css';
const siteOrigin = String(Astro.site ?? Astro.url.origin).replace(/\/+$/, '');

const orgInitial = (name: string) => {
	const letter = String(name || '').trim().charAt(0);
	return letter ? letter.toLocaleUpperCase('es') : 'H';
};

const CITY_DISPLAY: Record<string, string> = {
	asuncion: 'Asunción',
	capiata: 'Capiatá',
	'ciudad del este': 'Ciudad del Este',
	encarnacion: 'Encarnación',
	itaugua: 'Itauguá',
	lambare: 'Lambaré',
	nemby: 'Ñemby',
};

const toDisplayCityName = (value: string) => {
	const raw = String(value || '').trim();
	if (!raw) return '';
	const folded = raw
		.normalize('NFD')
		.replace(/\p{M}/gu, '')
		.toLowerCase()
		.replace(/\s+/g, ' ')
		.trim();
	if (CITY_DISPLAY[folded]) return CITY_DISPLAY[folded];
	const particles = new Set(['de', 'del', 'la', 'las', 'los', 'y']);
	return raw
		.toLocaleLowerCase('es')
		.split(/\s+/)
		.map((word, index) =>
			index > 0 && particles.has(word)
				? word
				: word.charAt(0).toLocaleUpperCase('es') + word.slice(1)
		)
		.join(' ');
};

let previewOrgs: OrgDirectoryItem[] = [];
let previewSpecialties: { code: string; label: string }[] = [];
try {
	const directory = await searchOrgDirectory();
	previewOrgs = directory.items.slice(0, 4).map((item) => ({
		...item,
		city_name: toDisplayCityName(item.city_name),
	}));
	previewSpecialties = directory.facets.specialties.slice(0, 4);
} catch {
	previewOrgs = [];
	previewSpecialties = [];
}

type AppReview = {
	name: string;
	role: string;
	org: string;
	stars: 4 | 5;
	quote: string;
};

const featuredReview: AppReview = {
	name: 'Dann Villasanti',
	role: 'Quiropráctico',
	org: 'Consultorio General',
	stars: 5,
	quote: 'Dejé de coordinar turnos por WhatsApp. El cliente reserva y yo veo todo en el calendario.',
};

const moreReviews: AppReview[] = [
	{
		name: 'Ramón Villasanti',
		role: 'Quiropráctico',
		org: 'Consultorio General',
		stars: 5,
		quote: 'El equipo comparte la misma agenda. Ya no se pisan los horarios.',
	},
	{
		name: 'Max Gómez',
		role: 'Administrador',
		org: 'Fisio Max',
		stars: 4,
		quote: 'El link de reservas me ahorra idas y vueltas. La gente elige horario y llega.',
	},
];

const starSlots = [1, 2, 3, 4, 5] as const;

type InboxKind = 'book' | 'pay' | 'ok';

type InboxNote = {
	kind: InboxKind;
	title: string;
	detail: string;
};

const inboxIcons: Record<InboxKind, string> = {
	book: 'chat',
	pay: 'payments',
	ok: 'event_available',
};

const inboxNotes: InboxNote[] = [
	{ kind: 'book', title: 'Nueva reserva', detail: 'Ana Ríos, masaje' },
	{ kind: 'pay', title: 'Seña recibida', detail: 'HASEL-4K2P, ₲ 50.000' },
	{ kind: 'ok', title: 'Turno confirmado', detail: 'Ramón, quiropraxia' },
	{ kind: 'book', title: 'Nueva reserva', detail: 'Lucía Benítez, fisioterapia' },
	{ kind: 'ok', title: 'Turno confirmado', detail: 'Carlos Duarte, consulta' },
	{ kind: 'pay', title: 'Seña recibida', detail: 'HASEL-9M1C, ₲ 80.000' },
	{ kind: 'book', title: 'Nueva reserva', detail: 'Sofía Acosta, evaluación' },
	{ kind: 'ok', title: 'Turno confirmado', detail: 'Martín López, masaje' },
	{ kind: 'book', title: 'Nueva reserva', detail: 'Elena Franco, quiropraxia' },
	{ kind: 'pay', title: 'Seña recibida', detail: 'HASEL-7Q3L, ₲ 40.000' },
	{ kind: 'book', title: 'Nueva reserva', detail: 'Diego Bareiro, consulta' },
	{ kind: 'ok', title: 'Turno confirmado', detail: 'Camila Núñez, fisioterapia' },
];

const inboxVisible = inboxNotes.slice(0, 3);
const inboxTimes = ['ahora', '2 min', '5 min'] as const;

const pageTitle = 'Hasel - Software de citas, agenda y reservas online para tu negocio';
const metaDescription =
	'Organizá citas, equipo y clientes en un solo panel. Tus clientes reservan 24/7 con tu enlace personalizado. Probá Premium gratis 14 días.';

const usefulServices = [
	{
		icon: 'event_available',
		title: 'Citas automáticas',
		text: 'Tus clientes reservan 24/7. Recordatorios automáticos para reducir cancelaciones.',
		variant: 'featured',
		image: '/landing/salon.jpg',
		imageAlt: 'Recepción de salón con agenda digital',
	},
	{
		icon: 'show_chart',
		title: 'Métricas claras',
		text: 'Ingresos, ticket promedio y tendencias en números simples para decidir con datos.',
		variant: 'tint',
	},
	{
		icon: 'apartment',
		title: 'Equipo y sucursales',
		text: 'Disponibilidad en tiempo real, turnos y varias ubicaciones desde un solo panel.',
		variant: 'default',
	},
	{
		icon: 'desktop_windows',
		title: 'Página de reservas',
		text: 'Link propio con disponibilidad real. Tus clientes eligen horario sin llamarte.',
		variant: 'visual',
		image: '/landing/barber.jpg',
		imageAlt: 'Interior de barbería con espejo y sillón',
	},
] as const;

const steps = [
	{
		icon: 'tune',
		title: 'Configurá servicios y horarios',
		text: 'Definí tu catálogo, profesionales y disponibilidad en minutos.',
	},
	{
		icon: 'share',
		title: 'Compartí tu enlace',
		text: 'Pegalo en WhatsApp, Instagram o tu bio. Reservas sin ida y vuelta.',
	},
	{
		icon: 'calendar_month',
		title: 'Controlá desde el calendario',
		text: 'Todo se actualiza solo. Hasel envía recordatorios por vos.',
	},
];

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Hasel',
		url: siteOrigin,
		description: metaDescription,
		inLanguage: 'es',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'Hasel',
		applicationCategory: 'BusinessApplication',
		operatingSystem: 'Web',
		url: siteOrigin,
		description: metaDescription,
		offers: {
			'@type': 'Offer',
			price: '0',
			priceCurrency: 'PYG',
			description: 'Prueba Premium 14 días sin tarjeta',
		},
		featureList: [
			...usefulServices.map((service) => service.title),
			'Prueba Premium 14 días',
			...steps.map((step) => step.title),
		].join(', '),
	},
];
---

<Layout
	pageTitle={pageTitle}
	metaDescription={metaDescription}
	canonicalPath="/"
	ogImage="/icons/icon-512x512.png"
	jsonLd={jsonLd}
>
	<main class="landing-root">
		<a href="#hero-heading" class="landing-skip-link">Saltar al contenido principal</a>
		<div class="landing-scroll-sentinel" data-scroll-sentinel aria-hidden="true"></div>

		<PublicHaselTopbar variant="marketing" />

		<div class="landing-shell">
			<section class="m3-hero" aria-labelledby="hero-heading">
				<div class="m3-hero-content">
					<div class="m3-hero-titleblock" data-hero-reveal data-hero-reveal-delay="0">
						<h1 id="hero-heading" class="m3-display">
							<span>Dejá que</span>
							<span>tus clientes</span>
							<span>se agenden solos.</span>
						</h1>
					</div>
					<p class="m3-body-large" data-hero-reveal data-hero-reveal-delay="120">
						Calendario, equipo y link de reservas para WhatsApp. Todo en un solo panel.
					</p>

					<div class="hero-actions" data-hero-reveal data-hero-reveal-delay="180">
						<a href="/auth/register" class="m3-btn m3-btn-filled m3-btn-large no-underline">
							Empezar gratis
						</a>
						<a href="/explorar" class="m3-btn m3-btn-tonal m3-btn-large no-underline">
							Buscar negocios
						</a>
						<a href="#funciones" class="m3-btn m3-btn-text m3-btn-large no-underline">Ver funciones</a>
					</div>
				</div>

				<div class="hero-visual" data-hero-reveal data-hero-reveal-delay="220">
					<div class="hero-inbox" aria-hidden="true">
						<p class="hero-inbox__live">
							<span class="hero-inbox__dot"></span>
							Reservas entrando
						</p>

						<ol class="hero-inbox__stack" data-hero-inbox>
							{
								inboxVisible.map((note, index) => (
									<li class="hero-toast" data-kind={note.kind} style={`--i: ${index}`}>
										<span class="hero-toast__mark material-symbols-rounded">{inboxIcons[note.kind]}</span>
										<div class="hero-toast__copy">
											<strong>{note.title}</strong>
											<span>{note.detail}</span>
										</div>
										<time>{inboxTimes[index]}</time>
									</li>
								))
							}
						</ol>
						<script type="application/json" id="hero-inbox-notes" set:html={JSON.stringify({ notes: inboxNotes, icons: inboxIcons, times: inboxTimes })} />
					</div>
				</div>
			</section>

			{
				previewOrgs.length > 0 ? (
					<section id="negocios" class="m3-section discover-section" aria-labelledby="negocios-heading">
						<div class="discover-intro reveal-on-scroll">
							<h2 id="negocios-heading" class="m3-headline">
								Encontrá lo que necesitás
							</h2>
							<p class="m3-body discover-lead">
								Reservá en negocios que ya reciben turnos con Hasel.
							</p>
						</div>

						<div class="discover-toolbar reveal-on-scroll">
							{
								previewSpecialties.length > 0 ? (
									<nav class="discover-chips" aria-label="Rubros">
										<a href="/explorar" class="discover-chip is-active">
											Todos
										</a>
										{previewSpecialties.map((item) => (
											<a href={`/explorar?specialty=${encodeURIComponent(item.code)}`} class="discover-chip">
												{item.label}
											</a>
										))}
									</nav>
								) : null
							}
							<a href="/explorar" class="discover-all no-underline">
								<span class="discover-all__short">Ver todos</span>
								<span class="discover-all__full">Ver todos los lugares</span>
								<span class="material-symbols-rounded" aria-hidden="true">
									arrow_forward
								</span>
							</a>
						</div>

						<div class="discover-grid" aria-label="Negocios en Hasel">
							{previewOrgs.map((item, index) => {
								const hubPath = `/${encodeURIComponent(item.slug)}`;
								const bannerUrl = String(item.banner_url || '').trim();
								const meta = [item.specialty.label, item.city_name].filter(Boolean).join(' · ');
								return (
									<a
										href={hubPath}
										class="discover-card reveal-on-scroll no-underline"
										style={`--reveal-i: ${index}`}
									>
										<div class:list={['discover-card__cover', { 'has-banner': Boolean(bannerUrl) }]}>
											{bannerUrl ? (
												<img
													class="discover-card__photo"
													src={bannerUrl}
													alt=""
													width={640}
													height={400}
													loading="lazy"
													decoding="async"
												/>
											) : (
												<span class="discover-card__initial" aria-hidden="true">
													{orgInitial(item.name)}
												</span>
											)}
										</div>
										<div class="discover-card__body">
											<h3 class="discover-card__name">{item.name}</h3>
											{meta ? <p class="discover-card__meta">{meta}</p> : null}
											<span class="discover-card__cta">
												Ver negocio
												<span class="material-symbols-rounded" aria-hidden="true">
													arrow_forward
												</span>
											</span>
										</div>
									</a>
								);
							})}
						</div>
					</section>
				) : null
			}

			<section id="funciones" class="m3-section features-section" aria-labelledby="funciones-heading">
				<div class="features-intro reveal-on-scroll">
					<h2 id="funciones-heading" class="m3-headline">
						Todo lo que necesitás para operar y crecer
					</h2>
					<p class="m3-body features-lead">
						Desde la primera reserva hasta el seguimiento del cliente, sin planillas ni mensajes perdidos.
					</p>
				</div>

				<div class="features-bento" data-features-bento>
					{
						usefulServices.map((service, index) => (
							<article
								class:list={[
									'features-bento__cell',
									`features-bento__cell--${service.variant}`,
									'reveal-on-scroll',
								]}
								style={`--reveal-i: ${index}`}
							>
								{'image' in service && service.image ? (
									<img
										class="features-bento__photo"
										src={service.image}
										alt={service.imageAlt}
										width={800}
										height={600}
										loading="lazy"
										decoding="async"
									/>
								) : null}
								<div class="features-bento__content">
									<span class="features-bento__icon" aria-hidden="true">
										<span class="material-symbols-rounded">{service.icon}</span>
									</span>
									<h3 class="features-bento__title">{service.title}</h3>
									<p class="features-bento__text">{service.text}</p>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<section id="como-funciona" class="m3-section workflow-section" aria-labelledby="como-funciona-heading">
				<div class="workflow-intro reveal-on-scroll">
					<h2 id="como-funciona-heading" class="m3-headline">Cómo funciona Hasel</h2>
					<p class="m3-body workflow-lead">Tres pasos y ya estás recibiendo reservas.</p>
				</div>

				<ol class="workflow-rail">
					{
						steps.map((item) => (
							<li class="workflow-rail__step reveal-on-scroll">
								<span class="workflow-rail__icon material-symbols-rounded" aria-hidden="true">
									{item.icon}
								</span>
								<div class="workflow-rail__copy">
									<h3 class="m3-title">{item.title}</h3>
									<p class="m3-body">{item.text}</p>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<section id="opiniones" class="m3-section voices-section" aria-labelledby="voices-title">
				<div class="voices-intro reveal-on-scroll">
					<h2 id="voices-title" class="m3-headline">Lo que opinan de Hasel</h2>
					<p class="m3-body voices-lead">Profesionales y administradores califican la app con la que atienden.</p>
				</div>
				<div class="voices-board">
					<article class="voices-card voices-card--lead reveal-on-scroll">
						<div class="voices-stars" aria-label={`${featuredReview.stars} de 5`}>
							{starSlots.map((slot) => (
								<span
									class:list={['material-symbols-rounded', 'voices-star', { 'is-on': slot <= featuredReview.stars }]}
									aria-hidden="true"
								>
									star
								</span>
							))}
						</div>
						<blockquote class="voices-quote">
							<p>«{featuredReview.quote}»</p>
						</blockquote>
						<footer class="voices-who">
							<strong>{featuredReview.name}</strong>
							<span>{featuredReview.role}, {featuredReview.org}</span>
						</footer>
					</article>
					<div class="voices-stack">
						{moreReviews.map((review, index) => (
							<article class="voices-card reveal-on-scroll" style={`--reveal-i: ${index + 1}`}>
								<div class="voices-stars" aria-label={`${review.stars} de 5`}>
									{starSlots.map((slot) => (
										<span
											class:list={['material-symbols-rounded', 'voices-star', { 'is-on': slot <= review.stars }]}
											aria-hidden="true"
										>
											star
										</span>
									))}
								</div>
								<blockquote class="voices-quote">
									<p>«{review.quote}»</p>
								</blockquote>
								<footer class="voices-who">
									<strong>{review.name}</strong>
									<span>{review.role}, {review.org}</span>
								</footer>
							</article>
						))}
					</div>
				</div>
			</section>

			<section id="precios" class="m3-cta-split" aria-labelledby="cta-heading">
				<div class="cta-split__copy reveal-on-scroll">
					<h2 id="cta-heading" class="m3-headline">
						Probá <span class="cta-premium">Premium</span> 14 días, sin tarjeta
					</h2>
					<p class="m3-body-large">
						Creá tu espacio, configurá horarios y compartí tu página pública hoy mismo.
					</p>
				</div>
				<div class="cta-split__panel reveal-on-scroll">
					<ul class="cta-checklist">
						<li>
							<span class="material-symbols-rounded" aria-hidden="true">check_circle</span>
							Calendario compartido con tu equipo
						</li>
						<li>
							<span class="material-symbols-rounded" aria-hidden="true">check_circle</span>
							Página pública de reservas
						</li>
						<li>
							<span class="material-symbols-rounded" aria-hidden="true">check_circle</span>
							Recordatorios automáticos
						</li>
					</ul>
					<a href="/auth/register" class="m3-btn m3-btn-filled m3-btn-large no-underline cta-btn">
						Empezar gratis
						<span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span>
					</a>
				</div>
			</section>

			<footer id="soporte" class="m3-footer">
				<div class="m3-footer-brand">
					<p class="m3-footer-copy">© {new Date().getFullYear()} Hasel</p>
					<p class="m3-footer-tagline">Software de reservas</p>
				</div>
				<div class="m3-footer-links">
					<p class="m3-footer-support">
						<span>¿Necesitás ayuda? Escribinos al correo</span>
						<a href="mailto:support@hasel.app" class="m3-footer-link no-underline">support@hasel.app</a>
					</p>
					<nav class="m3-footer-nav" aria-label="Enlaces legales">
						<a href="/politicas-y-privacidad" class="m3-footer-link no-underline">
							Políticas y privacidad
						</a>
						<a href="/politicas-de-cancelacion-y-reembolso" class="m3-footer-link no-underline">
							Cancelación y reembolso
						</a>
					</nav>
				</div>
			</footer>
		</div>
	</main>
</Layout>

<script is:inline>
	(() => {
		if (typeof window === 'undefined') return;

		/** @type {AbortController | null} */
		let landingAbort = null;
		/** @type {ReturnType<typeof setTimeout>[]} */
		let landingTimeouts = [];

		const clearLandingTimeouts = () => {
			for (const id of landingTimeouts) window.clearTimeout(id);
			landingTimeouts = [];
		};

		const later = (fn, ms) => {
			const id = window.setTimeout(fn, ms);
			landingTimeouts.push(id);
			return id;
		};

		const initLandingPage = () => {
			const root = document.querySelector('.landing-root');
			if (!(root instanceof HTMLElement)) return;

			landingAbort?.abort();
			clearLandingTimeouts();
			landingAbort = new AbortController();
			const { signal } = landingAbort;

			const nav = document.querySelector('[data-public-hasel-topbar]');
			const sentinel = document.querySelector('[data-scroll-sentinel]');
			const getOffset = () => {
				const navHeight = nav instanceof HTMLElement ? nav.getBoundingClientRect().height : 0;
				return navHeight + 12;
			};

			if (nav instanceof HTMLElement && sentinel instanceof HTMLElement && 'IntersectionObserver' in window) {
				const topObserver = new IntersectionObserver(
					([entry]) => {
						if (!entry) return;
						nav.classList.toggle('is-scrolled', !entry.isIntersecting);
					},
					{ root: null, threshold: 0, rootMargin: '-1px 0px 0px 0px' }
				);
				topObserver.observe(sentinel);
				signal.addEventListener('abort', () => topObserver.disconnect());
			}

			const scrollToHash = (hash, behavior = 'smooth') => {
				if (!hash || !hash.startsWith('#')) return;
				const id = decodeURIComponent(hash.slice(1));
				if (!id) return;
				const target = document.getElementById(id);
				if (!target) return;

				const top = target.getBoundingClientRect().top + window.scrollY - getOffset();
				window.scrollTo({ top: Math.max(0, top), behavior });
			};

			root.querySelectorAll('a[href^="#"]').forEach((anchor) => {
				anchor.addEventListener(
					'click',
					(event) => {
						const href = anchor.getAttribute('href');
						if (!href) return;
						event.preventDefault();
						history.pushState(null, '', href);
						scrollToHash(href, 'smooth');
					},
					{ signal }
				);
			});

			if (window.location.hash) {
				requestAnimationFrame(() => scrollToHash(window.location.hash, 'auto'));
			}

			const heroRevealNodes = Array.from(root.querySelectorAll('[data-hero-reveal]')).filter(
				(node) => node instanceof HTMLElement
			);
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			const clearHeroReveal = () => {
				heroRevealNodes.forEach((node) => {
					node.classList.remove('is-in');
					node.style.animation = 'none';
				});
			};

			const runHeroReveal = () => {
				if (!heroRevealNodes.length) return;

				if (prefersReducedMotion) {
					heroRevealNodes.forEach((node) => {
						node.style.animation = '';
						node.classList.add('is-in');
					});
					return;
				}

				clearHeroReveal();
				void document.body.offsetWidth;

				window.requestAnimationFrame(() => {
					window.requestAnimationFrame(() => {
						heroRevealNodes.forEach((node) => {
							node.style.animation = '';
							const delay = Number(node.getAttribute('data-hero-reveal-delay') || 0);
							const safeDelay = Number.isFinite(delay) ? Math.max(0, delay) : 0;
							later(() => node.classList.add('is-in'), safeDelay + 40);
						});
					});
				});
			};

			const prepareHeroFonts = async () => {
				if (!document.fonts?.load) return;
				try {
					await Promise.race([
						Promise.all([
							document.fonts.load('800 3.5rem "Plus Jakarta Sans"'),
							document.fonts.load('400 1.125rem "Plus Jakarta Sans"'),
							document.fonts.load('700 1rem "Plus Jakarta Sans"'),
						]),
						new Promise((resolve) => window.setTimeout(resolve, 300)),
					]);
				} catch {
					/* ignore */
				}
			};

			if (heroRevealNodes.length) {
				void prepareHeroFonts().then(runHeroReveal);
			}

			const inboxStack = root.querySelector('[data-hero-inbox]');
			const inboxSource = document.getElementById('hero-inbox-notes');
			if (inboxStack instanceof HTMLElement && inboxSource && !prefersReducedMotion) {
				/** @type {{ notes?: Array<{ kind: string, title: string, detail: string }>, icons?: Record<string, string>, times?: string[] }} */
				let inboxData = {};
				try {
					inboxData = JSON.parse(inboxSource.textContent || '{}');
				} catch {
					inboxData = {};
				}

				const notes = Array.isArray(inboxData.notes) ? inboxData.notes : [];
				const icons = inboxData.icons && typeof inboxData.icons === 'object' ? inboxData.icons : {};
				const times = Array.isArray(inboxData.times) ? inboxData.times : ['ahora', '2 min', '5 min'];
				const slots = Array.from(inboxStack.querySelectorAll('.hero-toast'));

				if (notes.length > slots.length && slots.length > 0) {
					let cursor = slots.length;
					const used = new Set(notes.slice(0, slots.length).map((note) => `${note.kind}|${note.detail}`));

					const paintSlot = (slot, note, index, entering) => {
						slot.dataset.kind = note.kind;
						const mark = slot.querySelector('.hero-toast__mark');
						const title = slot.querySelector('strong');
						const detail = slot.querySelector('.hero-toast__copy span');
						const time = slot.querySelector('time');
						if (mark) mark.textContent = icons[note.kind] || 'chat';
						if (title) title.textContent = note.title;
						if (detail) detail.textContent = note.detail;
						if (time) time.textContent = times[index] || '';
						slot.classList.toggle('is-enter', Boolean(entering));
					};

					const nextNote = () => {
						const topKind = slots[0]?.dataset.kind;
						let fallback = notes[cursor % notes.length];
						for (let step = 0; step < notes.length; step += 1) {
							const note = notes[cursor % notes.length];
							cursor += 1;
							const key = `${note.kind}|${note.detail}`;
							if (used.has(key)) continue;
							if (!fallback) fallback = note;
							if (note.kind === topKind) continue;
							return note;
						}
						return fallback;
					};

					const rotateInbox = () => {
						if (document.hidden) return;
						const incoming = nextNote();
						if (!incoming) return;

						const current = slots.map((slot) => ({
							kind: slot.dataset.kind || 'book',
							title: slot.querySelector('strong')?.textContent || '',
							detail: slot.querySelector('.hero-toast__copy span')?.textContent || '',
						}));
						const nextVisible = [incoming, ...current.slice(0, slots.length - 1)];
						used.clear();
						nextVisible.forEach((note) => used.add(`${note.kind}|${note.detail}`));

						slots.forEach((slot, index) => {
							slot.classList.remove('is-enter');
							if (index === 0) void slot.offsetWidth;
							paintSlot(slot, nextVisible[index], index, index === 0);
						});
					};

					const inboxTimer = window.setInterval(rotateInbox, 4800);
					signal.addEventListener('abort', () => window.clearInterval(inboxTimer));
				}
			}

			const revealNodes = root.querySelectorAll('.reveal-on-scroll');
			if (revealNodes.length && 'IntersectionObserver' in window) {
				const revealObserver = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add('is-visible');
							revealObserver.unobserve(entry.target);
						}
					},
					{ rootMargin: '0px 0px -10% 0px', threshold: 0.15 }
				);
				revealNodes.forEach((node) => revealObserver.observe(node));
				signal.addEventListener('abort', () => revealObserver.disconnect());
			} else {
				revealNodes.forEach((node) => node.classList.add('is-visible'));
			}

		};

		if (!window.__haselLandingPageBound) {
			window.__haselLandingPageBound = true;
			document.addEventListener('astro:page-load', initLandingPage);
		}
		initLandingPage();
	})();
</script>

