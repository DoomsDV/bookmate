---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
const siteOrigin = String(Astro.site ?? Astro.url.origin).replace(/\/+$/, '');
const pageTitle = 'Hasel — Software de citas, agenda y reservas online para tu negocio';
const metaDescription =
	'Organizá citas, equipo y clientes en un solo panel. Tus clientes reservan 24/7 con tu enlace personalizado. Probá Premium gratis 14 días.';

const usefulServices = [
	{
		icon: 'event_available',
		title: 'Automatización Inteligente de Citas',
		text: 'Tus clientes reservan 24/7. Recordatorios automáticos para reducir cancelaciones. Pagos integrados.',
	},
	{
		icon: 'show_chart',
		title: 'Inteligencia de Negocio y Rentabilidad',
		text: 'Mirá ingresos, ticket promedio y tendencias en métricas simples. Con datos claros, tomás decisiones informadas al instante.',
	},
	{
		icon: 'apartment',
		title: 'Gestión de Equipo y Múltiples Ubicaciones',
		text: 'Monitorizá disponibilidad en tiempo real. Asigná turnos y gestioná todas tus sucursales desde un solo lugar.',
	},
	{
		icon: 'notifications_active',
		title: 'Alertas Proactivas y Sugerencias',
		text: 'Notificaciones sobre nuevas citas, modificaciones o cancelaciones. Sugerencias de marketing basadas en IA para potenciar tus servicios.',
	},
	{
		icon: 'desktop_windows',
		title: 'Tu Propia Página de Reservas',
		text: 'Proyectá una imagen profesional con un sitio de reservas autogestionable. Tus clientes ven la disponibilidad real y eligen el horario al instante.',
	},
	{
		icon: 'folder_shared',
		title: 'Historial y Fichas de Clientes Centralizadas',
		text: 'Registrá cada cliente, su historial de citas, servicios y notas privadas para una atención personalizada en cada visita.',
	},
] as const;

const steps = [
	{
		step: '1',
		title: 'Configurá en minutos',
		text: 'Definí tus servicios, horarios y profesionales en un panel intuitivo. Tu negocio listo para operar al instante.',
	},
	{
		step: '2',
		title: 'Compartí tu enlace',
		text: 'Pegá tu enlace en WhatsApp, Instagram o tu bio. Tus clientes ven tu disponibilidad real y agendan solos 24/7.',
	},
	{
		step: '3',
		title: 'Todo bajo control',
		text: 'El calendario se actualiza solo. Recibí alertas al instante y dejá que Hasel envíe los recordatorios automáticos por vos.',
	},
];

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Hasel',
		url: siteOrigin,
		description: metaDescription,
		inLanguage: 'es',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'Hasel',
		applicationCategory: 'BusinessApplication',
		operatingSystem: 'Web',
		url: siteOrigin,
		description: metaDescription,
		offers: {
			'@type': 'Offer',
			price: '0',
			priceCurrency: 'PYG',
			description: 'Prueba Premium 14 días sin tarjeta',
		},
		featureList: [
			...usefulServices.map((service) => service.title),
			'Prueba Premium 14 días',
			...steps.map((step) => step.title),
		].join(', '),
	},
];
---

<Layout
	pageTitle={pageTitle}
	metaDescription={metaDescription}
	canonicalPath="/"
	ogImage="/icons/icon-512x512.png"
	jsonLd={jsonLd}
>
	<main class="landing-root">
		<div class="landing-fx" aria-hidden="true">
			<div class="landing-atmosphere"></div>
			<div class="landing-orb landing-orb-a"></div>
			<div class="landing-orb landing-orb-c"></div>
		</div>

		<header class="landing-topbar" data-landing-topbar>
			<div class="landing-topbar-inner">
				<a href="/" class="brand no-underline" aria-label="Hasel — Inicio">
					<img
						src="/icons/icon-64.png"
						alt=""
						class="brand-logo"
						width="64"
						height="64"
						loading="eager"
						decoding="async"
					/>
					<span class="brand-text">Hasel</span>
				</a>

				<nav class="landing-topbar-links" aria-label="Secciones">
					<a href="#funciones" class="landing-topbar-link no-underline">Funciones</a>
					<a href="#como-funciona" class="landing-topbar-link no-underline">Cómo funciona</a>
					<a href="#precios" class="landing-topbar-link no-underline">Precios</a>
					<a href="#soporte" class="landing-topbar-link no-underline">Soporte</a>
				</nav>

				<div class="nav-actions">
					<a href="/auth/login" class="m3-btn m3-btn-text m3-btn-nav no-underline">Iniciar sesión</a>
					<a href="/auth/register" class="m3-btn m3-btn-filled m3-btn-nav no-underline">Empezar gratis</a>
				</div>
			</div>
		</header>

		<div class="landing-shell">
			<section class="m3-hero" aria-labelledby="hero-heading">
				<div class="m3-hero-content">
					<p class="m3-chip m3-chip-primary">
						<span class="material-symbols-rounded" aria-hidden="true">workspace_premium</span>
						<span>14 días Premium de prueba</span>
					</p>
					<h1 id="hero-heading" class="m3-display" data-hero-reveal data-hero-reveal-delay="0">
						Tu calendario, equipo y reservas públicas en una sola plataforma
					</h1>
					<p class="m3-body-large" data-hero-reveal data-hero-reveal-delay="160">
						Tus clientes reservan 24/7; vos gestionás el día desde un solo lugar.
					</p>

					<div class="hero-actions">
						<a href="/auth/register" class="m3-btn m3-btn-filled m3-btn-large no-underline">
							Empezar gratis
						</a>
						<a href="#funciones" class="m3-btn m3-btn-tonal m3-btn-large no-underline">Ver funciones</a>
					</div>
				</div>

				<div class="hero-monitor" data-hero-reveal data-hero-reveal-delay="220">
					<div class="hero-monitor__bezel">
						<div class="hero-monitor__screen">
							<div
								class="hero-calendar-split"
								data-calendar-compare
								style="--split: 50%; --skew: 14%"
								aria-label="Compará el calendario en modo claro y oscuro. Deslizá para revelar."
							>
								<div class="hero-calendar-split__pane hero-calendar-split__pane--light">
									<picture>
										<source type="image/avif" srcset="/calendar/desktop/calendario-light.avif" />
										<source type="image/webp" srcset="/calendar/desktop/calendario-light.webp" />
										<img
											src="/calendar/desktop/calendario-light.png"
											alt="Calendario Hasel en modo claro"
											width="1883"
											height="957"
											loading="eager"
											decoding="async"
											draggable="false"
										/>
									</picture>
								</div>
								<div class="hero-calendar-split__pane hero-calendar-split__pane--dark">
									<picture>
										<source type="image/avif" srcset="/calendar/desktop/calendario-dark.avif" />
										<source type="image/webp" srcset="/calendar/desktop/calendario-dark.webp" />
										<img
											src="/calendar/desktop/calendario-dark.png"
											alt="Calendario Hasel en modo oscuro"
											width="1879"
											height="961"
											loading="eager"
											decoding="async"
											draggable="false"
										/>
									</picture>
								</div>
								<div
									class="hero-calendar-split__handle"
									data-calendar-handle
									role="slider"
									tabindex="0"
									aria-orientation="horizontal"
									aria-valuemin="0"
									aria-valuemax="100"
									aria-valuenow="50"
									aria-label="Deslizá para comparar modo claro y oscuro"
								>
									<span class="hero-calendar-split__handle-line" aria-hidden="true"></span>
									<span class="hero-calendar-split__handle-knob material-symbols-rounded" aria-hidden="true"
										>code</span
									>
								</div>
								<span class="hero-calendar-split__label hero-calendar-split__label--light">Light</span>
								<span class="hero-calendar-split__label hero-calendar-split__label--dark">Dark</span>
							</div>
						</div>
					</div>
					<div class="hero-monitor__stand" aria-hidden="true">
						<span class="hero-monitor__neck"></span>
						<span class="hero-monitor__base"></span>
					</div>
				</div>

				<div class="hero-phone" data-hero-reveal data-hero-reveal-delay="220">
					<div class="hero-phone__bezel">
						<span class="hero-phone__island" aria-hidden="true"></span>
						<div class="hero-phone__screen">
							<div
								class="hero-calendar-split hero-calendar-split--mobile"
								data-calendar-compare
								style="--split: 50%; --skew: 12%"
								aria-label="Compará el calendario móvil en modo claro y oscuro. Deslizá para revelar."
							>
								<div class="hero-calendar-split__pane hero-calendar-split__pane--light">
									<picture>
										<source type="image/avif" srcset="/calendar/mobile/calendario-light.avif" />
										<source type="image/webp" srcset="/calendar/mobile/calendario-light.webp" />
										<img
											src="/calendar/mobile/calendario-light.png"
											alt="Calendario Hasel móvil en modo claro"
											width="780"
											height="1691"
											loading="eager"
											decoding="async"
											draggable="false"
										/>
									</picture>
								</div>
								<div class="hero-calendar-split__pane hero-calendar-split__pane--dark">
									<picture>
										<source type="image/avif" srcset="/calendar/mobile/calendario-dark.avif" />
										<source type="image/webp" srcset="/calendar/mobile/calendario-dark.webp" />
										<img
											src="/calendar/mobile/calendario-dark.png"
											alt="Calendario Hasel móvil en modo oscuro"
											width="780"
											height="1691"
											loading="eager"
											decoding="async"
											draggable="false"
										/>
									</picture>
								</div>
								<div
									class="hero-calendar-split__handle"
									data-calendar-handle
									role="slider"
									tabindex="0"
									aria-orientation="horizontal"
									aria-valuemin="0"
									aria-valuemax="100"
									aria-valuenow="50"
									aria-label="Deslizá para comparar modo claro y oscuro"
								>
									<span class="hero-calendar-split__handle-line" aria-hidden="true"></span>
									<span class="hero-calendar-split__handle-knob material-symbols-rounded" aria-hidden="true"
										>code</span
									>
								</div>
								<span class="hero-calendar-split__label hero-calendar-split__label--light">Light</span>
								<span class="hero-calendar-split__label hero-calendar-split__label--dark">Dark</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section id="funciones" class="m3-section features-section" aria-labelledby="funciones-heading">
				<div class="features-intro">
					<h2 id="funciones-heading" class="m3-headline features-heading reveal-on-scroll">
						<span class="features-heading-lead">Todo lo que necesitás</span>
						<span class="features-heading-muted">para operar y crecer</span>
					</h2>
				</div>

				<div class="features-carousel" data-features-carousel>
					<div
						class="features-panel"
						data-features-panel
						tabindex="0"
						role="region"
						aria-roledescription="carrusel"
						aria-label="Funciones de Hasel"
					>
						{
							usefulServices.map((service) => (
								<article class="features-card" data-feature-card>
									<span class="features-card-icon" aria-hidden="true">
										<span class="material-symbols-rounded">{service.icon}</span>
									</span>
									<h3 class="features-card-title">{service.title}</h3>
									<p class="features-card-text">{service.text}</p>
								</article>
							))
						}
					</div>
					<div class="features-dots" data-features-dots role="tablist" aria-label="Páginas del carrusel">
						{
							usefulServices.map((_, index) => (
								<button
									type="button"
									class:list={['features-dot', index === 0 && 'is-active']}
									data-features-dot
									aria-label={`Ir a la función ${index + 1}`}
									aria-current={index === 0 ? 'true' : undefined}
								/>
							))
						}
					</div>
				</div>
			</section>

			<section id="como-funciona" class="m3-section m3-section-tonal" aria-labelledby="como-funciona-heading">
				<div class="workflow-intro reveal-on-scroll">
					<p class="m3-chip m3-chip-secondary">
						<span class="material-symbols-rounded" aria-hidden="true">bolt</span>
						<span>Listo para usar</span>
					</p>
					<h2 id="como-funciona-heading" class="m3-headline">Cómo funciona Hasel</h2>
				</div>

				<ol class="workflow-steps">
					{
						steps.map((item, index) => (
							<li class="workflow-step reveal-on-scroll">
								<div class="workflow-step-copy">
									<span class="workflow-step-num" aria-hidden="true">
										{item.step}
									</span>
									<h3 class="m3-title">{item.title}</h3>
									<p class="m3-body">{item.text}</p>
								</div>
								{index < steps.length - 1 ? (
									<span class="workflow-step-arrow material-symbols-rounded" aria-hidden="true">
										arrow_forward
									</span>
								) : null}
							</li>
						))
					}
				</ol>
			</section>

			<section id="precios" class="m3-cta-card" aria-labelledby="cta-heading">
				<div class="cta-content">
					<h2 id="cta-heading" class="m3-headline">
						Empezá con 14&nbsp;días de <span class="cta-premium">Premium</span>
					</h2>
					<p class="m3-body-large">
						Creá tu espacio, configurá horarios y compartí tu página pública. Tus clientes reservan; vos
						controlás todo desde el calendario.
					</p>
					<a href="/auth/register" class="m3-btn m3-btn-filled m3-btn-large no-underline cta-btn">
						Crear mi espacio gratis
						<span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span>
					</a>
				</div>
			</section>

			<footer id="soporte" class="m3-footer">
				<div class="m3-footer-brand">
					<p class="m3-footer-copy">© {new Date().getFullYear()} Hasel</p>
					<p class="m3-footer-tagline">Software de reservas</p>
				</div>
				<div class="m3-footer-links">
					<p class="m3-footer-support">
						<span>¿Necesitás ayuda? Escribinos al correo</span>
						<a href="mailto:support@hasel.app" class="m3-footer-link no-underline">support@hasel.app</a>
					</p>
					<nav class="m3-footer-nav" aria-label="Enlaces legales">
						<a href="/politicas-y-privacidad" class="m3-footer-link no-underline">
							Políticas y privacidad
						</a>
						<a href="/politicas-de-cancelacion-y-reembolso" class="m3-footer-link no-underline">
							Cancelación y reembolso
						</a>
					</nav>
				</div>
			</footer>
		</div>
	</main>
</Layout>

<script is:inline>
	(() => {
		if (typeof window === 'undefined') return;

		/** @type {AbortController | null} */
		let landingAbort = null;
		/** @type {ReturnType<typeof setTimeout>[]} */
		let landingTimeouts = [];

		const clearLandingTimeouts = () => {
			for (const id of landingTimeouts) window.clearTimeout(id);
			landingTimeouts = [];
		};

		const later = (fn, ms) => {
			const id = window.setTimeout(fn, ms);
			landingTimeouts.push(id);
			return id;
		};

		const initLandingPage = () => {
			const root = document.querySelector('.landing-root');
			if (!(root instanceof HTMLElement)) return;

			landingAbort?.abort();
			clearLandingTimeouts();
			landingAbort = new AbortController();
			const { signal } = landingAbort;

			const nav = document.querySelector('[data-landing-topbar]');
			const getOffset = () => {
				const navHeight = nav instanceof HTMLElement ? nav.getBoundingClientRect().height : 0;
				return navHeight + 12;
			};

			const syncTopbar = () => {
				if (!(nav instanceof HTMLElement)) return;
				nav.classList.toggle('is-scrolled', window.scrollY > 12);
			};
			syncTopbar();
			window.addEventListener('scroll', syncTopbar, { passive: true, signal });

			const scrollToHash = (hash, behavior = 'smooth') => {
				if (!hash || !hash.startsWith('#')) return;
				const id = decodeURIComponent(hash.slice(1));
				if (!id) return;
				const target = document.getElementById(id);
				if (!target) return;

				const top = target.getBoundingClientRect().top + window.scrollY - getOffset();
				window.scrollTo({ top: Math.max(0, top), behavior });
			};

			root.querySelectorAll('a[href^="#"]').forEach((anchor) => {
				anchor.addEventListener(
					'click',
					(event) => {
						const href = anchor.getAttribute('href');
						if (!href) return;
						event.preventDefault();
						history.pushState(null, '', href);
						scrollToHash(href, 'smooth');
					},
					{ signal }
				);
			});

			if (window.location.hash) {
				requestAnimationFrame(() => scrollToHash(window.location.hash, 'auto'));
			}

			const heroRevealNodes = Array.from(root.querySelectorAll('[data-hero-reveal]')).filter(
				(node) => node instanceof HTMLElement
			);
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			const clearHeroReveal = () => {
				heroRevealNodes.forEach((node) => {
					node.classList.remove('is-in');
					node.style.animation = 'none';
				});
			};

			const runHeroReveal = () => {
				if (!heroRevealNodes.length) return;

				if (prefersReducedMotion) {
					heroRevealNodes.forEach((node) => {
						node.style.animation = '';
						node.classList.add('is-in');
					});
					return;
				}

				clearHeroReveal();
				void document.body.offsetWidth;

				window.requestAnimationFrame(() => {
					window.requestAnimationFrame(() => {
						heroRevealNodes.forEach((node) => {
							node.style.animation = '';
							const delay = Number(node.getAttribute('data-hero-reveal-delay') || 0);
							const safeDelay = Number.isFinite(delay) ? Math.max(0, delay) : 0;
							later(() => node.classList.add('is-in'), safeDelay + 40);
						});
					});
				});
			};

			const prepareHeroFonts = async () => {
				if (!document.fonts?.load) return;
				try {
					await Promise.race([
						Promise.all([
							document.fonts.load('800 3.5rem "Nunito Sans"'),
							document.fonts.load('400 1.125rem "Nunito Sans"'),
							document.fonts.load('700 1rem "Nunito Sans"'),
						]),
						new Promise((resolve) => window.setTimeout(resolve, 300)),
					]);
				} catch {
					/* ignore */
				}
			};

			if (heroRevealNodes.length) {
				void prepareHeroFonts().then(runHeroReveal);
			}

			const revealNodes = root.querySelectorAll('.reveal-on-scroll');
			if (revealNodes.length && 'IntersectionObserver' in window) {
				const revealObserver = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add('is-visible');
							revealObserver.unobserve(entry.target);
						}
					},
					{ rootMargin: '0px 0px -12% 0px', threshold: 0.18 }
				);
				revealNodes.forEach((node) => revealObserver.observe(node));
				signal.addEventListener('abort', () => revealObserver.disconnect());
			} else {
				revealNodes.forEach((node) => node.classList.add('is-visible'));
			}

			const featuresPanel = root.querySelector('[data-features-panel]');
			const featureCards = Array.from(root.querySelectorAll('[data-feature-card]')).filter(
				(node) => node instanceof HTMLElement
			);

			const playFeatureCards = () => {
				featureCards.forEach((card) => {
					card.classList.remove('is-in');
					card.style.animation = 'none';
				});
				void (featuresPanel instanceof HTMLElement ? featuresPanel.offsetWidth : 0);

				const stepMs = prefersReducedMotion ? 90 : 420;
				featureCards.forEach((card, index) => {
					later(() => {
						card.style.animation = '';
						card.classList.add('is-in');
					}, 40 + index * stepMs);
				});
			};

			if (featuresPanel instanceof HTMLElement && featureCards.length) {
				if ('IntersectionObserver' in window) {
					const featuresObserver = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (!entry.isIntersecting) continue;
								playFeatureCards();
								featuresObserver.disconnect();
								break;
							}
						},
						{ rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
					);
					featuresObserver.observe(featuresPanel);
					signal.addEventListener('abort', () => featuresObserver.disconnect());

					/* Si al volver con View Transitions el panel ya está a la vista, forzar entrada. */
					const rect = featuresPanel.getBoundingClientRect();
					const visible =
						rect.top < window.innerHeight * 0.92 && rect.bottom > window.innerHeight * 0.08;
					if (visible) {
						later(playFeatureCards, 80);
						featuresObserver.disconnect();
					}
				} else {
					playFeatureCards();
				}

				const dots = Array.from(root.querySelectorAll('[data-features-dot]')).filter(
					(node) => node instanceof HTMLButtonElement
				);

				const setActiveDot = (index) => {
					dots.forEach((dot, i) => {
						const active = i === index;
						dot.classList.toggle('is-active', active);
						if (active) dot.setAttribute('aria-current', 'true');
						else dot.removeAttribute('aria-current');
					});
				};

				const syncDotsFromScroll = () => {
					if (window.matchMedia('(min-width: 700px)').matches) return;
					const cardWidth = featureCards[0]?.getBoundingClientRect().width || 1;
					const gap =
						Number.parseFloat(
							getComputedStyle(featuresPanel).columnGap || getComputedStyle(featuresPanel).gap
						) || 0;
					const index = Math.round(featuresPanel.scrollLeft / (cardWidth + gap));
					setActiveDot(Math.min(featureCards.length - 1, Math.max(0, index)));
				};

				let scrollRaf = 0;
				featuresPanel.addEventListener(
					'scroll',
					() => {
						cancelAnimationFrame(scrollRaf);
						scrollRaf = requestAnimationFrame(syncDotsFromScroll);
					},
					{ passive: true, signal }
				);

				dots.forEach((dot, index) => {
					dot.addEventListener(
						'click',
						() => {
							const card = featureCards[index];
							if (!(card instanceof HTMLElement)) return;
							card.scrollIntoView({
								behavior: prefersReducedMotion ? 'auto' : 'smooth',
								inline: 'start',
								block: 'nearest',
							});
							setActiveDot(index);
						},
						{ signal }
					);
				});
			}

			root.querySelectorAll('[data-calendar-compare]').forEach((compareRoot) => {
				if (!(compareRoot instanceof HTMLElement)) return;
				const handle = compareRoot.querySelector('[data-calendar-handle]');
				const skewRaw = getComputedStyle(compareRoot).getPropertyValue('--skew').trim();
				const SKEW = Number.parseFloat(skewRaw) || 14;
				let split = 50;
				let dragging = false;

				const setSplit = (pct) => {
					split = Math.min(100, Math.max(0, pct));
					const splitTop = (split / 100) * (100 + SKEW);
					compareRoot.style.setProperty('--split', `${splitTop}%`);
					if (handle instanceof HTMLElement) {
						handle.setAttribute('aria-valuenow', String(Math.round(split)));
					}
				};

				const updateFromClientX = (clientX) => {
					const rect = compareRoot.getBoundingClientRect();
					if (rect.width <= 0) return;
					const pct = ((clientX - rect.left) / rect.width) * 100;
					setSplit(pct);
				};

				compareRoot.addEventListener(
					'pointerdown',
					(event) => {
						if (!(event instanceof PointerEvent)) return;
						dragging = true;
						compareRoot.classList.add('is-dragging');
						compareRoot.setPointerCapture?.(event.pointerId);
						updateFromClientX(event.clientX);
						event.preventDefault();
					},
					{ signal }
				);
				compareRoot.addEventListener(
					'pointermove',
					(event) => {
						if (!dragging || !(event instanceof PointerEvent)) return;
						updateFromClientX(event.clientX);
					},
					{ signal }
				);
				const onPointerUp = (event) => {
					if (!dragging || !(event instanceof PointerEvent)) return;
					dragging = false;
					compareRoot.classList.remove('is-dragging');
					try {
						compareRoot.releasePointerCapture?.(event.pointerId);
					} catch {
						/* ignore */
					}
				};
				compareRoot.addEventListener('pointerup', onPointerUp, { signal });
				compareRoot.addEventListener('pointercancel', onPointerUp, { signal });
				compareRoot.addEventListener(
					'lostpointercapture',
					() => {
						dragging = false;
						compareRoot.classList.remove('is-dragging');
					},
					{ signal }
				);

				if (handle instanceof HTMLElement) {
					handle.addEventListener(
						'keydown',
						(event) => {
							if (!(event instanceof KeyboardEvent)) return;
							const step = event.shiftKey ? 10 : 3;
							if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') {
								event.preventDefault();
								setSplit(split - step);
							} else if (event.key === 'ArrowRight' || event.key === 'ArrowUp') {
								event.preventDefault();
								setSplit(split + step);
							} else if (event.key === 'Home') {
								event.preventDefault();
								setSplit(0);
							} else if (event.key === 'End') {
								event.preventDefault();
								setSplit(100);
							}
						},
						{ signal }
					);
				}

				setSplit(50);
			});
		};

		if (!window.__haselLandingPageBound) {
			window.__haselLandingPageBound = true;
			document.addEventListener('astro:page-load', initLandingPage);
		}
		/* Al volver con ClientRouter el script se reinyecta: reiniciar animaciones ya. */
		initLandingPage();
	})();
</script>

