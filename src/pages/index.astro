		border-radius: 1.85rem;
		background:
			linear-gradient(160deg, #3a3d46 0%, #1c1e24 42%, #12141a 100%);
		border: 1px solid rgba(255, 255, 255, 0.1);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.08) inset,
			0 18px 40px rgba(0, 0, 0, 0.45),
			0 4px 12px rgba(0, 0, 0, 0.3);
	}

	.hero-phone__island {
		position: absolute;
		z-index: 6;
		top: 0.72rem;
		left: 50%;
		transform: translateX(-50%);
		width: 28%;
		height: 0.72rem;
		border-radius: 999px;
		background: #050608;
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.04);
		pointer-events: none;
	}

	.hero-phone__screen {
		position: relative;
		border-radius: 1.45rem;
		overflow: hidden;
		background: #050608;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.55) inset;
	}

	.hero-monitor__bezel {
		width: 100%;
		padding: 0.55rem;
		border-radius: 1.15rem;
		background:
			linear-gradient(160deg, #3a3d46 0%, #1c1e24 42%, #12141a 100%);
		border: 1px solid rgba(255, 255, 255, 0.1);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.08) inset,
			0 18px 40px rgba(0, 0, 0, 0.45),
			0 4px 12px rgba(0, 0, 0, 0.3);
	}

	.hero-monitor__screen {
		position: relative;
		border-radius: 0.65rem;
		overflow: hidden;
		background: #050608;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.55) inset;
	}

	.hero-monitor__stand {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		margin-top: -1px;
		pointer-events: none;
	}

	.hero-monitor__neck {
		display: block;
		width: 18%;
		max-width: 4.5rem;
		min-width: 2.4rem;
		height: 1.15rem;
		background: linear-gradient(90deg, #1a1c22, #2c3038 50%, #1a1c22);
		border-radius: 0 0 0.2rem 0.2rem;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
	}

	.hero-monitor__base {
		display: block;
		width: 42%;
		max-width: 11rem;
		min-width: 6.5rem;
		height: 0.55rem;
		margin-top: -1px;
		border-radius: 999px 999px 40% 40%;
		background: linear-gradient(180deg, #2e323b 0%, #15171c 100%);
		border: 1px solid rgba(255, 255, 255, 0.06);
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.4);
	}

	.hero-calendar-split {
		--split: 50%;
		--skew: 14%;
		/* Ángulo aproximado para aspect-ratio ~16/10 con skew 14% */
		--split-angle: 12.5deg;
		position: relative;
		isolation: isolate;
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 0;
		border: none;
		background: var(--md-sys-color-surface-container);
		box-shadow: none;
		touch-action: none;
		cursor: ew-resize;
		user-select: none;
		-webkit-user-select: none;
	}

	.hero-calendar-split--mobile {
		--skew: 12%;
		--split-angle: 10deg;
		aspect-ratio: 780 / 1691;
	}

	.hero-calendar-split--mobile .hero-calendar-split__handle-knob {
		width: 2rem;
		height: 2rem;
		font-size: 1rem;
		transform: rotate(-10deg);
	}

	.hero-calendar-split--mobile .hero-calendar-split__label {
		font-size: 0.6rem;
		padding: 0.22rem 0.5rem;
	}

	.hero-calendar-split.is-dragging {
		cursor: grabbing;
	}

	.hero-calendar-split__pane {
		position: absolute;
		inset: 0;
	}

	.hero-calendar-split__pane picture {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-calendar-split__pane img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: left top;
		user-select: none;
		pointer-events: none;
		-webkit-user-drag: none;
	}

	.hero-calendar-split__pane--light {
		z-index: 1;
		/* Solape ligero con dark para evitar franja blanca por antialiasing */
		clip-path: polygon(
			0 0,
			calc(var(--split) + 0.65%) 0,
			calc(var(--split) - var(--skew) + 0.65%) 100%,
			0 100%
		);
	}

	.hero-calendar-split__pane--dark {
		z-index: 2;
		/* Diagonal: tope en --split, base en --split - --skew. Derecha = dark. */
		clip-path: polygon(
			calc(var(--split) - 0.65%) 0,
			100% 0,
			100% 100%,
			calc(var(--split) - var(--skew) - 0.65%) 100%
		);
	}

	.hero-calendar-split__handle {
		position: absolute;
		z-index: 5;
		top: 0;
		bottom: 0;
		left: calc(var(--split) - (var(--skew) * 0.5));
		width: 44px;
		transform: translateX(-50%) rotate(var(--split-angle));
		display: grid;
		place-items: center;
		touch-action: none;
		cursor: ew-resize;
		outline: none;
	}

	.hero-calendar-split__handle-line {
		display: none;
	}

	.hero-calendar-split__handle-knob {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 2.35rem;
		height: 2.35rem;
		border-radius: var(--md-sys-shape-corner-full);
		background: #ffffff;
		color: #1c1c1e;
		font-size: 1.15rem;
		/* Compensa la rotación del handle para que el ícono quede derecho */
		transform: rotate(-12.5deg);
		box-shadow:
			0 4px 14px rgba(0, 0, 0, 0.35),
			0 0 0 1px rgba(0, 0, 0, 0.08);
		pointer-events: none;
	}

	.hero-calendar-split__handle:focus-visible .hero-calendar-split__handle-knob {
		outline: 2px solid var(--md-brand-filled);
		outline-offset: 3px;
	}

	.hero-calendar-split__label {
		position: absolute;
		z-index: 4;
		padding: 0.28rem 0.65rem;
		border-radius: var(--md-sys-shape-corner-full);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		pointer-events: none;
	}

	.hero-calendar-split__label--light {
		top: 0.75rem;
		left: 0.75rem;
		background: rgba(255, 255, 255, 0.88);
		color: #1a1a1a;
		border: 1px solid rgba(0, 0, 0, 0.08);
	}

	.hero-calendar-split__label--dark {
		top: auto;
		bottom: 0.75rem;
		right: 0.75rem;
		background: rgba(20, 20, 24, 0.88);
		color: #e8e8ea;
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	@media (min-width: 900px) {
		.m3-hero {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
			gap: 3.25rem;
			align-items: center;
			min-height: min(62vh, 34rem);
			padding: 2rem 0 3.25rem;
			max-width: none;
		}

		.m3-hero-content {
			padding-right: 0.5rem;
		}

		.hero-phone {
			display: none;
		}

		.hero-monitor {
			display: flex;
			margin-left: 0.75rem;
		}

		.hero-monitor__bezel {
			padding: 0.65rem;
			border-radius: 1.35rem;
		}

		.hero-monitor__screen {
			border-radius: 0.75rem;
		}

		.hero-calendar-split {
			aspect-ratio: 16 / 10.2;
			min-height: 16.5rem;
		}
	}

	@media (min-width: 1280px) {
		.m3-hero {
			gap: 3.75rem;
			padding-left: 0.5rem;
		}

		.hero-monitor {
			margin-left: 1.25rem;
		}

		.hero-monitor__bezel {
			padding: 0.7rem;
		}
	}

	@keyframes landing-orb-drift {
		0%,
		100% {
			transform: translate3d(0, 0, 0) scale(1);
		}
		50% {
			transform: translate3d(8%, 4%, 0) scale(1.08);
		}
	}

	/* ——— Sections ——— */
	.m3-section {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		padding: 2rem 0;
	}

	@media (min-width: 768px) {
		.m3-section {
			gap: 2.5rem;
			padding: 3rem 0;
		}
	}

	.m3-section-tonal {
		padding: 1.75rem 1.25rem;
		border-radius: var(--md-sys-shape-corner-extra-large);
		background: var(--md-sys-color-surface-container-low);
		border: 1px solid color-mix(in srgb, var(--md-sys-color-outline-variant) 50%, transparent);
	}

	@media (min-width: 768px) {
		.m3-section-tonal {
			padding: 2.5rem 2rem;
		}
	}

	.reveal-on-scroll {
		opacity: 0.2;
		transform: translateY(16px);
		transition:
			opacity 0.65s var(--md-sys-motion-easing-emphasized),
			transform 0.65s var(--md-sys-motion-easing-emphasized);
	}

	.reveal-on-scroll.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal-on-scroll,
		.landing-orb,
		.features-heading.reveal-on-scroll,
		[data-hero-reveal] {
			animation: none;
			opacity: 1;
			translate: none;
			transform: none;
			transition: none;
			transition-delay: 0ms;
		}

		.features-card {
			animation: none;
			transition: none;
		}

		.features-card.is-in {
			opacity: 1;
			transform: none;
			animation: none;
		}
	}

	/* ——— Features grid ——— */
	.features-section {
		gap: 1.5rem;
	}

	.features-intro {
		display: grid;
		justify-items: center;
		text-align: center;
	}

	.features-heading {
		display: grid;
		gap: 0.2rem;
		justify-items: center;
		margin: 0;
	}

	.features-heading.reveal-on-scroll {
		opacity: 0;
		transform: translateY(28px);
		transition:
			opacity 0.85s var(--md-sys-motion-easing-emphasized),
			transform 0.85s var(--md-sys-motion-easing-emphasized);
	}

	.features-heading.reveal-on-scroll.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.features-heading-lead {
		color: var(--md-sys-color-on-surface);
	}

	.features-heading-muted {
		color: color-mix(in srgb, var(--md-sys-color-on-surface-variant) 88%, transparent);
		font-weight: 650;
	}

	@keyframes feature-card-enter {
		from {
			opacity: 0;
			transform: translateY(40px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.features-panel {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1px;
		overflow: hidden;
		border-radius: var(--md-sys-shape-corner-extra-large);
		border: 0;
		background: var(--md-sys-color-surface);
		box-shadow: none;
	}

	.features-dots {
		display: none;
	}

	.features-card {
		display: grid;
		gap: 0.75rem;
		align-content: start;
		padding: 1.35rem 1.25rem 1.45rem;
		background: var(--md-sys-color-surface-container);
		text-align: left;
		opacity: 0;
		transform: translateY(40px);
		transition: background-color var(--md-sys-motion-duration-short) var(--md-sys-motion-easing-standard);
	}

	.features-card:hover {
		background: var(--md-sys-color-surface-container-high);
	}

	.features-card.is-in {
		/* Solo la animación controla opacidad/posición: así cada card entra cuando recibe la clase. */
		animation: feature-card-enter 0.55s cubic-bezier(0.2, 0, 0, 1) both;
	}

	.features-card-icon {
		display: grid;
		place-items: center;
		width: 2.55rem;
		height: 2.55rem;
		border-radius: 0.7rem;
		border: 1.5px solid #4ba3ff;
		color: #4ba3ff;
		background: color-mix(in srgb, #4ba3ff 10%, transparent);
		box-shadow: 0 0 0 1px color-mix(in srgb, #4ba3ff 12%, transparent);
	}

	.features-card-icon .material-symbols-rounded {
		font-size: 1.3rem;
		font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
	}

	.features-card-title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.3;
		color: var(--md-sys-color-on-surface);
	}

	.features-card-text {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--md-sys-color-on-surface-variant);
	}

	@media (max-width: 699px) {
		.features-carousel {
			display: grid;
			gap: 0.9rem;
			width: 100%;
		}

		.features-panel {
			display: flex;
			gap: 0.85rem;
			overflow-x: auto;
			overflow-y: hidden;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: var(--landing-pad-x);
			padding: 0.1rem var(--landing-pad-x) 0.35rem;
			margin-inline: calc(var(--landing-pad-x) * -1);
			border-radius: 0;
			background: transparent;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
			overscroll-behavior-x: contain;
		}

		.features-panel::-webkit-scrollbar {
			display: none;
		}

		.features-card {
			flex: 0 0 min(78vw, 18.5rem);
			scroll-snap-align: start;
			border-radius: var(--md-sys-shape-corner-extra-large);
			min-height: 13.5rem;
		}

		.features-dots {
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 0.45rem;
		}

		.features-dot {
			width: 0.45rem;
			height: 0.45rem;
			padding: 0;
			border: 0;
			border-radius: 999px;
			background: color-mix(in srgb, var(--md-sys-color-on-surface) 28%, transparent);
			cursor: pointer;
			transition:
				width var(--md-sys-motion-duration-short) var(--md-sys-motion-easing-standard),
				background-color var(--md-sys-motion-duration-short) var(--md-sys-motion-easing-standard);
		}

		.features-dot.is-active {
			width: 1.15rem;
			background: #4ba3ff;
		}
	}

	@media (min-width: 700px) {
		.features-panel {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.features-card {
			padding: 1.55rem 1.45rem 1.65rem;
			min-height: 100%;
		}

		.features-dots {
			display: none;
		}
	}

	@media (min-width: 1024px) {
		.features-section {
			gap: 2rem;
		}

		.features-panel {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.features-card {
			padding: 1.75rem 1.6rem 1.85rem;
		}

		.features-card-title {
			font-size: 1.1rem;
		}
	}

	/* ——— Workflow ——— */
	.workflow-intro {
		display: grid;
		gap: 0.85rem;
		justify-items: center;
		text-align: center;
	}

	.workflow-steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
		min-width: 0;
	}

	.workflow-step {
		position: relative;
		min-width: 0;
	}

	.workflow-step-copy {
		display: grid;
		gap: 0.45rem;
		width: 100%;
		padding: 1.35rem 1.35rem 1.5rem;
		min-width: 0;
		border-radius: var(--md-sys-shape-corner-extra-large);
		background: var(--md-sys-color-surface-container);
		border: 1px solid color-mix(in srgb, var(--md-sys-color-outline-variant) 45%, transparent);
		text-align: left;
	}

	.workflow-step-num {
		display: block;
		color: var(--md-sys-color-primary);
		font-size: 2.75rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 0.95;
		font-variant-numeric: tabular-nums;
		opacity: 0.9;
	}

	.workflow-step-arrow {
		display: none;
	}

	@media (min-width: 900px) {
		.workflow-steps {
			--workflow-gap-x: 3.5rem;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1rem var(--workflow-gap-x);
			align-items: stretch;
		}

		.workflow-step {
			display: flex;
		}

		.workflow-step-copy {
			justify-items: center;
			text-align: center;
			padding: 1.6rem 1.35rem 1.7rem;
		}

		.workflow-step-num {
			font-size: 3.25rem;
		}

		.workflow-step-arrow {
			display: grid;
			place-items: center;
			position: absolute;
			z-index: 2;
			top: 50%;
			left: calc(100% + var(--workflow-gap-x) / 2);
			transform: translate(-50%, -50%);
			width: 2.15rem;
			height: 2.15rem;
			border-radius: var(--md-sys-shape-corner-full);
			background: var(--md-sys-color-secondary-container);
			color: var(--md-sys-color-on-secondary-container);
			font-size: 1.15rem;
			border: 1px solid color-mix(in srgb, var(--md-sys-color-outline-variant) 50%, transparent);
		}
	}

	/* ——— CTA ——— */
	.m3-cta-card {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 1.75rem;
		padding: 2.5rem 1.5rem;
		border-radius: var(--md-sys-shape-corner-extra-large);
		background:
			radial-gradient(ellipse 90% 120% at 100% 0%, rgba(70, 130, 255, 0.22), transparent 55%),
			linear-gradient(145deg, #101826 0%, #18243c 48%, #121c30 100%);
		border: 1px solid color-mix(in srgb, var(--md-sys-color-primary) 24%, transparent);
		box-shadow:
			var(--md-sys-elevation-2),
			0 0 40px rgba(50, 110, 255, 0.08);
	}

	.m3-cta-card::before {
		content: '';
		position: absolute;
		inset: -20%;
		z-index: -1;
		background: radial-gradient(circle at 70% 30%, rgba(110, 170, 255, 0.1), transparent 45%);
		pointer-events: none;
	}

	@media (min-width: 640px) {
		.m3-cta-card {
			padding: 3.25rem 2rem;
		}
	}

	.cta-content {
		width: 100%;
		max-width: 36rem;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.15rem;
	}

	.cta-content .m3-headline,
	.cta-content .m3-body-large {
		text-align: center;
	}

	.cta-premium {
		color: #e8c76a;
	}

	.cta-btn {
		margin-top: 0.25rem;
		align-self: center;
	}

	.m3-cta-card .m3-body-large {
		color: var(--md-sys-color-on-surface-variant);
	}

	@media (min-width: 900px) {
		.m3-cta-card {
			padding: 3.25rem 3rem;
		}
	}

	/* ——— Footer ——— */
	.m3-footer {
		width: 100%;
		max-width: 22rem;
		margin: 0 auto;
		padding: 2rem 0.5rem 1.25rem;
		color: var(--md-sys-color-on-surface-variant);
		font-size: 0.875rem;
		line-height: 1.45;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.15rem;
		scroll-margin-top: 0;
	}

	.m3-footer-brand,
	.m3-footer-support,
	.m3-footer-nav {
		width: 100%;
		margin: 0;
	}

	.m3-footer-links {
		display: contents;
	}

	.m3-footer-brand {
		display: grid;
		gap: 0.2rem;
		justify-items: center;
	}

	.m3-footer-copy,
	.m3-footer-tagline {
		margin: 0;
	}

	.m3-footer-copy {
		color: var(--md-sys-color-on-surface);
		font-weight: 700;
	}

	.m3-footer-tagline {
		font-size: 0.8rem;
		opacity: 0.85;
	}

	.m3-footer-support {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3rem;
	}

	.m3-footer-nav {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.m3-footer-link {
		color: var(--md-sys-color-primary);
		font-weight: 700;
		font-size: 0.875rem;
		padding: 0.2rem 0.35rem;
		border-radius: var(--md-sys-shape-corner-small);
		transition: color var(--md-sys-motion-duration-short) var(--md-sys-motion-easing-standard);
	}

	.m3-footer-link:hover {
