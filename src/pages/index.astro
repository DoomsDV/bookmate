---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
const siteOrigin = String(Astro.site ?? Astro.url.origin).replace(/\/+$/, '');
const pageTitle = 'Hasel — Software de citas, agenda y reservas online para tu negocio';
const metaDescription =
	'Organizá citas, equipo y clientes en un solo panel. Tus clientes reservan 24/7 con tu enlace personalizado. Probá Premium gratis 14 días.';

const showcaseFeatures = [
	{
		id: 'voice-ai',
		eyebrow: 'Recepción inteligente',
		title: 'Cargá citas hablando, con IA',
		badge: 'Incluido en Premium',
		blocks: [
			{
				icon: 'smartphone',
				title: 'Uso en movimiento',
				text: 'Pensado para que cargues turnos al instante mientras estás ocupado o atendiendo en el mostrador.',
			},
		],
		visual: 'voice',
	},
	{
		id: 'deposits',
		eyebrow: 'Cobro de señas',
		title: 'Pedí seña y asegurá tu tiempo',
		badge: 'Incluido en Premium',
		blocks: [
			{
				icon: 'account_balance',
				title: 'Transferencia directa',
				text: 'El cliente te transfiere la seña a tu cuenta. El dinero llega sin intermediarios.',
			},
			{
				icon: 'fact_check',
				title: 'Validación con un clic',
				text: 'Recibí el comprobante del cliente directamente en tu panel y aprobá el turno al instante.',
			},
		],
		visual: 'deposit',
	},
	{
		id: 'history',
		eyebrow: 'Historial por visita',
		title: 'El historial del cliente, en cada cita',
		badge: 'Incluido en Premium',
		blocks: [
			{
				icon: 'note_alt',
				title: 'Notas y archivos',
				text: 'Al completar un turno, guardá el contexto de la visita: notas, fotos o documentos en un solo lugar.',
			},
		],
		visual: 'history',
	},
] as const;

const steps = [
	{
		step: '1',
		title: 'Configurá en minutos',
		text: 'Definí tus servicios, horarios y profesionales en un panel intuitivo. Tu negocio listo para operar al instante.',
	},
	{
		step: '2',
		title: 'Compartí tu enlace',
		text: 'Pegá tu enlace en WhatsApp, Instagram o tu bio. Tus clientes ven tu disponibilidad real y agendan solos 24/7.',
	},
	{
		step: '3',
		title: 'Todo bajo control',
		text: 'El calendario se actualiza solo. Recibí alertas al instante y dejá que Hasel envíe los recordatorios automáticos por vos.',
	},
];

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Hasel',
		url: siteOrigin,
		description: metaDescription,
		inLanguage: 'es',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'Hasel',
		applicationCategory: 'BusinessApplication',
		operatingSystem: 'Web',
		url: siteOrigin,
		description: metaDescription,
		offers: {
			'@type': 'Offer',
			price: '0',
			priceCurrency: 'PYG',
			description: 'Prueba Premium 14 días sin tarjeta',
		},
		featureList: [
			'Citas por voz con IA',
			'Cobro de señas por transferencia',
			'Historial de visitas con notas y archivos',
			'Reservas públicas por enlace personalizado',
			'Prueba Premium 14 días',
			...steps.map((step) => step.title),
		].join(', '),
	},
];

---

<Layout
	pageTitle={pageTitle}
	metaDescription={metaDescription}
	canonicalPath="/"
	ogImage="/icon-512x512.png"
	jsonLd={jsonLd}
>
	<main class="landing-root">
		<div class="landing-orb landing-orb-a" aria-hidden="true"></div>
		<div class="landing-orb landing-orb-b" aria-hidden="true"></div>
		<div class="landing-orb landing-orb-c" aria-hidden="true"></div>

		<header class="landing-topbar" data-landing-topbar>
			<div class="landing-topbar-inner">
				<a href="/" class="brand no-underline" aria-label="Hasel — Inicio">
					<img
						src="/icon-512x512.png"
						alt=""
						class="brand-logo"
						width="32"
						height="32"
						loading="eager"
						decoding="async"
					/>
					<span class="brand-text">Hasel</span>
				</a>

				<nav class="landing-topbar-links" aria-label="Secciones">
					<a href="#funciones" class="landing-topbar-link no-underline">Funciones</a>
					<a href="#precios" class="landing-topbar-link no-underline">Precios</a>
					<a href="#soporte" class="landing-topbar-link no-underline">Soporte</a>
				</nav>

				<div class="nav-actions">
					<a href="/auth/login" class="m3-btn m3-btn-ghost m3-btn-nav no-underline">Iniciar sesión</a>
					<a href="/auth/register" class="m3-btn m3-btn-primary m3-btn-nav no-underline">Empezar gratis</a>
				</div>
			</div>
		</header>

		<div class="landing-shell">
			<section class="m3-hero" aria-labelledby="hero-heading">
				<div class="m3-hero-content">
					<p class="m3-chip m3-chip-primary">
						<span class="material-symbols-rounded" aria-hidden="true">workspace_premium</span>
						<span>14 días Premium de prueba</span>
					</p>
					<h1 id="hero-heading" class="m3-display">
						Tu calendario, equipo y reservas públicas en una sola plataforma
					</h1>
					<p class="m3-body-large">
						Tus clientes reservan 24/7; vos gestionás el día desde un solo lugar.
					</p>

					<div class="hero-actions">
						<a href="#funciones" class="m3-btn m3-btn-tonal m3-btn-large no-underline">Ver funciones</a>
					</div>
				</div>

				<div class="m3-hero-visuals" data-hero-visuals>
					<div class="visual-story-shell">
						<div class="visual-card-slot visual-card-slot--main">
							<button
								type="button"
								class="visual-card visual-card-main"
								data-visual-card
								aria-expanded="false"
								aria-label="¡Nueva Cita Agendada!"
							>
								<div class="visual-header">
									<div class="visual-avatar">
										<span class="material-symbols-rounded" aria-hidden="true">event</span>
									</div>
									<div class="visual-detail">
										<div class="visual-info">
											<strong>¡Nueva Cita Agendada!</strong>
											<span>[Consultorio Centro] Ana Ríos ha reservado para el 15/07/2026 a las 10:30</span>
										</div>
									</div>
								</div>
							</button>
						</div>

						<div class="visual-card-slot visual-card-slot--team">
							<button
								type="button"
								class="visual-card visual-card-3"
								data-visual-card
								aria-expanded="false"
								aria-label="Cita cancelada"
							>
								<div class="visual-icon-box visual-icon-cancel">
									<span class="material-symbols-rounded" aria-hidden="true">event_busy</span>
								</div>
								<div class="visual-detail">
									<div class="visual-info">
										<strong>Cita cancelada</strong>
										<span>[Consultorio Centro] Ana Ríos cancelo su cita del 15/07/2026 a las 10:30</span>
									</div>
								</div>
							</button>
						</div>
					</div>
				</div>
			</section>

			<section id="funciones" class="m3-section" aria-labelledby="funciones-heading">
				<div class="section-header center reveal-on-scroll">
					<h2 id="funciones-heading" class="m3-headline">Herramientas Premium</h2>
					<p class="m3-body section-lead">
						Recepción por voz con IA, cobro de señas e historial de clientes. Todo el poder de Hasel
						incluido en tu prueba de 14 días.
					</p>
				</div>

				<div class="feature-showcase">
					{
						showcaseFeatures.map((feature) => (
							<article class="feature-stack reveal-on-scroll">
								<div class="feature-stack-copy">
									<header class="feature-stack-head">
										<div class="feature-stack-labels">
											<p class="feature-eyebrow">{feature.eyebrow}</p>
											<span class="feature-badge">
												<span class="material-symbols-rounded" aria-hidden="true">workspace_premium</span>
												{feature.badge}
											</span>
										</div>
										<h3 class="feature-title">{feature.title}</h3>
									</header>

									<div class="feature-microblocks">
										{feature.blocks.map((block) => (
											<div class="feature-microblock">
												<span class="feature-microblock-icon material-symbols-rounded" aria-hidden="true">
													{block.icon}
												</span>
												<div class="feature-microblock-copy">
													<strong>{block.title}</strong>
													<p>{block.text}</p>
												</div>
											</div>
										))}
									</div>
								</div>

								<div class="feature-visual" aria-hidden="true">
									{feature.visual === 'voice' ? (
										<div class="ui-panel ui-panel--voice">
											<div class="ui-voice-header">
												<span class="ui-voice-mic material-symbols-rounded">mic</span>
												<strong>Cita rápida por voz</strong>
											</div>
											<p
												class="ui-voice-quote"
												data-typewriter="“Agendá a Ana Ríos mañana a las 10:30 para consulta general con la Dra. María en la sucursal Centro, dura 45 minutos”"
											>
												<span class="ui-voice-quote-text"></span><span class="ui-voice-caret" aria-hidden="true"></span>
											</p>
											<div class="ui-voice-result">
												<small>Ana Ríos · Consulta · Mañana 10:30 · 45 min · Sucursal Centro · Dra. María</small>
											</div>
										</div>
									) : feature.visual === 'deposit' ? (
										<div class="ui-panel ui-panel--deposit">
											<p class="ui-deposit-kicker">Señas pendientes de validación</p>
											<div class="ui-cobros-card">
												<div class="ui-cobros-card__top">
													<div>
														<strong class="ui-cobros-card__amount">Gs. 50.000</strong>
														<span class="ui-cobros-card__client">Ana Ríos</span>
													</div>
													<span class="ui-cobros-status">Comprobante subido</span>
												</div>
												<p class="ui-cobros-card__meta">En revisión · Consulta general · Mañana 10:30</p>
												<div class="ui-cobros-actions">
													<span class="ui-cobros-btn ui-cobros-btn--ghost">Ver comprobante</span>
													<span class="ui-cobros-btn ui-cobros-btn--primary">Aprobar seña</span>
												</div>
											</div>
										</div>
									) : (
										<div class="ui-panel ui-panel--history">
											<div class="ui-history-header">
												<strong>Ana Ríos</strong>
												<span>Historial de visitas</span>
											</div>
											<div class="ui-history-card">
												<small>12 jun · Completado</small>
												<strong>Consulta de control</strong>
												<p>Nota: Respondió bien al plan. Próximo control en 30 días.</p>
												<div class="ui-file-chips">
													<span class="ui-file-chip">foto-control-1.jpg</span>
													<span class="ui-file-chip">foto-control-2.jpg</span>
												</div>
											</div>
											<div class="ui-history-card ui-history-card--muted">
												<small>15 may · Completado</small>
												<strong>Primera consulta</strong>
												<p>Archivo: consentimiento.pdf</p>
											</div>
										</div>
									)}
								</div>
							</article>
						))
					}
				</div>
			</section>

			<section id="como-funciona" class="m3-section m3-section-tonal" aria-labelledby="como-funciona-heading">
				<div class="workflow-intro reveal-on-scroll">
					<p class="m3-chip m3-chip-secondary">
						<span class="material-symbols-rounded" aria-hidden="true">bolt</span>
						<span>Listo para usar</span>
					</p>
					<h2 id="como-funciona-heading" class="m3-headline">Cómo funciona Hasel</h2>
				</div>

				<ol class="workflow-steps">
					{
						steps.map((item, index) => (
							<li class="workflow-step reveal-on-scroll">
								<span class="workflow-step-marker" aria-hidden="true">
									<span class="workflow-step-num">{item.step}</span>
								</span>
								<div class="workflow-step-copy">
									<h3 class="m3-title">{item.title}</h3>
									<p class="m3-body">{item.text}</p>
								</div>
								{index < steps.length - 1 ? (
									<span class="workflow-step-arrow material-symbols-rounded" aria-hidden="true">
										arrow_forward
									</span>
								) : null}
							</li>
						))
					}
				</ol>
			</section>

			<section id="precios" class="m3-cta-card" aria-labelledby="cta-heading">
				<div class="cta-content">
					<h2 id="cta-heading" class="m3-headline">Empezá con 14 días de Premium</h2>
					<p class="m3-body-large">
						Creá tu espacio, configurá horarios y compartí tu página pública. Tus clientes
						reservan; vos controlás todo desde el calendario.
					</p>
					<a href="/auth/register" class="m3-btn m3-btn-primary m3-btn-large no-underline cta-btn">
						Crear mi espacio gratis
						<span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span>
					</a>
				</div>
			</section>

			<footer id="soporte" class="m3-footer">
				<div class="m3-footer-brand">
					<p class="m3-footer-copy">© {new Date().getFullYear()} Hasel</p>
					<p class="m3-footer-tagline">Software de citas y reservas online</p>
				</div>
				<p class="m3-footer-support">
					<span>¿Necesitás ayuda? Escribinos al correo</span>
					<a href="mailto:support@hasel.app" class="m3-footer-link no-underline">support@hasel.app</a>
				</p>
				<nav class="m3-footer-nav" aria-label="Enlaces legales">
					<a href="/politicas-y-privacidad" class="m3-footer-link no-underline">
						Políticas y privacidad
					</a>
					<a href="/politicas-de-cancelacion-y-reembolso" class="m3-footer-link no-underline">
						Cancelación y reembolso
					</a>
				</nav>
			</footer>
		</div>
	</main>
</Layout>

<script is:inline>
	(() => {
		if (typeof window === 'undefined') return;

		const nav = document.querySelector('[data-landing-topbar]');
		const getOffset = () => {
			const navHeight = nav instanceof HTMLElement ? nav.getBoundingClientRect().height : 0;
			return navHeight + 12;
		};

		const syncTopbar = () => {
			if (!(nav instanceof HTMLElement)) return;
			nav.classList.toggle('is-scrolled', window.scrollY > 12);
		};
		syncTopbar();
		window.addEventListener('scroll', syncTopbar, { passive: true });

		const scrollToHash = (hash, behavior = 'smooth') => {
			if (!hash || !hash.startsWith('#')) return;
			const id = decodeURIComponent(hash.slice(1));
			if (!id) return;
			const target = document.getElementById(id);
			if (!target) return;

			const top = target.getBoundingClientRect().top + window.scrollY - getOffset();
			window.scrollTo({ top: Math.max(0, top), behavior });
		};

		document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
			anchor.addEventListener('click', (event) => {
				const href = anchor.getAttribute('href');
				if (!href) return;
				event.preventDefault();
				history.pushState(null, '', href);
				scrollToHash(href, 'smooth');
			});
		});

		if (window.location.hash) {
			requestAnimationFrame(() => scrollToHash(window.location.hash, 'auto'));
		}

		const revealNodes = document.querySelectorAll('.reveal-on-scroll');
		if (revealNodes.length && 'IntersectionObserver' in window) {
			const revealObserver = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						entry.target.classList.add('is-visible');
						revealObserver.unobserve(entry.target);
					}
				},
				{ rootMargin: '0px 0px -12% 0px', threshold: 0.18 }
			);
			revealNodes.forEach((node) => revealObserver.observe(node));
		} else {
			revealNodes.forEach((node) => node.classList.add('is-visible'));
		}

		const heroVisualMq = window.matchMedia('(max-width: 1023px)');
		const visualCards = Array.from(document.querySelectorAll('[data-visual-card]'));

		const closeVisualCards = () => {
			for (const card of visualCards) {
				if (!(card instanceof HTMLElement)) continue;
				card.classList.remove('is-open');
				card.setAttribute('aria-expanded', 'false');
			}
		};

		for (const card of visualCards) {
			card.addEventListener('click', (event) => {
				if (!heroVisualMq.matches) return;
				event.stopPropagation();
				const willOpen = !card.classList.contains('is-open');
				closeVisualCards();
				if (!willOpen) return;
				card.classList.add('is-open');
				card.setAttribute('aria-expanded', 'true');
			});
		}

		document.addEventListener('click', () => {
			if (!heroVisualMq.matches) return;
			closeVisualCards();
		});

		heroVisualMq.addEventListener('change', () => {
			if (!heroVisualMq.matches) closeVisualCards();
		});

		document.querySelectorAll('[data-typewriter]').forEach((node) => {
			if (!(node instanceof HTMLElement)) return;
			const full = node.getAttribute('data-typewriter') || '';
			const textEl = node.querySelector('.ui-voice-quote-text');
			if (!textEl) return;

			let started = false;
			const runTypewriter = () => {
				if (started) return;
				started = true;
				node.classList.add('is-typing');
				let i = 0;
				const tick = () => {
					textEl.textContent = full.slice(0, i);
					i += 1;
					if (i <= full.length) {
						window.setTimeout(tick, 28);
					} else {
						window.setTimeout(() => node.classList.remove('is-typing'), 1800);
					}
				};
				tick();
			};

			if ('IntersectionObserver' in window) {
				const typeObserver = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							runTypewriter();
							typeObserver.disconnect();
						}
					},
					{ rootMargin: '0px 0px -20% 0px', threshold: 0.25 }
				);
				typeObserver.observe(node);
			} else {
				runTypewriter();
			}
		});
	})();
</script>

<style>
	/* PREMIUM DARK — single palette, no light/dark duality */
	:root {
		--m3-sys-light-primary: #3a6fd7;
		--m3-sys-light-on-primary: #ffffff;
		--m3-sys-light-primary-container: rgba(58, 111, 215, 0.2);
		--m3-sys-light-on-primary-container: #bfd6ff;

		--m3-sys-light-secondary: #6b8ecf;
		--m3-sys-light-secondary-container: rgba(148, 163, 184, 0.12);
		--m3-sys-light-on-secondary-container: #dbe7ff;

		--m3-sys-light-surface: #09090b;
		--m3-sys-light-surface-container: rgba(255, 255, 255, 0.04);
		--m3-sys-light-on-surface: #ffffff;
		--m3-sys-light-on-surface-variant: #a1a1aa;

		--m3-sys-light-outline: #3f3f46;
		--m3-sys-light-outline-variant: rgba(255, 255, 255, 0.1);
	}

	.landing-root {
		--landing-max: 1200px;
		--landing-pad-x: 1rem;
		position: relative;
		overflow: hidden;
		min-height: 100vh;
		background-color: var(--m3-sys-light-surface);
		color: var(--m3-sys-light-on-surface);
		font-family: 'Inter', system-ui, sans-serif;
	}

	@media (min-width: 768px) {
		.landing-root {
			--landing-pad-x: 1.5rem;
		}
	}

	html {
		scroll-padding-top: 5.5rem;
	}

	.landing-root [id] {
		scroll-margin-top: 5.5rem;
	}

	.landing-orb {
		position: absolute;
		border-radius: 9999px;
		filter: blur(92px);
		pointer-events: none;
		z-index: 0;
		animation: landing-orb-drift 16s ease-in-out infinite;
		will-change: transform, opacity;
	}

	.landing-orb-a {
		top: -15%;
		left: -10%;
		width: 55vw;
		height: 55vw;
		background: radial-gradient(circle, rgba(59, 130, 246, 0.28), transparent 65%);
		animation-duration: 18s;
	}

	.landing-orb-b {
		bottom: -15%;
		right: -10%;
		width: 65vw;
		height: 65vw;
		background: radial-gradient(circle, rgba(14, 165, 233, 0.22), transparent 65%);
		animation-duration: 22s;
		animation-direction: reverse;
	}

	.landing-orb-c {
		top: 38%;
		left: 18%;
		width: 35vw;
		height: 35vw;
		background: radial-gradient(circle, rgba(99, 102, 241, 0.18), transparent 65%);
		animation-duration: 19s;
		animation-delay: -4s;
	}

	.landing-shell {
		position: relative;
		z-index: 1;
		width: min(var(--landing-max), 100%);
		margin: 0 auto;
		padding: 1rem var(--landing-pad-x);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.landing-topbar {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		padding: 0.85rem 0;
		background: transparent;
		border-bottom: 1px solid transparent;
		transition:
			background-color 0.25s ease,
			border-color 0.25s ease,
			backdrop-filter 0.25s ease,
			box-shadow 0.25s ease;
	}

	.landing-topbar.is-scrolled {
		background: rgba(9, 9, 11, 0.72);
		border-bottom-color: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
	}

	.landing-topbar-inner {
		width: min(var(--landing-max), 100%);
		margin: 0 auto;
		padding: 0 var(--landing-pad-x);
		display: flex;
		align-items: center;
