---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import '../../styles/auth.css';
import {
	CREATE_ORGANIZATION_PATH,
	getOrgSelectionCookie,
	isInvitationAcceptRedirect,
} from '../../lib/auth';

const selectionContext = getOrgSelectionCookie(Astro.cookies);
const error = Astro.url.searchParams.get('error') ?? '';
const pendingInvitation = Boolean(
	selectionContext?.redirectTo && isInvitationAcceptRedirect(selectionContext.redirectTo)
);

if (!selectionContext) {
	return Astro.redirect('/auth/login?error=' + encodeURIComponent('Tu sesión expiró. Vuelve a iniciar sesión.'));
}

const organizations = selectionContext.organizations;
const redirectTo = String(selectionContext.redirectTo || '/panel/dashboard').trim();
const preferredOrgMemberId = (() => {
	try {
		const targetUrl = new URL(redirectTo, Astro.url);
		const raw = String(targetUrl.searchParams.get('org_member_id') || '').trim();
		const parsed = Number(raw);
		if (!Number.isInteger(parsed) || parsed <= 0) return 0;
		return parsed;
	} catch {
		return 0;
	}
})();
const preferredOrgIndex =
	preferredOrgMemberId > 0
		? organizations.findIndex((org) => Number(org.org_member_id) === preferredOrgMemberId)
		: -1;
const autoSubmitPreferredOrg =
	preferredOrgIndex >= 0 && organizations.length > 1 && !pendingInvitation;
---

<Layout
	pageTitle="Seleccionar organización | Hasel"
	metaDescription="Elegí con qué organización trabajar en tu sesión de Hasel."
	canonicalPath="/auth/select-org"
	ogImage="/icons/icon-512x512.png"
	robots="noindex, nofollow"
>
	<section class="auth-page" data-select-org-root>
		<header class="auth-topbar">
			<div class="auth-topbar-inner">
				<a href="/" class="auth-brand" aria-label="Hasel — Inicio">
					<img
						src="/icons/icon-64.png"
						alt=""
						class="auth-brand-logo"
						width="40"
						height="40"
						loading="eager"
						decoding="async"
					/>
					<span class="auth-brand-wordmark">Hasel</span>
				</a>
			</div>
		</header>

		<div class="auth-shell">
			<main class="auth-card select-org-card">
				<header class="auth-card-header select-org-card-header">
					<h1 class="auth-title">Seleccionar organización</h1>
					<p class="auth-subtitle">
						Elegí con cuál organización trabajar en esta sesión. Luego podés cambiar desde el panel.
					</p>
				</header>

				{error && (
					<div class="auth-banner auth-banner-error" role="alert">
						<span class="material-symbols-rounded" aria-hidden="true">error</span>
						<span>{error}</span>
					</div>
				)}

				{pendingInvitation && (
					<div class="auth-banner auth-banner-info" role="status">
						<span class="material-symbols-rounded" aria-hidden="true">mail</span>
						<span>
							Tenés una invitación pendiente. Al continuar, la aceptaremos con la sesión de la
							organización que elijas y te llevaremos al panel.
						</span>
					</div>
				)}

				<form
					method="post"
					action="/api/auth/select-org"
					class="org-select-form"
					data-auto-submit-preferred={autoSubmitPreferredOrg ? '1' : '0'}
				>
					<input type="hidden" name="redirectTo" value={redirectTo} />
					<ul class="auth-org-list">
						{organizations.map((org, index) => {
							const isChecked =
								preferredOrgIndex >= 0 ? index === preferredOrgIndex : index === 0;
							return (
								<li>
									<label
										class:list={['auth-org-card', { 'is-selected': isChecked }]}
										data-org-card
									>
										<input
											type="radio"
											name="org_member_id"
											value={String(org.org_member_id)}
											required
											class="auth-org-radio"
											checked={isChecked}
										/>
										<span class="auth-org-indicator" aria-hidden="true"></span>
										<span class="auth-org-content">
											<span class="auth-org-name">{org.organization_name}</span>
											<span class="auth-org-role">{org.role_name}</span>
										</span>
										<span class="select-org-chevron material-symbols-rounded" aria-hidden="true">
											chevron_right
										</span>
									</label>
								</li>
							);
						})}
					</ul>

					<div class="auth-actions auth-actions--between select-org-actions">
						<a href="/auth/login" class="auth-btn auth-btn-tonal" data-select-org-back>
							Volver al login
						</a>
						<button type="submit" class="auth-btn auth-btn-primary select-org-submit" data-select-org-submit>
							Continuar
						</button>
					</div>
				</form>

				<footer class="auth-card-footer select-org-card-footer">
					<p class="auth-footer-text">
						¿Querés registrar un espacio de trabajo nuevo?
						<a
							href={CREATE_ORGANIZATION_PATH}
							class="auth-footer-link"
							title="Registrá un espacio nuevo con el acceso que acabas de iniciar"
							><strong>Crear organización</strong></a
						>
					</p>
				</footer>
			</main>
		</div>

		<footer class="auth-page-footer" aria-label="Pie de página">
			<p>
				Hasel &copy; 2026
				<span class="auth-page-footer-sep" aria-hidden="true">|</span>
				<a href="/politicas-y-privacidad" class="auth-page-footer-link">Políticas de privacidad</a>
			</p>
		</footer>
	</section>
</Layout>

<script is:inline>
	function setupSelectOrgForm() {
		const root = document.querySelector('[data-select-org-root]');
		if (!root || root.dataset.enhanced) return;
		root.dataset.enhanced = 'true';

		const cards = root.querySelectorAll('[data-org-card]');
		const syncSelected = () => {
			cards.forEach((card) => {
				const input = card.querySelector('input[type="radio"]');
				card.classList.toggle(
					'is-selected',
					input instanceof HTMLInputElement && input.checked
				);
			});
		};

		cards.forEach((card) => {
			card.addEventListener('click', () => {
				const input = card.querySelector('input[type="radio"]');
				if (input instanceof HTMLInputElement) {
					input.checked = true;
					syncSelected();
				}
			});
		});

		root.querySelectorAll('.auth-org-radio').forEach((input) => {
			input.addEventListener('change', syncSelected);
		});

		syncSelected();

		const form = root.querySelector('form.org-select-form');
		const submitBtn = root.querySelector('[data-select-org-submit]');
		const setSubmitting = (isSubmitting) => {
			if (!(submitBtn instanceof HTMLButtonElement)) return;
			submitBtn.disabled = isSubmitting;
			submitBtn.setAttribute('aria-busy', isSubmitting ? 'true' : 'false');
			submitBtn.textContent = isSubmitting ? 'Entrando…' : 'Continuar';
			const backLink = root.querySelector('[data-select-org-back]');
			if (backLink instanceof HTMLAnchorElement) {
				backLink.style.pointerEvents = isSubmitting ? 'none' : '';
				backLink.setAttribute('aria-disabled', isSubmitting ? 'true' : 'false');
			}
		};

		if (form instanceof HTMLFormElement && !form.dataset.submitBound) {
			form.dataset.submitBound = 'true';
			form.addEventListener('submit', () => {
				setSubmitting(true);
			});
		}

		if (
			form instanceof HTMLFormElement &&
			form.dataset.autoSubmitPreferred === '1' &&
			!root.dataset.autoSubmitted
		) {
			root.dataset.autoSubmitted = '1';
			setSubmitting(true);
			form.requestSubmit();
		}
	}

	if (typeof window !== 'undefined') {
		setupSelectOrgForm();
		document.addEventListener('astro:page-load', setupSelectOrgForm);
	}
</script>

<style>
	.select-org-card {
		max-width: 32rem;
		background: rgba(20, 24, 32, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(24px) saturate(1.15);
		-webkit-backdrop-filter: blur(24px) saturate(1.15);
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.12),
			0 16px 40px rgba(0, 0, 0, 0.16),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
	}

	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.select-org-card {
			background: rgba(20, 24, 32, 0.88);
		}
	}

	:global(.auth-page[data-select-org-root] .auth-shell) {
		padding: 0.75rem var(--auth-pad-x) 0.35rem;
	}

	:global(.auth-page[data-select-org-root] .auth-page-footer) {
		padding: 0.35rem var(--auth-pad-x) 0.85rem;
	}

	.select-org-card-header {
		margin-bottom: 1.25rem;
	}

	.select-org-card :global(.auth-org-list) {
		margin-bottom: 0.25rem;
	}

	.select-org-chevron {
		color: var(--auth-on-surface-variant);
		flex-shrink: 0;
	}

	.select-org-card :global(.auth-actions) {
		margin-top: 1.15rem;
		padding-top: 0;
		border-top: none;
		gap: 0.75rem;
	}

	.select-org-card :global(.auth-card-footer) {
		margin-top: 0.75rem;
		padding-top: 0;
		border-top: none;
		text-align: center;
	}

	.select-org-submit.auth-btn-primary {
		box-shadow: none;
	}

	.select-org-submit.auth-btn-primary:hover {
		background: var(--auth-primary-hover);
		box-shadow: none;
		transform: none;
	}

	.select-org-submit.auth-btn-primary:active {
		transform: scale(0.98);
	}

	@media (max-width: 640px) {
		:global(.auth-page[data-select-org-root] .auth-shell) {
			padding: 0.65rem var(--auth-pad-x) 0.25rem;
		}

		:global(.auth-page[data-select-org-root] .auth-page-footer) {
			padding: 0.25rem var(--auth-pad-x) 0.65rem;
		}

		.select-org-card {
			max-width: none;
			background: transparent;
			border: none;
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
			box-shadow: none;
			border-radius: 0;
			padding: 0;
		}

		.select-org-card-header {
			align-items: center;
			text-align: center;
			gap: 0.35rem;
			margin-bottom: 1rem;
		}

		.select-org-actions {
			flex-direction: column-reverse;
			align-items: stretch;
		}

		.select-org-actions :global(.auth-btn) {
			width: 100%;
		}

		.select-org-card-footer :global(.auth-footer-text) {
			font-size: 0.88rem;
		}
	}
</style>
