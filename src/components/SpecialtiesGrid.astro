---
import type { Specialty } from '../lib/specialties';

interface Props {
	specialties: Specialty[];
	showCreateAction?: boolean;
	searchQuery?: string;
	isActiveFilter?: number | null;
}

const {
	specialties = [],
	showCreateAction = false,
	searchQuery = '',
	isActiveFilter = null,
} = Astro.props;
const hasSearch = Boolean(searchQuery);
const hasStatusFilter = isActiveFilter === 0 || isActiveFilter === 1;
const hasFilters = hasSearch || hasStatusFilter;

const SPECIALTY_ICON = 'workspace_premium';

const toDescriptionLabel = (value?: string | null) => {
	const text = String(value || '').trim();
	return text || 'Sin descripción';
};

const activeCount = specialties.filter((item) => item.is_active === 1).length;
const inactiveCount = specialties.length - activeCount;

---

<section class="specialties-view">
	<header class="mb-4 flex flex-wrap items-center justify-between gap-3">
		<h2 class="m-0 text-[1.5rem] sm:text-[1.75rem] font-bold tracking-tight text-(--on-surface) leading-none">
			Especialidades
		</h2>

		<div class="flex flex-wrap items-center justify-end gap-2">
			<span class="specialties-summary-pill specialties-summary-pill--active">
				<span class="size-2 rounded-full specialties-summary-dot specialties-summary-dot--active"></span>
				Activas: <span data-specialties-active-count>{activeCount}</span>
			</span>
			<span
				class="specialties-summary-pill specialties-summary-pill--inactive"
				data-specialties-inactive-pill
				hidden={inactiveCount <= 0}
			>
				<span class="size-2 rounded-full specialties-summary-dot specialties-summary-dot--inactive"></span>
				Inactivas: <span data-specialties-inactive-count>{inactiveCount}</span>
			</span>

			{showCreateAction && (
				<button
					type="button"
					class="specialties-create-btn hidden sm:inline-flex items-center justify-center gap-2"
					data-open-specialty-modal
				>
					<svg class="specialties-create-btn-icon w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
					</svg>
					<span>Nueva Especialidad</span>
				</button>
			)}
		</div>
	</header>

	{showCreateAction && (
		<button
			type="button"
			class="specialties-create-fab"
			data-open-specialty-modal
			aria-label="Nueva Especialidad"
			title="Nueva Especialidad"
		>
			<svg
				class="specialties-create-fab-icon"
				viewBox="0 0 24 24"
				fill="none"
				aria-hidden="true"
			>
				<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
			</svg>
		</button>
	)}

	<div class="flex max-w-xl items-center gap-2">
		<div class="relative min-w-0 flex-1">
			<span
				class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-(--on-surface-variant)"
				aria-hidden="true"
			>
				<span class="material-symbols-rounded text-[1.2rem]">search</span>
			</span>
			<input
				type="search"
				data-specialties-search
				placeholder="Buscar por nombre"
				aria-label="Buscar por nombre"
				autocomplete="off"
				value={searchQuery}
				class="w-full rounded-2xl border border-(--shell-border) bg-(--surface-bright) py-2.5 pl-11 pr-4 text-[0.95rem] font-semibold text-(--on-surface) outline-none transition placeholder:font-medium placeholder:text-(--on-surface-variant)/70 hover:border-(--on-surface-variant) focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10 shadow-sm"
			/>
		</div>

		<button
			type="button"
			class:list={[
				'panel-status-filter-btn relative flex size-11 shrink-0 items-center justify-center rounded-2xl border border-(--shell-border) bg-(--surface-bright) text-(--on-surface-variant) shadow-sm transition hover:border-(--on-surface-variant) hover:text-(--on-surface) focus:border-(--primary) focus:outline-none focus:ring-4 focus:ring-(--primary)/10',
				hasStatusFilter && 'is-active',
			]}
			data-open-specialties-status-filter
			aria-label="Filtrar por estado"
			aria-haspopup="dialog"
			aria-controls="specialties-status-filter-sheet"
			aria-pressed={hasStatusFilter ? 'true' : 'false'}
		>
			<span class="material-symbols-rounded text-[1.25rem]" aria-hidden="true">tune</span>
			{hasStatusFilter && (
				<span class="panel-status-filter-badge" data-specialties-status-filter-badge aria-hidden="true"></span>
			)}
		</button>
	</div>

	<dialog
		id="specialties-status-filter-sheet"
		class="panel-status-filter-sheet"
		data-specialties-status-filter-sheet
		aria-labelledby="specialties-status-filter-title"
	>
		<div class="panel-status-filter-sheet__handle" aria-hidden="true">
			<span></span>
		</div>
		<div class="panel-status-filter-sheet__header">
			<h2 id="specialties-status-filter-title" class="m-0 text-[1.05rem] font-extrabold tracking-tight">
				Estado
			</h2>
			<button
				type="button"
				class="flex size-9 shrink-0 items-center justify-center rounded-full text-(--on-surface-variant) transition-colors hover:bg-(--surface-variant) hover:text-(--on-surface)"
				data-close-specialties-status-filter
				aria-label="Cerrar filtro"
			>
				<span class="material-symbols-rounded text-[1.3rem]">close</span>
			</button>
		</div>
		<div class="panel-status-filter-sheet__list" role="listbox" aria-label="Estado de la especialidad">
			<button
				type="button"
				class:list={['panel-status-filter-option', !hasStatusFilter && 'is-selected']}
				data-specialties-status-option
				data-value=""
				role="option"
				aria-selected={!hasStatusFilter ? 'true' : 'false'}
			>
				<span>Todas</span>
				<span class="material-symbols-rounded">check</span>
			</button>
			<button
				type="button"
				class:list={['panel-status-filter-option', isActiveFilter === 1 && 'is-selected']}
				data-specialties-status-option
				data-value="1"
				role="option"
				aria-selected={isActiveFilter === 1 ? 'true' : 'false'}
			>
				<span>Activas</span>
				<span class="material-symbols-rounded">check</span>
			</button>
			<button
				type="button"
				class:list={['panel-status-filter-option', isActiveFilter === 0 && 'is-selected']}
				data-specialties-status-option
				data-value="0"
				role="option"
				aria-selected={isActiveFilter === 0 ? 'true' : 'false'}
			>
				<span>Inactivas</span>
				<span class="material-symbols-rounded">check</span>
			</button>
		</div>
	</dialog>

	<div data-specialties-results>
	{specialties.length === 0 ? (
		<div class="specialties-empty-state" data-specialties-empty>
			<div class="specialties-empty-icon">
				<span class="material-symbols-rounded text-[2rem]">{hasFilters ? 'search_off' : 'inbox'}</span>
			</div>
			<h3 class="text-[1.1rem] font-bold text-(--on-surface)">
				{hasFilters ? 'No se encontraron especialidades' : 'No hay especialidades registradas'}
			</h3>
			<p class="mt-1.5 max-w-sm text-[0.95rem] leading-relaxed text-(--on-surface-variant)">
				{hasSearch
					? 'Probá con otro nombre.'
					: hasStatusFilter
						? 'No hay especialidades con ese estado.'
						: 'Creá tu primera especialidad para empezar.'}
			</p>
		</div>
	) : (
		<div class="material-cards-grid gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3" data-specialties-grid>
			{specialties.map((specialty) => (
				<article
					class="specialties-card group cursor-pointer relative overflow-hidden"
					data-specialty-card
					data-specialty-id={specialty.id_specialty}
					tabindex="0"
					role="button"
					aria-label={`Editar especialidad ${specialty.name || specialty.id_specialty}`}
				>
					<div class="relative flex items-start justify-between gap-4">
						<div class="specialties-card-icon">
							<span class="material-symbols-rounded text-[1.25rem]">{SPECIALTY_ICON}</span>
						</div>

						<span
							class:list={[
								'specialties-card-status',
								specialty.is_active === 1
									? 'specialties-card-status--active'
									: 'specialties-card-status--inactive',
							]}
						>
							<span
								class:list={[
									'size-1.5 rounded-full',
									specialty.is_active === 1
										? 'specialties-summary-dot--active'
										: 'specialties-summary-dot--inactive',
								]}
							></span>
							{specialty.is_active === 1 ? 'Activa' : 'Inactiva'}
						</span>
					</div>

					<div class="specialties-card-body">
						<div>
							<h3 class="specialties-card-title line-clamp-1">
								{specialty.name || `Especialidad #${specialty.id_specialty}`}
							</h3>
							<p class="mt-1 text-[0.9rem] text-(--on-surface-variant) line-clamp-2 leading-relaxed">
								{toDescriptionLabel(specialty.description)}
							</p>
						</div>
					</div>
				</article>
			))}
		</div>
	)}
	</div>
</section>

<style is:global>
	.specialties-view {
		display: grid;
		gap: 1.2rem;
	}

	.specialties-summary-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border-radius: 999px;
		border: 0;
		padding: 0.33rem 0.78rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.01em;
	}

	.specialties-summary-pill--active {
		background: rgba(16, 185, 129, 0.12);
		color: #0f6d4a;
	}

	.specialties-summary-pill--inactive {
		background: rgba(244, 63, 94, 0.11);
		color: #8d3e4a;
	}

	.specialties-summary-dot {
		display: inline-block;
	}

	.specialties-summary-dot--active {
		background: #22c55e;
	}

	.specialties-summary-dot--inactive {
		background: #fb7185;
	}

	.specialties-create-btn {
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--primary) 72%, #123e7a 28%);
		background: var(--primary);
		padding: 0.72rem 1.15rem;
		font-size: 0.92rem;
		font-weight: 780;
		color: #f8fbff;
		box-shadow: none;
		transition: filter 140ms ease, border-color 140ms ease;
	}

	.specialties-create-btn-icon {
		flex-shrink: 0;
	}

	.specialties-create-btn:hover {
		filter: brightness(1.04);
	}

	.specialties-create-btn:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
		outline-offset: 3px;
	}

	.specialties-create-fab {
		display: none;
	}

	@media (max-width: 639px) {
		.specialties-create-fab {
			position: fixed;
			right: max(1rem, env(safe-area-inset-right, 0px));
			bottom: calc(5.15rem + env(safe-area-inset-bottom, 0px));
			z-index: 44;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 3.5rem;
			height: 3.5rem;
			padding: 0;
			border: 0;
			border-radius: 999px;
			color: #f8fbff;
			background: var(--primary);
			box-shadow:
				0 6px 18px color-mix(in srgb, var(--primary) 38%, transparent),
				0 1px 3px rgba(15, 23, 42, 0.12);
			cursor: pointer;
			-webkit-tap-highlight-color: transparent;
			transition: transform 140ms ease, box-shadow 140ms ease, filter 140ms ease;
		}

		.specialties-create-fab-icon {
			width: 1.35rem;
			height: 1.35rem;
			flex-shrink: 0;
		}

		.specialties-create-fab:hover {
			filter: brightness(1.04);
			box-shadow:
				0 8px 22px color-mix(in srgb, var(--primary) 44%, transparent),
				0 1px 3px rgba(15, 23, 42, 0.14);
		}

		.specialties-create-fab:active {
			transform: scale(0.96);
		}

		.specialties-create-fab:focus-visible {
			outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
			outline-offset: 3px;
		}
	}

	.specialties-empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 1.35rem;
		border: 1px solid rgba(148, 163, 184, 0.24);
		background: color-mix(in srgb, var(--surface-container-low) 72%, var(--surface-bright) 28%);
		padding: 2.5rem 1.25rem;
		text-align: center;
	}

	.specialties-empty-icon {
		margin-bottom: 1rem;
		display: flex;
		height: 4rem;
		width: 4rem;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container) 88%, var(--surface-bright) 12%);
		color: var(--on-surface-variant);
	}

	.specialties-card {
		cursor: pointer;
	}

	.specialties-card-status {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border-radius: 999px;
		border: 0;
		padding: 0.24rem 0.6rem;
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.specialties-card-status--active {
		background: rgba(16, 185, 129, 0.12);
		color: #0f6d4a;
	}

	.specialties-card-status--inactive {
		background: rgba(244, 63, 94, 0.11);
		color: #8d3e4a;
	}

	html[data-theme='dark'] .specialties-summary-pill--active {
		background: rgba(110, 231, 183, 0.16);
		color: #b8f5d5;
	}

	html[data-theme='dark'] .specialties-summary-pill--inactive {
		background: rgba(255, 182, 193, 0.12);
		color: #ffc8d2;
	}

	html[data-theme='dark'] .specialties-create-btn {
		border-color: color-mix(in srgb, var(--primary) 58%, #131314 42%);
		background: color-mix(in srgb, var(--primary) 78%, #131314 22%);
	}

	html[data-theme='dark'] .specialties-create-btn:hover {
		filter: brightness(1.08);
	}

	@media (max-width: 639px) {
		html[data-theme='dark'] .specialties-create-fab {
			background: color-mix(in srgb, var(--primary) 78%, #131314 22%);
		}

		html[data-theme='dark'] .specialties-create-fab:hover {
			filter: brightness(1.08);
		}
	}

	html[data-theme='dark'] .specialties-empty-state {
		border-color: rgba(255, 255, 255, 0.08);
		background: color-mix(
			in srgb,
			var(--surface-container-low, #1e1f22) 82%,
			var(--surface-container, #131314) 18%
		);
	}


	html[data-theme='dark'] .specialties-card-status--active {
		background: rgba(110, 231, 183, 0.16);
		color: #b8f5d5;
	}

	html[data-theme='dark'] .specialties-card-status--inactive {
		background: rgba(255, 182, 193, 0.12);
		color: #ffc8d2;
	}
</style>

<script>
	import { initSpecialtiesListControls } from '../scripts/specialties-list-controls';

	initSpecialtiesListControls();
</script>
