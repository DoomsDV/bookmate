---
import { canAccessPath } from "../config/roles";
import OrgSwitcherModal from "./OrgSwitcherModal.astro";
import MobileBottomNav from "./MobileBottomNav.astro";

interface NavItem {
	label: string;
	href: string;
	icon?: string;
	active?: boolean;
	/** Si true, muestra badge de pendientes (Cobros). */
	pendingBadge?: boolean;
	/** Gate de entitlement en cliente. */
	requiresFeature?: string;
}

interface Props {
	currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const normalizePath = (path: string) => {
	if (!path || path === "/") return "/";
	return path.endsWith("/") ? path.slice(0, -1) : path;
};

const cachedOrganizationName = String(
	Astro.locals.organizationName || Astro.cookies.get("org_name")?.value || "",
).trim();
const cachedOrganizationLogoUrl = String(
	Astro.locals.organizationLogoUrl || Astro.cookies.get("org_logo_url")?.value || "",
).trim();
const workspaceName = cachedOrganizationName || "Workspace";
const workspaceInitial = workspaceName.charAt(0).toUpperCase();
const workspaceLogoUrl = cachedOrganizationLogoUrl;
const currentOrgMemberId = Number(Astro.locals.userId ?? 0);

const activePath = normalizePath(currentPath);
const currentRoleId = Number(Astro.locals.roleId ?? 0);

const isItemActive = (item: NavItem) => {
	if (typeof item.active === "boolean") return item.active;
	if (!item.href.startsWith("/")) return false;
	return normalizePath(item.href) === activePath;
};

/** Rutas con shell SSR liviano (datos en cliente). Prefetch al tap/click, no en viewport.
 *  /panel/plan NO entra: es SSR pesado (4 llamadas ORDS) y usa data-astro-reload. */
const prefetchTapPaths = new Set([
	"/panel/dashboard",
	"/panel/calendar",
	"/panel/customers",
	"/panel/cobros",
	"/panel/ajustes",
	"/panel/services",
	"/panel/locations",
	"/panel/perfil-publico",
	"/panel/specialties",
	"/panel/professionals",
	"/panel/complementos",
]);

const getPrefetchMode = (item: NavItem) =>
	prefetchTapPaths.has(normalizePath(item.href)) ? "tap" : undefined;

const primaryItems: NavItem[] = [
	{ label: "Dashboard", icon: "home", href: "/panel/dashboard" },
	{ label: "Calendario", icon: "calendar_month", href: "/panel/calendar" },
	{ label: "Clientes", icon: "group", href: "/panel/customers" },
	{
		label: "Cobros",
		icon: "payments",
		href: "/panel/cobros",
		pendingBadge: true,
		requiresFeature: "DEPOSIT_COLLECTION",
	},
	{ label: "Servicios", icon: "inventory_2", href: "/panel/services" },
	{ label: "Sucursales", icon: "storefront", href: "/panel/locations" },
	{ label: "Perfil Público", icon: "public", href: "/panel/perfil-publico" },
	{ label: "Complementos", icon: "extension", href: "/panel/complementos" },
];

const teamItems: NavItem[] = [
	{ label: "Especialidades", icon: "category", href: "/panel/specialties" },
	{ label: "Personal", icon: "badge", href: "/panel/professionals" },
	{ label: "Horarios", icon: "schedule", href: "/panel/schedules" },
];

const visiblePrimaryItems = primaryItems.filter((item) =>
	canAccessPath(item.href, currentRoleId),
);
const visibleTeamItems = teamItems.filter((item) =>
	canAccessPath(item.href, currentRoleId),
);
/** Ya visibles en MobileBottomNav: no repetir en el sheet «Más». */
const mobileSheetExcludedPaths = new Set([
	"/panel/dashboard",
	"/panel/calendar",
	"/panel/customers",
	"/panel/cobros",
]);
const mobileSheetPrimaryItems = visiblePrimaryItems.filter(
	(item) => !mobileSheetExcludedPaths.has(normalizePath(item.href)),
);
---

{/* Sync inmediato del shell (antes del paint del sidebar) — solo desktop */}
<script is:inline>
	(function () {
		try {
			if (!window.matchMedia('(min-width: 1024px)').matches) return;
			var stored = localStorage.getItem('hasel-sidebar-state');
			if (stored !== 'collapsed' && stored !== 'expanded') return;
			var shell =
				(document.currentScript && document.currentScript.closest('[data-app-shell]')) ||
				document.querySelector('[data-app-shell]');
			if (shell) shell.setAttribute('data-sidebar-state', stored);
			document.documentElement.setAttribute('data-sidebar-pref', stored);
		} catch (e) {}
	})();
</script>

{/* Animación de entrada solo en la primera visita de la sesión */}
<script is:inline>
	(function () {
		try {
			var key = 'hasel-sidenav-shown';
			var sidebar = document.querySelector('[data-desktop-sidebar]');
			if (!sidebar) return;
			if (!sessionStorage.getItem(key)) {
				sidebar.classList.add('is-first-visit');
				sessionStorage.setItem(key, '1');
				sidebar.addEventListener('animationend', function handler() {
					sidebar.classList.remove('is-first-visit');
					sidebar.removeEventListener('animationend', handler);
				});
			}
		} catch (e) {}
	})();
</script>

	<div
		class="pointer-events-none fixed inset-0 z-50 flex items-end justify-center lg:hidden"
		data-side-nav-shell
	>
	<div
		class="absolute inset-0 bg-black/55 opacity-0 backdrop-blur-[2px]"
		data-side-nav-backdrop
	>
	</div>

	<aside
		id="app-side-nav"
		class="more-sheet relative flex h-auto max-h-[min(90dvh,52rem)] w-full translate-y-full flex-col overflow-hidden rounded-t-[1.5rem] border border-b-0 border-(--shell-border) bg-(--sidebar-surface) shadow-[0_-20px_60px_rgba(0,0,0,0.45)]"
		data-side-nav
		role="dialog"
		aria-modal="true"
		aria-label="Más opciones"
	>
		<div class="more-sheet__handle" aria-hidden="true"></div>

		<div class="more-sheet__header shrink-0 px-4 pt-1 pb-3 sm:px-5">
			<button
				type="button"
				class="more-sheet__org sidebar-account-row sidebar-account-trigger w-full min-w-0"
				data-org-switcher-trigger
				aria-haspopup="dialog"
				aria-label={`Organización actual: ${workspaceName}. Cambiar organización`}
			>
				<div
					class:list={[
						"more-sheet__org-avatar workspace-avatar flex size-11 shrink-0 items-center justify-center overflow-hidden rounded-2xl text-base font-bold",
						workspaceLogoUrl ? "workspace-avatar--has-logo" : "workspace-avatar--empty",
					]}
					data-workspace-avatar
				>
					<span class="workspace-logo-placeholder" aria-hidden="true">
						<span class="material-symbols-rounded">storefront</span>
					</span>
					{
						workspaceLogoUrl ? (
							<img
								src={workspaceLogoUrl}
								alt=""
								class="workspace-logo-image size-full object-cover"
								loading="eager"
								onerror="this.classList.add('is-hidden'); this.removeAttribute('src');"
							/>
						) : null
					}
				</div>
				<div class="sidebar-account-meta min-w-0" data-sidebar-brand-text>
					<p class="workspace-account-name truncate text-[1rem] leading-snug font-bold">
						{workspaceName}
					</p>
				</div>
				<span class="material-symbols-rounded more-sheet__org-chevron" aria-hidden="true">
					unfold_more
				</span>
			</button>
		</div>

		<div class="more-sheet__body flex min-h-0 flex-1 flex-col px-3 pb-[max(1rem,env(safe-area-inset-bottom))] sm:px-4">
			<nav aria-label="Más opciones" class="more-sheet__nav min-h-0 flex-1 overflow-y-auto overscroll-contain">
				<ul class="more-sheet__list">
					<li class="more-sheet__heading" aria-hidden="true">
						<p class="more-sheet__section">Menú</p>
					</li>
					{
						mobileSheetPrimaryItems.map((item) => (
							<li
								class="more-sheet__item"
								data-requires-feature={item.requiresFeature || undefined}
							>
								<a
									href={item.href}
									data-astro-prefetch={getPrefetchMode(item)}
									class:list={[
										"more-sheet__link",
										isItemActive(item) && "is-active",
									]}
									data-side-nav-close
								>
									<span class="material-symbols-rounded more-sheet__icon" aria-hidden="true">
										{item.icon}
									</span>
									<span class="more-sheet__label">
										<span class="truncate">{item.label}</span>
										{item.pendingBadge ? (
											<span
												class="hidden min-w-5 items-center justify-center rounded-full bg-rose-600 px-1.5 py-0.5 text-[0.68rem] font-extrabold leading-none text-white"
												data-cobros-nav-badge
												aria-label="Pendientes de revisión"
											></span>
										) : null}
									</span>
								</a>
							</li>
						))
					}

					<li class="more-sheet__item">
						<a
							href="/panel/ajustes"
							class:list={["more-sheet__link", activePath === "/panel/ajustes" && "is-active"]}
							data-side-nav-close
							data-astro-prefetch="tap"
						>
							<span class="material-symbols-rounded more-sheet__icon" aria-hidden="true">
								settings
							</span>
							<span class="more-sheet__label">
								<span>Ajustes</span>
							</span>
						</a>
					</li>

					{
						visibleTeamItems.length > 0 && (
							<>
								<li class="more-sheet__heading more-sheet__heading--team" aria-hidden="true">
									<p class="more-sheet__section">Equipo</p>
								</li>
								{visibleTeamItems.map((item) => (
									<li class="more-sheet__item">
										<a
											href={item.href}
											data-astro-prefetch={getPrefetchMode(item)}
											class:list={[
												"more-sheet__link",
												isItemActive(item) && "is-active",
											]}
											data-side-nav-close
										>
											<span class="material-symbols-rounded more-sheet__icon" aria-hidden="true">
												{item.icon}
											</span>
											<span class="more-sheet__label">
												<span class="truncate">{item.label}</span>
											</span>
										</a>
									</li>
								))}
							</>
						)
					}
				</ul>
			</nav>

			<div class="more-sheet__divider" role="presentation" aria-hidden="true"></div>

			<div class="more-sheet__footer shrink-0 pt-2">
				<form
					method="post"
					action="/api/auth/logout"
					enctype="application/x-www-form-urlencoded"
					data-astro-reload
					data-logout-form
				>
					<input type="hidden" name="fcm_token" value="" data-logout-fcm-token />
					<button type="submit" class="more-sheet__logout">
						<span class="material-symbols-rounded text-[1.2rem]" aria-hidden="true">logout</span>
						Cerrar sesión
					</button>
				</form>
			</div>
		</div>
	</aside>
</div>

<aside
	class="hidden h-full min-h-0 w-full flex-col overflow-hidden border-r border-(--shell-border) bg-(--sidebar-surface) lg:flex"
	data-desktop-sidebar
>
	<div
		class="shell-header-zone sidebar-account-header flex shrink-0 items-center px-6"
		data-sidebar-brand-block
	>
		<button
			type="button"
			class="sidebar-account-row sidebar-account-trigger w-full min-w-0"
			data-org-switcher-trigger
			data-sidebar-brand
			aria-haspopup="dialog"
			aria-label={`Organización actual: ${workspaceName}. Cambiar organización`}
		>
			<div
				class:list={[
					"workspace-avatar flex size-11 shrink-0 items-center justify-center overflow-hidden rounded-full text-base font-bold",
					workspaceLogoUrl ? "workspace-avatar--has-logo" : "workspace-avatar--empty",
				]}
				data-workspace-avatar
			>
				<span class="workspace-logo-placeholder" aria-hidden="true">
					<span class="material-symbols-rounded">storefront</span>
				</span>
				{
					workspaceLogoUrl ? (
						<img
							src={workspaceLogoUrl}
							alt=""
							class="workspace-logo-image size-full object-cover"
							loading="eager"
							onerror="this.classList.add('is-hidden'); this.removeAttribute('src');"
						/>
					) : null
				}
			</div>
			<div class="sidebar-account-meta min-w-0" data-sidebar-brand-text>
				<div class="sidebar-account-title-row min-w-0">
					<p
						class="workspace-account-name text-[1.02rem] font-bold leading-snug lg:text-[0.95rem]"
						data-sidebar-title
					>
						{workspaceName}
					</p>
				</div>
			</div>
			<span class="material-symbols-rounded sidebar-account-chevron" aria-hidden="true">
				unfold_more
			</span>
		</button>
	</div>

	<div class="sidebar-divider shrink-0" role="presentation" aria-hidden="true"></div>

	<div
		class="flex min-h-0 flex-1 flex-col overscroll-contain px-6 pb-7"
		data-sidebar-desktop-inner
	>
		<nav aria-label="Side navigation desktop">
			<ul class="space-y-2">
				<li class="sidebar-nav-heading" aria-hidden="true">
					<p class="sidebar-nav-section">Menú</p>
				</li>
				{
					visiblePrimaryItems.map((item) => (
						<li data-requires-feature={item.requiresFeature || undefined}>
							<a
								href={item.href}
								data-astro-prefetch={getPrefetchMode(item)}
								data-sidebar-item
								class:list={[
									"sidebar-nav-link flex items-center gap-3 rounded-full px-4 py-2.5 text-[0.9rem] font-medium no-underline transition",
									isItemActive(item)
										? "is-active bg-(--primary-container) text-(--primary)"
										: "text-(--sidebar-nav) hover:bg-(--sidebar-hover)",
								]}
							>
								<span class="sidebar-nav-icon material-symbols-rounded shrink-0 text-[1.25rem] leading-none">
									{item.icon}
								</span>
								<span class="sidebar-nav-label flex min-w-0 flex-1 items-center justify-between gap-2" data-sidebar-label>
									<span class="truncate">{item.label}</span>
									{item.pendingBadge ? (
										<span
											class="hidden min-w-5 items-center justify-center rounded-full bg-rose-600 px-1.5 py-0.5 text-[0.68rem] font-extrabold leading-none text-white"
											data-cobros-nav-badge
											aria-label="Pendientes de revisión"
										></span>
									) : null}
								</span>
							</a>
						</li>
					))
				}

				{
					visibleTeamItems.length > 0 && (
						<>
							<li class="sidebar-nav-heading sidebar-nav-heading--team" aria-hidden="true">
								<p class="sidebar-nav-section">Equipo</p>
							</li>
							{visibleTeamItems.map((item) => (
								<li>
									<a
										href={item.href}
										data-sidebar-item
										data-astro-prefetch={getPrefetchMode(item)}
										class:list={[
											"sidebar-nav-link flex items-center gap-3 rounded-full px-4 py-2.5 text-[0.9rem] font-medium no-underline transition",
											isItemActive(item)
												? "is-active bg-(--primary-container) text-(--primary)"
												: "text-(--sidebar-nav) hover:bg-(--sidebar-hover)",
										]}
									>
										<span class="sidebar-nav-icon material-symbols-rounded shrink-0 text-[1.25rem] leading-none">
											{item.icon}
										</span>
										<span class="sidebar-nav-label flex min-w-0 flex-1 items-center justify-between gap-2" data-sidebar-label>
											<span class="truncate">{item.label}</span>
										</span>
									</a>
								</li>
							))}
						</>
					)
				}
			</ul>
		</nav>

	</div>
</aside>

<OrgSwitcherModal currentOrgMemberId={currentOrgMemberId} />
<MobileBottomNav currentPath={currentPath} />

<style>
	/* Neoxa: texto gray-700 / ícono gray-500. Dark: gray-300 / gray-400. */
	[data-desktop-sidebar],
	.more-sheet {
		--sidebar-nav: #374151;
		--sidebar-nav-icon: #6b7280;
	}

	:global(html[data-theme='dark']) [data-desktop-sidebar],
	:global(html[data-theme='dark']) .more-sheet {
		--sidebar-nav: #d1d5db;
		--sidebar-nav-icon: #9ca3af;
	}

	/* Entrada del SideNav en PC: slide solo en la primera visita de la sesión. */
	@media (min-width: 1024px) {
		[data-desktop-sidebar].is-first-visit {
			animation: sidenav-slide-in 320ms cubic-bezier(0.2, 0, 0, 1) both;
			will-change: transform, opacity;
		}

		@media (prefers-reduced-motion: reduce) {
			[data-desktop-sidebar].is-first-visit {
				animation: none;
			}
		}
	}

	@keyframes sidenav-slide-in {
		from {
			opacity: 0;
			transform: translateX(-100%);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	.more-sheet__handle {
		margin: 0.65rem auto 0;
		width: 2.5rem;
		height: 0.28rem;
		flex-shrink: 0;
		border-radius: 999px;
		background: color-mix(in srgb, var(--on-surface-variant) 42%, transparent);
	}

	.more-sheet__header {
		padding-top: 0.15rem;
	}

	.more-sheet__org.sidebar-account-trigger {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.7rem 0.85rem;
		border-radius: 1rem;
		border: 1px solid color-mix(in srgb, var(--shell-border) 90%, transparent);
		background: color-mix(in srgb, var(--surface-container, var(--control-surface)) 72%, transparent);
	}

	.more-sheet__org.sidebar-account-trigger:hover {
		background: color-mix(in srgb, var(--on-surface) 6%, var(--surface-container, var(--control-surface)));
	}

	.more-sheet__org-avatar.workspace-avatar {
		border-radius: 0.85rem;
	}

	.more-sheet__org-chevron {
		margin-left: auto;
		flex-shrink: 0;
		font-size: 1.2rem;
		line-height: 1;
		color: var(--on-surface-variant);
	}

	.more-sheet__body {
		gap: 0;
	}

	.more-sheet__nav {
		margin-top: 0.15rem;
		padding-inline: 0.2rem;
		scrollbar-width: thin;
	}

	.more-sheet__list {
		display: flex;
		flex-direction: column;
		gap: 0.12rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.more-sheet__heading {
		list-style: none;
		margin: 0;
		padding: 0.55rem 0.8rem 0.2rem 0;
	}

	.more-sheet__heading--team {
		margin-top: 0.65rem;
	}

	.more-sheet__section,
	.sidebar-nav-section {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-transform: uppercase;
		color: #6b7280;
	}

	:global(html[data-theme='dark']) .more-sheet__section,
	:global(html[data-theme='dark']) .sidebar-nav-section {
		color: #9ca3af;
	}

	.sidebar-nav-heading {
		list-style: none;
		margin: 0;
		padding: 0.35rem 0 0.4rem;
	}

	.sidebar-nav-heading--team {
		padding-top: 1.15rem;
	}

	.more-sheet__link,
	.more-sheet__sublink {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		min-height: 3rem;
		padding: 0.65rem 0.8rem;
		margin: 0;
		border: 0;
		border-radius: 0.85rem;
		background: transparent;
		color: var(--sidebar-nav);
		font: inherit;
		font-size: 0.94rem;
		font-weight: 500;
		line-height: 1.25;
		text-decoration: none;
		cursor: pointer;
		transition:
			background-color 0.16s ease,
			color 0.16s ease;
	}

	.more-sheet__link:hover,
	.more-sheet__sublink:hover {
		background: color-mix(in srgb, var(--on-surface) 5%, transparent);
	}

	.more-sheet__link.is-active,
	.more-sheet__sublink.is-active {
		background: color-mix(in srgb, var(--primary) 16%, transparent);
		color: var(--primary);
		font-weight: 500;
	}

	.more-sheet__icon {
		display: inline-flex;
		width: 1.35rem;
		height: 1.35rem;
		align-items: center;
		justify-content: center;
		font-size: 1.28rem;
		line-height: 1;
		font-weight: 300;
		color: var(--sidebar-nav-icon);
		font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
	}

	.more-sheet__link.is-active .more-sheet__icon {
		color: var(--primary);
	}

	.more-sheet__label {
		display: flex;
		min-width: 0;
		flex: 1;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.more-sheet__chevron {
		font-size: 1.2rem;
		line-height: 1;
		color: color-mix(in srgb, var(--on-surface-variant) 80%, transparent);
		flex-shrink: 0;
	}


	.more-sheet__divider {
		margin: 0.65rem 0.35rem 0;
		height: 0;
		border: 0;
		border-top: 1px solid color-mix(in srgb, var(--shell-border) 85%, transparent);
	}

	.more-sheet__footer {
		padding-inline: 0.2rem;
	}

	.more-sheet__logout {
		display: flex;
		width: 100%;
		min-height: 2.85rem;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 0.35rem;
		border: 0;
		border-radius: 0.85rem;
		background: transparent;
		padding: 0.6rem 0.75rem;
		font: inherit;
		font-size: 0.92rem;
		font-weight: 700;
		color: #ef4444;
		cursor: pointer;
		transition: background-color 0.16s ease;
	}

	.more-sheet__logout:hover {
		background: color-mix(in srgb, #ef4444 10%, transparent);
	}

	:global(html[data-theme='dark']) .more-sheet {
		background: #1a1a1a;
		border-color: rgba(255, 255, 255, 0.08);
		box-shadow: 0 -24px 64px rgba(0, 0, 0, 0.55);
	}

	:global(html[data-theme='dark']) .more-sheet__org.sidebar-account-trigger {
		background: rgba(255, 255, 255, 0.04);
		border-color: rgba(255, 255, 255, 0.08);
	}

	:global(html[data-theme='dark']) .more-sheet__org.sidebar-account-trigger:hover {
		background: rgba(255, 255, 255, 0.06);
	}

