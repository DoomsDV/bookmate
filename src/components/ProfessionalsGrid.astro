---
import { parseParaguayMobilePhone } from '../lib/paraguay-phone';
import { getProfessionalDisplayName, isProfessionalAccountActive, type Professional } from '../lib/professionals';

interface Props {
	professionals: Professional[];
	showCreateAction?: boolean;
	searchQuery?: string;
	isActiveFilter?: number | null;
	totalRecords?: number;
}

const {
	professionals = [],
	showCreateAction = false,
	searchQuery = '',
	isActiveFilter = null,
	totalRecords = 0,
} = Astro.props;
const hasSearch = Boolean(searchQuery);
const hasStatusFilter = isActiveFilter === 0 || isActiveFilter === 1;
const hasFilters = hasSearch || hasStatusFilter;

const PROFESSIONAL_ICON = 'badge';

const toDisplayName = (professional: Professional) => getProfessionalDisplayName(professional);

const toContactEmail = (professional: Professional) => {
	return String(professional.user.email || '').trim() || '—';
};

const toSpecialtyName = (professional: Professional) => {
	return professional.specialty?.name || 'Sin especialidad';
};

const toProfileImageUrl = (professional: Professional) => {
	return String(professional.profile_image_url || '').trim();
};

const toPhoneLabel = (value?: string | null) => {
	const raw = String(value || '').trim();
	if (!raw) return '—';
	const parsed = parseParaguayMobilePhone(raw);
	return parsed.isValid ? parsed.pretty : raw;
};

const cardItems = professionals.map((professional) => ({
	professional,
	profileImageUrl: toProfileImageUrl(professional),
}));
---

<section class="professionals-view">
	<header class="mb-0 lg:mb-4 flex flex-wrap items-center justify-between gap-2 lg:gap-3">
		<div class="page-title-row flex flex-wrap items-center gap-2 lg:gap-3 min-w-0">
			<h2 class="m-0 text-[1.5rem] sm:text-[1.75rem] font-bold tracking-tight text-(--on-surface) leading-none">
				Personal{' '}
				<span class="font-semibold text-(--on-surface-variant)" data-professionals-summary>
					({totalRecords})
				</span>
			</h2>
		</div>

		<div class="panel-page-header__actions flex flex-wrap items-center justify-end gap-2 shrink-0">
			{showCreateAction && (
				<button
					type="button"
					class="professionals-create-btn hidden sm:inline-flex items-center justify-center gap-2"
					data-open-professional-modal
				>
					<svg class="professionals-create-btn-icon w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
					</svg>
					<span>Nuevo Personal</span>
				</button>
			)}
		</div>
	</header>

	{showCreateAction && (
		<button
			type="button"
			class="professionals-create-fab"
			data-open-professional-modal
			aria-label="Nuevo Personal"
			title="Nuevo Personal"
		>
			<svg
				class="professionals-create-fab-icon"
				viewBox="0 0 24 24"
				fill="none"
				aria-hidden="true"
			>
				<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
			</svg>
		</button>
	)}

	<div class="professionals-search">
		<div class="professionals-search__well" data-panel-search>
			<div class="professionals-search__core">
				<span class="professionals-search__icon" aria-hidden="true">
					<span class="material-symbols-rounded">search</span>
				</span>
				<input
					type="text"
					inputmode="search"
					enterkeyhint="search"
					data-professionals-search
					placeholder="Buscar por nombre, email o teléfono"
					aria-label="Buscar por nombre, email o teléfono"
					autocomplete="off"
					value={searchQuery}
					class="professionals-search__input"
				/>
				<button
					type="button"
					class="panel-search-clear professionals-search__clear"
					data-panel-search-clear
					hidden={String(searchQuery || '').length === 0}
					aria-label="Limpiar búsqueda"
				>
					<span class="material-symbols-rounded" aria-hidden="true">close</span>
				</button>
			</div>
		</div>

		<button
			type="button"
			class:list={[
				'professionals-search__filter panel-status-filter-btn',
				hasStatusFilter && 'is-active',
			]}
			data-open-professionals-status-filter
			aria-label="Filtrar por estado"
			aria-haspopup="dialog"
			aria-controls="professionals-status-filter-sheet"
			aria-pressed={hasStatusFilter ? 'true' : 'false'}
		>
			<span class="professionals-search__filter-icon" aria-hidden="true">
				<span class="material-symbols-rounded">tune</span>
			</span>
			{hasStatusFilter && (
				<span class="panel-status-filter-badge" data-professionals-status-filter-badge aria-hidden="true"></span>
			)}
		</button>
	</div>

	<dialog
		id="professionals-status-filter-sheet"
		class="panel-status-filter-sheet"
		data-professionals-status-filter-sheet
		aria-labelledby="professionals-status-filter-title"
	>
		<div class="panel-status-filter-sheet__handle" aria-hidden="true">
			<span></span>
		</div>
		<div class="panel-status-filter-sheet__header">
			<h2 id="professionals-status-filter-title" class="m-0 text-[1.05rem] font-extrabold tracking-tight">
				Filtros
			</h2>
			<button
				type="button"
				class="flex size-9 shrink-0 items-center justify-center rounded-full text-(--on-surface-variant) transition-colors hover:bg-(--surface-variant) hover:text-(--on-surface)"
				data-close-professionals-status-filter
				aria-label="Cerrar filtro"
			>
				<span class="material-symbols-rounded text-[1.3rem]">close</span>
			</button>
		</div>
		<div class="panel-status-filter-sheet__list" role="listbox" aria-label="Estado del personal">
			<button
				type="button"
				class:list={['panel-status-filter-option', !hasStatusFilter && 'is-selected']}
				data-professionals-status-option
				data-value=""
				role="option"
				aria-selected={!hasStatusFilter ? 'true' : 'false'}
			>
				<span>Todos</span>
				<span class="material-symbols-rounded">check</span>
			</button>
			<button
				type="button"
				class:list={['panel-status-filter-option', isActiveFilter === 1 && 'is-selected']}
				data-professionals-status-option
				data-value="1"
				role="option"
				aria-selected={isActiveFilter === 1 ? 'true' : 'false'}
			>
				<span>Activos</span>
				<span class="material-symbols-rounded">check</span>
			</button>
			<button
				type="button"
				class:list={['panel-status-filter-option', isActiveFilter === 0 && 'is-selected']}
				data-professionals-status-option
				data-value="0"
				role="option"
				aria-selected={isActiveFilter === 0 ? 'true' : 'false'}
			>
				<span>Inactivos</span>
				<span class="material-symbols-rounded">check</span>
			</button>
		</div>
	</dialog>

	<div data-professionals-results>
	{professionals.length === 0 ? (
		<div class="professionals-empty-state" data-professionals-empty>
			<div class="professionals-empty-icon">
				<span class="material-symbols-rounded text-[2rem]">{hasFilters ? 'search_off' : 'badge'}</span>
			</div>
			<h3 class="text-[1.1rem] font-bold text-(--on-surface)">
				{hasFilters ? 'No se encontraron profesionales' : 'No hay profesionales registrados'}
			</h3>
			<p class="mt-1.5 max-w-sm text-[0.95rem] leading-relaxed text-(--on-surface-variant)">
				{hasSearch
					? 'Probá con otro nombre, email o teléfono.'
					: hasStatusFilter
						? 'No hay profesionales con ese estado.'
						: 'Aún no has agregado a ningún profesional a esta organización. Comienza creando tu primer registro de personal.'}
			</p>
		</div>
	) : (
		<div class="material-cards-grid gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3" data-professionals-grid>
			{cardItems.map((item) => (
				<article
					class:list={[
						'professionals-card group',
						item.professional.membership_status === 'pending_invite' && 'professionals-card--pending',
						item.professional.membership_status !== 'pending_invite' &&
							!isProfessionalAccountActive(item.professional) &&
							'professionals-card--inactive',
					]}
					data-professional-card
					data-professional-id={item.professional.id_professional}
					tabindex="0"
					role="button"
					aria-label={`Editar personal ${toDisplayName(item.professional)}`}
				>
					<div class="professionals-card__inner">
						<div class="professionals-card__roster">
							<div
								class:list={[
									'professionals-card-avatar',
									!item.profileImageUrl && 'professionals-card-avatar--placeholder',
								]}
								data-professional-card-avatar
							>
								{item.profileImageUrl ? (
									<img
										src={item.profileImageUrl}
										alt={`Foto de perfil de ${toDisplayName(item.professional)}`}
										class="professionals-card-avatar-image"
										loading="lazy"
										decoding="async"
										onerror="this.classList.add('is-hidden'); this.parentElement?.classList.add('professionals-card-avatar--placeholder');"
									/>
								) : null}
								<span
									class:list={[
										'material-symbols-rounded professionals-card-avatar-icon',
										item.profileImageUrl && 'professionals-card-avatar-icon--fallback',
									]}
									aria-hidden="true"
								>
									{PROFESSIONAL_ICON}
								</span>
							</div>
							<div class="professionals-card-body">
								<div class="professionals-card__title-row">
									<h3 class="professionals-card-title line-clamp-1">
										{toDisplayName(item.professional)}
									</h3>
									<span
										class:list={[
											'professionals-card-status',
											item.professional.membership_status === 'pending_invite'
												? 'professionals-card-status--pending'
												: isProfessionalAccountActive(item.professional)
													? 'professionals-card-status--active'
													: 'professionals-card-status--inactive',
										]}
									>
										<span
											class:list={[
												'size-1.5 rounded-full',
												item.professional.membership_status === 'pending_invite'
													? 'professionals-summary-dot--pending'
													: isProfessionalAccountActive(item.professional)
														? 'professionals-summary-dot--active'
														: 'professionals-summary-dot--inactive',
											]}
										></span>
										{item.professional.membership_status === 'pending_invite'
											? 'Pendiente'
											: isProfessionalAccountActive(item.professional)
												? 'Activo'
												: 'Inactivo'}
									</span>
								</div>
								<p class="professionals-card__email line-clamp-1">
									{toContactEmail(item.professional)}
								</p>
							</div>
						</div>
						<div class="professionals-card__meta">
							<span class="professionals-card__craft line-clamp-1">
								{toSpecialtyName(item.professional)}
							</span>
							<span class="professionals-card__phone">
								{toPhoneLabel(item.professional.phone_number)}
							</span>
						</div>
					</div>
				</article>
			))}
		</div>
	)}
	</div>
</section>

<style is:global>
	.professionals-view {
		display: grid;
		gap: 0.75rem;
	}

	@media (min-width: 1024px) {
		.professionals-view {
			gap: 1.2rem;
		}
	}

	.professionals-search {
		--pros-search-ease: cubic-bezier(0.32, 0.72, 0, 1);
		display: flex;
		align-items: center;
		gap: 0.55rem;
		max-width: 36rem;
		width: 100%;
	}

	.professionals-search__well {
		position: relative;
		min-width: 0;
		flex: 1 1 auto;
		padding: 0.28rem;
		border-radius: 1.35rem;
		background: color-mix(in srgb, var(--on-surface) 5%, transparent);
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--on-surface) 7%, transparent);
		transition:
			box-shadow 520ms var(--pros-search-ease),
			background-color 520ms var(--pros-search-ease),
			transform 520ms var(--pros-search-ease);
	}

	.professionals-search__core {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.45rem;
		min-width: 0;
		padding: 0.22rem 0.28rem 0.22rem 0.22rem;
		border-radius: calc(1.35rem - 0.28rem);
		background: var(--surface-bright);
		box-shadow: inset 0 1px 0 color-mix(in srgb, #ffffff 55%, transparent);
	}

	.professionals-search__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.05rem;
		height: 2.05rem;
		flex-shrink: 0;
		border-radius: 999px;
		background: color-mix(in srgb, var(--on-surface) 5.5%, transparent);
		color: var(--on-surface-variant);
		transition:
			transform 520ms var(--pros-search-ease),
			color 520ms var(--pros-search-ease),
			background-color 520ms var(--pros-search-ease);
	}

	.professionals-search__icon .material-symbols-rounded {
		font-size: 1.15rem;
		line-height: 1;
		font-variation-settings: 'wght' 380, 'opsz' 20;
	}

	.professionals-search__input {
		min-width: 0;
		flex: 1 1 auto;
		height: 2.15rem;
		margin: 0;
		padding: 0 2.2rem 0 0.1rem;
		border: 0;
		background: transparent;
		color: var(--on-surface);
		font-size: 0.94rem;
		font-weight: 650;
		letter-spacing: -0.015em;
		outline: none;
		box-shadow: none;
	}

	.professionals-search__input::placeholder {
		color: color-mix(in srgb, var(--on-surface-variant) 72%, transparent);
		font-weight: 550;
	}

	.professionals-search__clear {
		right: 0.35rem;
	}

	.professionals-search__well:hover {
		background: color-mix(in srgb, var(--on-surface) 7%, transparent);
	}

	.professionals-search__well:focus-within {
		background: color-mix(in srgb, var(--primary) 10%, transparent);
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 38%, transparent);
	}

	.professionals-search__well:focus-within .professionals-search__icon {
		color: var(--primary);
		background: color-mix(in srgb, var(--primary) 12%, transparent);
		transform: scale(1.04);
	}

	.professionals-search__filter {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3.05rem;
		height: 3.05rem;
		flex-shrink: 0;
		padding: 0.28rem;
		border: 0;
		border-radius: 1.25rem;
		background: color-mix(in srgb, var(--on-surface) 5%, transparent);
		color: var(--on-surface-variant);
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--on-surface) 7%, transparent);
		cursor: pointer;
		transition:
			transform 520ms var(--pros-search-ease),
			background-color 520ms var(--pros-search-ease),
			box-shadow 520ms var(--pros-search-ease),
			color 520ms var(--pros-search-ease);
	}

	.professionals-search__filter-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		border-radius: calc(1.25rem - 0.28rem);
		background: var(--surface-bright);
		box-shadow: inset 0 1px 0 color-mix(in srgb, #ffffff 55%, transparent);
	}

	.professionals-search__filter-icon .material-symbols-rounded {
		font-size: 1.2rem;
		line-height: 1;
		font-variation-settings: 'wght' 380, 'opsz' 20;
	}

	.professionals-search__filter:hover {
		color: var(--on-surface);
		transform: scale(1.02);
	}

	.professionals-search__filter:active {
		transform: scale(0.97);
	}

	.professionals-search__filter:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 50%, transparent);
		outline-offset: 2px;
	}

	.professionals-search__filter.panel-status-filter-btn.is-active {
		color: var(--primary);
		background: color-mix(in srgb, var(--primary) 12%, transparent);
		border-color: transparent;
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 32%, transparent);
	}

	html[data-theme='dark'] .professionals-search__well,
	html[data-theme='dark'] .professionals-search__filter {
		background: rgba(255, 255, 255, 0.04);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.07);
	}

	html[data-theme='dark'] .professionals-search__core,
	html[data-theme='dark'] .professionals-search__filter-icon {
		background: color-mix(in srgb, var(--surface-container-high, #1c1d22) 92%, #0e1014 8%);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
	}

	html[data-theme='dark'] .professionals-search__well:focus-within,
	html[data-theme='dark'] .professionals-search__filter.is-active {
		background: color-mix(in srgb, var(--primary) 16%, transparent);
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 36%, transparent);
	}

	@media (prefers-reduced-motion: reduce) {
		.professionals-search__well,
		.professionals-search__icon,
		.professionals-search__filter {
			transition: none;
		}

		.professionals-search__well:focus-within .professionals-search__icon,
		.professionals-search__filter:hover,
		.professionals-search__filter:active {
			transform: none;
		}
	}

	.professionals-summary-dot {
		display: inline-block;
	}

	.professionals-summary-dot--active {
		background: #22c55e;
	}

	.professionals-summary-dot--inactive {
		background: #fb7185;
	}

	.professionals-create-btn {
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--primary) 72%, #123e7a 28%);
		background: var(--primary);
		padding: 0.72rem 1.15rem;
		font-size: 0.92rem;
		font-weight: 780;
		color: #f8fbff;
		box-shadow: none;
		transition: filter 140ms ease, border-color 140ms ease;
	}

	.professionals-create-btn-icon {
		flex-shrink: 0;
	}

	.professionals-create-btn:hover {
		filter: brightness(1.04);
	}

	.professionals-create-btn:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
		outline-offset: 3px;
	}

	.professionals-create-fab {
		display: none;
	}

	@media (max-width: 639px) {
		.professionals-create-fab {
			position: fixed;
			right: max(1rem, env(safe-area-inset-right, 0px));
			bottom: calc(5.15rem + env(safe-area-inset-bottom, 0px));
			z-index: 44;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 3.5rem;
			height: 3.5rem;
			padding: 0;
			border: 0;
			border-radius: 999px;
			color: #f8fbff;
			background: var(--primary);
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.28);
			cursor: pointer;
			-webkit-tap-highlight-color: transparent;
			transition: transform 140ms ease, box-shadow 140ms ease, filter 140ms ease;
		}

		.professionals-create-fab-icon {
			width: 1.35rem;
			height: 1.35rem;
			flex-shrink: 0;
		}

		.professionals-create-fab:hover {
			filter: brightness(1.04);
			box-shadow: 0 3px 10px rgba(0, 0, 0, 0.32);
		}

		.professionals-create-fab:active {
			transform: scale(0.96);
		}

		.professionals-create-fab:focus-visible {
			outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
			outline-offset: 3px;
		}
	}

	.professionals-empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 1.35rem;
		border: 1px solid rgba(148, 163, 184, 0.24);
		background: color-mix(in srgb, var(--surface-container-low) 72%, var(--surface-bright) 28%);
		padding: 2.5rem 1.25rem;
		text-align: center;
	}

	.professionals-empty-icon {
		margin-bottom: 1rem;
		display: flex;
		height: 4rem;
		width: 4rem;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container) 88%, var(--surface-bright) 12%);
		color: var(--on-surface-variant);
	}

	professional-manager .professionals-card {
		--professionals-ease: cubic-bezier(0.32, 0.72, 0, 1);
		cursor: pointer;
		gap: 0;
		padding: 0.28rem;
		border: 0;
		border-radius: 1.45rem;
		background: color-mix(in srgb, var(--on-surface) 4%, var(--surface-bright));
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--on-surface) 6%, transparent);
		overflow: visible;
		animation: professionals-card-enter 720ms var(--professionals-ease) both;
		transition:
			transform 420ms var(--professionals-ease),
			box-shadow 420ms var(--professionals-ease);
	}

	professional-manager .professionals-card:nth-child(1) { animation-delay: 0ms; }
	professional-manager .professionals-card:nth-child(2) { animation-delay: 50ms; }
	professional-manager .professionals-card:nth-child(3) { animation-delay: 100ms; }
	professional-manager .professionals-card:nth-child(4) { animation-delay: 150ms; }
	professional-manager .professionals-card:nth-child(n + 5) { animation-delay: 200ms; }

	@keyframes professionals-card-enter {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	professional-manager .professionals-card.panel-skeleton-card {
		animation: none;
	}

	professional-manager .professionals-card:hover {
		transform: none;
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--on-surface) 8%, transparent);
	}

	professional-manager .professionals-card__inner {
		display: grid;
		gap: 0.85rem;
		height: 100%;
		padding: 0.95rem 0.95rem 0.9rem;
		border-radius: calc(1.45rem - 0.28rem);
		background: var(--surface-bright);
