---
import { getProfessionalDisplayName, isProfessionalAccountActive, type Professional } from '../lib/professionals';

interface Props {
	professionals: Professional[];
	showCreateAction?: boolean;
	searchQuery?: string;
	isActiveFilter?: number | null;
	totalRecords?: number;
}

const {
	professionals = [],
	showCreateAction = false,
	searchQuery = '',
	isActiveFilter = null,
	totalRecords = 0,
} = Astro.props;
const hasSearch = Boolean(searchQuery);
const hasStatusFilter = isActiveFilter === 0 || isActiveFilter === 1;
const hasFilters = hasSearch || hasStatusFilter;

const PROFESSIONAL_ICON = 'badge';

const toDisplayName = (professional: Professional) => getProfessionalDisplayName(professional);

const toContactEmail = (professional: Professional) => {
	return String(professional.user.email || '').trim() || '—';
};

const toSpecialtyName = (professional: Professional) => {
	return professional.specialty?.name || 'Sin especialidad';
};

const toProfileImageUrl = (professional: Professional) => {
	return String(professional.profile_image_url || '').trim();
};

const cardItems = professionals.map((professional) => ({
	professional,
	profileImageUrl: toProfileImageUrl(professional),
}));

const activeCount = professionals.filter(
	(item) =>
		item.membership_status !== 'pending_invite' && isProfessionalAccountActive(item)
).length;
const inactiveCount = professionals.filter(
	(item) =>
		item.membership_status !== 'pending_invite' && !isProfessionalAccountActive(item)
).length;
---

<section class="professionals-view">
	<header class="mb-4 flex flex-wrap items-center justify-between gap-3">
		<h2 class="m-0 text-[1.5rem] sm:text-[1.75rem] font-bold tracking-tight text-(--on-surface) leading-none">
			Personal{' '}
			<span class="font-semibold text-(--on-surface-variant)" data-professionals-summary>
				({totalRecords})
			</span>
		</h2>

		<div class="flex flex-wrap items-center justify-end gap-2">
			<span class="professionals-summary-pill professionals-summary-pill--active">
				<span class="size-2 rounded-full professionals-summary-dot professionals-summary-dot--active"></span>
				Activos: <span data-professionals-active-count>{activeCount}</span>
			</span>
			<span
				class="professionals-summary-pill professionals-summary-pill--inactive"
				data-professionals-inactive-pill
				hidden={inactiveCount <= 0}
			>
				<span class="size-2 rounded-full professionals-summary-dot professionals-summary-dot--inactive"></span>
				Inactivos: <span data-professionals-inactive-count>{inactiveCount}</span>
			</span>

			{showCreateAction && (
				<button
					type="button"
					class="professionals-create-btn hidden sm:inline-flex items-center justify-center gap-2"
					data-open-professional-modal
				>
					<svg class="professionals-create-btn-icon w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
					</svg>
					<span>Nuevo Personal</span>
				</button>
			)}
		</div>
	</header>

	{showCreateAction && (
		<button
			type="button"
			class="professionals-create-fab"
			data-open-professional-modal
			aria-label="Nuevo Personal"
			title="Nuevo Personal"
		>
			<svg
				class="professionals-create-fab-icon"
				viewBox="0 0 24 24"
				fill="none"
				aria-hidden="true"
			>
				<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
			</svg>
		</button>
	)}

	<div class="flex max-w-xl items-center gap-2">
		<div class="relative min-w-0 flex-1" data-panel-search>
			<span
				class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-(--on-surface-variant)"
				aria-hidden="true"
			>
				<span class="material-symbols-rounded text-[1.2rem]">search</span>
			</span>
			<input
				type="text"
				inputmode="search"
				enterkeyhint="search"
				data-professionals-search
				placeholder="Buscar por nombre, email o teléfono"
				aria-label="Buscar por nombre, email o teléfono"
				autocomplete="off"
				value={searchQuery}
				class="w-full rounded-2xl border border-(--shell-border) bg-(--surface-bright) py-2.5 pl-11 pr-11 text-[0.95rem] font-semibold text-(--on-surface) outline-none transition placeholder:font-medium placeholder:text-(--on-surface-variant)/70 hover:border-(--on-surface-variant) focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10 shadow-sm"
			/>
			<button
				type="button"
				class="panel-search-clear"
				data-panel-search-clear
				hidden={String(searchQuery || '').length === 0}
				aria-label="Limpiar búsqueda"
			>
				<span class="material-symbols-rounded" aria-hidden="true">close</span>
			</button>
		</div>

		<button
			type="button"
			class:list={[
				'panel-status-filter-btn relative flex size-11 shrink-0 items-center justify-center rounded-2xl border border-(--shell-border) bg-(--surface-bright) text-(--on-surface-variant) shadow-sm transition hover:border-(--on-surface-variant) hover:text-(--on-surface) focus:border-(--primary) focus:outline-none focus:ring-4 focus:ring-(--primary)/10',
				hasStatusFilter && 'is-active',
			]}
			data-open-professionals-status-filter
			aria-label="Filtrar por estado"
			aria-haspopup="dialog"
			aria-controls="professionals-status-filter-sheet"
			aria-pressed={hasStatusFilter ? 'true' : 'false'}
		>
			<span class="material-symbols-rounded text-[1.25rem]" aria-hidden="true">tune</span>
			{hasStatusFilter && (
				<span class="panel-status-filter-badge" data-professionals-status-filter-badge aria-hidden="true"></span>
			)}
		</button>
	</div>

	<dialog
		id="professionals-status-filter-sheet"
		class="panel-status-filter-sheet"
		data-professionals-status-filter-sheet
		aria-labelledby="professionals-status-filter-title"
	>
		<div class="panel-status-filter-sheet__handle" aria-hidden="true">
			<span></span>
		</div>
		<div class="panel-status-filter-sheet__header">
			<h2 id="professionals-status-filter-title" class="m-0 text-[1.05rem] font-extrabold tracking-tight">
				Filtros
			</h2>
			<button
				type="button"
				class="flex size-9 shrink-0 items-center justify-center rounded-full text-(--on-surface-variant) transition-colors hover:bg-(--surface-variant) hover:text-(--on-surface)"
				data-close-professionals-status-filter
				aria-label="Cerrar filtro"
			>
				<span class="material-symbols-rounded text-[1.3rem]">close</span>
			</button>
		</div>
		<div class="panel-status-filter-sheet__list" role="listbox" aria-label="Estado del personal">
			<button
				type="button"
				class:list={['panel-status-filter-option', !hasStatusFilter && 'is-selected']}
				data-professionals-status-option
				data-value=""
				role="option"
				aria-selected={!hasStatusFilter ? 'true' : 'false'}
			>
				<span>Todos</span>
				<span class="material-symbols-rounded">check</span>
			</button>
			<button
				type="button"
				class:list={['panel-status-filter-option', isActiveFilter === 1 && 'is-selected']}
				data-professionals-status-option
				data-value="1"
				role="option"
				aria-selected={isActiveFilter === 1 ? 'true' : 'false'}
			>
				<span>Activos</span>
				<span class="material-symbols-rounded">check</span>
			</button>
			<button
				type="button"
				class:list={['panel-status-filter-option', isActiveFilter === 0 && 'is-selected']}
				data-professionals-status-option
				data-value="0"
				role="option"
				aria-selected={isActiveFilter === 0 ? 'true' : 'false'}
			>
				<span>Inactivos</span>
				<span class="material-symbols-rounded">check</span>
			</button>
		</div>
	</dialog>

	<div data-professionals-results>
	{professionals.length === 0 ? (
		<div class="professionals-empty-state" data-professionals-empty>
			<div class="professionals-empty-icon">
				<span class="material-symbols-rounded text-[2rem]">{hasFilters ? 'search_off' : 'badge'}</span>
			</div>
			<h3 class="text-[1.1rem] font-bold text-(--on-surface)">
				{hasFilters ? 'No se encontraron profesionales' : 'No hay profesionales registrados'}
			</h3>
			<p class="mt-1.5 max-w-sm text-[0.95rem] leading-relaxed text-(--on-surface-variant)">
				{hasSearch
					? 'Probá con otro nombre, email o teléfono.'
					: hasStatusFilter
						? 'No hay profesionales con ese estado.'
						: 'Aún no has agregado a ningún profesional a esta organización. Comienza creando tu primer registro de personal.'}
			</p>
		</div>
	) : (
		<div class="material-cards-grid gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3" data-professionals-grid>
			{cardItems.map((item) => (
				<article
					class="professionals-card group cursor-pointer relative overflow-hidden"
					data-professional-card
					data-professional-id={item.professional.id_professional}
					tabindex="0"
					role="button"
					aria-label={`Editar personal ${toDisplayName(item.professional)}`}
				>
					<div class="relative flex items-start justify-between gap-4">
						<div
							class:list={[
								'professionals-card-avatar',
								!item.profileImageUrl && 'professionals-card-avatar--placeholder',
							]}
							data-professional-card-avatar
						>
							{item.profileImageUrl ? (
								<img
									src={item.profileImageUrl}
									alt={`Foto de perfil de ${toDisplayName(item.professional)}`}
									class="professionals-card-avatar-image"
									loading="lazy"
									decoding="async"
									onerror="this.classList.add('is-hidden'); this.parentElement?.classList.add('professionals-card-avatar--placeholder');"
								/>
							) : null}
							<span
								class:list={[
									'material-symbols-rounded professionals-card-avatar-icon',
									item.profileImageUrl && 'professionals-card-avatar-icon--fallback',
								]}
								aria-hidden="true"
							>
								{PROFESSIONAL_ICON}
							</span>
						</div>

						<span
							class:list={[
								'professionals-card-status',
								item.professional.membership_status === 'pending_invite'
									? 'professionals-card-status--pending'
									: isProfessionalAccountActive(item.professional)
										? 'professionals-card-status--active'
										: 'professionals-card-status--inactive',
							]}
						>
							<span
								class:list={[
									'size-1.5 rounded-full',
									item.professional.membership_status === 'pending_invite'
										? 'professionals-summary-dot--pending'
										: isProfessionalAccountActive(item.professional)
											? 'professionals-summary-dot--active'
											: 'professionals-summary-dot--inactive',
								]}
							></span>
							{item.professional.membership_status === 'pending_invite'
								? 'Invitación pendiente'
								: isProfessionalAccountActive(item.professional)
									? 'Activo'
									: 'Inactivo'}
						</span>
					</div>

					<div class="professionals-card-body">
						<div>
							<h3 class="professionals-card-title line-clamp-1">
								{toDisplayName(item.professional)}
							</h3>
							<p class="mt-1 text-[0.9rem] text-(--on-surface-variant) line-clamp-1">
								{toContactEmail(item.professional)}
							</p>
						</div>

						<dl class="mt-auto shrink-0 grid gap-0.5">
							<div class="flex items-center justify-between text-[0.92rem]">
								<dt class="professionals-card-term">Especialidad</dt>
								<dd class="professionals-card-value">{toSpecialtyName(item.professional)}</dd>
							</div>
							<div class="flex items-center justify-between text-[0.92rem]">
								<dt class="professionals-card-term">Teléfono</dt>
								<dd class="professionals-card-value">{item.professional.phone_number || '-'}</dd>
							</div>
						</dl>
					</div>
				</article>
			))}
		</div>
	)}
	</div>
</section>

<style is:global>
	.professionals-view {
		display: grid;
		gap: 1.2rem;
	}

	.professionals-summary-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border-radius: 999px;
		border: 0;
		padding: 0.33rem 0.78rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.01em;
	}

	.professionals-summary-pill--active {
		background: rgba(16, 185, 129, 0.12);
		color: #0f6d4a;
	}

	.professionals-summary-pill--inactive {
		background: rgba(244, 63, 94, 0.11);
		color: #8d3e4a;
	}

	.professionals-summary-dot {
		display: inline-block;
	}

	.professionals-summary-dot--active {
		background: #22c55e;
	}

	.professionals-summary-dot--inactive {
		background: #fb7185;
	}

	.professionals-create-btn {
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--primary) 72%, #123e7a 28%);
		background: var(--primary);
		padding: 0.72rem 1.15rem;
		font-size: 0.92rem;
		font-weight: 780;
		color: #f8fbff;
		box-shadow: none;
		transition: filter 140ms ease, border-color 140ms ease;
	}

	.professionals-create-btn-icon {
		flex-shrink: 0;
	}

	.professionals-create-btn:hover {
		filter: brightness(1.04);
	}

	.professionals-create-btn:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
		outline-offset: 3px;
	}

	.professionals-create-fab {
		display: none;
	}

	@media (max-width: 639px) {
		.professionals-create-fab {
			position: fixed;
			right: max(1rem, env(safe-area-inset-right, 0px));
			bottom: calc(5.15rem + env(safe-area-inset-bottom, 0px));
			z-index: 44;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 3.5rem;
			height: 3.5rem;
			padding: 0;
			border: 0;
			border-radius: 999px;
			color: #f8fbff;
			background: var(--primary);
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.28);
			cursor: pointer;
			-webkit-tap-highlight-color: transparent;
			transition: transform 140ms ease, box-shadow 140ms ease, filter 140ms ease;
		}

		.professionals-create-fab-icon {
			width: 1.35rem;
			height: 1.35rem;
			flex-shrink: 0;
		}

		.professionals-create-fab:hover {
			filter: brightness(1.04);
			box-shadow: 0 3px 10px rgba(0, 0, 0, 0.32);
		}

		.professionals-create-fab:active {
			transform: scale(0.96);
		}

		.professionals-create-fab:focus-visible {
			outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
			outline-offset: 3px;
		}
	}

	.professionals-empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 1.35rem;
		border: 1px solid rgba(148, 163, 184, 0.24);
		background: color-mix(in srgb, var(--surface-container-low) 72%, var(--surface-bright) 28%);
		padding: 2.5rem 1.25rem;
		text-align: center;
	}

	.professionals-empty-icon {
		margin-bottom: 1rem;
		display: flex;
		height: 4rem;
		width: 4rem;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container) 88%, var(--surface-bright) 12%);
		color: var(--on-surface-variant);
	}

	.professionals-card {
		cursor: pointer;
	}

	.professionals-card-avatar {
		position: relative;
		display: flex;
		width: 2.75rem;
		height: 2.75rem;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		border-radius: 50%;
		isolation: isolate;
	}

	.professionals-card-avatar-image {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
		object-position: center;
		background: transparent;
	}

	.professionals-card-avatar-icon {
		font-size: 1.25rem;
		line-height: 1;
	}

	.professionals-card-avatar-icon--fallback {
		display: none;
	}

	.professionals-card-avatar--placeholder .professionals-card-avatar-icon--fallback {
		display: inline-flex;
	}

	.professionals-card-avatar-image.is-hidden {
		display: none;
	}

	.professionals-card-status {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border-radius: 999px;
		border: 0;
		padding: 0.24rem 0.6rem;
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.professionals-card-status--active {
		background: rgba(16, 185, 129, 0.12);
		color: #0f6d4a;
	}

	.professionals-card-status--inactive {
		background: rgba(244, 63, 94, 0.11);
		color: #8d3e4a;
	}

	.professionals-card-status--pending {
		background: rgba(245, 158, 11, 0.14);
		color: #9a6700;
	}

	.professionals-summary-dot--pending {
		background: #f59e0b;
	}

	.professionals-card-value {
		font-weight: 700;
	}

	html[data-theme='dark'] .professionals-summary-pill--active {
		background: rgba(110, 231, 183, 0.16);
		color: #b8f5d5;
	}

	html[data-theme='dark'] .professionals-summary-pill--inactive {
		background: rgba(255, 182, 193, 0.12);
		color: #ffc8d2;
	}

	html[data-theme='dark'] .professionals-create-btn {
		border-color: color-mix(in srgb, var(--primary) 58%, #0e0e10 42%);
		background: color-mix(in srgb, var(--primary) 78%, #0e0e10 22%);
	}

	html[data-theme='dark'] .professionals-create-btn:hover {
		filter: brightness(1.08);
	}

	@media (max-width: 639px) {
		html[data-theme='dark'] .professionals-create-fab {
			background: color-mix(in srgb, var(--primary) 78%, #0e0e10 22%);
		}

		html[data-theme='dark'] .professionals-create-fab:hover {
			filter: brightness(1.08);
		}
	}

	html[data-theme='dark'] .professionals-empty-state {
		border-color: rgba(255, 255, 255, 0.08);
		background: #121214;
	}


	html[data-theme='dark'] .professionals-card-status--active {
		background: rgba(110, 231, 183, 0.16);
		color: #b8f5d5;
	}

	html[data-theme='dark'] .professionals-card-status--inactive {
		background: rgba(255, 182, 193, 0.12);
		color: #ffc8d2;
	}

	html[data-theme='dark'] .professionals-card-status--pending {
		background: rgba(251, 191, 36, 0.16);
		color: #fcd34d;
	}
</style>

<script>
	import { initProfessionalsListControls } from '../scripts/professionals-list-controls';
	import { initPanelSearchClear } from '../scripts/panel-search-clear';

	initProfessionalsListControls();
	initPanelSearchClear();
</script>
