---
import '../styles/auth.css';

interface Props {
	error?: string;
	successMessage?: string;
	identifier?: string;
	identifierError?: string;
	passwordError?: string;
	redirectTo?: string;
}

const {
	error = '',
	successMessage = '',
	identifier = '',
	identifierError = '',
	passwordError = '',
	redirectTo = '',
} = Astro.props;
---

<section class="auth-page" data-login-page>
	<header class="auth-topbar">
		<div class="auth-topbar-inner">
			<a href="/" class="auth-brand" aria-label="Hasel — Inicio">
				<img
					src="/icons/icon-64.png"
					alt=""
					class="auth-brand-logo"
					width="40"
					height="40"
					loading="eager"
					decoding="async"
				/>
				<span class="auth-brand-wordmark">Hasel</span>
			</a>
		</div>
	</header>

	<div class="auth-shell">
		<main class="auth-card login-card">
			<header class="auth-card-header login-card-header">
				<h1 id="login-heading" class="auth-title">Iniciar sesión</h1>
				<p class="auth-subtitle">Ingresa tus datos para acceder a tu cuenta.</p>
			</header>

			{error && (
				<div class="auth-banner auth-banner-error" role="alert" aria-live="polite">
					<span class="material-symbols-rounded" aria-hidden="true">error</span>
					<span>{error}</span>
				</div>
			)}

			{successMessage && (
				<div class="auth-banner auth-banner-success" role="status" aria-live="polite">
					<span class="material-symbols-rounded" aria-hidden="true">check_circle</span>
					<span>{successMessage}</span>
				</div>
			)}

			<form method="post" action="/api/auth/login" data-astro-reload data-login-form>
				<input type="hidden" name="redirectTo" value={redirectTo} />

				<div class="auth-field">
					<label class="auth-label" for="identifier">Correo electrónico</label>
					<input
						type="email"
						id="identifier"
						name="identifier"
						class:list={['auth-input', identifierError && 'is-invalid']}
						placeholder="Ej: usuario@empresa.com"
						value={identifier}
						autocomplete="email"
						autocapitalize="none"
						spellcheck="false"
						inputmode="email"
						required
					/>
					{identifierError && <span class="auth-field-error">{identifierError}</span>}
				</div>

				<div class="auth-field">
					<label class="auth-label" for="password">Contraseña</label>
					<div class="auth-input-affix">
						<input
							type="password"
							id="password"
							name="password"
							class:list={['auth-input', passwordError && 'is-invalid']}
							placeholder="Tu contraseña"
							autocomplete="current-password"
							required
						/>
						<button
							type="button"
							class="auth-icon-btn"
							data-password-toggle
							aria-label="Mostrar contraseña"
						>
							<span class="material-symbols-rounded" data-password-icon aria-hidden="true"
								>visibility_off</span
							>
						</button>
					</div>
					{passwordError && <span class="auth-field-error">{passwordError}</span>}
				</div>

				<div class="login-options-row">
					<label class="login-checkbox-label">
						<input type="checkbox" name="remember" value="true" />
						<span class="login-checkbox-box" aria-hidden="true">
							<span class="material-symbols-rounded">check</span>
						</span>
						Recordarme
					</label>
					<a href="/auth/forgot-password" class="auth-link">¿Olvidaste tu contraseña?</a>
				</div>

				<button
					type="submit"
					class="auth-btn auth-btn-primary auth-submit login-submit"
					data-login-submit
				>
					<span class="login-submit-label">Iniciar sesión</span>
					<span class="login-submit-spinner" aria-hidden="true"></span>
				</button>
			</form>

			<footer class="auth-card-footer">
				<p class="auth-footer-text">
					¿No tienes cuenta?
					<a href="/auth/register" class="auth-footer-link"><strong>Crear cuenta</strong></a>
				</p>
			</footer>
		</main>
	</div>

	<footer class="auth-page-footer" aria-label="Pie de página">
		<p>
			Hasel &copy; 2026
			<span class="auth-page-footer-sep" aria-hidden="true">|</span>
			<a href="/politicas-y-privacidad" class="auth-page-footer-link">Políticas de privacidad</a>
		</p>
	</footer>
</section>

<script is:inline>
	(() => {
		if (typeof window === 'undefined') return;

		const setupLoginForm = () => {
			const form = document.querySelector('[data-login-form]');
			if (!form || form.dataset.enhanced) return;
			form.dataset.enhanced = 'true';

			const pwToggle = form.querySelector('[data-password-toggle]');
			const pwIcon = form.querySelector('[data-password-icon]');
			pwToggle?.addEventListener('click', () => {
				const input = form.querySelector('input[name="password"]');
				if (!(input instanceof HTMLInputElement)) return;
				const isPw = input.type === 'password';
				input.type = isPw ? 'text' : 'password';
				if (pwIcon) pwIcon.textContent = isPw ? 'visibility' : 'visibility_off';
				pwToggle.setAttribute('aria-label', isPw ? 'Ocultar contraseña' : 'Mostrar contraseña');
			});

			form.addEventListener('submit', () => {
				const submitBtn = form.querySelector('[data-login-submit]');
				if (!(submitBtn instanceof HTMLButtonElement) || submitBtn.disabled) return;
				submitBtn.disabled = true;
				submitBtn.setAttribute('aria-busy', 'true');
				submitBtn.classList.add('is-loading');
			});
		};

		setupLoginForm();
		document.addEventListener('astro:page-load', setupLoginForm);
	})();
</script>

<style>
	.login-card {
		max-width: 28rem;
		background: rgba(20, 24, 32, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(24px) saturate(1.15);
		-webkit-backdrop-filter: blur(24px) saturate(1.15);
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.12),
			0 16px 40px rgba(0, 0, 0, 0.16),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
	}

	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.login-card {
			background: rgba(20, 24, 32, 0.88);
		}
	}

	.login-card-header {
		margin-bottom: 1.5rem;
	}

	#login-heading {
		scroll-margin-top: 5rem;
	}

	.login-options-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 1.15rem;
		flex-wrap: wrap;
	}

	.login-checkbox-label {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--auth-on-surface-variant);
		user-select: none;
	}

	.login-checkbox-label input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.login-checkbox-box {
		width: 1.15rem;
		height: 1.15rem;
		border-radius: 0.35rem;
		border: 1.5px solid rgba(255, 255, 255, 0.18);
		background: transparent;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition:
			background-color 180ms ease,
			border-color 180ms ease;
		flex-shrink: 0;
	}

	.login-checkbox-box .material-symbols-rounded {
		font-size: 0.9rem;
		color: var(--auth-on-primary);
		opacity: 0;
		line-height: 1;
		transition: opacity 180ms ease;
	}

	.login-checkbox-label:hover .login-checkbox-box {
		border-color: rgba(168, 199, 255, 0.45);
	}

	.login-checkbox-label input:checked + .login-checkbox-box {
		background: var(--auth-primary);
		border-color: var(--auth-primary);
	}

	.login-checkbox-label input:checked + .login-checkbox-box .material-symbols-rounded {
		opacity: 1;
	}

	.login-checkbox-label input:focus-visible + .login-checkbox-box {
		box-shadow: 0 0 0 4px rgba(66, 110, 219, 0.2);
	}

	.login-submit {
		position: relative;
	}

	.login-submit.is-loading {
		pointer-events: none;
		opacity: 0.88;
	}

	.login-submit-spinner {
		position: absolute;
		inset: 0;
		margin: auto;
		display: none;
		width: 1.1rem;
		height: 1.1rem;
		border: 2px solid rgba(255, 255, 255, 0.35);
		border-top-color: #fff;
		border-radius: 50%;
		animation: login-spin 650ms linear infinite;
	}

	.login-submit.is-loading .login-submit-spinner {
		display: inline-block;
	}

	.login-submit.is-loading .login-submit-label {
		opacity: 0;
	}

	@keyframes login-spin {
		to {
			transform: rotate(360deg);
		}
	}

	.login-submit.auth-btn-primary {
		box-shadow: none;
	}

	.login-submit.auth-btn-primary:hover {
		background: var(--auth-primary-hover);
		box-shadow: none;
		transform: none;
	}

	.login-submit.auth-btn-primary:active {
		transform: scale(0.98);
	}

	@media (max-width: 640px) {
		:global(.auth-page[data-login-page] .auth-shell) {
			padding: 1rem var(--auth-pad-x) 1.25rem;
		}

		.login-card {
			max-width: none;
			background: transparent;
			border: none;
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
			box-shadow: none;
			border-radius: 0;
			padding: 0;
		}

		.login-card-header {
			align-items: center;
			text-align: center;
			gap: 0.5rem;
			margin-bottom: 2rem;
		}

		.login-card-header :global(.auth-title) {
			margin-bottom: 0.35rem;
		}

		.login-card :global(.auth-field) {
			gap: 0.5rem;
		}

		.login-card :global(.auth-field + .auth-field) {
			margin-top: 1.15rem;
		}

		.login-options-row {
			margin-top: 1.15rem;
			gap: 0.75rem;
		}

		.login-card :global(.login-submit.auth-submit) {
			margin-top: 1.5rem;
		}

		.login-checkbox-label {
			font-size: 0.8rem;
		}

		.login-card :global(.auth-card-footer) {
			border-top: none;
			margin-top: 1.75rem;
			padding-top: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.login-submit-spinner {
			animation: none;
		}
	}
</style>
