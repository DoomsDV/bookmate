---
interface Props {
	error?: string;
	successMessage?: string;
	identifier?: string;
	identifierError?: string;
	passwordError?: string;
	redirectTo?: string;
}

const {
	error = '',
	successMessage = '',
	identifier = '',
	identifierError = '',
	passwordError = '',
	redirectTo = '',
} = Astro.props;
---

<section class="login-page" data-login-page>
	<div class="login-fx" aria-hidden="true">
		<div class="login-atmosphere"></div>
		<div class="login-vignette"></div>
		<div class="login-orb login-orb-a"></div>
		<div class="login-orb login-orb-b"></div>

		<!-- Decorative accents: outlined rects -->
		<div class="login-deco login-deco-1"></div>
		<div class="login-deco login-deco-2"></div>
		<div class="login-deco login-deco-3"></div>
		<!-- Filled squares -->
		<div class="login-deco login-deco-4"></div>
		<div class="login-deco login-deco-5"></div>
		<!-- Circles / dots -->
		<div class="login-deco login-deco-6"></div>
		<div class="login-deco login-deco-7"></div>
		<!-- Wavy lines (CSS, sized explicitly to avoid SVG overflow) -->
		<div class="login-deco login-deco-wave1"></div>
		<div class="login-deco login-deco-wave2"></div>
	</div>

	<header class="login-topbar">
		<div class="login-topbar-inner">
			<a href="/" class="login-brand" aria-label="Hasel — Inicio">
				<img
					src="/icons/icon-64.png"
					alt=""
					class="login-brand-logo"
					width="40"
					height="40"
					loading="eager"
					decoding="async"
				/>
				<span class="login-brand-wordmark">Hasel</span>
			</a>
			<a href="/auth/register" class="login-topbar-cta">Crear cuenta</a>
		</div>
	</header>

	<div class="login-shell">
		<main class="login-card">
			<header class="login-card-header">
				<h1 class="login-title">Iniciar sesión</h1>
				<p class="login-subtitle">Ingresá tus datos para acceder a tu cuenta.</p>
			</header>

			{error && (
				<div class="login-error-banner">
					<span class="material-symbols-rounded" aria-hidden="true">error</span>
					{error}
				</div>
			)}

			{successMessage && (
				<div class="login-success-banner" role="status">
					<span class="material-symbols-rounded" aria-hidden="true">check_circle</span>
					{successMessage}
				</div>
			)}

			<form method="post" action="/api/auth/login" data-astro-reload data-login-form>
				<input type="hidden" name="redirectTo" value={redirectTo} />

				<div class="login-field">
					<label class="login-label" for="identifier">Correo electrónico</label>
					<input
						type="text"
						id="identifier"
						name="identifier"
						class:list={['login-input', identifierError && 'is-invalid']}
						placeholder="Correo electrónico"
						value={identifier}
						autocomplete="email"
						autocapitalize="none"
						spellcheck="false"
						inputmode="email"
						required
					/>
					{identifierError && <span class="login-field-error">{identifierError}</span>}
				</div>

				<div class="login-field">
					<label class="login-label" for="password">Contraseña</label>
					<div class="login-input-affix">
						<input
							type="password"
							id="password"
							name="password"
							class:list={['login-input', passwordError && 'is-invalid']}
							placeholder="Tu contraseña"
							autocomplete="current-password"
							required
						/>
						<button
							type="button"
							class="login-icon-btn"
							data-password-toggle
							aria-label="Mostrar contraseña"
						>
							<span class="material-symbols-rounded" data-password-icon aria-hidden="true"
								>visibility_off</span
							>
						</button>
					</div>
					{passwordError && <span class="login-field-error">{passwordError}</span>}
				</div>

				<div class="login-actions-row">
					<label class="login-checkbox-label">
						<input type="checkbox" name="remember" value="true" />
						<span class="login-checkbox-box" aria-hidden="true">
							<span class="material-symbols-rounded">check</span>
						</span>
						Recordarme
					</label>
					<a href="/auth/forgot-password" class="login-link">¿Olvidaste tu contraseña?</a>
				</div>

				<button type="submit" class="login-submit">Iniciar sesión</button>
			</form>

			<footer class="login-card-footer">
				<p class="login-footer-text">
					¿No tienes una cuenta?
					<a href="/auth/register" class="login-footer-link"><strong>Crear cuenta</strong></a>
				</p>
			</footer>
		</main>
	</div>

	<footer class="login-page-footer" aria-label="Copyright">
		<p>Hasel &copy; 2026</p>
	</footer>
</section>

<script is:inline>
	function setupLoginForm() {
		const form = document.querySelector('[data-login-form]');
		if (!form || form.dataset.enhanced) return;
		form.dataset.enhanced = 'true';

		const pwToggle = form.querySelector('[data-password-toggle]');
		const pwIcon = form.querySelector('[data-password-icon]');
		pwToggle?.addEventListener('click', () => {
			const input = form.querySelector('input[name="password"]');
			if (input) {
				const isPw = input.type === 'password';
				input.type = isPw ? 'text' : 'password';
				if (pwIcon) pwIcon.textContent = isPw ? 'visibility' : 'visibility_off';
				pwToggle.setAttribute('aria-label', isPw ? 'Ocultar contraseña' : 'Mostrar contraseña');
			}
		});
	}

	if (typeof window !== 'undefined') {
		setupLoginForm();
		document.addEventListener('astro:page-load', setupLoginForm);
	}
</script>

<style>
	.login-page {
		--login-bg: #0b0d12;
		--login-primary: #426edb;
		--login-primary-hover: #5a82e8;
		--login-on-primary: #ffffff;
		--login-surface: #1c1b1f;
		--login-surface-high: #201f23;
		--login-surface-highest: #2a292d;
		--login-on-surface: #e5e2e1;
		--login-on-surface-variant: #c4c6d0;
		--login-outline: #44474e;
		--login-outline-soft: color-mix(in srgb, #44474e 55%, transparent);
		--login-error: #ffb4ab;
		--login-error-container: rgba(127, 29, 29, 0.28);
		--login-success: #a7f3d0;
		--login-success-container: rgba(6, 78, 59, 0.35);
		--login-radius: 28px;
		--login-shell: 100%;
		--login-pad-x: 1.25rem;

		position: relative;
		isolation: isolate;
		overflow-x: clip;
		min-height: 100vh;
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
		font-family: var(--font-body, 'Nunito Sans', system-ui, sans-serif);
		color: var(--login-on-surface);
		background-color: var(--login-bg);
		background-image:
			radial-gradient(ellipse 85% 60% at 90% 6%, rgba(45, 110, 255, 0.2), transparent 58%),
			radial-gradient(ellipse 70% 45% at 12% 88%, rgba(66, 110, 219, 0.1), transparent 60%),
			linear-gradient(165deg, #0b0d12 0%, #101522 45%, #0b0d12 100%);
		-webkit-font-smoothing: antialiased;
	}

	:global(html:has(.login-page)),
	:global(body:has(.login-page)) {
		margin: 0;
		padding: 0;
		background: var(--login-bg, #0b0d12);
		overflow-x: clip;
	}

	@media (min-width: 768px) {
		.login-page {
			--login-pad-x: 2rem;
		}
	}

	@media (min-width: 1024px) {
		.login-page {
			--login-shell: 85%;
			--login-pad-x: 2.75rem;
		}
	}

	/* ─── Effects Layer ─── */

	.login-fx {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: 0;
		contain: paint;
	}

	.login-atmosphere {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 50% 42%, rgba(90, 150, 255, 0.18), transparent 38%),
			radial-gradient(circle at 22% 70%, rgba(66, 110, 219, 0.12), transparent 32%);
		opacity: 1;
	}

	.login-vignette {
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 90% 80% at 50% 50%, transparent 50%, rgba(0, 0, 0, 0.4) 100%);
	}

	.login-orb {
		position: absolute;
		border-radius: 9999px;
		opacity: 0.6;
		animation: login-orb-drift 22s ease-in-out infinite;
	}

	.login-orb-a {
		top: -10%;
		right: -8%;
		width: min(52vw, 36rem);
		height: min(52vw, 36rem);
		background: radial-gradient(
			circle,
			rgba(55, 120, 255, 0.42) 0%,
			rgba(30, 70, 200, 0.16) 40%,
			transparent 70%
		);
	}

	.login-orb-b {
		bottom: 4%;
		left: -10%;
		width: min(40vw, 26rem);
		height: min(40vw, 26rem);
		background: radial-gradient(circle, rgba(100, 160, 255, 0.26) 0%, transparent 68%);
		animation-duration: 28s;
		animation-direction: reverse;
		opacity: 0.6;
	}

	/* ─── Decorative Elements ─── */

	.login-deco {
		display: none;
		position: absolute;
		box-sizing: border-box;
		max-width: 8rem;
		max-height: 6rem;
		flex-shrink: 0;
	}

	@media (min-width: 1024px) {
		.login-deco {
			display: block;
		}
	}

	/* Outlined rectangles */
	.login-deco-1 {
		--_deco-rotate: rotate(12deg);
		top: 18%;
		left: 7%;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 1rem;
		border: 1.5px solid rgba(66, 110, 219, 0.4);
		background: transparent;
		animation: login-float 8s ease-in-out infinite;
	}

	.login-deco-2 {
		--_deco-rotate: rotate(-8deg);
		bottom: 28%;
		right: 6%;
		width: 5.5rem;
		height: 3.5rem;
		border-radius: 0.85rem;
		border: 1.5px solid rgba(66, 110, 219, 0.32);
		background: transparent;
		animation: login-float 10s ease-in-out infinite 1.5s;
	}

	.login-deco-3 {
		--_deco-rotate: rotate(-15deg);
		top: 55%;
		left: 4%;
		width: 3rem;
		height: 5rem;
		border-radius: 0.75rem;
		border: 1px solid rgba(66, 110, 219, 0.25);
		background: transparent;
		animation: login-float 12s ease-in-out infinite 3s;
	}

	/* Filled squares */
	.login-deco-4 {
		--_deco-rotate: rotate(22deg);
		top: 32%;
		right: 10%;
		width: 3rem;
		height: 3rem;
		border-radius: 0.7rem;
		background: rgba(66, 110, 219, 0.12);
		border: 1px solid rgba(66, 110, 219, 0.2);
		animation: login-float 9s ease-in-out infinite 0.8s;
	}

	.login-deco-5 {
		--_deco-rotate: rotate(-6deg);
		bottom: 16%;
		left: 9%;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.5rem;
		background: rgba(66, 110, 219, 0.14);
		border: 1px solid rgba(66, 110, 219, 0.22);
		animation: login-float 7s ease-in-out infinite 2.2s;
	}

	/* Circles / dots */
	.login-deco-6 {
		--_deco-rotate: rotate(0deg);
		top: 12%;
		right: 18%;
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 9999px;
		background: rgba(66, 110, 219, 0.28);
		animation: login-float 6s ease-in-out infinite 0.5s;
	}

	.login-deco-7 {
		--_deco-rotate: rotate(0deg);
		bottom: 38%;
		left: 15%;
		width: 0.85rem;
		height: 0.85rem;
		border-radius: 9999px;
		background: rgba(66, 110, 219, 0.35);
		animation: login-float 8s ease-in-out infinite 4s;
	}

	/* Waves without data: URLs (avoids Vite/Firefox resolving file://) */
	.login-deco-wave1,
	.login-deco-wave2 {
		height: 1.1rem;
		background: transparent;
		border: none;
		opacity: 0.55;
		background:
			radial-gradient(ellipse 18% 70% at 8% 55%, transparent 55%, rgba(66, 110, 219, 0.7) 56%, transparent 62%),
			radial-gradient(ellipse 18% 70% at 28% 40%, transparent 55%, rgba(66, 110, 219, 0.7) 56%, transparent 62%),
			radial-gradient(ellipse 18% 70% at 48% 60%, transparent 55%, rgba(66, 110, 219, 0.7) 56%, transparent 62%),
			radial-gradient(ellipse 18% 70% at 68% 38%, transparent 55%, rgba(66, 110, 219, 0.7) 56%, transparent 62%),
			radial-gradient(ellipse 18% 70% at 88% 55%, transparent 55%, rgba(66, 110, 219, 0.7) 56%, transparent 62%);
	}

	.login-deco-wave1 {
		--_deco-rotate: rotate(6deg);
		top: 72%;
		right: 5%;
		width: 7.5rem;
		animation: login-float 11s ease-in-out infinite 2s;
	}

	.login-deco-wave2 {
		--_deco-rotate: rotate(-4deg);
		top: 24%;
		left: 12%;
		width: 5.5rem;
		animation: login-float 9s ease-in-out infinite 3.5s;
	}

	@keyframes login-float {
		0%,
		100% {
			transform: translate3d(0, 0, 0) var(--_deco-rotate, rotate(0deg));
		}
		50% {
			transform: translate3d(0, -6px, 0) var(--_deco-rotate, rotate(0deg));
		}
	}

	@keyframes login-orb-drift {
		0%, 100% {
			transform: translate3d(0, 0, 0);
		}
		50% {
			transform: translate3d(1.5%, -2%, 0);
		}
	}

	/* ─── Topbar ─── */

	.login-topbar {
		position: relative;
		z-index: 2;
		padding: 1rem var(--login-pad-x) 0.5rem;
	}

	.login-topbar-inner {
		width: var(--login-shell);
		max-width: 100%;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.login-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: var(--login-on-surface);
	}

	.login-brand-logo {
		width: 2.25rem;
		height: 2.25rem;
		object-fit: contain;
	}

	.login-brand-wordmark {
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.login-topbar-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0.55rem 1.15rem;
		border-radius: 9999px;
		background: var(--login-primary);
		color: var(--login-on-primary);
		font-size: 0.92rem;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 180ms ease, transform 180ms ease;
	}

	.login-topbar-cta:hover {
		background: var(--login-primary-hover);
		transform: translateY(-1px);
	}

	/* ─── Shell & Card ─── */

	.login-shell {
		position: relative;
		z-index: 2;
		flex: 1;
		width: var(--login-shell);
		max-width: 100%;
		margin: 0 auto;
		padding: 1.25rem var(--login-pad-x) 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.login-card {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 28rem;
		padding: 2.25rem 1.75rem 2rem;
		border-radius: var(--login-radius);
		background: rgba(28, 27, 31, 0.45);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-top-color: rgba(168, 199, 255, 0.35);
		backdrop-filter: blur(22px) saturate(1.35);
		-webkit-backdrop-filter: blur(22px) saturate(1.35);
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.35),
			0 24px 56px rgba(0, 0, 0, 0.35),
			0 0 80px rgba(66, 110, 219, 0.1),
			inset 0 1px 0 rgba(255, 255, 255, 0.1);
		animation: login-card-in 360ms cubic-bezier(0.2, 0, 0, 1);
	}

	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.login-card {
			background: rgba(28, 27, 31, 0.92);
		}
	}

	@media (min-width: 640px) {
		.login-card {
			padding: 2.75rem 2.5rem 2.25rem;
		}
	}

	@keyframes login-card-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* ─── Card Content ─── */

	.login-card-header {
		text-align: center;
		margin-bottom: 1.75rem;
	}

	.login-title {
		margin: 0 0 0.45rem;
		font-size: clamp(1.55rem, 2.5vw, 1.85rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--login-on-surface);
		line-height: 1.15;
	}

	.login-subtitle {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.5;
		color: var(--login-on-surface-variant);
	}

	.login-error-banner,
	.login-success-banner {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
		padding: 0.9rem 1rem;
		border-radius: 0.85rem;
		margin-bottom: 1.25rem;
		font-size: 0.92rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.login-error-banner .material-symbols-rounded,
	.login-success-banner .material-symbols-rounded {
		font-size: 1.25rem;
		flex-shrink: 0;
		margin-top: 0.05rem;
	}

	.login-error-banner {
		background: rgba(127, 29, 29, 0.35);
		border: 1px solid rgba(255, 180, 171, 0.35);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		color: var(--login-error);
	}

	.login-success-banner {
		background: rgba(6, 78, 59, 0.4);
		border: 1px solid rgba(52, 211, 153, 0.4);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		color: var(--login-success);
	}

	/* ─── Form Fields ─── */

	.login-field {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.login-field + .login-field {
		margin-top: 1.15rem;
	}

	.login-label {
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--login-on-surface);
		margin-left: 0.15rem;
	}

	.login-input {
		box-sizing: border-box;
		width: 100%;
		min-height: 3rem;
		padding: 0.8rem 1rem;
		border-radius: 0.85rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(255, 255, 255, 0.025);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		color: var(--login-on-surface);
		caret-color: var(--login-primary);
		font: inherit;
		font-size: 1rem;
		line-height: 1.4;
		outline: none;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			box-shadow 180ms ease;
		-webkit-text-fill-color: currentColor;
	}

	.login-input::placeholder {
		color: color-mix(in srgb, var(--login-on-surface-variant) 65%, transparent);
	}

	.login-input:focus {
		border-color: rgba(168, 199, 255, 0.5);
		background: rgba(255, 255, 255, 0.05);
		box-shadow: 0 0 0 4px rgba(66, 110, 219, 0.2);
	}

	.login-input.is-invalid {
		border-color: rgba(255, 180, 171, 0.55);
		background: rgba(127, 29, 29, 0.28);
	}

	.login-input.is-invalid:focus {
		box-shadow: 0 0 0 4px rgba(255, 180, 171, 0.18);
	}

	.login-input-affix {
		position: relative;
		display: flex;
		align-items: center;
	}

	.login-input-affix .login-input {
		padding-right: 3rem;
	}

	.login-icon-btn {
		position: absolute;
		right: 0.4rem;
		width: 2.35rem;
		height: 2.35rem;
		border: none;
		border-radius: 9999px;
		background: transparent;
		color: var(--login-on-surface-variant);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: background-color 160ms ease, color 160ms ease;
	}

	.login-icon-btn:hover {
		background: rgba(255, 255, 255, 0.1);
		color: var(--login-on-surface);
	}

	.login-icon-btn .material-symbols-rounded {
		font-size: 1.25rem;
	}

	.login-field-error {
		font-size: 0.84rem;
		font-weight: 500;
		color: var(--login-error);
		margin-left: 0.15rem;
	}

	/* ─── Actions Row ─── */

	.login-actions-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 1.15rem;
		flex-wrap: wrap;
	}

	.login-checkbox-label {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--login-on-surface-variant);
		user-select: none;
	}

	.login-checkbox-label input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.login-checkbox-box {
		width: 1.2rem;
		height: 1.2rem;
		border-radius: 0.3rem;
