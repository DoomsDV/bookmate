---
import type { PublicOrgHub } from '../lib/public-org-hub';
import type { WorkspaceSettingsData } from '../lib/workspace-settings-shared';
import {
	buildOrgHubUrl,
	resolvePublicSiteOrigin,
} from '../lib/public-profile-url';
import PublicProfilePreview from './PublicProfilePreview';

interface Props {
	workspace: WorkspaceSettingsData;
	hub: PublicOrgHub | null;
	organizationName: string;
}

const DESC_MAX = 500;
const GALLERY_MAX = 30;

const { workspace, hub, organizationName } = Astro.props;
const siteOrigin = resolvePublicSiteOrigin(Astro.url.origin);
const initialSlug = workspace.profile_slug || '';
const hubUrl = initialSlug ? buildOrgHubUrl(siteOrigin || Astro.url.origin, initialSlug) : '';
const domainLabel = (siteOrigin || Astro.url.origin).replace(/^https?:\/\//i, '').replace(/\/+$/, '');
const whatsappDigits = String(workspace.public_whatsapp || '').replace(/\D/g, '');
const whatsappLocal = whatsappDigits.startsWith('595')
	? whatsappDigits.slice(3)
	: whatsappDigits;
const descriptionValue = String(workspace.description || '').slice(0, DESC_MAX);
const galleryImages = workspace.gallery_images || [];
const facebookUrl = String(workspace.facebook_url || '').trim();
const instagramUrl = String(workspace.instagram_url || '').trim();
const bannerUrl = String(workspace.banner_url || '').trim();

const initials = (() => {
	const parts = organizationName.trim().split(/\s+/).filter(Boolean);
	if (!parts.length) return '?';
	if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
	return `${parts[0][0] || ''}${parts[1][0] || ''}`.toUpperCase();
})();

const payload = {
	workspace: {
		...workspace,
		description: descriptionValue,
		gallery_images: galleryImages,
	},
	hub,
	organizationName,
	siteOrigin: siteOrigin || Astro.url.origin,
	domainLabel,
	descMax: DESC_MAX,
	galleryMax: GALLERY_MAX,
};
const serialized = JSON.stringify(payload).replace(/</g, '\\u003c');

const previewInitial = {
	organizationName,
	initials,
	description: descriptionValue,
	logoUrl: workspace.logo_url || '',
	bannerUrl,
	whatsappVisible: Boolean(whatsappLocal),
	facebookUrl,
	instagramUrl,
	galleryUrls: galleryImages.map((item) => item.url).filter(Boolean),
	serviceCategories: hub?.service_categories || [],
	profileSlug: initialSlug,
	locationLabel: hub?.locations?.[0]?.name || hub?.locations?.[0]?.address || '',
	teamCount: hub?.professionals?.length || 0,
};
---

<public-profile-editor data-ppe-root data-ppe-bootstrap={serialized}>
	<div class="ppe-page">
		<div class="ppe-layout">
			<div class="ppe-config-pane">
				<header class="ppe-header">
					<div>
						<h1 class="ppe-header__title">Perfil Público</h1>
						<p class="ppe-header__sub">
							Configurá cómo ven tu negocio los clientes en Hasel. Los cambios se reflejan en la vista
							previa.
						</p>
					</div>
					<div class="ppe-header__actions">
						<a
							class="ppe-btn ppe-btn-secondary"
							href={hubUrl || '#'}
							target="_blank"
							rel="noopener noreferrer"
							data-ppe-open-public
						>
							<span class="material-symbols-rounded text-[1.1rem]" aria-hidden="true">open_in_new</span>
							Ver página pública
						</a>
					</div>
				</header>

				<div data-ppe-feedback class="ppe-feedback" hidden></div>

				<form class="ppe-form-col" id="ppe-form" data-ppe-form>
				<details class="ppe-accordion" open>
					<summary>
						<span class="material-symbols-rounded" aria-hidden="true">link</span>
						Enlace del perfil
						<span class="material-symbols-rounded ppe-accordion__chevron" aria-hidden="true"
							>expand_more</span
						>
					</summary>
					<div class="ppe-accordion__body">
						<div class="ppe-field">
							<span class="ppe-field__label">URL pública <span class="text-rose-500">*</span></span>
							<div class="ppe-slug-row" data-ppe-slug-row>
								<span class="ppe-slug-prefix" title={`${domainLabel}/`}>{domainLabel}/</span>
								<div class="ppe-slug-input-wrap">
									<input
										class="ppe-input"
										type="text"
										name="profile_slug"
										maxlength="100"
										required
										autocomplete="off"
										spellcheck="false"
										value={initialSlug}
										data-ppe-slug
										placeholder="mi-negocio"
									/>
									<span class="ppe-slug-inline-icon" data-ppe-slug-icon hidden aria-hidden="true">
										<span class="material-symbols-rounded">check_circle</span>
									</span>
								</div>
								<button
									type="button"
									class="ppe-icon-btn"
									data-ppe-copy-url
									aria-label="Copiar enlace"
									title="Copiar enlace"
								>
									<span class="material-symbols-rounded text-[1.1rem]" aria-hidden="true"
										>content_copy</span
									>
								</button>
							</div>
							<p class="ppe-slug-meta">
								<span class="ppe-slug-status is-pending" data-ppe-slug-status>Validando…</span>
								<span class="ppe-field__hint" data-ppe-slug-hint>Ej: {domainLabel}/mi-peluqueria</span>
							</p>
						</div>
					</div>
				</details>

				<details class="ppe-accordion" open>
					<summary>
						<span class="material-symbols-rounded" aria-hidden="true">palette</span>
						Apariencia
						<span class="material-symbols-rounded ppe-accordion__chevron" aria-hidden="true"
							>expand_more</span
						>
					</summary>
					<div class="ppe-accordion__body">
						<div class="ppe-field">
							<span class="ppe-field__label">Logo del negocio</span>
							<label class="ppe-logo-drop" data-ppe-logo-dropzone>
								<img
									src={workspace.logo_url || undefined}
									alt=""
									class={`ppe-logo-preview ${workspace.logo_url ? '' : 'hidden'}`}
									data-ppe-logo-preview
									width="88"
									height="88"
								/>
								<div
									class={`ppe-logo-preview ppe-logo-preview--ph ${workspace.logo_url ? 'hidden' : ''}`}
									data-ppe-logo-placeholder
								>
									{initials}
								</div>
								<p class="ppe-field__hint">JPG o PNG. Arrastrá o hacé clic para subir.</p>
								<span class="ppe-btn ppe-btn-secondary" data-ppe-logo-file-label>Subir logo</span>
								<input
									type="file"
									accept=".jpg,.jpeg,.png,image/jpeg,image/png"
									class="sr-only"
									data-ppe-logo-input
								/>
							</label>
						</div>

						<div class="ppe-field">
							<span class="ppe-field__label">Banner del negocio</span>
							<label class="ppe-banner-drop" data-ppe-banner-dropzone>
								<img
									src={bannerUrl || undefined}
									alt=""
									class={`ppe-banner-preview ${bannerUrl ? '' : 'hidden'}`}
									data-ppe-banner-preview
								/>
								<div
									class={`ppe-banner-preview ppe-banner-preview--ph ${bannerUrl ? 'hidden' : ''}`}
									data-ppe-banner-placeholder
								>
									<span class="material-symbols-rounded" aria-hidden="true">image</span>
									<span>1200 × 600 (2:1)</span>
								</div>
								<p class="ppe-field__hint">
									JPG o PNG hasta 5 MB. Recomendado 1200×600 o 1080×566.
								</p>
								<span class="ppe-btn ppe-btn-secondary">Subir banner</span>
								<input
									type="file"
									accept=".jpg,.jpeg,.png,image/jpeg,image/png"
									class="sr-only"
									data-ppe-banner-input
								/>
							</label>
							<label class="ppe-check">
								<input type="checkbox" data-ppe-banner-compress checked />
								<span>Comprimir imagen (recomendado)</span>
							</label>
							<p class="ppe-field__hint" data-ppe-banner-compress-hint hidden>
								Se mantiene la resolución; el perfil puede cargar más lento.
							</p>
						</div>

						<div class="ppe-field">
							<span class="ppe-field__label">
								Galería <span data-ppe-gallery-count>({galleryImages.length}/{GALLERY_MAX})</span>
							</span>
							<p class="ppe-field__hint">
								Hasta 30 fotos del negocio (fachada, interior, servicios). Hasta 5 MB c/u.
							</p>
							<label class="ppe-check">
								<input type="checkbox" data-ppe-gallery-compress checked />
								<span>Comprimir imagen (recomendado)</span>
							</label>
							<p class="ppe-field__hint" data-ppe-gallery-compress-hint hidden>
								Se mantiene la resolución; el perfil puede cargar más lento.
							</p>
							<ul class="ppe-gallery-grid" data-ppe-gallery-grid>
								{
									galleryImages.map((item) => (
										<li class="ppe-gallery-item" data-ppe-gallery-item data-id={item.id}>
											<img src={item.url} alt="" />
											<button
												type="button"
												class="ppe-gallery-item__remove"
												data-ppe-gallery-remove
												data-id={item.id}
												aria-label="Eliminar foto"
											>
												<span class="material-symbols-rounded" aria-hidden="true">close</span>
											</button>
										</li>
									))
								}
							</ul>
							<label class="ppe-btn ppe-btn-secondary ppe-gallery-add" data-ppe-gallery-add>
								<span class="material-symbols-rounded text-[1.1rem]" aria-hidden="true">add_photo_alternate</span>
								Agregar foto
								<input
									type="file"
									accept=".jpg,.jpeg,.png,image/jpeg,image/png"
									class="sr-only"
									data-ppe-gallery-input
									multiple
								/>
							</label>
						</div>
					</div>
				</details>

				<details class="ppe-accordion" open>
					<summary>
						<span class="material-symbols-rounded" aria-hidden="true">edit_note</span>
						Información
						<span class="material-symbols-rounded ppe-accordion__chevron" aria-hidden="true"
							>expand_more</span
						>
					</summary>
					<div class="ppe-accordion__body">
						<div class="ppe-field">
							<label for="ppe-description">Descripción (Sobre nosotros)</label>
							<textarea
								id="ppe-description"
								class="ppe-textarea"
								name="description"
								maxlength={DESC_MAX}
								rows="4"
								placeholder="Contá qué hace tu negocio y por qué elegirte."
								data-ppe-description>{descriptionValue}</textarea
							>
							<span class="ppe-field__hint"
								><span data-ppe-desc-count>{descriptionValue.length}</span>/{DESC_MAX} caracteres</span
							>
						</div>

						<div class="ppe-switch-row">
							<div class="ppe-switch-row__text">
								<strong>Mostrar botón WhatsApp</strong>
								<span>Aparece en la cabecera del hub público.</span>
							</div>
							<label class="ppe-switch">
								<input type="checkbox" data-ppe-wa-toggle checked={Boolean(whatsappLocal)} />
								<span class="ppe-switch__track" aria-hidden="true"></span>
							</label>
						</div>

						<div class={`ppe-field ${whatsappLocal ? '' : 'hidden'}`} data-ppe-wa-field>
							<label for="ppe-whatsapp">Número de WhatsApp</label>
							<div class="ppe-phone-input">
								<span class="ppe-phone-input__prefix">+595</span>
								<input
									id="ppe-whatsapp"
									class="ppe-input ppe-phone-input__field"
									type="tel"
									inputmode="numeric"
									name="public_whatsapp_local"
									maxlength="20"
									placeholder="981 123 456"
									value={whatsappLocal}
									data-ppe-whatsapp
								/>
							</div>
							<span class="ppe-field__hint">Sin el 0 inicial. Ej: 981 123 456</span>
						</div>

						<div class="ppe-field">
							<label for="ppe-facebook">Facebook</label>
							<input
								id="ppe-facebook"
								class="ppe-input"
								type="url"
								name="facebook_url"
								placeholder="https://facebook.com/tu-negocio"
								value={facebookUrl}
								data-ppe-facebook
							/>
							<span class="ppe-field__hint">URL completa de tu página o perfil.</span>
						</div>

						<div class="ppe-field">
							<label for="ppe-instagram">Instagram</label>
							<input
								id="ppe-instagram"
								class="ppe-input"
								type="url"
								name="instagram_url"
								placeholder="https://instagram.com/tu-negocio"
								value={instagramUrl}
								data-ppe-instagram
							/>
							<span class="ppe-field__hint">URL completa de tu perfil.</span>
						</div>
					</div>
				</details>
				</form>
			</div>

			<aside class="ppe-phone-col" aria-label="Vista previa móvil">
				<PublicProfilePreview client:load initial={previewInitial} />
			</aside>
		</div>
	</div>

	<footer class="ppe-save-footer">
		<span class="ppe-field__hint ppe-save-footer__hint">
			Guardá para publicar los cambios en tu página.
		</span>
		<button type="submit" form="ppe-form" class="ppe-btn ppe-btn-primary" data-ppe-save>
			<span class="material-symbols-rounded text-[1.15rem]" aria-hidden="true">save</span>
			Guardar perfil
		</button>
	</footer>

	<dialog class="ppe-crop-modal" data-ppe-crop-modal>
		<div class="ppe-crop-modal__head">
			<strong data-ppe-crop-title>Recortar logo</strong>
			<button type="button" class="ppe-icon-btn" data-ppe-crop-close aria-label="Cerrar">
				<span class="material-symbols-rounded" aria-hidden="true">close</span>
			</button>
		</div>
		<div class="ppe-crop-modal__mount" data-ppe-crop-mount></div>
		<div class="ppe-crop-modal__actions">
			<button type="button" class="ppe-btn ppe-btn-secondary" data-ppe-crop-close>Cancelar</button>
			<button type="button" class="ppe-btn ppe-btn-primary" data-ppe-crop-confirm>Usar foto</button>
		</div>
	</dialog>
</public-profile-editor>

<script>
	import { initializePublicProfileEditor } from '../scripts/public-profile-editor';

	const boot = () => {
		document.querySelectorAll<HTMLElement>('public-profile-editor[data-ppe-root]').forEach((el) => {
			initializePublicProfileEditor(el);
		});
	};

	boot();
	document.addEventListener('astro:page-load', boot);
</script>
