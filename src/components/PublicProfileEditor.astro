---
import {
	formatBusinessHoursForDisplay,
	parseBusinessHours,
} from '../lib/business-hours';
import type { PublicOrgHub } from '../lib/public-org-hub';
import { getPublicProfileSpecialtyLabel } from '../lib/public-profile-labels';
import type { WorkspaceSettingsData } from '../lib/workspace-settings-shared';
import { formatParaguayMobilePhoneInput } from '../lib/paraguay-phone';
import {
	buildOrgHubUrl,
	resolvePublicSiteOrigin,
} from '../lib/public-profile-url';
import PublicProfilePreview from './PublicProfilePreview';
import { FacebookIcon, InstagramIcon } from './hub-brand-icons';

interface Props {
	workspace: WorkspaceSettingsData;
	hub: PublicOrgHub | null;
	organizationName: string;
}

const DESC_MAX = 500;

const { workspace, hub, organizationName } = Astro.props;
const siteOrigin = resolvePublicSiteOrigin(Astro.url.origin);
const initialSlug = workspace.profile_slug || '';
const hubUrl = initialSlug ? buildOrgHubUrl(siteOrigin || Astro.url.origin, initialSlug) : '';
const domainLabel = (siteOrigin || Astro.url.origin).replace(/^https?:\/\//i, '').replace(/\/+$/, '');
const whatsappDigits = String(workspace.public_whatsapp || '').replace(/\D/g, '');
const whatsappLocal = whatsappDigits.startsWith('595')
	? whatsappDigits.slice(3)
	: whatsappDigits;
const whatsappLocalDisplay = formatParaguayMobilePhoneInput(whatsappLocal);
const descriptionValue = String(workspace.description || '').slice(0, DESC_MAX);
const galleryImages = workspace.gallery_images || [];
const facebookUrl = String(workspace.facebook_url || '').trim();
const instagramUrl = String(workspace.instagram_url || '').trim();
const bannerUrl = String(workspace.banner_url || '').trim();
const businessHours = parseBusinessHours(workspace.business_hours);
const businessHoursRows = formatBusinessHoursForDisplay(businessHours);

const initials = (() => {
	const parts = organizationName.trim().split(/\s+/).filter(Boolean);
	if (!parts.length) return '?';
	if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
	return `${parts[0][0] || ''}${parts[1][0] || ''}`.toUpperCase();
})();

const personInitials = (name: string) => {
	const parts = String(name || '')
		.trim()
		.split(/\s+/)
		.filter(Boolean);
	if (!parts.length) return '?';
	if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
	return `${parts[0][0] || ''}${parts[1][0] || ''}`.toUpperCase();
};

const previewProfessionals = (hub?.professionals || []).map((pro) => ({
	id: Number(pro.id_professional) || 0,
	fullName: String(pro.full_name || '').trim(),
	specialty: getPublicProfileSpecialtyLabel(pro.specialty) || 'Profesional',
	imageUrl: String(pro.image_url || '').trim(),
	initials: personInitials(pro.full_name),
}));

const previewLocations = (hub?.locations || []).map((loc) => ({
	id: Number(loc.id_location) || 0,
	name: String(loc.name || '').trim() || 'Sucursal',
	address: String(loc.address || '').trim(),
}));

const payload = {
	workspace: {
		...workspace,
		description: descriptionValue,
		gallery_images: galleryImages,
	},
	hub,
	organizationName,
	siteOrigin: siteOrigin || Astro.url.origin,
	domainLabel,
	descMax: DESC_MAX,
};
const serialized = JSON.stringify(payload).replace(/</g, '\\u003c');

const previewInitial = {
	organizationName,
	initials,
	description: descriptionValue,
	logoUrl: workspace.logo_url || '',
	bannerUrl,
	whatsappVisible: Boolean(whatsappLocal),
	facebookUrl,
	instagramUrl,
	galleryUrls: galleryImages.map((item) => item.url).filter(Boolean),
	serviceCategories: hub?.service_categories || [],
	profileSlug: initialSlug,
	locationLabel: (() => {
		const locs = hub?.locations || [];
		if (!locs.length) return '';
		if (locs.length === 1) {
			return String(locs[0]?.name || locs[0]?.address || '').trim();
		}
		return `${locs.length} sucursales`;
	})(),
	teamCount: previewProfessionals.length,
	professionals: previewProfessionals,
	locations: previewLocations,
	businessHoursRows,
};
---

<public-profile-editor data-ppe-root data-ppe-bootstrap={serialized}>
	<div class="ppe-page" data-ppe-page>
		<div class="ppe-layout">
			<div class="ppe-config-pane" data-ppe-config-pane>
				<header class="ppe-header">
					<nav class="ppe-tabs" role="tablist" aria-label="Secciones del perfil">
						<button
							type="button"
							class="ppe-tab is-active"
							role="tab"
							id="ppe-tab-general"
							aria-selected="true"
							aria-controls="ppe-panel-general"
							data-ppe-tab="general"
						>
							General
						</button>
						<button
							type="button"
							class="ppe-tab"
							role="tab"
							id="ppe-tab-apariencia"
							aria-selected="false"
							aria-controls="ppe-panel-apariencia"
							data-ppe-tab="apariencia"
							tabindex="-1"
						>
							Apariencia
						</button>
						<button
							type="button"
							class="ppe-tab"
							role="tab"
							id="ppe-tab-galeria"
							aria-selected="false"
							aria-controls="ppe-panel-galeria"
							data-ppe-tab="galeria"
							tabindex="-1"
						>
							Galería
						</button>
						<button
							type="button"
							class="ppe-tab"
							role="tab"
							id="ppe-tab-horario"
							aria-selected="false"
							aria-controls="ppe-panel-horario"
							data-ppe-tab="horario"
							tabindex="-1"
						>
							Horario
						</button>
					</nav>
					<div class="ppe-header__actions">
						<button
							type="button"
							class="ppe-btn ppe-btn-secondary ppe-preview-trigger--header"
							data-ppe-open-preview
							aria-label="Ver vista previa"
							title="Ver vista previa"
						>
							<span class="material-symbols-rounded text-[1.1rem]" aria-hidden="true">visibility</span>
							<span class="ppe-preview-trigger__label">Ver vista previa</span>
						</button>
						<a
							class="ppe-btn ppe-btn-secondary ppe-open-public"
							href={hubUrl || '#'}
							target="_blank"
							rel="noopener noreferrer"
							data-ppe-open-public
						>
							<span class="material-symbols-rounded text-[1.1rem]" aria-hidden="true">open_in_new</span>
							Ver página pública
						</a>
					</div>
				</header>

				<form class="ppe-form-col" id="ppe-form" data-ppe-form>
					<section
						class="ppe-panel"
						role="tabpanel"
						id="ppe-panel-general"
						aria-labelledby="ppe-tab-general"
						data-ppe-panel="general"
					>
						<div class="ppe-field">
							<span class="ppe-field__label">URL pública <span class="text-rose-500">*</span></span>
							<div class="ppe-slug-row" data-ppe-slug-row>
								<span class="ppe-slug-prefix" title={`${domainLabel}/`}>{domainLabel}/</span>
								<div class="ppe-slug-input-wrap">
									<input
										class="ppe-input"
										type="text"
										name="profile_slug"
										maxlength="100"
										required
										autocomplete="off"
										spellcheck="false"
										value={initialSlug}
										data-ppe-slug
										placeholder="mi-negocio"
									/>
									<span class="ppe-slug-inline-icon" data-ppe-slug-icon hidden aria-hidden="true">
										<span class="material-symbols-rounded">check_circle</span>
									</span>
								</div>
								<button
									type="button"
									class="ppe-icon-btn"
									data-ppe-copy-url
									aria-label="Copiar enlace"
									title="Copiar enlace"
								>
									<span class="material-symbols-rounded text-[1.1rem]" aria-hidden="true"
										>content_copy</span
									>
								</button>
							</div>
							<p class="ppe-slug-meta">
								<span class="ppe-slug-status is-pending" data-ppe-slug-status>Validando…</span>
								<span class="ppe-field__hint" data-ppe-slug-hint>Ej: {domainLabel}/mi-peluqueria</span>
							</p>
						</div>

						<div class="ppe-field">
							<label for="ppe-description">Descripción</label>
							<textarea
								id="ppe-description"
								class="ppe-textarea"
								name="description"
								maxlength={DESC_MAX}
								rows="4"
								placeholder="Contá qué hace tu negocio y por qué elegirte."
								data-ppe-description>{descriptionValue}</textarea
							>
							<span class="ppe-field__hint"
								><span data-ppe-desc-count>{descriptionValue.length}</span>/{DESC_MAX} caracteres</span
							>
						</div>

						<div class="ppe-switch-row">
							<div class="ppe-switch-row__text">
								<strong>Mostrar botón WhatsApp</strong>
								<span>Aparece en la cabecera del hub público.</span>
							</div>
							<label class="ppe-switch">
								<input type="checkbox" data-ppe-wa-toggle checked={Boolean(whatsappLocal)} />
								<span class="ppe-switch__track" aria-hidden="true"></span>
							</label>
						</div>

						<div class={`ppe-field ${whatsappLocal ? '' : 'hidden'}`} data-ppe-wa-field>
							<label for="ppe-whatsapp">Número de WhatsApp</label>
							<div class="ppe-phone-input">
								<span class="ppe-phone-input__prefix">+595</span>
								<input
									id="ppe-whatsapp"
									class="ppe-input ppe-phone-input__field"
									type="tel"
									inputmode="numeric"
									autocomplete="tel-national"
									name="public_whatsapp_local"
									maxlength="20"
									placeholder="981 123 456"
									value={whatsappLocalDisplay}
									data-ppe-whatsapp
								/>
							</div>
							<span class="ppe-field__hint">Sin el 0 inicial. Ej: 981 123 456</span>
						</div>

						<div class="ppe-field-grid ppe-field-grid--2">
							<div class="ppe-field">
								<label for="ppe-facebook">Facebook</label>
								<div class="ppe-social-input">
									<span class="ppe-social-input__icon" aria-hidden="true">
										<FacebookIcon />
									</span>
									<input
										id="ppe-facebook"
										class="ppe-input ppe-social-input__field"
										type="url"
										name="facebook_url"
										placeholder="https://facebook.com/tu-negocio"
										value={facebookUrl}
										data-ppe-facebook
									/>
								</div>
								<span class="ppe-field__hint">URL completa de tu página o perfil.</span>
							</div>

							<div class="ppe-field">
								<label for="ppe-instagram">Instagram</label>
								<div class="ppe-social-input">
									<span class="ppe-social-input__icon" aria-hidden="true">
										<InstagramIcon />
									</span>
									<input
										id="ppe-instagram"
										class="ppe-input ppe-social-input__field"
										type="url"
										name="instagram_url"
										placeholder="https://instagram.com/tu-negocio"
										value={instagramUrl}
										data-ppe-instagram
									/>
								</div>
								<span class="ppe-field__hint">URL completa de tu perfil.</span>
							</div>
						</div>
					</section>

					<section
						class="ppe-panel"
						role="tabpanel"
						id="ppe-panel-apariencia"
						aria-labelledby="ppe-tab-apariencia"
						data-ppe-panel="apariencia"
						hidden
					>
						<div class="ppe-field ppe-field--logo">
							<span class="ppe-field__label">Logo del negocio</span>
							<label
								class={`ppe-dropzone ppe-dropzone--logo ${workspace.logo_url ? 'has-preview' : ''}`}
								data-ppe-logo-dropzone
							>
								<input
									type="file"
									accept=".jpg,.jpeg,.png,image/jpeg,image/png"
									class="sr-only"
									data-ppe-logo-input
								/>
								<img
									src={workspace.logo_url || undefined}
									alt=""
									class={`ppe-dropzone__preview ppe-dropzone__preview--logo ${workspace.logo_url ? '' : 'hidden'}`}
									data-ppe-logo-preview
									width="88"
									height="88"
								/>
								<div
									class={`ppe-dropzone__empty ${workspace.logo_url ? 'hidden' : ''}`}
									data-ppe-logo-placeholder
								>
									<span class="material-symbols-rounded ppe-dropzone__icon" aria-hidden="true">image</span>
									<span class="ppe-dropzone__title">
										<span class="ppe-copy-desktop">Arrastrá tu logo aquí</span>
										<span class="ppe-copy-mobile">Tocá para subir tu logo</span>
									</span>
									<span class="ppe-dropzone__meta">JPG o PNG · máx. 5 MB</span>
									<span class="ppe-dropzone__btn">Seleccionar imagen</span>
								</div>
								<span
									class={`ppe-dropzone__change ${workspace.logo_url ? '' : 'hidden'}`}
									data-ppe-logo-change
								>
									<span class="ppe-copy-desktop">Hacé clic o arrastrá para cambiar</span>
									<span class="ppe-copy-mobile">Tocá para cambiar</span>
								</span>
								<button
									type="button"
									class={`ppe-dropzone__clear ${workspace.logo_url ? '' : 'hidden'}`}
									data-ppe-logo-clear
									aria-label="Eliminar logo"
								>
									<span class="material-symbols-rounded" aria-hidden="true">delete</span>
								</button>
							</label>
						</div>

						<div class="ppe-field">
							<span class="ppe-field__label">Banner del negocio</span>
							<label
								class={`ppe-dropzone ppe-dropzone--banner ${bannerUrl ? 'has-preview' : ''}`}
								data-ppe-banner-dropzone
							>
								<input
									type="file"
									accept=".jpg,.jpeg,.png,image/jpeg,image/png"
									class="sr-only"
									data-ppe-banner-input
								/>
								<img
									src={bannerUrl || undefined}
									alt=""
									class={`ppe-dropzone__preview ppe-dropzone__preview--banner ${bannerUrl ? '' : 'hidden'}`}
									data-ppe-banner-preview
								/>
								<div
									class={`ppe-dropzone__empty ${bannerUrl ? 'hidden' : ''}`}
									data-ppe-banner-placeholder
								>
									<span class="material-symbols-rounded ppe-dropzone__icon" aria-hidden="true">image</span>
									<span class="ppe-dropzone__title">
										<span class="ppe-copy-desktop">Arrastrá tu banner aquí</span>
										<span class="ppe-copy-mobile">Tocá para subir tu banner</span>
									</span>
									<span class="ppe-dropzone__meta">JPG o PNG · máx. 5 MB · 2:1</span>
									<span class="ppe-dropzone__btn">Seleccionar imagen</span>
								</div>
								<span
									class={`ppe-dropzone__change ${bannerUrl ? '' : 'hidden'}`}
									data-ppe-banner-change
								>
									<span class="ppe-copy-desktop">Hacé clic o arrastrá para cambiar</span>
									<span class="ppe-copy-mobile">Tocá para cambiar</span>
								</span>
								<button
									type="button"
									class={`ppe-dropzone__clear ${bannerUrl ? '' : 'hidden'}`}
									data-ppe-banner-clear
									aria-label="Eliminar banner"
								>
									<span class="material-symbols-rounded" aria-hidden="true">delete</span>
								</button>
							</label>
							<p class="ppe-field__hint">JPG o PNG. Recomendado 1200×600 o 1080×566.</p>
						</div>
					</section>

					<section
						class="ppe-panel"
						role="tabpanel"
						id="ppe-panel-galeria"
						aria-labelledby="ppe-tab-galeria"
						data-ppe-panel="galeria"
						hidden
					>
						<div class="ppe-field">
							<span class="ppe-field__label">
								Fotos del negocio
								<span data-ppe-gallery-count>({galleryImages.length})</span>
							</span>
							<p class="ppe-field__hint">
								Fotos (fachada, interior, servicios). Máximo 5 MB por imagen.
							</p>
							<ul class="ppe-gallery-grid" data-ppe-gallery-grid>
								{
									galleryImages.map((item) => (
										<li class="ppe-gallery-item" data-ppe-gallery-item data-id={item.id}>
											<button
												type="button"
												class="ppe-gallery-item__open"
												data-ppe-gallery-open
												data-id={item.id}
												aria-label="Ver foto"
											>
												<img src={item.url} alt="" />
											</button>
											<button
												type="button"
												class="ppe-gallery-item__remove"
												data-ppe-gallery-remove
												data-id={item.id}
												aria-label="Eliminar foto"
											>
												<span class="material-symbols-rounded" aria-hidden="true">delete</span>
											</button>
										</li>
									))
								}
							</ul>
							<label class="ppe-dropzone ppe-dropzone--gallery" data-ppe-gallery-add>
								<span class="material-symbols-rounded ppe-dropzone__icon" aria-hidden="true">image</span>
								<span class="ppe-dropzone__title">
									<span class="ppe-copy-desktop">Arrastrá fotos aquí</span>
									<span class="ppe-copy-mobile">Tocá para agregar fotos</span>
								</span>
								<span class="ppe-dropzone__meta">JPG o PNG · máx. 5 MB</span>
								<span class="ppe-dropzone__btn">Seleccionar imágenes</span>
								<input
									type="file"
									accept=".jpg,.jpeg,.png,image/jpeg,image/png"
									class="sr-only"
									data-ppe-gallery-input
									multiple
								/>
							</label>
						</div>
					</section>

					<section
						class="ppe-panel"
						role="tabpanel"
						id="ppe-panel-horario"
						aria-labelledby="ppe-tab-horario"
						data-ppe-panel="horario"
						hidden
					>
						<div class="ppe-field">
							<span class="ppe-field__label">Horario comercial</span>
							<p class="ppe-field__hint">
								Se muestra en el Overview del perfil. No afecta la disponibilidad de reservas.
							</p>
							<ul class="ppe-hours-list" data-ppe-hours-list></ul>
						</div>
					</section>
				</form>
			</div>

			<aside class="ppe-phone-col" data-ppe-phone-col aria-label="Vista previa">
				<PublicProfilePreview client:load initial={previewInitial} />
			</aside>
		</div>
	</div>

	<footer class="ppe-save-footer">
		<span class="ppe-field__hint ppe-save-footer__hint">
			Guardá para publicar los cambios en tu página.
		</span>
		<button type="submit" form="ppe-form" class="ppe-btn ppe-btn-primary" data-ppe-save>
			<span class="material-symbols-rounded text-[1.15rem]" aria-hidden="true">save</span>
			Guardar cambios
		</button>
	</footer>

	<dialog class="ppe-preview-modal" data-ppe-preview-modal aria-label="Vista previa del perfil público">
		<div class="ppe-preview-modal__bar">
			<button type="button" class="ppe-preview-modal__back" data-ppe-close-preview>
				<span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
				Volver a edición
			</button>
		</div>
		<div class="ppe-preview-modal__scroll">
			<PublicProfilePreview client:load initial={previewInitial} variant="live" />
		</div>
	</dialog>

	<dialog class="ppe-crop-modal" data-ppe-crop-modal>
		<div class="ppe-crop-modal__sheet" data-ppe-crop-sheet>
			<div class="ppe-crop-modal__handle" aria-hidden="true"><span></span></div>
			<div class="ppe-crop-modal__head">
				<div>
					<strong data-ppe-crop-title>Recortar logo</strong>
					<p class="ppe-crop-modal__hint" data-ppe-crop-hint>
						Arrastrá la imagen para centrarla y usá el control para acercar o alejar.
					</p>
				</div>
				<button type="button" class="ppe-icon-btn" data-ppe-crop-close aria-label="Cerrar">
					<span class="material-symbols-rounded" aria-hidden="true">close</span>
				</button>
			</div>
			<div class="ppe-crop-modal__mount" data-ppe-crop-mount></div>
			<div class="ppe-crop-modal__compress" data-ppe-crop-compress-wrap>
				<label class="ppe-check ppe-crop-modal__compress-check">
					<input type="checkbox" data-ppe-crop-compress />
					<span>Comprimir imagen</span>
				</label>
				<p class="ppe-field__hint" data-ppe-crop-compress-hint>
					Se mantiene la resolución; el perfil puede cargar más lento.
				</p>
			</div>
			<div class="ppe-crop-modal__actions">
				<button type="button" class="ppe-btn ppe-btn-secondary" data-ppe-crop-close>Cancelar</button>
				<button type="button" class="ppe-btn ppe-btn-primary" data-ppe-crop-confirm>Usar foto</button>
			</div>
		</div>
	</dialog>

	<dialog class="ppe-crop-modal ppe-gallery-preview-modal" data-ppe-gallery-preview-modal>
		<div class="ppe-crop-modal__sheet ppe-gallery-preview-modal__sheet">
			<div class="ppe-crop-modal__handle" aria-hidden="true"><span></span></div>
			<div class="ppe-crop-modal__head">
				<div>
					<strong data-ppe-gallery-preview-title>Vista previa</strong>
					<p class="ppe-gallery-preview-modal__sub" data-ppe-gallery-preview-sub>
						Revisá cada foto y elegí si comprimirla antes de subir.
					</p>
				</div>
				<button type="button" class="ppe-icon-btn" data-ppe-gallery-preview-close aria-label="Cerrar">
					<span class="material-symbols-rounded" aria-hidden="true">close</span>
				</button>
			</div>
			<ul class="ppe-gallery-preview-list" data-ppe-gallery-preview-list></ul>
			<div class="ppe-crop-modal__actions">
				<button type="button" class="ppe-btn ppe-btn-secondary" data-ppe-gallery-preview-close>
					Cancelar
				</button>
				<button type="button" class="ppe-btn ppe-btn-primary" data-ppe-gallery-preview-confirm>
					<span class="material-symbols-rounded text-[1.1rem]" aria-hidden="true">cloud_upload</span>
					<span data-ppe-gallery-preview-confirm-label>Subir fotos</span>
				</button>
			</div>
		</div>
	</dialog>

	<dialog class="ppe-lightbox" data-ppe-lightbox aria-label="Foto de la galería">
		<button type="button" class="ppe-lightbox__close" data-ppe-lightbox-close aria-label="Cerrar">
			<span class="material-symbols-rounded" aria-hidden="true">close</span>
		</button>
		<button type="button" class="ppe-lightbox__nav ppe-lightbox__nav--prev" data-ppe-lightbox-prev aria-label="Foto anterior">
			<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
		</button>
		<figure class="ppe-lightbox__figure">
			<img src="" alt="" data-ppe-lightbox-image />
			<figcaption class="ppe-lightbox__caption" data-ppe-lightbox-caption></figcaption>
		</figure>
		<button type="button" class="ppe-lightbox__nav ppe-lightbox__nav--next" data-ppe-lightbox-next aria-label="Foto siguiente">
			<span class="material-symbols-rounded" aria-hidden="true">chevron_right</span>
		</button>
	</dialog>
</public-profile-editor>

<script>
	import {
		ensurePublicProfileTabDelegation,
		initializePublicProfileEditor,
	} from '../scripts/public-profile-editor';

	let deferObserver: MutationObserver | null = null;

	const boot = () => {
		ensurePublicProfileTabDelegation();
		document.querySelectorAll<HTMLElement>('public-profile-editor[data-ppe-root]').forEach((el) => {
			initializePublicProfileEditor(el);
		});
		return Boolean(document.querySelector('public-profile-editor[data-ppe-root][data-ppe-bound="1"]'));
	};

	const watchUntilBound = () => {
		if (boot() || typeof MutationObserver === 'undefined') return;
		if (deferObserver) return;
		deferObserver = new MutationObserver(() => {
			if (!boot()) return;
			deferObserver?.disconnect();
			deferObserver = null;
		});
		if (document.body) {
			deferObserver.observe(document.body, { childList: true, subtree: true });
		}
	};

	watchUntilBound();
	document.addEventListener('astro:page-load', watchUntilBound);
	document.addEventListener('astro:after-swap', watchUntilBound);
</script>
