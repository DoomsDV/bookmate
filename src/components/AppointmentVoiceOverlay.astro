---
import { FEATURE_FLAGS } from '../config/feature-flags';
---

{FEATURE_FLAGS.APPOINTMENT_AI_VOICE && (
	<appointment-voice-overlay>
		<dialog
			class="appointment-voice-shell"
			data-voice-overlay-shell
			aria-label="Cita rápida por voz"
		>
			<div class="appointment-voice-dialog">
				<div class="appointment-voice-sheet-handle" aria-hidden="true">
					<span class="appointment-voice-sheet-handle__pill"></span>
				</div>

				<div class="appointment-voice-header">
					<div class="appointment-voice-title-wrap">
						<div class="appointment-voice-mark">
							<span class="material-symbols-rounded">auto_awesome</span>
						</div>
						<div>
							<h2 class="appointment-voice-title">Cita rápida</h2>
							<p class="appointment-voice-subtitle" data-voice-overlay-subtitle>Describe la cita con tu voz</p>
						</div>
					</div>
					<div class="appointment-voice-header-actions">
						<button
							type="button"
							class="appointment-voice-help"
							data-voice-overlay-tour-help
							aria-label="Guía de cita rápida por voz"
						>
							<span class="material-symbols-rounded" aria-hidden="true">help</span>
							<span class="appointment-voice-help__label">Guía</span>
						</button>
						<button
							type="button"
							class="appointment-voice-close"
							data-voice-overlay-close
							aria-label="Cerrar"
						>
							<span class="material-symbols-rounded">close</span>
						</button>
					</div>
				</div>

				<div class="appointment-voice-tabs" role="tablist" aria-label="Modo de cita rápida">
					<button
						type="button"
						class="appointment-voice-tab is-active"
						data-voice-overlay-tab="voice"
						role="tab"
						aria-selected="true"
					>
						<span class="material-symbols-rounded" aria-hidden="true">mic</span>
						<span>Por voz</span>
					</button>
					<button
						type="button"
						class="appointment-voice-tab"
						data-voice-overlay-tab="scan"
						role="tab"
						aria-selected="false"
					>
						<span class="material-symbols-rounded" aria-hidden="true">photo_camera</span>
						<span>Escanear agenda</span>
						<span class="appointment-voice-tab__badge" aria-hidden="true">Nuevo</span>
					</button>
				</div>

				<div class="appointment-voice-body">
					<p class="appointment-voice-status" data-voice-overlay-status>
						Toca el micrófono y describe la cita.
					</p>

					<div class="appointment-voice-scan" data-voice-overlay-scan>
						<label class="appointment-voice-scan__dropzone" data-voice-overlay-dropzone>
							<input
								type="file"
								accept="image/*"
								class="appointment-voice-scan__input"
								data-voice-overlay-scan-input
								hidden
							/>
							<span class="appointment-voice-scan__icon material-symbols-rounded" aria-hidden="true">
								add_a_photo
							</span>
							<span class="appointment-voice-scan__title">Tomá o subí una foto de tu agenda</span>
							<span class="appointment-voice-scan__hint">
								La IA leerá las citas escritas a mano. JPG, PNG o WEBP.
							</span>
							<span class="appointment-voice-scan__cta">Elegir imagen</span>
						</label>
					</div>
					<div class="appointment-voice-transcript-wrap hidden" data-voice-overlay-transcript-wrap>
						<p class="appointment-voice-transcript-label">Escuché</p>
						<p class="appointment-voice-transcript" data-voice-overlay-transcript></p>
					</div>
					<p class="appointment-voice-error hidden" data-voice-overlay-error role="alert"></p>

					<div class="appointment-voice-processing hidden" data-voice-overlay-processing>
						<div class="appointment-voice-processing__visual" aria-hidden="true">
							<span class="appointment-voice-processing__glow"></span>
							<span class="appointment-voice-processing__sparkle material-symbols-rounded">auto_awesome</span>
							<span class="appointment-voice-processing__spinner"></span>
						</div>
						<span class="appointment-voice-processing__shimmer" data-voice-overlay-processing-label>
							Transcribiendo y completando datos…
						</span>
					</div>

					<div class="appointment-voice-stage" data-voice-overlay-stage>
						<div class="appointment-voice-visual" data-voice-overlay-visualizer data-visualizer-mode="idle">
							<div class="appointment-voice-visual__aura" aria-hidden="true">
								<span class="appointment-voice-visual__blob appointment-voice-visual__blob--blue"></span>
								<span class="appointment-voice-visual__blob appointment-voice-visual__blob--red"></span>
								<span class="appointment-voice-visual__blob appointment-voice-visual__blob--yellow"></span>
								<span class="appointment-voice-visual__blob appointment-voice-visual__blob--green"></span>
							</div>
							<div class="appointment-voice-visual__magic" data-voice-magic aria-hidden="true">
								<span class="appointment-voice-visual__magic-bloom appointment-voice-visual__magic-bloom--blue"></span>
								<span class="appointment-voice-visual__magic-bloom appointment-voice-visual__magic-bloom--violet"></span>
								<span class="appointment-voice-visual__magic-bloom appointment-voice-visual__magic-bloom--gold"></span>
								<span class="appointment-voice-visual__magic-bloom appointment-voice-visual__magic-bloom--green"></span>
								<span class="appointment-voice-visual__magic-core"></span>
								<span class="appointment-voice-visual__magic-shine"></span>
							</div>
						</div>
					</div>

					<div
						class="appointment-voice-livebar hidden"
						data-voice-overlay-livebar
						aria-live="polite"
						aria-atomic="true"
					>
						<span class="appointment-voice-livebar__dot" aria-hidden="true"></span>
						<span class="appointment-voice-livebar__label" data-voice-overlay-live-label>Escuchando…</span>
						<span class="appointment-voice-livebar__timer" data-voice-overlay-timer>00:00</span>
					</div>

					<div class="appointment-voice-controls" data-voice-overlay-controls>
						<button
							type="button"
							class="appointment-voice-ctrl appointment-voice-ctrl--side"
							data-voice-overlay-restart
							aria-label="Reiniciar grabación"
							disabled
						>
							<span class="material-symbols-rounded" aria-hidden="true">replay</span>
						</button>

						<button
							type="button"
							class="appointment-voice-ctrl appointment-voice-ctrl--primary"
							data-voice-overlay-record
							aria-label="Empezar a grabar"
						>
							<span
								class="appointment-voice-ctrl__icon material-symbols-rounded"
								data-voice-overlay-primary-icon
								aria-hidden="true"
							>mic</span>
						</button>

						<button
							type="button"
							class="appointment-voice-ctrl appointment-voice-ctrl--side appointment-voice-ctrl--stop"
							data-voice-overlay-stop
							aria-label="Terminar y procesar"
							disabled
						>
							<span class="appointment-voice-ctrl__stop" aria-hidden="true"></span>
						</button>
					</div>

					<div class="appointment-voice-actions hidden" data-voice-overlay-actions>
						<button type="button" class="appointment-voice-continue" data-voice-overlay-continue>
							Ir al calendario
						</button>
					</div>
				</div>
			</div>
		</dialog>
	</appointment-voice-overlay>
)}

<style is:global>
	appointment-voice-overlay {
		display: block;
	}

	.appointment-voice-shell {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		top: auto;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		box-sizing: border-box;
		width: 100vw;
		max-width: none;
		height: min(72dvh, calc(100dvh - 1.5rem));
		max-height: min(72dvh, calc(100dvh - 1.5rem));
		overflow: visible;
		overscroll-behavior: contain;
		color: var(--on-surface);
	}

	.appointment-voice-shell[open]:not(.is-settled) {
		display: block;
		will-change: transform, opacity;
	}

	.appointment-voice-shell[open].is-settled {
		display: block;
		will-change: auto;
	}

	@media (max-width: 639px) {
		.appointment-voice-shell::backdrop {
			background: var(--modal-backdrop-scrim);
			backdrop-filter: blur(var(--modal-backdrop-blur));
			-webkit-backdrop-filter: blur(var(--modal-backdrop-blur));
		}

		.appointment-voice-dialog {
			max-height: min(72dvh, calc(100dvh - 1.5rem));
			padding-bottom: max(1rem, calc(env(safe-area-inset-bottom, 0px) + 0.65rem));
		}

		.appointment-voice-controls {
			flex-shrink: 0;
			padding-bottom: 0.5rem;
		}
	}

	.appointment-voice-shell[open] {
		animation: appointment-voice-sheet-in var(--modal-open-duration, 150ms) var(--modal-easing, cubic-bezier(0.4, 0, 0.2, 1));
	}

	.appointment-voice-shell[open]::backdrop {
		animation: appointment-voice-backdrop-in var(--modal-open-duration, 150ms) var(--modal-easing, cubic-bezier(0.4, 0, 0.2, 1));
	}

	.appointment-voice-shell[open]:not(.is-settled)::backdrop {
		will-change: opacity;
	}

	.appointment-voice-shell[open].is-settled::backdrop {
		will-change: auto;
	}

	.appointment-voice-shell.is-closing {
		animation: appointment-voice-sheet-out 100ms var(--modal-easing, cubic-bezier(0.4, 0, 0.2, 1)) forwards;
	}

	.appointment-voice-shell.is-closing::backdrop {
		animation: appointment-voice-backdrop-out 100ms var(--modal-easing, cubic-bezier(0.4, 0, 0.2, 1)) forwards;
	}

	.appointment-voice-dialog {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100%;
		max-height: min(72dvh, calc(100dvh - 1.5rem));
		min-height: 0;
		overflow: hidden;
		border-radius: 1.8rem 1.8rem 0 0;
		border: 1px solid var(--shell-border);
		border-bottom: 0;
		background: var(--surface-bright);
		box-shadow: 0 -18px 60px rgba(15, 23, 42, 0.18);
		padding-bottom: max(0.55rem, env(safe-area-inset-bottom, 0px));
	}

	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-dialog,
	appointment-voice-overlay[data-voice-state='collapsing'] .appointment-voice-dialog,
	appointment-voice-overlay[data-voice-state='processing'] .appointment-voice-dialog {
		border-color: color-mix(in srgb, var(--primary) 28%, var(--shell-border));
		box-shadow:
			0 -18px 60px rgba(15, 23, 42, 0.2),
			0 0 48px color-mix(in srgb, #4285f4 14%, transparent);
	}

	.appointment-voice-sheet-handle {
		display: flex;
		justify-content: center;
		padding: 0.55rem 0 0.15rem;
	}

	.appointment-voice-sheet-handle__pill {
		width: 2.35rem;
		height: 0.28rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--on-surface-variant) 42%, transparent);
	}

	@media (min-width: 640px) {
		/* Drawer solo a la derecha (como Servicios): sin capa oscura a la izquierda */
		dialog.appointment-voice-shell {
			inset: 0 0 0 auto;
			left: auto;
			right: 0;
			top: 0;
			bottom: 0;
			width: min(32rem, 100vw);
			max-width: min(32rem, 100vw);
			height: 100%;
			max-height: none;
			transform: none;
			overflow: hidden;
			border-radius: 0;
			background: transparent;
			box-shadow: none;
		}

		dialog.appointment-voice-shell[open] {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			justify-content: stretch;
			animation: appointment-voice-drawer-in var(--modal-open-duration, 180ms)
				var(--modal-easing, cubic-bezier(0.2, 0, 0, 1));
		}

		dialog.appointment-voice-shell.is-closing {
			animation: appointment-voice-drawer-out 140ms
				var(--modal-easing, cubic-bezier(0.4, 0, 0.2, 1)) forwards;
		}

		dialog.appointment-voice-shell[open]::backdrop,
		dialog.appointment-voice-shell.is-closing::backdrop {
			animation: none;
		}

		.appointment-voice-dialog {
			width: 100%;
			max-width: none;
			flex: 1 1 auto;
			height: 100%;
			min-height: 0;
			max-height: none;
			border-radius: 0;
			border: 0;
			border-left: 1px solid var(--shell-border);
			box-shadow: -18px 0 50px rgba(15, 23, 42, 0.16);
			padding-bottom: 0;
			background: var(--surface-bright);
			animation: none;
		}

		.appointment-voice-shell.is-closing .appointment-voice-dialog {
			animation: none;
		}

		.appointment-voice-body {
			padding: 1.25rem 1.2rem 1.4rem;
			gap: 1rem;
		}

		.appointment-voice-stage {
			flex: 1 1 auto;
			min-height: 17rem;
			--magic-height: 11.5rem;
		}

		.appointment-voice-sheet-handle {
			display: none;
		}

		/* Blur translúcido con token compartido (menor costo en PC). */
		dialog.appointment-voice-shell::backdrop {
			background: var(--modal-backdrop-scrim);
			backdrop-filter: blur(var(--modal-backdrop-blur));
			-webkit-backdrop-filter: blur(var(--modal-backdrop-blur));
		}

		appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-dialog,
		appointment-voice-overlay[data-voice-state='collapsing'] .appointment-voice-dialog,
		appointment-voice-overlay[data-voice-state='processing'] .appointment-voice-dialog {
			border-left-color: color-mix(in srgb, var(--primary) 45%, var(--shell-border));
			box-shadow:
				-18px 0 50px rgba(15, 23, 42, 0.18),
				0 0 48px color-mix(in srgb, #4285f4 14%, transparent);
		}
	}

	@keyframes appointment-voice-sheet-in {
		from {
			opacity: 0;
			transform: translateY(100%);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes appointment-voice-sheet-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(100%);
		}
	}

	@keyframes appointment-voice-drawer-in {
		from {
			opacity: 0;
			transform: translateX(100%);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@keyframes appointment-voice-drawer-out {
		from {
			opacity: 1;
			transform: translateX(0);
		}
		to {
			opacity: 0;
			transform: translateX(100%);
		}
	}

	@keyframes appointment-voice-backdrop-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes appointment-voice-backdrop-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

	.appointment-voice-header {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.65rem 1.25rem 1rem;
		border-bottom: 1px solid color-mix(in srgb, var(--shell-border) 72%, transparent);
	}

	.appointment-voice-title-wrap {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		min-width: 0;
		flex: 1;
	}

	.appointment-voice-mark {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 1rem;
		background: color-mix(in srgb, var(--primary) 14%, transparent);
		color: var(--primary);
	}

	.appointment-voice-title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 800;
		color: var(--on-surface);
		line-height: 1.2;
	}

	.appointment-voice-subtitle {
		margin: 0.15rem 0 0;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--on-surface-variant);
		line-height: 1.35;
	}

	.appointment-voice-header-actions {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-shrink: 0;
	}

	.appointment-voice-help {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		height: 2.25rem;
		padding: 0 0.85rem;
		border: 1px solid var(--shell-border);
		border-radius: 999px;
		background: var(--surface-bright);
		color: var(--on-surface-variant);
		font-size: 0.82rem;
		font-weight: 700;
		cursor: pointer;
		transition:
			border-color 160ms ease,
			color 160ms ease,
			background 160ms ease;
	}

	.appointment-voice-help .material-symbols-rounded {
		font-size: 1.05rem;
	}

	.appointment-voice-help:hover {
		border-color: color-mix(in srgb, var(--primary) 35%, var(--shell-border));
		color: var(--primary);
	}

	.appointment-voice-close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.35rem;
		height: 2.35rem;
		border: 1px solid color-mix(in srgb, var(--on-surface) 10%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-variant) 72%, transparent);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		color: var(--on-surface-variant);
		cursor: pointer;
		transition:
			background 160ms ease,
			color 160ms ease,
			border-color 160ms ease;
	}

	.appointment-voice-close:hover {
		background: color-mix(in srgb, var(--surface-variant) 92%, transparent);
		border-color: color-mix(in srgb, var(--on-surface) 18%, transparent);
		color: var(--on-surface);
	}

	.appointment-voice-tabs {
		position: relative;
		z-index: 1;
		display: flex;
		gap: 0.3rem;
		margin: 0.6rem 1.15rem 0;
		padding: 0.25rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-variant) 70%, transparent);
		border: 1px solid color-mix(in srgb, var(--shell-border) 70%, transparent);
	}

	.appointment-voice-tab {
		flex: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		padding: 0.5rem 0.6rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--on-surface-variant);
		font-size: 0.85rem;
		font-weight: 700;
		cursor: pointer;
		transition: background 150ms ease, color 150ms ease, box-shadow 150ms ease;
	}

	.appointment-voice-tab .material-symbols-rounded {
		font-size: 1.1rem;
	}

	.appointment-voice-tab.is-active {
		background: var(--surface-bright);
		color: var(--primary);
		box-shadow: 0 2px 8px rgba(15, 23, 42, 0.1);
	}

	.appointment-voice-tab__badge {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
		padding: 0.12rem 0.42rem;
		border-radius: 999px;
		font-size: 0.58rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		line-height: 1.15;
		background: color-mix(in srgb, var(--primary) 14%, transparent);
		color: var(--primary);
	}

	.appointment-voice-tab.is-active .appointment-voice-tab__badge {
		background: color-mix(in srgb, var(--primary) 18%, transparent);
	}

	.appointment-voice-body {
		position: relative;
		z-index: 1;
		display: flex;
		flex: 1;
		min-height: 0;
		flex-direction: column;
		align-items: center;
		gap: 0.7rem;
		padding: 0.85rem 1.15rem 1rem;
		text-align: center;
		overflow: hidden;
	}

	/* Escaneo de agenda: zona de captura */
	.appointment-voice-scan {
		display: none;
		width: 100%;
		flex: 1;
		min-height: 0;
		align-items: center;
		justify-content: center;
	}

	.appointment-voice-scan__dropzone {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		width: 100%;
		max-width: 24rem;
		min-height: 12rem;
		padding: 1.5rem 1.25rem;
		border-radius: 1.35rem;
		border: 2px dashed color-mix(in srgb, var(--primary) 42%, var(--shell-border));
		background: color-mix(in srgb, var(--primary) 6%, transparent);
		color: var(--on-surface-variant);
		cursor: pointer;
		text-align: center;
		transition: border-color 150ms ease, background 150ms ease, transform 150ms ease;
	}

	.appointment-voice-scan__dropzone:hover,
	.appointment-voice-scan__dropzone.is-dragover {
		border-color: var(--primary);
		background: color-mix(in srgb, var(--primary) 12%, transparent);
	}

	.appointment-voice-scan__icon {
		font-size: 2.6rem;
		color: var(--primary);
	}

	.appointment-voice-scan__title {
		font-size: 0.98rem;
		font-weight: 800;
		color: var(--on-surface);
	}

	.appointment-voice-scan__hint {
		font-size: 0.82rem;
		font-weight: 600;
		max-width: 20rem;
		line-height: 1.35;
	}

	.appointment-voice-scan__cta {
		margin-top: 0.35rem;
		padding: 0.5rem 1.1rem;
		border-radius: 999px;
		background: var(--primary);
		color: #f8fbff;
		font-size: 0.85rem;
		font-weight: 800;
	}

	/* Mostrar/ocultar según modo */
	appointment-voice-overlay[data-voice-mode='scan'] .appointment-voice-status,
	appointment-voice-overlay[data-voice-mode='scan'] .appointment-voice-stage,
	appointment-voice-overlay[data-voice-mode='scan'] .appointment-voice-controls,
	appointment-voice-overlay[data-voice-mode='scan'] .appointment-voice-livebar,
	appointment-voice-overlay[data-voice-mode='scan'] .appointment-voice-transcript-wrap {
		display: none !important;
	}

	appointment-voice-overlay[data-voice-mode='scan'][data-voice-state='idle'] .appointment-voice-scan {
		display: flex;
	}

	appointment-voice-overlay[data-voice-mode='scan'] .appointment-voice-controls {
		display: none !important;
	}

	.appointment-voice-status {
		margin: 0;
		max-width: 22rem;
		min-height: 1.35em;
		font-size: 1.05rem;
		font-weight: 750;
		line-height: 1.4;
		color: color-mix(in srgb, var(--on-surface) 86%, var(--on-surface-variant) 14%);
		opacity: 1;
		transform: translateY(0);
		transition:
			opacity 180ms ease,
			transform 180ms ease,
			color 180ms ease;
	}

	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-status,
	appointment-voice-overlay[data-voice-state='paused'] .appointment-voice-status {
		display: none;
	}

	.appointment-voice-status.is-leaving {
		opacity: 0;
		transform: translateY(-4px);
	}

	.appointment-voice-status.is-entering {
		opacity: 0;
		transform: translateY(4px);
	}

	.appointment-voice-transcript-wrap {
		width: 100%;
		padding: 0.85rem 1rem;
		border-radius: 1rem;
		border: 1px solid var(--shell-border);
		background: var(--surface-variant);
		text-align: left;
	}

	.appointment-voice-transcript-wrap.hidden {
		display: none;
	}

	.appointment-voice-transcript-label {
		margin: 0 0 0.35rem;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--on-surface-variant);
	}

	.appointment-voice-transcript {
		margin: 0;
		max-width: 100%;
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.45;
		color: var(--on-surface);
	}

	.appointment-voice-error {
		margin: 0;
		font-size: 0.88rem;
		font-weight: 700;
		color: #e11d48;
	}

	.appointment-voice-status.hidden {
		display: none;
	}

	.appointment-voice-processing {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.85rem;
		width: 100%;
		min-height: 0;
	}

	.appointment-voice-processing__visual {
		position: relative;
		display: grid;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
	}

	.appointment-voice-processing__glow {
		position: absolute;
		inset: 0;
		border-radius: 999px;
		background: radial-gradient(
			circle,
			color-mix(in srgb, #67e8f9 28%, transparent) 0%,
			color-mix(in srgb, #a78bfa 18%, transparent) 45%,
			transparent 72%
		);
		filter: blur(10px);
		animation: appointment-voice-breathe 2.8s ease-in-out infinite;
	}

	.appointment-voice-processing__sparkle {
		position: absolute;
		z-index: 1;
		font-size: 1.15rem;
		color: color-mix(in srgb, #67e8f9 70%, #c4b5fd 30%);
		opacity: 0.85;
		animation: appointment-voice-breathe 2.8s ease-in-out infinite;
	}

	.appointment-voice-processing__spinner {
		position: relative;
		z-index: 2;
		width: 2.35rem;
		height: 2.35rem;
		border-radius: 999px;
		background: conic-gradient(
			from 0deg,
			transparent 0deg 40deg,
			#67e8f9 80deg,
			#818cf8 160deg,
			#a78bfa 220deg,
			#22d3ee 300deg,
			transparent 340deg 360deg
		);
		animation: appointment-voice-spin 0.95s linear infinite;
		mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2.5px));
		-webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2.5px));
	}

	.appointment-voice-processing__shimmer {
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1.4;
		text-align: center;
		background: linear-gradient(
			110deg,
			color-mix(in srgb, var(--on-surface-variant) 92%, transparent) 0%,
			color-mix(in srgb, var(--on-surface-variant) 92%, transparent) 36%,
			#bae6fd 46%,
			#c4b5fd 50%,
			#bae6fd 54%,
			color-mix(in srgb, var(--on-surface-variant) 92%, transparent) 64%,
			color-mix(in srgb, var(--on-surface-variant) 92%, transparent) 100%
		);
		background-size: 220% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: appointment-voice-shimmer 2.4s ease-in-out infinite;
	}

	.appointment-voice-processing.hidden,
	.appointment-voice-transcript-wrap.hidden,
	.appointment-voice-error.hidden,
	.appointment-voice-actions.hidden,
	.appointment-voice-livebar.hidden,
	.appointment-voice-controls[hidden] {
		display: none;
	}

	.appointment-voice-actions {
		width: 100%;
		margin-top: auto;
	}

	.appointment-voice-continue {
		width: 100%;
		border: 0;
		border-radius: 999px;
		padding: 0.85rem 1.2rem;
		font-size: 0.92rem;
		font-weight: 800;
		color: #f8fbff;
		background: var(--primary);
		box-shadow: 0 4px 14px rgba(15, 23, 42, 0.12);
		cursor: pointer;
		transition: background-color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
	}

	.appointment-voice-continue:hover {
		transform: translateY(-1px);
		background: color-mix(in srgb, var(--primary) 92%, #000 8%);
	}

	.appointment-voice-livebar {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		width: min(100%, 22rem);
		padding: 0.15rem 0.25rem;
		margin-top: auto;
	}

	.appointment-voice-livebar__dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: #ef4444;
		box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.45);
		animation: appointment-voice-live-dot 1.35s ease-out infinite;
		flex-shrink: 0;
	}

	appointment-voice-overlay[data-voice-state='paused'] .appointment-voice-livebar__dot {
		background: #f59e0b;
		animation: none;
		box-shadow: none;
	}

	.appointment-voice-livebar__label {
		flex: 1;
		min-width: 0;
		text-align: left;
		font-size: 0.92rem;
		font-weight: 700;
		color: color-mix(in srgb, var(--on-surface) 88%, var(--on-surface-variant) 12%);
	}

	.appointment-voice-livebar__timer {
		font-size: 0.92rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.04em;
		color: color-mix(in srgb, var(--on-surface) 78%, var(--on-surface-variant) 22%);
	}

	.appointment-voice-livebar__timer.is-near-limit {
		color: #e11d48;
	}

	.appointment-voice-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.7rem;
		width: min(100%, 22rem);
		padding: 0.15rem 0 0.35rem;
	}

	.appointment-voice-ctrl {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid color-mix(in srgb, var(--on-surface) 12%, transparent);
		background:
			linear-gradient(
				165deg,
				color-mix(in srgb, #ffffff 72%, var(--surface-variant) 28%),
				color-mix(in srgb, var(--surface-variant) 88%, #ffffff 12%)
			);
		color: var(--on-surface);
		box-shadow:
			0 10px 28px rgba(15, 23, 42, 0.1),
			inset 0 1px 0 color-mix(in srgb, #ffffff 35%, transparent);
		cursor: pointer;
		transition:
			transform 160ms ease,
			background 160ms ease,
			border-color 160ms ease,
			opacity 160ms ease,
			box-shadow 160ms ease;
	}

	/* Blur glass solo al grabar: en idle el backdrop-filter suma costo al abrir. */
	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-ctrl,
	appointment-voice-overlay[data-voice-state='paused'] .appointment-voice-ctrl {
		background:
			linear-gradient(
				165deg,
				color-mix(in srgb, #ffffff 28%, transparent),
				color-mix(in srgb, var(--surface-variant) 55%, transparent)
			);
		backdrop-filter: blur(10px) saturate(1.25);
		-webkit-backdrop-filter: blur(10px) saturate(1.25);
	}

	.appointment-voice-ctrl--side {
		width: 3.55rem;
		height: 3.55rem;
		border-radius: 1.2rem;
		flex-shrink: 0;
	}

	.appointment-voice-ctrl--side .material-symbols-rounded {
		font-size: 1.45rem;
	}

	.appointment-voice-ctrl--primary {
		flex: 1;
		height: 3.7rem;
		border-radius: 1.45rem;
		min-width: 0;
	}

	.appointment-voice-ctrl__icon {
		font-size: 1.7rem;
		line-height: 1;
	}

	.appointment-voice-ctrl__stop {
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 0.22rem;
		background: #ef4444;
		box-shadow: 0 0 12px rgba(239, 68, 68, 0.35);
	}

	.appointment-voice-ctrl--stop {
		color: #ef4444;
	}

	.appointment-voice-ctrl:hover:not(:disabled) {
		transform: translateY(-1px);
		border-color: color-mix(in srgb, var(--on-surface) 20%, transparent);
		box-shadow:
			0 14px 32px rgba(15, 23, 42, 0.14),
			inset 0 1px 0 color-mix(in srgb, #ffffff 42%, transparent);
	}

	.appointment-voice-ctrl:active:not(:disabled) {
		transform: translateY(0);
	}

	.appointment-voice-ctrl:disabled {
		opacity: 0.38;
		cursor: not-allowed;
		box-shadow: none;
	}

	.appointment-voice-ctrl:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 48%, white 52%);
		outline-offset: 3px;
	}

	appointment-voice-overlay[data-voice-state='idle'] .appointment-voice-ctrl--primary {
		background:
			linear-gradient(145deg, #4f7cf2 0%, #365ed6 100%) padding-box,
			conic-gradient(from 210deg, #4285f4, #a142f4, #ea4335, #fbbc05, #34a853, #4285f4) border-box;
		border: 2px solid transparent;
		color: #f8fbff;
		box-shadow:
			0 10px 26px rgba(66, 133, 244, 0.28),
			inset 0 1px 0 rgba(255, 255, 255, 0.28);
	}

	/* Pulse solo tras settle: no competir con la animación de apertura. */
	appointment-voice-overlay[data-voice-state='idle']:has(.appointment-voice-shell[open].is-settled)
		.appointment-voice-ctrl--primary {
		animation: appointment-voice-mic-button-pulse 2.4s ease-in-out infinite;
	}

	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-ctrl--primary,
	appointment-voice-overlay[data-voice-state='paused'] .appointment-voice-ctrl--primary {
		background:
			linear-gradient(
				165deg,
				color-mix(in srgb, #ffffff 34%, transparent),
				color-mix(in srgb, var(--surface-variant) 48%, transparent)
			);
		color: var(--on-surface);
		animation: none;
	}

	.appointment-voice-stage {
		position: relative;
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		width: calc(100% + 2.5rem);
		margin-inline: -1.25rem;
		min-height: 0;
		margin-top: 0.15rem;
		padding-inline: 0;
		--voice-level: 0.16;
		--magic-height: 7.5rem;
	}

	.appointment-voice-visual {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 100%;
		height: var(--magic-height);
		pointer-events: none;
		overflow: visible;
		isolation: isolate;
	}

	.appointment-voice-visual::before {
		content: '';
		position: absolute;
		z-index: 0;
		width: min(22rem, calc(100% - 1rem));
		height: 8rem;
		border-radius: 999px;
		background:
			radial-gradient(circle at 28% 52%, rgba(66, 133, 244, 0.28), transparent 42%),
			radial-gradient(circle at 50% 48%, rgba(161, 66, 244, 0.24), transparent 40%),
			radial-gradient(circle at 70% 56%, rgba(251, 188, 5, 0.2), transparent 42%),
			radial-gradient(circle at 82% 48%, rgba(52, 168, 83, 0.18), transparent 44%);
		filter: blur(22px) saturate(1.25);
		opacity: calc(0.28 + var(--voice-level, 0.16) * 0.55);
		transform: scale(calc(0.96 + var(--voice-level, 0.16) * 0.22));
		transition: opacity 140ms ease, transform 140ms ease;
	}

	.appointment-voice-visual__aura {
		position: absolute;
		inset: -2% 6%;
		z-index: 0;
		opacity: 0.36;
		transition: opacity 220ms ease;
	}

	.appointment-voice-visual__blob {
		position: absolute;
		border-radius: 42% 58% 62% 38% / 38% 42% 58% 62%;
		filter: blur(28px);
		opacity: 0.54;
		animation: appointment-voice-blob-drift 9s ease-in-out infinite;
	}

	/* Pausar blobs/magic cuando no se graba ni procesa (idle consume GPU). */
	appointment-voice-overlay:not([data-voice-state='recording']):not([data-voice-state='processing']) .appointment-voice-visual__blob,
	appointment-voice-overlay:not([data-voice-state='recording']):not([data-voice-state='processing']) .appointment-voice-visual__magic,
	appointment-voice-overlay:not([data-voice-state='recording']):not([data-voice-state='processing']) .appointment-voice-visual__magic::before,
	appointment-voice-overlay:not([data-voice-state='recording']):not([data-voice-state='processing']) .appointment-voice-visual__magic::after {
		animation-play-state: paused;
	}

	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-visual__blob,
	appointment-voice-overlay[data-voice-state='processing'] .appointment-voice-visual__blob {
		will-change: transform, opacity;
	}

	.appointment-voice-visual__blob--blue {
		inset: 6% 4% 28% 38%;
		background: radial-gradient(circle at 40% 40%, rgba(66, 133, 244, 0.95), rgba(66, 133, 244, 0.2) 62%, transparent 78%);
		animation-duration: 8.2s;
	}

	.appointment-voice-visual__blob--red {
		inset: 18% 36% 8% 4%;
		background: radial-gradient(circle at 55% 45%, rgba(234, 67, 53, 0.88), rgba(234, 67, 53, 0.18) 60%, transparent 78%);
		animation-duration: 10.4s;
		animation-direction: reverse;
	}

	.appointment-voice-visual__blob--yellow {
		inset: 28% 8% 4% 28%;
		background: radial-gradient(circle at 50% 50%, rgba(251, 188, 5, 0.9), rgba(251, 188, 5, 0.2) 58%, transparent 76%);
		animation-duration: 9.6s;
	}

	.appointment-voice-visual__blob--green {
		inset: 4% 28% 34% 8%;
		background: radial-gradient(circle at 45% 35%, rgba(52, 168, 83, 0.88), rgba(52, 168, 83, 0.18) 58%, transparent 76%);
		animation-duration: 11.2s;
		animation-direction: reverse;
	}

	.appointment-voice-visual[data-visualizer-mode='idle'] .appointment-voice-visual__aura {
		opacity: 0.2;
	}

	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-visual__aura,
	.appointment-voice-visual[data-visualizer-mode='live'] .appointment-voice-visual__aura {
		opacity: calc(0.58 + var(--voice-level, 0.2) * 0.42);
	}

	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-visual__blob,
	.appointment-voice-visual[data-visualizer-mode='live'] .appointment-voice-visual__blob {
		opacity: calc(0.62 + var(--voice-level, 0.2) * 0.38);
		filter: blur(calc(18px - var(--voice-level, 0.2) * 6px));
		animation-name: appointment-voice-blob-drift-live;
		animation-duration: calc(4.2s - var(--voice-level, 0.2) * 2.1s);
		animation-timing-function: ease-in-out;
	}

	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-visual__blob--blue,
	.appointment-voice-visual[data-visualizer-mode='live'] .appointment-voice-visual__blob--blue {
		animation-duration: calc(3.6s - var(--voice-level, 0.2) * 1.8s);
	}

	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-visual__blob--red,
	.appointment-voice-visual[data-visualizer-mode='live'] .appointment-voice-visual__blob--red {
		animation-duration: calc(4.4s - var(--voice-level, 0.2) * 2s);
	}

	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-visual__blob--yellow,
	.appointment-voice-visual[data-visualizer-mode='live'] .appointment-voice-visual__blob--yellow {
		animation-duration: calc(3.9s - var(--voice-level, 0.2) * 1.9s);
	}

	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-visual__blob--green,
	.appointment-voice-visual[data-visualizer-mode='live'] .appointment-voice-visual__blob--green {
		animation-duration: calc(4.8s - var(--voice-level, 0.2) * 2.2s);
	}

	.appointment-voice-visual__magic {
		--magic-x: 0px;
		--magic-y: 0px;
		--magic-scale: 1;
		--magic-rotate: 0deg;
		position: relative;
		z-index: 2;
		width: min(18.5rem, calc(100% - 2rem));
		height: 7.4rem;
		transform: translate3d(var(--magic-x), var(--magic-y), 0)
			scale(var(--magic-scale))
			rotate(var(--magic-rotate));
		transform-origin: center;
		transition: opacity 180ms ease;
	}

	.appointment-voice-visual[data-visualizer-mode='live'] .appointment-voice-visual__magic,
	.appointment-voice-visual[data-visualizer-mode='collapsing'] .appointment-voice-visual__magic {
		will-change: transform;
	}

	.appointment-voice-visual__magic::before,
	.appointment-voice-visual__magic::after {
		content: '';
		position: absolute;
		inset: 12% 10%;
		border-radius: 48% 52% 58% 42% / 48% 42% 58% 52%;
		background: conic-gradient(
			from 180deg,
			rgba(66, 133, 244, 0.75),
			rgba(161, 66, 244, 0.62),
			rgba(234, 67, 53, 0.5),
			rgba(251, 188, 5, 0.54),
			rgba(52, 168, 83, 0.5),
			rgba(66, 133, 244, 0.75)
		);
		filter: blur(24px) saturate(1.2);
		opacity: calc(0.28 + var(--voice-level, 0.16) * 0.48);
		animation: appointment-voice-magic-morph 7.8s ease-in-out infinite;
	}

	.appointment-voice-visual__magic::after {
		inset: 24% 18%;
		filter: blur(16px) saturate(1.35);
		opacity: calc(0.22 + var(--voice-level, 0.16) * 0.4);
		animation-duration: 6.2s;
		animation-direction: reverse;
	}

	.appointment-voice-visual__magic-bloom,
	.appointment-voice-visual__magic-core,
	.appointment-voice-visual__magic-shine {
		position: absolute;
		border-radius: 999px;
		pointer-events: none;
		mix-blend-mode: screen;
	}

	.appointment-voice-visual__magic-bloom {
		filter: blur(calc(14px + var(--voice-level, 0.16) * 4px)) saturate(1.28);
		opacity: calc(0.28 + var(--voice-level, 0.16) * 0.48);
		transform: scale(calc(0.96 + var(--voice-level, 0.16) * 0.32));
		transition: opacity 120ms ease, filter 120ms ease, transform 120ms ease;
		animation: appointment-voice-magic-float 8.4s ease-in-out infinite;
	}

	.appointment-voice-visual__magic-bloom--blue {
		inset: 14% 48% 28% 8%;
		background: radial-gradient(circle at 42% 44%, rgba(0, 194, 255, 0.86), rgba(66, 133, 244, 0.46) 42%, transparent 72%);
	}

	.appointment-voice-visual__magic-bloom--violet {
		inset: 8% 26% 24% 28%;
		background: radial-gradient(circle at 52% 48%, rgba(161, 66, 244, 0.74), rgba(234, 67, 53, 0.34) 48%, transparent 74%);
		animation-delay: -1.8s;
		animation-direction: reverse;
	}

	.appointment-voice-visual__magic-bloom--gold {
		inset: 26% 16% 14% 44%;
		background: radial-gradient(circle at 50% 52%, rgba(251, 188, 5, 0.72), rgba(234, 67, 53, 0.32) 48%, transparent 76%);
		animation-delay: -3.2s;
	}

	.appointment-voice-visual__magic-bloom--green {
		inset: 18% 8% 26% 62%;
		background: radial-gradient(circle at 48% 48%, rgba(52, 168, 83, 0.72), rgba(66, 133, 244, 0.2) 50%, transparent 76%);
		animation-delay: -4.4s;
		animation-direction: reverse;
	}

	.appointment-voice-visual__magic-core {
		inset: 28% 22%;
		background:
			radial-gradient(circle at 35% 45%, rgba(255, 255, 255, 0.7), transparent 16%),
			linear-gradient(90deg, rgba(66, 133, 244, 0.58), rgba(161, 66, 244, 0.48), rgba(251, 188, 5, 0.42), rgba(52, 168, 83, 0.42));
		filter: blur(20px) saturate(1.28);
		opacity: calc(0.32 + var(--voice-level, 0.16) * 0.48);
		transform: scaleX(calc(0.9 + var(--voice-level, 0.16) * 0.38));
	}

	.appointment-voice-visual__magic-shine {
		inset: 38% 30%;
		background: rgba(255, 255, 255, 0.55);
		filter: blur(14px);
		opacity: calc(0.12 + var(--voice-level, 0.16) * 0.42);
	}

	appointment-voice-overlay[data-voice-state='idle'] .appointment-voice-visual__magic {
		opacity: 0.86;
	}

	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-visual__magic,
	.appointment-voice-visual[data-visualizer-mode='live'] .appointment-voice-visual__magic {
		opacity: 1;
	}

	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-visual__magic::before,
	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-visual__magic::after,
	.appointment-voice-visual[data-visualizer-mode='live'] .appointment-voice-visual__magic::before,
	.appointment-voice-visual[data-visualizer-mode='live'] .appointment-voice-visual__magic::after {
		animation-name: appointment-voice-magic-morph-live;
		animation-duration: calc(4.6s - var(--voice-level, 0.2) * 2.2s);
		filter: blur(calc(18px - var(--voice-level, 0.2) * 6px)) saturate(1.45);
