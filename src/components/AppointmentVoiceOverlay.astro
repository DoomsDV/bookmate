---
import { FEATURE_FLAGS } from '../config/feature-flags';
---

{FEATURE_FLAGS.APPOINTMENT_AI_VOICE && (
	<appointment-voice-overlay>
		<dialog
			class="appointment-voice-shell"
			data-voice-overlay-shell
			aria-label="Cita rápida por voz"
		>
			<div class="appointment-voice-dialog">
				<div class="appointment-voice-sheet-handle" aria-hidden="true">
					<span class="appointment-voice-sheet-handle__pill"></span>
				</div>

				<div class="appointment-voice-header">
					<div class="appointment-voice-title-wrap">
						<div class="appointment-voice-mark">
							<span class="material-symbols-rounded">auto_awesome</span>
						</div>
						<div>
							<h2 class="appointment-voice-title">Cita rápida</h2>
							<p class="appointment-voice-subtitle">Describe la cita con tu voz</p>
						</div>
					</div>
					<div class="appointment-voice-header-actions">
						<button
							type="button"
							class="appointment-voice-help"
							data-voice-overlay-tour-help
							aria-label="Guía de cita rápida por voz"
						>
							<span class="material-symbols-rounded" aria-hidden="true">help</span>
							<span class="appointment-voice-help__label">Guía</span>
						</button>
						<button
							type="button"
							class="appointment-voice-close"
							data-voice-overlay-close
							aria-label="Cerrar"
						>
							<span class="material-symbols-rounded">close</span>
						</button>
					</div>
				</div>

				<div class="appointment-voice-body">
					<p class="appointment-voice-status" data-voice-overlay-status>
						Toca el micrófono y describe la cita.
					</p>
					<div class="appointment-voice-transcript-wrap hidden" data-voice-overlay-transcript-wrap>
						<p class="appointment-voice-transcript-label">Escuché</p>
						<p class="appointment-voice-transcript" data-voice-overlay-transcript></p>
					</div>
					<p class="appointment-voice-error hidden" data-voice-overlay-error role="alert"></p>

					<div class="appointment-voice-processing hidden" data-voice-overlay-processing>
						<div class="appointment-voice-processing__visual" aria-hidden="true">
							<span class="appointment-voice-processing__glow"></span>
							<span class="appointment-voice-processing__sparkle material-symbols-rounded">auto_awesome</span>
							<span class="appointment-voice-processing__spinner"></span>
						</div>
						<span class="appointment-voice-processing__shimmer">
							Transcribiendo y completando datos…
						</span>
					</div>

					<div class="appointment-voice-stage" data-voice-overlay-stage>
						<div class="appointment-voice-visual" data-voice-overlay-visualizer data-visualizer-mode="idle">
							<div class="appointment-voice-visual__aura" aria-hidden="true">
								<span class="appointment-voice-visual__blob appointment-voice-visual__blob--blue"></span>
								<span class="appointment-voice-visual__blob appointment-voice-visual__blob--red"></span>
								<span class="appointment-voice-visual__blob appointment-voice-visual__blob--yellow"></span>
								<span class="appointment-voice-visual__blob appointment-voice-visual__blob--green"></span>
							</div>
							<div class="appointment-voice-visual__magic" data-voice-magic aria-hidden="true">
								<span class="appointment-voice-visual__magic-bloom appointment-voice-visual__magic-bloom--blue"></span>
								<span class="appointment-voice-visual__magic-bloom appointment-voice-visual__magic-bloom--violet"></span>
								<span class="appointment-voice-visual__magic-bloom appointment-voice-visual__magic-bloom--gold"></span>
								<span class="appointment-voice-visual__magic-bloom appointment-voice-visual__magic-bloom--green"></span>
								<span class="appointment-voice-visual__magic-core"></span>
								<span class="appointment-voice-visual__magic-shine"></span>
							</div>
						</div>
						<div class="appointment-voice-record-wrap">
							<button
								type="button"
								class="appointment-voice-record"
								data-voice-overlay-record
								aria-label="Empezar a grabar"
							>
								<span class="appointment-voice-record__pulse" aria-hidden="true"></span>
								<span class="appointment-voice-record__halo" aria-hidden="true"></span>
								<span
									class="appointment-voice-record__icon appointment-voice-record__icon--mic material-symbols-rounded"
									data-voice-overlay-record-icon-mic
									aria-hidden="true"
								>mic</span>
								<span
									class="appointment-voice-record__icon appointment-voice-record__icon--stop"
									data-voice-overlay-record-icon-stop
									aria-hidden="true"
								></span>
							</button>
						</div>
					</div>

					<p
						class="appointment-voice-timer hidden"
						data-voice-overlay-timer
						aria-live="polite"
						aria-atomic="true"
					>
						00:00 / 01:00
					</p>

					<button
						type="button"
						class="appointment-voice-discard hidden"
						data-voice-overlay-discard
						aria-label="Descartar grabación"
					>
						<span class="material-symbols-rounded" aria-hidden="true">delete</span>
						Descartar
					</button>

					<div class="appointment-voice-actions hidden" data-voice-overlay-actions>
						<button type="button" class="appointment-voice-continue" data-voice-overlay-continue>
							Ir al calendario
						</button>
					</div>
				</div>
			</div>
		</dialog>
	</appointment-voice-overlay>
)}

<style is:global>
	appointment-voice-overlay {
		display: block;
	}

	.appointment-voice-shell {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		top: auto;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		box-sizing: border-box;
		width: 100vw;
		max-width: none;
		height: fit-content;
		max-height: min(88dvh, 100%);
		overflow: visible;
		overscroll-behavior: contain;
		color: var(--on-surface);
	}

	.appointment-voice-shell[open] {
		display: block;
	}

	.appointment-voice-shell::backdrop {
		background: rgba(15, 23, 42, 0.42);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	.appointment-voice-shell[open] {
		animation: appointment-voice-sheet-in var(--modal-open-duration, 150ms) var(--modal-easing, cubic-bezier(0.4, 0, 0.2, 1));
	}

	.appointment-voice-shell[open]::backdrop {
		animation: appointment-voice-backdrop-in var(--modal-open-duration, 150ms) var(--modal-easing, cubic-bezier(0.4, 0, 0.2, 1));
	}

	.appointment-voice-shell.is-closing {
		animation: appointment-voice-sheet-out var(--modal-close-duration, 140ms) var(--modal-easing, cubic-bezier(0.4, 0, 0.2, 1)) forwards;
	}

	.appointment-voice-shell.is-closing::backdrop {
		animation: appointment-voice-backdrop-out var(--modal-close-duration, 140ms) var(--modal-easing, cubic-bezier(0.4, 0, 0.2, 1)) forwards;
	}

	.appointment-voice-dialog {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		width: 100%;
		max-height: min(88dvh, 100%);
		overflow: hidden;
		border-radius: 1.8rem 1.8rem 0 0;
		border: 1px solid var(--shell-border);
		border-bottom: 0;
		background: var(--surface-bright);
		box-shadow: 0 -18px 60px rgba(15, 23, 42, 0.18);
		padding-bottom: max(0.35rem, env(safe-area-inset-bottom, 0px));
	}

	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-dialog,
	appointment-voice-overlay[data-voice-state='collapsing'] .appointment-voice-dialog,
	appointment-voice-overlay[data-voice-state='processing'] .appointment-voice-dialog {
		border-color: color-mix(in srgb, var(--primary) 28%, var(--shell-border));
		box-shadow:
			0 -18px 60px rgba(15, 23, 42, 0.2),
			0 0 48px color-mix(in srgb, #4285f4 14%, transparent);
	}

	.appointment-voice-sheet-handle {
		display: flex;
		justify-content: center;
		padding: 0.55rem 0 0.15rem;
	}

	.appointment-voice-sheet-handle__pill {
		width: 2.35rem;
		height: 0.28rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--on-surface-variant) 42%, transparent);
	}

	@media (min-width: 640px) {
		.appointment-voice-shell {
			left: 50%;
			right: auto;
			bottom: auto;
			top: 50%;
			width: min(26.5rem, calc(100vw - 2rem));
			max-width: min(26.5rem, calc(100vw - 2rem));
			max-height: min(90vh, 42rem);
			transform: translate(-50%, -50%);
		}

		.appointment-voice-dialog {
			border-radius: 1.8rem;
			border-bottom: 1px solid var(--shell-border);
			box-shadow: 0 24px 80px rgba(15, 23, 42, 0.16);
			padding-bottom: 0;
			max-height: min(90vh, 42rem);
		}

		.appointment-voice-sheet-handle {
			display: none;
		}

		.appointment-voice-shell[open] {
			animation-name: appointment-voice-sheet-in-desktop;
		}

		.appointment-voice-shell.is-closing {
			animation-name: appointment-voice-sheet-out-desktop;
		}
	}

	@keyframes appointment-voice-sheet-in {
		from {
			opacity: 0;
			transform: translateY(100%);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes appointment-voice-sheet-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(100%);
		}
	}

	@keyframes appointment-voice-sheet-in-desktop {
		from {
			opacity: 0;
			transform: translate(-50%, calc(-50% + 12px)) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1);
		}
	}

	@keyframes appointment-voice-sheet-out-desktop {
		from {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1);
		}
		to {
			opacity: 0;
			transform: translate(-50%, calc(-50% + 10px)) scale(0.98);
		}
	}

	@keyframes appointment-voice-backdrop-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes appointment-voice-backdrop-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

	.appointment-voice-header {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.55rem 1.2rem 0.85rem;
		border-bottom: 1px solid var(--shell-border);
	}

	.appointment-voice-title-wrap {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		min-width: 0;
		flex: 1;
	}

	.appointment-voice-mark {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 1rem;
		background: linear-gradient(
			135deg,
			color-mix(in srgb, #4285f4 22%, transparent),
			color-mix(in srgb, #ea4335 14%, transparent) 40%,
			color-mix(in srgb, #fbbc05 14%, transparent) 70%,
			color-mix(in srgb, #34a853 18%, transparent)
		);
		color: var(--primary);
	}

	.appointment-voice-title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 800;
		color: var(--on-surface);
		line-height: 1.2;
	}

	.appointment-voice-subtitle {
		margin: 0.15rem 0 0;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--on-surface-variant);
		line-height: 1.35;
	}

	.appointment-voice-header-actions {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-shrink: 0;
	}

	.appointment-voice-help {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		height: 2.25rem;
		padding: 0 0.85rem;
		border: 1px solid var(--shell-border);
		border-radius: 999px;
		background: var(--surface-bright);
		color: var(--on-surface-variant);
		font-size: 0.82rem;
		font-weight: 700;
		cursor: pointer;
		transition:
			border-color 160ms ease,
			color 160ms ease,
			background 160ms ease;
	}

	.appointment-voice-help .material-symbols-rounded {
		font-size: 1.05rem;
	}

	.appointment-voice-help:hover {
		border-color: color-mix(in srgb, var(--primary) 35%, var(--shell-border));
		color: var(--primary);
	}

	.appointment-voice-close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--on-surface-variant);
		cursor: pointer;
	}

	.appointment-voice-close:hover {
		background: var(--surface-variant);
		color: var(--on-surface);
	}

	.appointment-voice-body {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: 0.85rem;
		padding: 1.4rem 1.2rem 1.6rem;
		text-align: center;
	}

	.appointment-voice-status {
		margin: 0;
		min-height: 1.35em;
		font-size: 0.94rem;
		font-weight: 750;
		color: color-mix(in srgb, var(--on-surface) 82%, var(--on-surface-variant) 18%);
		opacity: 1;
		transform: translateY(0);
		transition:
			opacity 180ms ease,
			transform 180ms ease,
			color 180ms ease;
	}

	appointment-voice-overlay[data-voice-state='recording'] .appointment-voice-status {
		color: color-mix(in srgb, var(--on-surface) 90%, var(--primary) 10%);
		margin-bottom: 0.65rem;
	}

	.appointment-voice-timer {
		margin: -0.55rem 0 0;
		font-size: 0.88rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.05em;
		color: #3b82f6;
		transition: opacity 180ms ease, color 180ms ease;
	}

	.appointment-voice-timer.is-near-limit {
		color: #e11d48;
	}

	.appointment-voice-timer.hidden {
		display: none;
	}

	.appointment-voice-status.is-leaving {
		opacity: 0;
		transform: translateY(-4px);
	}

	.appointment-voice-status.is-entering {
		opacity: 0;
		transform: translateY(4px);
	}

	.appointment-voice-transcript-wrap {
		width: 100%;
		padding: 0.85rem 1rem;
		border-radius: 1rem;
		border: 1px solid var(--shell-border);
		background: var(--surface-variant);
		text-align: left;
	}

	.appointment-voice-transcript-wrap.hidden {
		display: none;
	}

	.appointment-voice-transcript-label {
		margin: 0 0 0.35rem;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--on-surface-variant);
	}

	.appointment-voice-transcript {
		margin: 0;
		max-width: 100%;
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.45;
		color: var(--on-surface);
	}

	.appointment-voice-error {
		margin: 0;
		font-size: 0.88rem;
		font-weight: 700;
		color: #e11d48;
	}

	.appointment-voice-status.hidden {
		display: none;
	}

	.appointment-voice-processing {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		width: 100%;
		min-height: 6.5rem;
	}

	.appointment-voice-processing__visual {
		position: relative;
		display: grid;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
	}

	.appointment-voice-processing__glow {
		position: absolute;
		inset: 0;
		border-radius: 999px;
		background: radial-gradient(
			circle,
			color-mix(in srgb, #67e8f9 28%, transparent) 0%,
			color-mix(in srgb, #a78bfa 18%, transparent) 45%,
			transparent 72%
		);
		filter: blur(10px);
		animation: appointment-voice-breathe 2.8s ease-in-out infinite;
	}

	.appointment-voice-processing__sparkle {
		position: absolute;
		z-index: 1;
		font-size: 1.15rem;
		color: color-mix(in srgb, #67e8f9 70%, #c4b5fd 30%);
		opacity: 0.85;
		animation: appointment-voice-breathe 2.8s ease-in-out infinite;
	}

	.appointment-voice-processing__spinner {
		position: relative;
		z-index: 2;
		width: 2.35rem;
		height: 2.35rem;
		border-radius: 999px;
		background: conic-gradient(
			from 0deg,
			transparent 0deg 40deg,
			#67e8f9 80deg,
			#818cf8 160deg,
			#a78bfa 220deg,
			#22d3ee 300deg,
			transparent 340deg 360deg
		);
		animation: appointment-voice-spin 0.95s linear infinite;
		mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2.5px));
		-webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2.5px));
	}

	.appointment-voice-processing__shimmer {
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1.4;
		text-align: center;
		background: linear-gradient(
			110deg,
			color-mix(in srgb, var(--on-surface-variant) 92%, transparent) 0%,
			color-mix(in srgb, var(--on-surface-variant) 92%, transparent) 36%,
			#bae6fd 46%,
			#c4b5fd 50%,
			#bae6fd 54%,
			color-mix(in srgb, var(--on-surface-variant) 92%, transparent) 64%,
			color-mix(in srgb, var(--on-surface-variant) 92%, transparent) 100%
		);
		background-size: 220% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: appointment-voice-shimmer 2.4s ease-in-out infinite;
	}

	.appointment-voice-processing.hidden,
	.appointment-voice-transcript-wrap.hidden,
	.appointment-voice-error.hidden,
	.appointment-voice-actions.hidden,
	.appointment-voice-discard.hidden {
		display: none;
	}

	.appointment-voice-record[hidden] {
		display: none;
	}

	.appointment-voice-actions {
		width: 100%;
	}

	.appointment-voice-continue {
		width: 100%;
		border: 0;
		border-radius: 999px;
		padding: 0.85rem 1.2rem;
		font-size: 0.92rem;
		font-weight: 800;
		color: #f8fbff;
		background: var(--primary);
		box-shadow: 0 4px 14px rgba(15, 23, 42, 0.12);
		cursor: pointer;
		transition: background-color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
	}

	.appointment-voice-continue:hover {
		transform: translateY(-1px);
		background: color-mix(in srgb, var(--primary) 92%, #000 8%);
	}

	.appointment-voice-discard {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		margin-top: -0.15rem;
		padding: 0.55rem 0.95rem;
		border: 1px solid color-mix(in srgb, var(--on-surface-variant) 28%, var(--shell-border) 72%);
		border-radius: 999px;
		background: transparent;
		color: color-mix(in srgb, var(--on-surface) 72%, var(--on-surface-variant) 28%);
		font-size: 0.84rem;
		font-weight: 600;
		cursor: pointer;
		transition:
			color 140ms ease,
			border-color 140ms ease,
			background-color 140ms ease,
			opacity 180ms ease,
			transform 180ms ease;
	}

	.appointment-voice-discard .material-symbols-rounded {
		font-size: 1.05rem;
		color: color-mix(in srgb, var(--on-surface-variant) 80%, #64748b 20%);
		transition: color 140ms ease;
	}

	.appointment-voice-discard:hover {
		color: #be123c;
		border-color: color-mix(in srgb, #e11d48 35%, var(--shell-border) 65%);
		background: color-mix(in srgb, #e11d48 6%, transparent);
	}

	.appointment-voice-discard:hover .material-symbols-rounded {
		color: #e11d48;
	}

	.appointment-voice-discard:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
		outline-offset: 3px;
	}

	.appointment-voice-stage {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.95rem;
		width: calc(100% + 2.4rem);
		margin-inline: -1.2rem;
		min-height: 13.6rem;
		margin-top: 0.2rem;
		padding-inline: 0;
		--voice-level: 0.16;
		--magic-height: 8.45rem;
	}

	.appointment-voice-visual {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 100%;
		height: var(--magic-height);
		pointer-events: none;
		overflow: visible;
		isolation: isolate;
	}

	.appointment-voice-visual::before {
		content: '';
		position: absolute;
		z-index: 0;
		width: min(22rem, calc(100% - 1rem));
		height: 8rem;
		border-radius: 999px;
		background:
			radial-gradient(circle at 28% 52%, rgba(66, 133, 244, 0.18), transparent 42%),
			radial-gradient(circle at 50% 48%, rgba(161, 66, 244, 0.15), transparent 40%),
			radial-gradient(circle at 70% 56%, rgba(251, 188, 5, 0.13), transparent 42%),
			radial-gradient(circle at 82% 48%, rgba(52, 168, 83, 0.12), transparent 44%);
		filter: blur(22px) saturate(1.12);
		opacity: calc(0.18 + var(--voice-level, 0.16) * 0.28);
		transform: scale(calc(0.96 + var(--voice-level, 0.16) * 0.1));
		transition: opacity 220ms ease, transform 220ms ease;
	}

	.appointment-voice-visual__aura {
		position: absolute;
		inset: -2% 6%;
		z-index: 0;
