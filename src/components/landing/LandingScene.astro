---
export type LandingSceneKind = 'hero-cal' | 'feat-book' | 'feat-metrics' | 'feat-team' | 'feat-page';

interface Props {
	kind: LandingSceneKind;
}

const { kind } = Astro.props;

const weekDays = ['L', 'M', 'X', 'J', 'V'] as const;
const heroHours = ['09', '11', '13', '15'] as const;
const heroBlocks = [
	{ day: 0, start: 16, span: 18, tone: 'soft' },
	{ day: 1, start: 42, span: 16, tone: 'soft' },
	{ day: 2, start: 12, span: 22, tone: 'on' },
	{ day: 3, start: 48, span: 15, tone: 'soft' },
	{ day: 4, start: 28, span: 18, tone: 'soft' },
] as const;
---

{
	kind === 'hero-cal' ? (
		<div class="ls-cal ls-cal--hero">
			<div class="ls-cal__bar">
				<strong>Hoy</strong>
				<span class="ls-cal__meta">5 turnos</span>
			</div>
			<div class="ls-cal__board">
				<div class="ls-cal__hours">
					{heroHours.map((hour) => (
						<span>{hour}</span>
					))}
				</div>
				<div class="ls-cal__week">
					<div class="ls-cal__days">
						{weekDays.map((day, index) => (
							<span class:list={{ 'is-now': index === 2 }}>{day}</span>
						))}
					</div>
					<div class="ls-cal__grid">
						<span class="ls-cal__now" />
						{weekDays.map((_, day) => (
							<div class:list={['ls-cal__col', { 'is-now': day === 2 }]}>
								{heroBlocks
									.filter((block) => block.day === day)
									.map((block) => (
										<span
											class:list={['ls-chip', `ls-chip--${block.tone}`]}
											style={`top: ${block.start}%; height: ${block.span}%`}
										/>
									))}
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	) : kind === 'feat-book' ? (
		<svg class="ls-mini" viewBox="0 0 280 160" fill="none" aria-hidden="true">
			<rect x="18" y="22" width="244" height="116" rx="18" class="ls-mini__card" />
			<rect x="36" y="40" width="88" height="10" rx="5" class="ls-mini__ink" />
			<rect x="36" y="58" width="208" height="22" rx="8" class="ls-mini__ok" />
			<rect x="36" y="88" width="168" height="22" rx="8" class="ls-mini__wait" />
			<rect x="36" y="118" width="128" height="8" rx="4" class="ls-mini__mute" />
		</svg>
	) : kind === 'feat-metrics' ? (
		<svg class="ls-mini" viewBox="0 0 280 160" fill="none" aria-hidden="true">
			<rect x="18" y="22" width="244" height="116" rx="18" class="ls-mini__card" />
			<rect x="48" y="92" width="22" height="28" rx="6" class="ls-mini__bar" />
			<rect x="86" y="72" width="22" height="48" rx="6" class="ls-mini__ok" />
			<rect x="124" y="54" width="22" height="66" rx="6" class="ls-mini__bar" />
			<rect x="162" y="64" width="22" height="56" rx="6" class="ls-mini__wait" />
			<rect x="200" y="44" width="22" height="76" rx="6" class="ls-mini__ok" />
		</svg>
	) : kind === 'feat-team' ? (
		<svg class="ls-mini" viewBox="0 0 280 160" fill="none" aria-hidden="true">
			<rect x="18" y="22" width="244" height="116" rx="18" class="ls-mini__card" />
			<circle cx="70" cy="80" r="22" class="ls-mini__ok" />
			<circle cx="118" cy="80" r="22" class="ls-mini__wait" />
			<circle cx="166" cy="80" r="22" class="ls-mini__bar" />
			<rect x="198" y="68" width="44" height="24" rx="12" class="ls-mini__ink" />
		</svg>
	) : (
		<svg class="ls-mini" viewBox="0 0 280 160" fill="none" aria-hidden="true">
			<rect x="78" y="16" width="124" height="128" rx="22" class="ls-mini__card" />
			<rect x="96" y="36" width="88" height="8" rx="4" class="ls-mini__mute" />
			<rect x="96" y="56" width="88" height="18" rx="8" class="ls-mini__ok" />
			<rect x="96" y="82" width="88" height="18" rx="8" class="ls-mini__wait" />
			<rect x="96" y="108" width="56" height="18" rx="8" class="ls-mini__bar" />
		</svg>
	)
}

<style>
	.ls-cal {
		position: relative;
		width: 100%;
		min-height: 0;
		padding: 1.05rem 1.1rem 0.95rem;
		overflow: hidden;
	}

	.ls-cal__bar {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.95rem;
	}

	.ls-cal__bar strong {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--text-primary);
	}

	.ls-cal__meta {
		font-size: 0.68rem;
		font-weight: 600;
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
	}

	.ls-cal__board {
		display: grid;
		grid-template-columns: 1.45rem minmax(0, 1fr);
		gap: 0.55rem;
		align-items: stretch;
	}

	.ls-cal__hours {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding-top: 1.35rem;
		color: var(--text-muted);
		font-size: 0.58rem;
		font-weight: 650;
		letter-spacing: 0.02em;
		font-variant-numeric: tabular-nums;
		line-height: 1;
	}

	.ls-cal__week {
		min-width: 0;
	}

	.ls-cal__days {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.28rem;
		margin-bottom: 0.4rem;
		color: var(--text-muted);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-align: center;
	}

	.ls-cal__days .is-now {
		color: var(--accent);
	}

	.ls-cal__grid {
		position: relative;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.28rem;
		height: 11.25rem;
		background-image: repeating-linear-gradient(
			to bottom,
			transparent,
			transparent 27px,
			color-mix(in srgb, var(--border) 80%, transparent) 27px,
			color-mix(in srgb, var(--border) 80%, transparent) 28px
		);
	}

	.ls-cal__now {
		position: absolute;
		left: -0.2rem;
		right: 0;
		top: 38%;
		z-index: 2;
		height: 1px;
		background: color-mix(in srgb, var(--accent) 72%, transparent);
		pointer-events: none;
	}

	.ls-cal__now::before {
		content: '';
		position: absolute;
		left: -0.18rem;
		top: 50%;
		width: 0.28rem;
		height: 0.28rem;
		border-radius: 999px;
		background: var(--accent);
		transform: translateY(-50%);
	}

	.ls-cal__col {
		position: relative;
		min-width: 0;
		border-radius: 0.28rem;
	}

	.ls-cal__col.is-now {
		background: color-mix(in srgb, var(--accent) 3.5%, transparent);
	}

	.ls-chip {
		position: absolute;
		left: 0.12rem;
		right: 0.12rem;
		z-index: 1;
		border-radius: 0.22rem;
	}

	.ls-chip--soft {
		background: color-mix(in srgb, var(--text-primary) 8%, var(--surface-raised));
	}

	.ls-chip--on {
		background: color-mix(in srgb, var(--accent) 22%, var(--surface-raised));
	}

	.ls-mini {
		display: block;
		width: 100%;
		height: auto;
	}

	.ls-mini__card {
		fill: var(--surface-raised);
		stroke: var(--border);
	}

	.ls-mini__ink {
		fill: color-mix(in srgb, var(--text-primary) 72%, transparent);
	}

	.ls-mini__mute {
		fill: color-mix(in srgb, var(--text-muted) 45%, transparent);
	}

	.ls-mini__ok {
		fill: color-mix(in srgb, #059669 42%, var(--surface-raised));
	}

	.ls-mini__wait {
		fill: color-mix(in srgb, #d97706 40%, var(--surface-raised));
	}

	.ls-mini__bar {
		fill: color-mix(in srgb, var(--accent) 42%, var(--surface-raised));
	}
</style>
