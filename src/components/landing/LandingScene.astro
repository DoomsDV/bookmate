---
export type LandingSceneKind =
	| 'hero-cal'
	| 'calendar'
	| 'booking'
	| 'feat-book'
	| 'feat-metrics'
	| 'feat-team'
	| 'feat-page';

interface Props {
	kind: LandingSceneKind;
}

const { kind } = Astro.props;

const weekDays = ['L', 'M', 'X', 'J', 'V'] as const;
const heroBlocks = [
	{ day: 0, start: 18, span: 28, tone: 'ok', label: 'Ana · masaje' },
	{ day: 1, start: 32, span: 24, tone: 'wait', label: 'Ramón' },
	{ day: 2, start: 12, span: 30, tone: 'ok', label: 'Lucía · fisio' },
	{ day: 3, start: 40, span: 22, tone: 'pay', label: 'Seña' },
	{ day: 4, start: 20, span: 26, tone: 'ok', label: 'Carlos' },
] as const;

const calBlocks = [
	{ day: 0, start: 10, span: 22, tone: 'ok' },
	{ day: 0, start: 42, span: 20, tone: 'wait' },
	{ day: 1, start: 18, span: 26, tone: 'ok' },
	{ day: 2, start: 8, span: 18, tone: 'pay' },
	{ day: 2, start: 36, span: 24, tone: 'ok' },
	{ day: 3, start: 22, span: 20, tone: 'wait' },
	{ day: 4, start: 14, span: 28, tone: 'ok' },
] as const;

const bookServices = [
	{ name: 'Consulta', mins: '30 min', price: '₲ 80.000' },
	{ name: 'Masaje', mins: '45 min', price: '₲ 120.000' },
	{ name: 'Evaluación', mins: '40 min', price: '₲ 90.000' },
] as const;

const bookSlots = ['09:00', '10:30', '15:00'] as const;
---

{
	kind === 'hero-cal' || kind === 'calendar' ? (
		<div class:list={['ls-cal', { 'ls-cal--hero': kind === 'hero-cal' }]} aria-hidden="true">
			<div class="ls-cal__bar">
				<span class="ls-cal__dot" />
				<span class="ls-cal__dot" />
				<span class="ls-cal__dot" />
				<strong>{kind === 'hero-cal' ? 'Agenda de hoy' : 'Semana del equipo'}</strong>
			</div>
			<div class="ls-cal__days">
				{weekDays.map((day) => (
					<span>{day}</span>
				))}
			</div>
			<div class="ls-cal__grid">
				{weekDays.map((_, day) => (
					<div class="ls-cal__col">
						{(kind === 'hero-cal' ? heroBlocks : calBlocks)
							.filter((block) => block.day === day)
							.map((block) => (
								<span
									class:list={['ls-chip', `ls-chip--${block.tone}`]}
									style={`top: ${block.start}%; height: ${block.span}%`}
								>
									{'label' in block ? block.label : ''}
								</span>
							))}
					</div>
				))}
			</div>
		</div>
	) : kind === 'booking' ? (
		<div class="ls-book" aria-hidden="true">
			<div class="ls-book__who">
				<span class="ls-book__avatar">DV</span>
				<div>
					<strong>Dann Villasanti</strong>
					<span>Quiropraxia · Capiatá</span>
				</div>
			</div>
			<ol class="ls-book__list">
				{bookServices.map((item) => (
					<li>
						<span>
							<b>{item.name}</b>
							<small>{item.mins}</small>
						</span>
						<em>{item.price}</em>
					</li>
				))}
			</ol>
			<div class="ls-book__slots">
				{bookSlots.map((slot, index) => (
					<span class:list={{ 'is-on': index === 1 }}>{slot}</span>
				))}
			</div>
		</div>
	) : kind === 'feat-book' ? (
		<svg class="ls-mini" viewBox="0 0 280 160" fill="none" aria-hidden="true">
			<rect x="18" y="22" width="244" height="116" rx="18" class="ls-mini__card" />
			<rect x="36" y="40" width="88" height="10" rx="5" class="ls-mini__ink" />
			<rect x="36" y="58" width="208" height="22" rx="8" class="ls-mini__ok" />
			<rect x="36" y="88" width="168" height="22" rx="8" class="ls-mini__wait" />
			<rect x="36" y="118" width="128" height="8" rx="4" class="ls-mini__mute" />
		</svg>
	) : kind === 'feat-metrics' ? (
		<svg class="ls-mini" viewBox="0 0 280 160" fill="none" aria-hidden="true">
			<rect x="18" y="22" width="244" height="116" rx="18" class="ls-mini__card" />
			<rect x="48" y="92" width="22" height="28" rx="6" class="ls-mini__bar" />
			<rect x="86" y="72" width="22" height="48" rx="6" class="ls-mini__ok" />
			<rect x="124" y="54" width="22" height="66" rx="6" class="ls-mini__bar" />
			<rect x="162" y="64" width="22" height="56" rx="6" class="ls-mini__wait" />
			<rect x="200" y="44" width="22" height="76" rx="6" class="ls-mini__ok" />
		</svg>
	) : kind === 'feat-team' ? (
		<svg class="ls-mini" viewBox="0 0 280 160" fill="none" aria-hidden="true">
			<rect x="18" y="22" width="244" height="116" rx="18" class="ls-mini__card" />
			<circle cx="70" cy="80" r="22" class="ls-mini__ok" />
			<circle cx="118" cy="80" r="22" class="ls-mini__wait" />
			<circle cx="166" cy="80" r="22" class="ls-mini__bar" />
			<rect x="198" y="68" width="44" height="24" rx="12" class="ls-mini__ink" />
		</svg>
	) : (
		<svg class="ls-mini" viewBox="0 0 280 160" fill="none" aria-hidden="true">
			<rect x="78" y="16" width="124" height="128" rx="22" class="ls-mini__card" />
			<rect x="96" y="36" width="88" height="8" rx="4" class="ls-mini__mute" />
			<rect x="96" y="56" width="88" height="18" rx="8" class="ls-mini__ok" />
			<rect x="96" y="82" width="88" height="18" rx="8" class="ls-mini__wait" />
			<rect x="96" y="108" width="56" height="18" rx="8" class="ls-mini__bar" />
		</svg>
	)
}

<style>
	.ls-cal,
	.ls-book {
		position: relative;
		width: 100%;
		height: 100%;
		min-height: 16rem;
		padding: 1rem 1rem 1.1rem;
		border-radius: calc(var(--radius-lg) - 2px);
		background: var(--surface-raised);
		border: 1px solid var(--border);
		box-shadow: 0 10px 28px rgb(15 23 42 / 0.06);
		overflow: hidden;
	}

	.ls-cal--hero {
		min-height: 18rem;
	}

	.ls-cal__bar {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		margin-bottom: 0.85rem;
		color: var(--text-primary);
	}

	.ls-cal__bar strong {
		margin-left: 0.35rem;
		font-size: 0.82rem;
		font-weight: 750;
		letter-spacing: -0.02em;
	}

	.ls-cal__dot {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 999px;
		background: var(--border-strong);
	}

	.ls-cal__dot:first-child {
		background: #ef6b6b;
	}

	.ls-cal__days {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.4rem;
		margin-bottom: 0.55rem;
		color: var(--text-muted);
		font-size: 0.68rem;
		font-weight: 750;
		text-align: center;
	}

	.ls-cal__grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.4rem;
		height: 11.5rem;
		background-image: repeating-linear-gradient(
			to bottom,
			transparent,
			transparent 23px,
			color-mix(in srgb, var(--border) 80%, transparent) 23px,
			color-mix(in srgb, var(--border) 80%, transparent) 24px
		);
	}

	.ls-cal__col {
		position: relative;
		min-width: 0;
	}

	.ls-cal--hero .ls-cal__grid {
		height: 13rem;
	}

	.ls-chip {
		position: absolute;
		left: 0;
		right: 0;
		display: grid;
		align-content: center;
		padding: 0.28rem 0.35rem;
		border-radius: 0.55rem;
		font-size: 0.58rem;
		font-weight: 750;
		letter-spacing: -0.02em;
		line-height: 1.15;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.ls-chip--ok {
		background: color-mix(in srgb, #059669 18%, var(--surface-raised));
		color: #047857;
	}

	.ls-chip--wait {
		background: color-mix(in srgb, #d97706 18%, var(--surface-raised));
		color: #b45309;
	}

	.ls-chip--pay {
		background: color-mix(in srgb, var(--accent) 18%, var(--surface-raised));
		color: var(--accent);
	}

	.ls-book__who {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-bottom: 1rem;
	}

	.ls-book__avatar {
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font-size: 0.72rem;
		font-weight: 800;
	}

	.ls-book__who strong,
	.ls-book li b {
		display: block;
		font-size: 0.86rem;
		font-weight: 750;
		letter-spacing: -0.02em;
		color: var(--text-primary);
	}

	.ls-book__who span,
	.ls-book li small,
	.ls-book li em {
		font-size: 0.72rem;
		font-weight: 650;
		color: var(--text-muted);
		font-style: normal;
	}

	.ls-book__list {
		display: grid;
		gap: 0.55rem;
		margin: 0 0 1rem;
		padding: 0;
		list-style: none;
	}

	.ls-book__list li {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		padding: 0.55rem 0.65rem;
		border-radius: 0.75rem;
		background: var(--surface);
		border: 1px solid var(--border);
	}

	.ls-book__slots {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.ls-book__slots span {
		padding: 0.38rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text-secondary);
		font-size: 0.72rem;
		font-weight: 750;
	}

	.ls-book__slots .is-on {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}

	.ls-mini {
		display: block;
		width: 100%;
		height: auto;
	}

	.ls-mini__card {
		fill: var(--surface-raised);
		stroke: var(--border);
	}

	.ls-mini__ink {
		fill: color-mix(in srgb, var(--text-primary) 72%, transparent);
	}

	.ls-mini__mute {
		fill: color-mix(in srgb, var(--text-muted) 45%, transparent);
	}

	.ls-mini__ok {
		fill: color-mix(in srgb, #059669 42%, var(--surface-raised));
	}

	.ls-mini__wait {
		fill: color-mix(in srgb, #d97706 40%, var(--surface-raised));
	}

	.ls-mini__bar {
		fill: color-mix(in srgb, var(--accent) 42%, var(--surface-raised));
	}

	:global(html[data-theme='dark']) .ls-cal,
	:global(html[data-theme='dark']) .ls-book {
		box-shadow: 0 12px 32px rgb(0 0 0 / 0.28);
	}
</style>
