---
export type LandingSceneKind = 'hero-cal' | 'feat-book' | 'feat-metrics' | 'feat-team' | 'feat-page';

interface Props {
	kind: LandingSceneKind;
}

const { kind } = Astro.props;

const weekDays = ['L', 'M', 'X', 'J', 'V'] as const;
const heroHours = ['09', '11', '13', '15'] as const;
const heroBlocks = [
	{ id: 'a', day: 0, start: 16, span: 18, tone: 'soft' },
	{ id: 'b', day: 1, start: 42, span: 16, tone: 'soft' },
	{ id: 'c', day: 2, start: 12, span: 22, tone: 'on' },
	{ id: 'd', day: 3, start: 48, span: 15, tone: 'soft' },
	{ id: 'e', day: 4, start: 28, span: 18, tone: 'soft' },
] as const;
---

{
	kind === 'hero-cal' ? (
		<div class="ls-cal ls-cal--hero" data-hero-cal>
			<div class="ls-cal__bar">
				<strong>Hoy</strong>
				<span class="ls-cal__meta">5 turnos</span>
			</div>
			<div class="ls-cal__board">
				<div class="ls-cal__hours">
					{heroHours.map((hour) => (
						<span>{hour}</span>
					))}
				</div>
				<div class="ls-cal__week">
					<div class="ls-cal__days">
						{weekDays.map((day, index) => (
							<span class:list={{ 'is-now': index === 2 }}>{day}</span>
						))}
					</div>
					<div class="ls-cal__grid">
						<span class="ls-cal__now" />
						{weekDays.map((_, day) => (
							<div class:list={['ls-cal__col', { 'is-now': day === 2 }]} />
						))}
						<div class="ls-cal__chips">
							{heroBlocks.map((block) => (
								<span
									class:list={['ls-chip', `ls-chip--${block.tone}`]}
									data-chip={block.id}
									data-home-d={block.day}
									data-home-t={block.start}
									data-home-h={block.span}
									data-home-tone={block.tone}
									style={`--d: ${block.day}; --t: ${block.start}; --h: ${block.span}`}
								/>
							))}
						</div>
					</div>
				</div>
			</div>
		</div>
	) : kind === 'feat-book' ? (
		<svg class="ls-mini" viewBox="0 0 280 160" fill="none" aria-hidden="true">
			<rect x="18" y="22" width="244" height="116" rx="18" class="ls-mini__card" />
			<rect x="36" y="40" width="88" height="10" rx="5" class="ls-mini__ink" />
			<rect x="36" y="58" width="208" height="22" rx="8" class="ls-mini__ok" />
			<rect x="36" y="88" width="168" height="22" rx="8" class="ls-mini__wait" />
			<rect x="36" y="118" width="128" height="8" rx="4" class="ls-mini__mute" />
		</svg>
	) : kind === 'feat-metrics' ? (
		<svg class="ls-mini" viewBox="0 0 280 160" fill="none" aria-hidden="true">
			<rect x="18" y="22" width="244" height="116" rx="18" class="ls-mini__card" />
			<rect x="48" y="92" width="22" height="28" rx="6" class="ls-mini__bar" />
			<rect x="86" y="72" width="22" height="48" rx="6" class="ls-mini__ok" />
			<rect x="124" y="54" width="22" height="66" rx="6" class="ls-mini__bar" />
			<rect x="162" y="64" width="22" height="56" rx="6" class="ls-mini__wait" />
			<rect x="200" y="44" width="22" height="76" rx="6" class="ls-mini__ok" />
		</svg>
	) : kind === 'feat-team' ? (
		<svg class="ls-mini" viewBox="0 0 280 160" fill="none" aria-hidden="true">
			<rect x="18" y="22" width="244" height="116" rx="18" class="ls-mini__card" />
			<circle cx="70" cy="80" r="22" class="ls-mini__ok" />
			<circle cx="118" cy="80" r="22" class="ls-mini__wait" />
			<circle cx="166" cy="80" r="22" class="ls-mini__bar" />
			<rect x="198" y="68" width="44" height="24" rx="12" class="ls-mini__ink" />
		</svg>
	) : (
		<svg class="ls-mini" viewBox="0 0 280 160" fill="none" aria-hidden="true">
			<rect x="78" y="16" width="124" height="128" rx="22" class="ls-mini__card" />
			<rect x="96" y="36" width="88" height="8" rx="4" class="ls-mini__mute" />
			<rect x="96" y="56" width="88" height="18" rx="8" class="ls-mini__ok" />
			<rect x="96" y="82" width="88" height="18" rx="8" class="ls-mini__wait" />
			<rect x="96" y="108" width="56" height="18" rx="8" class="ls-mini__bar" />
		</svg>
	)
}

<style>
	.ls-cal {
		--ls-ease: cubic-bezier(0.16, 1, 0.3, 1);
		--ls-gap: 0.28rem;
		position: relative;
		width: 100%;
		min-height: 0;
		padding: 1.05rem 1.1rem 0.95rem;
		overflow: hidden;
	}

	.ls-cal--hero {
		padding: 0.85rem 0.35rem 0.4rem 0.15rem;
	}

	.ls-cal--hero .ls-cal__bar strong {
		font-size: 0.92rem;
	}

	.ls-cal--hero .ls-cal__meta {
		font-size: 0.74rem;
	}

	.ls-cal--hero .ls-cal__hours {
		font-size: 0.66rem;
	}

	.ls-cal--hero .ls-cal__days {
		font-size: 0.7rem;
	}

	.ls-cal--hero .ls-cal__grid {
		height: 15.25rem;
	}

	.ls-cal__bar {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.95rem;
	}

	.ls-cal__bar strong {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--text-primary);
	}

	.ls-cal__meta {
		font-size: 0.68rem;
		font-weight: 600;
		color: var(--text-secondary);
		font-variant-numeric: tabular-nums;
	}

	.ls-cal__board {
		display: grid;
		grid-template-columns: 1.45rem minmax(0, 1fr);
		gap: 0.55rem;
		align-items: stretch;
	}

	.ls-cal__hours {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding-top: 1.35rem;
		color: var(--text-secondary);
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		font-variant-numeric: tabular-nums;
		line-height: 1;
	}

	.ls-cal__week {
		min-width: 0;
	}

	.ls-cal__days {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.28rem;
		margin-bottom: 0.4rem;
		color: var(--text-secondary);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-align: center;
	}

	.ls-cal__days .is-now {
		color: var(--accent);
	}

	.ls-cal__grid {
		position: relative;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: var(--ls-gap);
		height: 11.25rem;
		background-image: repeating-linear-gradient(
			to bottom,
			transparent,
			transparent 27px,
			color-mix(in srgb, var(--border-strong) 85%, transparent) 27px,
			color-mix(in srgb, var(--border-strong) 85%, transparent) 28px
		);
	}

	.ls-cal__now {
		position: absolute;
		left: -0.2rem;
		right: 0;
		top: 38%;
		z-index: 2;
		height: 1px;
		background: color-mix(in srgb, var(--accent) 72%, transparent);
		pointer-events: none;
	}

	.ls-cal__now::before {
		content: '';
		position: absolute;
		left: -0.18rem;
		top: 50%;
		width: 0.28rem;
		height: 0.28rem;
		border-radius: 999px;
		background: var(--accent);
		transform: translateY(-50%);
	}

	.ls-cal__col {
		position: relative;
		min-width: 0;
		border-radius: 0.28rem;
	}

	.ls-cal__col.is-now {
		background: color-mix(in srgb, var(--accent) 7%, transparent);
	}

	.ls-cal__chips {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
	}

	.ls-chip {
		--d: 0;
		--t: 0;
		--h: 16;
		--cols: 5;
		--inset: 0.12rem;
		--col-w: calc((100% - (var(--cols) - 1) * var(--ls-gap)) / var(--cols));
		position: absolute;
		left: calc(var(--d) * (var(--col-w) + var(--ls-gap)) + var(--inset));
		width: calc(var(--col-w) - var(--inset) * 2);
		top: calc(var(--t) * 1%);
		height: calc(var(--h) * 1%);
		z-index: 1;
		border-radius: 0.22rem;
		overflow: hidden;
		background: color-mix(in srgb, var(--accent) 32%, var(--surface));
		transform-origin: center;
		transition:
			left 0.85s var(--ls-ease),
			top 0.85s var(--ls-ease),
			height 0.55s var(--ls-ease),
			transform 0.45s var(--ls-ease),
			filter 0.45s ease;
	}

	.ls-chip::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: color-mix(in srgb, var(--accent) 78%, #c9d8ff);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.72s var(--ls-ease);
		pointer-events: none;
	}

	:global(html[data-theme='dark']) .ls-chip {
		background: color-mix(in srgb, var(--accent) 28%, var(--surface-raised));
	}

	:global(html[data-theme='dark']) .ls-chip::after {
		background: color-mix(in srgb, var(--accent) 78%, #8eafff);
	}

	.ls-chip--on::after,
	.ls-chip.is-filled::after {
		transform: scaleX(1);
	}

	.ls-chip.is-lift {
		z-index: 4;
		transform: translateY(-3px) scale(1.05);
		filter: brightness(1.12);
	}

	.ls-chip.is-pulse {
		animation: ls-chip-pulse 0.62s var(--ls-ease);
	}

	@keyframes ls-chip-pulse {
		0%,
		100% {
			transform: scale(1);
		}
		42% {
			transform: scale(1.07);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ls-chip,
		.ls-chip.is-pulse {
			animation: none;
			transition: none;
			transform: none;
			filter: none;
		}

		.ls-chip::after {
			transition: none;
		}
	}

	.ls-mini {
		display: block;
		width: 100%;
		height: auto;
	}

	.ls-mini__card {
		fill: var(--surface-raised);
		stroke: var(--border);
	}

	.ls-mini__ink {
		fill: color-mix(in srgb, var(--text-primary) 72%, transparent);
	}

	.ls-mini__mute {
		fill: color-mix(in srgb, var(--text-muted) 45%, transparent);
	}

	.ls-mini__ok {
		fill: color-mix(in srgb, #059669 42%, var(--surface-raised));
	}

	.ls-mini__wait {
		fill: color-mix(in srgb, #d97706 40%, var(--surface-raised));
	}

	.ls-mini__bar {
		fill: color-mix(in srgb, var(--accent) 42%, var(--surface-raised));
	}
</style>
