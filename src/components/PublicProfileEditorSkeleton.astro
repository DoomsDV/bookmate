---
/** Skeleton liviano mientras carga el editor (server:defer). */
---

<section class="ppe-page" aria-busy="true" aria-label="Cargando perfil público">
	<div class="ppe-layout">
		<div class="ppe-config-pane">
			<header class="ppe-header">
				<div class="flex min-w-0 flex-1 gap-2">
					<div class="panel-skeleton-line h-9 w-16 shrink-0 rounded-full"></div>
					<div class="panel-skeleton-line h-9 w-20 shrink-0 rounded-full"></div>
					<div class="panel-skeleton-line h-9 w-16 shrink-0 rounded-full"></div>
					<div class="panel-skeleton-line h-9 w-16 shrink-0 rounded-full"></div>
				</div>
				<div class="panel-skeleton-line h-10 w-36 shrink-0 rounded-full"></div>
			</header>
			<div class="mt-6 grid gap-4">
				<div class="panel-skeleton-line h-24 w-full rounded-2xl"></div>
				<div class="panel-skeleton-line h-40 w-full rounded-2xl"></div>
				<div class="panel-skeleton-line h-32 w-full rounded-2xl"></div>
				<div class="panel-skeleton-line h-48 w-full rounded-2xl"></div>
			</div>
		</div>
		<!-- Preview solo en el modal live; no hay mockup de celular. -->
	</div>
</section>
