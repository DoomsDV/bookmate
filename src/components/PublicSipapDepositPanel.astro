---
/**
 * Paso de seña SIPAP (reserva pública).
 * Móvil: monto arriba + CTA sticky. Desktop: resumen + CTA en panel sticky derecho.
 */
interface Props {
	stepPanel?: number;
	variant?: 'booking' | 'manage';
	receiptRejected?: boolean;
}

const { stepPanel = 7, variant = 'booking', receiptRejected = false } = Astro.props;
---

<section
	data-step-panel={String(stepPanel)}
	class:list={[
		'sipap-deposit-panel public-booking-panel text-(--on-surface)',
		{ 'sipap-deposit-panel--manage': variant === 'manage' },
		{ hidden: variant !== 'manage' },
	]}
>
	<div class="sipap-hold-banner" data-sipap-hold-banner data-sipap-hold-state="active">
		<span class="material-symbols-rounded sipap-hold-banner__icon" aria-hidden="true">timer</span>
		<p class="sipap-hold-banner__text">
			<span data-sipap-hold-active>
				Tenés
				<strong class="tabular-nums" data-sipap-countdown>10:00</strong>
				min para confirmar
			</span>
			<span class="hidden" data-sipap-hold-expired>
				Se venció el tiempo para adjuntar el comprobante.
			</span>
			<span class="hidden" data-sipap-hold-unknown>
				Adjuntá el comprobante para confirmar tu turno.
			</span>
			<span class="hidden" data-sipap-hold-submitted>
				Comprobante enviado. Esperando confirmación del comercio.
			</span>
		</p>
	</div>
	<p class="sr-only" data-sipap-hold-live role="status" aria-live="polite"></p>

	<header class="sipap-deposit-intro">
		<h2 class="sipap-deposit-title tracking-tight">Transferí la seña para confirmar</h2>
	</header>

	<div class="sipap-layout">
		<div class="sipap-main">
			<div class="sipap-panel sipap-sheet">
				<div class="sipap-panel__core">
					<p class="sipap-panel__kicker">Datos de transferencia</p>
					<ul class="sipap-transfer-card__list">
						<li>
							<button
								type="button"
								class="sipap-bank-row"
								data-sipap-copy="bank"
								data-sipap-copy-keep-label
								aria-label="Copiar banco"
							>
								<span class="sipap-bank-row__label">Banco</span>
								<span class="sipap-bank-row__value">
									<span data-sipap-bank>—</span>
									<span class="sipap-copy-feedback" aria-hidden="true">¡Copiado!</span>
									<span class="material-symbols-rounded sipap-copy-glyph" aria-hidden="true" data-sipap-copy-icon
										>content_copy</span
									>
								</span>
							</button>
						</li>
						<li>
							<button
								type="button"
								class="sipap-bank-row"
								data-sipap-copy="holder"
								data-sipap-copy-keep-label
								aria-label="Copiar titular"
							>
								<span class="sipap-bank-row__label">Titular</span>
								<span class="sipap-bank-row__value">
									<span data-sipap-holder>—</span>
									<span class="sipap-copy-feedback" aria-hidden="true">¡Copiado!</span>
									<span class="material-symbols-rounded sipap-copy-glyph" aria-hidden="true" data-sipap-copy-icon
										>content_copy</span
									>
								</span>
							</button>
						</li>
						<li>
							<button
								type="button"
								class="sipap-bank-row"
								data-sipap-copy="document"
								data-sipap-copy-keep-label
								aria-label="Copiar C.I. / RUC"
							>
								<span class="sipap-bank-row__label">C.I. / RUC</span>
								<span class="sipap-bank-row__value">
									<span data-sipap-document>—</span>
									<span class="sipap-copy-feedback" aria-hidden="true">¡Copiado!</span>
									<span class="material-symbols-rounded sipap-copy-glyph" aria-hidden="true" data-sipap-copy-icon
										>content_copy</span
									>
								</span>
							</button>
						</li>
						<li>
							<button
								type="button"
								class="sipap-bank-row"
								data-sipap-copy="alias"
								data-sipap-copy-keep-label
								aria-label="Copiar alias"
							>
								<span class="sipap-bank-row__label">Alias</span>
								<span class="sipap-bank-row__value">
									<span data-sipap-alias>—</span>
									<span class="sipap-copy-feedback" aria-hidden="true">¡Copiado!</span>
									<span class="material-symbols-rounded sipap-copy-glyph" aria-hidden="true" data-sipap-copy-icon
										>content_copy</span
									>
								</span>
							</button>
						</li>
					</ul>

					<div class="sipap-ref-block">
						<p class="sipap-ref-block__label">
							Código para el concepto
							<span class="sipap-ref-optional">(opcional)</span>
							<span class="sipap-ref-badge">Recomendado</span>
						</p>
						<button
							type="button"
							class="sipap-ref-block__code"
							data-sipap-copy="reference"
							data-sipap-copy-keep-label
							aria-label="Copiar código"
							aria-describedby="sipap-ref-hint"
						>
							<p class="sipap-ref-block__value" data-sipap-reference>—</p>
							<input type="hidden" data-sipap-reference-value />
							<span class="sipap-copy-feedback" aria-hidden="true">¡Copiado!</span>
							<span class="material-symbols-rounded sipap-copy-glyph" aria-hidden="true" data-sipap-copy-icon
								>content_copy</span
							>
						</button>
						<p class="sipap-ref-hint" id="sipap-ref-hint">
							Incluye este código en tu transferencia para validación automática.
						</p>
					</div>

					<p class="sr-only" data-sipap-copy-status role="status" aria-live="polite"></p>

					<div class="sipap-upload-section" data-sipap-upload-section>
						<input type="hidden" data-sipap-manage-token />
						<div class="sipap-upload-card" data-sipap-upload>
							<p class="sipap-panel__kicker" id="sipap-upload-title">Comprobante</p>
							<p class="sipap-panel__lede" id="sipap-upload-hint">JPG, PNG o PDF (máx. 8 MB).</p>
							<div
								class:list={['sipap-reject-alert', { hidden: !receiptRejected }]}
								data-sipap-reject-alert
								hidden={!receiptRejected}
							>
								<span class="material-symbols-rounded" aria-hidden="true">error</span>
								<div>
									<p class="sipap-reject-alert__title">Comprobante rechazado</p>
									<p class="sipap-reject-alert__text">
										El comprobante adjunto no se pudo validar. Por favor, subí una foto más clara.
									</p>
								</div>
							</div>
							<div class="sipap-dropzone-wrap">
								<label
									class="sipap-dropzone"
									data-sipap-dropzone
									aria-labelledby="sipap-upload-title"
									aria-describedby="sipap-upload-hint"
								>
									<input
										type="file"
										accept="image/jpeg,image/png,.jpg,.jpeg,.png,application/pdf,.pdf"
										data-sipap-upload-input
										class="sr-only"
									/>
									<div class="sipap-dropzone__empty" data-sipap-dropzone-empty>
										<span class="material-symbols-rounded sipap-dropzone__icon" aria-hidden="true"
											>cloud_upload</span
										>
										<span class="sipap-dropzone__title">Subí el comprobante o arrastralo acá</span>
									</div>
									<div class="sipap-dropzone__preview hidden" data-sipap-dropzone-preview>
										<img
											alt="Vista previa del comprobante"
											class="sipap-dropzone__thumb hidden"
											data-sipap-preview-image
										/>
										<div class="sipap-dropzone__pdf hidden" data-sipap-preview-pdf>
											<span class="material-symbols-rounded" aria-hidden="true">description</span>
											<span class="sipap-dropzone__filename" data-sipap-preview-name></span>
										</div>
									</div>
								</label>
								<button
									type="button"
									class="sipap-dropzone__clear hidden"
									data-sipap-preview-clear
									aria-label="Quitar comprobante"
								>
									<span class="material-symbols-rounded" aria-hidden="true">delete</span>
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<aside class="sipap-panel sipap-summary-ticket" aria-label="Resumen de la seña">
			<div class="sipap-panel__core sipap-summary-ticket__core">
				<p class="sipap-panel__kicker">Resumen</p>
				<p class="sipap-summary-ticket__amount" data-sipap-amount>—</p>
				<p class="sipap-summary-ticket__for" data-sipap-for>Seña por: —</p>
				<details class="sipap-policy-details">
					<summary class="sipap-policy-summary">
						<span class="material-symbols-rounded sipap-policy-summary__shield" aria-hidden="true"
							>verified_user</span
						>
						<span class="sipap-policy-summary__title">
							Política: <span data-sipap-policy-label>—</span>
						</span>
						<span class="material-symbols-rounded sipap-policy-summary__info" aria-hidden="true"
							>info</span
						>
						<span class="sr-only">Ver detalles</span>
					</summary>
					<p class="sipap-policy-details__copy" data-sipap-policy-summary>—</p>
				</details>

				<div class="sipap-submit-dock" data-sipap-submit-dock>
					<p
						class="sipap-upload-status"
						data-sipap-upload-status
						data-state="idle"
						role="status"
						aria-live="polite"
					></p>
					<button
						type="button"
						data-sipap-upload-submit
						class="sipap-submit-cta inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full px-5 py-3 text-base font-medium leading-snug"
						disabled
						aria-busy="false"
					>
						<span
							class="sipap-submit-cta__spinner material-symbols-rounded"
							aria-hidden="true"
							data-sipap-submit-spinner>progress_activity</span
						>
						<span data-sipap-submit-label>Confirmar y enviar comprobante</span>
					</button>
				</div>
			</div>
		</aside>
	</div>
</section>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	[data-sipap-hold-active].hidden,
	[data-sipap-hold-expired].hidden,
	[data-sipap-hold-unknown].hidden,
	[data-sipap-hold-submitted].hidden {
		display: none;
	}

	.sipap-hold-banner {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
		padding: 0.45rem 0.75rem;
		border-radius: 0.65rem;
		border: 1px solid rgb(249 115 22 / 0.2);
		background: rgb(249 115 22 / 0.1);
	}

	.sipap-hold-banner.is-expired {
		border-color: rgb(249 115 22 / 0.35);
		background: rgb(249 115 22 / 0.16);
	}

	.sipap-hold-banner.hidden {
		display: none;
		margin-bottom: 0;
	}

	.sipap-hold-banner:not(.hidden) ~ .sipap-deposit-intro {
		margin-top: 0;
	}

	.sipap-hold-banner.is-submitted {
		border-color: rgb(251 191 36 / 0.3);
		background: rgb(251 191 36 / 0.12);
	}

	.sipap-hold-banner.is-submitted .sipap-hold-banner__icon {
		color: #fbbf24;
	}

	.sipap-hold-banner__icon {
		flex-shrink: 0;
		font-size: 1.15rem;
		line-height: 1;
		color: #f97316;
	}

	.sipap-hold-banner__text {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 550;
		line-height: 1.25;
		color: var(--on-surface);
	}

	.sipap-hold-banner__text strong {
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		color: #f97316;
	}

	.sipap-deposit-panel {
		container-type: inline-size;
		text-align: left;
	}

	.sipap-deposit-intro {
		margin: 0.85rem 0 0;
		text-align: left;
	}

	.sipap-deposit-title {
		margin: 0;
		max-width: none;
		font-size: 1.25rem;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.15;
		text-align: left;
		text-wrap: balance;
	}

	.sipap-layout {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		align-items: stretch;
		margin-top: 0.75rem;
	}

	.sipap-main {
		display: grid;
		gap: 0;
		min-width: 0;
	}

	.sipap-summary-ticket {
		align-self: stretch;
	}

	/* Móvil: timer → monto → título → datos. */
	@media (max-width: 959px) {
		.sipap-deposit-panel {
			display: flex;
			flex-direction: column;
		}

		.sipap-hold-banner {
			order: 0;
			margin-bottom: 1rem;
		}

		.sipap-hold-banner:not(.hidden) ~ .sipap-layout .sipap-summary-ticket {
			margin-top: 0;
		}

		.sipap-layout {
			display: contents;
			margin-top: 0;
		}

		.sipap-summary-ticket {
			order: 1;
			margin-top: 0.85rem;
		}

		.sipap-deposit-intro,
		.sipap-hold-banner:not(.hidden) ~ .sipap-deposit-intro {
			order: 2;
			margin: 1.15rem 1rem 0.25rem;
		}

		.sipap-main {
			order: 3;
			margin-top: 1rem;
		}
	}

	.sipap-panel {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 0;
		border-radius: 1.15rem;
		border: 1px solid #27272a;
		background: #18181b;
		box-shadow: none;
	}

	.sipap-panel__core {
		display: flex;
		flex-direction: column;
		min-height: 0;
		padding: 0.85rem 1.15rem 1.2rem;
		border-radius: inherit;
		background: transparent;
		box-shadow: none;
	}

	.sipap-summary-ticket__core {
		gap: 0;
	}

	.sipap-panel__kicker {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		line-height: 1.2;
		color: #9ca3af;
	}

	.sipap-panel__lede {
		margin: 0.3rem 0 0;
		font-size: 0.78rem;
		font-weight: 500;
		line-height: 1.4;
		color: var(--on-surface-variant);
	}

	.sipap-upload-section {
		display: grid;
		gap: 0.7rem;
		min-width: 0;
		margin-top: 0.95rem;
		padding-top: 0.9rem;
		border-top: 1px solid color-mix(in srgb, var(--outline-variant) 55%, transparent);
	}

	.sipap-upload-section.hidden {
		display: none;
	}

	.sipap-reject-alert {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
		margin-top: 0.65rem;
		padding: 0.7rem 0.8rem;
		border-radius: 0.85rem;
		border: 1px solid color-mix(in srgb, #ef4444 38%, transparent);
		background: color-mix(in srgb, #ef4444 12%, #18181b);
	}

	.sipap-reject-alert.hidden {
		display: none;
	}

	.sipap-reject-alert .material-symbols-rounded {
		flex-shrink: 0;
		margin-top: 0.05rem;
		font-size: 1.15rem;
		line-height: 1;
		color: #f87171;
	}

	.sipap-reject-alert__title {
		margin: 0;
		font-size: 0.84rem;
		font-weight: 750;
		line-height: 1.3;
		color: #fecaca;
	}

	.sipap-reject-alert__text {
		margin: 0.2rem 0 0;
		font-size: 0.8rem;
		font-weight: 500;
		line-height: 1.4;
		color: #fca5a5;
	}

	.sipap-dropzone-wrap {
		position: relative;
		margin-top: 0.55rem;
		padding: 1px;
	}

	.sipap-transfer-card__list {
		margin: 0.55rem 0 0;
		padding: 0;
		list-style: none;
	}

	.sipap-bank-row {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: 0.75rem;
		width: 100%;
		margin: 0;
		padding: 0.5rem 0.15rem;
		border: 0;
		border-radius: 0.65rem;
		background: transparent;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.sipap-transfer-card__list > li + li .sipap-bank-row {
		border-top: 1px solid color-mix(in srgb, var(--outline-variant) 45%, transparent);
		border-radius: 0;
	}

	.sipap-bank-row:hover,
	.sipap-bank-row:focus-visible {
		background: color-mix(in srgb, var(--primary) 8%, transparent);
	}

	.sipap-bank-row:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 70%, transparent);
		outline-offset: 2px;
	}

	.sipap-bank-row__label {
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: color-mix(in srgb, var(--on-surface-variant) 68%, transparent);
	}

	.sipap-bank-row__value {
		display: inline-flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.4rem;
		min-width: 0;
		font-size: 0.95rem;
		font-weight: 700;
		color: #fff;
		text-align: right;
		overflow-wrap: anywhere;
	}

	.sipap-ref-block {
		margin-top: 0.65rem;
		padding: 0.55rem 0.7rem 0.65rem;
		border-radius: 0.9rem;
		background: color-mix(in srgb, var(--primary) 10%, #1a1a1a);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 28%, transparent);
	}

	.sipap-ref-block__label {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem 0.45rem;
		margin: 0;
		font-size: 0.8rem;
		font-weight: 650;
		color: var(--on-surface);
	}

	.sipap-ref-optional {
		font-size: 0.75rem;
		font-weight: 550;
		color: var(--on-surface-variant);
	}

	.sipap-ref-block__code {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		width: 100%;
		min-width: 0;
		margin-top: 0.35rem;
		padding: 0.2rem 0;
		border: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
		border-radius: 0.55rem;
	}

	.sipap-ref-block__code:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 70%, transparent);
		outline-offset: 2px;
	}

	.sipap-ref-block__value {
		min-width: 0;
		margin: 0;
		flex: 1 1 auto;
		overflow-wrap: anywhere;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: 0.03em;
		line-height: 1.2;
		color: #fff;
	}

	.sipap-ref-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.12rem 0.45rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--primary) 18%, transparent);
		color: var(--primary);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		line-height: 1.2;
	}

	.sipap-ref-hint {
		margin: 0.4rem 0 0;
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.35;
		color: var(--on-surface-variant);
	}

	.sipap-copy-feedback {
		display: none;
		flex-shrink: 0;
		font-size: 0.72rem;
		font-weight: 700;
		color: #4ade80;
	}

	.sipap-bank-row.is-copied .sipap-copy-feedback,
	.sipap-ref-block__code.is-copied .sipap-copy-feedback {
		display: inline;
	}

	.sipap-copy-glyph {
		flex-shrink: 0;
		font-size: 1.05rem;
		line-height: 1;
		color: color-mix(in srgb, var(--primary) 88%, #fff);
	}

	.sipap-bank-row.is-copied .sipap-copy-glyph,
	.sipap-ref-block__code.is-copied .sipap-copy-glyph {
		color: #4ade80;
	}

	.sipap-dropzone {
		position: relative;
		display: flex;
		box-sizing: border-box;
		width: 100%;
		min-height: 5.5rem;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 0.85rem 0.9rem;
		border: 2px dashed color-mix(in srgb, var(--outline-variant) 50%, #fff 28%);
		border-radius: 0.85rem;
		background: color-mix(in srgb, #141414 78%, var(--surface-container-lowest) 22%);
		box-shadow: none;
		cursor: pointer;
		transition:
			border-color 0.28s cubic-bezier(0.32, 0.72, 0, 1),
