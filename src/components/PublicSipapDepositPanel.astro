---
/**
 * Paso de seña SIPAP (reserva pública).
 * Layout: acciones a la izquierda + ticket resumen sticky a la derecha (desktop).
 */
interface Props {
	stepPanel?: number;
}

const { stepPanel = 6 } = Astro.props;
---

<section
	data-step-panel={String(stepPanel)}
	class="sipap-deposit-panel public-booking-panel hidden text-(--on-surface)"
>
	<div class="sipap-hold-banner" data-sipap-hold-banner data-sipap-hold-state="active">
		<span class="material-symbols-rounded sipap-hold-banner__icon" aria-hidden="true">timer</span>
		<p class="sipap-hold-banner__text">
			<span data-sipap-hold-active>
				Tu turno está reservado. Tenés
				<strong class="tabular-nums" data-sipap-countdown>10:00</strong>
				min para adjuntar el comprobante.
			</span>
			<span class="hidden" data-sipap-hold-expired>
				Se venció el tiempo para adjuntar el comprobante.
			</span>
			<span class="hidden" data-sipap-hold-unknown>
				Tu turno está reservado. Adjuntá el comprobante para confirmar.
			</span>
			<span class="hidden" data-sipap-hold-submitted>
				Comprobante enviado. Esperando confirmación del comercio.
			</span>
		</p>
	</div>
	<p class="sr-only" data-sipap-hold-live role="status" aria-live="polite"></p>

	<div class="sipap-deposit-layout">
		<div class="sipap-deposit-main grid min-w-0">
			<div>
				<h2 class="sipap-deposit-title tracking-tight">Transferí la seña para confirmar</h2>
				<p class="sipap-deposit-lead font-medium text-(--on-surface-variant)">
					Hacé la transferencia SIPAP con el código en el concepto y subí el comprobante acá.
				</p>
			</div>

			<div class="sipap-reference-card">
				<p class="text-sm font-medium text-(--on-surface-variant)">Código para el concepto</p>
				<div class="sipap-reference-card__code">
					<p class="sipap-reference-card__value" data-sipap-reference>—</p>
					<input type="hidden" data-sipap-reference-value />
					<button
						type="button"
						data-sipap-copy="reference"
						data-sipap-copy-keep-label
						class="sipap-copy-primary"
						aria-label="Copiar código"
					>
						<span class="material-symbols-rounded" aria-hidden="true" data-sipap-copy-icon
							>content_copy</span
						>
						<span class="sipap-copy-primary__label" data-sipap-copy-label>Copiar código</span>
					</button>
				</div>
				<p class="sipap-reference-card__hint text-(--on-surface-variant)">
					Pegá este código exactamente en el concepto de la transferencia.
				</p>
			</div>

			<div class="sipap-bank-card">
				<p class="text-sm font-bold uppercase tracking-wide text-(--primary)">Datos SIPAP del comercio</p>
				<ul class="mt-4 grid gap-0 divide-y divide-(--outline-variant)/60">
					<li class="sipap-bank-row">
						<span class="sipap-bank-row__label">Banco</span>
						<span class="sipap-bank-row__value">
							<span class="material-symbols-rounded sipap-bank-row__icon" aria-hidden="true"
								>account_balance</span
							>
							<span data-sipap-bank>—</span>
						</span>
					</li>
					<li class="sipap-bank-row">
						<span class="sipap-bank-row__label">Titular</span>
						<span class="sipap-bank-row__value">
							<span data-sipap-holder>—</span>
						</span>
					</li>
					<li class="sipap-bank-row">
						<span class="sipap-bank-row__label">C.I. / RUC</span>
						<span class="sipap-bank-row__value">
							<span data-sipap-document>—</span>
							<button
								type="button"
								data-sipap-copy="document"
								class="sipap-copy-icon"
								aria-label="Copiar C.I. / RUC"
								title="Copiar"
							>
								<span class="material-symbols-rounded" aria-hidden="true" data-sipap-copy-icon
									>content_copy</span
								>
							</button>
						</span>
					</li>
					<li class="sipap-bank-row">
						<span class="sipap-bank-row__label">Alias</span>
						<span class="sipap-bank-row__value">
							<span data-sipap-alias>—</span>
							<button
								type="button"
								data-sipap-copy="alias"
								class="sipap-copy-icon"
								aria-label="Copiar alias"
								title="Copiar"
							>
								<span class="material-symbols-rounded" aria-hidden="true" data-sipap-copy-icon
									>content_copy</span
								>
							</button>
						</span>
					</li>
				</ul>
				<button
					type="button"
					data-sipap-copy="all"
					class="sipap-copy-all inline-flex w-full items-center justify-center gap-2 rounded-full px-5 text-sm font-semibold"
				>
					<span class="material-symbols-rounded text-[1.15rem]" aria-hidden="true" data-sipap-copy-icon
						>content_copy</span
					>
					<span data-sipap-copy-label>Copiar datos de transferencia</span>
				</button>
				<p class="sipap-copy-status" data-sipap-copy-status role="status" aria-live="polite"></p>
			</div>

			<div class="sipap-upload-section grid gap-3 min-w-0" data-sipap-upload-section>
				<input type="hidden" data-sipap-manage-token />
				<div class="sipap-upload-card" data-sipap-upload>
					<p class="text-sm font-bold text-(--on-surface)" id="sipap-upload-title">Subí el comprobante</p>
					<p class="mt-1 text-sm text-(--on-surface-variant)" id="sipap-upload-hint">
						Subí una foto clara del ticket (JPG o PNG) o el comprobante en PDF. Lo leemos al instante para confirmar tu seña.
					</p>
					<div class="sipap-dropzone-wrap mt-4">
						<label
							class="sipap-dropzone"
							data-sipap-dropzone
							aria-labelledby="sipap-upload-title"
							aria-describedby="sipap-upload-hint"
						>
							<input
								type="file"
								accept="image/jpeg,image/png,.jpg,.jpeg,.png,application/pdf,.pdf"
								data-sipap-upload-input
								class="sr-only"
							/>
							<div class="sipap-dropzone__empty" data-sipap-dropzone-empty>
								<span class="material-symbols-rounded sipap-dropzone__icon" aria-hidden="true"
									>cloud_upload</span
								>
								<span class="sipap-dropzone__title">
									Hacé clic para subir tu comprobante o arrastralo acá
								</span>
								<span class="sipap-dropzone__meta">JPG, PNG o PDF · máx. 8 MB</span>
							</div>
							<div class="sipap-dropzone__preview hidden" data-sipap-dropzone-preview>
								<img
									alt="Vista previa del comprobante"
									class="sipap-dropzone__thumb hidden"
									data-sipap-preview-image
								/>
								<div class="sipap-dropzone__pdf hidden" data-sipap-preview-pdf>
									<span class="material-symbols-rounded" aria-hidden="true">description</span>
									<span class="sipap-dropzone__filename" data-sipap-preview-name></span>
								</div>
							</div>
						</label>
						<button
							type="button"
							class="sipap-dropzone__clear hidden"
							data-sipap-preview-clear
							aria-label="Quitar comprobante"
						>
							<span class="material-symbols-rounded" aria-hidden="true">delete</span>
						</button>
					</div>
				</div>

				<div class="sipap-submit-dock" data-sipap-submit-dock>
					<p
						class="sipap-upload-status"
						data-sipap-upload-status
						data-state="idle"
						role="status"
						aria-live="polite"
					></p>
					<button
						type="button"
						data-sipap-upload-submit
						class="sipap-submit-cta inline-flex h-12 w-full items-center justify-center rounded-full px-6 text-base font-medium"
						disabled
					>
						Enviar comprobante
					</button>
				</div>
			</div>
		</div>

		<aside class="sipap-summary-ticket" aria-label="Resumen de la seña">
			<p class="text-xs font-bold uppercase tracking-widest text-(--primary)">Resumen</p>
			<p class="sipap-summary-ticket__amount" data-sipap-amount>—</p>
			<p class="mt-2 text-sm font-medium text-(--on-surface-variant)" data-sipap-for>
				Seña por: —
			</p>

			<div class="sipap-policy-card mt-5">
				<div class="flex items-start gap-2.5">
					<span class="material-symbols-rounded sipap-policy-card__icon" aria-hidden="true"
						>verified_user</span
					>
					<div class="min-w-0">
						<p class="text-sm font-semibold text-(--on-surface-variant)">
							Política: <span data-sipap-policy-label>—</span>
						</p>
						<p class="mt-1 text-sm leading-relaxed text-(--on-surface-variant)" data-sipap-policy-summary>
							—
						</p>
					</div>
				</div>
			</div>
		</aside>
	</div>
</section>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	[data-sipap-hold-active].hidden,
	[data-sipap-hold-expired].hidden,
	[data-sipap-hold-unknown].hidden,
	[data-sipap-hold-submitted].hidden {
		display: none;
	}

	.sipap-hold-banner {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 0.75rem;
		border-radius: 0.65rem;
		border: 1px solid rgb(249 115 22 / 0.2);
		background: rgb(249 115 22 / 0.1);
	}

	.sipap-hold-banner.is-expired {
		border-color: rgb(249 115 22 / 0.35);
		background: rgb(249 115 22 / 0.16);
	}

	.sipap-hold-banner.hidden {
		display: none;
	}

	/* Comprobante ya subido y en revisión: tono ámbar calmo (el reloj está congelado, no
	   hay urgencia para el cliente, la pelota está del lado del negocio). */
	.sipap-hold-banner.is-submitted {
		border-color: rgb(251 191 36 / 0.3);
		background: rgb(251 191 36 / 0.12);
	}

	.sipap-hold-banner.is-submitted .sipap-hold-banner__icon {
		color: #fbbf24;
	}

	.sipap-hold-banner__icon {
		flex-shrink: 0;
		font-size: 1.15rem;
		line-height: 1;
		color: #f97316;
	}

	.sipap-hold-banner__text {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 550;
		line-height: 1.25;
		color: var(--on-surface);
	}

	.sipap-hold-banner__text strong {
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		color: #f97316;
	}

	.sipap-deposit-layout {
		display: grid;
		gap: 0.85rem;
		align-items: start;
		margin-top: 0.75rem;
	}

	.sipap-deposit-main {
		gap: 0.85rem;
	}

	.sipap-deposit-title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 400;
		line-height: 1.2;
	}

	.sipap-deposit-lead {
		margin: 0.35rem 0 0;
		font-size: 0.88rem;
		line-height: 1.35;
	}

	@media (min-width: 960px) {
		.sipap-deposit-layout {
			grid-template-columns: minmax(0, 1.7fr) minmax(260px, 0.95fr);
			gap: 1.5rem;
			margin-top: 1.5rem;
		}

		.sipap-deposit-main {
			gap: 1rem;
		}

		.sipap-hold-banner {
			align-items: flex-start;
			gap: 0.65rem;
			padding: 0.85rem 1rem;
			border-radius: 1rem;
		}

		.sipap-hold-banner__icon {
			margin-top: 0.05rem;
			font-size: 1.25rem;
		}

		.sipap-hold-banner__text {
			font-size: 0.9rem;
			line-height: 1.4;
		}

		.sipap-deposit-title {
			font-size: 1.875rem;
		}

		.sipap-deposit-lead {
			margin-top: 0.5rem;
			font-size: 1rem;
		}
	}

	.sipap-reference-card {
		padding: 0.85rem 1rem;
		border-radius: 1.1rem;
		border: 1px solid color-mix(in srgb, var(--primary) 55%, var(--outline-variant));
		background: color-mix(in srgb, var(--primary-container) 28%, #121212);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 12%, transparent);
	}

	.sipap-reference-card__code {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		margin-top: 0.35rem;
	}

	.sipap-reference-card__value {
		min-width: 0;
		margin: 0;
		flex: 1 1 auto;
		overflow-wrap: anywhere;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 1.15rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		line-height: 1.2;
		color: var(--on-surface);
	}

	.sipap-reference-card__hint {
		margin: 0.4rem 0 0;
		font-size: 0.75rem;
		line-height: 1.3;
	}

	.sipap-copy-primary {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container-highest) 70%, transparent);
		color: var(--on-surface);
		cursor: pointer;
	}

	.sipap-copy-primary .material-symbols-rounded {
		font-size: 1.2rem;
		line-height: 1;
	}

	.sipap-copy-primary__label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.sipap-copy-primary:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 70%, transparent);
		outline-offset: 2px;
	}

	.sipap-copy-primary.is-copied {
		color: var(--tertiary);
	}

	@media (min-width: 960px) {
		.sipap-reference-card {
			padding: 1.15rem 1.25rem;
			border-radius: 1.25rem;
		}

		.sipap-reference-card__value {
			font-size: 1.5rem;
		}

		.sipap-reference-card__hint {
			margin-top: 0.75rem;
			font-size: 0.875rem;
		}

		.sipap-copy-primary {
			width: auto;
			height: 2.75rem;
			gap: 0.5rem;
			padding: 0 1.25rem;
			background: var(--primary-container);
			color: var(--on-primary-container);
			font-size: 0.875rem;
			font-weight: 600;
		}

		.sipap-copy-primary__label {
			position: static;
			width: auto;
			height: auto;
			margin: 0;
			overflow: visible;
			clip: unset;
			clip-path: none;
			white-space: nowrap;
		}
	}

	.sipap-bank-card {
		padding: 0.85rem 1rem;
		border-radius: 1.1rem;
		border: 1px solid color-mix(in srgb, var(--outline-variant) 70%, transparent);
		background: color-mix(in srgb, #252525 88%, var(--surface-container-lowest));
	}

	.sipap-bank-card ul {
		margin-top: 0.5rem;
	}

	.sipap-bank-row {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 0;
	}

	.sipap-bank-row__label {
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--on-surface-variant);
	}

	.sipap-bank-row__value {
		display: inline-flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.35rem;
		min-width: 0;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--on-surface);
		text-align: right;
		overflow-wrap: anywhere;
	}

	.sipap-bank-row__icon {
		display: none;
		flex-shrink: 0;
		font-size: 1.15rem;
		line-height: 1;
		color: var(--primary);
		opacity: 0.9;
	}

	@media (min-width: 960px) {
		.sipap-bank-card {
			padding: 1.15rem 1.25rem;
			border-radius: 1.25rem;
		}

		.sipap-bank-card ul {
			margin-top: 1rem;
		}

		.sipap-bank-row {
			padding: 0.85rem 0;
		}

		.sipap-bank-row__icon {
			display: inline;
		}

		.sipap-bank-row__value {
			font-size: 0.98rem;
		}
	}

	.sipap-copy-icon {
		display: inline-grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		margin-left: 0.05rem;
		border: 0;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container-highest) 70%, transparent);
		color: var(--on-surface-variant);
		cursor: pointer;
		transition:
			background 0.2s cubic-bezier(0.16, 1, 0.3, 1),
			color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.sipap-copy-icon:hover {
		background: color-mix(in srgb, var(--primary) 22%, transparent);
		color: var(--primary);
		transform: scale(1.08);
	}

	.sipap-copy-icon:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 70%, transparent);
		outline-offset: 2px;
	}

	.sipap-copy-icon .material-symbols-rounded {
		font-size: 1.05rem;
		line-height: 1;
	}

	.sipap-copy-icon.is-copied {
		color: var(--tertiary);
	}

	.sipap-copy-all {
		height: 2.5rem;
		margin-top: 0.75rem;
		border: 1px solid color-mix(in srgb, var(--outline-variant) 80%, transparent);
		background: color-mix(in srgb, var(--surface-container-highest) 55%, transparent);
		color: var(--on-surface);
		cursor: pointer;
		transition:
			background 0.2s cubic-bezier(0.16, 1, 0.3, 1),
			border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.sipap-copy-all:hover {
		border-color: color-mix(in srgb, var(--primary) 45%, var(--outline-variant));
		background: color-mix(in srgb, var(--primary) 12%, transparent);
		color: var(--on-surface);
	}

	.sipap-copy-all:active {
		transform: scale(0.98);
	}

	.sipap-copy-all:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 70%, transparent);
		outline-offset: 2px;
	}

	.sipap-copy-all.is-copied {
		border-color: color-mix(in srgb, var(--tertiary) 45%, transparent);
		color: var(--tertiary);
	}

	.sipap-copy-status {
		margin: 0.35rem 0 0;
		min-height: 1.05rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--on-surface-variant);
	}

	@media (min-width: 960px) {
		.sipap-copy-icon {
			width: 2rem;
			height: 2rem;
		}

		.sipap-copy-all {
			height: 2.75rem;
			margin-top: 1rem;
		}
	}

	.sipap-copy-status[data-state='error'] {
		color: #f87171;
	}

	.sipap-upload-card {
		padding: 0.85rem 1rem;
		border-radius: 1.1rem;
		border: 1px solid var(--outline-variant);
		background: var(--surface-container-lowest);
	}

	.sipap-upload-card #sipap-upload-hint {
		font-size: 0.78rem;
		line-height: 1.3;
	}

	.sipap-dropzone-wrap {
		position: relative;
	}

	.sipap-dropzone {
		position: relative;
		display: flex;
		width: 100%;
		min-height: 7.5rem;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 1.25rem 1rem;
		border: 2px dashed color-mix(in srgb, var(--outline-variant) 88%, var(--on-surface-variant) 12%);
		border-radius: 1.1rem;
		background: color-mix(in srgb, var(--surface) 70%, var(--surface-container-lowest) 30%);
		cursor: pointer;
		transition:
			border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
			background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.sipap-dropzone:hover,
	.sipap-dropzone.is-dragging {
		border-color: color-mix(in srgb, var(--primary) 55%, var(--outline-variant));
		background: color-mix(in srgb, var(--primary) 8%, var(--surface-container-lowest));
	}

	.sipap-dropzone:focus-within {
		outline: 2px solid color-mix(in srgb, var(--primary) 55%, transparent);
		outline-offset: 2px;
	}

	.sipap-dropzone.is-locked,
	.sipap-dropzone.is-locked:hover {
		cursor: not-allowed;
		opacity: 0.72;
	}

	.sipap-dropzone.has-preview {
		padding: 0;
		overflow: hidden;
