---
/**
 * Paso de seña SIPAP (reserva pública).
 * Layout: acciones a la izquierda + ticket resumen sticky a la derecha (desktop).
 */
interface Props {
	stepPanel?: number;
}

const { stepPanel = 7 } = Astro.props;
---

<section
	data-step-panel={String(stepPanel)}
	class="sipap-deposit-panel public-booking-panel hidden text-(--on-surface)"
>
	<div class="sipap-hold-banner" data-sipap-hold-banner data-sipap-hold-state="active">
		<span class="material-symbols-rounded sipap-hold-banner__icon" aria-hidden="true">timer</span>
		<p class="sipap-hold-banner__text">
			<span data-sipap-hold-active>
				Tu turno está reservado. Tenés
				<strong class="tabular-nums" data-sipap-countdown>10:00</strong>
				min para adjuntar el comprobante.
			</span>
			<span class="hidden" data-sipap-hold-expired>
				Se venció el tiempo para adjuntar el comprobante.
			</span>
			<span class="hidden" data-sipap-hold-unknown>
				Tu turno está reservado. Adjuntá el comprobante para confirmar.
			</span>
			<span class="hidden" data-sipap-hold-submitted>
				Comprobante enviado. Esperando confirmación del comercio.
			</span>
		</p>
	</div>
	<p class="sr-only" data-sipap-hold-live role="status" aria-live="polite"></p>

	<div class="sipap-layout">
		<div class="sipap-main">
			<header class="sipap-deposit-intro">
				<h2 class="sipap-deposit-title tracking-tight">Transferí la seña para confirmar</h2>
			</header>

			<div class="sipap-panel sipap-sheet">
				<div class="sipap-panel__core">
					<p class="sipap-panel__kicker">Datos de transferencia</p>
					<ul class="sipap-transfer-card__list">
						<li class="sipap-bank-row">
							<span class="sipap-bank-row__label">Banco</span>
							<span class="sipap-bank-row__value">
								<span data-sipap-bank>—</span>
							</span>
						</li>
						<li class="sipap-bank-row">
							<span class="sipap-bank-row__label">Titular</span>
							<span class="sipap-bank-row__value">
								<span data-sipap-holder>—</span>
							</span>
						</li>
						<li class="sipap-bank-row">
							<span class="sipap-bank-row__label">C.I. / RUC</span>
							<span class="sipap-bank-row__value">
								<span data-sipap-document>—</span>
								<button
									type="button"
									data-sipap-copy="document"
									class="sipap-copy-icon"
									aria-label="Copiar C.I. / RUC"
									title="Copiar"
								>
									<span class="material-symbols-rounded" aria-hidden="true" data-sipap-copy-icon
										>content_copy</span
									>
								</button>
							</span>
						</li>
						<li class="sipap-bank-row">
							<span class="sipap-bank-row__label">Alias</span>
							<span class="sipap-bank-row__value">
								<span data-sipap-alias>—</span>
								<button
									type="button"
									data-sipap-copy="alias"
									class="sipap-copy-icon"
									aria-label="Copiar alias"
									title="Copiar"
								>
									<span class="material-symbols-rounded" aria-hidden="true" data-sipap-copy-icon
										>content_copy</span
									>
								</button>
							</span>
						</li>
					</ul>

					<div class="sipap-ref-block">
						<p class="sipap-ref-block__label">
							Código para el concepto
							<span class="sipap-ref-optional">(opcional)</span>
							<span class="sipap-ref-badge">Recomendado</span>
						</p>
						<div class="sipap-ref-block__code">
							<p class="sipap-ref-block__value" data-sipap-reference>—</p>
							<input type="hidden" data-sipap-reference-value />
							<button
								type="button"
								data-sipap-copy="reference"
								class="sipap-copy-icon"
								aria-label="Copiar código"
								aria-describedby="sipap-ref-hint"
								title="Copiar"
							>
								<span class="material-symbols-rounded" aria-hidden="true" data-sipap-copy-icon
									>content_copy</span
								>
							</button>
						</div>
						<p class="sipap-ref-hint" id="sipap-ref-hint">
							Pegalo en el concepto de tu transferencia para aprobación automática. Si tu banco no
							te deja, subí el ticket igual.
						</p>
					</div>

					<p class="sr-only" data-sipap-copy-status role="status" aria-live="polite"></p>

					<div class="sipap-upload-section" data-sipap-upload-section>
						<input type="hidden" data-sipap-manage-token />
						<div class="sipap-upload-card" data-sipap-upload>
							<p class="sipap-panel__kicker" id="sipap-upload-title">Comprobante</p>
							<p class="sipap-panel__lede" id="sipap-upload-hint">JPG, PNG o PDF (máx. 8 MB).</p>
							<div class="sipap-dropzone-wrap">
								<label
									class="sipap-dropzone"
									data-sipap-dropzone
									aria-labelledby="sipap-upload-title"
									aria-describedby="sipap-upload-hint"
								>
									<input
										type="file"
										accept="image/jpeg,image/png,.jpg,.jpeg,.png,application/pdf,.pdf"
										data-sipap-upload-input
										class="sr-only"
									/>
									<div class="sipap-dropzone__empty" data-sipap-dropzone-empty>
										<span class="material-symbols-rounded sipap-dropzone__icon" aria-hidden="true"
											>cloud_upload</span
										>
										<span class="sipap-dropzone__title">Subí el comprobante o arrastralo acá</span>
									</div>
									<div class="sipap-dropzone__preview hidden" data-sipap-dropzone-preview>
										<img
											alt="Vista previa del comprobante"
											class="sipap-dropzone__thumb hidden"
											data-sipap-preview-image
										/>
										<div class="sipap-dropzone__pdf hidden" data-sipap-preview-pdf>
											<span class="material-symbols-rounded" aria-hidden="true">description</span>
											<span class="sipap-dropzone__filename" data-sipap-preview-name></span>
										</div>
									</div>
								</label>
								<button
									type="button"
									class="sipap-dropzone__clear hidden"
									data-sipap-preview-clear
									aria-label="Quitar comprobante"
								>
									<span class="material-symbols-rounded" aria-hidden="true">delete</span>
								</button>
							</div>
						</div>

						<div class="sipap-submit-dock" data-sipap-submit-dock>
							<p
								class="sipap-upload-status"
								data-sipap-upload-status
								data-state="idle"
								role="status"
								aria-live="polite"
							></p>
							<button
								type="button"
								data-sipap-upload-submit
								class="sipap-submit-cta inline-flex h-12 w-full items-center justify-center rounded-full px-6 text-base font-medium"
								disabled
							>
								Confirmar y enviar comprobante
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>

		<aside class="sipap-panel sipap-summary-ticket" aria-label="Resumen de la seña">
			<div class="sipap-panel__core">
				<p class="sipap-panel__kicker">Resumen</p>
				<p class="sipap-summary-ticket__amount" data-sipap-amount>—</p>
				<p class="sipap-summary-ticket__for" data-sipap-for>Seña por: —</p>
				<div class="sipap-policy-card">
					<span class="material-symbols-rounded sipap-policy-card__icon" aria-hidden="true"
						>verified_user</span
					>
					<div class="min-w-0">
						<p class="sipap-policy-card__title">
							Política: <span data-sipap-policy-label>—</span>
						</p>
						<p class="sipap-policy-card__copy" data-sipap-policy-summary>—</p>
					</div>
				</div>
			</div>
		</aside>
	</div>
</section>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	[data-sipap-hold-active].hidden,
	[data-sipap-hold-expired].hidden,
	[data-sipap-hold-unknown].hidden,
	[data-sipap-hold-submitted].hidden {
		display: none;
	}

	.sipap-hold-banner {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 0.75rem;
		border-radius: 0.65rem;
		border: 1px solid rgb(249 115 22 / 0.2);
		background: rgb(249 115 22 / 0.1);
	}

	.sipap-hold-banner.is-expired {
		border-color: rgb(249 115 22 / 0.35);
		background: rgb(249 115 22 / 0.16);
	}

	.sipap-hold-banner.hidden {
		display: none;
	}

	/* Comprobante ya subido y en revisión: tono ámbar calmo (el reloj está congelado, no
	   hay urgencia para el cliente, la pelota está del lado del negocio). */
	.sipap-hold-banner.is-submitted {
		border-color: rgb(251 191 36 / 0.3);
		background: rgb(251 191 36 / 0.12);
	}

	.sipap-hold-banner.is-submitted .sipap-hold-banner__icon {
		color: #fbbf24;
	}

	.sipap-hold-banner__icon {
		flex-shrink: 0;
		font-size: 1.15rem;
		line-height: 1;
		color: #f97316;
	}

	.sipap-hold-banner__text {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 550;
		line-height: 1.25;
		color: var(--on-surface);
	}

	.sipap-hold-banner__text strong {
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		color: #f97316;
	}

	.sipap-deposit-panel {
		container-type: inline-size;
	}

	.sipap-layout {
		display: grid;
		gap: 1rem;
		align-items: start;
		margin-top: 0.85rem;
	}

	.sipap-main {
		display: grid;
		gap: 0.35rem;
		min-width: 0;
	}

	.sipap-deposit-intro {
		margin: 0;
	}

	.sipap-deposit-title {
		margin: 0;
		max-width: 34rem;
		font-size: 1.25rem;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.15;
		text-wrap: balance;
	}

	.sipap-panel {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 0;
		border-radius: 1.15rem;
		border: 1px solid rgb(255 255 255 / 0.08);
		background: color-mix(in srgb, #1c1c1c 94%, var(--surface-container-lowest));
		box-shadow: none;
	}

	.sipap-panel__core {
		display: flex;
		flex-direction: column;
		min-height: 0;
		padding: 0.85rem 1.15rem 1.2rem;
		border-radius: inherit;
		background: transparent;
		box-shadow: none;
	}

	.sipap-panel__kicker {
		margin: 0;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		line-height: 1.2;
		color: color-mix(in srgb, var(--on-surface-variant) 78%, #000);
	}

	.sipap-panel__lede {
		margin: 0.3rem 0 0;
		font-size: 0.78rem;
		font-weight: 500;
		line-height: 1.4;
		color: var(--on-surface-variant);
	}

	.sipap-upload-section {
		display: grid;
		gap: 0.7rem;
		min-width: 0;
		margin-top: 0.95rem;
		padding-top: 0.9rem;
		border-top: 1px solid color-mix(in srgb, var(--outline-variant) 55%, transparent);
	}

	.sipap-upload-section.hidden {
		display: none;
	}

	.sipap-dropzone-wrap {
		position: relative;
		margin-top: 0.55rem;
		padding: 1px;
	}

	.sipap-transfer-card__list {
		margin: 0.55rem 0 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 960px) {
		.sipap-hold-banner {
			align-items: flex-start;
			gap: 0.65rem;
			padding: 0.85rem 1rem;
			border-radius: 1rem;
		}

		.sipap-hold-banner__icon {
			margin-top: 0.05rem;
			font-size: 1.25rem;
		}

		.sipap-hold-banner__text {
			font-size: 0.9rem;
			line-height: 1.4;
		}

		.sipap-layout {
			gap: 1.25rem;
			margin-top: 1.1rem;
		}

		.sipap-deposit-title {
			font-size: 1.75rem;
		}

		.sipap-panel__core {
			padding: 1rem 1.25rem 1.2rem;
		}

		.sipap-panel__lede {
			font-size: 0.82rem;
		}
	}

	@container (min-width: 40rem) {
		.sipap-layout {
			grid-template-columns: minmax(0, 1.7fr) minmax(16rem, 0.82fr);
		}

		.sipap-summary-ticket {
			position: sticky;
			top: 1.15rem;
		}
	}

	.sipap-bank-row {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: 0.75rem;
		padding: 0.38rem 0;
	}

	.sipap-bank-row + .sipap-bank-row {
		border-top: 1px solid color-mix(in srgb, var(--outline-variant) 60%, transparent);
	}

	.sipap-bank-row__label {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.45rem;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--on-surface-variant);
	}

	.sipap-bank-row__value {
		display: inline-flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.35rem;
		min-width: 0;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--on-surface);
		text-align: right;
		overflow-wrap: anywhere;
	}

	.sipap-ref-block {
		margin-top: 0.65rem;
		padding: 0.5rem 0.65rem;
		border-radius: 0.9rem;
		background: color-mix(in srgb, var(--primary) 7%, #1a1a1a);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 16%, transparent);
	}

	.sipap-ref-block__label {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem 0.45rem;
		margin: 0;
		font-size: 0.8rem;
		font-weight: 650;
		color: var(--on-surface);
	}

	.sipap-ref-optional {
		font-size: 0.75rem;
		font-weight: 550;
		color: var(--on-surface-variant);
	}

	.sipap-ref-block__code {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		min-width: 0;
		margin-top: 0.35rem;
	}

	.sipap-ref-block__value {
		min-width: 0;
		margin: 0;
		flex: 1 1 auto;
		overflow-wrap: anywhere;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: 0.03em;
		line-height: 1.2;
	}

	.sipap-ref-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.12rem 0.45rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--primary) 18%, transparent);
		color: var(--primary);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		line-height: 1.2;
	}

	.sipap-ref-hint {
		margin: 0.45rem 0 0;
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.4;
		color: var(--on-surface-variant);
	}

	@media (min-width: 960px) {
		.sipap-transfer-card__list {
			margin-top: 0.45rem;
		}

		.sipap-bank-row {
			padding: 0.42rem 0;
		}

		.sipap-bank-row__value {
			font-size: 0.95rem;
		}

		.sipap-ref-hint {
			font-size: 0.78rem;
		}
	}

	.sipap-copy-icon {
		display: inline-grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		margin-left: 0.05rem;
		border: 0;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container-highest) 70%, transparent);
		color: var(--on-surface-variant);
		cursor: pointer;
		transition:
			background 0.2s cubic-bezier(0.16, 1, 0.3, 1),
			color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.sipap-copy-icon:hover {
		background: color-mix(in srgb, var(--primary) 22%, transparent);
		color: var(--primary);
		transform: scale(1.08);
	}

	.sipap-copy-icon:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 70%, transparent);
		outline-offset: 2px;
	}

	.sipap-copy-icon .material-symbols-rounded {
		font-size: 1.05rem;
		line-height: 1;
	}

	.sipap-copy-icon.is-copied {
		color: var(--tertiary);
	}

	@media (min-width: 960px) {
		.sipap-copy-icon {
			width: 2rem;
			height: 2rem;
		}
	}

	.sipap-dropzone {
		position: relative;
		display: flex;
		box-sizing: border-box;
		width: 100%;
		min-height: 5.25rem;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 0.9rem;
		border: 0;
		border-radius: 0.7rem;
		background: color-mix(in srgb, #161616 70%, var(--surface-container-lowest) 30%);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--outline-variant) 82%, #fff 18%);
		cursor: pointer;
		transition:
			box-shadow 0.28s cubic-bezier(0.32, 0.72, 0, 1),
			background-color 0.28s cubic-bezier(0.32, 0.72, 0, 1),
			transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
	}

	.sipap-dropzone:hover,
	.sipap-dropzone.is-dragging {
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 55%, var(--outline-variant));
		background: color-mix(in srgb, var(--primary) 8%, var(--surface-container-lowest));
	}

	.sipap-dropzone:focus-within {
		outline: 2px solid color-mix(in srgb, var(--primary) 55%, transparent);
		outline-offset: 2px;
	}

	.sipap-dropzone.is-locked,
	.sipap-dropzone.is-locked:hover {
		cursor: not-allowed;
		opacity: 0.72;
	}

	.sipap-dropzone.has-preview {
		padding: 0;
		min-height: 5.75rem;
	}

	.sipap-dropzone__empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		text-align: center;
	}

	.sipap-dropzone__empty.hidden,
	.sipap-dropzone__preview.hidden,
	.sipap-dropzone__thumb.hidden,
	.sipap-dropzone__pdf.hidden {
		display: none;
	}

	.sipap-dropzone__icon {
		font-size: 1.55rem;
		line-height: 1;
		color: var(--primary);
	}

	.sipap-dropzone__title {
		max-width: 22rem;
		font-size: 0.86rem;
		font-weight: 760;
		line-height: 1.35;
		color: var(--on-surface);
	}

	.sipap-dropzone__preview {
		position: relative;
		display: flex;
		width: 100%;
		min-height: 5.75rem;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		border-radius: inherit;
	}

	.sipap-dropzone__thumb {
		display: block;
		width: 100%;
		height: 5.75rem;
		object-fit: cover;
	}

	.sipap-dropzone__pdf {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 1.25rem 3.5rem 1.25rem 1.25rem;
		color: var(--on-surface);
	}

	.sipap-dropzone__pdf .material-symbols-rounded {
		font-size: 2rem;
		color: var(--primary);
	}

	.sipap-dropzone__filename {
		overflow: hidden;
		font-size: 0.92rem;
		font-weight: 700;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.sipap-dropzone__clear {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		z-index: 2;
		display: inline-grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 0;
		border-radius: 999px;
		background: rgb(0 0 0 / 0.62);
		color: #fff;
		cursor: pointer;
		transition: background 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.sipap-dropzone__clear:hover {
		background: rgb(0 0 0 / 0.8);
	}

	.sipap-dropzone__clear:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}

