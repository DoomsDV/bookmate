---
/**
 * Paso de seña SIPAP (reserva pública).
 * Móvil: resumen arriba → título → pasos → CTA sticky con monto + cronómetro.
 * Desktop: resumen + CTA + cronómetro en el panel sticky derecho.
 * Contratos DOM: no quitar data-sipap-*, data-sipap-submit-dock, ni las clases
 * sipap-layout / sipap-main / sipap-summary-ticket / sipap-hold-banner / sipap-deposit-intro
 * (r/[token] aplana layout/intro; el banner vive dentro del dock, no como hijo directo).
 */
interface Props {
	stepPanel?: number;
	variant?: 'booking' | 'manage';
	receiptRejected?: boolean;
	rejectReason?: string | null;
}

const { stepPanel = 7, variant = 'booking', receiptRejected = false, rejectReason = '' } = Astro.props;

const rejectReasonText =
	String(rejectReason || '').trim() ||
	'El comprobante adjunto no se pudo validar. Por favor, subí una foto más clara.';

const copyRows = [
	{ key: 'bank', label: 'Banco', aria: 'Copiar banco', icon: 'account_balance' },
	{ key: 'holder', label: 'Titular', aria: 'Copiar titular', icon: 'person' },
	{ key: 'document', label: 'C.I. / RUC', aria: 'Copiar C.I. / RUC', icon: 'badge' },
	{ key: 'alias', label: 'Alias', aria: 'Copiar alias', icon: 'sell' },
] as const;
---

<section
	data-step-panel={String(stepPanel)}
	class:list={[
		'sipap-deposit-panel public-booking-panel text-(--on-surface)',
		{ 'sipap-deposit-panel--manage': variant === 'manage' },
		{ hidden: variant !== 'manage' },
	]}
>
	<p class="sr-only" data-sipap-hold-live role="status" aria-live="polite"></p>

	<header class="sipap-deposit-intro">
		<h2 class="sipap-deposit-title tracking-tight">Transferí la seña para confirmar</h2>
	</header>

	<div class="sipap-layout">
		<div class="sipap-main">
			<div class="sipap-panel sipap-sheet">
				<div class="sipap-panel__core">
					<ol class="sipap-steps">
						<li class="sipap-step">
							<div class="sipap-step__head">
								<span class="sipap-step__index" aria-hidden="true">1</span>
								<h3 class="sipap-step__title">Transferí a estos datos</h3>
							</div>
							<ul class="sipap-transfer-card__list">
								{
									copyRows.map((row) => (
										<li>
											<button
												type="button"
												class="sipap-bank-row"
												data-sipap-copy={row.key}
												data-sipap-copy-keep-label
												aria-label={row.aria}
											>
												<span class="material-symbols-rounded sipap-bank-row__icon" aria-hidden="true">
													{row.icon}
												</span>
												<span class="sipap-bank-row__label">{row.label}</span>
												<span class="sipap-bank-row__value">
													<span {...{ [`data-sipap-${row.key}`]: row.key }}>—</span>
													<span class="sipap-copy-feedback" aria-hidden="true">
														¡Copiado!
													</span>
													<span
														class="material-symbols-rounded sipap-copy-glyph"
														aria-hidden="true"
														data-sipap-copy-icon
													>
														content_copy
													</span>
												</span>
											</button>
										</li>
									))
								}
							</ul>
						</li>

						<li class="sipap-step">
							<div class="sipap-step__head">
								<span class="sipap-step__index" aria-hidden="true">2</span>
								<h3 class="sipap-step__title">Incluí el código en el concepto</h3>
							</div>
							<div class="sipap-ref-block">
								<p class="sipap-ref-block__label">
									Código Hasel
									<span class="sipap-ref-badge">Recomendado para validación automática</span>
								</p>
								<button
									type="button"
									class="sipap-ref-block__code"
									data-sipap-copy="reference"
									data-sipap-copy-keep-label
									aria-label="Copiar código"
									aria-describedby="sipap-ref-hint"
								>
									<span class="sipap-ref-block__value" data-sipap-reference>—</span>
									<input type="hidden" data-sipap-reference-value />
									<span class="sipap-copy-feedback" aria-hidden="true">¡Copiado!</span>
									<span class="sipap-ref-block__action" data-sipap-copy-label>Copiar</span>
									<span
										class="material-symbols-rounded sipap-copy-glyph"
										aria-hidden="true"
										data-sipap-copy-icon
									>
										content_copy
									</span>
								</button>
								<p class="sipap-ref-hint" id="sipap-ref-hint">
									Pegalo en el concepto de la transferencia.
								</p>
							</div>
						</li>

						<li class="sipap-step sipap-upload-section" data-sipap-upload-section>
							<div class="sipap-step__head">
								<span class="sipap-step__index" aria-hidden="true">3</span>
								<h3 class="sipap-step__title" id="sipap-upload-title">Subí el comprobante</h3>
							</div>
							<input type="hidden" data-sipap-manage-token />
							<div class="sipap-upload-card" data-sipap-upload>
								<p class="sipap-panel__lede" id="sipap-upload-hint">JPG, PNG o PDF (máx. 8 MB).</p>
								<div
									class:list={['sipap-reject-alert', { hidden: !receiptRejected }]}
									data-sipap-reject-alert
									hidden={!receiptRejected}
								>
									<span class="material-symbols-rounded" aria-hidden="true">error</span>
									<div>
										<p class="sipap-reject-alert__title">Comprobante rechazado</p>
										<p class="sipap-reject-alert__text" data-sipap-reject-reason>
											{rejectReasonText}
										</p>
									</div>
								</div>
								<div class="sipap-dropzone-wrap">
									<label
										class="sipap-dropzone"
										data-sipap-dropzone
										aria-labelledby="sipap-upload-title"
										aria-describedby="sipap-upload-hint"
									>
										<input
											type="file"
											accept="image/jpeg,image/png,.jpg,.jpeg,.png,application/pdf,.pdf"
											data-sipap-upload-input
											class="sr-only"
										/>
										<div class="sipap-dropzone__empty" data-sipap-dropzone-empty>
											<span class="material-symbols-rounded sipap-dropzone__icon" aria-hidden="true"
												>cloud_upload</span
											>
											<span class="sipap-dropzone__title">Arrastrá el comprobante o hacé clic para elegir</span>
										</div>
										<div class="sipap-dropzone__preview hidden" data-sipap-dropzone-preview>
											<img
												alt="Vista previa del comprobante"
												class="sipap-dropzone__thumb hidden"
												data-sipap-preview-image
											/>
											<div class="sipap-dropzone__pdf hidden" data-sipap-preview-pdf>
												<span class="material-symbols-rounded" aria-hidden="true">description</span>
												<span class="sipap-dropzone__filename" data-sipap-preview-name></span>
											</div>
										</div>
									</label>
									<button
										type="button"
										class="sipap-dropzone__clear hidden"
										data-sipap-preview-clear
										aria-label="Quitar comprobante"
									>
										<span class="material-symbols-rounded" aria-hidden="true">delete</span>
									</button>
								</div>
								<p
									class="sipap-upload-status"
									data-sipap-upload-status
									data-state="idle"
								></p>
							</div>
						</li>
					</ol>
				</div>
			</div>
		</div>

		<aside class="sipap-panel sipap-summary-ticket" aria-label="Resumen de la seña">
			<div class="sipap-panel__core sipap-summary-ticket__core">
				<p class="sipap-panel__kicker">Resumen</p>
				<div class="sipap-pro hidden" data-sipap-pro hidden>
					<img class="sipap-pro__avatar hidden" alt="" data-sipap-pro-image />
					<span class="sipap-pro__avatar sipap-pro__avatar--empty" data-sipap-pro-fallback aria-hidden="true">
						<span class="material-symbols-rounded">account_circle</span>
					</span>
					<div class="sipap-pro__text">
						<p class="sipap-pro__name" data-sipap-pro-name>—</p>
						<p class="sipap-pro__role hidden" data-sipap-pro-specialty hidden></p>
					</div>
				</div>
				<p class="sipap-summary-ticket__amount" data-sipap-amount>—</p>
				<p class="sipap-summary-ticket__for" data-sipap-for>Seña por: —</p>
				<details class="sipap-policy-details">
					<summary class="sipap-policy-summary">
						<span class="material-symbols-rounded sipap-policy-summary__shield" aria-hidden="true"
							>verified_user</span
						>
						<span class="sipap-policy-summary__title">
							Política: <span data-sipap-policy-label>—</span>
						</span>
						<span class="sipap-policy-summary__action">Ver detalles</span>
					</summary>
					<p class="sipap-policy-details__copy" data-sipap-policy-summary>—</p>
				</details>

				<div class="sipap-submit-dock" data-sipap-submit-dock>
					<p class="sipap-dock-amount">
						<span data-sipap-amount>—</span>
					</p>
					<p id="sipap-submit-hint" class="sipap-submit-hint" data-sipap-submit-hint>
						Subí el comprobante para habilitar el envío.
					</p>
					<div class="sipap-hold-banner" data-sipap-hold-banner data-sipap-hold-state="active">
						<span class="material-symbols-rounded sipap-hold-banner__icon" aria-hidden="true">timer</span>
						<p class="sipap-hold-banner__text">
							<span data-sipap-hold-active>
								<span class="sipap-hold-banner__lead">Tenés</span>
								<strong class="tabular-nums" data-sipap-countdown>—:—</strong>
								<span class="sipap-hold-banner__unit"> min</span>
								<span class="sipap-hold-banner__tail"> para confirmar</span>
							</span>
							<span class="hidden" data-sipap-hold-expired>
								Se venció el tiempo para adjuntar el comprobante.
							</span>
							<span class="hidden" data-sipap-hold-unknown>
								Adjuntá el comprobante para confirmar tu turno.
							</span>
							<span class="hidden" data-sipap-hold-submitted>
								Comprobante enviado. Esperando confirmación del comercio.
							</span>
						</p>
					</div>
					<button
						type="button"
						data-sipap-upload-submit
						class="sipap-submit-cta inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full px-5 py-3 text-base font-medium leading-snug"
						disabled
						aria-busy="false"
						aria-describedby="sipap-submit-hint"
					>
						<span
							class="sipap-submit-cta__spinner material-symbols-rounded"
							aria-hidden="true"
							data-sipap-submit-spinner>progress_activity</span
						>
						<span class="sipap-submit-cta__lock material-symbols-rounded" aria-hidden="true">lock</span>
						<span data-sipap-submit-label>Confirmar y enviar comprobante</span>
					</button>
				</div>
			</div>
		</aside>
	</div>
</section>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	[data-sipap-hold-active].hidden,
	[data-sipap-hold-expired].hidden,
	[data-sipap-hold-unknown].hidden,
	[data-sipap-hold-submitted].hidden {
		display: none;
	}

	.sipap-deposit-panel {
		--sipap-accent: #a8c7fa;
		--sipap-on-accent: #062e6f;
		--sipap-accent-soft: color-mix(in srgb, #a8c7fa 16%, #18181b);
		--sipap-paper: transparent;
		--sipap-card: #18181b;
		--sipap-ink: #f4f4f5;
		--sipap-muted: #a1a1aa;
		--sipap-line: #27272a;
		--sipap-dock-space: 9.5rem;
		container-type: inline-size;
		text-align: left;
		color: var(--sipap-ink);
		--on-surface: var(--sipap-ink);
		--on-surface-variant: var(--sipap-muted);
		--outline-variant: var(--sipap-line);
		--primary: var(--sipap-accent);
	}

	.sipap-deposit-panel:not(.sipap-deposit-panel--manage) {
		padding: 0.15rem 0 0.35rem;
		background: transparent;
	}

	.sipap-hold-banner {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		grid-area: hold;
		margin: 0;
		padding: 0.65rem 0.8rem;
		border-radius: 0.85rem;
		border: 1px solid rgb(214 158 90 / 0.16);
		background: #221f1c;
		color: var(--sipap-ink);
	}

	.sipap-hold-banner.is-expired {
		border-color: rgb(214 158 90 / 0.28);
		background: #2a2218;
	}

	.sipap-hold-banner.hidden {
		display: none;
	}

	.sipap-hold-banner.is-submitted {
		border-color: color-mix(in srgb, var(--sipap-accent) 22%, transparent);
		background: color-mix(in srgb, var(--sipap-accent) 8%, #18181b);
	}

	.sipap-hold-banner.is-submitted .sipap-hold-banner__icon {
		color: var(--sipap-accent);
	}

	.sipap-hold-banner__icon {
		flex-shrink: 0;
		font-size: 1.15rem;
		line-height: 1;
		color: var(--sipap-accent);
	}

	.sipap-hold-banner__text {
		margin: 0;
		font-size: 0.84rem;
		font-weight: 550;
		line-height: 1.35;
		color: inherit;
	}

	.sipap-hold-banner__text strong {
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		color: var(--sipap-accent);
	}

	.sipap-deposit-intro {
		margin: 0.35rem 0 0;
		text-align: left;
	}

	.sipap-deposit-title {
		margin: 0;
		max-width: none;
		font-size: 1.65rem;
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1.15;
		text-align: left;
		text-wrap: balance;
		color: var(--sipap-ink);
	}

	.sipap-pro {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin: 0.75rem 0 0;
		padding-bottom: 0.85rem;
		border-bottom: 1px solid var(--sipap-line);
	}

	.sipap-pro.hidden {
		display: none;
	}

	.sipap-pro__avatar {
		width: 2.75rem;
		height: 2.75rem;
		flex-shrink: 0;
		border-radius: 999px;
		object-fit: cover;
		background: #27272a;
	}

	.sipap-pro__avatar--empty {
		display: grid;
		place-items: center;
		color: var(--sipap-muted);
	}

	.sipap-pro__avatar--empty.hidden,
	.sipap-pro__avatar.hidden {
		display: none;
	}

	.sipap-pro__avatar--empty .material-symbols-rounded {
		font-size: 1.65rem;
		line-height: 1;
	}

	.sipap-pro__text {
		min-width: 0;
	}

	.sipap-pro__name {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 550;
		letter-spacing: -0.015em;
		line-height: 1.25;
		color: var(--sipap-ink);
	}

	.sipap-pro__role {
		margin: 0.15rem 0 0;
		font-size: 0.78rem;
		font-weight: 500;
		line-height: 1.3;
		color: var(--sipap-muted);
	}

	.sipap-pro__role.hidden {
		display: none;
	}

	.sipap-layout {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: stretch;
		margin-top: 0.95rem;
	}

	.sipap-main {
		display: grid;
		gap: 0;
		min-width: 0;
	}

	.sipap-summary-ticket {
		align-self: stretch;
	}

	.sipap-panel {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 0;
		border-radius: 1.05rem;
		border: 1px solid var(--sipap-line);
		background: var(--sipap-card);
		color: var(--sipap-ink);
		box-shadow: none;
		--on-surface: var(--sipap-ink);
		--on-surface-variant: var(--sipap-muted);
	}

	.sipap-panel__core {
		display: flex;
		flex-direction: column;
		min-height: 0;
		padding: 1.05rem 1.1rem 1.2rem;
		border-radius: inherit;
		background: transparent;
		box-shadow: none;
	}

	.sipap-summary-ticket__core {
		gap: 0;
	}

	.sipap-panel__kicker {
		margin: 0;
		font-size: 0.74rem;
		font-weight: 650;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		line-height: 1.2;
		color: var(--sipap-muted);
	}

	.sipap-panel__lede {
		margin: 0.15rem 0 0;
		font-size: 0.82rem;
		font-weight: 500;
		line-height: 1.4;
		color: var(--sipap-muted);
	}

	.sipap-steps {
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sipap-step__head {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0 0 0.7rem;
	}

	.sipap-step__index {
		display: inline-grid;
		place-items: center;
		width: 1.55rem;
		height: 1.55rem;
		border-radius: 999px;
		background: var(--sipap-accent);
		color: var(--sipap-on-accent);
		font-size: 0.78rem;
		font-weight: 750;
		line-height: 1;
	}

	.sipap-step__title {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.25;
		color: var(--sipap-ink);
	}

	.sipap-upload-section {
		min-width: 0;
		padding-top: 1.15rem;
		border-top: 1px solid var(--sipap-line);
	}

	.sipap-upload-section.hidden {
		display: none;
	}

	.sipap-upload-card {
		position: relative;
	}

	/* NEW-A: feedback visible durante el POST (~9s por OCR síncrono en el backend). */
	.sipap-upload-card.is-uploading {
		pointer-events: none;
	}

	.sipap-upload-card.is-uploading::after {
		content: '';
		position: absolute;
		inset: -0.35rem;
		z-index: 1;
		border-radius: 0.95rem;
		background: color-mix(in srgb, #101114 55%, transparent);
		backdrop-filter: blur(1px);
	}

	.sipap-reject-alert {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
		margin-top: 0.7rem;
		padding: 0.75rem 0.85rem;
		border-radius: 0.85rem;
		border: 1px solid color-mix(in srgb, #ef4444 38%, transparent);
		background: color-mix(in srgb, #ef4444 12%, #18181b);
	}

	.sipap-reject-alert.hidden {
		display: none;
	}

	.sipap-reject-alert .material-symbols-rounded {
		flex-shrink: 0;
		margin-top: 0.05rem;
		font-size: 1.15rem;
		line-height: 1;
		color: #f87171;
	}

	.sipap-reject-alert__title {
		margin: 0;
		font-size: 0.86rem;
		font-weight: 750;
		line-height: 1.3;
		color: #fecaca;
	}

	.sipap-reject-alert__text {
		margin: 0.2rem 0 0;
		font-size: 0.8rem;
		font-weight: 500;
		line-height: 1.4;
		color: #fca5a5;
	}

	.sipap-dropzone-wrap {
		position: relative;
		margin-top: 0.7rem;
	}

	.sipap-transfer-card__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sipap-bank-row {
		display: grid;
		grid-template-columns: auto auto minmax(0, 1fr);
		align-items: center;
		gap: 0.65rem;
		width: 100%;
		margin: 0;
		padding: 0.7rem 0.2rem;
		border: 0;
		border-radius: 0.7rem;
		background: transparent;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.sipap-transfer-card__list > li + li .sipap-bank-row {
		border-top: 1px solid var(--sipap-line);
		border-radius: 0;
	}

	.sipap-bank-row:hover,
	.sipap-bank-row:focus-visible {
		background: color-mix(in srgb, var(--sipap-accent) 7%, transparent);
	}

	.sipap-bank-row:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--sipap-accent) 70%, transparent);
		outline-offset: 2px;
	}

	.sipap-bank-row__icon {
		font-size: 1.15rem;
		line-height: 1;
		color: var(--sipap-muted);
	}

	.sipap-bank-row__label {
		font-size: 0.78rem;
		font-weight: 550;
		letter-spacing: 0.01em;
		color: var(--sipap-muted);
	}

	.sipap-bank-row__value {
		display: inline-flex;
		align-items: center;
