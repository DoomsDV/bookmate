---
/**
 * Paso de seña SIPAP (reserva pública).
 * Layout: acciones a la izquierda + ticket resumen sticky a la derecha (desktop).
 */
---

<section
	data-step-panel="6"
	class="sipap-deposit-panel public-booking-panel hidden text-(--on-surface)"
>
	<ol class="sipap-flow-stepper" aria-label="Progreso del pago">
		<li class="sipap-flow-stepper__item is-done">
			<span class="sipap-flow-stepper__num" aria-hidden="true">1</span>
			<span>Datos</span>
		</li>
		<li class="sipap-flow-stepper__item is-done">
			<span class="sipap-flow-stepper__num" aria-hidden="true">2</span>
			<span>Confirmación</span>
		</li>
		<li class="sipap-flow-stepper__item is-current" aria-current="step">
			<span class="sipap-flow-stepper__num" aria-hidden="true">3</span>
			<span>Pago</span>
		</li>
	</ol>

	<div class="sipap-hold-banner" role="status" aria-live="polite">
		<span class="material-symbols-rounded sipap-hold-banner__icon" aria-hidden="true">timer</span>
		<p class="sipap-hold-banner__text">
			Tu turno está reservado. Tenés
			<strong class="tabular-nums" data-sipap-countdown>10:00</strong>
			min para adjuntar el comprobante.
		</p>
	</div>

	<div class="sipap-deposit-layout mt-6">
		<div class="sipap-deposit-main grid gap-4 min-w-0">
			<div>
				<h2 class="text-3xl font-normal tracking-tight">Transferí la seña para confirmar</h2>
				<p class="mt-2 text-base font-medium text-(--on-surface-variant)">
					Hacé la transferencia SIPAP con el código en el asunto y subí el comprobante acá.
				</p>
			</div>

			<div class="sipap-reference-card">
				<div class="flex flex-wrap items-start justify-between gap-3">
					<div class="min-w-0">
						<p class="text-sm font-medium text-(--on-surface-variant)">Código para el asunto</p>
						<p
							class="mt-1 break-all font-mono text-xl font-bold tracking-wide text-(--on-surface) sm:text-2xl"
							data-sipap-reference
						>
							—
						</p>
						<input type="hidden" data-sipap-reference-value />
					</div>
					<button
						type="button"
						data-sipap-copy="reference"
					class="sipap-copy-primary booking-primary-action inline-flex h-11 shrink-0 items-center gap-2 rounded-full px-5 text-sm font-semibold transition hover:opacity-90"
					>
						<span class="material-symbols-rounded text-[1.15rem]" aria-hidden="true" data-sipap-copy-icon
							>content_copy</span
						>
						<span data-sipap-copy-label>Copiar código</span>
					</button>
				</div>
				<p class="mt-3 text-sm text-(--on-surface-variant)">
					Pegá este código exactamente en el asunto de la transferencia.
				</p>
			</div>

			<div class="sipap-bank-card">
				<p class="text-sm font-bold uppercase tracking-wide text-(--primary)">Datos SIPAP del comercio</p>
				<ul class="mt-4 grid gap-0 divide-y divide-(--outline-variant)/60">
					<li class="sipap-bank-row">
						<span class="sipap-bank-row__label">Banco</span>
						<span class="sipap-bank-row__value">
							<span class="material-symbols-rounded sipap-bank-row__icon" aria-hidden="true"
								>account_balance</span
							>
							<span data-sipap-bank>—</span>
						</span>
					</li>
					<li class="sipap-bank-row">
						<span class="sipap-bank-row__label">Titular</span>
						<span class="sipap-bank-row__value">
							<span data-sipap-holder>—</span>
						</span>
					</li>
					<li class="sipap-bank-row">
						<span class="sipap-bank-row__label">C.I. / RUC</span>
						<span class="sipap-bank-row__value">
							<span data-sipap-document>—</span>
							<button
								type="button"
								data-sipap-copy="document"
								class="sipap-copy-icon"
								aria-label="Copiar C.I. / RUC"
								title="Copiar"
							>
								<span class="material-symbols-rounded" aria-hidden="true" data-sipap-copy-icon
									>content_copy</span
								>
							</button>
						</span>
					</li>
					<li class="sipap-bank-row">
						<span class="sipap-bank-row__label">Alias</span>
						<span class="sipap-bank-row__value">
							<span data-sipap-alias>—</span>
							<button
								type="button"
								data-sipap-copy="alias"
								class="sipap-copy-icon"
								aria-label="Copiar alias"
								title="Copiar"
							>
								<span class="material-symbols-rounded" aria-hidden="true" data-sipap-copy-icon
									>content_copy</span
								>
							</button>
						</span>
					</li>
				</ul>
			</div>

			<div
				class="rounded-2xl border border-(--outline-variant) bg-(--surface-container-lowest) p-5"
				data-sipap-upload
			>
				<input type="hidden" data-sipap-manage-token />
				<p class="text-sm font-bold text-(--on-surface)">Subí el comprobante</p>
				<p class="mt-1 text-sm text-(--on-surface-variant)">
					Foto clara del ticket (JPG o PNG). Lo leemos al instante para confirmar tu seña.
				</p>
				<input
					type="file"
					accept="image/jpeg,image/png,image/webp,image/gif,application/pdf"
					capture="environment"
					data-sipap-upload-input
					class="mt-4 block w-full text-sm text-(--on-surface-variant) file:mr-3 file:rounded-full file:border-0 file:bg-(--primary-container) file:px-4 file:py-2 file:text-sm file:font-semibold file:text-(--on-primary-container)"
				/>
				<button
					type="button"
					data-sipap-upload-submit
					class="mt-4 booking-primary-action inline-flex h-12 w-full items-center justify-center rounded-full px-6 text-base font-medium"
				>
					Enviar comprobante
				</button>
				<p
					class="mt-3 text-sm text-(--on-surface-variant) data-[state=error]:text-red-600 data-[state=success]:text-green-700 data-[state=loading]:text-(--primary)"
					data-sipap-upload-status
					data-state="idle"
				></p>
			</div>

			<button
				type="button"
				data-restart-booking
				class="booking-primary-action mt-2 inline-flex h-12 w-full items-center justify-center rounded-full border border-(--outline-variant) bg-transparent px-8 text-base font-medium text-(--on-surface) transition hover:bg-(--surface-container-highest) sm:w-auto"
			>
				Listo
			</button>
		</div>

		<aside class="sipap-summary-ticket" aria-label="Resumen de la seña">
			<p class="text-sm font-bold uppercase tracking-wide text-(--on-surface-variant)">Resumen</p>
			<p class="mt-2 text-3xl font-bold tracking-tight text-(--on-surface) sm:text-4xl" data-sipap-amount>
				—
			</p>
			<p class="mt-2 text-sm font-medium text-(--on-surface-variant)" data-sipap-for>
				Seña por: —
			</p>

			<div class="sipap-policy-card mt-5">
				<div class="flex items-start gap-2.5">
					<span class="material-symbols-rounded sipap-policy-card__icon" aria-hidden="true"
						>verified_user</span
					>
					<div class="min-w-0">
						<p class="text-sm font-bold text-(--on-surface)">
							Política: <span data-sipap-policy-label>—</span>
						</p>
						<p class="mt-1 text-sm leading-relaxed text-(--on-surface-variant)" data-sipap-policy-summary>
							—
						</p>
					</div>
				</div>
			</div>
		</aside>
	</div>
</section>

<style>
	.sipap-flow-stepper {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.75rem;
		margin: 0 0 1rem;
		padding: 0;
		list-style: none;
	}

	.sipap-flow-stepper__item {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.82rem;
		font-weight: 650;
		color: var(--on-surface-variant);
		opacity: 0.72;
	}

	.sipap-flow-stepper__item + .sipap-flow-stepper__item::before {
		content: '';
		display: inline-block;
		width: 1.25rem;
		height: 1px;
		margin-right: 0.35rem;
		background: color-mix(in srgb, var(--outline-variant) 80%, transparent);
	}

	.sipap-flow-stepper__num {
		display: inline-grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 999px;
		border: 1px solid var(--outline-variant);
		font-size: 0.72rem;
		font-weight: 750;
		line-height: 1;
	}

	.sipap-flow-stepper__item.is-done {
		opacity: 0.9;
	}

	.sipap-flow-stepper__item.is-done .sipap-flow-stepper__num {
		border-color: color-mix(in srgb, var(--primary) 45%, var(--outline-variant));
		background: color-mix(in srgb, var(--primary-container) 35%, transparent);
		color: var(--primary);
	}

	.sipap-flow-stepper__item.is-current {
		color: var(--on-surface);
		opacity: 1;
	}

	.sipap-flow-stepper__item.is-current .sipap-flow-stepper__num {
		border-color: transparent;
		background: var(--primary);
		color: var(--on-primary);
	}

	.sipap-hold-banner {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
		padding: 0.85rem 1rem;
		border-radius: 1rem;
		border: 1px solid color-mix(in srgb, var(--primary) 28%, var(--outline-variant));
		background: color-mix(in srgb, var(--primary-container) 22%, var(--surface-container-lowest));
	}

	.sipap-hold-banner__icon {
		flex-shrink: 0;
		margin-top: 0.05rem;
		font-size: 1.25rem;
		line-height: 1;
		color: var(--primary);
	}

	.sipap-hold-banner__text {
		margin: 0;
		font-size: 0.9rem;
		font-weight: 550;
		line-height: 1.4;
		color: var(--on-surface);
	}

	.sipap-hold-banner__text strong {
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		color: var(--primary);
	}

	.sipap-deposit-layout {
		display: grid;
		gap: 1.25rem;
		align-items: start;
	}

	@media (min-width: 960px) {
		.sipap-deposit-layout {
			grid-template-columns: minmax(0, 1.7fr) minmax(260px, 0.95fr);
			gap: 1.5rem;
		}
	}

	.sipap-reference-card {
		padding: 1.15rem 1.25rem;
		border-radius: 1.25rem;
		border: 1px solid color-mix(in srgb, var(--primary) 55%, var(--outline-variant));
		background: color-mix(in srgb, var(--primary-container) 28%, #121212);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 12%, transparent);
	}

	.sipap-bank-card {
		padding: 1.15rem 1.25rem;
		border-radius: 1.25rem;
		border: 1px solid color-mix(in srgb, var(--outline-variant) 70%, transparent);
		background: color-mix(in srgb, #252525 88%, var(--surface-container-lowest));
	}

	.sipap-bank-row {
		display: grid;
		gap: 0.25rem;
		padding: 0.85rem 0;
	}

	@media (min-width: 480px) {
		.sipap-bank-row {
			grid-template-columns: 7.5rem minmax(0, 1fr);
			align-items: center;
			gap: 0.75rem;
		}
	}

	.sipap-bank-row__label {
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--on-surface-variant);
	}

	.sipap-bank-row__value {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-width: 0;
		font-size: 0.98rem;
		font-weight: 700;
		color: var(--on-surface);
		word-break: break-word;
	}

	.sipap-bank-row__icon {
		flex-shrink: 0;
		font-size: 1.15rem;
		line-height: 1;
		color: var(--primary);
		opacity: 0.9;
	}

	.sipap-copy-icon {
		display: inline-grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		margin-left: 0.15rem;
		border: 0;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container-highest) 70%, transparent);
		color: var(--on-surface-variant);
		cursor: pointer;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.sipap-copy-icon:hover {
		background: color-mix(in srgb, var(--primary-container) 45%, transparent);
		color: var(--primary);
	}

	.sipap-copy-icon .material-symbols-rounded {
		font-size: 1.05rem;
		line-height: 1;
	}

	.sipap-copy-icon.is-copied {
		color: var(--tertiary);
	}

	.sipap-summary-ticket {
		padding: 1.25rem 1.35rem;
		border-radius: 1.35rem;
		border: 1px solid var(--outline-variant);
		background: color-mix(in srgb, var(--surface-container-lowest) 92%, #2a2a2a);
		box-shadow: 0 12px 32px rgb(0 0 0 / 0.18);
	}

	@media (min-width: 960px) {
		.sipap-summary-ticket {
			position: sticky;
			top: 1.25rem;
		}
	}

	.sipap-policy-card {
		padding: 0.9rem 1rem;
		border-radius: 1rem;
		border: 1px solid color-mix(in srgb, #34d399 28%, var(--outline-variant));
		background: color-mix(in srgb, #065f46 22%, var(--surface-container-lowest));
	}

	.sipap-policy-card__icon {
		flex-shrink: 0;
		font-size: 1.25rem;
		line-height: 1;
		color: #6ee7b7;
	}
</style>
