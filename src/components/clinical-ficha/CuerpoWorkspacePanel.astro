---
interface Props {
	rootClass?: string;
	panelClass?: string;
	embedded?: boolean;
}

const { rootClass = '', panelClass = '', embedded = false } = Astro.props;
---

<div
	class:list={['clinical-workspace-panel cuerpo-workspace', panelClass]}
	data-clinical-workspace-panel="cuerpo"
	hidden={embedded ? undefined : true}
>
	<div class="cuerpo-draft-banner hidden" data-cuerpo-draft-banner role="status">
		Cambios sin guardar en esta sesión.
	</div>
	<div class:list={['cuerpo-workspace__layout', rootClass]} data-cuerpo-workspace>
		<section class="cuerpo-workspace__map-col" aria-label="Mapa para registrar marcas">
			<header class="cuerpo-toolbar">
				<div class="cuerpo-segment" role="toolbar" aria-label="Vista del cuerpo">
					<span class="cuerpo-segment__label">Vista</span>
					<div class="cuerpo-segment__track">
						<button type="button" class="cuerpo-pill is-active" data-cuerpo-view="FRONT" aria-pressed="true">Frente</button>
						<button type="button" class="cuerpo-pill" data-cuerpo-view="BACK" aria-pressed="false">Espalda</button>
						<button type="button" class="cuerpo-pill" data-cuerpo-view="SIDE" aria-pressed="false">Lado</button>
					</div>
				</div>
				<div class="cuerpo-segment" role="toolbar" aria-label="Zona del cuerpo">
					<span class="cuerpo-segment__label">Ampliar zona</span>
					<div class="cuerpo-segment__track">
						<button type="button" class="cuerpo-pill is-active" data-cuerpo-lens="BODY" aria-pressed="true">Completo</button>
						<button type="button" class="cuerpo-pill" data-cuerpo-lens="SHOULDER">Hombro</button>
						<button type="button" class="cuerpo-pill" data-cuerpo-lens="HIP">Cadera</button>
						<button type="button" class="cuerpo-pill" data-cuerpo-lens="KNEE">Rodilla</button>
						<button type="button" class="cuerpo-pill" data-cuerpo-lens="ANKLE">Tobillo</button>
					</div>
				</div>
			</header>
			<p class="cuerpo-map-zoom-label hidden" data-cuerpo-zoom-label aria-live="polite"></p>
			<div class="cuerpo-map-stage">
				<svg
					class="cuerpo-map-svg"
					data-cuerpo-map-svg
					viewBox="0 0 100 130"
					xmlns="http://www.w3.org/2000/svg"
					role="img"
					aria-label="Silueta corporal, vista frontal"
				>
					<g data-cuerpo-map-outline></g>
					<g data-cuerpo-map-marks></g>
				</svg>
			</div>
			<section class="cuerpo-controls-dock" aria-label="Configuración de la marca">
				<div class="cuerpo-segment cuerpo-segment--inline cuerpo-segment--kind" role="toolbar" aria-label="Tipo de marca">
					<span class="cuerpo-segment__label">Registrar</span>
					<div class="cuerpo-segment__track">
						<button type="button" class="cuerpo-mark-kind is-active" data-cuerpo-mark-kind="PAIN">Dolor</button>
						<button type="button" class="cuerpo-mark-kind" data-cuerpo-mark-kind="TENSION">Tensión</button>
						<button type="button" class="cuerpo-mark-kind" data-cuerpo-mark-kind="WORK">Trabajo</button>
						<button type="button" class="cuerpo-mark-kind" data-cuerpo-mark-kind="SCAR">Cicatriz</button>
						<button type="button" class="cuerpo-mark-kind" data-cuerpo-mark-kind="EDEMA">Edema</button>
					</div>
				</div>
				<div class="cuerpo-mark-settings">
					<div class="cuerpo-segment cuerpo-segment--inline" role="group" aria-label="Lado del cuerpo">
						<span class="cuerpo-segment__label">Lado</span>
						<div class="cuerpo-segment__track">
							<button type="button" class="cuerpo-pill" data-cuerpo-mark-side="L" aria-pressed="false">Izq.</button>
							<button type="button" class="cuerpo-pill is-active" data-cuerpo-mark-side="R" aria-pressed="true">Der.</button>
						</div>
					</div>
					<div class="cuerpo-intensity">
					<span class="cuerpo-intensity__label">Intensidad</span>
					<div class="cuerpo-intensity__controls">
						<button type="button" class="cuerpo-stepper-btn" data-cuerpo-intensity-dec aria-label="Menos intensidad">−</button>
						<span class="cuerpo-intensity__value" data-cuerpo-intensity-value>7</span>
						<button type="button" class="cuerpo-stepper-btn" data-cuerpo-intensity-inc aria-label="Más intensidad">+</button>
						<input type="range" min="0" max="10" value="7" class="cuerpo-intensity__slider" data-cuerpo-intensity-slider aria-label="Intensidad 0 a 10" />
					</div>
				</div>
				</div>
				<p class="cuerpo-map-instruction">
					<span class="material-symbols-rounded" aria-hidden="true">ads_click</span>
					Elegí una zona para ampliarla o hacé clic en la silueta para registrar la marca.
				</p>
			</section>
		</section>
		<aside class="cuerpo-workspace__side">
			<div class="cuerpo-session-card">
				<div class="cuerpo-session-picker hidden" data-cuerpo-session-picker-wrap hidden={embedded ? true : undefined}>
					<label class="cuerpo-session-picker__label" for="cuerpo-session-picker">Cita</label>
					<div class="cuerpo-session-picker__field">
						<select class="cuerpo-session-picker__select" data-cuerpo-session-picker id="cuerpo-session-picker"></select>
					</div>
				</div>
				<div class="cuerpo-session-chip hidden" data-cuerpo-session-chip-wrap hidden={embedded ? undefined : true}>
					<span class="cuerpo-session-chip__label">Cita</span>
					<span class="cuerpo-session-chip__value" data-cuerpo-session-chip>Sin cita</span>
				</div>
				<p class="cuerpo-session-label hidden" data-cuerpo-session-label aria-hidden="true"></p>
			</div>
			<div class="cuerpo-segment cuerpo-segment--silhouette" role="group" aria-label="Silueta">
				<span class="cuerpo-segment__label">Silueta</span>
				<div class="cuerpo-segment__track">
					<button type="button" class="cuerpo-pill is-active" data-cuerpo-silhouette="FEMALE" aria-pressed="true">Femenino</button>
					<button type="button" class="cuerpo-pill" data-cuerpo-silhouette="MALE" aria-pressed="false">Masculino</button>
					<button type="button" class="cuerpo-pill" data-cuerpo-silhouette="CHILD" aria-pressed="false">Niño</button>
				</div>
			</div>
			<section class="cuerpo-side-section">
				<div class="cuerpo-side-section__heading">
					<h4 class="customer-profile-section-title">Registro de la sesión</h4>
					<span class="cuerpo-marks-count" data-cuerpo-marks-count aria-live="polite"></span>
				</div>
				<ul class="cuerpo-marks-list" data-cuerpo-marks-list></ul>
				<p class="cuerpo-marks-empty hidden" data-cuerpo-marks-empty>Seleccioná el tipo y hacé clic en la zona a registrar.</p>
				<p class="cuerpo-marks-view-hint hidden" data-cuerpo-marks-view-hint>
					Hay marcas en otra vista. Cambiá Frente/Espalda/Lado para verlas en el mapa.
				</p>
			</section>
			<section class="cuerpo-joint-panel hidden" data-cuerpo-joint-panel hidden>
				<h4 class="customer-profile-section-title">ROM</h4>
				<div class="cuerpo-rom-fields" data-cuerpo-rom-fields></div>
				<h4 class="customer-profile-section-title mt-3">EVA (dolor)</h4>
				<input type="range" min="0" max="10" value="0" class="cuerpo-intensity__slider" data-cuerpo-eva aria-label="EVA 0 a 10" />
				<h4 class="customer-profile-section-title mt-3">Pruebas</h4>
				<div class="cuerpo-tests" data-cuerpo-tests></div>
			</section>
			<div class="cuerpo-side-actions">
				<div class="cuerpo-secondary-actions">
					<button type="button" class="cuerpo-action-button" data-cuerpo-compare>
						<span class="material-symbols-rounded" aria-hidden="true">compare</span>
						Comparar
					</button>
					<button type="button" class="cuerpo-action-button" data-cuerpo-pdf>
						<span class="material-symbols-rounded" aria-hidden="true">picture_as_pdf</span>
						PDF
					</button>
				</div>
				<button type="button" class="cuerpo-save-session hidden" data-cuerpo-save-session>
					<span class="material-symbols-rounded" aria-hidden="true">save</span>
					Guardar sesión
				</button>
			</div>
			<div class="cuerpo-compare-wrap hidden" data-cuerpo-compare-wrap>
				<h4 class="customer-profile-section-title">Sesión anterior</h4>
				<p class="cuerpo-marks-empty hidden" data-cuerpo-compare-empty>Sin sesión anterior para comparar.</p>
				<p class="cuerpo-compare-loading hidden" data-cuerpo-compare-loading>Cargando comparación…</p>
				<svg class="cuerpo-map-svg cuerpo-map-svg--compare" data-cuerpo-compare-svg viewBox="0 0 100 130" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<g data-cuerpo-map-outline></g>
					<g data-cuerpo-compare-marks></g>
				</svg>
			</div>
		</aside>
	</div>
	<dialog class="cuerpo-mark-editor" data-cuerpo-mark-editor aria-labelledby="cuerpo-mark-editor-title">
		<form method="dialog" class="cuerpo-mark-editor__form" data-cuerpo-mark-editor-form>
			<header class="cuerpo-mark-editor__header">
				<h3 id="cuerpo-mark-editor-title" class="cuerpo-mark-editor__title">Editar marca</h3>
				<button type="button" class="cuerpo-mark-editor__close" data-cuerpo-mark-editor-close aria-label="Cerrar">
					<span class="material-symbols-rounded" aria-hidden="true">close</span>
				</button>
			</header>
			<div class="cuerpo-mark-editor__body">
				<label class="cuerpo-mark-editor__field">
					<span>Tipo</span>
					<select data-cuerpo-mark-editor-kind></select>
				</label>
				<label class="cuerpo-mark-editor__field">
					<span>Intensidad</span>
					<input type="range" min="0" max="10" value="5" data-cuerpo-mark-editor-intensity />
					<span data-cuerpo-mark-editor-intensity-value>5/10</span>
				</label>
				<div class="cuerpo-mark-editor__field">
					<span>Lado</span>
					<div class="cuerpo-segment__track">
						<button type="button" class="cuerpo-pill" data-cuerpo-mark-editor-side="L">Izq.</button>
						<button type="button" class="cuerpo-pill is-active" data-cuerpo-mark-editor-side="R">Der.</button>
					</div>
				</div>
				<label class="cuerpo-mark-editor__field">
					<span>Nota</span>
					<input type="text" maxlength="120" placeholder="Opcional" data-cuerpo-mark-editor-note />
				</label>
			</div>
			<footer class="cuerpo-mark-editor__footer">
				<button type="button" class="modal-action-danger" data-cuerpo-mark-editor-delete>Eliminar</button>
				<button type="submit" class="modal-action-primary">Guardar</button>
			</footer>
		</form>
	</dialog>
</div>
