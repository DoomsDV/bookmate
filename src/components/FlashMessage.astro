---
import { FLASH_TONE_META, normalizeFlashMessageText } from '../lib/flash';

type MessageType = 'success' | 'error' | 'info' | 'warning';

interface Props {
	message: string;
	type?: MessageType;
	autoHideMs?: number;
	expand?: boolean;
	dismissible?: boolean;
}

const {
	message,
	type = 'info',
	autoHideMs = 0,
	expand = false,
	dismissible = true,
} = Astro.props;

const displayMessage = normalizeFlashMessageText(message);
const tone = FLASH_TONE_META[type];
const flashToneClass = `flash-message--${type}`;
---

{
	displayMessage ? (
		<div
			role="alert"
			aria-live="polite"
			class:list={[
				'flash-message pointer-events-auto group relative',
				flashToneClass,
				expand ? 'flash-message--expand' : '',
			]}
			style="transform: translateY(20px); opacity: 0; animation: flash-slide-in 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;"
			data-flash-message
			data-auto-hide-ms={autoHideMs > 0 ? String(autoHideMs) : undefined}
		>
			<span class="flash-message__icon-badge" aria-hidden="true">
				<span class="material-symbols-rounded">{tone.icon}</span>
			</span>
			<div class="flash-message__body">
				<strong class="flash-message__title">{tone.title}</strong>
				<p class="flash-message__text">{displayMessage}</p>
			</div>

			{
				dismissible ? (
					<button
						type="button"
						class="flash-message__close"
						aria-label="Cerrar mensaje"
						data-flash-close
					>
						<span class="material-symbols-rounded">close</span>
					</button>
				) : null
			}
		</div>
	) : null
}

<style is:global>
	@keyframes flash-slide-in {
		0% {
			transform: translateY(20px);
			opacity: 0;
		}
		100% {
			transform: translateY(0);
			opacity: 1;
		}
	}

	/*
	 * Stack en top layer via popover=manual (sobre dialogs showModal).
	 * Hay que anular el UA ([popover] { inset:0; margin:auto; width:fit-content }).
	 */
	[data-flash-stack],
	[data-flash-stack]:popover-open {
		position: fixed !important;
		top: auto !important;
		right: 0 !important;
		bottom: 1.25rem !important;
		left: 0 !important;
		inset: auto 0 1.25rem 0 !important;
		width: 100% !important;
		max-width: none !important;
		height: fit-content !important;
		margin: 0 !important;
		padding: 0 1rem !important;
		border: none !important;
		background: transparent !important;
		overflow: visible !important;
		color: inherit;
		display: flex !important;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		pointer-events: none;
		box-sizing: border-box;
		z-index: 2147483646;
	}
</style>

<script>
	import {
		consumeStashedFlash,
		drainPendingFlashMessages,
		FLASH_TONE_META,
		normalizeFlashMessageText,
		stripFlashParamsFromUrl,
	} from '../lib/flash';

	type FlashTone = keyof typeof FLASH_TONE_META;

	const hideMessage = (node: HTMLElement) => {
		if (!node || node.dataset.isClosing === '1') return;
		node.dataset.isClosing = '1';
		node.classList.add('pointer-events-none');
		node.animate(
			[
				{ transform: 'translateY(0)', opacity: 1 },
				{ transform: 'translateY(16px)', opacity: 0 },
			],
			{
				duration: 220,
				easing: 'cubic-bezier(0.4, 0, 1, 1)',
				fill: 'forwards',
			}
		).onfinish = () => node.remove();
	};

	const initMessage = (node: HTMLElement) => {
		if (!node || node.dataset.flashBound === '1') return;
		node.dataset.flashBound = '1';

		const closeButton = node.querySelector('[data-flash-close]');
		closeButton?.addEventListener('click', () => hideMessage(node));

		const delay = Number(node.dataset.autoHideMs || '0');
		if (Number.isFinite(delay) && delay > 0) {
			window.setTimeout(() => hideMessage(node), delay);
		}
	};

	const ensureFlashStack = () => {
		let stack = document.querySelector<HTMLElement>('[data-flash-stack]');
		if (!stack) {
			stack = document.createElement('div');
			stack.setAttribute('data-flash-stack', 'true');
			stack.setAttribute('popover', 'manual');
			document.body.appendChild(stack);
		}

		if (typeof stack.showPopover === 'function') {
			try {
				stack.showPopover();
			} catch {
				/* ignore: fallback a fixed + z-index */
			}
		}

		return stack;
	};

	const createDynamicMessage = ({
		message,
		type = 'info',
		autoHideMs = 5000,
	}: {
		message?: string;
		type?: FlashTone;
		autoHideMs?: number;
	}) => {
		const cleanMessage = normalizeFlashMessageText(String(message || '').trim());
		if (!cleanMessage) return null;

		const tone = FLASH_TONE_META[type] || FLASH_TONE_META.info;
		const node = document.createElement('div');
		node.setAttribute('role', 'alert');
		node.setAttribute('aria-live', 'polite');
		node.setAttribute('data-flash-message', 'true');
		node.dataset.autoHideMs = String(autoHideMs);
		node.className = `flash-message flash-message--${type} pointer-events-auto group relative`;
		node.style.transform = 'translateY(20px)';
		node.style.opacity = '0';
		node.style.animation = 'flash-slide-in 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards';
		node.innerHTML = `
			<span class="flash-message__icon-badge" aria-hidden="true">
				<span class="material-symbols-rounded">${tone.icon}</span>
			</span>
			<div class="flash-message__body">
				<strong class="flash-message__title"></strong>
				<p class="flash-message__text"></p>
			</div>
			<button
				type="button"
				class="flash-message__close"
				aria-label="Cerrar mensaje"
				data-flash-close
			>
				<span class="material-symbols-rounded">close</span>
			</button>
		`;
		const titleNode = node.querySelector('.flash-message__title');
		const textNode = node.querySelector('.flash-message__text');
		if (titleNode) titleNode.textContent = tone.title;
		if (textNode) textNode.textContent = cleanMessage;
		return node;
	};

	const showFlashMessage = (detail: {
		message?: string;
		type?: FlashTone;
		autoHideMs?: number;
	}) => {
		const node = createDynamicMessage(detail);
		if (!node) return;
		const stack = ensureFlashStack();
		stack.appendChild(node);
		initMessage(node);
	};

	const bootstrapFlashHost = () => {
		stripFlashParamsFromUrl();
		ensureFlashStack();

		for (const node of document.querySelectorAll<HTMLElement>('[data-flash-message]')) {
			initMessage(node);
		}

		const stashed = consumeStashedFlash();
		if (stashed) showFlashMessage(stashed);

		drainPendingFlashMessages();
	};

	window.BookmateFlash = {
		show: showFlashMessage,
	};

	document.addEventListener('bookmate:flash', ((event: CustomEvent) => {
		showFlashMessage(event.detail || {});
	}) as EventListener);

	bootstrapFlashHost();

	document.addEventListener('astro:page-load', bootstrapFlashHost);
</script>
