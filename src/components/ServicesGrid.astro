---
import type { Service } from '../lib/services';

interface Props {
	services: Service[];
	showCreateAction?: boolean;
	searchQuery?: string;
	isActiveFilter?: number | null;
	totalRecords?: number;
}

const {
	services = [],
	showCreateAction = false,
	searchQuery = '',
	isActiveFilter = null,
	totalRecords = 0,
} = Astro.props;
const hasSearch = Boolean(searchQuery);
const hasStatusFilter = isActiveFilter === 0 || isActiveFilter === 1;
const hasFilters = hasSearch || hasStatusFilter;

const currencyFormatter = new Intl.NumberFormat('es-PY', {
	style: 'currency',
	currency: 'PYG',
	maximumFractionDigits: 0,
});

const toDurationLabel = (value?: number | null) => {
	if (!value || value <= 0) return '--';
	if (value === 60) return '1 hora';
	if (value > 60 && value % 60 === 0) return `${value / 60} horas`;

	const hours = Math.floor(value / 60);
	const mins = value % 60;
	if (hours > 0) return `${hours} h ${mins} min`;
	return `${value} min`;
};

---

<section class="services-view">
	<header class="mb-0 lg:mb-4 flex flex-wrap items-center justify-between gap-2 lg:gap-3">
		<div class="page-title-row flex flex-wrap items-center gap-2 lg:gap-3 min-w-0">
			<h2 class="m-0 text-[1.5rem] sm:text-[1.75rem] font-bold tracking-tight text-(--on-surface) leading-none">
				Servicios{' '}
				<span class="font-semibold text-(--on-surface-variant)" data-services-summary>
					({totalRecords})
				</span>
			</h2>
		</div>

		<div class="panel-page-header__actions flex flex-wrap items-center justify-end gap-2 shrink-0">
			{showCreateAction && (
				<button
					type="button"
					class="services-create-btn hidden sm:inline-flex items-center justify-center gap-2"
					data-open-service-modal
				>
					<svg
						class="services-create-btn-icon w-[18px] h-[18px]"
						viewBox="0 0 24 24"
						fill="none"
						aria-hidden="true"
					>
						<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
					</svg>
					<span>Nuevo Servicio</span>
				</button>
			)}
		</div>
	</header>

	{showCreateAction && (
		<button
			type="button"
			class="services-create-fab"
			data-open-service-modal
			aria-label="Nuevo Servicio"
			title="Nuevo Servicio"
		>
			<svg
				class="services-create-fab-icon"
				viewBox="0 0 24 24"
				fill="none"
				aria-hidden="true"
			>
				<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
			</svg>
		</button>
	)}

	<div class="flex max-w-xl items-center gap-2">
		<div class="relative min-w-0 flex-1" data-panel-search>
			<span
				class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-(--on-surface-variant)"
				aria-hidden="true"
			>
				<span class="material-symbols-rounded text-[1.2rem]">search</span>
			</span>
			<input
				type="text"
				inputmode="search"
				enterkeyhint="search"
				data-services-search
				placeholder="Buscar por nombre"
				aria-label="Buscar por nombre"
				autocomplete="off"
				value={searchQuery}
				class="w-full rounded-2xl border border-(--shell-border) bg-(--surface-bright) py-2.5 pl-11 pr-11 text-[0.95rem] font-semibold text-(--on-surface) outline-none transition placeholder:font-medium placeholder:text-(--on-surface-variant)/70 hover:border-(--on-surface-variant) focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10 shadow-sm"
			/>
			<button
				type="button"
				class="panel-search-clear"
				data-panel-search-clear
				hidden={String(searchQuery || '').length === 0}
				aria-label="Limpiar búsqueda"
			>
				<span class="material-symbols-rounded" aria-hidden="true">close</span>
			</button>
		</div>

		<button
			type="button"
			class:list={[
				'services-status-filter-btn relative flex size-11 shrink-0 items-center justify-center rounded-2xl border border-(--shell-border) bg-(--surface-bright) text-(--on-surface-variant) shadow-sm transition hover:border-(--on-surface-variant) hover:text-(--on-surface) focus:border-(--primary) focus:outline-none focus:ring-4 focus:ring-(--primary)/10',
				hasStatusFilter && 'is-active',
			]}
			data-open-services-status-filter
			aria-label="Filtrar por estado"
			aria-haspopup="dialog"
			aria-controls="services-status-filter-sheet"
			aria-pressed={hasStatusFilter ? 'true' : 'false'}
		>
			<span class="material-symbols-rounded text-[1.25rem]" aria-hidden="true">tune</span>
			{hasStatusFilter && (
				<span class="services-status-filter-badge" data-services-status-filter-badge aria-hidden="true"></span>
			)}
		</button>
	</div>

	<dialog
		id="services-status-filter-sheet"
		class="services-status-filter-sheet"
		data-services-status-filter-sheet
		aria-labelledby="services-status-filter-title"
	>
		<div class="services-status-filter-sheet__handle" aria-hidden="true">
			<span></span>
		</div>
		<div class="services-status-filter-sheet__header">
			<h2 id="services-status-filter-title" class="m-0 text-[1.05rem] font-extrabold tracking-tight">
				Filtros
			</h2>
			<button
				type="button"
				class="flex size-9 shrink-0 items-center justify-center rounded-full text-(--on-surface-variant) transition-colors hover:bg-(--surface-variant) hover:text-(--on-surface)"
				data-close-services-status-filter
				aria-label="Cerrar filtro"
			>
				<span class="material-symbols-rounded text-[1.3rem]">close</span>
			</button>
		</div>
		<div class="services-status-filter-sheet__list" role="listbox" aria-label="Estado del servicio">
			<button
				type="button"
				class:list={['services-status-filter-option', !hasStatusFilter && 'is-selected']}
				data-services-status-option
				data-value=""
				role="option"
				aria-selected={!hasStatusFilter ? 'true' : 'false'}
			>
				<span>Todos</span>
				<span class="material-symbols-rounded">check</span>
			</button>
			<button
				type="button"
				class:list={['services-status-filter-option', isActiveFilter === 1 && 'is-selected']}
				data-services-status-option
				data-value="1"
				role="option"
				aria-selected={isActiveFilter === 1 ? 'true' : 'false'}
			>
				<span>Activos</span>
				<span class="material-symbols-rounded">check</span>
			</button>
			<button
				type="button"
				class:list={['services-status-filter-option', isActiveFilter === 0 && 'is-selected']}
				data-services-status-option
				data-value="0"
				role="option"
				aria-selected={isActiveFilter === 0 ? 'true' : 'false'}
			>
				<span>Inactivos</span>
				<span class="material-symbols-rounded">check</span>
			</button>
		</div>
	</dialog>

	<div data-services-results>
		{services.length === 0 ? (
			<div class="services-empty-state" data-services-empty>
				<div class="services-empty-icon">
					<span class="material-symbols-rounded text-[2rem]">
						{hasFilters ? 'search_off' : 'inbox'}
					</span>
				</div>
				<h3 class="text-[1.1rem] font-bold text-(--on-surface)">
					{hasFilters ? 'No se encontraron servicios' : 'No hay servicios registrados'}
				</h3>
				<p class="mt-1.5 max-w-sm text-[0.95rem] leading-relaxed text-(--on-surface-variant)">
					{hasSearch
						? 'Probá con otro nombre.'
						: hasStatusFilter
							? 'No hay servicios con ese estado.'
							: 'Aun no has agregado ningun servicio a esta organizacion. Comienza creando tu primera prestacion.'}
				</p>
			</div>
		) : (
			<div class="material-cards-grid gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3 xl:grid-cols-4" data-services-grid>
				{services.map((service) => {
					const imageUrl = String(service.image_url || '').trim();
					const isActive = service.is_active === 1;
					return (
					<article
						class:list={[
							'services-card group',
							!isActive && 'services-card--inactive',
						]}
						data-service-card
						data-service-id={service.id_service}
						tabindex="0"
						role="button"
						aria-label={`Editar servicio ${service.name || service.id_service}`}
					>
						<div class="services-card__inner">
							<div
								class:list={[
									'services-card__media',
									'panel-horizontal-card__media',
									!imageUrl && 'panel-horizontal-card__media--placeholder',
								]}
								data-service-card-media
							>
								{imageUrl ? (
									<img
										src={imageUrl}
										alt=""
										class="panel-horizontal-card__media-image"
										loading="lazy"
										decoding="async"
										onerror="this.classList.add('is-hidden'); this.parentElement?.classList.add('panel-horizontal-card__media--placeholder');"
									/>
								) : null}
								<span
									class="material-symbols-rounded panel-horizontal-card__media-icon"
									aria-hidden="true"
								>
									design_services
								</span>
								<span
									class:list={[
										'services-card-status',
										isActive
											? 'services-card-status--active'
											: 'services-card-status--inactive',
									]}
								>
									<span
										class:list={[
											'size-1.5 rounded-full',
											isActive
												? 'services-summary-dot--active'
												: 'services-summary-dot--inactive',
										]}
									></span>
									{isActive ? 'Activo' : 'Inactivo'}
								</span>
							</div>

							<div class="services-card__body services-card-body">
								<h3 class="services-card-title line-clamp-1">
									{service.name || `Servicio #${service.id_service}`}
								</h3>
								<dl class="services-card__metrics">
									<div class="services-card__stat">
										<dt class="services-card-term">Duración</dt>
										<dd class="services-card-value">{toDurationLabel(service.duration_minutes)}</dd>
									</div>
									<div class="services-card__stat">
										<dt class="services-card-term">Precio</dt>
										<dd class="services-card-value">
											{service.price ? currencyFormatter.format(service.price) : '--'}
										</dd>
									</div>
								</dl>
							</div>
						</div>
					</article>
					);
				})}
			</div>
		)}
	</div>
</section>

<style is:global>
	.services-view {
		display: grid;
		gap: 0.75rem;
	}

	@media (min-width: 1024px) {
		.services-view {
			gap: 1.2rem;
		}
	}

	.services-summary-dot {
		display: inline-block;
	}

	.services-summary-dot--active {
		background: #22c55e;
	}

	.services-summary-dot--inactive {
		background: #fb7185;
	}

	.services-create-btn {
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--primary) 72%, #123e7a 28%);
		background: var(--primary);
		padding: 0.72rem 1.15rem;
		font-size: 0.92rem;
		font-weight: 780;
		color: #f8fbff;
		box-shadow: none;
		transition: filter 140ms ease, border-color 140ms ease;
	}

	.services-create-btn-icon {
		flex-shrink: 0;
	}

	.services-create-btn:hover {
		filter: brightness(1.04);
	}

	.services-create-btn:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
		outline-offset: 3px;
	}

	.services-create-fab {
		display: none;
	}

	@media (max-width: 639px) {
		.services-create-fab {
			position: fixed;
			right: max(1rem, env(safe-area-inset-right, 0px));
			bottom: calc(5.15rem + env(safe-area-inset-bottom, 0px));
			z-index: 44;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 3.05rem;
			height: 3.05rem;
			padding: 0;
			border: 0;
			border-radius: 999px;
			color: #f8fbff;
			background: var(--primary);
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.28);
			cursor: pointer;
			-webkit-tap-highlight-color: transparent;
			transition: transform 140ms ease, box-shadow 140ms ease, filter 140ms ease;
		}

		.services-create-fab-icon {
			width: 1.35rem;
			height: 1.35rem;
			flex-shrink: 0;
		}

		.services-create-fab:hover {
			filter: brightness(1.04);
			box-shadow: 0 3px 10px rgba(0, 0, 0, 0.32);
		}

		.services-create-fab:active {
			transform: scale(0.96);
		}

		.services-create-fab:focus-visible {
			outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
			outline-offset: 3px;
		}
	}

	.services-empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 1.35rem;
		border: 1px solid rgba(148, 163, 184, 0.24);
		background: color-mix(in srgb, var(--surface-container-low) 72%, var(--surface-bright) 28%);
		padding: 2.5rem 1.25rem;
		text-align: center;
	}

	.services-empty-icon {
		margin-bottom: 1rem;
		display: flex;
		height: 4rem;
		width: 4rem;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container) 88%, var(--surface-bright) 12%);
		color: var(--on-surface-variant);
	}

	service-manager .services-card {
		--services-ease: cubic-bezier(0.32, 0.72, 0, 1);
		cursor: pointer;
		gap: 0;
		padding: 0.7rem 0.75rem 0.6rem;
		border: 0;
		border-radius: 1.15rem;
		background: var(--surface-bright);
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--on-surface) 9%, transparent);
		overflow: visible;
		animation: services-card-enter 800ms var(--services-ease) both;
		transition:
			transform 520ms var(--services-ease),
			box-shadow 520ms var(--services-ease),
			background 520ms var(--services-ease);
	}

	service-manager .services-card:nth-child(1) { animation-delay: 0ms; }
	service-manager .services-card:nth-child(2) { animation-delay: 50ms; }
	service-manager .services-card:nth-child(3) { animation-delay: 100ms; }
	service-manager .services-card:nth-child(4) { animation-delay: 150ms; }
	service-manager .services-card:nth-child(5) { animation-delay: 200ms; }
	service-manager .services-card:nth-child(6) { animation-delay: 250ms; }
	service-manager .services-card:nth-child(7) { animation-delay: 300ms; }
	service-manager .services-card:nth-child(8) { animation-delay: 350ms; }
	service-manager .services-card:nth-child(n + 9) { animation-delay: 400ms; }

	@keyframes services-card-enter {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	service-manager .services-card.panel-skeleton-card,
	service-manager .services-card.panel-skeleton-card:hover {
		animation: none;
		transform: none !important;
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--on-surface) 9%, transparent) !important;
	}

	service-manager .services-card:hover {
		transform: none;
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--on-surface) 14%, transparent);
	}

	service-manager .services-card__inner {
		display: grid;
		gap: 0.65rem;
		height: 100%;
		min-width: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
	}

	service-manager .services-card .services-card__media,
	service-manager .services-card .panel-horizontal-card__media {
		flex: none;
		max-width: none;
		min-width: 0;
		width: 100%;
		height: 5.15rem;
		border-radius: 0.9rem;
		overflow: hidden;
	}

	service-manager .services-card .panel-horizontal-card__media-icon {
		display: inline-flex;
		position: relative;
		z-index: 1;
		font-size: 1.55rem;
		color: color-mix(in srgb, var(--primary) 72%, #ffffff 28%);
	}

	service-manager .services-card .panel-horizontal-card__media:not(.panel-horizontal-card__media--placeholder) .panel-horizontal-card__media-icon {
		display: none;
	}

	service-manager .services-card .panel-horizontal-card__media-image {
		transition: transform 700ms var(--services-ease);
	}

	service-manager .services-card--inactive .panel-horizontal-card__media-image,
	service-manager .services-card--inactive .panel-horizontal-card__media-icon {
		opacity: 0.7;
	}

	service-manager .services-card__body {
		display: grid;
		gap: 0.45rem;
		min-width: 0;
		padding: 0;
	}

	service-manager .services-card .services-card-title {
		font-size: 1.06rem;
		font-weight: 760;
		letter-spacing: -0.032em;
		line-height: 1.2;
	}

	service-manager .services-card__metrics {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.85rem;
		margin: 0;
		padding: 0.55rem 0 0;
		box-shadow: inset 0 1px 0 color-mix(in srgb, var(--on-surface) 8%, transparent);
	}

	service-manager .services-card__stat {
		display: grid;
		gap: 0.2rem;
		min-width: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
	}

	service-manager .services-card .services-card-term {
		font-size: 0.68rem;
		font-weight: 650;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	service-manager .services-card .services-card-value {
		margin: 0;
		font-size: 0.9rem;
		font-weight: 720;
		letter-spacing: -0.02em;
		line-height: 1.2;
		text-align: left;
		font-variant-numeric: tabular-nums;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.services-card-status {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border-radius: 999px;
		border: 0;
		padding: 0.28rem 0.58rem;
		font-size: 0.7rem;
		font-weight: 750;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.services-card-status--active {
		background: color-mix(in srgb, #22c55e 18%, #0b1220 82%);
		color: #bbf7d0;
	}

	.services-card-status--inactive {
		background: color-mix(in srgb, #fb7185 16%, #1a1014 84%);
		color: #fecdd3;
	}

	service-manager .services-card:active {
		transform: scale(0.985);
	}

	html[data-theme='dark'] .services-create-btn {
		border-color: color-mix(in srgb, var(--primary) 58%, #0e0e10 42%);
		background: color-mix(in srgb, var(--primary) 78%, #0e0e10 22%);
	}

	html[data-theme='dark'] .services-create-btn:hover {
		filter: brightness(1.08);
	}

	@media (max-width: 639px) {
		html[data-theme='dark'] .services-create-fab {
			background: color-mix(in srgb, var(--primary) 78%, #0e0e10 22%);
		}

		html[data-theme='dark'] .services-create-fab:hover {
			filter: brightness(1.08);
		}
	}

	html[data-theme='dark'] .services-empty-state {
		border-color: rgba(255, 255, 255, 0.08);
		background: #121214;
	}

	html[data-theme='dark'] .services-empty-icon {
		background: rgba(255, 255, 255, 0.05);
		color: var(--on-surface-variant);
	}

	@media (min-width: 1024px) {
		service-manager .services-card:hover {
			transform: translateY(-3px);
			box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 28%, transparent);
		}

		service-manager .services-card:hover .panel-horizontal-card__media-image {
			transform: scale(1.045);
		}
	}

	html[data-theme='dark'] service-manager .services-card {
		background: #16161a;
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
	}

	html[data-theme='dark'] service-manager .services-card:hover {
		background: #19191e;
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.14);
	}

	html[data-theme='dark'] service-manager .services-card__inner {
		background: transparent;
		box-shadow: none;
	}

	html[data-theme='dark'] service-manager .services-card__metrics {
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
	}

	html[data-theme='dark'] service-manager .services-card__stat {
		background: transparent;
	}

	html[data-theme='dark'] service-manager .services-card.panel-skeleton-card,
	html[data-theme='dark'] service-manager .services-card.panel-skeleton-card:hover {
		background: #16161a;
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) !important;
	}

	html[data-theme='dark'] .services-card-status--active {
		background: color-mix(in srgb, #22c55e 22%, #0b1220 78%);
		color: #bbf7d0;
	}

	html[data-theme='dark'] .services-card-status--inactive {
		background: color-mix(in srgb, #fb7185 18%, #1a1014 82%);
		color: #fecdd3;
	}

	@media (prefers-reduced-motion: reduce) {
		service-manager .services-card,
		service-manager .services-card .panel-horizontal-card__media-image {
			animation: none;
			transition: none;
		}

		service-manager .services-card:hover,
		service-manager .services-card:active,
		service-manager .services-card:hover .panel-horizontal-card__media-image {
			transform: none;
		}
	}

	.services-status-filter-btn.is-active {
		border-color: color-mix(in srgb, var(--primary) 55%, var(--shell-border));
		color: var(--primary);
		background: color-mix(in srgb, var(--primary) 10%, var(--surface-bright));
	}

	.services-status-filter-badge {
		position: absolute;
		top: 0.45rem;
