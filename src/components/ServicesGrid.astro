---
import type { Service } from '../lib/services';

interface Props {
	services: Service[];
	showCreateAction?: boolean;
	searchQuery?: string;
	isActiveFilter?: number | null;
	totalRecords?: number;
}

const {
	services = [],
	showCreateAction = false,
	searchQuery = '',
	isActiveFilter = null,
	totalRecords = 0,
} = Astro.props;
const hasSearch = Boolean(searchQuery);
const hasStatusFilter = isActiveFilter === 0 || isActiveFilter === 1;
const hasFilters = hasSearch || hasStatusFilter;

const currencyFormatter = new Intl.NumberFormat('es-PY', {
	style: 'currency',
	currency: 'PYG',
	maximumFractionDigits: 0,
});

const toDurationLabel = (value?: number | null) => {
	if (!value || value <= 0) return '--';
	if (value === 60) return '1 hora';
	if (value > 60 && value % 60 === 0) return `${value / 60} horas`;

	const hours = Math.floor(value / 60);
	const mins = value % 60;
	if (hours > 0) return `${hours} h ${mins} min`;
	return `${value} min`;
};

const activeCount = services.filter((s) => s.is_active === 1).length;
const inactiveCount = services.length - activeCount;
---

<section class="services-view">
	<header class="mb-4 flex flex-wrap items-center justify-between gap-3">
		<h2 class="m-0 text-[1.5rem] sm:text-[1.75rem] font-bold tracking-tight text-(--on-surface) leading-none">
			Servicios{' '}
			<span class="font-semibold text-(--on-surface-variant)" data-services-summary>
				({totalRecords})
			</span>
		</h2>

		<div class="flex flex-wrap items-center justify-end gap-2">
			<span class="services-summary-pill services-summary-pill--active">
				<span class="size-2 rounded-full services-summary-dot services-summary-dot--active"></span>
				Activos: <span data-services-active-count>{activeCount}</span>
			</span>
			<span
				class="services-summary-pill services-summary-pill--inactive"
				data-services-inactive-pill
				hidden={inactiveCount <= 0}
			>
				<span class="size-2 rounded-full services-summary-dot services-summary-dot--inactive"></span>
				Inactivos: <span data-services-inactive-count>{inactiveCount}</span>
			</span>

			{showCreateAction && (
				<button
					type="button"
					class="services-create-btn hidden sm:inline-flex items-center justify-center gap-2"
					data-open-service-modal
				>
					<svg
						class="services-create-btn-icon w-[18px] h-[18px]"
						viewBox="0 0 24 24"
						fill="none"
						aria-hidden="true"
					>
						<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
					</svg>
					<span>Nuevo Servicio</span>
				</button>
			)}
		</div>
	</header>

	{showCreateAction && (
		<button
			type="button"
			class="services-create-fab"
			data-open-service-modal
			aria-label="Nuevo Servicio"
			title="Nuevo Servicio"
		>
			<svg
				class="services-create-fab-icon"
				viewBox="0 0 24 24"
				fill="none"
				aria-hidden="true"
			>
				<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
			</svg>
		</button>
	)}

	<div class="flex max-w-xl items-center gap-2">
		<div class="relative min-w-0 flex-1" data-panel-search>
			<span
				class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-(--on-surface-variant)"
				aria-hidden="true"
			>
				<span class="material-symbols-rounded text-[1.2rem]">search</span>
			</span>
			<input
				type="text"
				inputmode="search"
				enterkeyhint="search"
				data-services-search
				placeholder="Buscar por nombre"
				aria-label="Buscar por nombre"
				autocomplete="off"
				value={searchQuery}
				class="w-full rounded-2xl border border-(--shell-border) bg-(--surface-bright) py-2.5 pl-11 pr-11 text-[0.95rem] font-semibold text-(--on-surface) outline-none transition placeholder:font-medium placeholder:text-(--on-surface-variant)/70 hover:border-(--on-surface-variant) focus:border-(--primary) focus:ring-4 focus:ring-(--primary)/10 shadow-sm"
			/>
			<button
				type="button"
				class="panel-search-clear"
				data-panel-search-clear
				hidden={String(searchQuery || '').length === 0}
				aria-label="Limpiar búsqueda"
			>
				<span class="material-symbols-rounded" aria-hidden="true">close</span>
			</button>
		</div>

		<button
			type="button"
			class:list={[
				'services-status-filter-btn relative flex size-11 shrink-0 items-center justify-center rounded-2xl border border-(--shell-border) bg-(--surface-bright) text-(--on-surface-variant) shadow-sm transition hover:border-(--on-surface-variant) hover:text-(--on-surface) focus:border-(--primary) focus:outline-none focus:ring-4 focus:ring-(--primary)/10',
				hasStatusFilter && 'is-active',
			]}
			data-open-services-status-filter
			aria-label="Filtrar por estado"
			aria-haspopup="dialog"
			aria-controls="services-status-filter-sheet"
			aria-pressed={hasStatusFilter ? 'true' : 'false'}
		>
			<span class="material-symbols-rounded text-[1.25rem]" aria-hidden="true">tune</span>
			{hasStatusFilter && (
				<span class="services-status-filter-badge" data-services-status-filter-badge aria-hidden="true"></span>
			)}
		</button>
	</div>

	<dialog
		id="services-status-filter-sheet"
		class="services-status-filter-sheet"
		data-services-status-filter-sheet
		aria-labelledby="services-status-filter-title"
	>
		<div class="services-status-filter-sheet__handle" aria-hidden="true">
			<span></span>
		</div>
		<div class="services-status-filter-sheet__header">
			<h2 id="services-status-filter-title" class="m-0 text-[1.05rem] font-extrabold tracking-tight">
				Filtros
			</h2>
			<button
				type="button"
				class="flex size-9 shrink-0 items-center justify-center rounded-full text-(--on-surface-variant) transition-colors hover:bg-(--surface-variant) hover:text-(--on-surface)"
				data-close-services-status-filter
				aria-label="Cerrar filtro"
			>
				<span class="material-symbols-rounded text-[1.3rem]">close</span>
			</button>
		</div>
		<div class="services-status-filter-sheet__list" role="listbox" aria-label="Estado del servicio">
			<button
				type="button"
				class:list={['services-status-filter-option', !hasStatusFilter && 'is-selected']}
				data-services-status-option
				data-value=""
				role="option"
				aria-selected={!hasStatusFilter ? 'true' : 'false'}
			>
				<span>Todos</span>
				<span class="material-symbols-rounded">check</span>
			</button>
			<button
				type="button"
				class:list={['services-status-filter-option', isActiveFilter === 1 && 'is-selected']}
				data-services-status-option
				data-value="1"
				role="option"
				aria-selected={isActiveFilter === 1 ? 'true' : 'false'}
			>
				<span>Activos</span>
				<span class="material-symbols-rounded">check</span>
			</button>
			<button
				type="button"
				class:list={['services-status-filter-option', isActiveFilter === 0 && 'is-selected']}
				data-services-status-option
				data-value="0"
				role="option"
				aria-selected={isActiveFilter === 0 ? 'true' : 'false'}
			>
				<span>Inactivos</span>
				<span class="material-symbols-rounded">check</span>
			</button>
		</div>
	</dialog>

	<div data-services-results>
		{services.length === 0 ? (
			<div class="services-empty-state" data-services-empty>
				<div class="services-empty-icon">
					<span class="material-symbols-rounded text-[2rem]">
						{hasFilters ? 'search_off' : 'inbox'}
					</span>
				</div>
				<h3 class="text-[1.1rem] font-bold text-(--on-surface)">
					{hasFilters ? 'No se encontraron servicios' : 'No hay servicios registrados'}
				</h3>
				<p class="mt-1.5 max-w-sm text-[0.95rem] leading-relaxed text-(--on-surface-variant)">
					{hasSearch
						? 'Probá con otro nombre.'
						: hasStatusFilter
							? 'No hay servicios con ese estado.'
							: 'Aun no has agregado ningun servicio a esta organizacion. Comienza creando tu primera prestacion.'}
				</p>
			</div>
		) : (
			<div class="material-cards-grid gap-3 sm:grid-cols-2 sm:gap-4 md:grid-cols-3 lg:grid-cols-4" data-services-grid>
				{services.map((service) => (
					<article
						class="services-card group cursor-pointer"
						data-service-card
						data-service-id={service.id_service}
						tabindex="0"
						role="button"
						aria-label={`Editar servicio ${service.name || service.id_service}`}
					>
						{service.image_url ? (
							<div class="services-card-cover">
								<img src={service.image_url} alt="" loading="lazy" />
							</div>
						) : (
							<div class="services-card-cover services-card-cover--brand" aria-hidden="true"></div>
						)}
						<div class="flex items-start justify-between gap-2">
							<div class="services-card-icon">
								<span class="material-symbols-rounded text-[1.25rem]">design_services</span>
							</div>

							<span
								class:list={[
									'services-card-status',
									service.is_active === 1
										? 'services-card-status--active'
										: 'services-card-status--inactive',
								]}
							>
								<span
									class:list={[
										'size-1.5 rounded-full',
										service.is_active === 1
											? 'services-summary-dot--active'
											: 'services-summary-dot--inactive',
									]}
								></span>
								{service.is_active === 1 ? 'Activo' : 'Inactivo'}
							</span>
						</div>

						<div class="services-card-body">
							<h3 class="services-card-title">
								{service.name || `Servicio #${service.id_service}`}
							</h3>

							<dl class="services-card-metrics">
								<div class="flex items-center justify-between text-[0.8rem]">
									<dt class="services-card-term">Duración</dt>
									<dd class="services-card-value services-card-value--duration">{toDurationLabel(service.duration_minutes)}</dd>
								</div>
								<div class="flex items-center justify-between text-[0.8rem]">
									<dt class="services-card-term">Precio</dt>
									<dd class="services-card-value services-card-value--price">
										{service.price ? currencyFormatter.format(service.price) : '--'}
									</dd>
								</div>
							</dl>
						</div>
					</article>
				))}
			</div>
		)}
	</div>
</section>

<style is:global>
	.services-view {
		display: grid;
		gap: 1.2rem;
	}

	.services-summary-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border-radius: 999px;
		border: 0;
		padding: 0.33rem 0.78rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.01em;
	}

	.services-summary-pill--active {
		background: rgba(16, 185, 129, 0.12);
		color: #0f6d4a;
	}

	.services-summary-pill--inactive {
		background: rgba(244, 63, 94, 0.11);
		color: #8d3e4a;
	}

	.services-summary-dot {
		display: inline-block;
	}

	.services-summary-dot--active {
		background: #22c55e;
	}

	.services-summary-dot--inactive {
		background: #fb7185;
	}

	.services-create-btn {
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--primary) 72%, #123e7a 28%);
		background: var(--primary);
		padding: 0.72rem 1.15rem;
		font-size: 0.92rem;
		font-weight: 780;
		color: #f8fbff;
		box-shadow: none;
		transition: filter 140ms ease, border-color 140ms ease;
	}

	.services-create-btn-icon {
		flex-shrink: 0;
	}

	.services-create-btn:hover {
		filter: brightness(1.04);
	}

	.services-create-btn:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
		outline-offset: 3px;
	}

	.services-create-fab {
		display: none;
	}

	@media (max-width: 639px) {
		.services-create-fab {
			position: fixed;
			right: max(1rem, env(safe-area-inset-right, 0px));
			bottom: calc(5.15rem + env(safe-area-inset-bottom, 0px));
			z-index: 44;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 3.5rem;
			height: 3.5rem;
			padding: 0;
			border: 0;
			border-radius: 999px;
			color: #f8fbff;
			background: var(--primary);
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.28);
			cursor: pointer;
			-webkit-tap-highlight-color: transparent;
			transition: transform 140ms ease, box-shadow 140ms ease, filter 140ms ease;
		}

		.services-create-fab-icon {
			width: 1.35rem;
			height: 1.35rem;
			flex-shrink: 0;
		}

		.services-create-fab:hover {
			filter: brightness(1.04);
			box-shadow: 0 3px 10px rgba(0, 0, 0, 0.32);
		}

		.services-create-fab:active {
			transform: scale(0.96);
		}

		.services-create-fab:focus-visible {
			outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
			outline-offset: 3px;
		}
	}

	.services-empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 1.35rem;
		border: 1px solid rgba(148, 163, 184, 0.24);
		background: color-mix(in srgb, var(--surface-container-low) 72%, var(--surface-bright) 28%);
		padding: 2.5rem 1.25rem;
		text-align: center;
	}

	.services-empty-icon {
		margin-bottom: 1rem;
		display: flex;
		height: 4rem;
		width: 4rem;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container) 88%, var(--surface-bright) 12%);
		color: var(--on-surface-variant);
	}

	.services-card {
		cursor: pointer;
		gap: 0.55rem;
		padding: 0.72rem 0.8rem 0.85rem;
		border-radius: 0.8rem;
	}

	.services-card-cover {
		margin: -0.05rem -0.05rem 0.4rem;
		overflow: hidden;
		border-radius: 0.65rem;
		aspect-ratio: 16 / 9;
		background: color-mix(in srgb, var(--surface-container-high) 80%, transparent);
	}

	.services-card-cover--brand {
		background:
			radial-gradient(
				ellipse 80% 70% at 20% 15%,
				color-mix(in srgb, var(--primary) 28%, transparent),
				transparent 60%
			),
			linear-gradient(
				145deg,
				color-mix(in srgb, var(--primary-container) 55%, var(--surface-container-high)),
				var(--surface-container-highest) 55%,
				color-mix(in srgb, var(--primary-container) 35%, var(--surface-container-high))
			);
	}

	.services-card-cover img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.services-card .services-card-icon {
		width: 1.9rem;
		height: 1.9rem;
		border-radius: 0.6rem;
	}

	.services-card .services-card-icon .material-symbols-rounded {
		font-size: 1rem;
	}

	.services-card .services-card-body {
		gap: 0.4rem;
	}

	.services-card .services-card-title {
		font-size: 0.92rem;
	}

	.services-card .services-card-metrics {
		gap: 0.25rem;
		font-size: 0.8rem;
	}

	.services-card-status {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border-radius: 999px;
		border: 0;
		padding: 0.24rem 0.6rem;
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.services-card-status--active {
		background: rgba(16, 185, 129, 0.12);
		color: #0f6d4a;
	}

	.services-card-status--inactive {
		background: rgba(244, 63, 94, 0.11);
		color: #8d3e4a;
	}

	.services-card-value--duration {
		font-weight: 500;
	}

	.services-card-value--price {
		font-weight: 700;
		color: var(--on-surface);
	}

	html[data-theme='dark'] .services-summary-pill--active {
		background: rgba(110, 231, 183, 0.16);
		color: #b8f5d5;
	}

	html[data-theme='dark'] .services-summary-pill--inactive {
		background: rgba(255, 182, 193, 0.12);
		color: #ffc8d2;
	}

	html[data-theme='dark'] .services-create-btn {
		border-color: color-mix(in srgb, var(--primary) 58%, #131314 42%);
		background: color-mix(in srgb, var(--primary) 78%, #131314 22%);
	}

	html[data-theme='dark'] .services-create-btn:hover {
		filter: brightness(1.08);
	}

	@media (max-width: 639px) {
		.services-card {
			gap: 0.55rem;
			padding: 0.85rem 0.95rem 0.95rem;
			border-radius: 0.85rem;
		}

		.services-card-cover {
			margin: 0 0 0.45rem;
			border-radius: 0.7rem;
			aspect-ratio: 16 / 9;
		}

		.services-card .services-card-icon {
			width: 1.75rem;
			height: 1.75rem;
			border-radius: 0.55rem;
		}

		.services-card .services-card-icon .material-symbols-rounded {
			font-size: 0.95rem;
		}

		.services-card .services-card-body {
			gap: 0.35rem;
		}

		.services-card .services-card-title {
			font-size: 0.9rem;
		}

		.services-card .services-card-metrics {
			gap: 0.2rem;
			font-size: 0.78rem;
		}

		.services-card-status {
			padding: 0.2rem 0.5rem;
			font-size: 0.62rem;
		}

		html[data-theme='dark'] .services-create-fab {
			background: color-mix(in srgb, var(--primary) 78%, #131314 22%);
		}

		html[data-theme='dark'] .services-create-fab:hover {
			filter: brightness(1.08);
		}
	}

	html[data-theme='dark'] .services-empty-state {
		border-color: rgba(255, 255, 255, 0.08);
		background: color-mix(
			in srgb,
			var(--surface-container-low, #1e1f22) 82%,
			var(--surface-container, #131314) 18%
		);
	}

	html[data-theme='dark'] .services-empty-icon {
		background: rgba(255, 255, 255, 0.05);
		color: var(--on-surface-variant);
	}

	html[data-theme='dark'] .services-card-status--active {
		background: rgba(110, 231, 183, 0.16);
		color: #b8f5d5;
	}

	html[data-theme='dark'] .services-card-status--inactive {
		background: rgba(255, 182, 193, 0.12);
		color: #ffc8d2;
	}

	html[data-theme='dark'] .services-card-value--duration {
		color: color-mix(in srgb, var(--on-surface-variant) 86%, #d1d5db 14%);
	}

	html[data-theme='dark'] .services-card-value--price {
		color: var(--on-surface);
	}

	.services-status-filter-btn.is-active {
		border-color: color-mix(in srgb, var(--primary) 55%, var(--shell-border));
		color: var(--primary);
		background: color-mix(in srgb, var(--primary) 10%, var(--surface-bright));
	}

	.services-status-filter-badge {
		position: absolute;
		top: 0.45rem;
		right: 0.45rem;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--primary);
		box-shadow: 0 0 0 2px var(--surface-bright);
	}

	.services-status-filter-sheet {
		position: fixed;
		inset: auto 0 0;
		z-index: 80;
		margin: 0;
		width: 100vw;
		max-width: none;
		max-height: min(72dvh, 28rem);
		border: 1px solid var(--shell-border);
		border-bottom: 0;
		border-radius: 1.6rem 1.6rem 0 0;
		background: var(--surface-bright);
		color: var(--on-surface);
		padding: 0;
		overflow: hidden;
		box-shadow: 0 -12px 40px rgb(0 0 0 / 0.18);
	}

	.services-status-filter-sheet[open] {
		display: flex;
		flex-direction: column;
	}

	.services-status-filter-sheet::backdrop {
		background: rgb(0 0 0 / 0.4);
	}

	.services-status-filter-sheet__handle {
		display: flex;
		justify-content: center;
		padding: 0.65rem 0 0.15rem;
	}

	.services-status-filter-sheet__handle span {
		display: block;
		width: 2.4rem;
		height: 0.28rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--on-surface-variant) 45%, transparent);
	}

	.services-status-filter-sheet__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.35rem 1rem 0.75rem;
		border-bottom: 1px solid var(--shell-border);
	}

	.services-status-filter-sheet__list {
		display: grid;
		gap: 0.35rem;
		padding: 0.75rem 0.85rem max(0.95rem, env(safe-area-inset-bottom));
		overflow-y: auto;
		overscroll-behavior: contain;
		min-height: 0;
	}

	.services-status-filter-option {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		width: 100%;
		border: 0;
		border-radius: 1rem;
		background: transparent;
		padding: 0.85rem 0.95rem;
		text-align: left;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--on-surface);
		cursor: pointer;
		transition: background-color 120ms ease, color 120ms ease;
	}

	.services-status-filter-option:hover {
		background: color-mix(in srgb, var(--on-surface) 6%, transparent);
	}

	.services-status-filter-option.is-selected {
