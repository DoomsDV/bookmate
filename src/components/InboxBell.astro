---
---

<details class="inbox-bell group relative shrink-0" data-inbox-menu>
	<summary
		class="topbar-action-btn relative flex size-9 cursor-pointer list-none items-center justify-center rounded-xl border border-(--shell-border) bg-(--control-surface) text-(--on-surface-variant) outline-none transition hover:bg-(--control-surface-strong) focus-visible:ring-2 focus-visible:ring-(--primary) focus-visible:ring-offset-2 focus-visible:ring-offset-transparent sm:size-10"
		aria-label="Notificaciones"
		data-inbox-trigger
	>
		<span class="material-symbols-rounded text-[1.1rem]">notifications</span>
		<span
			class="inbox-bell__badge"
			data-inbox-badge
			hidden
			aria-hidden="true"
		></span>
	</summary>

	<div class="inbox-panel" data-inbox-panel>
		<div class="inbox-panel__head">
			<div>
				<p class="inbox-panel__title">Notificaciones</p>
				<p class="inbox-panel__subtitle">Reservas, cobros y avisos del sistema</p>
			</div>
			<button type="button" class="inbox-panel__mark-all" data-inbox-mark-all hidden>
				Marcar todas como leídas
			</button>
		</div>
		<div class="inbox-panel__scroll">
			<p class="inbox-panel__empty" data-inbox-empty>
				No tenés notificaciones.
			</p>
			<div class="inbox-panel__list" data-inbox-list></div>
		</div>
	</div>
</details>

<dialog class="inbox-sheet" data-inbox-sheet aria-label="Notificaciones">
	<div class="inbox-sheet__handle" aria-hidden="true"><span></span></div>
	<div class="inbox-panel__head">
		<div>
			<p class="inbox-panel__title">Notificaciones</p>
			<p class="inbox-panel__subtitle">Reservas, cobros y avisos del sistema</p>
		</div>
		<button type="button" class="inbox-panel__mark-all" data-inbox-mark-all hidden>
			Marcar todas como leídas
		</button>
	</div>
	<div class="inbox-panel__scroll">
		<p class="inbox-panel__empty" data-inbox-empty>
			No tenés notificaciones.
		</p>
		<div class="inbox-panel__list" data-inbox-list></div>
	</div>
</dialog>

<style is:global>
	.inbox-bell summary::-webkit-details-marker,
	.inbox-bell summary::marker {
		display: none;
	}

	.inbox-bell__badge {
		position: absolute;
		top: 0.08rem;
		right: 0.08rem;
		z-index: 1;
		min-width: 1.1rem;
		height: 1.1rem;
		padding: 0 0.28rem;
		border-radius: 999px;
		background: #e11d48;
		color: #fff;
		font-size: 0.62rem;
		font-weight: 800;
		line-height: 1;
		text-align: center;
		display: none;
		align-items: center;
		justify-content: center;
		pointer-events: none;
	}

	.inbox-bell__badge:not([hidden]) {
		display: inline-flex;
	}

	.inbox-panel {
		position: absolute;
		right: 0;
		top: calc(100% + 0.75rem);
		z-index: 60;
		display: none;
		width: min(24.5rem, calc(100vw - 1.5rem));
		overflow: hidden;
		isolation: isolate;
		border-radius: 1.35rem;
		border: 1px solid var(--shell-border);
		background-color: var(--menu-surface);
		background-image: linear-gradient(
			180deg,
			color-mix(in srgb, var(--on-surface) 3%, var(--menu-surface)) 0%,
			var(--menu-surface) 48%
		);
		box-shadow: 0 22px 60px rgba(15, 23, 42, 0.16);
	}

	html[data-theme='dark'] .inbox-panel {
		background-color: #18181a;
		background-image: linear-gradient(
			180deg,
			#1c1c1e 0%,
			#18181a 52%,
			#171719 100%
		);
	}

	.inbox-bell[open] .inbox-panel {
		display: flex;
		flex-direction: column;
		max-height: min(32rem, calc(100dvh - 5.5rem));
	}

	.inbox-panel__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1rem 1.05rem 0.75rem;
		border-bottom: 1px solid color-mix(in srgb, var(--on-surface) 8%, transparent);
		flex-shrink: 0;
	}

	.inbox-panel__title {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--on-surface);
	}

	.inbox-panel__subtitle {
		margin: 0.15rem 0 0;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--on-surface-variant);
	}

	.inbox-panel__mark-all {
		flex-shrink: 0;
		border: 0;
		background: transparent;
		padding: 0;
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--primary);
		cursor: pointer;
	}

	.inbox-panel__scroll {
		display: flex;
		flex: 1;
		flex-direction: column;
		overflow: auto;
		min-height: 8rem;
		overscroll-behavior: contain;
	}

	.inbox-panel__empty {
		margin: auto;
		padding: 1.6rem 1.1rem;
		width: 100%;
		text-align: center;
		font-size: 0.86rem;
		font-weight: 600;
		color: var(--on-surface-variant);
	}

	.inbox-panel__empty[hidden] {
		display: none;
	}

	.inbox-panel__list {
		display: flex;
		flex-direction: column;
		padding: 0.35rem 0.4rem 0.55rem;
	}

	.inbox-panel__list:empty {
		display: none;
	}

	.inbox-item {
		display: flex;
		align-items: flex-start;
		gap: 0.7rem;
		width: 100%;
		border: 0;
		border-radius: 1rem;
		background: transparent;
		padding: 0.7rem 0.65rem;
		text-align: left;
		cursor: pointer;
		color: inherit;
	}

	.inbox-item:hover {
		background: color-mix(in srgb, var(--primary) 8%, transparent);
	}

	.inbox-item.is-unread {
		background: color-mix(in srgb, var(--primary) 10%, transparent);
	}

	.inbox-item__icon {
		flex-shrink: 0;
		margin-top: 0.1rem;
		font-size: 1.15rem;
		color: var(--primary);
	}

	.inbox-item__body {
		display: grid;
		min-width: 0;
		gap: 0.12rem;
		flex: 1;
	}

	.inbox-item__title {
		font-size: 0.84rem;
		font-weight: 700;
		color: var(--on-surface);
	}

	.inbox-item__text {
		font-size: 0.78rem;
		font-weight: 500;
		line-height: 1.35;
		color: var(--on-surface-variant);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.inbox-item__time {
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--on-surface-variant);
	}

	.inbox-item__dot {
		flex-shrink: 0;
		width: 0.45rem;
		height: 0.45rem;
		margin-top: 0.4rem;
		border-radius: 999px;
		background: var(--primary);
	}

	.inbox-sheet {
		display: none;
	}

	@media (max-width: 1023px) {
		.inbox-bell .inbox-panel {
			display: none !important;
		}

		.inbox-sheet {
			position: fixed;
			inset: auto 0 0;
			z-index: 80;
			margin: 0;
			width: 100vw;
			max-width: none;
			height: 50dvh;
			max-height: 50dvh;
			border: 1px solid var(--shell-border);
			border-bottom: 0;
			border-radius: 1.6rem 1.6rem 0 0;
			background: var(--surface-bright);
			color: var(--on-surface);
			padding: 0;
			overflow: hidden;
			box-shadow: var(--modal-shadow-sheet);
		}

		.inbox-sheet[open] {
			display: flex;
			flex-direction: column;
			animation: inbox-sheet-in var(--modal-open-duration, 150ms) var(--modal-easing, ease);
		}

		.inbox-sheet::backdrop {
			background-color: var(--modal-backdrop-scrim);
		}

		.inbox-sheet__handle {
			display: flex;
			justify-content: center;
			flex-shrink: 0;
			padding: 0.65rem 0 0.15rem;
		}

		.inbox-sheet__handle span {
			display: block;
			width: 2.4rem;
			height: 0.28rem;
			border-radius: 999px;
			background: color-mix(in srgb, var(--on-surface-variant) 45%, transparent);
		}

		.inbox-sheet .inbox-panel__head {
			padding: 0.35rem 1.1rem 0.85rem;
		}

		.inbox-sheet .inbox-panel__scroll {
			flex: 1 1 auto;
			min-height: 0;
			padding-bottom: max(1rem, env(safe-area-inset-bottom, 0px));
		}
	}

	@media (min-width: 1024px) {
		.inbox-sheet {
			display: none !important;
		}
	}

	@keyframes inbox-sheet-in {
		from {
			opacity: 0;
			transform: translateY(100%);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>

<script>
	import { initInboxBell } from '../scripts/inbox-bell';

	initInboxBell();
	if (!(window as any).__haselInboxBellPageBound) {
		document.addEventListener('astro:page-load', () => initInboxBell());
		(window as any).__haselInboxBellPageBound = true;
	}
</script>
