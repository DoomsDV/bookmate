---
interface Props {
	newAppointmentHref: string;
	newCustomerHref: string;
	hubHref: string;
	hubExternal?: boolean;
}

const {
	newAppointmentHref,
	newCustomerHref,
	hubHref,
	hubExternal = false,
} = Astro.props;
---

<section class="dashboard-quick-actions" data-dashboard-quick-actions aria-label="Accesos rápidos">
	<h2 class="dashboard-quick-actions__title">Accesos rápidos</h2>
	<div class="dashboard-quick-actions__grid">
		<a class="dashboard-quick-actions__item" href={newAppointmentHref} data-quick-action="appointment">
			<span class="dashboard-quick-actions__icon" aria-hidden="true">
				<span class="material-symbols-rounded">calendar_add_on</span>
			</span>
			<span class="dashboard-quick-actions__copy">
				<span class="dashboard-quick-actions__label">Nueva cita</span>
				<span class="dashboard-quick-actions__hint">Abrir el calendario</span>
			</span>
		</a>
		<a class="dashboard-quick-actions__item" href={newCustomerHref} data-quick-action="customer">
			<span class="dashboard-quick-actions__icon" aria-hidden="true">
				<span class="material-symbols-rounded">person_add</span>
			</span>
			<span class="dashboard-quick-actions__copy">
				<span class="dashboard-quick-actions__label">Nuevo cliente</span>
				<span class="dashboard-quick-actions__hint">Registrar en la agenda</span>
			</span>
		</a>
		<a
			class="dashboard-quick-actions__item"
			href={hubHref}
			data-quick-action="hub"
			target={hubExternal ? '_blank' : undefined}
			rel={hubExternal ? 'noopener noreferrer' : undefined}
			aria-label="Ver hub / página pública"
		>
			<span class="dashboard-quick-actions__icon" aria-hidden="true">
				<span class="material-symbols-rounded">public</span>
			</span>
			<span class="dashboard-quick-actions__copy">
				<span class="dashboard-quick-actions__label">Ver hub</span>
				<span class="dashboard-quick-actions__hint">Página pública</span>
			</span>
			{hubExternal ? (
				<span class="dashboard-quick-actions__external material-symbols-rounded" aria-hidden="true">
					open_in_new
				</span>
			) : null}
		</a>
	</div>
</section>

<style>
	.dashboard-quick-actions {
		display: grid;
		gap: 0.7rem;
		min-width: 0;
		width: 100%;
	}

	.dashboard-quick-actions__title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.25;
		color: #1e293b;
	}

	.dashboard-quick-actions__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--dashboard-gap, 8px);
		min-width: 0;
	}

	.dashboard-quick-actions__item {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.7rem;
		min-width: 0;
		min-height: 6.1rem;
		padding: 0.85rem 0.9rem 0.8rem;
		border: 1px solid var(--dashboard-card-border, var(--shell-border));
		border-radius: var(--dashboard-card-radius, 0.75rem);
		background: var(--dashboard-card-bg, #ffffff);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 260ms cubic-bezier(0.32, 0.72, 0, 1),
			background-color 260ms cubic-bezier(0.32, 0.72, 0, 1);
	}

	.dashboard-quick-actions__item:hover {
		border-color: color-mix(in srgb, var(--primary) 32%, var(--shell-border));
	}

	.dashboard-quick-actions__item:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 70%, #fff 30%);
		outline-offset: 2px;
	}

	.dashboard-quick-actions__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 2rem;
		height: 2rem;
		border-radius: 0.7rem;
		background: color-mix(in srgb, var(--primary) 12%, transparent);
		color: var(--primary);
	}

	.dashboard-quick-actions__icon .material-symbols-rounded {
		font-size: 1.15rem;
		line-height: 1;
	}

	.dashboard-quick-actions__copy {
		display: grid;
		gap: 0.12rem;
		min-width: 0;
	}

	.dashboard-quick-actions__label {
		font-size: 0.92rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.25;
		color: #1e293b;
	}

	.dashboard-quick-actions__hint {
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--on-surface-variant, #64748b);
	}

	.dashboard-quick-actions__external {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		font-size: 1rem;
		color: var(--on-surface-variant, #64748b);
	}

	html[data-theme='dark'] .dashboard-quick-actions__title,
	html[data-theme='dark'] .dashboard-quick-actions__label {
		color: #e5e7eb;
	}

	html[data-theme='dark'] .dashboard-quick-actions__item {
		background: var(--surface-bright);
		border-color: var(--dashboard-card-border, transparent);
	}

	html[data-theme='dark'] .dashboard-quick-actions__item:hover {
		border-color: color-mix(in srgb, var(--primary) 36%, var(--shell-border));
	}

	html[data-theme='dark'] .dashboard-quick-actions__icon {
		background: color-mix(in srgb, var(--primary) 16%, #1f2126);
	}

	@media (max-width: 640px) {
		.dashboard-quick-actions__item {
			min-height: 5.35rem;
			padding: 0.75rem 0.7rem 0.7rem;
			gap: 0.55rem;
		}

		.dashboard-quick-actions__label {
			font-size: 0.82rem;
		}

		.dashboard-quick-actions__hint {
			display: none;
		}

		.dashboard-quick-actions__external {
			top: 0.6rem;
			right: 0.55rem;
			font-size: 0.92rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dashboard-quick-actions__item {
			transition: none;
		}
	}
</style>
