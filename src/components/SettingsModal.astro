				.trim()
				.replace(/^\/+|\/+$/g, '');
			if (!slug) return '';
			const origin = String(this.orgHubOrigin || window.location.origin || '').replace(/\/+$/, '');
			return origin ? `${origin}/${encodeURIComponent(slug)}` : `/${encodeURIComponent(slug)}`;
