---
interface Props {
	userId: number;
	organizationId: number;
	mobilePeek?: boolean;
	desktopArt?: 'hammock' | 'analytics';
}

const { userId, organizationId, mobilePeek = true, desktopArt = 'hammock' } = Astro.props;
const storageKey = `hasel-assistant:${userId}:${organizationId}`;
const panelId = `hasel-assistant-panel-${userId}-${organizationId}`;
const desktopArtSrc = desktopArt === 'analytics'
	? '/assistant/numa-analytics-desktop.png'
	: '/assistant/numa-hammock-desktop.png';
const isAnalyticsDesktopArt = desktopArt === 'analytics';
---

<assistant-mascot
	data-assistant-mascot
	data-storage-key={storageKey}
	{...(mobilePeek ? { 'data-assistant-mobile-peek': '' } : { 'data-assistant-card-wait': '' })}
	{...(isAnalyticsDesktopArt ? { 'data-assistant-analytics': '' } : {})}
>
	<section
		id={panelId}
		class="assistant-mascot__panel"
		data-assistant-panel
		hidden
		aria-label="Asistente Hasel"
	>
		<header class="assistant-mascot__header">
			<div class="assistant-mascot__identity">
				<p>Asistente Hasel</p>
				<span data-assistant-status>Listo para ayudarte</span>
			</div>
			<div class="assistant-mascot__header-actions">
				<button type="button" class="assistant-mascot__icon-button" data-assistant-clear aria-label="Nueva conversación" title="Nueva conversación">
					<span class="material-symbols-rounded" aria-hidden="true">refresh</span>
				</button>
				<button type="button" class="assistant-mascot__icon-button" data-assistant-close aria-label="Cerrar asistente" title="Cerrar">
					<span class="material-symbols-rounded" aria-hidden="true">close</span>
				</button>
			</div>
		</header>

		<div class="assistant-mascot__messages" data-assistant-messages role="log" aria-live="polite" aria-relevant="additions text">
			<div class="assistant-mascot__empty" data-assistant-empty>
				<p>Hola, soy Numa.</p>
				<span>Preguntame por tu agenda, clientes o cómo viene el negocio.</span>
			</div>
		</div>

		<div class="assistant-mascot__error" data-assistant-error role="alert" hidden></div>
		<div class="assistant-mascot__suggestions-wrap" data-assistant-suggestions-wrap>
			<p class="assistant-mascot__suggestions-label">Podés empezar con</p>
			<div class="assistant-mascot__suggestions" data-assistant-suggestions aria-label="Preguntas sugeridas"></div>
		</div>
		<form class="assistant-mascot__composer" data-assistant-form>
			<label class="sr-only" for={`${panelId}-input`}>Escribí tu consulta para el asistente</label>
			<textarea
				id={`${panelId}-input`}
				data-assistant-input
				rows="1"
				maxlength="4000"
				placeholder="Escribí tu consulta…"
			></textarea>
			<button type="submit" class="assistant-mascot__send" data-assistant-send aria-label="Enviar consulta" title="Enviar consulta">
				<span class="material-symbols-rounded" data-assistant-send-icon aria-hidden="true">send</span>
			</button>
		</form>
		<p class="assistant-mascot__hint">Enter para enviar · Shift + Enter para una nueva línea</p>
		<div
			class="assistant-mascot__resize-handle"
			data-assistant-resize
			role="separator"
			aria-orientation="horizontal"
			aria-label="Redimensionar asistente"
			title="Arrastrá para cambiar el tamaño"
		></div>
	</section>

	<button
		type="button"
		class="assistant-mascot__launcher"
		data-assistant-launcher
		aria-controls={panelId}
		aria-expanded="false"
		aria-label="Abrir Asistente Hasel"
		title="Asistente Hasel"
	>
		<img
			class="assistant-mascot__art assistant-mascot__art--desktop"
			src={desktopArtSrc}
			width="1024"
			height="683"
			alt=""
			aria-hidden="true"
			decoding="async"
		/>
		<span class="assistant-mascot__reading assistant-mascot__art--dashboard-mobile">
			<img
				data-tail-layer
				src="/assistant/numa-tail-layer.png"
				width="1200"
				height="600"
				alt=""
				aria-hidden="true"
				decoding="async"
			/>
			<img
				data-tail-body
				src="/assistant/numa-reading-mobile-body.png"
				width="1200"
				height="600"
				alt=""
				aria-hidden="true"
				decoding="async"
			/>
		</span>
		{mobilePeek && (
			<span class="assistant-mascot__peek" data-assistant-peek data-peek-side="right">
				{Array.from({ length: 25 }, (_, index) => (
					<img
						data-peek-frame={String(index)}
						{...(index === 4 ? { 'data-peek-rest': '' } : {})}
						src={`/assistant/numa-peek-mobile-vertical-right-look-${String(index).padStart(2, '0')}.png`}
						width="512"
						height="768"
						alt=""
						aria-hidden="true"
						decoding="async"
					/>
				))}
			</span>
		)}
		<span class="sr-only">Abrir Asistente Hasel</span>
	</button>
</assistant-mascot>

<script>
	import { ASSISTANT_SUGGESTED_QUESTIONS, parseClarificationOptions } from '../lib/assistant-chat-ui';
	import type { AssistantClarificationOption } from '../lib/assistant-chat-ui';

	type MarkedParse = (
		src: string,
		options?: { async?: boolean; breaks?: boolean; gfm?: boolean }
	) => string | Promise<string>;

	let markedParse: MarkedParse | null = null;

	async function ensureMarked(): Promise<MarkedParse> {
		if (markedParse) return markedParse;
		const mod = await import('marked');
		markedParse = mod.marked.parse.bind(mod.marked) as MarkedParse;
		return markedParse;
	}

	type Role = 'user' | 'assistant';
	type AssistantSource = { domain?: string; operation?: string; scope?: string };
	type ChatMessage = {
		role: Role;
		content: string;
		sentAt: number;
		sources?: AssistantSource[];
		assumptions?: string[];
		status?: string;
		clarification?: { options: AssistantClarificationOption[] };
		clarificationResolved?: boolean;
	};

	const MAX_MESSAGES = 8;
	const MAX_HISTORY_LENGTH = 12_000;
	const ANALYTICS_COMPACT_CHART_MAX_WIDTH = 960;
	const PANEL_DEFAULT_WIDTH = 384;
	const PANEL_DEFAULT_HEIGHT = 544;
	const PANEL_ASPECT_RATIO = PANEL_DEFAULT_WIDTH / PANEL_DEFAULT_HEIGHT;
	const PANEL_MIN_WIDTH = 288;
	const PANEL_MAX_WIDTH = 560;
	const PANEL_MAX_HEIGHT = 680;
	const ALLOWED_TAGS = new Set(['a', 'blockquote', 'br', 'code', 'em', 'h1', 'h2', 'h3', 'h4', 'li', 'ol', 'p', 'pre', 'strong', 'ul']);
	const ALLOWED_PROTOCOLS = new Set(['http:', 'https:', 'mailto:', 'tel:']);

	class AssistantMascot extends HTMLElement {
		private panel: HTMLElement | null = null;
		private launcher: HTMLButtonElement | null = null;
		private messagesEl: HTMLElement | null = null;
		private input: HTMLTextAreaElement | null = null;
		private form: HTMLFormElement | null = null;
		private send: HTMLButtonElement | null = null;
		private sendIcon: HTMLElement | null = null;
		private statusEl: HTMLElement | null = null;
		private errorEl: HTMLElement | null = null;
		private suggestionsWrapEl: HTMLElement | null = null;
		private suggestionsEl: HTMLElement | null = null;
		private abort: AbortController | null = null;
		private requestAbort: AbortController | null = null;
		private confirmationCard: HTMLElement | null = null;
		private confirmationCardObserver: ResizeObserver | null = null;
		private analyticsChartObserver: ResizeObserver | null = null;
		private analyticsChartObserverTarget: HTMLElement | null = null;
		private anchorFrame = 0;
		private lookFrame = 0;
		private look = 0;
		private lookTarget = 0;
		private peekFrames: HTMLImageElement[] = [];
		private messages: ChatMessage[] = [];
		private busy = false;
		private storageKey = '';
		private panelSizeKey = '';
		private resizeHandle: HTMLElement | null = null;
		private resizeState: {
			pointerId: number;
			startX: number;
			startY: number;
			startWidth: number;
			startHeight: number;
		} | null = null;

		connectedCallback() {
			this.panel = this.querySelector('[data-assistant-panel]');
			this.launcher = this.querySelector('[data-assistant-launcher]');
			this.messagesEl = this.querySelector('[data-assistant-messages]');
			this.input = this.querySelector('[data-assistant-input]');
			this.form = this.querySelector('[data-assistant-form]');
			this.send = this.querySelector('[data-assistant-send]');
			this.sendIcon = this.querySelector('[data-assistant-send-icon]');
			this.statusEl = this.querySelector('[data-assistant-status]');
			this.errorEl = this.querySelector('[data-assistant-error]');
			this.suggestionsWrapEl = this.querySelector('[data-assistant-suggestions-wrap]');
			this.suggestionsEl = this.querySelector('[data-assistant-suggestions]');
			this.storageKey = String(this.dataset.storageKey || '').trim();
			this.panelSizeKey = `${this.storageKey}:panel-size`;
			this.resizeHandle = this.querySelector('[data-assistant-resize]');
			this.peekFrames = Array.from(this.querySelectorAll<HTMLImageElement>('[data-peek-frame]'))
				.sort((a, b) => Number(a.dataset.peekFrame) - Number(b.dataset.peekFrame));
			for (const frame of this.peekFrames) {
				if (frame.decode) void frame.decode().catch(() => undefined);
			}
			this.messages = this.readStoredMessages();
			void ensureMarked();
			void this.renderMessages();
			this.renderSuggestions();
			this.applyStoredPanelSize();

			this.abort?.abort();
			this.abort = new AbortController();
			const { signal } = this.abort;
			this.launcher?.addEventListener('click', () => this.toggle(), { signal });
			this.querySelector('[data-assistant-close]')?.addEventListener('click', () => this.close(), { signal });
			this.querySelector('[data-assistant-clear]')?.addEventListener('click', () => this.clearConversation(), { signal });
			this.form?.addEventListener('submit', (event) => {
				event.preventDefault();
				if (this.busy) this.cancelRequest();
				else void this.submitMessage();
			}, { signal });
			this.input?.addEventListener('keydown', (event) => {
				if (event.key !== 'Enter' || event.shiftKey) return;
				event.preventDefault();
				if (this.busy) this.cancelRequest();
				else void this.submitMessage();
			}, { signal });
			this.input?.addEventListener('input', () => this.resizeInput(), { signal });
			this.suggestionsEl?.addEventListener('click', (event) => {
				const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-assistant-suggestion]');
				if (button) this.handleSuggestedQuestion(button);
			}, { signal });
			this.messagesEl?.addEventListener('click', (event) => {
				const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-assistant-clarification]');
				if (button) this.handleClarificationChoice(button);
			}, { signal });
			document.addEventListener('keydown', this.handleDocumentKeydown, { signal });
			document.addEventListener('pointerdown', this.handleOutsidePointer, { signal });
			document.addEventListener('submit', this.handleLogout, { capture: true, signal });
			this.resizeHandle?.addEventListener('pointerdown', this.handleResizePointerDown, { signal });
			this.resizeHandle?.addEventListener('pointermove', this.handleResizePointerMove, { signal });
			this.resizeHandle?.addEventListener('pointerup', this.finishResize, { signal });
			this.resizeHandle?.addEventListener('pointercancel', this.finishResize, { signal });
			this.resizeHandle?.addEventListener('dblclick', () => this.resetPanelSize(), { signal });
			window.addEventListener('resize', this.scheduleMobileAnchor, { signal });
			window.addEventListener('resize', this.handlePanelViewportResize, { signal });
			document.addEventListener('scroll', this.scheduleMobileAnchor, { capture: true, passive: true, signal });
			document.addEventListener('astro:page-load', this.scheduleMobileAnchor, { signal });
			this.syncMobileAnchor();
			this.scheduleMobileAnchor();
		}

		disconnectedCallback() {
			this.requestAbort?.abort();
			this.abort?.abort();
			this.confirmationCardObserver?.disconnect();
			this.analyticsChartObserver?.disconnect();
			if (this.anchorFrame) window.cancelAnimationFrame(this.anchorFrame);
			if (this.lookFrame) window.cancelAnimationFrame(this.lookFrame);
			this.abort = null;
		}

		private scheduleMobileAnchor = () => {
			if (this.anchorFrame) return;
			this.anchorFrame = window.requestAnimationFrame(() => {
				this.anchorFrame = 0;
				this.syncMobileAnchor();
			});
		};

		private prefersReducedMotion() {
			return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		}

		private syncAnalyticsCompactMode() {
			if (!this.hasAttribute('data-assistant-analytics')) return false;
			const chart = document.querySelector<HTMLElement>('[data-assistant-analytics-chart]');
			if (!chart) {
				this.analyticsChartObserver?.disconnect();
				this.analyticsChartObserver = null;
				this.analyticsChartObserverTarget = null;
				this.removeAttribute('data-assistant-analytics-compact');
				return false;
			}

			if (this.analyticsChartObserverTarget !== chart) {
				this.analyticsChartObserver?.disconnect();
				this.analyticsChartObserverTarget = chart;
				this.analyticsChartObserver = new ResizeObserver(this.scheduleMobileAnchor);
				this.analyticsChartObserver.observe(chart);
			}

			const isCompact = chart.getBoundingClientRect().width <= ANALYTICS_COMPACT_CHART_MAX_WIDTH;
			this.toggleAttribute('data-assistant-analytics-compact', isCompact);
			return isCompact;
		}

		private isMobilePeekActive() {
			return this.hasAttribute('data-assistant-mobile-peek') && (
				window.matchMedia('(max-width: 1023px)').matches ||
				this.hasAttribute('data-assistant-analytics-compact')
			);
		}

		private getScrollMetrics() {
			const scroller = document.querySelector<HTMLElement>('.app-shell > :last-child');
			if (scroller && scroller.scrollHeight > scroller.clientHeight + 4) {
				return { y: scroller.scrollTop, max: Math.max(1, scroller.scrollHeight - scroller.clientHeight) };
			}
			const el = document.scrollingElement || document.documentElement;
			return { y: el.scrollTop, max: Math.max(1, el.scrollHeight - window.innerHeight) };
		}

		private restFrameIndex() {
			const rest = this.peekFrames.findIndex((frame) => frame.hasAttribute('data-peek-rest'));
			return rest >= 0 ? rest : 0;
		}

		private frameIndexForLook(look: number) {
			const rest = this.restFrameIndex();
			const last = Math.max(rest, this.peekFrames.length - 1);
			if (look <= 0) return rest + look * rest;
			return rest + look * (last - rest);
		}

		private applyLookFrames() {
			const frames = this.peekFrames;
			if (!frames.length) return;
			const index = Math.min(
				frames.length - 1,
				Math.max(0, Math.round(this.frameIndexForLook(this.look))),
			);
			for (let i = 0; i < frames.length; i++) {
				const on = i === index;
				frames[i].style.opacity = on ? '1' : '0';
				frames[i].style.visibility = on ? 'visible' : 'hidden';
			}
		}

		private scheduleLookTick() {
			if (this.lookFrame) return;
			this.lookFrame = window.requestAnimationFrame(() => {
				this.lookFrame = 0;
				this.look = this.lookTarget;
				this.style.setProperty('--numa-look', this.look.toFixed(3));
				this.applyLookFrames();
			});
		}

		private syncPeekLook() {
			if (!this.isMobilePeekActive() || this.prefersReducedMotion()) {
				this.look = 0;
				this.lookTarget = 0;
				this.style.setProperty('--numa-look', '0');
				this.applyLookFrames();
				return;
			}

			const { y, max } = this.getScrollMetrics();
			this.lookTarget = Math.min(1, y / Math.min(max, 620));
			this.scheduleLookTick();
		}

		private syncMobileAnchor() {
			this.syncAnalyticsCompactMode();
			this.syncPeekLook();
			const isMobile = window.matchMedia('(max-width: 1023px)').matches;
			if (this.isMobilePeekActive()) {
				this.removeAttribute('data-assistant-card-anchor');
				this.style.removeProperty('--assistant-mobile-width');
				this.style.removeProperty('--assistant-mobile-right');
				this.style.removeProperty('--assistant-mobile-bottom');
				this.style.removeProperty('--assistant-desktop-width');
				this.style.removeProperty('--assistant-desktop-right');
				this.style.removeProperty('--assistant-desktop-top');
				return;
			}

			const card = document.querySelector<HTMLElement>('[data-assistant-confirmation-card]');
			const analyticsChart = this.hasAttribute('data-assistant-analytics')
				? document.querySelector<HTMLElement>('[data-assistant-analytics-chart]')
				: null;
			const anchor = card ?? analyticsChart;
			if (!anchor) {
				this.confirmationCardObserver?.disconnect();
				this.confirmationCardObserver = null;
				this.confirmationCard = null;
				this.style.removeProperty('--assistant-mobile-width');
				this.style.removeProperty('--assistant-mobile-right');
				this.style.removeProperty('--assistant-mobile-bottom');
				if (isMobile) {
					this.removeAttribute('data-assistant-card-anchor');
					this.style.removeProperty('--assistant-desktop-width');
					this.style.removeProperty('--assistant-desktop-right');
					this.style.removeProperty('--assistant-desktop-top');
					return;
				}

				// En las demás páginas conservamos la misma columna que ocupa «Por confirmar»
				// en el dashboard: el segundo cuarto del canvas de contenido.
				const topBar = document.querySelector<HTMLElement>('[data-shell-topbar]');
				const canvas = topBar?.parentElement?.getBoundingClientRect();
				const width = 152;
				const center = canvas
					? canvas.left + canvas.width * 0.375
					: window.innerWidth * 0.45;
				const right = Math.max(8, window.innerWidth - center - width / 2);
				const top = this.hasAttribute('data-assistant-analytics')
					? Math.max(0, Math.round(topBar?.getBoundingClientRect().bottom || 0))
					: 0;
				this.style.setProperty('--assistant-desktop-width', `${width}px`);
				this.style.setProperty('--assistant-desktop-right', `${Math.round(right)}px`);
				this.style.setProperty('--assistant-desktop-top', `${top}px`);
				this.setAttribute('data-assistant-card-anchor', '');
				return;
			}

			if (this.confirmationCard !== anchor) {
				this.confirmationCardObserver?.disconnect();
				this.confirmationCard = anchor;
				this.confirmationCardObserver = new ResizeObserver(this.scheduleMobileAnchor);
				this.confirmationCardObserver.observe(anchor);
			}

			const bounds = anchor.getBoundingClientRect();
			if (bounds.width <= 0 || bounds.height <= 0) {
				this.removeAttribute('data-assistant-card-anchor');
				return;
			}

			if (isMobile) {
				const width = Math.min(bounds.width * 0.72, 126);
				const right = Math.max(8, window.innerWidth - bounds.right + (bounds.width - width) / 2);
				// Numa se apoya sobre la tarjeta: solapamos el borde superior sin llegar al contenido principal.
				const overlap = Math.min(18, Math.max(10, bounds.height * 0.16));
				const bottom = Math.max(8, window.innerHeight - bounds.top - overlap);
				this.style.setProperty('--assistant-mobile-width', `${Math.round(width)}px`);
				this.style.setProperty('--assistant-mobile-right', `${Math.round(right)}px`);
				this.style.setProperty('--assistant-mobile-bottom', `${Math.round(bottom)}px`);
				this.style.removeProperty('--assistant-desktop-width');
				this.style.removeProperty('--assistant-desktop-right');
				this.style.removeProperty('--assistant-desktop-top');
			} else {
				const isAnalyticsAnchor = anchor === analyticsChart;
				const width = isAnalyticsAnchor
					? Math.min(Math.max(bounds.width * 0.18, 144), 184)
					: Math.min(bounds.width * 0.48, 152);
				const right = isAnalyticsAnchor
					? Math.max(8, window.innerWidth - bounds.right + Math.min(56, Math.max(24, bounds.width * 0.04)))
					: Math.max(8, window.innerWidth - bounds.right + (bounds.width - width) / 2);
				const top = isAnalyticsAnchor
					? Math.max(0, Math.round(bounds.top - width * 0.56))
					: 0;
				this.style.setProperty('--assistant-desktop-width', `${Math.round(width)}px`);
				this.style.setProperty('--assistant-desktop-right', `${Math.round(right)}px`);
				this.style.setProperty('--assistant-desktop-top', `${top}px`);
				this.style.removeProperty('--assistant-mobile-width');
				this.style.removeProperty('--assistant-mobile-right');
				this.style.removeProperty('--assistant-mobile-bottom');
			}
			this.setAttribute('data-assistant-card-anchor', '');
		}

		private handleDocumentKeydown = (event: KeyboardEvent) => {
			if (event.key !== 'Escape' || !this.isOpen()) return;
			event.preventDefault();
			if (this.busy) this.cancelRequest();
			this.close();
		};

		private handleOutsidePointer = (event: PointerEvent) => {
			if (this.resizeState || !this.isOpen() || this.contains(event.target as Node)) return;
			this.close();
		};

		private getPanelSizeLimits() {
			const horizontalInset = window.matchMedia('(max-width: 639px)').matches ? 24 : 32;
			const verticalInset = window.matchMedia('(max-width: 639px)').matches ? 120 : 100;
			return {
				maxWidth: Math.min(PANEL_MAX_WIDTH, window.innerWidth - horizontalInset),
				maxHeight: Math.min(PANEL_MAX_HEIGHT, window.innerHeight - verticalInset),
			};
		}

		private clampPanelSize(width: number) {
			const { maxWidth, maxHeight } = this.getPanelSizeLimits();
			let nextWidth = Math.max(PANEL_MIN_WIDTH, Math.min(width, maxWidth));
			let nextHeight = nextWidth / PANEL_ASPECT_RATIO;
			if (nextHeight > maxHeight) {
				nextHeight = maxHeight;
				nextWidth = nextHeight * PANEL_ASPECT_RATIO;
			}
			return {
				width: Math.round(nextWidth),
				height: Math.round(nextHeight),
			};
		}

		private applyPanelSize(width: number, height: number) {
			if (!this.panel) return;
			this.panel.style.width = `${width}px`;
			this.panel.style.height = `${height}px`;
			this.panel.dataset.resized = 'true';
		}

		private readStoredPanelSize() {
			if (!this.panelSizeKey) return null;
			try {
				const raw = window.localStorage.getItem(this.panelSizeKey);
				if (!raw) return null;
				const payload = JSON.parse(raw) as { width?: number; height?: number };
				const width = Number(payload.width);
				const height = Number(payload.height);
				if (!Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0) return null;
				return this.clampPanelSize(width);
			} catch {
				return null;
			}
		}

		private persistPanelSize() {
			if (!this.panel || !this.panelSizeKey || this.panel.dataset.resized !== 'true') return;
			const rect = this.panel.getBoundingClientRect();
			window.localStorage.setItem(
				this.panelSizeKey,
				JSON.stringify({ width: Math.round(rect.width), height: Math.round(rect.height) })
			);
		}

		private applyStoredPanelSize() {
			const stored = this.readStoredPanelSize();
			if (!stored) return;
			this.applyPanelSize(stored.width, stored.height);
		}

		private resetPanelSize() {
			if (!this.panel) return;
			this.panel.style.removeProperty('width');
			this.panel.style.removeProperty('height');
			delete this.panel.dataset.resized;
			if (this.panelSizeKey) window.localStorage.removeItem(this.panelSizeKey);
		}

		private handlePanelViewportResize = () => {
			if (!this.panel || this.panel.dataset.resized !== 'true') return;
			const rect = this.panel.getBoundingClientRect();
			const { width, height } = this.clampPanelSize(rect.width);
			this.applyPanelSize(width, height);
			this.persistPanelSize();
		};

		private handleResizePointerDown = (event: PointerEvent) => {
			if (!this.panel || !this.resizeHandle || event.button !== 0) return;
			event.preventDefault();
			event.stopPropagation();
			const rect = this.panel.getBoundingClientRect();
			this.resizeState = {
				pointerId: event.pointerId,
				startX: event.clientX,
				startY: event.clientY,
				startWidth: rect.width,
				startHeight: rect.height,
			};
			this.resizeHandle.setPointerCapture(event.pointerId);
			this.setAttribute('data-assistant-resizing', '');
		};

		private handleResizePointerMove = (event: PointerEvent) => {
			if (!this.panel || !this.resizeState || event.pointerId !== this.resizeState.pointerId) return;
			const deltaX = this.resizeState.startX - event.clientX;
			const deltaY = event.clientY - this.resizeState.startY;
			const scale = Math.max(
				(this.resizeState.startWidth + deltaX) / this.resizeState.startWidth,
				(this.resizeState.startHeight + deltaY) / this.resizeState.startHeight
			);
			const { width, height } = this.clampPanelSize(this.resizeState.startWidth * scale);
			this.applyPanelSize(width, height);
		};

		private finishResize = (event: PointerEvent) => {
			if (!this.resizeState || event.pointerId !== this.resizeState.pointerId) return;
			this.resizeHandle?.releasePointerCapture(event.pointerId);
			this.resizeState = null;
			this.removeAttribute('data-assistant-resizing');
			this.persistPanelSize();
		};

		private handleLogout = (event: Event) => {
			const form = event.target instanceof HTMLFormElement ? event.target : null;
			if (form?.action.endsWith('/api/auth/logout')) this.removeStoredMessages();
		};

		private isOpen() {
			return Boolean(this.panel && !this.panel.hidden);
		}

		private toggle() {
			if (this.isOpen()) this.close();
			else this.open();
		}

		private open() {
			if (!this.panel || !this.launcher) return;
			this.panel.hidden = false;
			this.launcher.setAttribute('aria-expanded', 'true');
			this.clearError();
			this.react();
			window.requestAnimationFrame(() => this.panel?.classList.add('is-open'));
			if (!window.matchMedia('(max-width: 639px)').matches) {
				window.setTimeout(() => this.input?.focus({ preventScroll: true }), 120);
			}
		}

		private close() {
			if (!this.panel || !this.launcher || !this.isOpen()) return;
			this.panel.classList.remove('is-open');
			this.launcher.setAttribute('aria-expanded', 'false');
			window.setTimeout(() => {
				if (this.panel && !this.panel.classList.contains('is-open')) this.panel.hidden = true;
			}, 150);
			this.launcher.focus({ preventScroll: true });
		}

		private resizeInput() {
			if (!this.input) return;
			this.input.style.height = 'auto';
			this.input.style.height = `${Math.min(this.input.scrollHeight, 116)}px`;
		}

		private setBusy(next: boolean) {
			this.busy = next;
			this.toggleAttribute('data-assistant-busy', next);
			if (this.input) this.input.disabled = next;
			if (this.send) {
				this.send.setAttribute('aria-label', next ? 'Cancelar consulta' : 'Enviar consulta');
				this.send.title = next ? 'Cancelar consulta' : 'Enviar consulta';
			}
			if (this.sendIcon) this.sendIcon.textContent = next ? 'close' : 'send';
			this.updateSuggestionsVisibility();
			if (next) this.setStatus('Consultando información permitida…');
			else this.setStatus(this.lastUnresolvedClarification() ? 'Necesito un dato más' : 'Listo para ayudarte');
			if (next) this.renderThinking();
			else this.messagesEl?.querySelector('[data-assistant-thinking]')?.remove();
		}

		private setStatus(message: string) {
			if (this.statusEl) this.statusEl.textContent = message;
		}

		private react() {
			this.setAttribute('data-assistant-reacting', '');
			window.setTimeout(() => this.removeAttribute('data-assistant-reacting'), 580);
		}

		private renderThinking() {
			if (!this.messagesEl || this.messagesEl.querySelector('[data-assistant-thinking]')) return;
			const row = document.createElement('div');
			row.className = 'assistant-mascot__message assistant-mascot__message--assistant';
			row.dataset.assistantThinking = 'true';
			row.setAttribute('aria-busy', 'true');
			row.innerHTML = `<span class="assistant-mascot__thinking"><span></span><span></span><span></span></span>`;
			this.messagesEl.append(row);
			this.scrollMessages();
		}

		private cancelRequest() {
			if (!this.busy) return;
			this.requestAbort?.abort();
			this.setBusy(false);
			this.setStatus('Consulta cancelada');
		}

		private clearConversation() {
			if (this.busy) this.cancelRequest();
			this.messages = [];
			this.removeStoredMessages();
			this.clearError();
			void this.renderMessages();
			this.setStatus('Nueva conversación');
			this.input?.focus({ preventScroll: true });
		}

		private readStoredMessages(): ChatMessage[] {
			if (!this.storageKey) return [];
			try {
				const parsed = JSON.parse(sessionStorage.getItem(this.storageKey) || 'null');
				if (!Array.isArray(parsed)) return [];
				return this.trimMessages(parsed.flatMap((message): ChatMessage[] => {
					if (!message || typeof message !== 'object') return [];
					const raw = message as Record<string, unknown>;
					const role = raw.role === 'assistant' ? 'assistant' : raw.role === 'user' ? 'user' : null;
					const content = String(raw.content || '').trim();
					if (!role || !content) return [];
					const clarificationOptions = parseClarificationOptions(raw.clarification);
					return [{
						role,
						content,
						sentAt: Number(raw.sentAt) || Date.now(),
						sources: Array.isArray(raw.sources) ? raw.sources : [],
						assumptions: Array.isArray(raw.assumptions) ? raw.assumptions.map(String) : [],
						status: String(raw.status || ''),
						clarification: clarificationOptions.length ? { options: clarificationOptions } : undefined,
						clarificationResolved: raw.clarificationResolved === true,
					}];
				}));
			} catch {
				return [];
			}
		}

		private trimMessages(messages: ChatMessage[]) {
			const trimmed = messages.slice(-MAX_MESSAGES);
			while (trimmed.length && trimmed.reduce((total, message) => total + Array.from(message.content).length, 0) > MAX_HISTORY_LENGTH) {
				trimmed.shift();
			}
			return trimmed;
		}

		private persistMessages() {
			if (!this.storageKey) return;
			this.messages = this.trimMessages(this.messages);
			try {
				sessionStorage.setItem(this.storageKey, JSON.stringify(this.messages));
			} catch {
				/* sessionStorage puede no estar disponible en navegación privada */
			}
		}

		private removeStoredMessages() {
			if (!this.storageKey) return;
			try {
				sessionStorage.removeItem(this.storageKey);
			} catch {
				/* ignore */
			}
		}

		private clearError() {
			if (!this.errorEl) return;
			this.errorEl.hidden = true;
			this.errorEl.textContent = '';
		}

		private showError(message: string) {
			if (!this.errorEl) return;
			this.errorEl.textContent = message;
			this.errorEl.hidden = false;
		}

		private userMessageForAgent(message: ChatMessage): { role: Role; content: string } {
			return { role: message.role, content: message.content };
		}

		private handleSuggestedQuestion(button: HTMLButtonElement) {
			const message = String(button.dataset.assistantSuggestion || '').trim();
			if (!message || this.busy) return;
			void this.submitMessage(message);
		}

		private handleClarificationChoice(button: HTMLButtonElement) {
			const message = String(button.dataset.assistantClarification || '').trim();
			if (!message || this.busy) return;
			this.resolvePendingClarification();
			this.persistMessages();
			void this.submitMessage(message);
		}

		private lastUnresolvedClarification(): ChatMessage | null {
			for (let index = this.messages.length - 1; index >= 0; index -= 1) {
				const message = this.messages[index];
				if (
					message.role === 'assistant' &&
					message.status === 'needs_clarification' &&
					!message.clarificationResolved &&
					parseClarificationOptions(message.clarification).length >= 2
				) {
					return message;
				}
			}
			return null;
		}

		private resolvePendingClarification() {
			const pending = this.lastUnresolvedClarification();
			if (pending) pending.clarificationResolved = true;
		}

		private renderSuggestions() {
			if (!this.suggestionsEl) return;
			this.suggestionsEl.replaceChildren();
			const fragment = document.createDocumentFragment();
			for (const [index, suggestion] of ASSISTANT_SUGGESTED_QUESTIONS.entries()) {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'assistant-mascot__suggestion-btn';
				button.style.setProperty('--chip-index', String(index));
				button.dataset.assistantSuggestion = suggestion.message;
				button.setAttribute('aria-label', suggestion.label);
				button.title = suggestion.label;
				button.disabled = this.busy;

				const iconWrap = document.createElement('span');
				iconWrap.className = 'assistant-mascot__suggestion-btn__icon';
				iconWrap.setAttribute('aria-hidden', 'true');
				const icon = document.createElement('span');
				icon.className = 'material-symbols-rounded';
				icon.textContent = suggestion.icon;
				iconWrap.append(icon);

				const label = document.createElement('span');
				label.className = 'assistant-mascot__suggestion-btn__label';
				label.textContent = suggestion.label;

				button.append(iconWrap, label);
				fragment.append(button);
			}
			this.suggestionsEl.append(fragment);
			this.updateSuggestionsVisibility();
		}

		private updateSuggestionsVisibility() {
			if (!this.suggestionsWrapEl) return;
			const show = this.messages.length === 0 && !this.busy;
			this.suggestionsWrapEl.classList.toggle('hidden', !show);
			this.suggestionsEl?.querySelectorAll<HTMLButtonElement>('[data-assistant-suggestion]').forEach((button) => {
				button.disabled = this.busy;
			});
		}

		private async submitMessage(override?: string) {
			const query = (override ?? this.input?.value.trim() ?? '').trim();
			if (!query || this.busy) return;
			this.clearError();
			this.resolvePendingClarification();
			const history = this.trimMessages(this.messages).map((message) => this.userMessageForAgent(message));
			this.messages.push({ role: 'user', content: query, sentAt: Date.now() });
			this.persistMessages();
			this.input!.value = '';
			this.resizeInput();
			void this.renderMessages();
			this.requestAbort?.abort();
			this.requestAbort = new AbortController();
			this.setBusy(true);

			try {
				const response = await fetch('/api/assistant/query', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'text/event-stream' },
					body: JSON.stringify({ query, messages: history, locale: 'es-PY' }),
					signal: this.requestAbort.signal,
				});
				if (!response.ok) throw new Error(await this.readError(response));
				await this.consumeStream(response);
			} catch (error) {
				if (this.requestAbort?.signal.aborted) return;
				this.showError(error instanceof Error ? error.message : 'No fue posible obtener una respuesta.');
			} finally {
				if (!this.requestAbort?.signal.aborted) this.setBusy(false);
				this.requestAbort = null;
				if (!window.matchMedia('(max-width: 639px)').matches && this.isOpen()) {
					this.input?.focus({ preventScroll: true });
				}
			}
		}

		private async readError(response: Response) {
			const payload = await response.json().catch(() => null) as { message?: string } | null;
			if (response.status === 401) return 'Tu sesión venció. Volvé a iniciar sesión para continuar.';
			if (response.status === 403) return 'El asistente no está habilitado para este usuario u organización.';
			if (response.status === 504) return 'El asistente tardó demasiado. Probá nuevamente.';
			return String(payload?.message || 'El asistente no está disponible en este momento.');
		}

		private async consumeStream(response: Response) {
			if (!response.body) throw new Error('El asistente no devolvió una respuesta.');
			const reader = response.body.getReader();
			const decoder = new TextDecoder();
			let buffer = '';
			let answer = '';
			let completed = false;

			const consumeBlock = (block: string) => {
				const lines = block.split('\n');
				const event = lines.find((line) => line.startsWith('event:'))?.slice(6).trim() || 'message';
				const data = lines.filter((line) => line.startsWith('data:')).map((line) => line.slice(5).trim()).join('\n');
				if (!data) return;
				const payload = JSON.parse(data) as Record<string, unknown>;
				if (event === 'progress') {
					this.setStatus(String(payload.message || 'Consultando información permitida…'));
					return;
				}
				if (event === 'delta') {
					answer += String(payload.text || '');
					return;
				}
				if (event === 'error') {
					const failure = payload.error as Record<string, unknown> | undefined;
					throw new Error(String(failure?.message || 'El asistente no pudo completar la consulta.'));
				}
				if (event === 'done') {
					const finalAnswer = String(payload.answer || answer).trim();
					if (!finalAnswer) throw new Error('El asistente devolvió una respuesta vacía.');
					const clarificationOptions = parseClarificationOptions(payload.clarification);
					this.messages.push({
						role: 'assistant',
						content: finalAnswer,
						sentAt: Date.now(),
						sources: Array.isArray(payload.sources) ? payload.sources as AssistantSource[] : [],
						assumptions: Array.isArray(payload.assumptions) ? payload.assumptions.map(String) : [],
						status: String(payload.status || 'completed'),
						clarification: clarificationOptions.length ? { options: clarificationOptions } : undefined,
					});
					this.persistMessages();
					void this.renderMessages();
					window.setTimeout(() => this.react());
					completed = true;
				}
			};

			while (true) {
				const { done, value } = await reader.read();
				buffer += decoder.decode(value || new Uint8Array(), { stream: !done }).replace(/\r\n/g, '\n');
				let boundary = buffer.indexOf('\n\n');
				while (boundary >= 0) {
					consumeBlock(buffer.slice(0, boundary));
					buffer = buffer.slice(boundary + 2);
					boundary = buffer.indexOf('\n\n');
				}
				if (done) break;
			}
			if (buffer.trim()) consumeBlock(buffer);
			if (!completed) throw new Error('La respuesta del asistente se interrumpió. Probá nuevamente.');
		}

		private isSafeUrl(value: string) {
			try {
				return ALLOWED_PROTOCOLS.has(new URL(value, window.location.origin).protocol);
			} catch {
				return false;
			}
		}

		private isMarkdownListItem(line: string) {
			return /^([-*+]|\d+[.)])\s+/.test(line);
		}

		private lineEndsWithColon(line: string) {
			return line.length >= 3 && /:(?:\*\*)?\s*$/.test(line);
		}

		private isMarkdownSectionLead(line: string) {
			return (
				/^#{1,6}\s/.test(line) ||
				/^\*\*[^*]{1,80}:\*\*\s*$/.test(line) ||
				/^\*\*[^*]{1,80}\*\*:\s*$/.test(line)
			);
		}

		private promoteColonBlocksToLists(text: string) {
			const lines = text.split('\n');
			const out: string[] = [];
			let i = 0;

			while (i < lines.length) {
				const line = lines[i];
				const trimmed = line.trim();
				if (this.lineEndsWithColon(trimmed)) {
					let j = i + 1;
					if (j < lines.length && !lines[j].trim()) j += 1;

					const items: string[] = [];
					while (j < lines.length) {
						const item = lines[j].trim();
						if (!item) break;
						if (this.isMarkdownListItem(item) || this.isMarkdownSectionLead(item)) break;
						if (item.length > 180) break;
						items.push(item.replace(/^[•▪◦–—]\s+/, ''));
						j += 1;
					}

					if (items.length >= 2) {
						out.push(line);
						for (const item of items) out.push(`- ${item}`);
						i = j;
						continue;
					}
				}

				out.push(line);
				i += 1;
			}

			return out.join('\n');
		}

		private repairMarkdown(text: string) {
			const fixLine = (line: string) => {
				let fixed = line.replace(/\*{3,}/g, '**');
				const markers = fixed.match(/\*\*/g);
				if (markers && markers.length % 2 === 1) fixed += '**';
				fixed = fixed.replace(/\*\*([^*\n]*?)\*\*/g, (_, inner: string) => {
					const trimmed = inner.trim();
					return trimmed ? `**${trimmed}**` : '**';
				});
				return fixed;
			};
			return text.split('\n').map(fixLine).join('\n');
		}

		private stripInternalPhrases(text: string) {
			return text
				.replace(/\s*la consulta no (?:permite|puede)[^.!?\n]*[.!?]?/gi, '')
				.replace(/\s*no (?:puedo|podemos|puede|es posible) filtrar[^.!?\n]*[.!?]?/gi, '')
				.replace(/\s*esta consulta no[^.!?\n]*[.!?]?/gi, '')
				.replace(/\s*el sistema no (?:permite|puede)[^.!?\n]*[.!?]?/gi, '')
				.trim();
		}

		private normalizeAssistantMarkdown(content: string) {
			let text = this.stripInternalPhrases(String(content || '').trim());
			if (!text) return '';

			if (/\d+[.)]\s+/.test(text) && !/^\s*\d+[.)]\s+/m.test(text.split('\n').slice(1).join('\n'))) {
				text = text.replace(/(?:^|[ \t]+)(\d+)[.)]\s+/g, '\n$1. ');
			}

			if (/(?:^|\s)-\s+\S/.test(text) && !/^\s*[-*]\s+/m.test(text)) {
				text = text.replace(/(?:^|[ \t]+)[-*]\s+/g, '\n- ');
			}

			text = this.promoteColonBlocksToLists(text);
			text = this.repairMarkdown(text);

			return text
				.replace(/\n{3,}/g, '\n\n')
				.replace(/(^#{1,6}[^\n]+)\n{2,}/gm, '$1\n')
				.replace(/([^\n])\n{2,}(?=[-*+] |\d+\. )/g, '$1\n')
				.trim();
		}

		private sanitizeMarkdown(html: string) {
			const template = document.createElement('template');
			template.innerHTML = html;
			const walker = document.createTreeWalker(template.content, NodeFilter.SHOW_ELEMENT);
			const elements: Element[] = [];
			while (walker.nextNode()) elements.push(walker.currentNode as Element);
			for (const element of elements) {
				const tag = element.tagName.toLowerCase();
				if (!ALLOWED_TAGS.has(tag)) {
					element.replaceWith(...Array.from(element.childNodes));
					continue;
				}
				const href = element.getAttribute('href') || '';
				for (const attribute of Array.from(element.attributes)) element.removeAttribute(attribute.name);
				if (tag === 'a' && this.isSafeUrl(href)) {
					element.setAttribute('href', href);
					element.setAttribute('target', '_blank');
					element.setAttribute('rel', 'noreferrer');
				}
			}
			return template.innerHTML;
		}

		private escapePlain(content: string) {
			return content
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/\n/g, '<br>');
		}

		private async renderMarkdown(content: string) {
			const normalized = this.normalizeAssistantMarkdown(content);
			try {
				const parse = await ensureMarked();
				const html = parse(normalized, { async: false, gfm: true, breaks: false });
				return this.sanitizeMarkdown(typeof html === 'string' ? html : String(html));
			} catch {
				return this.escapePlain(normalized);
			}
		}

		private createMetadata(_message: ChatMessage) {
			return null;
		}

		private async renderMessages() {
			if (!this.messagesEl) return;
			this.messagesEl.replaceChildren();
			if (!this.messages.length) {
				const empty = document.createElement('div');
				empty.className = 'assistant-mascot__empty';
				empty.innerHTML = '<p>Hola, soy Numa.</p><span>Preguntame por tu agenda, clientes o cómo viene el negocio.</span>';
				this.messagesEl.append(empty);
				return;
			}
			for (const [index, message] of this.messages.entries()) {
				const row = document.createElement('article');
				row.className = `assistant-mascot__message assistant-mascot__message--${message.role}`;
				const bubble = document.createElement('div');
				bubble.className = 'assistant-mascot__bubble';
				if (message.role === 'assistant') {
					const body = document.createElement('div');
					body.className = 'assistant-mascot__bubble__body';
					body.innerHTML = await this.renderMarkdown(message.content);
					bubble.append(body);
				} else {
					bubble.textContent = message.content;
				}
				row.append(bubble);
				const metadata = this.createMetadata(message);
				if (metadata) row.append(metadata);
				const isLast = index === this.messages.length - 1;
				if (
					isLast &&
					message.role === 'assistant' &&
					message.status === 'needs_clarification' &&
					!message.clarificationResolved
				) {
					const options = parseClarificationOptions(message.clarification);
					if (options.length >= 2) {
						const group = document.createElement('div');
						group.className = 'assistant-mascot__clarification';
						group.setAttribute('role', 'group');
						group.setAttribute('aria-label', 'Elegí una opción');
						for (const [chipIndex, option] of options.entries()) {
							const button = document.createElement('button');
							button.type = 'button';
							button.className = 'assistant-mascot__suggestion-btn assistant-mascot__clarification-btn';
							button.style.setProperty('--chip-index', String(chipIndex));
							button.dataset.assistantClarification = option.value;
							button.setAttribute('aria-label', option.label);
							button.disabled = this.busy;
							const label = document.createElement('span');
							label.className = 'assistant-mascot__suggestion-btn__label';
							label.textContent = option.label;
							button.append(label);
							group.append(button);
						}
						row.append(group);
					}
				}
				this.messagesEl.append(row);
			}
			this.updateSuggestionsVisibility();
			this.scrollMessages();
		}

		private scrollMessages() {
			if (!this.messagesEl) return;
			this.messagesEl.scrollTop = this.messagesEl.scrollHeight;
		}
	}

	if (!customElements.get('assistant-mascot')) customElements.define('assistant-mascot', AssistantMascot);
</script>

<style is:global>
	assistant-mascot {
		--numa-look: 0;
		position: fixed;
		top: 0;
		right: clamp(7.5rem, 12vw, 12.5rem);
		z-index: var(--z-mascot, 95);
		display: block;
