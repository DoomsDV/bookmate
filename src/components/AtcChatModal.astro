---
interface Props {
	userName?: string;
}

const { userName = '' } = Astro.props;
const userInitials = String(userName || '')
	.trim()
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((part) => part.charAt(0))
	.join('')
	.toUpperCase();
---

<atc-chat-modal data-user-initials={userInitials || 'TÚ'}>
	<dialog
		data-atc-chat-modal
		class="m-0 mt-auto mb-0 h-[90svh] w-screen max-w-none open:flex open:flex-col overflow-hidden rounded-t-[1.8rem] rounded-b-none border border-(--shell-border) bg-(--surface-bright) p-0 text-(--on-surface) shadow-[0_24px_80px_rgba(0,0,0,0.2)] sm:m-auto sm:h-[min(36rem,90vh)] sm:w-[min(32rem,calc(100vw-2rem))] sm:max-w-[min(32rem,calc(100vw-2rem))] sm:rounded-[1.8rem] lg:m-0 lg:ml-auto lg:mr-0 lg:mt-0 lg:mb-0 lg:h-[100dvh] lg:max-h-[100dvh] lg:w-[min(32rem,100%)] lg:max-w-[min(32rem,100%)] lg:rounded-none lg:border-y-0 lg:border-r-0 lg:shadow-none"
	>
		<header class="flex shrink-0 items-start justify-between gap-3 border-b border-(--shell-border) px-4 py-3 sm:px-5 sm:py-4">
			<div class="flex min-w-0 items-center gap-3">
				<div class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-(--primary-soft) text-(--primary)">
					<span class="material-symbols-rounded text-[1.35rem]">support_agent</span>
				</div>
				<div class="min-w-0">
					<h2 class="text-[1.05rem] font-extrabold tracking-tight text-(--on-surface)">Atención al cliente</h2>
					<p class="truncate text-[0.82rem] font-medium text-(--on-surface-variant)">
						Preguntas sobre Hasel
					</p>
				</div>
			</div>
			<button
				type="button"
				class="flex size-10 shrink-0 items-center justify-center rounded-full border border-(--shell-border) text-(--on-surface-variant) transition hover:bg-(--control-surface)"
				data-atc-chat-close
				aria-label="Cerrar atención al cliente"
			>
				<span class="material-symbols-rounded text-[1.2rem]">close</span>
			</button>
		</header>

		<div class="min-h-0 flex-1 overflow-y-auto px-4 py-4 sm:px-5" data-atc-chat-messages>
			<div class="atc-chat-message atc-chat-message--assistant" data-atc-chat-welcome>
				<span class="atc-chat-avatar atc-chat-avatar--assistant" aria-hidden="true">
					<img src="/icons/icon-192x192.png" alt="" width="28" height="28" />
				</span>
				<div class="atc-chat-welcome">
					¡Hola! ¿En qué puedo ayudarte con Hasel hoy?
				</div>
			</div>
		</div>

		<div class="hidden shrink-0 px-4 pb-2 text-sm text-red-600 sm:px-5" data-atc-chat-error></div>

		<div class="atc-chat-composer shrink-0 border-t border-(--shell-border)">
			<div class="atc-chat-suggestions-wrap" data-atc-chat-suggestions-wrap>
				<p class="atc-chat-suggestions-label">Podés empezar con</p>
				<div class="atc-chat-suggestions" data-atc-chat-suggestions aria-label="Preguntas sugeridas"></div>
			</div>

			<form class="px-3 py-3 sm:px-4" data-atc-chat-form>
			<div class="flex items-end gap-2">
				<textarea
					rows="1"
					class="max-h-28 min-h-11 w-full resize-none rounded-2xl border border-(--shell-border) bg-(--control-surface) px-3.5 py-2.5 text-sm text-(--on-surface) outline-none transition placeholder:text-(--on-surface-variant)/70 focus:border-(--primary) focus:ring-2 focus:ring-(--primary)/20"
					placeholder="Escribí tu pregunta..."
					data-atc-chat-input
					autocomplete="off"
				></textarea>
				<button
					type="submit"
					class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-(--primary) text-(--on-primary) transition hover:opacity-90 disabled:opacity-50"
					data-atc-chat-send
					aria-label="Enviar pregunta"
				>
					<span class="material-symbols-rounded text-[1.25rem]">arrow_upward</span>
				</button>
			</div>
			</form>
		</div>
	</dialog>
</atc-chat-modal>

<script>
	import { BUSINESS_HOURS_TIME_ZONE } from '../lib/business-hours';
	import { ATC_CHAT_SUGGESTED_QUESTIONS } from '../lib/atc-chat-ui';
	import {
		getLayoutViewportHeight,
		lockPanelScroll,
		restorePanelScrollLayout,
	} from '../lib/panel-scroll-lock';

	type AtcRole = 'user' | 'assistant';

	type AtcMessage = {
		role: AtcRole;
		content: string;
		sentAt: number;
	};

	const atcTimeFormatter = new Intl.DateTimeFormat('es-PY', {
		timeZone: BUSINESS_HOURS_TIME_ZONE,
		hour: '2-digit',
		minute: '2-digit',
		hour12: false,
	});

	const atcDateFormatter = new Intl.DateTimeFormat('es-PY', {
		timeZone: BUSINESS_HOURS_TIME_ZONE,
		day: '2-digit',
		month: '2-digit',
		year: 'numeric',
	});

	const atcDayKeyFormatter = new Intl.DateTimeFormat('en-CA', {
		timeZone: BUSINESS_HOURS_TIME_ZONE,
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
	});

	const formatAtcMessageTime = (sentAt: number) => {
		const date = new Date(sentAt);
		if (Number.isNaN(date.getTime())) return '';

		const time = atcTimeFormatter.format(date);
		const isToday = atcDayKeyFormatter.format(date) === atcDayKeyFormatter.format(new Date());
		if (isToday) return time;

		return `${atcDateFormatter.format(date)} ${time}`;
	};

	type MarkedParse = (
		src: string,
		options?: { async?: boolean; breaks?: boolean; gfm?: boolean }
	) => string | Promise<string>;

	let markedParse: MarkedParse | null = null;

	async function ensureMarked(): Promise<MarkedParse> {
		if (markedParse) return markedParse;
		const mod = await import('marked');
		markedParse = mod.marked.parse.bind(mod.marked) as MarkedParse;
		return markedParse;
	}

	const ALLOWED_MARKDOWN_TAGS = new Set([
		'a',
		'blockquote',
		'br',
		'code',
		'del',
		'em',
		'h1',
		'h2',
		'h3',
		'h4',
		'h5',
		'h6',
		'hr',
		'li',
		'ol',
		'p',
		'pre',
		'strong',
		'ul',
	]);

	const ALLOWED_LINK_PROTOCOLS = new Set(['http:', 'https:', 'mailto:', 'tel:']);

	class AtcChatModal extends HTMLElement {
		private modal: HTMLDialogElement | null = null;
		private messagesEl: HTMLElement | null = null;
		private suggestionsWrapEl: HTMLElement | null = null;
		private suggestionsEl: HTMLElement | null = null;
		private errorEl: HTMLElement | null = null;
		private form: HTMLFormElement | null = null;
		private input: HTMLTextAreaElement | null = null;
		private sendBtn: HTMLButtonElement | null = null;
		private messages: AtcMessage[] = [];
		private busy = false;
		private abort: AbortController | null = null;
		private lockedSheetHeightPx = 0;
		private unlockCanvasScroll: (() => void) | null = null;
		private userAvatarUrl = '';
		private userInitials = 'TÚ';
		private userAvatarLoaded = false;
		private readonly botLogoUrl = '/icons/icon-192x192.png';

		connectedCallback() {
			this.modal = this.querySelector('[data-atc-chat-modal]');
			this.messagesEl = this.querySelector('[data-atc-chat-messages]');
			this.suggestionsWrapEl = this.querySelector('[data-atc-chat-suggestions-wrap]');
			this.suggestionsEl = this.querySelector('[data-atc-chat-suggestions]');
			this.errorEl = this.querySelector('[data-atc-chat-error]');
			this.form = this.querySelector('[data-atc-chat-form]');
			this.input = this.querySelector('[data-atc-chat-input]');
			this.sendBtn = this.querySelector('[data-atc-chat-send]');
			this.userInitials = String(this.dataset.userInitials || 'TÚ').trim() || 'TÚ';

			this.abort?.abort();
			this.abort = new AbortController();
			const { signal } = this.abort;

			document.addEventListener(
				'click',
				(event) => {
					const target = event.target as HTMLElement | null;
					if (target?.closest('[data-atc-button]')) {
						event.preventDefault();
						this.open();
					}
					if (target?.closest('[data-atc-chat-close]')) {
						this.close();
					}
					const suggestionButton = target?.closest<HTMLButtonElement>('[data-atc-chat-suggestion]');
					if (suggestionButton) {
						this.handleSuggestedQuestion(suggestionButton);
					}
				},
				{ signal }
			);

			this.renderSuggestedQuestions();

			this.modal?.addEventListener(
				'close',
				() => {
					this.clearMobileSheetLock();
					this.releasePanelScrollLock();
				},
				{ signal }
			);

			this.modal?.addEventListener(
				'cancel',
				(event) => {
					event.preventDefault();
					this.close();
				},
				{ signal }
			);

			this.modal?.addEventListener(
				'click',
				(event) => {
					if (event.target === this.modal) this.close();
				},
				{ signal }
			);

			this.form?.addEventListener(
				'submit',
				(event) => {
					event.preventDefault();
					void this.submitMessage();
				},
				{ signal }
			);

			this.input?.addEventListener(
				'keydown',
				(event) => {
					if (event.key === 'Enter' && !event.shiftKey) {
						event.preventDefault();
						void this.submitMessage();
					}
				},
				{ signal }
			);

			// Evita que el browser scrollee/empuje el sheet al enfocar el textarea.
			this.input?.addEventListener(
				'focus',
				() => {
					this.applyMobileSheetLock();
					restorePanelScrollLayout();
					this.messagesEl?.scrollTo({ top: this.messagesEl.scrollHeight });
				},
				{ signal }
			);
		}

		disconnectedCallback() {
			this.clearMobileSheetLock();
			this.releasePanelScrollLock();
			this.abort?.abort();
			this.abort = null;
		}

		private isMobileSheet() {
			return window.matchMedia('(max-width: 639px)').matches;
		}

		private acquirePanelScrollLock() {
			if (this.unlockCanvasScroll) return;
			this.unlockCanvasScroll = lockPanelScroll();
		}

		private releasePanelScrollLock() {
			this.unlockCanvasScroll?.();
			this.unlockCanvasScroll = null;
		}

		private applyMobileSheetLock() {
			if (!this.modal || !this.isMobileSheet()) return;
			if (!this.lockedSheetHeightPx) {
				this.lockedSheetHeightPx = Math.round(getLayoutViewportHeight() * 0.9);
			}
			this.modal.style.height = `${this.lockedSheetHeightPx}px`;
			this.modal.style.maxHeight = `${this.lockedSheetHeightPx}px`;
			this.modal.style.margin = '0';
			this.modal.style.bottom = '0';
			this.modal.style.top = 'auto';
		}

		private clearMobileSheetLock() {
			this.lockedSheetHeightPx = 0;
			if (!this.modal) return;
			this.modal.style.height = '';
			this.modal.style.maxHeight = '';
			this.modal.style.margin = '';
			this.modal.style.bottom = '';
			this.modal.style.top = '';
		}

		private open() {
			if (!this.modal) return;
			this.modal.classList.remove('is-closing', 'is-settled');
			this.acquirePanelScrollLock();
			this.applyMobileSheetLock();
			if (!this.modal.open) this.modal.showModal();
			this.clearError();
			void this.loadUserAvatar();
			const settleMs = Number.parseInt(
				getComputedStyle(this.modal).getPropertyValue('--modal-open-duration') || '220',
				10
			);
			window.setTimeout(() => {
				this.modal?.classList.add('is-settled');
			}, Number.isFinite(settleMs) ? settleMs : 220);
			// Warm-up markdown en idle para no competir con la apertura.
			const warmMarked = () => void ensureMarked();
			if ('requestIdleCallback' in window) {
				window.requestIdleCallback(warmMarked, { timeout: 1500 });
			} else {
				window.setTimeout(warmMarked, 300);
			}
			// En mobile no autofocus: el teclado sube el sheet y lo comprime.
			if (!this.isMobileSheet()) {
				queueMicrotask(() => this.input?.focus({ preventScroll: true }));
			}
		}

		private close() {
			if (!this.modal?.open || this.modal.classList.contains('is-closing')) return;
			this.input?.blur();
			this.modal.classList.add('is-closing');
			this.modal.classList.remove('is-settled');
			window.setTimeout(() => {
				this.modal?.close();
				this.modal?.classList.remove('is-closing');
				this.clearMobileSheetLock();
				this.releasePanelScrollLock();
			}, 200);
		}

		private clearError() {
			if (!this.errorEl) return;
			this.errorEl.textContent = '';
			this.errorEl.classList.add('hidden');
		}

		private showError(message: string) {
			if (!this.errorEl) return;
			this.errorEl.textContent = message;
			this.errorEl.classList.remove('hidden');
		}

		private isSafeUrl(value: string) {
			const url = value.trim();
			if (!url || url.startsWith('#')) return Boolean(url);
			try {
				const parsed = new URL(url, window.location.origin);
				return ALLOWED_LINK_PROTOCOLS.has(parsed.protocol);
			} catch {
				return false;
			}
		}

		private sanitizeMarkdownHtml(html: string) {
			const template = document.createElement('template');
			template.innerHTML = html;

			const walker = document.createTreeWalker(template.content, NodeFilter.SHOW_ELEMENT);
			const elements: Element[] = [];
			while (walker.nextNode()) {
				elements.push(walker.currentNode as Element);
			}

			for (const element of elements) {
				const tagName = element.tagName.toLowerCase();
				if (!ALLOWED_MARKDOWN_TAGS.has(tagName)) {
					element.replaceWith(...Array.from(element.childNodes));
					continue;
				}

				const href = element.getAttribute('href') || '';
				for (const attribute of Array.from(element.attributes)) {
					element.removeAttribute(attribute.name);
				}

				if (tagName === 'a' && this.isSafeUrl(href)) {
					element.setAttribute('href', href.trim());
					element.setAttribute('target', '_blank');
					element.setAttribute('rel', 'noreferrer');
				}
			}

			return template.innerHTML;
		}

		private normalizeAssistantMarkdown(content: string) {
			let text = String(content || '').trim();
			if (!text) return '';

			// Convierte pasos inline "1) ... 2) ..." en lista Markdown con saltos.
			if (/\d+[.)]\s+/.test(text) && !/^\s*\d+[.)]\s+/m.test(text.split('\n').slice(1).join('\n'))) {
				text = text.replace(/(?:^|[ \t]+)(\d+)[.)]\s+/g, '\n$1. ');
			}

			// Viñetas inline "- item - item" → lista.
			if (/(?:^|\s)-\s+\S/.test(text) && !/^\s*[-*]\s+/m.test(text)) {
				text = text.replace(/(?:^|[ \t]+)[-*]\s+/g, '\n- ');
			}

			return text
				.replace(/\n{3,}/g, '\n\n')
				.replace(/(^#{1,6}[^\n]+)\n{2,}/gm, '$1\n')
				.replace(/([^\n])\n{2,}(?=[-*+] |\d+\. )/g, '$1\n')
				.trim();
		}

		private escapePlain(content: string) {
			return content
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/\n/g, '<br>');
		}

		private async renderMarkdown(content: string) {
			const normalized = this.normalizeAssistantMarkdown(content);
			try {
				const parse = await ensureMarked();
				const html = parse(normalized, {
					async: false,
					breaks: false,
					gfm: true,
				});
				return this.sanitizeMarkdownHtml(typeof html === 'string' ? html : String(html));
			} catch {
				return this.escapePlain(normalized);
			}
		}

		private initialsFromName(firstName: string, lastName: string) {
			const first = String(firstName || '').trim();
			const last = String(lastName || '').trim();
			const letters = `${first.charAt(0)}${last.charAt(0)}`.toUpperCase();
			return letters || this.userInitials;
		}

		private createAvatarNode(role: AtcRole) {
			const avatar = document.createElement('span');
			avatar.className = `atc-chat-avatar atc-chat-avatar--${role}`;
			avatar.setAttribute('aria-hidden', 'true');

			const photoUrl = role === 'assistant' ? this.botLogoUrl : this.userAvatarUrl;
			if (photoUrl) {
				const img = document.createElement('img');
				img.src = photoUrl;
				img.alt = '';
				img.width = 28;
				img.height = 28;
				img.decoding = 'async';
				img.addEventListener('error', () => {
					img.remove();
					avatar.classList.add('atc-chat-avatar--fallback');
					avatar.textContent = role === 'assistant' ? 'H' : this.userInitials;
				});
				avatar.appendChild(img);
				return avatar;
			}

			avatar.classList.add('atc-chat-avatar--fallback');
			avatar.textContent = role === 'assistant' ? 'H' : this.userInitials;
			return avatar;
		}

		private async loadUserAvatar() {
			if (this.userAvatarLoaded) return;
			this.userAvatarLoaded = true;
			try {
				const response = await fetch('/api/profile/me', { headers: { Accept: 'application/json' } });
				const payload = (await response.json().catch(() => null)) as {
					status?: string;
					data?: {
						first_name?: string;
						last_name?: string;
						public_profile?: { image_url?: string };
						professional_profile?: { profile_image_url?: string };
					};
				} | null;
				if (!response.ok || payload?.status !== 'success' || !payload.data) return;

				const professionalPhoto = String(payload.data.professional_profile?.profile_image_url || '').trim();
				const userPhoto = String(payload.data.public_profile?.image_url || '').trim();
				this.userAvatarUrl = professionalPhoto || userPhoto;
				this.userInitials = this.initialsFromName(
					String(payload.data.first_name || ''),
					String(payload.data.last_name || '')
				);
				await this.renderMessages();
			} catch {
				/* sin foto: se usa inicial */
			}
		}

		private createMessageNode(message: AtcMessage, bodyHtml: string) {
			const wrapper = document.createElement('div');
			wrapper.dataset.atcMsg = message.role;
			wrapper.className = `atc-chat-message atc-chat-message--${message.role}`;

			const bubble = document.createElement('div');
			bubble.className = `atc-chat-bubble atc-chat-bubble--${message.role}`;

			const body = document.createElement('div');
			body.className = 'atc-chat-bubble__body';
			if (message.role === 'assistant') {
				body.innerHTML = bodyHtml;
			} else {
				body.textContent = message.content;
			}

			const time = document.createElement('time');
			time.className = 'atc-chat-bubble__time';
			time.dateTime = new Date(message.sentAt).toISOString();
			time.textContent = formatAtcMessageTime(message.sentAt);

			bubble.append(body, time);

			const avatar = this.createAvatarNode(message.role);
			if (message.role === 'user') {
				wrapper.append(bubble, avatar);
			} else {
				wrapper.append(avatar, bubble);
			}
			return wrapper;
		}

		private async renderMessages() {
			if (!this.messagesEl) return;
			const welcome = this.messagesEl.querySelector('[data-atc-chat-welcome]');
			const thinking = this.messagesEl.querySelector('[data-atc-thinking]');
			this.messagesEl.querySelectorAll('[data-atc-msg]').forEach((node) => node.remove());

			for (const message of this.messages) {
				const bodyHtml =
					message.role === 'assistant' ? await this.renderMarkdown(message.content) : '';
				this.messagesEl.appendChild(this.createMessageNode(message, bodyHtml));
			}

			if (welcome instanceof HTMLElement) {
				welcome.classList.toggle('hidden', this.messages.length > 0);
			}

			if (this.suggestionsWrapEl) {
				this.suggestionsWrapEl.classList.toggle('hidden', this.messages.length > 0);
			}

			// Mantener el indicador de pensamiento al final de la lista
			if (thinking) {
				this.messagesEl.appendChild(thinking);
			}

			this.messagesEl.scrollTop = this.messagesEl.scrollHeight;
		}

		private appendThinking() {
			if (!this.messagesEl || this.messagesEl.querySelector('[data-atc-thinking]')) return;

			const row = document.createElement('div');
			row.dataset.atcThinking = 'true';
			row.className = 'atc-chat-message atc-chat-message--assistant';
			row.setAttribute('aria-live', 'polite');
			row.setAttribute('aria-busy', 'true');

			const bubble = document.createElement('div');
			bubble.className = 'atc-thinking';
			bubble.innerHTML = `
				<span class="atc-thinking-label">Hasel está pensando</span>
				<span class="atc-thinking-dots" aria-hidden="true">
					<span></span><span></span><span></span>
				</span>
			`;
			row.append(this.createAvatarNode('assistant'), bubble);
			this.messagesEl.appendChild(row);
			this.messagesEl.scrollTop = this.messagesEl.scrollHeight;
		}

		private removeThinking() {
			this.messagesEl?.querySelectorAll('[data-atc-thinking]').forEach((node) => node.remove());
		}

		private setBusy(next: boolean) {
			this.busy = next;
			if (this.sendBtn) this.sendBtn.disabled = next;
			if (this.input) this.input.disabled = next;
			this.messagesEl
				?.querySelectorAll<HTMLButtonElement>('[data-atc-chat-suggestion]')
				.forEach((button) => {
					button.disabled = next;
				});
			if (next) {
				this.appendThinking();
			} else {
				this.removeThinking();
			}
		}

		private renderSuggestedQuestions() {
			if (!this.suggestionsEl) return;
			this.suggestionsEl.replaceChildren();

			const fragment = document.createDocumentFragment();
			for (const [index, suggestion] of ATC_CHAT_SUGGESTED_QUESTIONS.entries()) {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'atc-chat-suggestion-btn';
				button.style.setProperty('--chip-index', String(index));
				button.dataset.atcChatSuggestion = suggestion.message;
				button.dataset.atcChatSuggestionLabel = suggestion.label;
				button.setAttribute('aria-label', suggestion.label);
				button.disabled = this.busy;

				const iconWrap = document.createElement('span');
				iconWrap.className = 'atc-chat-suggestion-btn__icon';

				const icon = document.createElement('span');
				icon.className = 'material-symbols-rounded';
				icon.setAttribute('aria-hidden', 'true');
				icon.textContent = suggestion.icon;
				iconWrap.appendChild(icon);

				const label = document.createElement('span');
				label.className = 'atc-chat-suggestion-btn__label';
				label.textContent = suggestion.label;

				button.append(iconWrap, label);
				fragment.appendChild(button);
			}

			this.suggestionsEl.appendChild(fragment);
		}

		private handleSuggestedQuestion(button: HTMLButtonElement) {
			const message = String(button.dataset.atcChatSuggestion || '').trim();
			const label = String(button.dataset.atcChatSuggestionLabel || message).trim();
			if (!message || this.busy) return;
			void this.submitMessage(message, label);
		}

		private async submitMessage(override?: string, displayOverride?: string) {
			if (this.busy || !this.input) return;
			const message = (override ?? this.input.value).trim();
			const displayMessage = (displayOverride ?? message).trim();
			if (!message) return;

			this.clearError();
			this.messages.push({ role: 'user', content: displayMessage, sentAt: Date.now() });
			if (!override) {
				this.input.value = '';
			}
			await this.renderMessages();
			this.setBusy(true);

			try {
				const response = await fetch('/api/atc/ask', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						Accept: 'application/json',
					},
					body: JSON.stringify({ message }),
				});

				const payload = (await response.json().catch(() => null)) as {
					status?: string;
					data?: { response?: string };
					message?: string;
				} | null;

				if (!response.ok || payload?.status === 'error') {
					throw new Error(payload?.message || 'No fue posible obtener una respuesta.');
				}

				const answer = String(payload?.data?.response || '').trim();
				if (!answer) throw new Error('La respuesta vino vacía.');

				this.messages.push({ role: 'assistant', content: answer, sentAt: Date.now() });
				this.setBusy(false);
				await this.renderMessages();
			} catch (error) {
				this.setBusy(false);
				this.showError('No pudimos obtener una respuesta. Probá de nuevo en un momento.');
			} finally {
				if (this.busy) this.setBusy(false);
				if (!this.isMobileSheet()) {
					this.input?.focus({ preventScroll: true });
				}
			}
		}
	}

	if (!customElements.get('atc-chat-modal')) {
		customElements.define('atc-chat-modal', AtcChatModal);
	}
</script>

