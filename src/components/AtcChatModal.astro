<atc-chat-modal>
	<dialog
		data-atc-chat-modal
		class="m-0 mt-auto mb-0 h-[min(34rem,92svh)] w-screen max-w-none open:flex open:flex-col overflow-hidden rounded-t-[1.8rem] rounded-b-none border border-(--shell-border) bg-(--surface-bright) p-0 text-(--on-surface) shadow-[0_24px_80px_rgba(0,0,0,0.2)] sm:m-auto sm:h-[min(36rem,90vh)] sm:w-[min(28rem,calc(100vw-2rem))] sm:max-w-[min(28rem,calc(100vw-2rem))] sm:rounded-[1.8rem]"
	>
		<header class="flex shrink-0 items-start justify-between gap-3 border-b border-(--shell-border) px-4 py-3 sm:px-5 sm:py-4">
			<div class="flex min-w-0 items-center gap-3">
				<div class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-(--primary-soft) text-(--primary)">
					<span class="material-symbols-rounded text-[1.35rem]">support_agent</span>
				</div>
				<div class="min-w-0">
					<h2 class="text-[1.05rem] font-extrabold tracking-tight text-(--on-surface)">Atención al cliente</h2>
					<p class="truncate text-[0.82rem] font-medium text-(--on-surface-variant)">
						Preguntas sobre Hasel
					</p>
				</div>
			</div>
			<button
				type="button"
				class="flex size-10 shrink-0 items-center justify-center rounded-full border border-(--shell-border) text-(--on-surface-variant) transition hover:bg-(--control-surface)"
				data-atc-chat-close
				aria-label="Cerrar atención al cliente"
			>
				<span class="material-symbols-rounded text-[1.2rem]">close</span>
			</button>
		</header>

		<div class="min-h-0 flex-1 space-y-3 overflow-y-auto px-4 py-4 sm:px-5" data-atc-chat-messages>
			<div class="rounded-2xl bg-(--control-surface) px-3.5 py-3 text-sm leading-relaxed text-(--on-surface-variant)" data-atc-chat-welcome>
				Hola. Soy el asistente de atención al cliente de Hasel. Preguntame sobre el producto y te respondo con la documentación cargada.
			</div>
		</div>

		<div class="hidden shrink-0 px-4 pb-2 text-sm text-red-600 sm:px-5" data-atc-chat-error></div>

		<form class="shrink-0 border-t border-(--shell-border) px-3 py-3 sm:px-4" data-atc-chat-form>
			<div class="flex items-end gap-2">
				<textarea
					rows="1"
					class="max-h-28 min-h-11 w-full resize-none rounded-2xl border border-(--shell-border) bg-(--control-surface) px-3.5 py-2.5 text-sm text-(--on-surface) outline-none transition placeholder:text-(--on-surface-variant)/70 focus:border-(--primary) focus:ring-2 focus:ring-(--primary)/20"
					placeholder="Escribí tu pregunta..."
					data-atc-chat-input
					autocomplete="off"
				></textarea>
				<button
					type="submit"
					class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-(--primary) text-(--on-primary) transition hover:opacity-90 disabled:opacity-50"
					data-atc-chat-send
					aria-label="Enviar pregunta"
				>
					<span class="material-symbols-rounded text-[1.2rem]">send</span>
				</button>
			</div>
		</form>
	</dialog>
</atc-chat-modal>

<script>
	type AtcRole = 'user' | 'assistant';

	type AtcMessage = {
		role: AtcRole;
		content: string;
	};

	class AtcChatModal extends HTMLElement {
		private modal: HTMLDialogElement | null = null;
		private messagesEl: HTMLElement | null = null;
		private errorEl: HTMLElement | null = null;
		private form: HTMLFormElement | null = null;
		private input: HTMLTextAreaElement | null = null;
		private sendBtn: HTMLButtonElement | null = null;
		private messages: AtcMessage[] = [];
		private busy = false;
		private abort: AbortController | null = null;
		private lockedSheetHeightPx = 0;

		connectedCallback() {
			this.modal = this.querySelector('[data-atc-chat-modal]');
			this.messagesEl = this.querySelector('[data-atc-chat-messages]');
			this.errorEl = this.querySelector('[data-atc-chat-error]');
			this.form = this.querySelector('[data-atc-chat-form]');
			this.input = this.querySelector('[data-atc-chat-input]');
			this.sendBtn = this.querySelector('[data-atc-chat-send]');

			this.abort?.abort();
			this.abort = new AbortController();
			const { signal } = this.abort;

			document.addEventListener(
				'click',
				(event) => {
					const target = event.target as HTMLElement | null;
					if (target?.closest('[data-atc-button]')) {
						event.preventDefault();
						this.open();
					}
					if (target?.closest('[data-atc-chat-close]')) {
						this.close();
					}
				},
				{ signal }
			);

			this.modal?.addEventListener('close', () => this.clearMobileSheetLock(), { signal });

			this.form?.addEventListener(
				'submit',
				(event) => {
					event.preventDefault();
					void this.submitMessage();
				},
				{ signal }
			);

			this.input?.addEventListener(
				'keydown',
				(event) => {
					if (event.key === 'Enter' && !event.shiftKey) {
						event.preventDefault();
						void this.submitMessage();
					}
				},
				{ signal }
			);

			// Evita que el browser scrollee/empuje el sheet al enfocar el textarea.
			this.input?.addEventListener(
				'focus',
				() => {
					this.applyMobileSheetLock();
					this.messagesEl?.scrollTo({ top: this.messagesEl.scrollHeight });
				},
				{ signal }
			);
		}

		disconnectedCallback() {
			this.clearMobileSheetLock();
			this.abort?.abort();
			this.abort = null;
		}

		private isMobileSheet() {
			return window.matchMedia('(max-width: 639px)').matches;
		}

		private applyMobileSheetLock() {
			if (!this.modal || !this.isMobileSheet()) return;
			if (!this.lockedSheetHeightPx) {
				this.lockedSheetHeightPx = Math.min(
					34 * 16,
					Math.round(window.innerHeight * 0.92)
				);
			}
			this.modal.style.height = `${this.lockedSheetHeightPx}px`;
			this.modal.style.maxHeight = `${this.lockedSheetHeightPx}px`;
			this.modal.style.margin = '0';
			this.modal.style.bottom = '0';
			this.modal.style.top = 'auto';
		}

		private clearMobileSheetLock() {
			this.lockedSheetHeightPx = 0;
			if (!this.modal) return;
			this.modal.style.height = '';
			this.modal.style.maxHeight = '';
			this.modal.style.margin = '';
			this.modal.style.bottom = '';
			this.modal.style.top = '';
		}

		private open() {
			if (!this.modal) return;
			this.applyMobileSheetLock();
			if (!this.modal.open) this.modal.showModal();
			this.clearError();
			// En mobile no autofocus: el teclado sube el sheet y lo comprime.
			if (!this.isMobileSheet()) {
				queueMicrotask(() => this.input?.focus({ preventScroll: true }));
			}
		}

		private close() {
			this.modal?.close();
			this.clearMobileSheetLock();
		}

		private clearError() {
			if (!this.errorEl) return;
			this.errorEl.textContent = '';
			this.errorEl.classList.add('hidden');
		}

		private showError(message: string) {
			if (!this.errorEl) return;
			this.errorEl.textContent = message;
			this.errorEl.classList.remove('hidden');
		}

		private renderMessages() {
			if (!this.messagesEl) return;
			const welcome = this.messagesEl.querySelector('[data-atc-chat-welcome]');
			const thinking = this.messagesEl.querySelector('[data-atc-thinking]');
			this.messagesEl.querySelectorAll('[data-atc-msg]').forEach((node) => node.remove());

			for (const message of this.messages) {
				const bubble = document.createElement('div');
				bubble.dataset.atcMsg = message.role;
				bubble.className =
					message.role === 'user'
						? 'ml-8 rounded-2xl bg-(--primary) px-3.5 py-3 text-sm leading-relaxed text-(--on-primary)'
						: 'mr-8 rounded-2xl bg-(--control-surface) px-3.5 py-3 text-sm leading-relaxed text-(--on-surface)';
				bubble.textContent = message.content;
				this.messagesEl.appendChild(bubble);
			}

			if (welcome instanceof HTMLElement) {
				welcome.classList.toggle('hidden', this.messages.length > 0);
			}

			// Mantener el indicador de pensamiento al final de la lista
			if (thinking) {
				this.messagesEl.appendChild(thinking);
			}

			this.messagesEl.scrollTop = this.messagesEl.scrollHeight;
		}

		private appendThinking() {
			if (!this.messagesEl || this.messagesEl.querySelector('[data-atc-thinking]')) return;

			const bubble = document.createElement('div');
			bubble.dataset.atcThinking = 'true';
			bubble.className =
				'atc-thinking mr-8 flex items-center gap-2.5 rounded-2xl bg-(--control-surface) px-3.5 py-3 text-sm text-(--on-surface-variant)';
			bubble.setAttribute('aria-live', 'polite');
			bubble.setAttribute('aria-busy', 'true');
			bubble.innerHTML = `
				<span class="atc-thinking-label">Hasel está pensando</span>
				<span class="atc-thinking-dots" aria-hidden="true">
					<span></span><span></span><span></span>
				</span>
			`;
			this.messagesEl.appendChild(bubble);
			this.messagesEl.scrollTop = this.messagesEl.scrollHeight;
		}

		private removeThinking() {
			this.messagesEl?.querySelectorAll('[data-atc-thinking]').forEach((node) => node.remove());
		}

		private setBusy(next: boolean) {
			this.busy = next;
			if (this.sendBtn) this.sendBtn.disabled = next;
			if (this.input) this.input.disabled = next;
			if (next) {
				this.appendThinking();
			} else {
				this.removeThinking();
			}
		}

		private async submitMessage() {
			if (this.busy || !this.input) return;
			const message = this.input.value.trim();
			if (!message) return;

			this.clearError();
			this.messages.push({ role: 'user', content: message });
			this.input.value = '';
			this.renderMessages();
			this.setBusy(true);

			try {
				const response = await fetch('/api/atc/ask', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						Accept: 'application/json',
					},
					body: JSON.stringify({ message }),
				});

				const payload = (await response.json().catch(() => null)) as {
					status?: string;
					data?: { response?: string };
					message?: string;
				} | null;

				if (!response.ok || payload?.status === 'error') {
					throw new Error(payload?.message || 'No fue posible obtener una respuesta.');
				}

				const answer = String(payload?.data?.response || '').trim();
				if (!answer) throw new Error('La respuesta vino vacía.');

				this.messages.push({ role: 'assistant', content: answer });
				this.setBusy(false);
				this.renderMessages();
			} catch (error) {
				this.setBusy(false);
				this.showError(error instanceof Error ? error.message : 'Error al consultar ATC.');
			} finally {
				if (this.busy) this.setBusy(false);
				if (!this.isMobileSheet()) {
					this.input?.focus({ preventScroll: true });
				}
			}
		}
	}

	if (!customElements.get('atc-chat-modal')) {
		customElements.define('atc-chat-modal', AtcChatModal);
	}
</script>

<style>
	atc-chat-modal {
		display: contents;
	}
</style>

<style is:global>
	[data-atc-chat-modal]::backdrop {
		background: rgba(15, 17, 21, 0.6);
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	html[data-theme='dark'] [data-atc-chat-modal]::backdrop {
		background: rgba(0, 0, 0, 0.58);
	}

	/* Bottom sheet estable en mobile: no re-centrar ni achicar con el teclado (dvh). */
	@media (max-width: 639px) {
		[data-atc-chat-modal][open] {
			position: fixed;
			inset: auto 0 0 0;
			margin: 0;
			width: 100%;
			max-width: none;
			height: min(34rem, 92svh);
			max-height: 92svh;
			transform: none;
		}
	}

	.atc-thinking {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.atc-thinking-label {
		font-weight: 500;
		letter-spacing: 0.01em;
	}

	.atc-thinking-dots {
		display: inline-flex;
		align-items: flex-end;
		gap: 0.28rem;
		padding-bottom: 0.12rem;
	}

	.atc-thinking-dots span {
		display: inline-block;
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--on-surface-variant) 85%, transparent);
		animation: atc-thinking-bounce 1.1s ease-in-out infinite;
	}

	.atc-thinking-dots span:nth-child(2) {
		animation-delay: 0.18s;
	}

	.atc-thinking-dots span:nth-child(3) {
		animation-delay: 0.36s;
	}

	@keyframes atc-thinking-bounce {
		0%,
		70%,
		100% {
			opacity: 0.35;
			transform: translateY(0);
		}
		35% {
			opacity: 1;
			transform: translateY(-0.28rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.atc-thinking-dots span {
			animation: none;
			opacity: 0.7;
		}
	}
</style>
