---
import '../styles/auth.css';

interface Props {
	token?: string;
	error?: string;
}

const { token = '', error = '' } = Astro.props;
const safeToken = String(token || '').trim();
---

<section class="auth-page" data-accept-invite-root data-token={safeToken}>
	<div class="auth-fx" aria-hidden="true">
		<div class="auth-atmosphere"></div>
		<div class="auth-vignette"></div>
		<div class="auth-orb auth-orb-a"></div>
		<div class="auth-orb auth-orb-b"></div>
		<div class="auth-deco auth-deco-1"></div>
		<div class="auth-deco auth-deco-2"></div>
		<div class="auth-deco auth-deco-3"></div>
		<div class="auth-deco auth-deco-4"></div>
		<div class="auth-deco auth-deco-5"></div>
		<div class="auth-deco auth-deco-6"></div>
		<div class="auth-deco auth-deco-7"></div>
		<div class="auth-deco auth-wave auth-wave-1"></div>
		<div class="auth-deco auth-wave auth-wave-2"></div>
	</div>

	<header class="auth-topbar">
		<div class="auth-topbar-inner">
			<a href="/" class="auth-brand" aria-label="Hasel — Inicio">
				<img
					src="/icons/icon-64.png"
					alt=""
					class="auth-brand-logo"
					width="40"
					height="40"
					loading="eager"
					decoding="async"
				/>
				<span class="auth-brand-wordmark">Hasel</span>
			</a>
			<a href="/auth/login" class="auth-topbar-cta">Iniciar sesión</a>
		</div>
	</header>

	<div class="auth-shell">
		<main class="auth-card">
			<header class="auth-card-header">
				<img
					src="/icons/icon-512x512.png"
					alt="Hasel"
					class="auth-card-logo"
					width="72"
					height="72"
					loading="eager"
					decoding="async"
				/>
				<h1 class="auth-title">Aceptar invitación</h1>
				<p class="auth-subtitle" data-invite-desc>Estamos validando tu enlace de invitación…</p>
				<p class="auth-subtitle" data-invite-org-label style="margin-top: 0.4rem; font-weight: 600; color: var(--auth-on-surface);"></p>
			</header>

			{error && (
				<div class="auth-banner auth-banner-error" role="alert">
					<span class="material-symbols-rounded" aria-hidden="true">error</span>
					<span>{error}</span>
				</div>
			)}

			<div class="auth-banner auth-banner-error auth-is-hidden" data-invite-error role="alert">
				<span class="material-symbols-rounded" aria-hidden="true">error</span>
				<span data-invite-error-text></span>
			</div>

			<div class="auth-banner auth-banner-info auth-is-hidden" data-invite-loading role="status">
				<span class="material-symbols-rounded" aria-hidden="true">hourglass_top</span>
				<span>Cargando invitación…</span>
			</div>

			<div class="auth-is-hidden" data-invite-login-panel>
				<p class="auth-field-help" data-invite-login-hint style="margin-bottom: 0.9rem;">
					Ya tienes una cuenta con este correo. Iniciá sesión para unirte a la organización.
				</p>
				<a class="auth-btn auth-btn-primary auth-btn-block" data-invite-login-link href="/auth/login">
					Iniciar sesión y aceptar
				</a>
			</div>

			<form class="auth-is-hidden" method="post" action="/api/auth/accept-invitation" data-accept-invite-form>
				<input type="hidden" name="token" value={safeToken} data-invite-token-input />

				<div class="auth-form-grid auth-form-grid--2">
					<div class="auth-field">
						<label class="auth-label" for="invite_first_name">Nombres</label>
						<input type="text" id="invite_first_name" name="first_name" class="auth-input" required />
					</div>
					<div class="auth-field">
						<label class="auth-label" for="invite_last_name">Apellidos</label>
						<input type="text" id="invite_last_name" name="last_name" class="auth-input" required />
					</div>
				</div>

				<div class="auth-field" style="margin-top: 1.15rem;">
					<label class="auth-label" for="invite_email">Correo</label>
					<input type="email" id="invite_email" name="email" class="auth-input" readonly />
				</div>

				<div class="auth-field">
					<label class="auth-label" for="invite_password">Contraseña</label>
					<input
						type="password"
						id="invite_password"
						name="password"
						class="auth-input"
						minlength="8"
						autocomplete="new-password"
						required
					/>
				</div>

				<button type="submit" class="auth-btn auth-btn-primary auth-submit" data-invite-submit>
					Crear cuenta y unirme
				</button>
			</form>

			<footer class="auth-card-footer">
				<p class="auth-footer-text">
					<a href="/auth/login" class="auth-footer-link" data-invite-footer-login>
						¿Ya tienes cuenta? <strong>Iniciar sesión</strong>
					</a>
				</p>
			</footer>
		</main>
	</div>

	<footer class="auth-page-footer" aria-label="Pie de página">
		<p>
			Hasel &copy; 2026
			<span class="auth-page-footer-sep" aria-hidden="true">|</span>
			<a href="/politicas-y-privacidad" class="auth-page-footer-link">Políticas de privacidad</a>
		</p>
	</footer>
</section>

<script is:inline>
	function setupAcceptInviteForm() {
		const root = document.querySelector('[data-accept-invite-root]');
		if (!root || root.dataset.enhanced) return;
		root.dataset.enhanced = 'true';

		const token = String(root.dataset.token || '').trim();
		const errorBox = root.querySelector('[data-invite-error]');
		const errorText = root.querySelector('[data-invite-error-text]');
		const loadingBox = root.querySelector('[data-invite-loading]');
		const loginPanel = root.querySelector('[data-invite-login-panel]');
		const loginLink = root.querySelector('[data-invite-login-link]');
		const loginHint = root.querySelector('[data-invite-login-hint]');
		const footerLoginLink = root.querySelector('[data-invite-footer-login]');

		const buildInviteAcceptPath = () =>
			`/auth/accept-invite?token=${encodeURIComponent(token)}`;

		const buildLoginAfterLogoutPath = (switchAccount = false) => {
			const acceptPath = buildInviteAcceptPath();
			const loginParams = new URLSearchParams();
			loginParams.set('redirectTo', acceptPath);
			if (switchAccount) {
				loginParams.set('switch_account', '1');
			}
			return `/auth/login?${loginParams.toString()}`;
		};

		const logoutThenGoToLogin = async (switchAccount = false) => {
			const loginPath = buildLoginAfterLogoutPath(switchAccount);
			try {
				await fetch(`/api/auth/logout?redirectTo=${encodeURIComponent(loginPath)}`, {
					method: 'POST',
					headers: { Accept: 'application/json' },
					credentials: 'same-origin',
				});
			} catch {
				// Continuar al login aunque falle el logout remoto.
			}
			window.location.assign(loginPath);
		};

		const applyLoginLinks = (switchAccount = false) => {
			const bind = (el) => {
				if (!(el instanceof HTMLAnchorElement)) return;
				el.href = buildLoginAfterLogoutPath(switchAccount);
				el.onclick = (event) => {
					event.preventDefault();
					void logoutThenGoToLogin(switchAccount);
				};
			};
			bind(loginLink);
			bind(footerLoginLink);
		};
		const form = root.querySelector('[data-accept-invite-form]');
		const submitBtn = root.querySelector('[data-invite-submit]');
		const orgLabel = root.querySelector('[data-invite-org-label]');
		const desc = root.querySelector('[data-invite-desc]');

		const showError = (message) => {
			if (errorText) errorText.textContent = message;
			errorBox?.classList.remove('auth-is-hidden');
		};

		const hideError = () => {
			errorBox?.classList.add('auth-is-hidden');
			if (errorText) errorText.textContent = '';
		};

		if (!token) {
			showError('No encontramos un enlace de invitación válido.');
			loadingBox?.classList.add('auth-is-hidden');
			return;
		}

		const loadPreview = async () => {
			try {
				const response = await fetch(`/api/auth/invitation?token=${encodeURIComponent(token)}`, {
					headers: { Accept: 'application/json' },
				});
				const data = await response.json();
				loadingBox?.classList.add('auth-is-hidden');

				if (!response.ok) {
					showError(data?.message || data?.error || 'La invitación no es válida o expiró.');
					return;
				}

				const orgName = String(data.organization_name || '').trim();
				if (orgLabel) orgLabel.textContent = orgName ? `Te invitaron a ${orgName}` : 'Te invitaron a una organización';
				if (desc) {
					desc.textContent = orgName
						? `Completá tus datos de cuenta para unirte a ${orgName}.`
						: 'Completá tus datos de cuenta para unirte al equipo.';
				}

				const emailInput = form?.querySelector('#invite_email');
				if (emailInput instanceof HTMLInputElement) emailInput.value = String(data.email || '');

				if (data.login_required) {
					try {
						const acceptResponse = await fetch('/api/auth/accept-invitation', {
							method: 'POST',
							credentials: 'same-origin',
							headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
							body: JSON.stringify({ token }),
						});
						const acceptData = await acceptResponse.json();
						if (acceptResponse.ok) {
							window.location.assign(acceptData?.redirect || '/panel/dashboard');
							return;
						}

						if (acceptResponse.status === 403) {
							if (loginHint) {
								loginHint.textContent =
									'Hay otra cuenta iniciada en este navegador. Al continuar cerraremos esa sesión para que puedas ingresar con el correo invitado.';
							}
							showError(
								acceptData?.message ||
									'La sesión activa no corresponde al correo invitado.'
							);
							applyLoginLinks(true);
						} else if (!acceptData?.login_required) {
							showError(acceptData?.message || 'No fue posible aceptar la invitación con la sesión actual.');
							applyLoginLinks(false);
						}
					} catch {
						applyLoginLinks(false);
					}

					if (desc) {
						desc.textContent =
							'Ya tienes una cuenta con este correo. Iniciá sesión para unirte a la organización.';
					}
					applyLoginLinks(false);
					loginPanel?.classList.remove('auth-is-hidden');
					return;
				}

				form?.classList.remove('auth-is-hidden');
			} catch {
				loadingBox?.classList.add('auth-is-hidden');
				showError('No pudimos cargar la invitación. Intenta de nuevo.');
			}
		};

		form?.addEventListener('submit', async (event) => {
			event.preventDefault();
			hideError();
			if (!(form instanceof HTMLFormElement)) return;

			const formData = new FormData(form);
			const payload = {
				token,
				password: String(formData.get('password') || ''),
				first_name: String(formData.get('first_name') || '').trim(),
				last_name: String(formData.get('last_name') || '').trim(),
			};

			if (submitBtn instanceof HTMLButtonElement) {
				submitBtn.disabled = true;
				submitBtn.textContent = 'Procesando…';
			}

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify(payload),
				});
				const data = await response.json();

				if (!response.ok) {
					if (data?.login_required) {
						loginPanel?.classList.remove('auth-is-hidden');
						form.classList.add('auth-is-hidden');
						applyLoginLinks(false);
						return;
					}
					showError(data?.message || data?.error || 'No fue posible aceptar la invitación.');
					return;
				}

				window.location.assign(data?.redirect || '/auth/login?invitationAccepted=1');
			} catch {
				showError('No pudimos comunicarnos con el servidor.');
			} finally {
				if (submitBtn instanceof HTMLButtonElement) {
					submitBtn.disabled = false;
					submitBtn.textContent = 'Crear cuenta y unirme';
				}
			}
		});

		void loadPreview();
	}

	if (typeof window !== 'undefined') {
		setupAcceptInviteForm();
		document.addEventListener('astro:page-load', setupAcceptInviteForm);
	}
</script>
