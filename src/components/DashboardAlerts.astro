---
import type { DashboardAlert } from '../lib/dashboard-alerts';

interface Props {
	alerts: DashboardAlert[];
}

const { alerts } = Astro.props;
---

{
	alerts.length > 0 ? (
<section class="dashboard-alerts" data-dashboard-alerts aria-label="Alertas">
	<h2 class="dashboard-alerts__title">Alertas</h2>
	<ul class="dashboard-alerts__list">
		{
			alerts.map((alert) => (
				<li class="dashboard-alerts__item" data-dashboard-alert={alert.id}>
					<span class="dashboard-alerts__icon" aria-hidden="true">
						<span class="material-symbols-rounded">{alert.icon}</span>
					</span>
					<p class="dashboard-alerts__message">{alert.message}</p>
					<a class="dashboard-alerts__cta" href={alert.href} data-dashboard-alert-cta={alert.id}>
						{alert.ctaLabel}
					</a>
				</li>
			))
		}
	</ul>
</section>
	) : null
}

<style>
	.dashboard-alerts {
		display: grid;
		gap: 0.7rem;
		min-width: 0;
		width: 100%;
	}

	.dashboard-alerts__title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.25;
		color: #1e293b;
	}

	.dashboard-alerts__list {
		display: grid;
		gap: var(--dashboard-gap, 8px);
		min-width: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.dashboard-alerts__item {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
		padding: 0.85rem 0.95rem;
		border: 1px solid var(--dashboard-card-border, var(--shell-border));
		border-radius: var(--dashboard-card-radius, 0.75rem);
		background: var(--dashboard-card-bg, #ffffff);
	}

	.dashboard-alerts__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 2rem;
		height: 2rem;
		border-radius: 0.7rem;
		background: color-mix(in srgb, var(--primary) 12%, transparent);
		color: var(--primary);
	}

	.dashboard-alerts__icon .material-symbols-rounded {
		font-size: 1.15rem;
		line-height: 1;
	}

	.dashboard-alerts__message {
		margin: 0;
		min-width: 0;
		font-size: 0.92rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.35;
		color: #1e293b;
	}

	.dashboard-alerts__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		min-height: 2rem;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--primary) 28%, var(--shell-border));
		background: color-mix(in srgb, var(--primary) 8%, transparent);
		color: var(--primary);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.2;
		text-decoration: none;
		white-space: nowrap;
		transition:
			border-color 260ms cubic-bezier(0.32, 0.72, 0, 1),
			background-color 260ms cubic-bezier(0.32, 0.72, 0, 1);
	}

	.dashboard-alerts__cta:hover {
		border-color: color-mix(in srgb, var(--primary) 48%, var(--shell-border));
		background: color-mix(in srgb, var(--primary) 14%, transparent);
	}

	.dashboard-alerts__cta:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 70%, #fff 30%);
		outline-offset: 2px;
	}

	html[data-theme='dark'] .dashboard-alerts__title,
	html[data-theme='dark'] .dashboard-alerts__message {
		color: #e5e7eb;
	}

	html[data-theme='dark'] .dashboard-alerts__item {
		background: var(--surface-bright);
		border-color: var(--dashboard-card-border, transparent);
	}

	html[data-theme='dark'] .dashboard-alerts__icon {
		background: color-mix(in srgb, var(--primary) 16%, #1f2126);
	}

	html[data-theme='dark'] .dashboard-alerts__cta {
		background: color-mix(in srgb, var(--primary) 16%, #1f2126);
		border-color: color-mix(in srgb, var(--primary) 32%, var(--shell-border));
	}

	@media (max-width: 640px) {
		.dashboard-alerts__item {
			grid-template-columns: auto minmax(0, 1fr);
			padding: 0.75rem 0.8rem;
			gap: 0.6rem 0.7rem;
		}

		.dashboard-alerts__cta {
			grid-column: 2;
			justify-self: start;
		}

		.dashboard-alerts__message {
			font-size: 0.84rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dashboard-alerts__cta {
			transition: none;
		}
	}
</style>
