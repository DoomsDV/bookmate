---
import '../styles/auth.css';

interface Props {
	error?: string;
	email?: string;
	emailError?: string;
	codeError?: string;
	registered?: boolean;
	pendingLogin?: boolean;
	resent?: boolean;
}

const {
	error = '',
	email = '',
	emailError = '',
	codeError = '',
	registered = false,
	pendingLogin = false,
	resent = false,
} = Astro.props;

const notice = registered
	? 'Te enviamos un código de 6 dígitos. Revisá tu bandeja de entrada para activar tu cuenta.'
	: resent
		? 'Te enviamos un nuevo código de verificación. Revisá tu bandeja de entrada.'
		: pendingLogin
			? 'Debés verificar tu correo antes de iniciar sesión. Ingresá el código de 6 dígitos o solicitá uno nuevo con "Reenviar código".'
			: '';
---

<section class="auth-page" data-auth-flow>
	<header class="auth-topbar">
		<div class="auth-topbar-inner">
			<a href="/" class="auth-brand" aria-label="Hasel — Inicio">
				<img
					src="/icons/icon-64.png"
					alt=""
					class="auth-brand-logo"
					width="40"
					height="40"
					loading="eager"
					decoding="async"
				/>
				<span class="auth-brand-wordmark">Hasel</span>
			</a>
		</div>
	</header>

	<div class="auth-shell">
		<main class="auth-card auth-card--flow">
			<header class="auth-card-header">
				<h1 class="auth-title">Confirmá tu correo</h1>
				<p class="auth-subtitle">Ingresá el código de 6 dígitos que enviamos a tu correo.</p>
			</header>

			{notice && (
				<div class="auth-banner auth-banner-info" role="status">
					<span class="material-symbols-rounded" aria-hidden="true">info</span>
					<span>{notice}</span>
				</div>
			)}

			{error && (
				<div class="auth-banner auth-banner-error" role="alert">
					<span class="material-symbols-rounded" aria-hidden="true">error</span>
					<span>{error}</span>
				</div>
			)}

			<form method="post" action="/api/auth/verify-email" data-astro-reload data-verify-email-form>
				<input type="hidden" name="action" value="verify" />

				<div class="auth-field">
					<label class="auth-label" for="email">Correo electrónico</label>
					<input
						type="email"
						id="email"
						name="email"
						placeholder="Ej: usuario@empresa.com"
						value={email}
						class:list={['auth-input', emailError && 'is-invalid']}
						autocomplete="email"
						autocapitalize="none"
						spellcheck="false"
						inputmode="email"
						required
						data-email-input
					/>
					{emailError && <span class="auth-field-error">{emailError}</span>}
				</div>

				<div class="auth-field">
					<label class="auth-label" for="code">Código de 6 dígitos</label>
					<input
						type="text"
						id="code"
						name="code"
						placeholder="000000"
						class:list={['auth-input', 'auth-code-input', codeError && 'is-invalid']}
						inputmode="numeric"
						autocomplete="one-time-code"
						maxlength="6"
						pattern="[0-9]{6}"
						required
						data-code-input
					/>
					{codeError && <span class="auth-field-error">{codeError}</span>}
				</div>

				<button type="submit" class="auth-btn auth-btn-primary auth-btn--flat auth-submit">
					Verificar correo
				</button>
			</form>

			<form
				method="post"
				action="/api/auth/verify-email"
				data-astro-reload
				data-resend-form
				class="auth-resend-form"
			>
				<input type="hidden" name="action" value="resend" />
				<input type="hidden" name="email" value={email} data-resend-email />
				<button type="submit" class="auth-btn auth-btn-tonal auth-btn-block">
					Reenviar código
				</button>
			</form>

			<footer class="auth-card-footer">
				<p class="auth-footer-text">
					¿Ya verificaste tu cuenta?
					<a href="/auth/login" class="auth-footer-link"><strong>Iniciar sesión</strong></a>
				</p>
			</footer>
		</main>
	</div>

	<footer class="auth-page-footer" aria-label="Pie de página">
		<p>
			Hasel &copy; 2026
			<span class="auth-page-footer-sep" aria-hidden="true">|</span>
			<a href="/politicas-y-privacidad" class="auth-page-footer-link">Políticas de privacidad</a>
		</p>
	</footer>
</section>

<script is:inline>
	function setupVerifyEmailForm() {
		const form = document.querySelector('[data-verify-email-form]');
		const resendForm = document.querySelector('[data-resend-form]');
		if (!form || form.dataset.enhanced) return;
		form.dataset.enhanced = 'true';

		const emailInput = form.querySelector('[data-email-input]');
		const codeInput = form.querySelector('[data-code-input]');
		const resendEmailInput = resendForm?.querySelector('[data-resend-email]');

		const syncResendEmail = () => {
			if (emailInput instanceof HTMLInputElement && resendEmailInput instanceof HTMLInputElement) {
				resendEmailInput.value = emailInput.value.trim();
			}
		};

		if (codeInput instanceof HTMLInputElement) {
			codeInput.addEventListener('input', () => {
				codeInput.value = codeInput.value.replace(/\D/g, '').slice(0, 6);
			});
			codeInput.addEventListener('paste', () => {
				window.setTimeout(() => {
					codeInput.value = codeInput.value.replace(/\D/g, '').slice(0, 6);
				});
			});
		}

		emailInput?.addEventListener('input', syncResendEmail);
		resendForm?.addEventListener('submit', syncResendEmail);
		syncResendEmail();
	}

	if (typeof window !== 'undefined') {
		setupVerifyEmailForm();
		document.addEventListener('astro:page-load', setupVerifyEmailForm);
	}
</script>
