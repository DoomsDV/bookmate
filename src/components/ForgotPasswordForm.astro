---
import '../styles/auth.css';

interface Props {
	error?: string;
	email?: string;
	emailError?: string;
	sent?: boolean;
}

const {
	error = '',
	email = '',
	emailError = '',
	sent = false,
} = Astro.props;

const successMessage =
	'Revisa tu bandeja de entrada. Si el correo está registrado, te enviamos un enlace seguro para crear tu nueva contraseña.';
---

<section class="auth-page">
	<div class="auth-fx" aria-hidden="true">
		<div class="auth-atmosphere"></div>
		<div class="auth-vignette"></div>
		<div class="auth-orb auth-orb-a"></div>
		<div class="auth-orb auth-orb-b"></div>
		<div class="auth-deco auth-deco-1"></div>
		<div class="auth-deco auth-deco-2"></div>
		<div class="auth-deco auth-deco-3"></div>
		<div class="auth-deco auth-deco-4"></div>
		<div class="auth-deco auth-deco-5"></div>
		<div class="auth-deco auth-deco-6"></div>
		<div class="auth-deco auth-deco-7"></div>
		<div class="auth-deco auth-wave auth-wave-1"></div>
		<div class="auth-deco auth-wave auth-wave-2"></div>
	</div>

	<header class="auth-topbar">
		<div class="auth-topbar-inner">
			<a href="/" class="auth-brand" aria-label="Hasel — Inicio">
				<img
					src="/icons/icon-64.png"
					alt=""
					class="auth-brand-logo"
					width="40"
					height="40"
					loading="eager"
					decoding="async"
				/>
				<span class="auth-brand-wordmark">Hasel</span>
			</a>
			<a href="/auth/login?switch_account=1" class="auth-topbar-cta">Iniciar sesión</a>
		</div>
	</header>

	<div class="auth-shell">
		<main class="auth-card">
			<header class="auth-card-header">
				<img
					src="/icons/icon-512x512.png"
					alt="Hasel"
					class="auth-card-logo"
					width="72"
					height="72"
					loading="eager"
					decoding="async"
				/>
				<h1 class="auth-title">{sent ? 'Revisá tu correo' : 'Recuperar contraseña'}</h1>
				<p class="auth-subtitle">
					{sent
						? 'Te enviamos las instrucciones para restablecer tu acceso.'
						: 'Ingresá tu correo y te enviaremos un enlace seguro para crear una nueva contraseña.'}
				</p>
			</header>

			{sent ? (
				<div class="auth-banner auth-banner-success" role="status" data-forgot-password-sent>
					<span class="material-symbols-rounded" aria-hidden="true">check_circle</span>
					<div>
						<p class="auth-banner-copy"><strong>Enlace enviado.</strong> {successMessage}</p>
						{email && (
							<p class="auth-banner-copy" style="margin-top:0.35rem;">
								Correo: <span class="auth-banner-email">{email}</span>
							</p>
						)}
					</div>
				</div>
			) : (
				<>
					{error && (
						<div class="auth-banner auth-banner-error" role="alert">
							<span class="material-symbols-rounded" aria-hidden="true">error</span>
							<span>{error}</span>
						</div>
					)}

					<form method="post" action="/api/auth/forgot-password" data-astro-reload>
						<div class="auth-field">
							<label class="auth-label" for="email">Correo electrónico</label>
							<input
								type="email"
								id="email"
								name="email"
								placeholder="Ej: usuario@empresa.com"
								value={email}
								class:list={['auth-input', emailError && 'is-invalid']}
								autocomplete="email"
								autocapitalize="none"
								spellcheck="false"
								inputmode="email"
								required
							/>
							{emailError && <span class="auth-field-error">{emailError}</span>}
						</div>

						<button type="submit" class="auth-btn auth-btn-primary auth-submit">
							Enviar enlace
						</button>
					</form>
				</>
			)}

			<footer class="auth-card-footer">
				<p class="auth-footer-text">
					{sent ? '¿Ya lo revisaste?' : '¿Recordaste tu contraseña?'}
					<a href="/auth/login?switch_account=1" class="auth-footer-link">
						<strong>Volver al login</strong>
					</a>
				</p>
			</footer>
		</main>
	</div>

	<footer class="auth-page-footer" aria-label="Copyright">
		<p>Hasel &copy; 2026</p>
	</footer>
</section>

<script>
	import { showFlashMessage } from '../lib/flash';

	const SUCCESS_MESSAGE =
		'Revisa tu bandeja de entrada. Encontrarás un enlace seguro con las instrucciones para crear tu nueva contraseña.';

	const showSentFlash = () => {
		if (!document.querySelector('[data-forgot-password-sent]')) return;
		if (document.querySelector('[data-flash-message]')) return;
		showFlashMessage({
			message: SUCCESS_MESSAGE,
			type: 'success',
			autoHideMs: 7000,
		});
	};

	showSentFlash();
	document.addEventListener('astro:page-load', showSentFlash);
</script>
