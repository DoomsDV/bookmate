---
import FlashMessage from './FlashMessage.astro';
import ServicesGrid from './ServicesGrid.astro';
import {
	ServicesApiError,
	ServicesClient,
	type Service,
} from '../lib/services';

interface Props {
	canManageServices?: boolean;
	currentPage?: number;
}

const PAGE_SIZE = 9;
const { canManageServices = false, currentPage: pageProp = 1 } = Astro.props;

const token = Astro.locals.token ?? '';
const rawPage = Number(pageProp || Astro.url.searchParams.get('page') || '1');
const currentPage = Number.isInteger(rawPage) && rawPage > 0 ? rawPage : 1;
const searchQuery = String(Astro.url.searchParams.get('search') || '').trim();
const rawIsActive = String(Astro.url.searchParams.get('is_active') || '').trim();
const isActiveFilter = rawIsActive === '0' || rawIsActive === '1' ? Number(rawIsActive) : null;

let services: Service[] = [];
let loadError = '';
let pagination = {
	current_page: currentPage,
	per_page: PAGE_SIZE,
	total_records: 0,
	total_pages: 1,
};

if (!token) {
	loadError = 'No hay sesion valida para consultar servicios.';
} else {
	try {
		const apiClient = new ServicesClient(token);
		const listResult = await apiClient.list(
			currentPage,
			PAGE_SIZE,
			searchQuery || undefined,
			isActiveFilter
		);
		services = listResult.data;
		pagination = listResult.meta;
	} catch (error) {
		loadError =
			error instanceof ServicesApiError
				? error.message
				: 'No fue posible cargar el listado de servicios.';
	}
}

const totalPages = Math.max(1, pagination.total_pages);
const safeCurrentPage = Math.min(Math.max(1, pagination.current_page), totalPages);
const canPrevPage = safeCurrentPage > 1;
const canNextPage = safeCurrentPage < totalPages;
---

{
	loadError ? (
		<FlashMessage message={loadError} type="error" expand={true} dismissible={false} />
	) : (
		<div class="grid gap-4" data-services-list>
			<ServicesGrid
				services={services}
				showCreateAction={canManageServices}
				searchQuery={searchQuery}
				isActiveFilter={isActiveFilter}
				totalRecords={pagination.total_records}
			/>

			<div class="app-pagination" data-services-pagination>
				<p class="app-pagination__summary" data-services-pagination-summary>
					Página <strong>{safeCurrentPage}</strong> de <strong>{totalPages}</strong>
					<span aria-hidden="true">-</span>
					Total: <strong>{pagination.total_records}</strong> servicios
				</p>

				<nav class="app-pagination__controls" aria-label="Paginacion servicios">
					<button
						type="button"
						class:list={['app-pagination__icon-button', !canPrevPage && 'is-disabled']}
						data-services-page-prev
						data-page={Math.max(1, safeCurrentPage - 1)}
						aria-label="Página anterior"
						disabled={!canPrevPage}
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6z"></path>
						</svg>
					</button>

					<span class="app-pagination__current" aria-current="page" data-services-pagination-current>
						{safeCurrentPage}
					</span>

					<button
						type="button"
						class:list={['app-pagination__icon-button', !canNextPage && 'is-disabled']}
						data-services-page-next
						data-page={Math.min(totalPages, safeCurrentPage + 1)}
						aria-label="Página siguiente"
						disabled={!canNextPage}
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"></path>
						</svg>
					</button>
				</nav>
			</div>
		</div>
	)
}
