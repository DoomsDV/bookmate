---
import FlashMessage from './FlashMessage.astro';
import ServicesGrid from './ServicesGrid.astro';
import AppPagination from './AppPagination.astro';
import {
	ServicesApiError,
	ServicesClient,
	type Service,
} from '../lib/services';

interface Props {
	canManageServices?: boolean;
	isProfessional?: boolean;
	currentPage?: number;
}

const PAGE_SIZE = 9;
const { canManageServices = false, isProfessional = false, currentPage: pageProp = 1 } = Astro.props;

const token = Astro.locals.token ?? '';
const rawPage = Number(pageProp || Astro.url.searchParams.get('page') || '1');
const currentPage = Number.isInteger(rawPage) && rawPage > 0 ? rawPage : 1;
const searchQuery = String(Astro.url.searchParams.get('search') || '').trim();
const rawIsActive = String(Astro.url.searchParams.get('is_active') || '').trim();
const isActiveFilter = rawIsActive === '0' || rawIsActive === '1' ? Number(rawIsActive) : null;

let services: Service[] = [];
let loadError = '';
let pagination = {
	current_page: currentPage,
	per_page: PAGE_SIZE,
	total_records: 0,
	total_pages: 1,
};

if (!token) {
	loadError = 'No hay sesion valida para consultar servicios.';
} else {
	try {
		const apiClient = new ServicesClient(token);
		const listResult = await apiClient.list(
			currentPage,
			PAGE_SIZE,
			searchQuery || undefined,
			isActiveFilter
		);
		services = listResult.data;
		pagination = listResult.meta;
	} catch (error) {
		loadError =
			error instanceof ServicesApiError
				? error.message
				: 'No fue posible cargar el listado de servicios.';
	}
}

const totalPages = Math.max(1, pagination.total_pages);
const safeCurrentPage = Math.min(Math.max(1, pagination.current_page), totalPages);
---

{
	loadError ? (
		<FlashMessage message={loadError} type="error" expand={true} dismissible={false} />
	) : (
		<div
			class="grid gap-4"
			data-services-list
			data-services-can-manage={canManageServices ? 'true' : 'false'}
			data-services-assigned-only={isProfessional ? 'true' : 'false'}
		>
			<ServicesGrid
				services={services}
				showCreateAction={canManageServices}
				searchQuery={searchQuery}
				isActiveFilter={isActiveFilter}
				totalRecords={pagination.total_records}
				isProfessional={isProfessional}
			/>

			<AppPagination
				currentPage={safeCurrentPage}
				totalPages={totalPages}
				totalRecords={pagination.total_records}
				recordLabel="servicios"
				ariaLabel="Paginacion servicios"
				rootDataAttr="data-services-pagination"
				summaryDataAttr="data-services-pagination-summary"
				pagesDataAttr="data-services-pagination-pages"
				prevDataAttr="data-services-page-prev"
				nextDataAttr="data-services-page-next"
				pageDataAttr="data-services-page"
			/>
		</div>
	)
}
