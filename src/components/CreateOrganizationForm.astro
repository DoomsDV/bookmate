---
import '../styles/auth.css';
import type { OrgSpecialtyOption } from '../lib/auth';

interface Props {
	error?: string;
	fromMultiOrgSelection?: boolean;
	organizationCount?: number;
	businessName?: string;
	phone?: string;
	companyEmail?: string;
	orgSpecialtyId?: string;
	orgSpecialties?: OrgSpecialtyOption[];
	specialtiesLoadError?: string;
	businessNameError?: string;
	phoneError?: string;
	companyEmailError?: string;
	orgSpecialtyIdError?: string;
}

const {
	error = '',
	fromMultiOrgSelection = false,
	organizationCount = 0,
	businessName = '',
	phone = '',
	companyEmail = '',
	orgSpecialtyId = '',
	orgSpecialties = [],
	specialtiesLoadError = '',
	businessNameError = '',
	phoneError = '',
	companyEmailError = '',
	orgSpecialtyIdError = '',
} = Astro.props;

const selectionNotice = fromMultiOrgSelection
	? organizationCount > 0
		? `Estás usando tu cuenta actual (ya tienes acceso a ${organizationCount} organizaciones). Al finalizar, entrarás directamente al panel de tu nuevo negocio.`
		: 'Estás usando tu cuenta actual. Al finalizar, entrarás directamente al panel de tu nuevo negocio.'
	: '';

const backHref = fromMultiOrgSelection ? '/auth/select-org' : '/panel/dashboard';
const backLabel = fromMultiOrgSelection ? 'Elegir otra organización' : 'Volver al panel';
---

<section class="auth-page" data-create-org-root>
	<div class="auth-fx" aria-hidden="true">
		<div class="auth-atmosphere"></div>
		<div class="auth-vignette"></div>
		<div class="auth-orb auth-orb-a"></div>
		<div class="auth-orb auth-orb-b"></div>
		<div class="auth-deco auth-deco-1"></div>
		<div class="auth-deco auth-deco-2"></div>
		<div class="auth-deco auth-deco-3"></div>
		<div class="auth-deco auth-deco-4"></div>
		<div class="auth-deco auth-deco-5"></div>
		<div class="auth-deco auth-deco-6"></div>
		<div class="auth-deco auth-deco-7"></div>
		<div class="auth-deco auth-wave auth-wave-1"></div>
		<div class="auth-deco auth-wave auth-wave-2"></div>
	</div>

	<header class="auth-topbar">
		<div class="auth-topbar-inner">
			<a href="/" class="auth-brand" aria-label="Hasel — Inicio">
				<img
					src="/icons/icon-64.png"
					alt=""
					class="auth-brand-logo"
					width="40"
					height="40"
					loading="eager"
					decoding="async"
				/>
				<span class="auth-brand-wordmark">Hasel</span>
			</a>
			<a href={backHref} class="auth-topbar-cta">{backLabel}</a>
		</div>
	</header>

	<div class="auth-shell">
		<main class="auth-card auth-card--wide">
			<header class="auth-card-header">
				<img
					src="/icons/icon-512x512.png"
					alt="Hasel"
					class="auth-card-logo"
					width="72"
					height="72"
					loading="eager"
					decoding="async"
				/>
				<h1 class="auth-title">Crear tu organización</h1>
				<p class="auth-subtitle">Configurá los datos de tu nuevo espacio de trabajo.</p>
			</header>

			{selectionNotice && (
				<div class="auth-banner auth-banner-info" role="status">
					<span class="material-symbols-rounded" aria-hidden="true">verified_user</span>
					<span>{selectionNotice}</span>
				</div>
			)}

			<div class:list={['auth-banner', 'auth-banner-error', !error && 'auth-is-hidden']} data-error-banner role="alert">
				<span class="material-symbols-rounded" aria-hidden="true">error</span>
				<span data-error-text>{error}</span>
			</div>

			<form method="post" action="/api/organization/create" data-create-org-form novalidate>
				<div class="auth-form-grid auth-form-grid--2">
					<div class="auth-field">
						<label class="auth-label" for="business_name">Nombre de la organización</label>
						<input
							type="text"
							id="business_name"
							name="business_name"
							class:list={['auth-input', businessNameError && 'is-invalid']}
							placeholder="Ej: Clínica Dental San José"
							value={businessName}
							autocomplete="organization"
							required
						/>
						<p class="auth-field-help">Así te verán tus clientes y tu equipo.</p>
						{businessNameError && <span class="auth-field-error">{businessNameError}</span>}
					</div>

					<div class="auth-field">
						<label class="auth-label" for="company_email">Correo de la compañía</label>
						<input
							type="email"
							id="company_email"
							name="company_email"
							class:list={['auth-input', companyEmailError && 'is-invalid']}
							placeholder="Ej: contacto@tuempresa.com"
							value={companyEmail}
							autocomplete="email"
							spellcheck="false"
							required
						/>
						<p class="auth-field-help">Contacto principal para notificaciones institucionales.</p>
						{companyEmailError && <span class="auth-field-error">{companyEmailError}</span>}
					</div>
				</div>

				<div class="auth-form-grid auth-form-grid--2" style="margin-top: 1.15rem;">
					<div class="auth-field">
						<label class="auth-label" for="phone">Teléfono corporativo</label>
						<div class:list={['auth-phone-group', phoneError && 'is-invalid']}>
							<span class="auth-phone-prefix">+595</span>
							<input
								type="tel"
								id="phone"
								name="phone"
								inputmode="numeric"
								autocomplete="tel-national"
								maxlength="11"
								class:list={['auth-input', 'auth-phone-input', phoneError && 'is-invalid']}
								placeholder="981 123 456"
								value={phone}
								spellcheck="false"
								required
							/>
						</div>
						{phoneError && <span class="auth-field-error">{phoneError}</span>}
					</div>

					<div class="auth-field">
						<label class="auth-label" for="id_org_specialty">Especialidad de la organización</label>
						<div class="auth-select-wrap">
							<select
								id="id_org_specialty"
								name="id_org_specialty"
								class:list={['auth-input', 'auth-select', orgSpecialtyIdError && 'is-invalid']}
								required
								disabled={orgSpecialties.length === 0}
							>
								<option value="">Seleccioná una especialidad</option>
								{orgSpecialties.map((specialty) => (
									<option
										value={String(specialty.id_org_specialty)}
										selected={String(specialty.id_org_specialty) === orgSpecialtyId}
									>
										{specialty.name}
									</option>
								))}
							</select>
						</div>
						{specialtiesLoadError && <span class="auth-field-error">{specialtiesLoadError}</span>}
						{orgSpecialtyIdError && <span class="auth-field-error">{orgSpecialtyIdError}</span>}
					</div>
				</div>

				<div class="auth-actions auth-actions--between">
					<a href={backHref} class="auth-btn auth-btn-tonal">{backLabel}</a>
					<button type="submit" class="auth-btn auth-btn-primary" disabled={orgSpecialties.length === 0}>
						Crear organización
					</button>
				</div>
			</form>
		</main>
	</div>

	<footer class="auth-page-footer" aria-label="Pie de página">
		<p>
			Hasel &copy; 2026
			<span class="auth-page-footer-sep" aria-hidden="true">|</span>
			<a href="/politicas-y-privacidad" class="auth-page-footer-link">Políticas de privacidad</a>
		</p>
	</footer>
</section>

<script is:inline>
	function setupCreateOrganizationForm() {
		const root = document.querySelector('[data-create-org-root]');
		const form = root?.querySelector('[data-create-org-form]');
		if (!form || form.dataset.enhanced) return;
		form.dataset.enhanced = 'true';

		const errorBanner = root.querySelector('[data-error-banner]');
		const errorText = root.querySelector('[data-error-text]');
		const phoneInput = form.querySelector('[name="phone"]');
		const submitButton = form.querySelector('button[type="submit"]');

		const toParaguayLocalPhoneDigits = (rawValue) => {
			let digits = String(rawValue || '').replace(/\D/g, '');
			if (digits.startsWith('00595')) digits = digits.slice(5);
			if (digits.startsWith('595')) digits = digits.slice(3);
			if (digits.startsWith('0')) digits = digits.slice(1);
			return digits.slice(0, 9);
		};

		const formatParaguayLocalPhone = (rawValue) => {
			const digits = toParaguayLocalPhoneDigits(rawValue);
			if (!digits) return '';
			if (digits.length <= 3) return digits;
			if (digits.length <= 6) return `${digits.slice(0, 3)} ${digits.slice(3)}`;
			return `${digits.slice(0, 3)} ${digits.slice(3, 6)} ${digits.slice(6, 9)}`;
		};

		const toParaguayE164Phone = (rawValue) => {
			const digits = toParaguayLocalPhoneDigits(rawValue);
			return digits ? `+595${digits}` : '';
		};

		const setErrorMessage = (message) => {
			const cleanMessage = String(message || '').trim() || 'No fue posible crear la organización.';
			if (errorText) errorText.textContent = cleanMessage;
			errorBanner?.classList.remove('auth-is-hidden');
		};

		const clearErrorMessage = () => {
			if (errorText) errorText.textContent = '';
			errorBanner?.classList.add('auth-is-hidden');
		};

		if (phoneInput instanceof HTMLInputElement) {
			phoneInput.value = formatParaguayLocalPhone(phoneInput.value);
			phoneInput.addEventListener('input', () => {
				phoneInput.value = formatParaguayLocalPhone(phoneInput.value);
			});
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			clearErrorMessage();

			if (!form.reportValidity()) return;

			const formData = new FormData(form);
			const payload = {
				business_name: String(formData.get('business_name') || '').trim(),
				company_email: String(formData.get('company_email') || '').trim(),
				phone:
					phoneInput instanceof HTMLInputElement
						? toParaguayE164Phone(phoneInput.value)
						: String(formData.get('phone') || '').trim(),
				id_org_specialty: Number(String(formData.get('id_org_specialty') || '').trim()),
			};

			const previousText = submitButton?.textContent || '';
			if (submitButton) {
				submitButton.disabled = true;
				submitButton.textContent = 'Creando...';
			}

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						Accept: 'application/json',
					},
					credentials: 'same-origin',
					body: JSON.stringify(payload),
				});

				let data = null;
				try {
					data = await response.json();
				} catch {
					data = null;
				}

				if (!response.ok) {
					if (data?.emailVerificationRequired && typeof data.redirect === 'string') {
						window.location.assign(data.redirect);
						return;
					}
					const fieldMessage = Array.isArray(data?.errors)
						? data.errors.find((item) => item?.message)?.message
						: '';
					setErrorMessage(data?.message || fieldMessage || 'No fue posible crear la organización.');
					return;
				}

				if (typeof data?.redirect === 'string' && data.redirect.trim()) {
					window.location.assign(data.redirect);
					return;
				}

				window.location.assign('/panel/dashboard');
			} catch {
				setErrorMessage('No pudimos comunicarnos con el servidor. Inténtalo de nuevo.');
			} finally {
				if (submitButton) {
					submitButton.disabled = false;
					submitButton.textContent = previousText;
				}
			}
		});
	}

	if (typeof window !== 'undefined') {
		setupCreateOrganizationForm();
		document.addEventListener('astro:page-load', setupCreateOrganizationForm);
	}
</script>
