---
import { FEATURE_FLAGS } from '../config/feature-flags';
---

{FEATURE_FLAGS.APPOINTMENT_AI_VOICE && (
	<agenda-scan-preview>
				<dialog class="agenda-preview-shell" data-agenda-preview-shell aria-label="Revisar reservas detectadas">
			<div class="agenda-preview-dialog">
				<div class="agenda-preview-sheet-handle" aria-hidden="true">
					<span class="agenda-preview-sheet-handle__pill"></span>
				</div>
				<header class="agenda-preview-header">
					<div class="agenda-preview-heading">
						<span class="agenda-preview-mark" aria-hidden="true">
							<span class="material-symbols-rounded">calendar_add_on</span>
						</span>
						<div class="agenda-preview-heading__copy">
							<h2 class="agenda-preview-title">Reservas detectadas</h2>
							<p class="agenda-preview-subtitle">Revisá y corregí antes de guardar</p>
						</div>
					</div>
					<p class="agenda-preview-pending" aria-live="polite">
						<span data-agenda-preview-count>0</span>
						<span data-agenda-preview-pending-label>pendientes</span>
					</p>
					<button
						type="button"
						class="agenda-preview-close"
						data-agenda-preview-close
						aria-label="Cerrar"
					>
						<span class="material-symbols-rounded">close</span>
					</button>
				</header>

				<div class="agenda-preview-defaults" data-agenda-preview-defaults>
					<button
						type="button"
						class="agenda-preview-defaults__toggle"
						data-agenda-defaults-toggle
						aria-expanded="false"
						aria-controls="agenda-preview-defaults-panel"
					>
						<span class="agenda-preview-defaults__toggle-copy">
							<span class="agenda-preview-defaults__toggle-title">Asignación</span>
							<span class="agenda-preview-defaults__summary" data-agenda-defaults-summary hidden></span>
						</span>
						<span class="agenda-preview-defaults__chevron" aria-hidden="true">
							<span class="material-symbols-rounded">expand_more</span>
						</span>
					</button>
					<p class="agenda-preview-defaults__caption">Asignación global por defecto</p>
					<div
						class="agenda-preview-defaults__reveal"
						id="agenda-preview-defaults-panel"
						data-agenda-defaults-panel
					>
						<div class="agenda-preview-defaults__fields">
							<div class="agenda-preview-defaults__field">
								<label>Profesional</label>
								<div class="agenda-preview-select">
									<select data-agenda-default-professional>
										<option value="">Profesional</option>
									</select>
									<span class="agenda-preview-select__chevron" aria-hidden="true">
										<span class="material-symbols-rounded">expand_more</span>
									</span>
								</div>
							</div>
							<div class="agenda-preview-defaults__field">
								<label>Sucursal</label>
								<div class="agenda-preview-select">
									<select data-agenda-default-location>
										<option value="">Sucursal</option>
									</select>
									<span class="agenda-preview-select__chevron" aria-hidden="true">
										<span class="material-symbols-rounded">expand_more</span>
									</span>
								</div>
							</div>
							<div class="agenda-preview-defaults__field agenda-preview-defaults__field--service">
								<label>Servicio</label>
								<div class="agenda-preview-select">
									<select data-agenda-default-service>
										<option value="">Servicio</option>
									</select>
									<span class="agenda-preview-select__chevron" aria-hidden="true">
										<span class="material-symbols-rounded">expand_more</span>
									</span>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="agenda-preview-body">
					<div class="agenda-preview-image-pane" data-agenda-preview-image-pane>
						<div class="agenda-preview-image-toolbar">
							<button type="button" tabindex="-1" data-agenda-zoom-out aria-label="Alejar">
								<span class="material-symbols-rounded" aria-hidden="true">zoom_out</span>
							</button>
							<button type="button" tabindex="-1" data-agenda-zoom-in aria-label="Acercar">
								<span class="material-symbols-rounded" aria-hidden="true">zoom_in</span>
							</button>
						</div>
						<div class="agenda-preview-image-frame" data-agenda-image-frame>
							<img data-agenda-preview-image alt="Agenda escaneada" />
						</div>
					</div>

					<div class="agenda-preview-rows-pane">
						<p class="agenda-preview-error hidden" data-agenda-preview-error role="alert"></p>
						<div class="agenda-preview-tablehead" aria-hidden="true">
							<span>Cliente</span>
							<span>Fecha y hora</span>
							<span>Servicio</span>
							<span>Profesional</span>
							<span class="agenda-preview-tablehead__action"></span>
						</div>
						<div class="agenda-preview-rows" data-agenda-preview-rows></div>
						<button type="button" class="agenda-preview-addrow" data-agenda-add-row>
							<span class="material-symbols-rounded" aria-hidden="true">add</span>
							Agregar cita
						</button>
					</div>
				</div>

				<footer class="agenda-preview-footer">
					<button type="button" class="agenda-preview-save" data-agenda-preview-save>
						<span class="material-symbols-rounded text-[1.2rem]" aria-hidden="true">save</span>
						<span data-agenda-save-label>Completar y guardar</span>
					</button>
				</footer>
			</div>
		<div class="agenda-preview-cal" data-agenda-cal hidden>
			<div class="agenda-preview-cal__nav">
				<button type="button" data-agenda-cal-prev aria-label="Mes anterior">
					<span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
				</button>
				<p class="agenda-preview-cal__label" data-agenda-cal-label></p>
				<button type="button" data-agenda-cal-next aria-label="Mes siguiente">
					<span class="material-symbols-rounded" aria-hidden="true">chevron_right</span>
				</button>
			</div>
			<div class="agenda-preview-cal__weekdays" aria-hidden="true">
				<span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span>
			</div>
			<div class="agenda-preview-cal__days" data-agenda-cal-days></div>
		</div>
		<div class="agenda-preview-times" data-agenda-times hidden role="listbox" id="agenda-preview-times-list"></div>
		</dialog>
	</agenda-scan-preview>
)}

<style is:global>
	agenda-scan-preview {
		display: block;
	}

	.agenda-preview-shell {
		--agenda-ease: cubic-bezier(0.32, 0.72, 0, 1);
		position: fixed;
		inset: 0;
		z-index: 10000;
		margin: 0;
		padding: 0;
		border: 0;
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		background: transparent;
		color: var(--on-surface);
		overscroll-behavior: contain;
	}

	.agenda-preview-shell[open] {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		justify-content: flex-end;
		animation: agenda-preview-sheet-in var(--modal-open-duration) var(--modal-easing);
	}

	/* Sobrescribe el fondo global de dialog: solo debe verse el sheet/drawer. */
	dialog.agenda-preview-shell[open] {
		background: transparent;
		background-color: transparent;
		background-image: none;
		box-shadow: none;
		overflow: visible;
	}

	.agenda-preview-shell::backdrop {
		animation: agenda-preview-backdrop-in var(--modal-open-duration) var(--modal-easing);
	}

	.agenda-preview-shell.is-closing {
		animation: agenda-preview-sheet-out var(--modal-close-duration) var(--modal-easing) forwards;
	}

	.agenda-preview-shell.is-closing::backdrop {
		animation: agenda-preview-backdrop-out var(--modal-close-duration) var(--modal-easing) forwards;
	}

	.agenda-preview-dialog {
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100dvh;
		max-height: 100dvh;
		background: var(--surface-bright);
		border: 1px solid var(--shell-border);
		border-bottom: 0;
		border-radius: 1.8rem 1.8rem 0 0;
		box-shadow: 0 -18px 60px rgba(15, 23, 42, 0.18);
		overflow: hidden;
		color-scheme: light;
	}

	html[data-theme='dark'] .agenda-preview-dialog {
		color-scheme: dark;
		box-shadow: 0 -18px 60px rgba(0, 0, 0, 0.45);
	}

	.agenda-preview-sheet-handle {
		display: flex;
		justify-content: center;
		padding: 0.55rem 0 0.1rem;
		flex-shrink: 0;
	}

	.agenda-preview-sheet-handle__pill {
		width: 2.35rem;
		height: 0.28rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--on-surface-variant) 42%, transparent);
	}

	@keyframes agenda-preview-sheet-in {
		from {
			opacity: 0;
			transform: translateY(100%);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes agenda-preview-sheet-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(100%);
		}
	}

	@keyframes agenda-preview-drawer-in {
		from {
			opacity: 0;
			transform: translateX(100%);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@keyframes agenda-preview-drawer-out {
		from {
			opacity: 1;
			transform: translateX(0);
		}
		to {
			opacity: 0;
			transform: translateX(100%);
		}
	}

	@keyframes agenda-preview-backdrop-in {
		from {
			opacity: 0;
			backdrop-filter: blur(0);
			-webkit-backdrop-filter: blur(0);
		}
		to {
			opacity: 1;
			backdrop-filter: blur(var(--modal-backdrop-blur));
			-webkit-backdrop-filter: blur(var(--modal-backdrop-blur));
		}
	}

	@keyframes agenda-preview-backdrop-out {
		from {
			opacity: 1;
			backdrop-filter: blur(var(--modal-backdrop-blur));
			-webkit-backdrop-filter: blur(var(--modal-backdrop-blur));
		}
		to {
			opacity: 0;
			backdrop-filter: blur(0);
			-webkit-backdrop-filter: blur(0);
		}
	}

	/* Desktop: drawer lateral desde la derecha. */
	@media (min-width: 641px) {
		.agenda-preview-shell[open] {
			flex-direction: row;
			align-items: stretch;
			justify-content: flex-end;
			padding: 0;
			animation-name: agenda-preview-drawer-in;
		}

		.agenda-preview-shell.is-closing {
			animation-name: agenda-preview-drawer-out;
		}

		html[data-theme='dark'] .agenda-preview-dialog {
			box-shadow: -22px 0 56px rgba(0, 0, 0, 0.5);
		}

		.agenda-preview-sheet-handle {
			display: none;
		}

		.agenda-preview-dialog {
			width: min(92vw, 90rem);
			height: 100dvh;
			max-height: 100dvh;
			border-radius: 0;
			border: 0;
			border-left: 1px solid var(--shell-border);
			box-shadow: -18px 0 48px rgba(15, 23, 42, 0.22);
		}

		.agenda-preview-header {
			padding-left: 1.75rem;
			padding-right: 1.75rem;
		}

		.agenda-preview-defaults {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: 0.55rem;
			padding: 0.95rem 1.75rem 1.1rem;
			background: color-mix(in srgb, var(--surface-variant) 48%, var(--surface-bright));
		}

		.agenda-preview-defaults__toggle {
			display: none;
		}

		.agenda-preview-defaults__caption {
			display: block;
		}

		.agenda-preview-defaults__reveal {
			display: block;
		}

		.agenda-preview-defaults__fields {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			align-items: end;
			gap: 0.55rem 1rem;
			overflow: visible;
			min-height: 0;
		}

		.agenda-preview-defaults__field {
			min-width: 0;
			flex: none;
		}

		.agenda-preview-rows {
			padding: 0.35rem 1.75rem 0;
		}

		.agenda-preview-tablehead {
			padding-left: 1.75rem;
			padding-right: 1.75rem;
		}

		.agenda-preview-addrow {
			margin-left: 1.75rem;
			margin-right: 1.75rem;
		}

		.agenda-preview-error {
			margin-left: 1.75rem;
			margin-right: 1.75rem;
		}

		.agenda-preview-footer {
			padding-left: 1.75rem;
			padding-right: 1.75rem;
		}
	}

	.agenda-preview-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.95rem 1.2rem;
		border-bottom: 1px solid color-mix(in srgb, var(--shell-border) 70%, transparent);
		background: var(--surface-bright);
	}

	.agenda-preview-heading {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		min-width: 0;
		flex: 1;
	}

	.agenda-preview-heading__copy {
		min-width: 0;
	}

	.agenda-preview-pending {
		margin: 0;
		margin-left: auto;
		flex-shrink: 0;
		font-size: 0.78rem;
		font-weight: 650;
		letter-spacing: 0.01em;
		color: color-mix(in srgb, var(--on-surface-variant) 88%, transparent);
		white-space: nowrap;
		transition: color 520ms cubic-bezier(0.32, 0.72, 0, 1);
	}

	.agenda-preview-mark {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		flex-shrink: 0;
		border-radius: 0.9rem;
		background: color-mix(in srgb, var(--primary) 14%, transparent);
		color: var(--primary);
	}

	.agenda-preview-mark .material-symbols-rounded {
		display: block;
		width: 1.35rem;
		height: 1.35rem;
		font-size: 1.35rem;
		line-height: 1.35rem;
		font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24;
		overflow: hidden;
		text-align: center;
	}

	.agenda-preview-title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 800;
	}

	.agenda-preview-subtitle {
		margin: 0.1rem 0 0;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--on-surface-variant);
	}

	.agenda-preview-close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.35rem;
		height: 2.35rem;
		border: 1px solid color-mix(in srgb, var(--on-surface) 10%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-variant) 72%, transparent);
		color: var(--on-surface-variant);
		cursor: pointer;
		flex-shrink: 0;
		transition: background 220ms var(--agenda-ease), color 220ms var(--agenda-ease), border-color 220ms var(--agenda-ease), transform 220ms var(--agenda-ease);
	}

	.agenda-preview-close:hover {
		background: color-mix(in srgb, var(--surface-variant) 92%, transparent);
		color: var(--on-surface);
		border-color: color-mix(in srgb, var(--on-surface) 16%, transparent);
	}

	.agenda-preview-close:active {
		transform: scale(0.94);
	}

	.agenda-preview-close:focus-visible {
		outline: none;
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 28%, transparent);
	}

	.agenda-preview-defaults {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.65rem;
		padding: 0.8rem 1.2rem;
		border-bottom: 1px solid color-mix(in srgb, var(--shell-border) 55%, transparent);
		background: color-mix(in srgb, var(--surface-variant) 38%, transparent);
		position: relative;
		z-index: 4;
	}

	.agenda-preview-defaults:has(.panel-themed-select.is-open) {
		z-index: 12;
	}

	.agenda-preview-defaults__toggle {
		display: none;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		width: 100%;
		min-height: 2.75rem;
		margin: 0;
		padding: 0.35rem 0.25rem;
		border: 0;
		border-radius: 0.7rem;
		background: transparent;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.agenda-preview-defaults__toggle:focus-visible {
		outline: none;
		box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary) 28%, transparent);
	}

	.agenda-preview-defaults__toggle-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.12rem;
		min-width: 0;
		flex: 1;
	}

	.agenda-preview-defaults__toggle-title {
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--on-surface-variant);
	}

	.agenda-preview-defaults__summary {
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 0.78rem;
		font-weight: 650;
		line-height: 1.3;
		color: var(--on-surface);
	}

	.agenda-preview-defaults__summary[hidden] {
		display: none;
	}

	.agenda-preview-defaults__chevron {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		flex-shrink: 0;
		color: var(--on-surface-variant);
		transition: transform 220ms var(--modal-easing, cubic-bezier(0.4, 0, 0.2, 1));
	}

	.agenda-preview-defaults.is-open .agenda-preview-defaults__chevron {
		transform: rotate(180deg);
	}

	.agenda-preview-defaults__chevron .material-symbols-rounded {
		font-size: 1.35rem;
		line-height: 1;
		font-variation-settings: 'FILL' 0, 'wght' 500, 'GRAD' 0, 'opsz' 24;
	}

	.agenda-preview-defaults__caption {
		display: none;
		margin: 0;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--on-surface-variant);
	}

	.agenda-preview-defaults__fields {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 0.65rem;
		min-height: 0;
	}

	.agenda-preview-defaults__field {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 8.5rem;
		flex: 1 1 8.5rem;
	}

	.agenda-preview-defaults__field label {
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--on-surface-variant);
	}

	/* Listbox custom (mismo widget que Intervalo de reserva en Settings). */
	.agenda-preview-select {
		position: relative;
		overflow: visible;
	}

	.agenda-preview-defaults .panel-themed-select,
	.agenda-preview-defaults .schedule-themed-select {
		width: 100%;
	}

	.agenda-preview-defaults .panel-modal-select__trigger {
		font-weight: 700;
	}

	.agenda-preview-select__chevron {
		pointer-events: none;
		position: absolute;
		inset-block: 0;
		right: 1rem;
		display: flex;
		align-items: center;
		color: var(--on-surface-variant);
	}

	.agenda-preview-select__chevron .material-symbols-rounded {
		font-size: 1.25rem;
		line-height: 1;
		font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
	}

	.agenda-preview-defaults__field input,
	.agenda-preview-defaults__field select {
		width: 100%;
		appearance: none;
		-webkit-appearance: none;
		min-height: 0;
		padding: 0.75rem 2.75rem 0.75rem 1rem;
		border-radius: 0.75rem;
		border: 1px solid var(--shell-border);
		background: var(--surface-bright);
		color: var(--on-surface);
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.25;
		outline: none;
		cursor: pointer;
		box-sizing: border-box;
		text-overflow: ellipsis;
		white-space: nowrap;
		overflow: hidden;
		transition: border-color 240ms var(--agenda-ease), box-shadow 240ms var(--agenda-ease), background-color 240ms var(--agenda-ease);
	}

	.agenda-preview-defaults__field input:hover,
	.agenda-preview-defaults__field select:hover {
		border-color: color-mix(in srgb, var(--on-surface-variant) 40%, transparent);
	}

	.agenda-preview-defaults__field select option,
	.agenda-preview-row__control select option {
		background-color: var(--surface-bright, #1c1c1e);
		color: var(--on-surface, #f5f5f5);
		padding: 0.35rem 0.55rem;
		min-height: 1.9rem;
		font-size: 0.88rem;
		font-weight: 600;
		line-height: 1.3;
		text-indent: 0;
	}

	html[data-theme='dark'] .agenda-preview-defaults__field select option,
	html[data-theme='dark'] .agenda-preview-row__control select option {
		background-color: #1c1c1e;
		color: #f3f4f6;
	}

	html[data-theme='dark'] .agenda-preview-defaults__field input[type='date'],
	html[data-theme='dark'] .agenda-preview-row__control input[type='date'],
	html[data-theme='dark'] .agenda-preview-row__control input[type='time'] {
		color-scheme: dark;
	}

	html[data-theme='dark'] .agenda-preview-defaults__field input[type='date']::-webkit-calendar-picker-indicator,
	html[data-theme='dark'] .agenda-preview-row__control input[type='date']::-webkit-calendar-picker-indicator,
	html[data-theme='dark'] .agenda-preview-row__control input[type='time']::-webkit-calendar-picker-indicator {
		cursor: pointer;
