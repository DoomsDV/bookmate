---
import { FEATURE_FLAGS } from '../config/feature-flags';
---

{FEATURE_FLAGS.APPOINTMENT_AI_VOICE && (
	<agenda-scan-preview>
		<dialog class="agenda-preview-shell" data-agenda-preview-shell aria-label="Revisar citas detectadas">
			<div class="agenda-preview-dialog">
				<header class="agenda-preview-header">
					<div class="agenda-preview-heading">
						<span class="agenda-preview-mark material-symbols-rounded" aria-hidden="true">
							calendar_add_on
						</span>
						<div>
							<h2 class="agenda-preview-title">
								Citas detectadas (<span data-agenda-preview-count>0</span>)
							</h2>
							<p class="agenda-preview-subtitle">Revisá y corregí antes de guardar</p>
						</div>
					</div>
					<button
						type="button"
						class="agenda-preview-close"
						data-agenda-preview-close
						aria-label="Cerrar"
					>
						<span class="material-symbols-rounded">close</span>
					</button>
				</header>

				<div class="agenda-preview-defaults" data-agenda-preview-defaults>
					<div class="agenda-preview-defaults__field">
						<label>Fecha objetivo</label>
						<input type="date" data-agenda-default-date />
					</div>
					<div class="agenda-preview-defaults__field">
						<label>Profesional</label>
						<select data-agenda-default-professional>
							<option value="">—</option>
						</select>
					</div>
					<div class="agenda-preview-defaults__field">
						<label>Sucursal</label>
						<select data-agenda-default-location>
							<option value="">—</option>
						</select>
					</div>
					<button type="button" class="agenda-preview-apply" data-agenda-apply-defaults>
						Aplicar a todas
					</button>
				</div>

				<div class="agenda-preview-body">
					<div class="agenda-preview-image-pane" data-agenda-preview-image-pane>
						<div class="agenda-preview-image-toolbar">
							<button type="button" data-agenda-zoom-out aria-label="Alejar">
								<span class="material-symbols-rounded">zoom_out</span>
							</button>
							<button type="button" data-agenda-zoom-in aria-label="Acercar">
								<span class="material-symbols-rounded">zoom_in</span>
							</button>
						</div>
						<div class="agenda-preview-image-frame" data-agenda-image-frame>
							<img data-agenda-preview-image alt="Agenda escaneada" />
						</div>
					</div>

					<div class="agenda-preview-rows-pane">
						<p class="agenda-preview-error hidden" data-agenda-preview-error role="alert"></p>
						<div class="agenda-preview-rows" data-agenda-preview-rows></div>
						<button type="button" class="agenda-preview-addrow" data-agenda-add-row>
							<span class="material-symbols-rounded" aria-hidden="true">add</span>
							Agregar cita
						</button>
					</div>
				</div>

				<footer class="agenda-preview-footer">
					<button type="button" class="agenda-preview-cancel" data-agenda-preview-cancel>
						Cancelar
					</button>
					<button type="button" class="agenda-preview-save" data-agenda-preview-save>
						Guardar <span data-agenda-save-count>0</span> citas
					</button>
				</footer>
			</div>
		</dialog>
	</agenda-scan-preview>
)}

<style is:global>
	agenda-scan-preview {
		display: block;
	}

	.agenda-preview-shell {
		position: fixed;
		inset: 0;
		margin: 0;
		padding: 0;
		border: 0;
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		background: transparent;
		color: var(--on-surface);
	}

	.agenda-preview-shell::backdrop {
		background: rgba(15, 23, 42, 0.5);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	.agenda-preview-dialog {
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100%;
		background: var(--surface-bright);
		overflow: hidden;
	}

	.agenda-preview-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.85rem 1.1rem;
		border-bottom: 1px solid color-mix(in srgb, var(--shell-border) 75%, transparent);
	}

	.agenda-preview-heading {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		min-width: 0;
	}

	.agenda-preview-mark {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.9rem;
		background: color-mix(in srgb, var(--primary) 14%, transparent);
		color: var(--primary);
	}

	.agenda-preview-title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 800;
	}

	.agenda-preview-subtitle {
		margin: 0.1rem 0 0;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--on-surface-variant);
	}

	.agenda-preview-close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.35rem;
		height: 2.35rem;
		border: 1px solid color-mix(in srgb, var(--on-surface) 10%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-variant) 72%, transparent);
		color: var(--on-surface-variant);
		cursor: pointer;
		flex-shrink: 0;
	}

	.agenda-preview-defaults {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 0.6rem;
		padding: 0.7rem 1.1rem;
		border-bottom: 1px solid color-mix(in srgb, var(--shell-border) 60%, transparent);
		background: color-mix(in srgb, var(--surface-variant) 45%, transparent);
	}

	.agenda-preview-defaults__field {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 8.5rem;
		flex: 1 1 8.5rem;
	}

	.agenda-preview-defaults__field label {
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--on-surface-variant);
	}

	.agenda-preview-defaults__field input,
	.agenda-preview-defaults__field select,
	.agenda-preview-row input,
	.agenda-preview-row select {
		width: 100%;
		padding: 0.45rem 0.55rem;
		border-radius: 0.6rem;
		border: 1px solid var(--shell-border);
		background: var(--surface-bright);
		color: var(--on-surface);
		font-size: 0.85rem;
		font-weight: 600;
	}

	.agenda-preview-apply {
		padding: 0.5rem 0.9rem;
		border-radius: 0.6rem;
		border: 1px solid color-mix(in srgb, var(--primary) 40%, var(--shell-border));
		background: color-mix(in srgb, var(--primary) 10%, transparent);
		color: var(--primary);
		font-size: 0.8rem;
		font-weight: 800;
		cursor: pointer;
		white-space: nowrap;
	}

	.agenda-preview-body {
		display: flex;
		flex: 1;
		min-height: 0;
		overflow: hidden;
	}

	.agenda-preview-image-pane {
		display: none;
		flex-direction: column;
		width: 42%;
		border-right: 1px solid color-mix(in srgb, var(--shell-border) 60%, transparent);
		background: color-mix(in srgb, var(--surface-variant) 30%, transparent);
	}

	.agenda-preview-image-toolbar {
		display: flex;
		gap: 0.4rem;
		padding: 0.5rem;
		justify-content: flex-end;
	}

	.agenda-preview-image-toolbar button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 0.5rem;
		border: 1px solid var(--shell-border);
		background: var(--surface-bright);
		color: var(--on-surface-variant);
		cursor: pointer;
	}

	.agenda-preview-image-frame {
		flex: 1;
		overflow: auto;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding: 0.5rem;
	}

	.agenda-preview-image-frame img {
		max-width: 100%;
		height: auto;
		transform-origin: top center;
		transition: transform 120ms ease;
		border-radius: 0.5rem;
	}

	.agenda-preview-rows-pane {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;
		overflow: hidden;
	}

	.agenda-preview-rows {
		flex: 1;
		overflow-y: auto;
		padding: 0.8rem 1.1rem;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	.agenda-preview-row {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem;
		padding: 0.7rem 0.8rem 0.7rem 0.95rem;
		border-radius: 0.9rem;
		border: 1px solid var(--shell-border);
		background: var(--surface-bright);
		border-left: 4px solid var(--agenda-confidence, #34a853);
	}

	.agenda-preview-row[data-confidence='medium'] {
		--agenda-confidence: #f59e0b;
	}

	.agenda-preview-row[data-confidence='low'],
	.agenda-preview-row.is-invalid {
		--agenda-confidence: #ef4444;
	}

	.agenda-preview-row__field {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}

	.agenda-preview-row__field--full {
		grid-column: 1 / -1;
	}

	.agenda-preview-row__field label {
		font-size: 0.64rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--on-surface-variant);
	}

	.agenda-preview-row__delete {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.9rem;
		height: 1.9rem;
		border-radius: 0.5rem;
		border: 1px solid transparent;
		background: transparent;
		color: #ef4444;
		cursor: pointer;
	}

	.agenda-preview-row__delete:hover {
		background: color-mix(in srgb, #ef4444 12%, transparent);
	}

	.agenda-preview-addrow {
		margin: 0 1.1rem 0.8rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		padding: 0.6rem;
		border-radius: 0.7rem;
		border: 1px dashed color-mix(in srgb, var(--primary) 42%, var(--shell-border));
		background: transparent;
		color: var(--primary);
		font-size: 0.85rem;
		font-weight: 800;
		cursor: pointer;
	}

	.agenda-preview-error {
		margin: 0.6rem 1.1rem 0;
		padding: 0.55rem 0.75rem;
		border-radius: 0.6rem;
		background: color-mix(in srgb, #ef4444 12%, transparent);
		color: #b91c1c;
		font-size: 0.82rem;
		font-weight: 700;
	}

	.agenda-preview-error.hidden {
		display: none;
	}

	.agenda-preview-footer {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.6rem;
		padding: 0.8rem 1.1rem;
		border-top: 1px solid color-mix(in srgb, var(--shell-border) 70%, transparent);
		padding-bottom: max(0.8rem, env(safe-area-inset-bottom, 0px));
	}

	.agenda-preview-cancel {
		padding: 0.75rem 1.2rem;
		border-radius: 999px;
		border: 1px solid var(--shell-border);
		background: var(--surface-bright);
		color: var(--on-surface-variant);
		font-size: 0.88rem;
		font-weight: 800;
		cursor: pointer;
	}

	.agenda-preview-save {
		flex: 1;
		max-width: 20rem;
		padding: 0.8rem 1.2rem;
		border-radius: 999px;
		border: 0;
		background: var(--primary);
		color: #f8fbff;
		font-size: 0.92rem;
		font-weight: 800;
		cursor: pointer;
	}

	.agenda-preview-save:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	@media (min-width: 900px) {
		.agenda-preview-shell {
			padding: 2.5vh 3vw;
		}

		.agenda-preview-dialog {
			border-radius: 1.4rem;
			max-width: 68rem;
			max-height: 95dvh;
			margin: 0 auto;
			border: 1px solid var(--shell-border);
			box-shadow: 0 24px 80px rgba(15, 23, 42, 0.24);
		}

		.agenda-preview-image-pane {
			display: flex;
		}

		.agenda-preview-row {
			grid-template-columns: 6rem 1fr 1fr;
			align-items: end;
		}

		.agenda-preview-row__field--name {
			grid-column: auto;
		}
	}

	@media (max-width: 480px) {
		.agenda-preview-subtitle {
			display: none;
		}
	}
</style>

<script>
	import '../scripts/agenda-scan-preview';
</script>
