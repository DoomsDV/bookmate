---
import FlashMessage from './FlashMessage.astro';
import SpecialtiesGrid from './SpecialtiesGrid.astro';
import AppPagination from './AppPagination.astro';
import {
	SpecialtiesApiError,
	SpecialtiesClient,
	type Specialty,
} from '../lib/specialties';

interface Props {
	canManageSpecialties?: boolean;
	currentPage?: number;
}

const PAGE_SIZE = 9;
const { canManageSpecialties = false, currentPage: pageProp = 1 } = Astro.props;

const token = Astro.locals.token ?? '';
const rawPage = Number(pageProp || Astro.url.searchParams.get('page') || '1');
const currentPage = Number.isInteger(rawPage) && rawPage > 0 ? rawPage : 1;
const searchQuery = String(Astro.url.searchParams.get('search') || '').trim();
const rawIsActive = String(Astro.url.searchParams.get('is_active') || '').trim();
const isActiveFilter = rawIsActive === '0' || rawIsActive === '1' ? Number(rawIsActive) : null;

let specialties: Specialty[] = [];
let loadError = '';
let pagination = {
	current_page: currentPage,
	per_page: PAGE_SIZE,
	total_records: 0,
	total_pages: 1,
};

if (!token) {
	loadError = 'No hay sesion valida para consultar especialidades.';
} else {
	try {
		const apiClient = new SpecialtiesClient(token);
		const listResult = await apiClient.list(
			currentPage,
			PAGE_SIZE,
			isActiveFilter,
			searchQuery || undefined
		);
		specialties = listResult.data;
		pagination = listResult.meta;
	} catch (error) {
		loadError =
			error instanceof SpecialtiesApiError
				? error.message
				: 'No fue posible cargar el listado de especialidades.';
	}
}

const totalPages = Math.max(1, pagination.total_pages);
const safeCurrentPage = Math.min(Math.max(1, pagination.current_page), totalPages);
---

{
	loadError ? (
		<FlashMessage message={loadError} type="error" expand={true} dismissible={false} />
	) : (
		<div class="grid gap-4" data-specialties-list>
			<SpecialtiesGrid
				specialties={specialties}
				showCreateAction={canManageSpecialties}
				searchQuery={searchQuery}
				isActiveFilter={isActiveFilter}
				totalRecords={pagination.total_records}
			/>

			<AppPagination
				currentPage={safeCurrentPage}
				totalPages={totalPages}
				totalRecords={pagination.total_records}
				recordLabel="especialidades"
				ariaLabel="Paginacion especialidades"
				rootDataAttr="data-specialties-pagination"
				summaryDataAttr="data-specialties-pagination-summary"
				pagesDataAttr="data-specialties-pagination-pages"
				prevDataAttr="data-specialties-page-prev"
				nextDataAttr="data-specialties-page-next"
				pageDataAttr="data-specialties-page"
			/>
		</div>
	)
}
