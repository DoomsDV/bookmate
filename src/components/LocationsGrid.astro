---
import type { Location } from '../lib/locations';
import {
	buildBrandMarkerSvgHtml,
	buildStadiaStaticMapUrl,
	resolveMapThemeFromStorage,
} from '../lib/maplibre-loader';
import AppPagination from './AppPagination.astro';

interface Props {
	locations: Location[];
	showCreateAction?: boolean;
	isActiveFilter?: number | null;
	currentPage?: number;
	totalPages?: number;
	totalRecords?: number;
}

const {
	locations = [],
	showCreateAction = false,
	isActiveFilter = null,
	currentPage = 1,
	totalPages = 1,
	totalRecords = 0,
} = Astro.props;
const hasStatusFilter = isActiveFilter === 0 || isActiveFilter === 1;

const activeCount = locations.filter((item) => item.is_active === 1).length;
const inactiveCount = locations.length - activeCount;
const stadiaKey = String(import.meta.env.PUBLIC_STADIA_MAPS_KEY ?? '');
const mapTheme = resolveMapThemeFromStorage(Astro.cookies.get('bookmate-theme')?.value);

const locationMapPreview = (location: Location) => {
	const lat = Number(location.latitude);
	const lng = Number(location.longitude);
	const coords =
		Number.isFinite(lat) && Number.isFinite(lng) ? { lat, lng } : null;
	return buildStadiaStaticMapUrl(stadiaKey, coords, {
		theme: mapTheme,
		width: 480,
		height: 270,
		zoom: 15,
	});
};
---

<section class="locations-view" data-stadia-key={stadiaKey}>
	<header class="mb-4 flex flex-wrap items-center justify-between gap-3">
		<h2 class="m-0 text-[1.5rem] sm:text-[1.75rem] font-bold tracking-tight text-(--on-surface) leading-none">
			Sucursales
		</h2>

		<div class="flex flex-wrap items-center justify-end gap-2">
			<span class="locations-summary-pill locations-summary-pill--active">
				<span class="size-2 rounded-full locations-summary-dot locations-summary-dot--active"></span>
				Activas: <span data-locations-active-count>{activeCount}</span>
			</span>
			<span
				class="locations-summary-pill locations-summary-pill--inactive"
				data-locations-inactive-pill
				hidden={inactiveCount <= 0}
			>
				<span class="size-2 rounded-full locations-summary-dot locations-summary-dot--inactive"></span>
				Inactivas: <span data-locations-inactive-count>{inactiveCount}</span>
			</span>

			{showCreateAction && (
				<button
					type="button"
					class="locations-org-closures-btn hidden sm:inline-flex items-center justify-center gap-2"
					data-open-org-closures
					title="Cierres generales para todas las sucursales"
				>
					<span class="material-symbols-rounded text-[1.15rem]" aria-hidden="true">event_busy</span>
					<span>Cierres generales</span>
				</button>
			)}

			{showCreateAction && (
				<button
					type="button"
					class="locations-create-btn hidden sm:inline-flex items-center justify-center gap-2"
					data-open-location-modal
				>
					<svg
						class="locations-create-btn-icon w-[18px] h-[18px]"
						viewBox="0 0 24 24"
						fill="none"
						aria-hidden="true"
					>
						<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
					</svg>
					<span>Nueva Sucursal</span>
				</button>
			)}
		</div>
	</header>

	{showCreateAction && (
		<button
			type="button"
			class="locations-create-fab"
			data-open-location-modal
			aria-label="Nueva Sucursal"
			title="Nueva Sucursal"
		>
			<svg
				class="locations-create-fab-icon"
				viewBox="0 0 24 24"
				fill="none"
				aria-hidden="true"
			>
				<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
			</svg>
		</button>
	)}

	<div class="flex max-w-xl items-center gap-2">
		<button
			type="button"
			class:list={[
				'panel-status-filter-btn relative flex size-11 shrink-0 items-center justify-center rounded-2xl border border-(--shell-border) bg-(--surface-bright) text-(--on-surface-variant) shadow-sm transition hover:border-(--on-surface-variant) hover:text-(--on-surface) focus:border-(--primary) focus:outline-none focus:ring-4 focus:ring-(--primary)/10',
				hasStatusFilter && 'is-active',
			]}
			data-open-locations-status-filter
			aria-label="Filtrar por estado"
			aria-haspopup="dialog"
			aria-controls="locations-status-filter-sheet"
			aria-pressed={hasStatusFilter ? 'true' : 'false'}
		>
			<span class="material-symbols-rounded text-[1.25rem]" aria-hidden="true">tune</span>
			{hasStatusFilter && (
				<span class="panel-status-filter-badge" data-locations-status-filter-badge aria-hidden="true"></span>
			)}
		</button>
	</div>

	<dialog
		id="locations-status-filter-sheet"
		class="panel-status-filter-sheet"
		data-locations-status-filter-sheet
		aria-labelledby="locations-status-filter-title"
	>
		<div class="panel-status-filter-sheet__handle" aria-hidden="true">
			<span></span>
		</div>
		<div class="panel-status-filter-sheet__header">
			<h2 id="locations-status-filter-title" class="m-0 text-[1.05rem] font-extrabold tracking-tight">
				Filtros
			</h2>
			<button
				type="button"
				class="flex size-9 shrink-0 items-center justify-center rounded-full text-(--on-surface-variant) transition-colors hover:bg-(--surface-variant) hover:text-(--on-surface)"
				data-close-locations-status-filter
				aria-label="Cerrar filtro"
			>
				<span class="material-symbols-rounded text-[1.3rem]">close</span>
			</button>
		</div>
		<div class="panel-status-filter-sheet__list" role="listbox" aria-label="Estado de la sucursal">
			<button
				type="button"
				class:list={['panel-status-filter-option', !hasStatusFilter && 'is-selected']}
				data-locations-status-option
				data-value=""
				role="option"
				aria-selected={!hasStatusFilter ? 'true' : 'false'}
			>
				<span>Todas</span>
				<span class="material-symbols-rounded">check</span>
			</button>
			<button
				type="button"
				class:list={['panel-status-filter-option', isActiveFilter === 1 && 'is-selected']}
				data-locations-status-option
				data-value="1"
				role="option"
				aria-selected={isActiveFilter === 1 ? 'true' : 'false'}
			>
				<span>Activas</span>
				<span class="material-symbols-rounded">check</span>
			</button>
			<button
				type="button"
				class:list={['panel-status-filter-option', isActiveFilter === 0 && 'is-selected']}
				data-locations-status-option
				data-value="0"
				role="option"
				aria-selected={isActiveFilter === 0 ? 'true' : 'false'}
			>
				<span>Inactivas</span>
				<span class="material-symbols-rounded">check</span>
			</button>
		</div>
	</dialog>

	<div data-locations-results>
	{locations.length === 0 ? (
		<div class="locations-empty-state" data-locations-empty>
			<div class="locations-empty-icon">
				<span class="material-symbols-rounded text-[2rem]">{hasStatusFilter ? 'search_off' : 'domain'}</span>
			</div>
			<h3 class="text-[1.1rem] font-bold text-(--on-surface)">
				{hasStatusFilter ? 'No se encontraron sucursales' : 'No hay sucursales registradas'}
			</h3>
			<p class="mt-1.5 max-w-sm text-[0.95rem] leading-relaxed text-(--on-surface-variant)">
				{hasStatusFilter
					? 'No hay sucursales con ese estado.'
					: 'Aún no has agregado ninguna sucursal a esta organización. Comienza creando tu primer local.'}
			</p>
		</div>
	) : (
		<div class="material-cards-grid gap-3 sm:grid-cols-2 sm:gap-4 md:grid-cols-3 lg:grid-cols-4" data-locations-grid>
			{locations.map((location) => {
				const lat = Number(location.latitude);
				const lng = Number(location.longitude);
				const hasCoords = Number.isFinite(lat) && Number.isFinite(lng);
				const mapPreviewUrl = locationMapPreview(location);
				return (
				<article
					class="locations-card group cursor-pointer"
					data-location-card
					data-location-id={location.id_location}
					tabindex="0"
					role="button"
					aria-label={`Editar sucursal ${location.name || location.id_location}`}
				>
					{mapPreviewUrl ? (
						<div class="locations-card-cover">
							<img
								src={mapPreviewUrl}
								alt=""
								loading="lazy"
								decoding="async"
								data-location-map-preview
								data-map-lat={hasCoords ? lat : undefined}
								data-map-lng={hasCoords ? lng : undefined}
							/>
							<span
								class="bookmate-map-marker-overlay"
								aria-hidden="true"
								set:html={buildBrandMarkerSvgHtml()}
							/>
						</div>
					) : (
						<div class="locations-card-cover locations-card-cover--brand" aria-hidden="true">
							<span
								class="bookmate-map-marker-overlay"
								aria-hidden="true"
								set:html={buildBrandMarkerSvgHtml()}
							/>
						</div>
					)}

					<div class="flex items-start justify-between gap-2">
						<div class="locations-card-icon">
							<span class="material-symbols-rounded text-[1.25rem]">storefront</span>
						</div>

						{location.current_closure_name && location.is_active === 1 ? (
							<span
								class="locations-card-status locations-card-status--closed"
								title={`Cerrado: ${location.current_closure_name}`}
							>
								<span class="size-1.5 rounded-full locations-summary-dot--closed"></span>
								Cerrada
							</span>
						) : (
							<span
								class:list={[
									'locations-card-status',
									location.is_active === 1
										? 'locations-card-status--active'
										: 'locations-card-status--inactive',
								]}
							>
								<span
									class:list={[
										'size-1.5 rounded-full',
										location.is_active === 1
											? 'locations-summary-dot--active'
											: 'locations-summary-dot--inactive',
									]}
								></span>
								{location.is_active === 1 ? 'Activa' : 'Inactiva'}
							</span>
						)}
					</div>

					<div class="locations-card-body">
						<div>
							<h3 class="locations-card-title line-clamp-1">
								{location.name || `Sucursal #${location.id_location}`}
							</h3>
							<p class="mt-1 text-[0.85rem] text-(--on-surface-variant) line-clamp-1">
								{location.address || 'Dirección no disponible'}
							</p>
						</div>

						<dl class="locations-card-metrics">
							<div class="flex items-center justify-between text-[0.8rem]">
								<dt class="locations-card-term">Ciudad</dt>
								<dd class="locations-card-value">{location.city?.name || '-'}</dd>
							</div>
							<div class="flex items-center justify-between text-[0.8rem]">
								<dt class="locations-card-term">Depto.</dt>
								<dd class="locations-card-value">{location.department?.name || '-'}</dd>
							</div>
						</dl>
					</div>
				</article>
				);
			})}
		</div>
	)}
	</div>

	<AppPagination
		currentPage={currentPage}
		totalPages={totalPages}
		totalRecords={totalRecords}
		recordLabel="sucursales"
		ariaLabel="Paginación sucursales"
		rootDataAttr="data-locations-pagination"
		summaryDataAttr="data-locations-pagination-summary"
		pagesDataAttr="data-locations-pagination-pages"
		prevDataAttr="data-locations-page-prev"
		nextDataAttr="data-locations-page-next"
		pageDataAttr="data-locations-page"
	/>
</section>

<style is:global>
	.locations-view {
		display: grid;
		gap: 1.2rem;
	}

	.locations-summary-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border-radius: 999px;
		border: 0;
		padding: 0.33rem 0.78rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.01em;
	}

	.locations-summary-pill--active {
		background: rgba(16, 185, 129, 0.12);
		color: #0f6d4a;
	}

	.locations-summary-pill--inactive {
		background: rgba(244, 63, 94, 0.11);
		color: #8d3e4a;
	}

	.locations-summary-dot {
		display: inline-block;
	}

	.locations-summary-dot--active {
		background: #22c55e;
	}

	.locations-summary-dot--inactive {
		background: #fb7185;
	}

	.locations-create-btn {
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--primary) 72%, #123e7a 28%);
		background: var(--primary);
		padding: 0.72rem 1.15rem;
		font-size: 0.92rem;
		font-weight: 780;
		color: #f8fbff;
		box-shadow: none;
		transition: filter 140ms ease, border-color 140ms ease;
	}

	.locations-create-btn-icon {
		flex-shrink: 0;
	}

	.locations-create-btn:hover {
		filter: brightness(1.04);
	}

	.locations-create-btn:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
		outline-offset: 3px;
	}

	.locations-create-fab {
		display: none;
	}

	@media (max-width: 639px) {
		.locations-create-fab {
			position: fixed;
			right: max(1rem, env(safe-area-inset-right, 0px));
			bottom: calc(5.15rem + env(safe-area-inset-bottom, 0px));
			z-index: 44;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 3.5rem;
			height: 3.5rem;
			padding: 0;
			border: 0;
			border-radius: 999px;
			color: #f8fbff;
			background: var(--primary);
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.28);
			cursor: pointer;
			-webkit-tap-highlight-color: transparent;
			transition: transform 140ms ease, box-shadow 140ms ease, filter 140ms ease;
		}

		.locations-create-fab-icon {
			width: 1.35rem;
			height: 1.35rem;
			flex-shrink: 0;
		}

		.locations-create-fab:hover {
			filter: brightness(1.04);
			box-shadow: 0 3px 10px rgba(0, 0, 0, 0.32);
		}

		.locations-create-fab:active {
			transform: scale(0.96);
		}

		.locations-create-fab:focus-visible {
			outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
			outline-offset: 3px;
		}
	}

	.locations-empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 1.35rem;
		border: 1px solid rgba(148, 163, 184, 0.24);
		background: color-mix(in srgb, var(--surface-container-low) 72%, var(--surface-bright) 28%);
		padding: 2.5rem 1.25rem;
		text-align: center;
	}

	.locations-empty-icon {
		margin-bottom: 1rem;
		display: flex;
		height: 4rem;
		width: 4rem;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-container) 88%, var(--surface-bright) 12%);
		color: var(--on-surface-variant);
	}

	.locations-card {
		cursor: pointer;
		gap: 0.55rem;
		padding: 0.72rem 0.8rem 0.85rem;
		border-radius: 0.8rem;
	}

	.locations-card-cover {
		position: relative;
		margin: -0.05rem -0.05rem 0.4rem;
		overflow: hidden;
		border-radius: 0.65rem;
		aspect-ratio: 16 / 9;
		background: color-mix(in srgb, var(--surface-container-high) 80%, transparent);
	}

	.locations-card-cover--brand {
		display: flex;
		align-items: center;
		justify-content: center;
		background:
			radial-gradient(
				ellipse 80% 70% at 20% 15%,
				color-mix(in srgb, var(--primary) 28%, transparent),
				transparent 60%
			),
			linear-gradient(
				145deg,
				color-mix(in srgb, var(--primary-container) 55%, var(--surface-container-high)),
				var(--surface-container-highest) 55%,
				color-mix(in srgb, var(--primary-container) 35%, var(--surface-container-high))
			);
	}

	.locations-card-cover .bookmate-map-marker-overlay {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 28px;
		height: 36px;
		transform: translate(-50%, -100%);
		pointer-events: none;
		filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.35));
		z-index: 1;
	}

	.locations-card-cover .bookmate-map-marker-overlay svg {
		display: block;
		width: 28px;
		height: 36px;
	}

	.locations-card-cover--brand .bookmate-map-marker-overlay {
		position: relative;
		left: auto;
		top: auto;
		transform: none;
	}

	.locations-card-cover img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.locations-card .locations-card-icon {
		width: 1.9rem;
		height: 1.9rem;
		border-radius: 0.6rem;
	}

	.locations-card .locations-card-icon .material-symbols-rounded {
		font-size: 1rem;
	}

	.locations-card .locations-card-body {
		gap: 0.4rem;
	}

	.locations-card .locations-card-title {
		font-size: 0.92rem;
	}

	.locations-card .locations-card-metrics {
		gap: 0.25rem;
		font-size: 0.8rem;
	}

	.locations-card-status {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border-radius: 999px;
		border: 0;
		padding: 0.24rem 0.6rem;
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.locations-card-status--active {
		background: rgba(16, 185, 129, 0.12);
		color: #0f6d4a;
	}

	.locations-card-status--inactive {
		background: rgba(244, 63, 94, 0.11);
		color: #8d3e4a;
	}

	.locations-card-status--closed {
		background: rgba(249, 115, 22, 0.15);
		color: #9a4a12;
	}

	.locations-summary-dot--closed {
		display: inline-block;
		background: #f97316;
	}

	.locations-org-closures-btn {
		border-radius: 999px;
		border: 1px solid var(--shell-border);
		background: transparent;
		padding: 0.62rem 1rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--on-surface-variant);
		transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
	}

	.locations-org-closures-btn:hover {
		background: color-mix(in srgb, var(--on-surface) 5%, transparent);
		color: var(--on-surface);
	}

	.locations-org-closures-btn:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 42%, white 58%);
		outline-offset: 3px;
	}

	.locations-card-value {
		font-weight: 700;
	}

	@media (max-width: 639px) {
		.locations-card {
			gap: 0.45rem;
			padding: 0.65rem 0.7rem 0.75rem;
		}

		.locations-card-cover {
			margin: -0.02rem -0.02rem 0.3rem;
			border-radius: 0.55rem;
		}
	}

	html[data-theme='dark'] .locations-summary-pill--active {
		background: rgba(110, 231, 183, 0.16);
		color: #b8f5d5;
	}

	html[data-theme='dark'] .locations-summary-pill--inactive {
		background: rgba(255, 182, 193, 0.12);
		color: #ffc8d2;
	}

	html[data-theme='dark'] .locations-create-btn {
		border-color: color-mix(in srgb, var(--primary) 58%, #0e0e10 42%);
		background: color-mix(in srgb, var(--primary) 78%, #0e0e10 22%);
	}

	html[data-theme='dark'] .locations-create-btn:hover {
		filter: brightness(1.08);
	}

	@media (max-width: 639px) {
		html[data-theme='dark'] .locations-create-fab {
			background: color-mix(in srgb, var(--primary) 78%, #0e0e10 22%);
		}

		html[data-theme='dark'] .locations-create-fab:hover {
			filter: brightness(1.08);
		}
	}

	html[data-theme='dark'] .locations-empty-state {
		border-color: rgba(255, 255, 255, 0.08);
		background: #121214;
	}

	html[data-theme='dark'] .locations-empty-icon {
		background: rgba(255, 255, 255, 0.05);
		color: var(--on-surface-variant);
	}


	html[data-theme='dark'] .locations-card-status--active {
		background: rgba(110, 231, 183, 0.16);
		color: #b8f5d5;
	}

	html[data-theme='dark'] .locations-card-status--inactive {
		background: rgba(255, 182, 193, 0.12);
		color: #ffc8d2;
	}

	html[data-theme='dark'] .locations-card-status--closed {
		background: rgba(251, 146, 60, 0.16);
		color: #ffd7a8;
	}

	html[data-theme='dark'] .locations-org-closures-btn {
		border-color: rgba(255, 255, 255, 0.12);
		color: var(--on-surface-variant);
	}

	html[data-theme='dark'] .locations-org-closures-btn:hover {
		background: rgba(255, 255, 255, 0.06);
		color: var(--on-surface);
	}
</style>

<script>
	import { initLocationsListControls } from '../scripts/locations-list-controls';

	initLocationsListControls();
</script>
