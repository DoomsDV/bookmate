---
interface Props {
	variant?: 'marketing' | 'marketplace';
	/** Solo en /explorar: CTA para dueños de negocio (guest). */
	showOwnerCta?: boolean;
	/** Destino del logo; por defecto `/` en marketing y `/explorar` en marketplace. */
	logoHref?: string;
}

const { variant = 'marketplace', showOwnerCta = false, logoHref: logoHrefProp } = Astro.props;

const isLoggedIn = Boolean(Astro.locals.token);
const organizationName = String(Astro.locals.organizationName || '').trim();
const organizationLogoUrl = String(Astro.locals.organizationLogoUrl || '').trim();
const avatarInitials =
	organizationName
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((part) => part.charAt(0).toUpperCase())
		.join('') || 'H';

const defaultLogoHref = variant === 'marketing' ? '/' : '/explorar';
const logoHref = logoHrefProp ?? defaultLogoHref;
const logoLabel = logoHref === '/' ? 'Hasel — Inicio' : 'Hasel — Buscar negocios';
---

<header
	class:list={[
		'public-hasel-topbar',
		{
			'public-hasel-topbar--marketing': variant === 'marketing',
			'public-hasel-topbar--marketplace': variant === 'marketplace',
		},
	]}
	data-public-hasel-topbar
>
	<div class="public-hasel-topbar__inner">
		<a href={logoHref} class="public-hasel-topbar__brand no-underline" aria-label={logoLabel}>
			<img
				src="/icons/icon-64.png"
				alt=""
				class="public-hasel-topbar__logo"
				width="32"
				height="32"
				loading="eager"
				decoding="async"
			/>
			<span class="public-hasel-topbar__wordmark">Hasel</span>
		</a>

		{
			variant === 'marketing' ? (
				<>
					<nav class="public-hasel-topbar__links" aria-label="Secciones">
						<a href="/explorar" class="public-hasel-topbar__link no-underline">Buscar negocios</a>
						<a href="/#funciones" class="public-hasel-topbar__link no-underline">Funciones</a>
						<a href="/#como-funciona" class="public-hasel-topbar__link no-underline">Cómo funciona</a>
						<a href="/#precios" class="public-hasel-topbar__link no-underline">Precios</a>
						<a href="/#soporte" class="public-hasel-topbar__link no-underline">Soporte</a>
					</nav>
					<div class="public-hasel-topbar__landing-actions">
						<a href="/auth/login" class="public-hasel-topbar__landing-login no-underline">
							Iniciar sesión
						</a>
						<a href="/auth/register" class="public-hasel-topbar__landing-cta no-underline">
							Empezar gratis
						</a>
					</div>
				</>
			) : (
				<div class="public-hasel-topbar__actions">
					{
						isLoggedIn ? (
							<a
								href="/panel/dashboard"
								class="public-hasel-topbar__avatar no-underline"
								aria-label="Ir al panel"
								title={organizationName || 'Ir al panel'}
							>
								{organizationLogoUrl ? (
									<img
										src={organizationLogoUrl}
										alt=""
										class="public-hasel-topbar__avatar-image"
										width="32"
										height="32"
										loading="lazy"
										decoding="async"
									/>
								) : (
									<span class="public-hasel-topbar__avatar-initials" aria-hidden="true">
										{avatarInitials}
									</span>
								)}
							</a>
						) : (
							<a href="/auth/login" class="public-hasel-topbar__login no-underline">
								Iniciar sesión
							</a>
						)
					}
					{
						showOwnerCta && !isLoggedIn ? (
							<a href="/auth/register" class="public-hasel-topbar__cta no-underline">
								Empezar gratis
							</a>
						) : null
					}
				</div>
			)
		}
	</div>
</header>

<script>
	const initTopbar = () => {
		const topbar = document.querySelector<HTMLElement>('[data-public-hasel-topbar]');
		if (!topbar) return;

		const onScroll = () => {
			topbar.classList.toggle('is-scrolled', window.scrollY > 8);
		};
		onScroll();
		if (topbar.dataset.scrollBound !== '1') {
			topbar.dataset.scrollBound = '1';
			window.addEventListener('scroll', onScroll, { passive: true });
		}
	};

	initTopbar();
	document.addEventListener('astro:page-load', initTopbar);
</script>

<style>
	.public-hasel-topbar {
		position: sticky;
		top: 0;
		z-index: 40;
		height: var(--app-topbar-h, 4rem);
		border-bottom: 1px solid transparent;
		background: color-mix(in srgb, var(--surface, #fafbfc) 82%, transparent);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		transition:
			border-color 200ms ease,
			box-shadow 200ms ease,
			background 200ms ease;
	}

	:global(html[data-theme='dark']) .public-hasel-topbar {
		background: color-mix(in srgb, var(--page-background, #0c0e14) 78%, transparent);
	}

	.public-hasel-topbar.is-scrolled {
		border-bottom-color: var(--shell-border, rgba(148, 163, 184, 0.28));
		box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
	}

	:global(html[data-theme='dark']) .public-hasel-topbar.is-scrolled {
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
	}

	.public-hasel-topbar__inner {
		max-width: var(--hub-max, 1120px);
		margin: 0 auto;
		height: 100%;
		padding: 0 max(var(--hub-pad-x, 1.25rem), env(safe-area-inset-right, 0px)) 0
			max(var(--hub-pad-x, 1.25rem), env(safe-area-inset-left, 0px));
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.public-hasel-topbar__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--on-surface, #1e293b);
		flex-shrink: 0;
	}

	.public-hasel-topbar__logo {
		width: 2rem;
		height: 2rem;
		border-radius: 0.65rem;
		object-fit: cover;
		flex-shrink: 0;
	}

	.public-hasel-topbar__wordmark {
		font-family: var(--font-body, 'Nunito Sans', sans-serif);
		font-weight: 800;
		font-size: 1.15rem;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.public-hasel-topbar__actions {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
	}

	.public-hasel-topbar__login {
		display: inline-flex;
		align-items: center;
		padding: 0.55rem 0.9rem;
		border-radius: 999px;
		font-weight: 700;
		font-size: 0.92rem;
		color: var(--on-surface-variant, #64748b);
		transition: color 160ms ease;
		white-space: nowrap;
	}

	.public-hasel-topbar__login:hover {
		color: var(--on-surface, #1e293b);
	}

	.public-hasel-topbar__avatar {
		display: inline-grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 999px;
		border: 1px solid var(--shell-border, rgba(148, 163, 184, 0.35));
		background: var(--control-surface, #fff);
		overflow: hidden;
		transition: border-color 160ms ease, box-shadow 160ms ease;
	}

	.public-hasel-topbar__avatar:hover {
		border-color: color-mix(in srgb, var(--primary, #426edb) 35%, transparent);
		box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary, #426edb) 12%, transparent);
	}

	.public-hasel-topbar__avatar-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.public-hasel-topbar__avatar-initials {
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		color: var(--primary, #426edb);
	}

	.public-hasel-topbar__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.6rem 1.05rem;
		border-radius: 999px;
		font-weight: 800;
		font-size: 0.92rem;
		background: #426edb;
		color: #fff;
		transition: background 160ms ease;
		white-space: nowrap;
	}

	.public-hasel-topbar__cta:hover {
		background: #5a82e8;
	}

	.public-hasel-topbar--marketing .public-hasel-topbar__inner {
		width: min(var(--landing-max, 72rem), 100%);
		max-width: none;
	}

	.public-hasel-topbar__links {
		display: none;
		align-items: center;
		gap: 0.1rem;
	}

	.public-hasel-topbar__link {
		padding: 0.45rem 0.75rem;
		border-radius: 999px;
		color: var(--on-surface-variant, #64748b);
		font-size: 0.875rem;
		font-weight: 600;
		white-space: nowrap;
		transition: color 200ms ease, background-color 200ms ease;
	}

	.public-hasel-topbar__link:hover {
		color: var(--on-surface, #1e293b);
		background: color-mix(in srgb, var(--hub-primary, #426edb) 7%, transparent);
	}

	.public-hasel-topbar__landing-actions {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		flex-shrink: 0;
	}

	.public-hasel-topbar__landing-login,
	.public-hasel-topbar__landing-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.35rem;
		padding: 0.45rem 1rem;
		border-radius: 999px;
		font-size: 0.8125rem;
		font-weight: 700;
		white-space: nowrap;
		transition: background-color 200ms ease, color 200ms ease, transform 200ms ease;
	}

	.public-hasel-topbar__landing-login {
		color: var(--on-surface-variant, #64748b);
	}

	.public-hasel-topbar__landing-login:hover {
		color: var(--on-surface, #1e293b);
	}

	.public-hasel-topbar__landing-cta {
		background: var(--hub-primary, #426edb);
		color: #fff;
		box-shadow: 0 1px 2px rgb(12 20 40 / 0.2);
	}

	.public-hasel-topbar__landing-cta:hover {
		background: #5a82e8;
		transform: translateY(-1px);
	}

	.public-hasel-topbar__landing-login:focus-visible,
	.public-hasel-topbar__landing-cta:focus-visible,
	.public-hasel-topbar__link:focus-visible,
	.public-hasel-topbar__brand:focus-visible {
		outline: 2px solid var(--hub-accent, #5b9cff);
		outline-offset: 3px;
	}

	:global(.landing-root) .public-hasel-topbar--marketing {
		background: color-mix(in srgb, var(--surface) 80%, transparent);
	}

	:global(.landing-root) .public-hasel-topbar--marketing.is-scrolled {
		border-bottom-color: var(--border);
		background: color-mix(in srgb, var(--surface) 92%, transparent);
	}

	:global(.landing-root) .public-hasel-topbar--marketing .public-hasel-topbar__brand,
	:global(.landing-root) .public-hasel-topbar--marketing .public-hasel-topbar__wordmark {
		color: var(--text-primary);
	}

	:global(.landing-root) .public-hasel-topbar--marketing .public-hasel-topbar__link {
		color: var(--text-secondary);
	}

	:global(.landing-root) .public-hasel-topbar--marketing .public-hasel-topbar__link:hover {
		color: var(--text-primary);
		background: var(--control-hover, rgba(15, 23, 42, 0.05));
	}

	:global(.landing-root) .public-hasel-topbar--marketing .public-hasel-topbar__landing-login {
		color: var(--text-secondary);
	}

	:global(.landing-root) .public-hasel-topbar--marketing .public-hasel-topbar__landing-login:hover {
		color: var(--text-primary);
	}

	@media (min-width: 1024px) {
		.public-hasel-topbar--marketing .public-hasel-topbar__inner {
			display: grid;
			grid-template-columns: auto 1fr auto;
			align-items: center;
		}

		.public-hasel-topbar__links {
			display: flex;
			justify-self: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.public-hasel-topbar__landing-login,
		.public-hasel-topbar__landing-cta,
		.public-hasel-topbar__link {
			transition: none;
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		:global(.landing-root) .public-hasel-topbar--marketing {
			background: var(--surface);
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
		}

		:global(.landing-root) .public-hasel-topbar--marketing.is-scrolled {
			background: var(--surface);
		}
	}
</style>
