{
	"name": "bookmate",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=10.0.0"
	},
	"scripts": {
		"preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(!ua.includes('pnpm')){console.error('\\nUse pnpm: pnpm install\\n');process.exit(1)}\"",
		"dev": "astro dev",
		"dev:force": "pnpm run clean:caches && astro dev --force",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"clean:caches": "node -e \"const fs=require('fs');for (const p of ['node_modules/.vite','.astro']){try{fs.rmSync(p,{recursive:true,force:true});console.log('removed',p);}catch{}}\""
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/react": "^6.0.2",
		"@astrojs/sitemap": "^3.7.3",
		"@astrojs/vercel": "^11.0.4",
		"@fullcalendar/core": "^6.1.20",
		"@fullcalendar/daygrid": "^6.1.20",
		"@fullcalendar/interaction": "^6.1.20",
		"@fullcalendar/list": "^6.1.20",
		"@fullcalendar/timegrid": "^6.1.20",
		"@google/genai": "^1.49.0",
		"@gsap/react": "^2.1.2",
		"@tailwindcss/vite": "^4.2.1",
		"astro": "^7.1.6",
		"croppie": "^2.6.5",
		"driver.js": "^1.4.0",
		"firebase": "^12.12.0",
		"googleapis": "^171.4.0",
		"gsap": "^3.13.0",
		"maplibre-gl": "^6.1.0",
		"marked": "^18.0.3",
		"pdfjs-dist": "^4.10.38",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"sharp": "^0.35.3",
		"tailwindcss": "^4.2.1",
		"tom-select": "^2.5.2",
		"typescript": "^5.9.3",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/node": "^25.5.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vite-pwa/astro": "^1.2.0",
		"shadcn": "^4.16.2",
		"jsrepo": "^3.8.1"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"@vite-pwa/astro>astro": "7"
			}
		},
		"overrides": {
			"@vitejs/plugin-react": "6.0.5"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"protobufjs",
			"sharp"
		]
	}
}