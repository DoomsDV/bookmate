# Copy this file to:
#   .env.development  →  npm run dev
#   .env.production   →  npm run build / preview
# Do not create a generic `.env` file.

# Base URLs — one per ORDS module (paths live in src/lib/*.ts)
ORDS_API_BASE_URL=https://your-ords-host/ords/bookmate/api/v1/
ORDS_PUBLIC_API_BASE_URL=https://your-ords-host/ords/bookmate/public/v1/
ORDS_AI_BASE_URL=https://your-ords-host/ords/bookmate/ai/

# Public app values
PUBLIC_BOOKMATE_PUBLIC_DOMAIN=https://bookmate.com
PUBLIC_BOOKMATE_PROFILE_PLACEHOLDER_IMAGE_URL=https://placehold.co/200x200?text=Bookmate
PUBLIC_G_MAPS_API_KEY=your_google_maps_api_key
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
PUBLIC_FIREBASE_VAPID_KEY=

# Google OAuth (exact redirect URI required by Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app-host/api/google/callback

# Optional endpoint overrides (advanced — leave empty to use base + path)
# ORDS_AUTH_LOGIN_URL=
# AI_SUMMARIZATION_URL=
# ORDS_AI_ATC_ASK=
# ORDS_AI_AGENDA_IMAGE_DRAFT=
# ORDS_PUBLIC_USER_PROFILE_URL=
# ORDS_INTEGRATIONS_URL=

# Stadia Maps
PUBLIC_STADIA_MAPS_KEY=