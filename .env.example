# Copy this file to:
#   .env.development  →  npm run dev
#   .env.production   →  npm run build / preview
# Do not create a generic `.env` file.

# Base URLs — one per ORDS module (paths live in src/lib/*.ts)
ORDS_API_BASE_URL=https://your-ords-host/ords/bookmate/api/v1/
ORDS_PUBLIC_API_BASE_URL=https://your-ords-host/ords/bookmate/public/v1/
ORDS_AI_BASE_URL=https://your-ords-host/ords/bookmate/ai/

# Public app values
PUBLIC_BOOKMATE_PUBLIC_DOMAIN=https://bookmate.com
PUBLIC_BOOKMATE_PROFILE_PLACEHOLDER_IMAGE_URL=https://placehold.co/200x200?text=Bookmate
PUBLIC_G_MAPS_API_KEY=your_google_maps_api_key
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
PUBLIC_FIREBASE_VAPID_KEY=

# Google OAuth (exact redirect URI required by Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app-host/api/google/callback

# Firmador esign — Factura Electronica SIFEN de suscripciones Hasel.
# Por ahora localhost y staging SIEMPRE usan la api key de TEST (sk_test_...).
# En .env.production queda vacia hasta tener certificado/timbrado real en el panel esign
# (mientras este vacia, la integracion no emite nada y no rompe el flujo de pago).
ESIGN_API_BASE_URL=https://api-staging.etick.uno
ESIGN_API_KEY=sk_test_your_test_key
# Secreto compartido con Oracle (app_parameter ESIGN_CALLBACK_SERVICE_TOKEN) para el
# callback PL/SQL -> Astro (header X-Service-Token) y para el cron de KuDE.
ESIGN_CALLBACK_SERVICE_TOKEN=

# Vercel Cron Jobs firma sus invocaciones con "Authorization: Bearer $CRON_SECRET"
# (ver vercel.com/docs/cron-jobs/manage-cron-jobs). Usado por /api/internal/esign/poll-kude.
CRON_SECRET=

# Optional endpoint overrides (advanced — leave empty to use base + path)
# ORDS_AUTH_LOGIN_URL=
# AI_SUMMARIZATION_URL=
# ORDS_AI_ATC_ASK=
# ORDS_AI_AGENDA_IMAGE_DRAFT=
# ORDS_PUBLIC_USER_PROFILE_URL=
# ORDS_INTEGRATIONS_URL=

# Stadia Maps
PUBLIC_STADIA_MAPS_KEY=

# Odontograma 3D (GLB público). Si CORS falla en localhost, el visor usa /models/odontogram/dientes.glb
PUBLIC_ODONTOGRAM_GLB_URL=https://objectstorage.sa-saopaulo-1.oraclecloud.com/n/gr7djv0kcgrr/b/bucket-hasel-aoxdev/o/odontograma%2Fboca.glb